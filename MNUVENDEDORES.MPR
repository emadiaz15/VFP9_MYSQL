*       *********************************************************
*       *                                                         
*       * _7H70W45R3  ON SELECTION BAR 1 OF POPUP todoslospe      
*       *                                                         
*       * Procedure Origin:                                       
*       *                                                         
*       * From Menu:  MNUVENDEDORES.MPR,            Record:   64  
*       * Called By:  ON SELECTION BAR 1 OF POPUP todoslospe      
*       * Prompt:     Previsualizar                               
*       * Snippet:    13                                          
*       *                                                         
*       *********************************************************
*
PROCEDURE _7h70w45r3
LOCAL vendn,zdes,ahas
vendn=UPPER(substr(sys(0),ATC("#",sys(0))+2))
mnutotpend= conectar_db(_screen.cn)
	SQLEXEC(mnutotpend,"select * from vendedores where TRIM(ven_nomb)=?vendn;","cur_vendp")
	if RECCOUNT("cur_vendp")>0
		ven=ven_codi
		SQLEXEC(mnutotpend,"select * from zonas order by zona_codi limit 1;","curdes")
		xdes=curdes.zona_codi
		SQLEXEC(mnutotpend,"select * from zonas order by zona_codi desc limit 1;","curhas")
		xhas=curhas.zona_codi
		SQLEXEC(mnutotpend,"call usp_pendxzon(?xdes,?xhas,?ven);","curpendcli")
	ENDIF
desconectar_db(mnutotpend)
go top
index on str(zona)+str(cli_codi)+dtos(ped_fech)+str(ped_codi) to SYS(2015)
report form pendtotcli preview noconsole



*       *********************************************************
*       *                                                         
*       * _7H70W45R4  ON SELECTION BAR 2 OF POPUP todoslospe      

*       *********************************************************
*       *                                                         
*       * _7H70W456D  ON SELECTION BAR 1 OF POPUP _1dh151tza      
*       *                                                         
*       * Procedure Origin:                                       
*       *                                                         
*       * From Menu:  MNUPRINCIPAL.MPR,            Record:  224   
*       * Called By:  ON SELECTION BAR 1 OF POPUP _1dh151tza      
*       * Prompt:     Previsualizar                               
*       * Snippet:    45                                          
*       *                                                         
*       *********************************************************
*
PROCEDURE _7h70w456d
LOCAL zdes,ahas
mnutotpend= conectar_db(_screen.cn)
	SQLEXEC(mnutotpend,"select * from zonas order by zona_codi limit 1;","curdes")
	xdes=curdes.zona_codi
	SQLEXEC(mnutotpend,"select * from zonas order by zona_codi desc limit 1;","curhas")
	xhas=curhas.zona_codi
	SQLEXEC(mnutotpend,"call usp_pendxzon(?xdes,?xhas,0);","curpendcli")
desconectar_db(mnutotpend)
go top
*!*	index on str(zona)+str(cli_codi)+dtos(ped_fech)+str(ped_codi) to SYS(2015)
report form pendtotcli preview noconsole



*       *********************************************************
*       *                                                         
*       * _7H70W456E  ON SELECTION BAR 2 OF POPUP _1dh151tza      
*       *                                                         
*       * Procedure Origin:                                       
*       *                                                         
*       * From Menu:  MNUPRINCIPAL.MPR,            Record:  225   
*       * Called By:  ON SELECTION BAR 2 OF POPUP _1dh151tza      
*       * Prompt:     Imprimir                                    
*       * Snippet:    46                                          
*       *                                                         
*       *********************************************************
*
PROCEDURE _7h70w456e
preg=messagebox("¿Listar Pendientes totales?",4+48+256,"Advertencia")
if preg=6
	LOCAL zdes,ahas
	mnutotpend= conectar_db(_screen.cn)
		SQLEXEC(mnutotpend,"select * from zonas order by zona_codi limit 1;","curdes")
		xdes=curdes.zona_codi
		SQLEXEC(mnutotpend,"select * from zonas order by zona_codi desc limit 1;","curhas")
		xhas=curhas.zona_codi
		SQLEXEC(mnutotpend,"call usp_pendxzon(?xdes,?xhas,0);","curpendcli")
	desconectar_db(mnutotpend)
	go top
*!*		index on str(zona)+str(cli_codi)+dtos(ped_fech)+str(ped_codi) to SYS(2015)
	report form pendtotcli to printer prompt noconsole
endif




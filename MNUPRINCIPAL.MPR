*       * Called By:  ON SELECTION BAR 3 OF POPUP registrode      
*       * Prompt:     Por Remito de Cliente                       
*       * Snippet:    5                                           
*       *                                                         
*       *********************************************************
*
PROCEDURE _7h70w4559
valorcadena=PROMPT()

preg= MESSAGEBOX("¿Búsqueda Numérica?",3+32+512,"Aviso del Sistema")

DO case
	CASE preg=6
		do form numremload
	CASE preg=7
		codicli = 0
		do form remload with codicli
ENDCASE



PROCEDURE BAR_3_OF__1vx1245ls_FB2P
	valorcadena=PROMPT()
	
	preg= MESSAGEBOX("¿Búsqueda Numérica?",3+32+512,"Aviso del Sistema")
	
	DO case
		CASE preg=6
			do form numremload
		CASE preg=7
			codicli = 0
			do form remload with codicli
	ENDCASE
ENDPROC && BAR_3_OF__1vx1245ls_FB2P


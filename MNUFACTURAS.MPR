*
PROCEDURE _7h70w45tl
valorcadena=PROMPT()

preg= MESSAGEBOX("¿Búsqueda Numérica?",3+32+512,"Aviso del Sistema")

DO case
	CASE preg=6
		do form numremload
	CASE preg=7
		codicli = 0
		do form remload with codicli
ENDCASE



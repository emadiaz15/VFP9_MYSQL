DEFINE CLASS lstincremental AS listbox 
 	*< CLASSDATA: Baseclass="listbox" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: listcursor
		*p: pcampo
		*p: pcampo2
		*p: pcursor
		*p: pinput
		*p: pitemselect
	*</DefinedPropArrayMethod>

	*<PropValue>
		Height = 156
		Name = "lstincremental"
		pcampo = 
		pcampo2 = 
		pcursor = 
		pinput = 
		pitemselect = 
		Width = 220
	*</PropValue>
	
	PROCEDURE listcursor
		IF VARTYPE(this.pcursor) = "C" AND !EMPTY(this.pcursor) AND VARTYPE(this.pcampo) = "C" AND !EMPTY(this.pcampo)
		
			LOCAL lcCursor,lcCampo,lcCampo2,lcInput,lcCursorTemp
			lcCursor = this.pcursor
			lcCampo  = this.pcampo
			lcCampo2 = this.pcampo2
			lcInput  = UPPER(ALLTRIM(this.pInput))
			
			SELECT &lcCampo,&lcCampo2 FROM (lcCursor) WHERE &lcCampo like "%"+(lcInput)+"%" INTO CURSOR crlistincremental
			IF RECCOUNT()>0
				this.RowSource     = "crlistincremental"
				this.RowSourceType = 2
			ENDIF
		ENDIF
		
	ENDPROC

ENDDEFINE

	PROCEDURE cnt_base.cnt_grupo02.cnt_boton3.btn.Click
		preg= MESSAGEBOX("¿Búsqueda Numérica?",3+32+512,"Aviso del Sistema")
		
		DO case
			CASE preg=6
				_screen.estapres=2
				valorcadena="Por Número"
				do form numpresload
			CASE preg=7
				_screen.estapres=0
				public codicli
				codicli=0
				valorcadena="Por Cliente"
				do form presupload with codicli
		ENDCASE
		
	ENDPROC


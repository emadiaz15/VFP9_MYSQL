	PROCEDURE cnt_base.cnt_grupo03.cnt_boton2.btn.Click
		public proveedor,codiprov
		*!*	proveedor=""
		*!*	codiprov=0
		*!*	valorcadena="Mercadería Recibida"
		*!*	do form recepload with proveedor,codiprov
		
		preg= MESSAGEBOX("¿Consulta Numérica?",3+32+512,"Aviso del Sistema")
		
		DO case
			CASE preg=6
				do form numrecepload
			CASE preg=7
				proveedor=""
				codiprov=0
				valorcadena="Mercadería Recibida"
				do form recepload with proveedor,codiprov
		ENDCASE
		
	ENDPROC


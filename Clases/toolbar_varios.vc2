	PROCEDURE cnt_base.cnt_grupo01.Container2.btn.Click
		preg= MESSAGEBOX("¿Consulta Numérica?",3+32+512,"Aviso del Sistema")
		
		DO case
			CASE preg=6
				do form consfacnum
			CASE preg=7
				public codicli
				codicli=0
				valorcadena="Por Cliente"
				do form facload with codicli
		ENDCASE
		
	ENDPROC


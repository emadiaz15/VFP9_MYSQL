		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE cnt_base.cnt_grupo05.cnt_boton2.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE cnt_base.cnt_grupo06.cnt_boton1.btn.Click
		lnOption = MsgboxEx(;
		   "Seleccione Tipo de Proveedor", ;
		   "?", ;
		   "Proveedores", ;
		   "&Mercadería,&Serv/Gastos,&Cancelar")
		DO case
			CASE lnOption = 1
				do form consprov
			CASE lnOption = 2
				DO FORM consper
		ENDCASE
	ENDPROC

	PROCEDURE cnt_base.cnt_grupo06.cnt_boton1.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE cnt_base.cnt_grupo06.cnt_boton1.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC


	PROCEDURE DblClick
		NODEFAULT
	ENDPROC

	PROCEDURE Init
		this.cnt_base.Width=_screen.Width-18
	ENDPROC

	PROCEDURE cnt_base.cnt_grupo01.cnt_boton1.btn.Click
		do form consart
	ENDPROC

	PROCEDURE cnt_base.cnt_grupo01.cnt_boton1.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE cnt_base.cnt_grupo01.cnt_boton1.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE cnt_base.cnt_grupo01.cnt_boton1.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE cnt_base.cnt_grupo01.cnt_boton2.btn.Click
		preg= MESSAGEBOX("¿Consulta Numérica?",3+32+512,"Aviso del Sistema")
		
		DO case
			CASE preg=6
				_screen.estapres=1
				do form numpresload
			CASE preg=7
				_screen.estapres=0
				public codicli
				codicli=0
				valorcadena="Presupuestos por Cliente"
				do form presupload with codicli
		ENDCASE
		
	ENDPROC


	*< OBJECTDATA: ObjPath="btn_min" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="btn_salir" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command3" UniqueID="" Timestamp="" />

	*<PropValue>
		BackStyle = 0
		BorderWidth = 0
		Height = 24
		Name = "btns_minsal"
		Width = 76
	*</PropValue>

	ADD OBJECT 'btn_min' AS commandbutton WITH ;
		Alignment = 2, ;
		Caption = "-", ;
		FontSize = 25, ;
		Height = 22, ;
		Left = 1, ;
		Name = "btn_min", ;
		Themes = .F., ;
		Top = 1, ;
		Width = 36
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'btn_salir' AS commandbutton WITH ;
		Caption = "X", ;
		FontBold = .T., ;
		FontSize = 12, ;
		Height = 22, ;
		Left = 39, ;
		Name = "btn_salir", ;
		Themes = .F., ;
		Top = 1, ;
		Width = 36
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command3' AS commandbutton WITH ;
		Caption = "Command3", ;
		Height = 1, ;
		Left = 60, ;
		Name = "Command3", ;
		Top = 48, ;
		Width = 13
		*< END OBJECT: BaseClass="commandbutton" />
	
	PROCEDURE btn_min.Click
		thisform.WindowState= 1
		thisform.TitleBar= 1
		thisform.refresh
		RETURN
		
		
	ENDPROC

	PROCEDURE btn_min.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.BackColor= RGB(240,240,240)
		this.ForeColor= RGB(0,0,0)
	ENDPROC

	PROCEDURE btn_min.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.BackColor= RGB(12,116,186)
		this.ForeColor= RGB(255,255,255)
	ENDPROC

	PROCEDURE btn_salir.Click
		thisform.Release
		RETURN
		
	ENDPROC

	PROCEDURE btn_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.BackColor= RGB(240,240,240)
		this.ForeColor= RGB(0,0,0)
	ENDPROC

	PROCEDURE btn_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.BackColor= RGB(192,32,2)
		this.ForeColor= RGB(255,255,255)
	ENDPROC

ENDDEFINE

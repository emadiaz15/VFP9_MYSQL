		Height = 28, ;
		Left = 10, ;
		Name = "img_boton", ;
		Picture = ..\imagen\refresh_arrow_1546.png, ;
		Stretch = 2, ;
		Top = 4, ;
		Width = 32
		*< END OBJECT: BaseClass="image" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackStyle = 0, ;
		BorderColor = 62,106,235, ;
		Curvature = 5, ;
		Height = 20, ;
		Left = 0, ;
		Name = "Shape1", ;
		Top = 0, ;
		Visible = .F., ;
		Width = 23
		*< END OBJECT: BaseClass="shape" />
	
	PROCEDURE Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		this.Parent.etq_titulo.FontBold= .F.
		
	ENDPROC

	PROCEDURE btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
		this.Parent.etq_titulo.FontBold= .T.
		
	ENDPROC

ENDDEFINE


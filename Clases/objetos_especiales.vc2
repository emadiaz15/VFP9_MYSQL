DEFINE CLASS fechahora_sistema AS container 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="txt_fecha0" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Line1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txt_hora" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txt_fecha1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txt_fecha2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Timer1" UniqueID="" Timestamp="" />

	*<PropValue>
		BackStyle = 0
		BorderWidth = 0
		Height = 135
		Name = "fechahora_sistema"
		Width = 399
	*</PropValue>

	ADD OBJECT 'Line1' AS line WITH ;
		BorderColor = 74,74,74, ;
		BorderWidth = 4, ;
		Height = 57, ;
		Left = 135, ;
		Name = "Line1", ;
		Top = 13, ;
		Width = 0
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'Timer1' AS timer WITH ;
		Height = 23, ;
		Interval = 1000, ;
		Left = 348, ;
		Name = "Timer1", ;
		Top = 48, ;
		Width = 23
		*< END OBJECT: BaseClass="timer" />

	ADD OBJECT 'txt_fecha0' AS textbox WITH ;
		Alignment = 1, ;
		BackStyle = 0, ;
		BorderStyle = 0, ;
		DisabledForeColor = 74,74,74, ;
		Enabled = .F., ;
		FontBold = .T., ;
		FontSize = 40, ;
		Height = 60, ;
		Left = 5, ;
		Margin = 0, ;
		Name = "txt_fecha0", ;
		Top = 6, ;
		Width = 121
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txt_fecha1' AS textbox WITH ;
		Alignment = 1, ;
		BackStyle = 0, ;
		BorderStyle = 0, ;
		DisabledForeColor = 74,74,74, ;
		Enabled = .F., ;
		FontBold = .T., ;
		FontSize = 50, ;
		Height = 77, ;
		Left = 1, ;
		Margin = 0, ;
		Name = "txt_fecha1", ;
		Top = 55, ;
		Width = 130
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txt_fecha2' AS textbox WITH ;
		BackStyle = 0, ;
		BorderStyle = 0, ;
		DisabledForeColor = 74,74,74, ;
		Enabled = .F., ;
		FontBold = .T., ;
		FontSize = 24, ;
		Height = 47, ;
		Left = 139, ;
		Margin = 0, ;
		Name = "txt_fecha2", ;
		Top = 86, ;
		Width = 290
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txt_hora' AS textbox WITH ;
		BackStyle = 0, ;
		BorderStyle = 0, ;
		DisabledForeColor = 74,74,74, ;
		Enabled = .F., ;
		FontBold = .T., ;
		FontSize = 45, ;
		Height = 66, ;
		Left = 140, ;
		Margin = 0, ;
		Name = "txt_hora", ;
		Top = 6, ;
		Width = 186
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		this.txt_hora.Value= LEFT(TIME(),5)
		this.txt_fecha0.Value= LEFT(dia_nombre(DOW(DATE())),3)
		this.txt_fecha1.Value= DAY(DATE())
		this.txt_fecha2.Value= mes_nombre(MONTH(DATE()))+" "+STR(YEAR(DATE()),4,0)
		
	ENDPROC

	PROCEDURE Timer1.Timer
		_screen.opantalla_principal.fechahora_sistema.txt_hora.Value= LEFT(TIME(),5)
		_screen.opantalla_principal.fechahora_sistema.txt_fecha0.Value= LEFT(dia_nombre(DOW(DATE())),3)
		_screen.opantalla_principal.fechahora_sistema.txt_fecha1.Value= DAY(DATE())
		_screen.opantalla_principal.fechahora_sistema.txt_fecha2.Value= mes_nombre(MONTH(DATE()))+" "+STR(YEAR(DATE()),4,0)
		
		
		
	ENDPROC

ENDDEFINE


		HighlightRow = .F., ;
		Left = 31, ;
		Name = "grd_tareas", ;
		Panel = 1, ;
		ReadOnly = .T., ;
		RecordMark = .F., ;
		RecordSource = "''", ;
		RowHeight = 36, ;
		ScrollBars = 2, ;
		Top = 71, ;
		Width = 425, ;
		Column1.BackColor = 245,245,245, ;
		Column1.ControlSource = "", ;
		Column1.FontBold = .F., ;
		Column1.ForeColor = 0,0,0, ;
		Column1.Name = "Column1", ;
		Column1.ReadOnly = .T., ;
		Column1.Width = 118, ;
		Column2.BackColor = 245,245,245, ;
		Column2.ControlSource = "", ;
		Column2.FontBold = .F., ;
		Column2.ForeColor = 0,0,0, ;
		Column2.Name = "Column2", ;
		Column2.ReadOnly = .T., ;
		Column2.Width = 214, ;
		Column3.BackColor = 245,245,245, ;
		Column3.ControlSource = "", ;
		Column3.FontBold = .F., ;
		Column3.ForeColor = 0,0,0, ;
		Column3.Name = "Column3", ;
		Column3.ReadOnly = .T., ;
		Column3.Sparse = .F., ;
		Column3.Width = 34, ;
		Column4.BackColor = 245,245,245, ;
		Column4.FontBold = .F., ;
		Column4.ForeColor = 0,0,0, ;
		Column4.Name = "Column4", ;
		Column4.ReadOnly = .T., ;
		Column4.Sparse = .F., ;
		Column4.Width = 34
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'cnt_tareas.grd_tareas.Column1.Header1' AS header WITH ;
		Caption = "Header1", ;
		FontBold = .F., ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'cnt_tareas.grd_tareas.Column1.Text1' AS textbox WITH ;
		BackColor = 245,245,245, ;
		BorderStyle = 0, ;

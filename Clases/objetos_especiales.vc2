		Caption = "Header1", ;
		FontBold = .F., ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'cnt_tareas.grd_tareas.Column2.Text1' AS textbox WITH ;
		BackColor = 245,245,245, ;
		BorderStyle = 0, ;
		FontBold = .F., ;
		ForeColor = 0,0,0, ;
		Margin = 0, ;
		Name = "Text1", ;
		ReadOnly = .T.
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'cnt_tareas.grd_tareas.Column3.cmd_esta' AS commandbutton WITH ;
		BackColor = 245,245,245, ;
		Caption = "", ;
		ForeColor = 0,0,0, ;
		Height = 27, ;
		Left = 5, ;
		MousePointer = 15, ;
		Name = "cmd_esta", ;
		Picture = ..\imagen\tareas\icons8-verificar-24.bmp, ;
		PicturePosition = 12, ;
		SpecialEffect = 1, ;
		Themes = .F., ;
		Top = 12, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cnt_tareas.grd_tareas.Column3.Header1' AS header WITH ;
		Caption = "Header1", ;
		FontBold = .F., ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'cnt_tareas.grd_tareas.Column4.cmd_ver' AS commandbutton WITH ;
		BackColor = 245,245,245, ;
		Caption = "", ;
		ForeColor = 0,0,0, ;
		Height = 27, ;
		Left = 7, ;
		MousePointer = 15, ;
		Name = "cmd_ver", ;
		Picture = ..\imagen\tareas\icons8-gmail-24.bmp, ;
		PicturePosition = 12, ;
		SpecialEffect = 1, ;
		Themes = .F., ;
		Top = 12, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cnt_tareas.grd_tareas.Column4.Header1' AS header WITH ;
		Caption = "Header1", ;
		FontBold = .F., ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'cnt_tareas.Label1' AS label WITH ;
		AutoSize = .T., ;
		BackStyle = 0, ;
		Caption = "ALERTAS DEL SISTEMA", ;
		FontBold = .T., ;
		FontName = "Arial", ;
		FontSize = 10, ;
		ForeColor = 255,255,255, ;
		Left = 166, ;
		Name = "Label1", ;
		Top = 47, ;
		Width = 153
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'cnt_tareas.Shape1' AS shape WITH ;
		BackColor = 0,128,128, ;
		BorderColor = 0,0,0, ;
		BorderWidth = 2, ;
		Height = 31, ;
		Left = 31, ;
		Name = "Shape1", ;
		Top = 40, ;
		Width = 425
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'cnt_tareas.Timer1' AS timer WITH ;
		Enabled = .F., ;
		Height = 23, ;
		Interval = 1000, ;
		Left = 14, ;
		Name = "Timer1", ;
		Top = 12, ;
		Width = 23
		*< END OBJECT: BaseClass="timer" />

	ADD OBJECT 'Fechahora_sistema' AS fechahora_sistema WITH ;
		Left = 72, ;
		Name = "Fechahora_sistema", ;
		Top = 552, ;
		txt_fecha0.Name = "txt_fecha0", ;
		Line1.Name = "Line1", ;
		txt_hora.Name = "txt_hora", ;
		txt_fecha1.Name = "txt_fecha1", ;
		txt_fecha2.Name = "txt_fecha2", ;
		Timer1.Name = "Timer1"
		*< END OBJECT: ClassLib="objetos_especiales.vcx" BaseClass="container" />

	ADD OBJECT 'img_pantalla' AS image WITH ;
		Height = 1200, ;
		Left = 0, ;
		Name = "img_pantalla", ;
		Picture = ..\imagen\fondo1.png, ;
		Stretch = 2, ;
		Top = 0, ;
		Width = 1600
		*< END OBJECT: BaseClass="image" />
	
	PROCEDURE Init
		this.img_pantalla.Width  =this.Parent.width
		this.img_pantalla.Height =this.Parent.Height
		
		this.cnt_tareas.Left   =this.Parent.width
		this.cnt_tareas.Height =_screen.Height-80
		
		this.cnt_tareas.grd_tareas.Height=(_screen.Height-80)/2
	ENDPROC

	PROCEDURE Btn_mostrar.Image1.Click
		this.Parent.Parent.cnt_tareas.Left=this.Parent.Parent.Width-458
		
		this.Visible= .F.
		this.Parent.Visible= .F.
		
		this.Parent.Parent.cnt_tareas.timer1.Enabled= .F.
		
		
		
	ENDPROC

	PROCEDURE cnt_tareas.Btn_ocultar.Image1.Click
		
		this.Parent.Parent.Left=this.Parent.Parent.Parent.width
		
		this.Parent.Parent.timer1.Interval=1000
		this.Parent.Parent.timer1.Enabled= .T.
		
		this.Parent.Parent.Parent.btn_mostrar.image1.visible= .T.
		this.Parent.Parent.Parent.btn_mostrar.visible= .T.
		
		
	ENDPROC

	PROCEDURE cnt_tareas.grd_tareas.Column3.cmd_esta.Click
		MESSAGEBOX("Mensaje de Prueba",0+64,"Aviso del Sistema")
	ENDPROC

	PROCEDURE cnt_tareas.grd_tareas.Column4.cmd_ver.Click
		MESSAGEBOX("Mensaje de Prueba 2",0+64,"Aviso del Sistema")
	ENDPROC

	PROCEDURE cnt_tareas.Timer1.Timer
		
		frmprinc= conectar_db(_screen.cn)
			SQLEXEC(frmprinc,"select tar_fech,tar_desc,'','' from tareas where tar_estado = 0 order by tar_fech;","cur_tarea")
		desconectar_db(frmprinc)
		
		IF RECCOUNT("cur_tarea") > 0
			LOCATE
			optar = MESSAGEBOX("ATENCIÓN!!!"+CHR(13)+CHR(13)+;
							   "Tiene tareas pendientes que requieren su atención."+CHR(13)+;
							   "Revise el panel de tareas.",0+48,"Aviso del Sistema")
			IF optar=1
				this.Parent.grd_tareas.Recordsource=""
				this.Parent.grd_tareas.Refresh
				SELECT * FROM cur_tarea INTO CURSOR curtar
				this.Parent.grd_tareas.RecordSource="curtar"
				this.Interval=120000
			ENDIF
		ENDIF
		
	ENDPROC

ENDDEFINE


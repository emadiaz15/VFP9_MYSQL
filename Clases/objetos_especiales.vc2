	PROCEDURE actualizarcotizaciondolar
		* === Container.Api_client_dolar.ActualizarCotizacionDolar ===
		LOCAL loApi, lcJson, lcMoneda, lcFecha, ;
		      lnCompra, lnVenta, lcCompraStr, lcVentaStr,lcUrl
		
		*-------------------------------------------------------
		* Asegurar dependencias cargadas
		*-------------------------------------------------------
		IF TYPE("APIClient") # "O"
		    SET PROCEDURE TO C:\VFP9_MYSQL\Prgs\api_client.prg ADDITIVE
		ENDIF
		IF TYPE("ConverNro") # "F"
		    SET PROCEDURE TO C:\VFP9_MYSQL\Prgs\librerias.prg ADDITIVE
		ENDIF
		IF TYPE("Crear_Estruc_Conex_MySQL") # "F"
		    SET PROCEDURE TO C:\VFP9_MYSQL\Prgs\librerias.prg ADDITIVE
		ENDIF
		
		TRY
		    *-------------------------------------------------------
		    * Crear cliente API y obtener datos
		    *-------------------------------------------------------
		  
		    loApi = CREATEOBJECT("APIClient")
		    
		    lcUrl = _screen.urlapi+':5000/"'
		    
		    loApi.SetBaseUrl(&lcUrl)
			
		    lcJson = ALLTRIM(loApi.Get("api/dolar", .F.))
		    IF EMPTY(lcJson)
		        RETURN .F.
		    ENDIF
		   
		    *-------------------------------------------------------
		    * Limpieza del JSON
		    *-------------------------------------------------------
		    lcJson = CHRTRAN(lcJson, CHR(13)+CHR(10)+CHR(9)+CHR(0), "")
			
		    IF LEFT(lcJson,3) == CHR(239)+CHR(187)+CHR(191)
		        lcJson = SUBSTR(lcJson, 4)
		    ENDIF
		    *-------------------------------------------------------
		    * Extraer STRINGS desde el JSON
		    *-------------------------------------------------------
		    lcMoneda    = ALLTRIM(STREXTRACT(lcJson, '"moneda":"', '",', 1))
		    lcFecha     = ALLTRIM(STREXTRACT(lcJson, '"ultima_actualizacion":"', '",', 1))
		    lcCompraStr = ALLTRIM(STREXTRACT(lcJson, '"compra":"', '",', 1))
		    lcVentaStr  = ALLTRIM(STREXTRACT(lcJson, '"venta":"', '"}', 1))
		
		    *-------------------------------------------------------
		    * Convertir a número REAL (ConverNro ya normaliza)
		    *-------------------------------------------------------
		    lnCompra = ConverNro(lcCompraStr)
			IF ALLTRIM(lcVentaStr) = 'null'
				lnVenta = 0
		*!*			this.valorinivta = 0
			ELSE
				lnVenta  = ConverNro(lcVentaStr)
		*!*			this.valorinivta = ConverNro(lcVentaStr)
			ENDIF
		
		*!*	    IF lnCompra <= 0 OR lnVenta <= 0
		*!*	        RETURN .F.
		*!*	    ENDIF
		
		*!*	    *-------------------------------------------------------
		*!*	    * RENDERIZAR LA CLASE VISUAL
		*!*	    *-------------------------------------------------------
		*!*	    THIS.moneda.Caption      = lcMoneda
		*!*	    THIS.ultcoti.Caption     = lcFecha
		*!*	    THIS.valorcompra.Caption = "$ " + TRANSFORM(lnCompra, "9,999.99")
		*!*	    THIS.valorventa.Caption  = "$ " + TRANSFORM(lnVenta,  "9,999.99")    	
		
		    *-------------------------------------------------------
		    * RENDERIZAR VALORES PARAMETRIZADOS
		    *-------------------------------------------------------
		    IF USED("cur_dolof")
			    THIS.moneda.Caption      = "Dolar Oficial BNA"
			    THIS.ultcoti.Caption     = DTOC(cur_fechora.param_fechora)+" "+SUBSTR(TTOC(cur_fechora.param_fechora,2),1,5)
			    THIS.valorcompra.Caption = "$ " + TRANSFORM(cur_dolcpra.param_impo, "9,999.99")
			    THIS.valorventa.Caption  = "$ " + TRANSFORM(cur_dolof.param_impo,  "9,999.99")
		    ENDIF
		    
		    *-------------------------------------------------------
		    * Enviar el valor de venta al método de DB
		    *-------------------------------------------------------
		
			THIS.actualizardolaroficial(lnVenta,lnCompra,lcMoneda,lcFecha)
		
		CATCH TO loEx
		    
		ENDTRY
		
		RETURN
		
	ENDPROC

	PROCEDURE actualizardolaroficial
		* === Container.Api_client_dolar.ActualizarDolarOficial ===
		LPARAMETERS lnVenta,lnCompra,lcMoneda,lcFecha
		
		LOCAL nCon, lcSQL, lcConnStr, lnValor, xcodhis, xfechor, xvalhis, xCadetran
		
		*-------------------------------------------------------
		* Dependencias (por las dudas, para ConverNro y conexión)
		*-------------------------------------------------------
		IF TYPE("ConverNro") # "F"
		    SET PROCEDURE TO C:\VFP9_MYSQL\Prgs\librerias.prg ADDITIVE
		ENDIF
		IF TYPE("Crear_Estruc_Conex_MySQL") # "F"
		    SET PROCEDURE TO C:\VFP9_MYSQL\Prgs\librerias.prg ADDITIVE
		ENDIF
		
		*-------------------------------------------------------
		* Normalizar y validar lnVenta
		*-------------------------------------------------------
		
		*!*	IF lnVenta <= 0
		*!*	    RETURN .F.
		*!*	ENDIF
		
		*-------------------------------------------------------
		* Cadena de conexión
		*-------------------------------------------------------
		*!*	IF TYPE("_SCREEN.cn") = "C" AND !EMPTY(_SCREEN.cn)
		*!*	    lcConnStr = _SCREEN.cn
		*!*	ELSE
		*!*	    lcConnStr = Crear_Estruc_Conex_MySQL("USER_CONNECT")
		*!*	ENDIF
		
		*-------------------------------------------------------
		* Conectar
		*-------------------------------------------------------
		nCon = Conectar_DB(_screen.cn)
		IF nCon <= 0
		    RETURN .F.
		ENDIF
		
			IF this.valorinivta<>lnVenta
		*!*		IF cur_cambio.param_impo<>lnVenta
		*-------------------------------------------------------
		* SQL FINAL (SIN comillas basura, SIN macro)
		*-------------------------------------------------------
		*!*			lcSQL = ;
		*!*			    "UPDATE parametros SET " + ;
		*!*			    "param_impo = " + TRANSFORM(lnVenta, "999999.99") + ", " + ;
		*!*			    "param_fec = CURDATE(), " + ;
		*!*			    "param_fechora = NOW() " + ;
		*!*			    "WHERE param_codi = 14"
		
		*!*			*-------------------------------------------------------
		*!*			* Ejecutar
		*!*			*-------------------------------------------------------
		*!*			IF SQLEXEC(nCon, lcSQL) < 0
		*!*			    Desconectar_DB(nCon)
		*!*			    RETURN .F.
		*!*			ENDIF
				********************************************************************************************
				*-------------------------------------------------------
				* SQL FINAL (SIN comillas basura, SIN macro)
				*-------------------------------------------------------
		
		*!*			IF SQLEXEC(nCon, "select param_impo from parametros where param_codi = 15;","cur_valaju") < 0
		*!*			    Desconectar_DB(nCon)
		*!*			    RETURN .F.
		*!*			ELSE
		*!*				SELECT * FROM cur_valaju INTO ARRAY ar_ajudolof
		*!*			ENDIF
				IF lnVenta > 0 
					lcSQL2 = ;
					    "UPDATE parametros SET " + ;
					    "param_impo = " + TRANSFORM(lnVenta, "999999.99") + ", " + ;
					    "param_fec = CURDATE(), " + ;
					    "param_fechora = NOW() " + ;
					    "WHERE param_codi = 14"
		
					lcSQL3 = ;
					    "UPDATE parametros SET " + ;
					    "param_impo = " + TRANSFORM(lnVenta*((100-_screen.dolaraju)/100), "999999.99") + ", " + ;
					    "param_fec = CURDATE(), " + ;
					    "param_fechora = NOW() " + ;
					    "WHERE param_codi = 9"
		
					lcSQL4 = ;
					    "UPDATE parametros SET " + ;
					    "param_impo = " + TRANSFORM(lnCompra, "999999.99") + ", " + ;
					    "param_fec = CURDATE(), " + ;
					    "param_fechora = NOW() " + ;
					    "WHERE param_codi = 18"
		
		*!*				xfechor=DATETIME()
		*!*				xvalhis=TRANSFORM(lnVenta, "999999.99")
		*!*				lcSQL5 = ;
		*!*				    "INSERT INTO histocoti " + ;
		*!*				    "VALUES(null,?xfechor,?xvalhis)"
		
			    	this.valorinivta = lnVenta
		
		
					*-------------------------------------------------------
					* Ejecutar
					*-------------------------------------------------------
					IF SQLEXEC(nCon, lcSQL2) < 0
					    Desconectar_DB(nCon)
					    RETURN .F.
					ENDIF
		
					IF SQLEXEC(nCon, lcSQL3) < 0
					    Desconectar_DB(nCon)
					    RETURN .F.
					ENDIF
					
					IF SQLEXEC(nCon, lcSQL4) < 0
					    Desconectar_DB(nCon)
					    RETURN .F.
					ENDIF
					
		*!*				IF SQLEXEC(nCon, lcSQL5) < 0
		*!*				    Desconectar_DB(nCon)
		*!*				    RETURN .F.
		*!*				ENDIF		
				ENDIF
			ENDIF
		    *-------------------------------------------------------
		    * RENDERIZAR LA CLASE VISUAL
		    *-------------------------------------------------------
		    THIS.moneda.Caption      = lcMoneda
		    THIS.ultcoti.Caption     = lcFecha
		    THIS.valorcompra.Caption = "$ " + TRANSFORM(lnCompra, "9,999.99")
		    THIS.valorventa.Caption  = "$ " + TRANSFORM(lnVenta,  "9,999.99")  
		
		Desconectar_DB(nCon)
		RETURN .T.
		*********************************************************************************************
	ENDPROC

	PROCEDURE Init
		&& api_client_dolar.init
		
		IF USED("cur_dolof")
			IF RECCOUNT("cur_dolof") > 0
				this.valorinivta = cur_dolof.param_impo
			ENDIF
		ENDIF
		
		IF USED("cur_dolcpra")
			IF RECCOUNT("cur_dolcpra") > 0
				this.valorinicpra= cur_dolcpra.param_impo
			ENDIF
		ENDIF
		
		this.estadoinicio = .T.
		THIS.actualizarcotizaciondolar()
		
		IF USED("cur_dolof")
			cerrar_cursor("cur_dolof")
		ENDIF
		IF USED("cur_dolcpra")
			cerrar_cursor("cur_dolcpra")
		ENDIF
		IF USED("cur_fechora")
			cerrar_cursor("cur_fechora")
		ENDIF
		
	ENDPROC

	PROCEDURE tmrActualizar.Timer
		&& api_dolarofical.tmrActualizar.Timer
		THIS.Parent.actualizarcotizaciondolar()
		
	ENDPROC

ENDDEFINE

DEFINE CLASS cmb_filtroabierto AS combobox 
 	*< CLASSDATA: Baseclass="combobox" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<PropValue>
		Height = 24
		IncrementalSearch = .F.
		Name = "cmb_filtroabierto"
		RowSourceType = 2
		Width = 100
	*</PropValue>
	
	PROCEDURE InteractiveChange
		LOCAL codigoCaracter AS INTEGER
		LOCAL valorDisplay AS STRING
		LOCAL valorNuevoDisplay AS STRING
		LOCAL lnUltimaSeleccion AS INTEGER
		LOCAL lnSeleccionados AS INTEGER
		codigoCaracter = LASTKEY()
		valorNuevoDisplay = ""
		lnUltimaSeleccion = 0
		lnSeleccionados = 0
		IF (codigoCaracter >= 32 AND codigoCaracter <= 126)
		  valorDisplay = SUBSTR(THIS.DISPLAYVALUE,1,THIS.SELSTART-1)+(CHR(codigoCaracter))
		  valorNuevoDisplay = THIS.DISPLAYVALUE
		  FOR i = 1 TO THIS.LISTCOUNT
		    IF UPPER(valorDisplay) $ UPPER(SUBSTR(THIS.LIST(i),1,LEN(valorDisplay)))
		      THIS.DISPLAYVALUE = THIS.LIST(i)
		      THIS.SELSTART = LEN(valorDisplay)
		      IF LEN(ALLT(THIS.DISPLAYVALUE)) > LEN(valorDisplay)
		        THIS.SELLENGTH = LEN(ALLT(THIS.DISPLAYVALUE))-LEN(valorDisplay)
		      ELSE
		        THIS.SELLENGTH = 0
		      ENDIF
		      valorNuevoDisplay = THIS.DISPLAYVALUE
		      lnUltimaSeleccion = THIS.SELSTART
		      lnSeleccionados = THIS.SELLENGTH
		      RETURN
		    ENDIF
		  ENDFOR
		  THIS.DISPLAYVALUE = valorNuevoDisplay
		  THIS.SELSTART = IIF(lnUltimaSeleccion > 0, lnUltimaSeleccion, LEN(valorDisplay))
		  THIS.SELLENGTH = lnSeleccionados
		ENDIF
		
	ENDPROC

ENDDEFINE

DEFINE CLASS cmb_filtrocerrado AS combobox 
 	*< CLASSDATA: Baseclass="combobox" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: buscaregistros
		*m: filtraregistros
		*m: quitafiltroregistros
		*m: setaliascontrol
		*m: setcampofiltro
		*p: aliascontrol
		*p: cadenaintroducida
		*p: campofiltro
		*p: confiltro
		*p: finalseleccion
		*p: inicioseleccion
	*</DefinedPropArrayMethod>

	PROTECTED aliascontrol,cadenaintroducida,campofiltro,confiltro,finalseleccion,inicioseleccion
	*<PropValue>
		aliascontrol = ''
		cadenaintroducida = ''
		campofiltro = ''
		confiltro = .F.
		finalseleccion = 0
		Height = 24
		IncrementalSearch = .F.
		inicioseleccion = 0
		Name = "cmb_filtrocerrado"
		RowSourceType = 2
		Width = 100
	*</PropValue>
	
	PROCEDURE buscaregistros
		LPARAMETERS _CodigoCaracter AS INTEGER
		
		THIS.QuitaFiltroRegistros()
		FOR i = 1 TO THIS.LISTCOUNT
		  IF UPPER(LEFT(THIS.LIST[i],LEN(THIS.cadenaIntroducida))) == ;
		      ALLTRIM(UPPER(THIS.cadenaIntroducida))
		    THIS.DISPLAYVALUE = THIS.LIST(i)
		    THIS.SELSTART = ATC(UPPER(THIS.cadenaIntroducida), ;
		      UPPER(THIS.LIST[i]), 1)-1
		    THIS.SELLENGTH = LEN(THIS.cadenaIntroducida)
		    THIS.FiltraRegistros()
		    RETURN
		  ENDIF
		ENDFOR
		FOR i = 1 TO THIS.LISTCOUNT
		  IF UPPER(THIS.cadenaIntroducida) $ UPPER(THIS.LIST(i))
		    THIS.DISPLAYVALUE = THIS.LIST(i)
		    THIS.SELSTART = ATC(UPPER(THIS.cadenaIntroducida), ;
		      UPPER(THIS.LIST[i]), 1)-1
		    THIS.SELLENGTH = LEN(THIS.cadenaIntroducida)
		    THIS.FiltraRegistros()
		    RETURN
		  ENDIF
		ENDFOR
		THIS.cadenaIntroducida= CHR(_CodigoCaracter)
		THIS.VALUE = CHR(_CodigoCaracter)
		THIS.DISPLAYVALUE = THIS.VALUE
		THIS.SELSTART = 0
		THIS.SELLENGTH = 1
		
	ENDPROC

	HIDDEN PROCEDURE filtraregistros
		LOCAL campo
		LOCAL aliasTabla
		PUBLIC textoSeleccionadoFiltro AS STRING
		IF THIS.conFiltro
		  campo = THIS.campoFiltro
		  aliasTabla = THIS.aliasControl
		  textoSeleccionadoFiltro = THIS.SELTEXT
		  SET FILTER TO (textoSeleccionadoFiltro $ &campo) IN &aliasTabla
		  THIS.REQUERY
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		*!*	PROTECTED cadenaIntroducida AS STRING
		*!*	PROTECTED inicioSeleccion AS INTEGER
		*!*	PROTECTED finalSeleccion AS INTEGER
		
		*!*	PROTECTED aliasControl AS STRING
		*!*	PROTECTED campoFiltro AS STRING
		*!*	PROTECTED conFiltro AS Boolean
		
		DODEFAULT()
		THIS.cadenaIntroducida = ''
		THIS.aliasControl = ''
		THIS.campoFiltro = ''
		THIS.conFiltro = .F.
		
	ENDPROC

	PROCEDURE InteractiveChange
		LOCAL codigoCaracter AS INTEGER
		LOCAL tamañoCadena AS INTEGER
		
		codigoCaracter = LASTKEY()
		IF codigoCaracter = 127
		  tamañoCadena = LEN(THIS.cadenaIntroducida)
		  IF tamañoCadena > 1
		    THIS.cadenaIntroducida = LEFT(THIS.cadenaIntroducida, ;
		      LEN(THIS.cadenaIntroducida)-1)
		    THIS.BuscaRegistros(codigoCaracter)
		  ELSE
		    THIS.cadenaIntroducida = ''
		    THIS.VALUE = ''
		    THIS.SELSTART = 0
		    THIS.SELLENGTH = 0
		    THIS.QuitaFiltroRegistros()
		  ENDIF
		ELSE
		  IF BETWEEN(codigoCaracter,32,255)
		    THIS.cadenaIntroducida = THIS.cadenaIntroducida + CHR(codigoCaracter)
		    THIS.BuscaRegistros(codigoCaracter)
		  ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE quitafiltroregistros
		LOCAL aliasTabla
		IF THIS.conFiltro
		  aliasTabla =THIS.aliasControl
		  SET FILTER TO IN &aliasTabla
		  THIS.REQUERY
		ENDIF
		
	ENDPROC

	PROCEDURE setaliascontrol
		LPARAMETERS _Alias AS STRING
		
		THIS.aliasControl = _Alias
		
	ENDPROC

	PROCEDURE setcampofiltro
		LPARAMETERS _Campo AS STRING
		
		THIS.conFiltro = .T.
		THIS.campoFiltro = _Campo
		
	ENDPROC

ENDDEFINE


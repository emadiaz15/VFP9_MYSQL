		Height = 661, ;
		Left = 720, ;
		Name = "cnt_tareas", ;
		SpecialEffect = 0, ;
		Top = 0, ;
		Visible = .F., ;
		Width = 485
		*< END OBJECT: BaseClass="container" />

	ADD OBJECT 'cnt_tareas.Btn_ocultar' AS btn_right WITH ;
		Left = -13, ;
		Name = "Btn_ocultar", ;
		Top = 315, ;
		Image1.Name = "Image1"
		*< END OBJECT: ClassLib="botones_especiales.vcx" BaseClass="container" />

	ADD OBJECT 'cnt_tareas.grd_tareas' AS grid WITH ;
		AllowCellSelection = .T., ;
		AllowHeaderSizing = .F., ;
		AllowRowSizing = .F., ;
		BackColor = 245,245,245, ;

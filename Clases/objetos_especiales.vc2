		Visible = .F., ;
		Image1.Name = "Image1"
		*< END OBJECT: ClassLib="botones_especiales.vcx" BaseClass="container" />

	ADD OBJECT 'cnt_tareas' AS container WITH ;
		BackColor = 200,200,200, ;

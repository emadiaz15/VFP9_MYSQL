PROCEDURE BAR_2_OF_Proveedore_FB2P
	valorcadena=PROMPT()
	xmoneda=''
	
	DO FORM altaordmon WITH xmoneda TO cmoneda
	
	IF cmoneda.xmoneda = 'D' OR cmoneda.xmoneda = 'P'
		do form altaocpra WITH cmoneda.xmoneda
	ENDIF
ENDPROC && BAR_2_OF_Proveedore_FB2P


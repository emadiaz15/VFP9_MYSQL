PROCEDURE BAR_2_OF_Altas_FB2P
	valorcadena=PROMPT()
	
	xmoneda=''
	
	DO FORM altapremon WITH xmoneda TO cmoneda
	
	IF cmoneda.xmoneda = 'D' OR cmoneda.xmoneda = 'P'
		do form altapresup WITH cmoneda.xmoneda
	ENDIF
ENDPROC && BAR_2_OF_Altas_FB2P


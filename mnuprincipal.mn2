*<Procedures>
PROCEDURE BAR_1_OF_Registrode_FB2P
	public cond
	STORE 0 TO codp,cond,codicli
	valorcadena=prompt()
	do form altafactura with codp,cond,codicli
ENDPROC && BAR_1_OF_Registrode_FB2P

PROCEDURE BAR_2_OF_Registrode_FB2P
	public cond,codicli
	codicli=0
	cond=0
	valorcadena=PROMPT()
	do form pediload with codicli
ENDPROC && BAR_2_OF_Registrode_FB2P

PROCEDURE BAR_3_OF_Registrode_FB2P
	valorcadena=PROMPT()
	
	preg= MESSAGEBOX("¿Búsqueda Numérica?",3+32+512,"Aviso del Sistema")
	
	DO case
		CASE preg=6
			do form numremload
		CASE preg=7
			codicli = 0
			do form remload with codicli
	ENDCASE
ENDPROC && BAR_3_OF_Registrode_FB2P


DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text1" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: valores
	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "Form1"
		DoCreate = .T.
		Height = 334
		Left = 0
		Name = "Form1"
		Top = 0
		Width = 543
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		Caption = "Command1", ;
		Height = 27, ;
		Left = 204, ;
		Name = "Command1", ;
		Top = 96, ;
		Width = 96
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Text1' AS textbox WITH ;
		Height = 23, ;
		Left = 192, ;
		Name = "Text1", ;
		Top = 192, ;
		Width = 108
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE valores
		LPARAMETERS xv1,xv2
		
		preg = MESSAGEBOX("¿Esta seguro de pasar el valor?",32+4,"Aviso del Sistema")
		
		IF preg = 6
			xv3 = 1
		ENDIF
		
		RETURN xv3
		
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL xval1,xval2,xval3
		
		xval1 = 50
		xval2 = 150
		**xval3 = 0
		
		thisform.valores(xval1,xval2)&&,xval3)
		
		thisform.text1.Value = xval3
	ENDPROC

ENDDEFINE

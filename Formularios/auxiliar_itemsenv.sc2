	PROCEDURE Activate
		SELECT cur_itemsped
		LOCATE
		
		thisform.grd_itpres.RecordSource=''
		thisform.grd_itpres.Refresh
		thisform.grd_itpres.RecordSource="cur_itemsped"
		thisform.grd_itpres.SetAll("DynamicBackColor","Thisform.Colorfila(cur_itemsped.selart)","Column")
		thisform.grd_itpres.SetAll("DynamicForeColor","Thisform.Colorletra(cur_itemsped.selart,cur_itemsped.art_med)","Column")
		thisform.grd_itpres.COLUMN7.DynamicBackColor='RGB(144,238,144)'
		
		
		*!*	do case
		*!*		case rta=1
		*!*			do form altafactura with codp,cond,codicli
		*!*		case rta=2
		*!*			thisform.release
		*!*	endcase
		*!*	if x>0 and x=con and y=0
		*!*		thisform.release
		*!*	endif
	ENDPROC

	PROCEDURE colorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = .T.
					lnColor = RGB(0,120,215)
				CASE tnsel = .F.
					lnColor = RGB(255,255,255)
			ENDCASE
		Return(lnColor)
		
		
	ENDPROC

	PROCEDURE colorletra
		LParameters tnsel,tnalt
		
		Local ltColor
		
			DO case
				CASE tnsel = .T. AND tnalt <> 'ALT'
					ltColor = RGB(255,255,255)
				CASE tnsel = .T. AND tnalt = 'ALT'
					ltColor = RGB(0,255,0)
				CASE tnsel = .F. AND tnalt <> 'ALT'
					ltColor = RGB(0,0,0)
				CASE tnsel = .F. AND tnalt = 'ALT'
					ltColor = RGB(255,0,0)
			ENDCASE
		Return(ltColor)
	ENDPROC

	PROCEDURE Init
		parameter codp,cond,codicli
		public rta,f,b,x,con,y,localiz,elimi
		CREATE CURSOR cur_itemsped(selart L,nro_it N(5),artped_cant N(10,2),art_med C(3),art_codi N(8),art_desc M,dac_codi N(8),artped_codi N(8))
		localiz=0
		elimi=0
		SET DECIMALS TO 3
		frmitrem= conectar_db(_screen.cn)
			SQLEXEC(frmitrem,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dac_desc,a.artped_codi from pedidos_articulos a INNER JOIN articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.ped_codi=?codp;","cur_carped")
		desconectar_db(frmitrem)
		SET DECIMALS TO
		this.caption="Envio del pedido  Nº "+allt(STR(codp))+" de "+ALLTRIM(cur_clie.cli_nomb)
		rta=0
		i=1
		item=1
		x=0
		y=0
		b=0
		con=0
		GO top
		con=RECCOUNT("cur_carped")
		COUNT FOR cur_carped.artped_ent>0 TO x
		COUNT FOR cur_carped.artped_ent>0 AND cur_carped.artped_ent<cur_carped.artped_cant TO y
		
		*!*	do while ped_codi=codp and !eof()
		*!*		con=con+1
		*!*		if artped_ent>0
		*!*			x=x+1
		*!*			if artped_ent<artped_cant
		*!*				y=y+1
		*!*			endif
		*!*		endif
		*!*		skip
		*!*	enddo
		do case
			case x>0 and x=con and y>0
				messagebox("Este pedido ya fue enviado pero aún quedan items"+chr(13)+ ;
						   "con cantidades pendientes. Seleccione los items pendientes.",0+64,"Información importante")
			case x>0 and x=con and y=0
				messagebox("Este pedido ya fue enviado en su totalidad.",0+64,"Información importante")
				this.release
				do form pediload with codicli
			case x>0 and x<con
				messagebox("Este pedido ya fue enviado pero aún "+chr(13)+ ;
		                  "quedan items pendientes. Seleccione "+chr(13)+ ;
		                  "los items pendientes.",0+64,"Información importante")
		ENDCASE
		
		SELECT .F. as selart,00000 as nro_it,artped_cant-artped_ent as artped_cant,art_med,art_codi, ;
			   padr(left(IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artped_dasc),len(IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artped_dasc))),254," ") as art_desc, ;
			   dac_codi,artped_codi FROM cur_carped WHERE artped_ent<artped_cant INTO CURSOR cur_itemsped readwrite
		GO top
		LOCAL itp
		itp=1
		SCAN
			REPLACE nro_it WITH itp
			itp=itp+1
		ENDSCAN
		GO top
		
		cerrar_cursor("cur_carped")
		
		*!*	seek codp
		*!*	do while ped_codi=codp and !eof()
		*!*		do case
		*!*			case artped_ent<artped_cant
		*!*				this.lstpedcli.AddListItem(str(item,5), i,1)
		*!*				this.lstpedcli.AddListItem(str(artped_cant-artped_ent,10,2), i,2)
		*!*				this.lstpedcli.AddListItem("  "+articulos.art_med, i,3)
		*!*				item=item+1
		*!*				cadena="   "+repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
		*!*				this.lstpedcli.AddListItem(cadena, i,4)
		*!*				if art_codi=4 or art_codi=5
		*!*					this.lstpedcli.AddListItem(artped_dasc, i,5)
		*!*				else
		*!*					if dac_codi=0
		*!*						this.lstpedcli.AddListItem(articulos.art_desc, i,5)
		*!*					else
		*!*						this.lstpedcli.AddListItem(desc_articulos_clientes.dac_desc, i,5)
		*!*					endif
		*!*				endif
		*!*				this.lstpedcli.AddListItem(rtrim(str(artped_precio,10,4)), i,6)
		*!*		endcase
		*!*		i=i+1
		*!*		skip
		*!*	enddo
		*!*	skip-1
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL xcodsel
		xcodsel=0
		SELECT cur_itemsped
		GO top
		rta=1
		SCAN FOR selart=.T.
			xcodsel=cur_itemsped.art_codi
			frmitrem= conectar_db(_screen.cn)
				SQLEXEC(frmitrem,"select * from articulos where art_codi=?xcodsel;","cur_arex")
			desconectar_db(frmitrem)
			if cur_arex.art_stock-cur_itemsped.artped_cant<0 and cur_arex.art_codi>5
				do form excedestock with rta
				exit
			ENDIF
			SELECT cur_itemsped
		ENDSCAN
		if rta=1
			do form altafactura with codp,cond,codicli
		endif
		thisform.hide
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command1.OLEDrag
		LPARAMETERS lDetectDrag
		this.command1.enabled=.T.
	ENDPROC

	PROCEDURE Command2.Click
		DO case
			CASE thisform.estadosel=0
				UPDATE cur_itemsped SET selart=.T.
				this.Caption="\<Deseleccionar Todos"
				thisform.command1.enabled=.T.
				thisform.estadosel=1
			CASE thisform.estadosel=1
				UPDATE cur_itemsped SET selart=.F.
				this.Caption="\<Seleccionar Todos"
				thisform.command1.enabled=.F.
				thisform.estadosel=0
		ENDCASE
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

ENDDEFINE

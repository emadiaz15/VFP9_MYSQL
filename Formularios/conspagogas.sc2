		set date british
		set cent on
		public totrec,totgral,totvalores,valorcadena,pasrecep,codpag,obser
		valorcadena=""
		obser=""
		thisform.xpago=codipag
		create cursor fac(gas_fech D,gas_codi N(8),gas_tipcbte C(2),gas_pto N(4),gas_cbte N(8),paggas_impo N(15,2),gas_conc C(1),parcial N(1))
		create cursor sic(sini_fech D,sini_cod N(8),pagsini_imp N(15,2),parcial N(1))
		CREATE CURSOR dic(debg_fech D,debg_codi N(8),pagdebi_imp N(15,2),parcial N(1))
		CREATE CURSOR cic(creg_fech D,creg_codi N(8),paggcrei_imp N(15,2),parcial N(1))
		create cursor facsic(gas_codi N(8),sini_cod N(8),debg_codi N(8),creg_codi N(8),gas_tipcbte C(2),gas_pto N(4), ;
						     gas_cbte N(8),facsic_fec D,paggas_impo N(15,2),pagsini_imp N(15,2),pagdebi_imp N(15,2),paggcrei_imp N(15,2),parcial N(1))
		
		
		create cursor totregis(instancia N(2),pagg_codi N(8),gas_codi N(8),sini_cod N(8),debg_codi N(8),creg_codi N(8),sa C(1),paggas_impo N(15,2),pagg_fech D, ;
		                       per_codi N(8),pagg_dtosaf N(15,2),pagg_antic N(15,2),pagg_restsaf N(15,2),pagsini_cod N(8),pagdebi_cod N(8),paggcrei_cod N(8), ;
		                       gas_conc C(1),gas_tipfac C(2),gas_pto N(4),gas_fac N(8),gas_fech D,sini_fech D,debg_fech D,creg_fech D,paggas_parci N(1), ;
		                       pagsini_parci N(1),pagdebi_parci N(1),paggcrei_parci N(1),pagpag_codi N(8),paggas_codi N(8), ;
		                       tippag_codi N(8),tippag_desc C(25),movtippag_nro C(14),ban_codi N(8),ban_desc C(45),ban_cuit N(11),movtippag_pza C(25), ;
		                       movtippag_fvto D,movtippag_imp N(15,2),cuit_lib N(11),parcial N(1))
		
		index on instancia to SYS(2015)
		importe=0
		totalfac=0
		totcred=0
		totdeb=0
		codrecpag=0
		pasrecep=0
		with this
			.text7.value=0
			.text8.value=0
			.text14.value=0
			.text15.value=0
			.text9.value=0
			.text10.value=0
			.text16.value=0
			.text17.value=0
			.text9.value=0
		ENDWITH
		if codipag>0
			frmconspag= conectar_db(_screen.cn)
				SQLEXEC(frmconspag,"select * from pagosgas where pagg_codi=?codipag;","cur_pago")
				codiper=cur_pago.per_codi
			desconectar_db(frmconspag)
			with thisform
				if paspago=1
					.command2.visible=.F.
				else
					.command2.visible=.T.
				endif
				.command2.enabled=.T.
				.command3.enabled=.T.
				thisform.cmd_OBSER.Enabled= .T.
				.text1.value=cur_per.per_desc
				.text2.value=cur_per.per_domi
				.text6.value=cur_per.cond_desc
				.text12.value=cur_per.per_cuit
				.text3.value=cur_per.cp_nro
				.text4.value=cur_per.loca_nomb
				.text5.value=cur_per.provi_nomb
				cuit=cur_per.per_cuit
				cond=cur_per.cond_codi
				if RECCOUNT("cur_pago")>0
					.text9.style=1
					.text10.style=1
					.text13.style=1
					.text7.value=cur_pago.pagg_impo+cur_pago.pagg_dtosaf
					.text10.value=cur_pago.pagg_codi
					.text13.value=cur_pago.pagg_fech
					.text16.value=cur_pago.pagg_antic
					.text17.value=cur_pago.pagg_dtoxpag
					.text9.value=cur_pago.pagg_dtosaf
					.text14.value=cur_pago.pagg_impo
					.text8.value=cur_pago.pagg_impo-cur_pago.pagg_dtoxpag
					obser=cur_pago.pagg_obser
					insert into totregis(instancia,pagg_codi,pagg_fech,per_codi);
								values(1,cur_pago.pagg_codi,cur_pago.pagg_fech,codiper)
					frmconspag= conectar_db(_screen.cn)
						SQLEXEC(frmconspag,"select b.gas_fech,b.gas_codi,b.gas_tipcbte,b.gas_pto,b.gas_cbte,a.paggas_impo,b.gas_conc,a.paggas_parci from pagosgas_gastos a inner join gastos b on a.gas_codi=b.gas_codi where a.pagg_codi=?codipag order by b.gas_codi;","fac")
						index on gas_codi to SYS(2015)
		
						SQLEXEC(frmconspag,"select b.sini_fech,b.sini_cod,a.pagsini_imp,a.pagsini_parci from pagos_saldosiniper a inner join saldosiniper b on a.sini_cod=b.sini_cod where a.pagg_codi=?codipag;","sic")
						index on sini_cod to SYS(2015)
		
						SQLEXEC(frmconspag,"SELECT b.debg_fech,a.debg_codi,a.pagdebi_imp,a.pagdebi_parci FROM pagosgas_debintg a INNER JOIN debintg b on a.debg_codi=b.debg_codi WHERE a.pagg_codi=?codipag;","dic")
						index on debg_codi to SYS(2015)
		
						SQLEXEC(frmconspag,"SELECT b.creg_fech,a.creg_codi,a.paggcrei_imp,a.paggcrei_parci FROM pagosgas_creintg a INNER JOIN creintg b on a.creg_codi=b.creg_codi WHERE a.pagg_codi=?codipag;","cic")
						index on creg_codi to SYS(2015)				
					desconectar_db(frmconspag)
					sele fac
					go top
					scan
						insert into facsic(gas_codi,sini_cod,debg_codi,creg_codi,gas_tipcbte,gas_pto,gas_cbte,facsic_fec,paggas_impo,pagsini_imp,pagdebi_imp,paggcrei_imp,parcial) ;
									values(fac.gas_codi,0,0,0,fac.gas_tipcbte,fac.gas_pto,fac.gas_cbte,fac.gas_fech,fac.paggas_impo,0,0,0,fac.paggas_parci)
					endscan
					sele sic
					go top
					scan
						insert into facsic(gas_codi,sini_cod,debg_codi,creg_codi,gas_tipcbte,gas_pto,gas_cbte,facsic_fec,paggas_impo,pagsini_imp,pagdebi_imp,paggcrei_imp,parcial) ;
									values(0,sic.sini_cod,0,0,"",0,0,sic.sini_fech,0,sic.pagsini_imp,0,0,sic.pagsini_parci)
					endscan
					sele dic
					go top
					scan
						insert into facsic(gas_codi,sini_cod,debg_codi,creg_codi,gas_tipcbte,gas_pto,gas_cbte,facsic_fec,paggas_impo,pagsini_imp,pagdebi_imp,paggcrei_imp,parcial) ;
									values(0,0,dic.debg_codi,0,"",0,0,dic.debg_fech,0,0,dic.pagdebi_imp,0,dic.pagdebi_parci)
					ENDSCAN
					sele cic
					go top
					scan
						insert into facsic(gas_codi,sini_cod,debg_codi,creg_codi,gas_tipcbte,gas_pto,gas_cbte,facsic_fec,paggas_impo,pagsini_imp,pagdebi_imp,paggcrei_imp,parcial) ;
									values(0,0,0,cic.creg_codi,"",0,0,cic.creg_fech,0,0,0,cic.paggcrei_imp,cic.paggcrei_parci)
					ENDSCAN
					
					sele facsic
					index on facsic_fec to SYS(2015)
					go top
					i=1
					SCAN
						DO case
							case gas_codi>0
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from gastos where gas_codi=?facsic.gas_codi;","faclis")
								desconectar_db(frmconspag)						
								.list1.list(i,1)=dtoc(facsic.facsic_fec)
								do case
									case faclis.gas_conc="F"
										.list1.list(i,2)=ICASE(faclis.gas_tipcbte="A","FA",faclis.gas_tipcbte="B","FB",faclis.gas_tipcbte="C","FC")
									case faclis.gas_conc="N"
										.list1.list(i,2)=ICASE(faclis.gas_tipcbte="A","NCA",faclis.gas_tipcbte="B","NCB",faclis.gas_tipcbte="C","NCC")
									case faclis.gas_conc="D"
										.list1.list(i,2)=ICASE(faclis.gas_tipcbte="A","NDA",faclis.gas_tipcbte="B","NDB",faclis.gas_tipcbte="C","NDC")
								ENDCASE
								.list1.list(i,3)=alltrim(str(faclis.gas_pto))
								.list1.list(i,4)=rtrim(str(faclis.gas_cbte))
								.list1.list(i,6)=str(faclis.gas_codi)
								.list1.list(i,5)=TRANSFORM(facsic.paggas_impo ,"$ 999,999,999.99")&& rtrim(str(facsic.paggas_impo,15,2))
								insert into totregis(instancia,gas_codi,gas_fech,gas_tipfac,gas_pto,gas_fac,gas_conc,paggas_impo,paggas_parci) ;
										values(1,faclis.gas_codi,faclis.gas_fech,faclis.gas_tipcbte,faclis.gas_pto,faclis.gas_cbte,faclis.gas_conc,facsic.paggas_impo,facsic.parcial)
							CASE sini_cod>0
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from saldosiniper where sini_cod=?facsic.sini_cod;","sinlis")
								desconectar_db(frmconspag)
								.list1.list(i,1)=dtoc(facsic.facsic_fec)
								.list1.list(i,2)="SIC"
								.list1.list(i,3)="0"
								.list1.list(i,4)=rtrim(str(sini_cod))
								.list1.list(i,5)=TRANSFORM(facsic.pagsini_imp ,"$ 999,999,999.99") && rtrim(str(facsic.pagsini_imp,15,2))
								.list1.list(i,6)=str(sinlis.sini_cod)
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from pagos_saldosiniper where pagg_codi=?codipag and sini_cod=?facsic.sini_cod;","reci_fac")
								desconectar_db(frmconspag)
								insert into totregis(instancia,sini_cod,sini_fech,pagsini_cod,paggas_impo,pagsini_parci) ;
										values(1,recfacsini.sini_cod,sinlis.sini_fech,reci_fac.recsini_cod,rec_fac.pagsini_imp,reci_fac.pagsini_parci)
								sele facsic
							case debg_codi>0
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from debintg where debg_codi=?facsic.debg_codi;","deblis")
								desconectar_db(frmconspag)
								.list1.list(i,1)=dtoc(deblis.debg_fech)
								.list1.list(i,2)="DIC"
								.list1.list(i,3)="0"
								.list1.list(i,4)=rtrim(str(deblis.debg_codi))
								.list1.list(i,5)=TRANSFORM(facsic.pagdebi_imp ,"$ 999,999,999.99") && rtrim(str(facsic.pagdebi_imp,15,2))
								.list1.list(i,6)=str(deblis.debg_codi)
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from pagosgas_debintg where pagg_codi=?codipag and debg_codi=?facsic.debg_codi;","reci_deb")
								desconectar_db(frmconspag)
								insert into totregis(instancia,debg_codi,debg_fech,pagdebi_cod,paggas_impo,pagdebi_parci) ;
										values(1,facsic.debg_codi,deblis.debg_fech,reci_deb.pagdebi_cod,facsic.pagdebi_imp,reci_deb.pagdebi_parci)
								sele facsic
							case creg_codi>0
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from creintg where creg_codi=?facsic.creg_codi;","crelis")
								desconectar_db(frmconspag)
								.list1.list(i,1)=dtoc(crelis.creg_fech)
								.list1.list(i,2)="CIC"
								.list1.list(i,3)="0"
								.list1.list(i,4)=rtrim(str(crelis.creg_codi))
								.list1.list(i,5)=TRANSFORM(facsic.paggcrei_imp ,"$ 999,999,999.99") && rtrim(str(facsic.paggcrei_imp,15,2))
								.list1.list(i,6)=str(crelis.creg_codi)
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from pagosgas_creintg where pagg_codi=?codipag and creg_codi=?facsic.creg_codi;","reci_cre")
								desconectar_db(frmconspag)
								insert into totregis(instancia,creg_codi,creg_fech,paggcrei_cod,paggas_impo,paggcrei_parci) ;
										values(1,facsic.creg_codi,crelis.creg_fech,reci_cre.paggcrei_cod,facsic.paggcrei_imp,reci_cre.paggcrei_parci)
								sele facsic						
						endcase
						i=i+1
					endscan
					frmconspag= conectar_db(_screen.cn)
						SQLEXEC(frmconspag,"select a.*,b.tippag_desc from pagosgas_pagos a inner join tipospago b on a.tippag_codi=b.tippag_codi where a.pagg_codi=?codipag order by pagpag_codi;","cur_pagpag")
					desconectar_db(frmconspag)
					IF RECCOUNT("cur_pagpag")>0
						GO top
						scan
							IF cur_pagpag.recpag_codi>0
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select a.*,b.* from recibos_pagos a inner join bancos b on a.ban_codi=b.ban_codi where recpag_codi=?cur_pagpag.recpag_codi;","cur_recipag")
								desconectar_db(frmconspag)
							ENDIF
							if cur_pagpag.tippag_codi=3 OR cur_pagpag.tippag_codi=20
								LOCAL xcuit
								xcuit=iif(recpag_codi>0,ALLTRIM(cur_recipag.cuit_lib),ALLTRIM(cuit_lib))
								cadenacuit=subst(xcuit,1,2)+"-"+subst(xcuit,3,8)+"-"+right(xcuit,1)
							else
								cadenacuit=""
							ENDIF
							if cur_pagpag.recpag_codi>0
								fvto=IIF(ISNULL(cur_recipag.movtippag_fvto),{  /  /    },cur_recipag.movtippag_fvto)
								.olecontrol1.additem(allt(cur_pagpag.tippag_desc)+chr(9)+IIF(cur_recipag.tippag_codi=20,allt(cur_recipag.movtippag_nro),allt(cur_recipag.chequenro))+chr(9)+ ;
												     cadenacuit+chr(9)+allt(cur_recipag.ban_desc)+chr(9)+allt(cur_recipag.movtippag_pza)+chr(9)+ ;
											   		 dtoc(fvto)+chr(9)+allt(str(cur_recipag.movtippag_imp,15,2))+CHR(9)+ALLTRIM(cur_recipag.cheqid)+CHR(9)+ALLTRIM(STR(cur_pagpag.recpag_codi)))
								.text15.value=.text15.value+cur_recipag.movtippag_imp
								insert into totregis(instancia,tippag_codi,tippag_desc,movtippag_nro,ban_codi,ban_desc,ban_cuit, ;
				                                     movtippag_pza,movtippag_fvto,movtippag_imp,cuit_lib) ;
				                             values(2,cur_pagpag.tippag_codi,cur_pagpag.tippag_desc,IIF(cur_recipag.tippag_codi=20,allt(cur_recipag.movtippag_nro),cur_recipag.chequenro), ;
				                             		cur_recipag.ban_codi,cur_recipag.ban_desc,VAL(cur_recipag.ban_cuit),cur_recipag.movtippag_pza, ;
				                             		fvto,cur_recipag.movtippag_imp, ;
				                             		VAL(cur_recipag.cuit_lib))
								SELECT cur_pagpag
							ELSE
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from bancos where ban_codi=?cur_pagpag.ban_codi;","cur_banpag")
								desconectar_db(frmconspag)
								fvto=IIF(ISNULL(cur_pagpag.movtippag_fvto),{  /  /    },cur_pagpag.movtippag_fvto)
								.olecontrol1.additem(allt(cur_pagpag.tippag_desc)+chr(9)+iif(cur_pagpag.tippag_codi=3,cur_pagpag.chequenro,allt(cur_pagpag.movtippag_nro))+chr(9)+ ;
												     cadenacuit+chr(9)+allt(cur_banpag.ban_desc)+chr(9)+allt(cur_pagpag.movtippag_pza)+chr(9)+ ;
											   		 dtoc(fvto)+chr(9)+allt(str(cur_pagpag.movtippag_imp,15,2))+CHR(9)+''+CHR(9)+'0')
								.text15.value=.text15.value+cur_pagpag.movtippag_imp
								insert into totregis(instancia,tippag_codi,tippag_desc,movtippag_nro,ban_codi,ban_desc,ban_cuit, ;
				                                     movtippag_pza,movtippag_fvto,movtippag_imp,cuit_lib) ;
				                             values(2,cur_pagpag.tippag_codi,cur_pagpag.tippag_desc,iif(cur_pagpag.tippag_codi=3,cur_pagpag.chequenro,allt(cur_pagpag.movtippag_nro)), ;
				                             		cur_pagpag.ban_codi,cur_banpag.ban_desc,VAL(cur_banpag.ban_cuit),cur_pagpag.movtippag_pza, ;
				                             		fvto,cur_pagpag.movtippag_imp, ;
				                             		VAL(cur_pagpag.cuit_lib))
			                endif
						ENDSCAN
					endif
				endif
		    ENDWITH
		endif
	ENDPROC

	PROCEDURE LostFocus
		set point to
		set separator to
	ENDPROC

	PROCEDURE cmd_obser.Click
		frmconspag= conectar_db(_screen.cn)
			SQLEXEC(frmconspag,"select TRIM(pagg_obser) pagg_obser from pagosgas where pagg_codi = ?thisform.xpago;","cur_obs")
		desconectar_db(frmconspag)
		
		IF RECCOUNT("cur_obs") > 0
			IF LEN(ALLTRIM(cur_obs.pagg_obser)) > 0
				=MESSAGEBOX(cur_obs.pagg_obser,64,"Observaciones")
			ELSE
				=MESSAGEBOX("Esta Orden de Pago no tiene Observaciones.",48,"Aviso del Sistema")
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_obser.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_obser.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		codiper=cur_per.per_codi
		do form pagoloadgas with codiper
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		local lcletra,xfecha
		
		SELECT totregis
		GO TOP
		
		xfecha="Río Cuarto, "+Dia_nombre(dow(totregis.pagg_fech)) +" "+ allt(str(DAY(totregis.pagg_fech)))+ ' de ' +Mes_nombre(month(totregis.pagg_fech))+ ' de '+allt(str(year(totregis.pagg_fech)))
		
		do monto2letra with thisform.text15.value,lcletra in ntoletra
		
		codpag=cur_pago.pagg_codi
		
		report form ordendepagas TO PRINTER PROMPT NOCONSOLE
		
		thisform.text9.setfocus
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE List1.Click
		*!*	if this.selected(this.listindex)
		*!*		this.selected(this.listindex)=.F.
		*!*	endif
	ENDPROC

	PROCEDURE List1.DblClick
		LOCAL codif
		codif=0
		with thisform
			for i=1 to this.listcount
				if this.selected(i)
					IF ALLTRIM(this.List(i,2))="DIC"
						pasdic=1
						codif=VAL(this.List(i,6))
						DO FORM consdebintgas with codif
					ELSE
		*!*					do case
		*!*						case subst(allt(.list1.list(i,2)),1,1)="F"
		*!*							valorcadena="Mercadería Recibida (Recepciones)"
		*!*					otherwise
		*!*						valorcadena="Notas de Crédito/Notas de Débito"
		*!*					endcase
						codrec=val(.list1.list(i,6))
		*!*					pasrecep=1
						do form consgastos with codrec,cond
					ENDIF
				endif
			next i
		endwith
	ENDPROC

	PROCEDURE Olecontrol1.DblClick
		*** ActiveX Control Event ***
		LOCAL xcodpag,xtipo
		this.col=8
		xcodpag=val(this.text)
		IF xcodpag>0
		this.col=0
			DO case
				CASE allt(this.text)="CHEQUE"
					do form conscheqrap with xcodpag,1
				CASE allt(this.text)="ECHEQ"
					do form conscheqrap with xcodpag,2
			ENDCASE
		ENDIF
	ENDPROC


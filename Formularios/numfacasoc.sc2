	PROCEDURE Init
		PARAMETERS codicli
		
		SET NOTIFY off
		frmnfac= conectar_db(_screen.cn)
			SQLEXEC(frmnfac,"select * from clientes where cli_codi=?codicli;","cur_clias")
			SQLEXEC(frmnfac,"select * from iva order by iva_codi desc limit 1;","cur_iva")
			SQLEXEC(frmnfac,"select fac_pto from facturas order by fac_codi desc limit 1;","cur_pto")	
		desconectar_db(frmnfac)
		STORE 0 TO thisform.txt_subt.Value,thisform.txt_iva1.Value,thisform.txt_iva2.value, ;
				   thisform.txt_tot.value,thisform.txt_nfac.value
		
		cond=cur_clias.cond_codi
		thisform.txt_cliente.Value=ALLTRIM(cur_clias.cli_nomb)
		thisform.cond =cur_clias.cond_codi
		thisform.lbl_iva1.Caption=thisform.lbl_iva1.Caption+" "+ALLTRIM(STR(cur_iva.iva_1,10,2))+"%:"
		thisform.lbl_iva2.Caption=thisform.lbl_iva2.Caption+" "+ALLTRIM(STR(cur_iva.iva_2,10,2))+"%:"
		thisform.txt_pto.Value=cur_pto.fac_pto
		thisform.txt_fecha.Value=''
		thisform.txt_pto.SetFocus
		
		thisform.lbl_tipcbte.Caption=IIF(cur_clias.cond_codi=2,"A","B")
		
		this.combo1.additem("FACTURA",1)
		DO case
			CASE _screen.tipoasoc="N"
				this.combo1.additem("N.DEBITO",2)
			CASE _screen.tipoasoc="D"
				this.combo1.additem("N.CREDITO",2)
		ENDCASE
		_screen.tipoasoc=""
		this.combo1.value="FACTURA"
	ENDPROC

	PROCEDURE verocultar
		LPARAMETERS xboolsel
		
		
		STORE xboolsel TO thisform.lbl_fec.Visible, ;
					      thisform.txt_fecha.Visible, ;
					      thisform.lbl_subt.Visible, ;
					      thisform.txt_subt.Visible, ;
					      thisform.lbl_iva1.Visible, ;
					      thisform.txt_iva1.Visible, ;
					      thisform.lbl_iva2.Visible, ;
					      thisform.txt_iva2.Visible, ;
					      thisform.lbl_tot.Visible, ;
					      thisform.txt_tot.Visible, ;
					      thisform.btn_verfac.Visible
	ENDPROC

	PROCEDURE btn_cancel.Click
		nroasoc=0
		estadoasoc=.F.
		thisform.Release
		
	ENDPROC

	PROCEDURE btn_cancel.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE btn_cancel.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE btn_cont.Click
		nroasoc   = thisform.txt_nfac.value
		estadoasoc=.T.
		
		IF PROMPT()<>"Notas de Débito"
			DO FORM itemsacred WITH cur_fas.fac_codi,cond,codicli
		ENDIF
		
		thisform.Release
		
	ENDPROC

	PROCEDURE btn_cont.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE btn_cont.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE btn_verfac.btn.Click
		LOCAL xcodifac,xcond
		pasfac=1
		
		xcodifac= thisform.codifac
		xcond   = thisform.cond
		
		do form consfactura WITH xcodifac,xcond
	ENDPROC

	PROCEDURE btn_verfac.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE btn_verfac.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE btn_verfac.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE txt_nfac.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE txt_nfac.Valid
		IF this.Value>0 AND LASTKEY()=13
			STORE 0 TO thisform.txt_subt.Value,thisform.txt_iva1.Value,thisform.txt_iva2.value, ;
				   thisform.txt_tot.value
			LOCAL dfac,fpto,fnro,ftip,letconc
			fpto=thisform.txt_pto.Value
			fnro=this.Value
			ftip=ALLTRIM(thisform.lbl_tipcbte.Caption)
			DO case
				CASE ALLTRIM(thisform.combo1.value)="FACTURA"
					letconc="F"
				CASE ALLTRIM(thisform.combo1.value)="N.CREDITO"
					letconc="N"
			ENDCASE
			frmnfac= conectar_db(_screen.cn)
				SQLEXEC(frmnfac,"select * from facturas where fac_pto=?fpto and fac_nro=?fnro and fac_tipo=?ftip and fac_conc=?letconc;","cur_fas")
			desconectar_db(frmnfac)
			IF RECCOUNT("cur_fas")>0
				IF cur_fas.cli_codi!=codicli
					MESSAGEBOX("El Número de comprobante ingresado no corresponde a "+ALLTRIM(thisform.txt_cliente.value)+"."+CHR(13)+ ;
							   "Verifique por favor.",0+48,"Aviso del Sistema")		
					this.Value=0
					
					thisform.verocultar(.F.)
					
					RETURN .F.
				ELSE
					_screen.vendasoc         =cur_fas.ven_codi
					_screen.porcodiasoc      =cur_fas.porc_codi
					_screen.otcomiasoc       =cur_fas.otra_comi
					thisform.codifac         =cur_fas.fac_codi
					thisform.txt_fecha.Value =cur_fas.fac_fec
					
					thisform.txt_subt.Value  =cur_fas.neto_1+cur_fas.neto_2 
					thisform.txt_iva1.Value  =cur_fas.fac_ivari
					thisform.txt_iva2.Value  =cur_fas.fac_ivarni
					thisform.txt_tot.Value   =thisform.txt_subt.Value+thisform.txt_iva1.Value+thisform.txt_iva2.Value
							
					thisform.verocultar(.T.)
					
					thisform.btn_cont.Enabled= .T.
					KEYBOARD '{TAB}'
				ENDIF
			ELSE
				MESSAGEBOX("Comprobante no se encuentra en archivo.",0+48,"Aviso del Sistema")
				thisform.btn_cont.Enabled= .F.
				
				thisform.verocultar(.F.)
				
				this.Value=0
				return .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txt_pto.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

ENDDEFINE

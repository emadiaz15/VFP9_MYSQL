	PROCEDURE Init
		public proveedor,codiprov,histcod
		proveedor=""
		codiprov=0
		histcod=0
		create cursor temppro(art_codi N(8))
		create cursor tmpcosto(art_codi N(8),art_desc C(45),costoant N(10,3),costoact N(10,3),artpro_codi N(8))
		with thisform
			.text3.value=0
		endwith
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(200,200,200)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Command1.Click
		codiprov=0
		do form provload with proveedor,codiprov
		if codiprov>0
			frmcxpro= conectar_db(_screen.cn)
				SQLEXEC(frmcxpro,"select a.art_codi,b.art_desc from articulos_proveedores a inner join articulos b on a.art_codi=b.art_codi where a.prov_codi=?codiprov and a.art_codi>5 order by a.art_codi;","temppro")
			desconectar_db(frmcxpro)
			if RECCOUNT("temppro")=0
				=messagebox("Aún no se han ingresado al sistema artículos que provea este Proveedor",0+48,"Advertencia!!!")
			else
				thisform.text1.value=cur_prov.prov_nomb
				thisform.text3.setfocus
			endif
		endif
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		thisform.grid1.recordsource=''
		thisform.grid1.Refresh()
		porcentaje=thisform.text3.value
		do case
			case thisform.optiongroup1.value=0
				=messagebox("No ha indicado si es un Aumento o un Descuento",0+48,"Advertencia!!!")
				this.enabled=.F.
			case thisform.optiongroup1.value=1
				SET DECIMALS TO 3
				frmcxpro= conectar_db(_screen.cn)
					SQLEXEC(frmcxpro,"call usp_modicostos(3,0,?codiprov,?porcentaje);","tmpcosto")
				desconectar_db(frmcxpro)
				SET DECIMALS TO
				GO top
				thisform.grid1.recordsource="tmpcosto"
				thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
				thisform.command4.enabled=.T.
			case thisform.optiongroup1.value=2
				SET DECIMALS TO 3
				frmcxpro= conectar_db(_screen.cn)
					SQLEXEC(frmcxpro,"call usp_modicostos(4,0,?codiprov,?porcentaje);","tmpcosto")
				desconectar_db(frmcxpro)
				SET DECIMALS TO
				GO top
				thisform.grid1.recordsource="tmpcosto"
				thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
				thisform.command4.enabled=.T.
		endcase
		
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		pregunta=messagebox("¿Confirma la modificación a efectuar?",4+48+256,"Costos")
		if pregunta=6
			LOCAL xfecha, conexterna
			xfecha=DATETIME()
			sele tmpcosto
			go top
			SCAN
				frmcxrub= conectar_db(_screen.cn)
					SQLEXEC(frmcxrub,"select * from articulos_proveedores where artpro_codi=?tmpcosto.artpro_codi;","fincostos")
				desconectar_db(frmcxrub)
				if RECCOUNT("fincostos")>0
					if tmpcosto.costoact<>fincostos.artpro_costo
						frmcxrub= conectar_db(_screen.cn)
							SQLEXEC(frmcxrub,"update articulos_proveedores set artpro_costo=?tmpcosto.costoact,artpro_ctovta=?tmpcosto.ctovtaact where artpro_codi=?tmpcosto.artpro_codi;")
							SQLEXEC(frmcxrub,"select CAST(histo_codi+1 as decimal(8,0)) as histo_codi from histocosto order by histo_codi desc limit 1;","cur_hisnvo")
							SQLEXEC(frmcxrub,"insert into histocosto values(?cur_hisnvo.histo_codi,?xfecha,?tmpcosto.costoact,?tmpcosto.ctovtaact,?fincostos.artpro_codi,?fincostos.moneda);")
						desconectar_db(frmcxrub)
						********************* SE CONECTA AL SERVIDOR ILUMET Y ACTUALIZA COSTOS DEL PROVEEDOR *************************
						conexterna = conectar_db(_screen.xconext)
						IF VARTYPE(conexterna)="N" AND conexterna>0
							SQLEXEC(conexterna,"select * from articulos_proveedores where artpro_codi=?tmpcosto.artpro_codi;","fincostos2")
							IF RECCOUNT("fincostos2")>0
								SQLEXEC(conexterna,"update articulos_proveedores set artpro_costo=?tmpcosto.costoact,artpro_ctovta=?tmpcosto.ctovtaact where artpro_codi=?tmpcosto.artpro_codi;")
								SQLEXEC(conexterna,"select CAST(histo_codi+1 as decimal(8,0)) as histo_codi from histocosto order by histo_codi desc limit 1;","cur_hisnvo2")
								SQLEXEC(conexterna,"insert into histocosto values(?cur_hisnvo2.histo_codi,?xfecha,?tmpcosto.costoact,?tmpcosto.ctovtaact,?fincostos2.artpro_codi,?fincostos2.moneda);")
							ENDIF
							desconectar_db(conexterna)
						ENDIF
						******************** FIN PROCESO SERVIDOR ILUMET ******************************************				
					endif
				endif
				sele tmpcosto
			endscan
			thisform.text1.value=""
			thisform.text3.value=0
			thisform.optiongroup1.value=0
			thisform.grid1.RecordSource=''
			thisform.grid1.Refresh()
			this.enabled=.F.
			thisform.command3.enabled=.F.
		endif
		
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10

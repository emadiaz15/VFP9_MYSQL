	ENDPROC

	PROCEDURE Command5.Click
		thisform.release
	ENDPROC

	PROCEDURE Command5.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command5.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Optiongroup1.Click
		if this.value>0
			if thisform.text3.value>0 and codiprov>0
				thisform.command3.enabled=.T.
			endif
		endif
	ENDPROC

ENDDEFINE

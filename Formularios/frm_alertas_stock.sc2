	PROCEDURE principal.grd_alerts.AfterRowColChange
		*=========================================================
		* principal.grd_alerts.AfterRowColChange
		*=========================================================
		LPARAMETERS nColIndex
		
		IF !USED("cur_alerts") OR EOF("cur_alerts")
		    RETURN
		ENDIF
		
		*-- Mantener auxiliares del registro actual
		IF PEMSTATUS(THIS, "Parent", 5) AND PEMSTATUS(THIS.Parent, "xCurArt", 5)
		    THIS.Parent.xCurArt = IIF(TYPE("cur_alerts.art_codi") = "N", cur_alerts.art_codi, 0)
		ENDIF
		
		IF PEMSTATUS(THIS, "Parent", 5) AND PEMSTATUS(THIS.Parent, "xCurRec", 5)
		    THIS.Parent.xCurRec = RECNO("cur_alerts")
		ENDIF
		
		*-- Efecto visual puro
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		    THISFORMSET.ActualizarEfectoGrid(0)
		ENDIF
		
		*-- Dependencias del artículo actual
		IF PEMSTATUS(THISFORMSET, "ActualizarDependenciasArticuloActual", 5)
		    THISFORMSET.ActualizarDependenciasArticuloActual()
		ENDIF
		
		*-- Refrescos auxiliares
		IF PEMSTATUS(THISFORMSET, "RefreshVentaCompraGrid", 5)
		    THISFORMSET.RefreshVentaCompraGrid()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "BindMetricTexts", 5)
		    THISFORMSET.BindMetricTexts()
		ENDIF
		
		*-- shpSelRow siempre visible al navegar
		IF PEMSTATUS(THISFORM, "shpSelRow", 5)
		    THISFORM.shpSelRow.Visible = .T.
		ENDIF
		
		TRY
		    THIS.SetFocus()
		CATCH
		ENDTRY
		
		RETURN
	ENDPROC

	PROCEDURE principal.grd_alerts.BeforeRowColChange
		*=========================================================
		* principal.grd_alerts.BeforeRowColChange
		*=========================================================
		LPARAMETERS nColIndex
		
		IF !PEMSTATUS(THISFORM, "xDblClickRec", 5)
		    RETURN
		ENDIF
		
		IF THISFORM.xDblClickRec > 0
		    SELECT cur_alerts
		    GO THISFORM.xDblClickRec
		    THISFORM.xDblClickRec = 0
		    NODEFAULT
		ENDIF
	ENDPROC

	PROCEDURE principal.grd_alerts.Click
		*=========================================================
		* principal.grd_alerts.Click
		*=========================================================
		LOCAL lnCol
		
		IF !USED("cur_alerts") OR EOF("cur_alerts")
		    RETURN
		ENDIF
		
		*-- Ignorar clicks durante DblClick
		IF PEMSTATUS(THISFORMSET, "xEnDblClick", 5) AND THISFORMSET.xEnDblClick
		    NODEFAULT
		    RETURN
		ENDIF
		
		lnCol = THIS.ActiveColumn
		
		*-- Col 12 y 13: sin acción en click simple
		IF lnCol = 12 OR lnCol = 13
		    TRY
		        THIS.SetFocus()
		    CATCH
		    ENDTRY
		    IF PEMSTATUS(THISFORM, "shpSelRow", 5)
		        THISFORM.shpSelRow.Visible = .T.
		    ENDIF
		    NODEFAULT
		    RETURN
		ENDIF
		
		*-- Resto de columnas: comportamiento por fila
		TRY
		    THIS.SetFocus()
		CATCH
		ENDTRY
		
		IF PEMSTATUS(THISFORM, "shpSelRow", 5)
		    THISFORM.shpSelRow.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "GridClick", 5)
		    THISFORMSET.GridClick()
		ENDIF
		
		NODEFAULT
		
		IF PEMSTATUS(THISFORMSET, "CargarClientesArticuloSeleccionado", 5)
		    THISFORMSET.CargarClientesArticuloSeleccionado()
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE principal.grd_alerts.Column10.Header1.Click
		IF PEMSTATUS(THISFORMSET, "SortAlertsByField", 5)
		    THISFORMSET.SortAlertsByField("prov_nomb_sel")
		ENDIF
		IF PEMSTATUS(THISFORM, "chkOrdenColor", 5)
		    THISFORM.chkOrdenColor.Value = .F.
		    IF PEMSTATUS(THISFORM, "xOrdenColorDesc", 5)
		        THISFORM.xOrdenColorDesc = .F.
		    ENDIF
		ENDIF
		IF PEMSTATUS(THISFORMSET, "UpdateGridHeaderSortUI", 5)
		    THISFORMSET.UpdateGridHeaderSortUI()
		ENDIF
		GO TOP IN cur_alerts
		THISFORM.grd_alerts.SetFocus()
	ENDPROC

	PROCEDURE principal.grd_alerts.Column11.Header1.Click
		IF PEMSTATUS(THISFORMSET, "SortAlertsByField", 5)
		    THISFORMSET.SortAlertsByField("artpro_costo")
		ENDIF
		IF PEMSTATUS(THISFORM, "chkOrdenColor", 5)
		    THISFORM.chkOrdenColor.Value = .F.
		    IF PEMSTATUS(THISFORM, "xOrdenColorDesc", 5)
		        THISFORM.xOrdenColorDesc = .F.
		    ENDIF
		ENDIF
		IF PEMSTATUS(THISFORMSET, "UpdateGridHeaderSortUI", 5)

	PROCEDURE secundario.confirm_oc.Click
		*=========================================================
		* Generar OCs masivas por proveedor + validar solicitud
		* SIN LOCK/UNLOCK TABLES
		* + cambiar estado a COMPRADO
		* + guardar reportes en Escritorio
		*=========================================================
		
		LOCAL lnHandle, lnHandleAux, lcSql, lnNuevoNroOC, lnProvid, lnCountOC, lnDetId, lnDetInsertados
		LOCAL lcCursor, lcCampoCant, lcCampoMone, lcCampoProv, lcCampoArt, lcCampoPrec
		LOCAL lcCampoObs, lcCampoItem, lcCampoArtProCodi
		LOCAL xfecha, xmone, xcoti, xarti, xcant, xprec, valProvid
		LOCAL lcObsGeneral, lcObsItems, lcObsFinal
		LOCAL lnSoliCodi, llOk, lnInsCab, lnInsDet
		LOCAL lnSeqItem, xArtProCodi, lcCarpetaReportes
		LOCAL ARRAY laObs[1,2]
		LOCAL lnObsCount, lnIdx, lcObsActual, lcItemsActual, lcItemMostrar
		LOCAL llTieneObs, llTieneItem, llTieneArtPro
		LOCAL lcEstadoActual, llEstadoOk, llReportesOk, lcMsgFinal
		LOCAL lcProvDirecto, lcMonedaSrc, lcItemSrc, lcObsSrc, lcArtProSrc
		LOCAL lnProvResuelto, lnRowsBatch, xdasc, xdap, lcDescGrid, lcDescDB
		LOCAL lcCursorSafety, lcConcatBusq, lnCodIva
		LOCAL lcErr1, lcErr2, lcErr3, lcErr4, lcErr5
		LOCAL lcMsgErr
		
		LOCAL lnTranResuelto, lnTranCodiOC, lcTranNombSrc
		LOCAL llTieneTran, llTieneTranNomb
		LOCAL lcMsgMultiTran, lnProvTmp, lnTranTmp, lcTranTmp, lcProvTmp
		LOCAL llHayMultiTran
		LOCAL lcMsgSinTran, lnSinTran, lnConTran, lnRespTran
		LOCAL lnTranAsignar, lcTranAsignar
		
		LOCAL ARRAY laErrCab[1]
		LOCAL ARRAY laErrDet[1]
		LOCAL ARRAY laErrId[1]
		
		*---------------------------------------------------------
		* Inicializacion defensiva
		*---------------------------------------------------------
		lcCursor           = ""
		lcCampoCant        = ""
		lcCampoMone        = ""
		lcCampoProv        = ""
		lcCampoArt         = ""
		lcCampoPrec        = ""
		lcCampoObs         = ""
		lcCampoItem        = ""
		lcCampoArtProCodi  = ""
		
		llTieneObs         = .F.
		llTieneItem        = .F.
		llTieneArtPro      = .F.
		
		lnCodIva           = 1
		xcoti              = 0
		
		lcErr1             = ""
		lcErr2             = ""
		lcErr3             = ""
		lcErr4             = ""
		lcErr5             = ""
		lcMsgErr           = ""
		
		*---------------------------------------------------------
		* 1. Usar directamente cur_soli_det
		*---------------------------------------------------------
		lcCursor           = "cur_soli_det"
		lcCampoArt         = "art_codi"
		lcCampoCant        = "cant_soli"
		lcCampoPrec        = "artpro_costo"
		lcCampoMone        = "det_moneda"
		lcCampoProv        = "prov_codi"
		lcCampoObs         = "observacion"
		lcCampoItem        = "ui_item"
		lcCampoArtProCodi  = "artpro_codi"
		
		IF NOT USED(lcCursor)
		    MESSAGEBOX("No esta abierto el cursor cur_soli_det.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF TYPE("cur_soli_det.prov_codi") = "U" OR ;
		   TYPE("cur_soli_det.art_codi") = "U" OR ;
		   TYPE("cur_soli_det.cant_soli") = "U" OR ;
		   TYPE("cur_soli_det.artpro_costo") = "U" OR ;
		   TYPE("cur_soli_det.det_moneda") = "U"
		
		    MESSAGEBOX("cur_soli_det no tiene la estructura esperada.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		llTieneObs    = (TYPE("cur_soli_det.observacion") <> "U")
		llTieneItem   = (TYPE("cur_soli_det.ui_item") <> "U")
		llTieneArtPro = (TYPE("cur_soli_det.artpro_codi") <> "U")
		
		
		llTieneTran     = (TYPE("cur_soli_det.tran_codi") <> "U")
		llTieneTranNomb = (TYPE("cur_soli_det.tran_nomb") <> "U")
		
		*---------------------------------------------------------
		* 2. Resolver solicitud actual DESDE EL FORM SECUNDARIO
		*---------------------------------------------------------
		lnSoliCodi = 0
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    IF VARTYPE(THISFORMSET.secundario) = "O"
		        IF PEMSTATUS(THISFORMSET.secundario, "xSoliCodiActual", 5)
		            lnSoliCodi = VAL(TRANSFORM(NVL(THISFORMSET.secundario.xSoliCodiActual, 0)))
		        ENDIF
		    ENDIF
		ENDIF
		
		IF lnSoliCodi <= 0
		    MESSAGEBOX("No se pudo determinar el codigo de la solicitud actual.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 3. Validar que la solicitud siga PENDIENTE
		*---------------------------------------------------------
		llEstadoOk     = .F.
		lcEstadoActual = ""
		
		lnHandle = conectar_db(_screen.cn)
		
		IF lnHandle <= 0
		    MESSAGEBOX("No se pudo conectar a la base de datos.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF SQLEXEC(lnHandle, ;
		    "SELECT IFNULL(estado,'') AS estado FROM solicitud_compra WHERE soli_codi = ?lnSoliCodi", ;
		    "cur_estado_soli") > 0
		
		    IF USED("cur_estado_soli") AND RECCOUNT("cur_estado_soli") > 0
		        lcEstadoActual = UPPER(ALLTRIM(NVL(cur_estado_soli.estado, "")))
		
		        IF lcEstadoActual == "PENDIENTE"
		            llEstadoOk = .T.
		        ENDIF
		    ENDIF
		ENDIF
		
		IF USED("cur_estado_soli")
		    USE IN cur_estado_soli
		ENDIF
		
		desconectar_db(lnHandle)
		
		IF NOT llEstadoOk
		    IF PEMSTATUS(THISFORM, "confirm_oc", 5)
		        THISFORM.confirm_oc.Enabled = .F.
		        THISFORM.confirm_oc.Refresh()
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		
		*---------------------------------------------------------
		* 4. Campos opcionales
		*---------------------------------------------------------
		IF TYPE(lcCursor + ".observacion") <> "U"
		    lcCampoObs = "observacion"
		    llTieneObs = .T.
		ENDIF
		
		IF TYPE(lcCursor + ".ui_item") <> "U"
		    lcCampoItem = "ui_item"
		    llTieneItem = .T.
		ELSE
		    IF TYPE(lcCursor + ".item") <> "U"
		        lcCampoItem = "item"
		        llTieneItem = .T.
		    ELSE
		        IF TYPE(lcCursor + ".posicion_item") <> "U"
		            lcCampoItem = "posicion_item"
		            llTieneItem = .T.
		        ENDIF
		    ENDIF
		ENDIF
		
		IF TYPE(lcCursor + ".artpro_codi") <> "U"
		    lcCampoArtProCodi = "artpro_codi"
		    llTieneArtPro = .T.
		ENDIF
		
		*---------------------------------------------------------
		* 5. Obtener observacion general
		*---------------------------------------------------------
		lcObsGeneral = ""
		
		lnHandle = conectar_db(_screen.cn)
		
		IF lnHandle > 0
		    IF SQLEXEC(lnHandle, ;
		        "SELECT IFNULL(observaciones,'') AS observaciones FROM solicitud_compra WHERE soli_codi = ?lnSoliCodi", ;
		        "cur_soli_obs") > 0
		
		        IF USED("cur_soli_obs") AND RECCOUNT("cur_soli_obs") > 0
		            lcObsGeneral = ALLTRIM(NVL(cur_soli_obs.observaciones, ""))
		        ENDIF
		    ENDIF
		
		    IF USED("cur_soli_obs")
		        USE IN cur_soli_obs
		    ENDIF
		
		    desconectar_db(lnHandle)
		ENDIF
		
		*---------------------------------------------------------
		* 6. Leer cotizacion y codigo de IVA
		*---------------------------------------------------------
		xcoti    = 0
		lnCodIva = 1
		
		lnHandle = conectar_db(_screen.cn)
		
		IF lnHandle <= 0
		    MESSAGEBOX("No se pudo conectar a la base de datos.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF SQLEXEC(lnHandle, ;
		    "SELECT param_impo FROM parametros WHERE param_codi = 9", ;
		    "cur_coti") > 0
		
		    IF USED("cur_coti") AND RECCOUNT("cur_coti") > 0
		        xcoti = VAL(TRANSFORM(cur_coti.param_impo))
		    ENDIF
		ENDIF
		
		IF USED("cur_coti")
		    USE IN cur_coti
		ENDIF
		
		IF SQLEXEC(lnHandle, ;
		    "SELECT iva_codi FROM iva ORDER BY iva_codi DESC LIMIT 1", ;
		    "cur_iva_cod") > 0
		
		    IF USED("cur_iva_cod") AND RECCOUNT("cur_iva_cod") > 0
		        lnCodIva = VAL(TRANSFORM(cur_iva_cod.iva_codi))
		
		        IF lnCodIva <= 0
		            lnCodIva = 1
		        ENDIF
		    ENDIF
		ENDIF
		
		IF USED("cur_iva_cod")
		    USE IN cur_iva_cod
		ENDIF
		
		desconectar_db(lnHandle)
		
		*---------------------------------------------------------
		* 7. Crear carpeta de reportes en Escritorio
		*---------------------------------------------------------
		lcCarpetaReportes = ""
		
		IF PEMSTATUS(THISFORMSET, "ObtenerCarpetaReportesMasivos", 5)
		    lcCarpetaReportes = THISFORMSET.ObtenerCarpetaReportesMasivos(lnSoliCodi)
		ENDIF
		
		*---------------------------------------------------------
		* 7.1 Sincronizar cantidad editada en grid2
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "SincronizarCantidadGrid2", 5)
		    THISFORMSET.SincronizarCantidadGrid2()
		ENDIF
		
		*---------------------------------------------------------
		* 8. Crear cursor normalizado batch DESDE cur_soli_det
		*---------------------------------------------------------
		IF USED("cur_oc_batch")
		    USE IN cur_oc_batch
		ENDIF
		
		CREATE CURSOR cur_oc_batch ;
		    (prov_codi    N(8), ;
		     det_prov     C(80), ;
		     tran_codi    N(8), ;
		     tran_nomb    C(80), ;
		     art_codi     N(8), ;
		     cant         N(10,3), ;
		     precio       N(15,4), ;
		     moneda       C(3), ;
		     observacion  M, ;
		     ui_item      C(30), ;
		     artpro_codi  N(8), ;
		     desc_grid    M)
		
		IF NOT USED("cur_soli_det") OR RECCOUNT("cur_soli_det") = 0
		    MESSAGEBOX("cur_soli_det no tiene registros para normalizar.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		SELECT cur_soli_det
		GO TOP
		SCAN
		    xarti          = INT(NVL(cur_soli_det.art_codi, 0))
		    xcant          = NVL(cur_soli_det.cant_soli, 0)
		    xprec          = NVL(cur_soli_det.artpro_costo, 0)
		    lnProvResuelto = INT(NVL(cur_soli_det.prov_codi, 0))
		
			lnTranResuelto = 0
			IF llTieneTran
			    lnTranResuelto = INT(NVL(cur_soli_det.tran_codi, 0))
			ENDIF
		
			lcTranNombSrc = ""
			IF llTieneTranNomb
			    lcTranNombSrc = ALLTRIM(TRANSFORM(NVL(cur_soli_det.tran_nomb, "")))
			ENDIF
		
			lcProvDirecto = ""
			IF TYPE("cur_soli_det.det_prov") <> "U"
			    lcProvDirecto = ALLTRIM(TRANSFORM(NVL(cur_soli_det.det_prov, "")))
			ENDIF
		
		    IF EMPTY(xarti) OR xarti <= 0
		        LOOP
		    ENDIF
		
		    IF EMPTY(xcant) OR xcant <= 0
		        LOOP
		    ENDIF
		
		    IF EMPTY(lnProvResuelto) OR lnProvResuelto <= 0
		        LOOP
		    ENDIF
		
		    IF EMPTY(xprec) OR xprec <= 0
		        LOOP
		    ENDIF
		
		    lcMonedaSrc = UPPER(ALLTRIM(TRANSFORM(NVL(cur_soli_det.det_moneda, "P"))))
		
		    IF EMPTY(lcMonedaSrc)
		        lcMonedaSrc = "P"
		    ENDIF
		
		    lcItemSrc = ""
		    IF llTieneItem
		        lcItemSrc = ALLTRIM(TRANSFORM(NVL(cur_soli_det.ui_item, "")))
		    ENDIF
		
		    lcObsSrc = ""
		    IF llTieneObs
		        lcObsSrc = ALLTRIM(TRANSFORM(NVL(cur_soli_det.observacion, "")))
		    ENDIF
		
		    xArtProCodi = 0
		    IF llTieneArtPro
		        xArtProCodi = INT(NVL(cur_soli_det.artpro_codi, 0))
		    ENDIF
		
		    IF TYPE("cur_soli_det.art_desc") <> "U"
		        lcDescGrid = ALLTRIM(TRANSFORM(NVL(cur_soli_det.art_desc, "")))
		    ELSE
		        lcDescGrid = ""
		    ENDIF
		
			INSERT INTO cur_oc_batch ;
			    (prov_codi, det_prov, tran_codi, tran_nomb, art_codi, cant, precio, moneda, observacion, ui_item, artpro_codi, desc_grid) ;
			VALUES ;
			    (lnProvResuelto, lcProvDirecto, lnTranResuelto, lcTranNombSrc, xarti, xcant, xprec, lcMonedaSrc, lcObsSrc, lcItemSrc, xArtProCodi, lcDescGrid)
		
		ENDSCAN
		
		IF NOT USED("cur_oc_batch") OR RECCOUNT("cur_oc_batch") = 0
		
		    LOCAL lnTotDet, lnSinArt, lnSinCant, lnSinProv, lnSinCosto
		    STORE 0 TO lnTotDet, lnSinArt, lnSinCant, lnSinProv, lnSinCosto
		
		    IF USED("cur_soli_det")
		        SELECT cur_soli_det
		
		        COUNT TO lnTotDet
		        COUNT FOR NVL(art_codi, 0) <= 0 TO lnSinArt
		        COUNT FOR NVL(cant_soli, 0) <= 0 TO lnSinCant
		        COUNT FOR NVL(prov_codi, 0) <= 0 TO lnSinProv
		        COUNT FOR NVL(artpro_costo, 0) <= 0 TO lnSinCosto
		    ENDIF
		
		    MESSAGEBOX( ;
		        "No se pudo normalizar ningun item valido para generar OCs." + CHR(13) + CHR(13) + ;
		        "Solicitud actual: " + TRANSFORM(lnSoliCodi) + CHR(13) + ;
		        "Items en cur_soli_det: " + TRANSFORM(lnTotDet) + CHR(13) + ;
		        "Sin art_codi: " + TRANSFORM(lnSinArt) + CHR(13) + ;
		        "Sin cant_soli: " + TRANSFORM(lnSinCant) + CHR(13) + ;
		        "Sin prov_codi: " + TRANSFORM(lnSinProv) + CHR(13) + ;
		        "Sin artpro_costo: " + TRANSFORM(lnSinCosto), ;
		        48, ;
		        "Diagnostico OCs" ;
		    )
		
		    RETURN .F.
		ENDIF
		
		
		
		*---------------------------------------------------------
		* 8.1 Validar proveedores con articulos sin transporte
		*---------------------------------------------------------
		IF USED("cur_prov_sin_tran")
		    USE IN cur_prov_sin_tran
		ENDIF
		
		SELECT ;
		    prov_codi, ;
		    MAX(det_prov) AS det_prov, ;
		    SUM(IIF(NVL(tran_codi, 0) <= 0, 1, 0)) AS cant_sin_tran ;
		FROM cur_oc_batch ;
		WHERE prov_codi > 0 ;
		GROUP BY prov_codi ;
		INTO CURSOR cur_prov_sin_tran READWRITE
		
		IF USED("cur_prov_sin_tran") AND RECCOUNT("cur_prov_sin_tran") > 0
		
		    SELECT cur_prov_sin_tran
		    GO TOP
		
		    SCAN FOR NVL(cant_sin_tran, 0) > 0
		
		        lnProvTmp = INT(NVL(cur_prov_sin_tran.prov_codi, 0))
		        lcProvTmp = ALLTRIM(NVL(cur_prov_sin_tran.det_prov, ""))
		        lnSinTran = INT(NVL(cur_prov_sin_tran.cant_sin_tran, 0))
		
		        IF EMPTY(lcProvTmp)
		            lcProvTmp = "Proveedor " + ALLTRIM(TRANSFORM(lnProvTmp))
		        ENDIF
		
		        *-------------------------------------------------
		        * Buscar transportes existentes del mismo proveedor
		        *-------------------------------------------------
		        IF USED("cur_tran_prov_dist")
		            USE IN cur_tran_prov_dist
		        ENDIF
		
		        SELECT DISTINCT ;
		            tran_codi, ;
		            tran_nomb ;
		        FROM cur_oc_batch ;
		        WHERE prov_codi = lnProvTmp ;
		          AND NVL(tran_codi, 0) > 0 ;
		        INTO CURSOR cur_tran_prov_dist READWRITE
		
		        lnConTran = 0
		
		        IF USED("cur_tran_prov_dist")
		            lnConTran = RECCOUNT("cur_tran_prov_dist")
		        ENDIF
		
		        DO CASE
		
		        *-------------------------------------------------
		        * Caso A:
		        * Tiene articulos sin transporte
		        * y el resto del proveedor tiene UN transporte.
		        * Se puede asignar automaticamente.
		        *-------------------------------------------------
		        CASE lnConTran = 1
		
		            SELECT cur_tran_prov_dist
		            GO TOP
		
		            lnTranAsignar = INT(NVL(cur_tran_prov_dist.tran_codi, 0))
		            lcTranAsignar = ALLTRIM(NVL(cur_tran_prov_dist.tran_nomb, ""))
		
		            IF EMPTY(lcTranAsignar)
		                lcTranAsignar = "SIN NOMBRE"
		            ENDIF
		
		            lcMsgSinTran = ;
		                "El proveedor " + lcProvTmp + " [" + ALLTRIM(TRANSFORM(lnProvTmp)) + "] tiene " + ;
		                ALLTRIM(TRANSFORM(lnSinTran)) + " articulo/s sin transporte asignado." + CHR(13) + CHR(13) + ;
		                "Los demas articulos de este proveedor tienen asignado el transporte:" + CHR(13) + ;
		                ALLTRIM(TRANSFORM(lnTranAsignar)) + " / " + lcTranAsignar + CHR(13) + CHR(13) + ;
		                "Desea asignar este mismo transporte a los articulos sin transporte?" + CHR(13) + CHR(13) + ;
		                "Si responde NO, no se generara ninguna OC y podra volver a modificar la seleccion."
		
		            lnRespTran = MESSAGEBOX(lcMsgSinTran, 4 + 48, "Proveedor sin transporte")
		
		            IF lnRespTran = 6
		
		                SELECT cur_oc_batch
		                GO TOP
		
		                SCAN FOR prov_codi = lnProvTmp AND NVL(tran_codi, 0) <= 0
		                    REPLACE tran_codi WITH lnTranAsignar, ;
		                            tran_nomb WITH lcTranAsignar
		                ENDSCAN
		
		                SELECT cur_prov_sin_tran
		
		            ELSE
		
		                IF USED("cur_tran_prov_dist")
		                    USE IN cur_tran_prov_dist
		                ENDIF
		
		                RETURN .F.
		            ENDIF
		
		        *-------------------------------------------------
		        * Caso B:
		        * El proveedor no tiene ningun transporte asignado
		        * en ninguno de sus articulos.
		        * Puede continuar sin transporte.
		        *-------------------------------------------------
		        CASE lnConTran = 0
		
		            lcMsgSinTran = ;
		                "El proveedor " + lcProvTmp + " [" + ALLTRIM(TRANSFORM(lnProvTmp)) + "] no tiene transporte asignado." + CHR(13) + CHR(13) + ;
		                "No se encontro ningun transporte en los articulos de este proveedor." + CHR(13) + CHR(13) + ;
		                "Desea continuar y generar la OC sin transporte?" + CHR(13) + CHR(13) + ;
		                "Luego, si necesita modificar la OC, podra hacerlo desde la rutina de modificacion."
		
		            lnRespTran = MESSAGEBOX(lcMsgSinTran, 4 + 48, "Proveedor sin transporte")
		
		            IF lnRespTran <> 6
		                IF USED("cur_tran_prov_dist")
		                    USE IN cur_tran_prov_dist
		                ENDIF
		
		                RETURN .F.
		            ENDIF
		
		        *-------------------------------------------------
		        * Caso C:
		        * Hay articulos sin transporte, pero el proveedor
		        * tambien tiene varios transportes distintos.
		        * No se puede decidir automaticamente.
		        *-------------------------------------------------
		        CASE lnConTran > 1
		
		            lcMsgSinTran = ;
		                "El proveedor " + lcProvTmp + " [" + ALLTRIM(TRANSFORM(lnProvTmp)) + "] tiene articulos sin transporte asignado," + CHR(13) + ;
		                "pero tambien posee mas de un transporte diferente en otros articulos." + CHR(13) + CHR(13) + ;
		                "No se puede asignar automaticamente un transporte porque hay varias opciones posibles." + CHR(13) + CHR(13) + ;
		                "No se generara ninguna OC." + CHR(13) + ;
		                "Vuelva a modificar la seleccion de transportes y luego intente nuevamente."
		
		            MESSAGEBOX(lcMsgSinTran, 48, "Transportes incompletos")
		            
		            IF USED("cur_tran_prov_dist")
		                USE IN cur_tran_prov_dist
		            ENDIF
		
		            RETURN .F.
		
		        ENDCASE
		
		        IF USED("cur_tran_prov_dist")
		            USE IN cur_tran_prov_dist
		        ENDIF
		
		        SELECT cur_prov_sin_tran
		
		    ENDSCAN
		
		ENDIF
		
		
		
		*---------------------------------------------------------
		* 8.2 Avisar proveedores con mas de un transporte
		*---------------------------------------------------------
		llHayMultiTran = .F.
		lcMsgMultiTran = ""
		
		IF TYPE("cur_oc_batch.tran_codi") <> "U"
		
		    IF USED("cur_prov_tran_dist")
		        USE IN cur_prov_tran_dist
		    ENDIF
		
		    SELECT DISTINCT ;
		        prov_codi, ;
		        det_prov, ;
		        tran_codi, ;
		        tran_nomb ;
		    FROM cur_oc_batch ;
		    WHERE prov_codi > 0 ;
		    INTO CURSOR cur_prov_tran_dist READWRITE
		
		    IF USED("cur_prov_multi_tran")
		        USE IN cur_prov_multi_tran
		    ENDIF
		
		    SELECT ;
		        prov_codi, ;
		        MAX(det_prov) AS det_prov, ;
		        COUNT(*) AS cant_trans ;
		    FROM cur_prov_tran_dist ;
		    GROUP BY prov_codi ;
		    HAVING COUNT(*) > 1 ;
		    INTO CURSOR cur_prov_multi_tran READWRITE
		
		    IF USED("cur_prov_multi_tran") AND RECCOUNT("cur_prov_multi_tran") > 0
		
		        llHayMultiTran = .T.
		
		        lcMsgMultiTran = ;
		            "Se detectaron proveedores con mas de un transporte asignado." + CHR(13) + CHR(13) + ;
		            "Para respetar el transporte de cada despacho, se generara una OC por cada combinacion:" + CHR(13) + ;
		            "Proveedor + Transporte." + CHR(13) + CHR(13)
		
		        SELECT cur_prov_multi_tran
		        GO TOP
		
		        SCAN
		            lnProvTmp = INT(NVL(cur_prov_multi_tran.prov_codi, 0))
		            lcProvTmp = ALLTRIM(NVL(cur_prov_multi_tran.det_prov, ""))
		
		            IF EMPTY(lcProvTmp)
		                lcProvTmp = "Proveedor " + ALLTRIM(TRANSFORM(lnProvTmp))
		            ENDIF
		
		            lcMsgMultiTran = lcMsgMultiTran + ;
		                lcProvTmp + " [" + ALLTRIM(TRANSFORM(lnProvTmp)) + "]:" + CHR(13)
		
		            SELECT cur_prov_tran_dist
		            GO TOP
		
		            SCAN FOR INT(NVL(prov_codi, 0)) = lnProvTmp
		                lnTranTmp = INT(NVL(cur_prov_tran_dist.tran_codi, 0))
		                lcTranTmp = ALLTRIM(NVL(cur_prov_tran_dist.tran_nomb, ""))
		
		                IF EMPTY(lcTranTmp)
		                    lcTranTmp = "SIN TRANSPORTE"
		                ENDIF
		
		                lcMsgMultiTran = lcMsgMultiTran + ;
		                    "  - " + ALLTRIM(TRANSFORM(lnTranTmp)) + " / " + lcTranTmp + CHR(13)
		            ENDSCAN
		
		            lcMsgMultiTran = lcMsgMultiTran + CHR(13)
		
		            SELECT cur_prov_multi_tran
		        ENDSCAN
		
		        lcMsgMultiTran = lcMsgMultiTran + ;
		            "Si responde SI, el sistema continuara y generara OCs separadas por transporte." + CHR(13) + ;
		            "Si responde NO, no se generara ninguna OC y podra volver a modificar la seleccion de transportes." + CHR(13) + CHR(13) + ;
		            "Luego de generar una OC, si necesita modificarla, podra hacerlo desde la rutina de modificacion." + CHR(13) + CHR(13) + ;
		            "Desea continuar?"
		
		        IF MESSAGEBOX(lcMsgMultiTran, 4 + 48, "Transportes diferentes por proveedor") <> 6
		            RETURN .F.
		        ENDIF
		
		    ENDIF
		ENDIF
		
		
		
		*---------------------------------------------------------
		* 9. Confirmacion
		*---------------------------------------------------------
		IF MESSAGEBOX("Confirma la creacion de OCs por proveedor/transporte para la solicitud N " + ;
		              ALLTRIM(TRANSFORM(NVL(lnSoliCodi, 0))) + "?", ;
		              4 + 32, ;
		              "Ordenes de Compra") <> 6
		    RETURN .F.
		ENDIF
		
		xfecha       = DATE()
		lnCountOC    = 0
		llReportesOk = .T.
		
		*---------------------------------------------------------
		* 10. Cursor para registrar OCs generadas
		*---------------------------------------------------------
		IF USED("cur_ocs_generadas")
		    USE IN cur_ocs_generadas
		ENDIF
		
		CREATE CURSOR cur_ocs_generadas ;
		    (orden_codi N(8), ;
		     prov_codi  N(8), ;
		     tran_codi  N(8), ;
		     moneda     C(3), ;
		     archivo    M)
		
		*---------------------------------------------------------
		* 11. Armar lista de proveedores reales
		*---------------------------------------------------------
		IF USED("cur_provs_batch")
		    USE IN cur_provs_batch
		ENDIF
		
		SELECT DISTINCT ;
		    prov_codi, ;
		    tran_codi ;
		FROM cur_oc_batch ;
		WHERE prov_codi > 0 ;
		INTO CURSOR cur_provs_batch READWRITE
		
		IF NOT USED("cur_provs_batch") OR RECCOUNT("cur_provs_batch") = 0
		    MESSAGEBOX("No se encontraron proveedores validos para generar OCs.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 12. Proceso por proveedor + transporte
		*---------------------------------------------------------
		SELECT cur_provs_batch
		GO TOP
		
		SCAN
		    lnProvid = VAL(TRANSFORM(cur_provs_batch.prov_codi))
			lnTranCodiOC = INT(NVL(cur_provs_batch.tran_codi, 0))
			
		    IF EMPTY(lnProvid) OR lnProvid <= 0
		        LOOP
		    ENDIF
		
		    *---------------------------------------------
		    * Validar proveedor
		    *---------------------------------------------
		    IF USED("cur_prov_val")
		        USE IN cur_prov_val
		    ENDIF
		
		    lnHandle = conectar_db(_screen.cn)
		
		    IF lnHandle <= 0
		        LOOP
		    ENDIF
		
		    IF SQLEXEC(lnHandle, ;
		        "SELECT prov_codi FROM proveedores WHERE prov_codi = ?lnProvid", ;
		        "cur_prov_val") <= 0
		
		        IF USED("cur_prov_val")
		            USE IN cur_prov_val
		        ENDIF
		
		        desconectar_db(lnHandle)
		        LOOP
		    ENDIF
		
		    desconectar_db(lnHandle)
		
		    IF NOT USED("cur_prov_val") OR RECCOUNT("cur_prov_val") = 0
		        IF USED("cur_prov_val")
		            USE IN cur_prov_val
		        ENDIF
		
		        LOOP
		    ENDIF
		
		    IF USED("cur_prov_val")
		        USE IN cur_prov_val
		    ENDIF
		
		    *---------------------------------------------
		    * Cursor auxiliar rollback
		    *---------------------------------------------
		    IF USED("cur_oc_det_insertados")
		        USE IN cur_oc_det_insertados
		    ENDIF
		
		    CREATE CURSOR cur_oc_det_insertados ;
		        (art_codi N(8), ;
		         cant     N(10,3))
		
		    *---------------------------------------------
		    * Items del proveedor actual
		    *---------------------------------------------
		    IF USED("cur_items_oc_prov")
		        USE IN cur_items_oc_prov
		    ENDIF
		
			SELECT * ;
			    FROM cur_oc_batch ;
			    WHERE prov_codi = lnProvid ;
			      AND tran_codi = lnTranCodiOC ;
			    INTO CURSOR cur_items_oc_prov READWRITE
			    
		    IF NOT USED("cur_items_oc_prov") OR RECCOUNT("cur_items_oc_prov") = 0
		        LOOP
		    ENDIF
		
		    *---------------------------------------------
		    * Validar moneda unica
		    *---------------------------------------------
		    IF USED("cur_valida_mone")
		        USE IN cur_valida_mone
		    ENDIF
		
		    SELECT DISTINCT moneda ;
		        FROM cur_items_oc_prov ;
		        INTO CURSOR cur_valida_mone READWRITE
		
		    IF NOT USED("cur_valida_mone") OR RECCOUNT("cur_valida_mone") = 0
		        LOOP
		    ENDIF
		
		    IF RECCOUNT("cur_valida_mone") > 1
		        IF USED("cur_valida_mone")
		            USE IN cur_valida_mone
		        ENDIF
		
		        MESSAGEBOX("Proveedor ID " + ALLTRIM(TRANSFORM(lnProvid)) + ;
		                   " tiene mezcla de monedas. Se omite su OC.", ;
		                   48, ;
		                   "Aviso")
		        LOOP
		    ENDIF
		
		    SELECT cur_valida_mone
		    GO TOP
		
		    xmone = UPPER(ALLTRIM(TRANSFORM(NVL(cur_valida_mone.moneda, "P"))))
		
		    IF EMPTY(xmone)
		        xmone = "P"
		    ENDIF
		
		    IF USED("cur_valida_mone")
		        USE IN cur_valida_mone
		    ENDIF
		
			*---------------------------------------------
		    * Construir observaciones agrupadas
		    *---------------------------------------------
		    lcObsItems = ""
		    lcObsFinal = ""
		    lnObsCount = 0
		    lnSeqItem  = 0
		
		    DIMENSION laObs[1,2]
		    laObs[1,1] = ""
		    laObs[1,2] = ""
		
		    SELECT cur_items_oc_prov
		    GO TOP
		
		    SCAN
		        lnSeqItem   = lnSeqItem + 1  && <--- Este es el contador real de la nueva OC (1, 2, 3...)
		        lcObsActual = ALLTRIM(NVL(cur_items_oc_prov.observacion, ""))
		
		        IF NOT EMPTY(lcObsActual)
		            
		            * ==========================================================
		            * SOLUCIÓN: Forzamos a que el número a mostrar sea el 
		            * secuencial de esta nueva OC, ignorando la posición vieja.
		            * ==========================================================
		            lcItemMostrar = ALLTRIM(TRANSFORM(lnSeqItem))
		
		            lnIdx = 0
		
		            FOR lnIdx = 1 TO lnObsCount
		                IF UPPER(ALLTRIM(laObs[lnIdx,1])) == UPPER(ALLTRIM(lcObsActual))
		                    EXIT
		                ENDIF
		            ENDFOR
		
		            IF lnObsCount = 0 OR lnIdx > lnObsCount
		                lnObsCount = lnObsCount + 1
		                DIMENSION laObs[lnObsCount,2]
		                laObs[lnObsCount,1] = lcObsActual
		                laObs[lnObsCount,2] = lcItemMostrar
		            ELSE
		                lcItemsActual = ALLTRIM(laObs[lnIdx,2])
		
		                IF NOT EMPTY(lcItemsActual)
		                    laObs[lnIdx,2] = lcItemsActual + "," + lcItemMostrar
		                ELSE
		                    laObs[lnIdx,2] = lcItemMostrar
		                ENDIF
		            ENDIF
		        ENDIF
		    ENDSCAN
		
		    IF lnObsCount > 0
		        FOR lnIdx = 1 TO lnObsCount
		            IF NOT EMPTY(ALLTRIM(laObs[lnIdx,1]))
		                IF NOT EMPTY(lcObsItems)
		                    lcObsItems = lcObsItems + CHR(13) + CHR(10)
		                ENDIF
		
		                lcObsItems = lcObsItems + ;
		                    "ITEM N " + ALLTRIM(laObs[lnIdx,2]) + ": " + ALLTRIM(laObs[lnIdx,1])
		            ENDIF
		        ENDFOR
		    ENDIF
		
		    IF NOT EMPTY(lcObsGeneral)
		        lcObsFinal =CHR(10) + lcObsGeneral
		    ENDIF
		
			IF NOT EMPTY(lcObsItems)
		        IF NOT EMPTY(lcObsFinal)
		            lcObsFinal = lcObsFinal + CHR(13) + CHR(10) + CHR(13) + CHR(10)
		        ENDIF
		        lcObsFinal = lcObsFinal + "OBSERVACIONES POR ITEM:" + CHR(13) + CHR(10) + lcObsItems
		    ENDIF
		
			* ====================================================================
			* AGREGAR LEYENDA DE MONEDA AL PRINCIPIO DE LAS OBSERVACIONES
			* SIN agregar referencia de solicitud
			* ====================================================================
			LOCAL lcLeyendaMoneda
		
			IF xmone == "D"
			    lcLeyendaMoneda = "PRECIOS EXPRESADOS EN DOLARES"
			ELSE
			    lcLeyendaMoneda = "PRECIOS EXPRESADOS EN PESOS"
			ENDIF
		
			IF EMPTY(ALLTRIM(lcObsFinal))
			    lcObsFinal = lcLeyendaMoneda
			ELSE
			    lcObsFinal = lcLeyendaMoneda + CHR(13) + CHR(10) + CHR(13) + CHR(10) + ALLTRIM(lcObsFinal)
			ENDIF
			* ====================================================================
		    *---------------------------------------------
		    * Crear cabecera OC
		    * SIN LOCK TABLES
		    *---------------------------------------------
		    lnDetInsertados = 0
		    llOk            = .T.
		    lnNuevoNroOC    = 0
		
		    lnHandle = conectar_db(_screen.cn)
		
		    IF lnHandle <= 0
		        LOOP
		    ENDIF
		
		    IF USED("cur_nvoc")
		        USE IN cur_nvoc
		    ENDIF
		
		    IF SQLEXEC(lnHandle, ;
		        "SELECT CAST(IFNULL(MAX(orden_codi),0)+1 AS DECIMAL(8,0)) AS orden_codi FROM compras", ;
		        "cur_nvoc") <= 0
		
		        IF USED("cur_nvoc")
		            USE IN cur_nvoc
		        ENDIF
		
		        desconectar_db(lnHandle)
		        LOOP
		    ENDIF
		
		    IF NOT USED("cur_nvoc") OR RECCOUNT("cur_nvoc") = 0
		        IF USED("cur_nvoc")
		            USE IN cur_nvoc
		        ENDIF
		
		        desconectar_db(lnHandle)
		        LOOP
		    ENDIF
		
		    SELECT cur_nvoc
		    GO TOP
		
		    lnNuevoNroOC = VAL(TRANSFORM(cur_nvoc.orden_codi))
		
		    IF USED("cur_nvoc")
		        USE IN cur_nvoc
		    ENDIF
		
		    IF lnNuevoNroOC <= 0
		        desconectar_db(lnHandle)
		        LOOP
		    ENDIF
		
			lcSql = "INSERT INTO compras VALUES " + ;
		   		"(?lnNuevoNroOC, ?xfecha, ?lnProvid, '', ?lcObsFinal, 0, ?lnTranCodiOC, ?lnCodIva, '', '', ?xcoti, ?xmone)"
		    
		    lnInsCab = SQLEXEC(lnHandle, lcSql)
		
		    IF lnInsCab <= 0
		        lcErr1 = ""
		        lcErr2 = ""
		        lcErr3 = ""
		        lcErr4 = ""
		        lcErr5 = ""
		
		        AERROR(laErrCab)
		
		        IF ALEN(laErrCab, 1) >= 1
		            IF ALEN(laErrCab, 2) >= 1
		                lcErr1 = TRANSFORM(laErrCab[1,1])
		            ENDIF
		            IF ALEN(laErrCab, 2) >= 2
		                lcErr2 = TRANSFORM(laErrCab[1,2])
		            ENDIF
		            IF ALEN(laErrCab, 2) >= 3
		                lcErr3 = TRANSFORM(laErrCab[1,3])
		            ENDIF
		            IF ALEN(laErrCab, 2) >= 4
		                lcErr4 = TRANSFORM(laErrCab[1,4])
		            ENDIF
		            IF ALEN(laErrCab, 2) >= 5
		                lcErr5 = TRANSFORM(laErrCab[1,5])
		            ENDIF
		        ENDIF
		
		        MESSAGEBOX("DIAG: INSERT compras fallo para Prov " + TRANSFORM(lnProvid) + CHR(13) + ;
		                   "NroOC: " + TRANSFORM(lnNuevoNroOC) + CHR(13) + ;
		                   "SQL: " + lcSql + CHR(13) + CHR(13) + ;
		                   "AERROR[1,1]: " + lcErr1 + CHR(13) + ;
		                   "AERROR[1,2]: " + lcErr2 + CHR(13) + ;
		                   "AERROR[1,3]: " + lcErr3 + CHR(13) + ;
		                   "AERROR[1,4]: " + lcErr4 + CHR(13) + ;
		                   "AERROR[1,5]: " + lcErr5, ;
		                   16, ;
		                   "Debug INSERT compras")
		
		        desconectar_db(lnHandle)
		        LOOP
		    ENDIF
		
		    *---------------------------------------------
		    * Insertar detalles replicando command2
		    * SIN LOCK TABLES
		    *---------------------------------------------
		    SELECT cur_items_oc_prov
		    GO TOP
		
		    SCAN
		        xarti       = VAL(TRANSFORM(cur_items_oc_prov.art_codi))
		        xcant       = VAL(TRANSFORM(cur_items_oc_prov.cant))
		        xprec       = VAL(TRANSFORM(cur_items_oc_prov.precio))
		        xArtProCodi = VAL(TRANSFORM(cur_items_oc_prov.artpro_codi))
		        lcDescGrid  = ALLTRIM(NVL(cur_items_oc_prov.desc_grid, ""))
		
		        IF EMPTY(xarti) OR xarti <= 0
		            LOOP
		        ENDIF
		
		        IF EMPTY(xcant) OR xcant <= 0
		            LOOP
		        ENDIF
		
		        xdasc    = ""
		        xdap     = 0
		        lcDescDB = ""
		
		        IF xarti > 5
		            lnHandleAux = conectar_db(_screen.cn)
		
		            IF lnHandleAux > 0
		                IF USED("cur_desc")
		                    USE IN cur_desc
		                ENDIF
		
		                IF SQLEXEC(lnHandleAux, ;
		                    "SELECT TRIM(art_desc) AS art_desc FROM articulos WHERE art_codi = ?xarti", ;
		                    "cur_desc") > 0
		
		                    IF USED("cur_desc") AND RECCOUNT("cur_desc") > 0
		                        lcDescDB = ALLTRIM(NVL(cur_desc.art_desc, ""))
		                    ENDIF
		                ENDIF
		
		                IF USED("cur_desc")
		                    USE IN cur_desc
		                ENDIF
		
		                desconectar_db(lnHandleAux)
		            ENDIF
		
		            IF NOT EMPTY(lcDescGrid) AND ALLTRIM(lcDescGrid) <> ALLTRIM(lcDescDB)
		                lnHandleAux = conectar_db(_screen.cn)
		
		                IF lnHandleAux > 0
		                    IF xArtProCodi <= 0
		                        IF USED("cur_artpro")
		                            USE IN cur_artpro
		                        ENDIF
		
		                        IF SQLEXEC(lnHandleAux, ;
		                            "SELECT * FROM articulos_proveedores WHERE prov_codi = ?lnProvid AND art_codi = ?xarti ORDER BY artpro_codi LIMIT 1", ;
		                            "cur_artpro") > 0
		
		                            IF USED("cur_artpro") AND RECCOUNT("cur_artpro") > 0
		                                xArtProCodi = VAL(TRANSFORM(cur_artpro.artpro_codi))
		                            ENDIF
		                        ENDIF
		
		                        IF USED("cur_artpro")
		                            USE IN cur_artpro
		                        ENDIF
		                    ENDIF
		
		                    IF xArtProCodi > 0
		                        IF USED("cur_ddes")
		                            USE IN cur_ddes
		                        ENDIF
		
		                        lcConcatBusq = ALLTRIM(STR(xArtProCodi)) + ALLTRIM(lcDescGrid)
		
		                        IF SQLEXEC(lnHandleAux, ;
		                            "SELECT * FROM desc_articulos_proveedores " + ;
		                            "WHERE CONCAT(CAST(artpro_codi AS CHAR), TRIM(dap_desc)) = ?lcConcatBusq", ;
		                            "cur_ddes") > 0
		
		                            IF USED("cur_ddes") AND RECCOUNT("cur_ddes") > 0
		                                xdap = VAL(TRANSFORM(cur_ddes.dap_codi))
		                            ENDIF
		                        ENDIF
		
		                        IF USED("cur_ddes")
		                            USE IN cur_ddes
		                        ENDIF
		                    ENDIF
		
		                    desconectar_db(lnHandleAux)
		                ENDIF
		            ENDIF
		        ELSE
		            xdasc = lcDescGrid
		        ENDIF
		
		        IF USED("cur_id_det")
		            USE IN cur_id_det
		        ENDIF
		
		        IF SQLEXEC(lnHandle, ;
		            "SELECT CAST(IFNULL(MAX(artord_codi),0)+1 AS DECIMAL(8,0)) AS artord_codi FROM compras_articulos", ;
		            "cur_id_det") <= 0
		
		            lcErr1 = ""
		            lcErr2 = ""
		            lcErr3 = ""
		
		            AERROR(laErrId)
		
		            IF ALEN(laErrId, 1) >= 1
		                IF ALEN(laErrId, 2) >= 1
		                    lcErr1 = TRANSFORM(laErrId[1,1])
		                ENDIF
		                IF ALEN(laErrId, 2) >= 2
		                    lcErr2 = TRANSFORM(laErrId[1,2])
		                ENDIF
		                IF ALEN(laErrId, 2) >= 3
		                    lcErr3 = TRANSFORM(laErrId[1,3])
		                ENDIF
		            ENDIF
		
		            MESSAGEBOX("DIAG: No se pudo obtener nuevo artord_codi." + CHR(13) + ;
		                       "OC: " + TRANSFORM(lnNuevoNroOC) + CHR(13) + ;
		                       "Art: " + TRANSFORM(xarti) + CHR(13) + ;
		                       "AERROR[1,1]: " + lcErr1 + CHR(13) + ;
		                       "AERROR[1,2]: " + lcErr2 + CHR(13) + ;
		                       "AERROR[1,3]: " + lcErr3, ;
		                       16, ;
		                       "Debug ID detalle")
		
		            IF USED("cur_id_det")
		                USE IN cur_id_det
		            ENDIF
		
		            llOk = .F.
		            EXIT
		        ENDIF
		
		        IF NOT USED("cur_id_det") OR RECCOUNT("cur_id_det") = 0
		            IF USED("cur_id_det")
		                USE IN cur_id_det
		            ENDIF
		
		            llOk = .F.
		            EXIT
		        ENDIF
		
		        SELECT cur_id_det
		        GO TOP
		
		        lnDetId = VAL(TRANSFORM(cur_id_det.artord_codi))
		
		        IF USED("cur_id_det")
		            USE IN cur_id_det
		        ENDIF
		
		        IF lnDetId <= 0
		            llOk = .F.
		            EXIT
		        ENDIF
		
				lcSql = ;
				    "INSERT INTO compras_articulos " + ;
				    "(artord_codi, orden_codi, art_codi, artord_precio, artord_cant, artord_ent, artord_dasc, artpro_codi, dap_codi, alter_iva) " + ;
				    "VALUES " + ;
				    "(?lnDetId, ?lnNuevoNroOC, ?xarti, ?xprec, ?xcant, 0, ?xdasc, 0, ?xdap, 0)"
		
				lnInsDet = SQLEXEC(lnHandle, lcSql)
		
		        IF lnInsDet <= 0
		            lcErr1 = ""
		            lcErr2 = ""
		            lcErr3 = ""
		            lcErr4 = ""
		            lcErr5 = ""
		
		            AERROR(laErrDet)
		
		            IF ALEN(laErrDet, 1) >= 1
		                IF ALEN(laErrDet, 2) >= 1
		                    lcErr1 = TRANSFORM(laErrDet[1,1])
		                ENDIF
		                IF ALEN(laErrDet, 2) >= 2
		                    lcErr2 = TRANSFORM(laErrDet[1,2])
		                ENDIF
		                IF ALEN(laErrDet, 2) >= 3
		                    lcErr3 = TRANSFORM(laErrDet[1,3])
		                ENDIF
		                IF ALEN(laErrDet, 2) >= 4
		                    lcErr4 = TRANSFORM(laErrDet[1,4])
		                ENDIF
		                IF ALEN(laErrDet, 2) >= 5
		                    lcErr5 = TRANSFORM(laErrDet[1,5])
		                ENDIF
		            ENDIF
		
		            MESSAGEBOX("DIAG: INSERT compras_articulos fallo" + CHR(13) + ;
		                       "OC: " + TRANSFORM(lnNuevoNroOC) + CHR(13) + ;
		                       "Art: " + TRANSFORM(xarti) + " Prov: " + TRANSFORM(lnProvid) + CHR(13) + ;
		                       "DetId: " + TRANSFORM(lnDetId) + CHR(13) + ;
		                       "Cant: " + TRANSFORM(xcant) + CHR(13) + ;
		                       "Precio: " + TRANSFORM(xprec) + CHR(13) + ;
		                       "ArtPro: " + TRANSFORM(xArtProCodi) + CHR(13) + ;
		                       "Dap: " + TRANSFORM(xdap) + CHR(13) + ;
		                       "SQL: " + lcSql + CHR(13) + CHR(13) + ;
		                       "AERROR[1,1]: " + lcErr1 + CHR(13) + ;
		                       "AERROR[1,2]: " + lcErr2 + CHR(13) + ;
		                       "AERROR[1,3]: " + lcErr3 + CHR(13) + ;
		                       "AERROR[1,4]: " + lcErr4 + CHR(13) + ;
		                       "AERROR[1,5]: " + lcErr5, ;
		                       16, ;
		                       "Debug INSERT detalle")
		
		            llOk = .F.
		            EXIT
		        ENDIF
		
		        lnDetInsertados = lnDetInsertados + 1
		
		        INSERT INTO cur_oc_det_insertados VALUES ;
		            (xarti, xcant)
		
		        IF xarti > 5
		            Campo_ppr(xarti)
		        ENDIF
		    ENDSCAN
		
		    desconectar_db(lnHandle)
		
		    IF llOk AND lnDetInsertados <= 0
		        llOk = .F.
		    ENDIF
		
		    IF llOk AND lnDetInsertados > 0
			INSERT INTO cur_ocs_generadas VALUES ;
		    	(lnNuevoNroOC, lnProvid, lnTranCodiOC, xmone, "")
		
		        lnCountOC = lnCountOC + 1
		    ELSE
		        MESSAGEBOX("DIAG: Prov " + TRANSFORM(lnProvid) + " NO genero OC" + CHR(13) + ;
		                   "llOk=" + TRANSFORM(llOk) + CHR(13) + ;
		                   "lnDetInsertados=" + TRANSFORM(lnDetInsertados) + CHR(13) + ;
		                   "lnNuevoNroOC=" + TRANSFORM(lnNuevoNroOC), ;
		                   48, ;
		                   "Debug resultado prov")
		
		        * Rollback manual
		        lnHandle = conectar_db(_screen.cn)
		
		        IF lnHandle > 0
		            SQLEXEC(lnHandle, "DELETE FROM compras_articulos WHERE orden_codi = ?lnNuevoNroOC")
		            SQLEXEC(lnHandle, "DELETE FROM compras WHERE orden_codi = ?lnNuevoNroOC")
		            desconectar_db(lnHandle)
		        ENDIF
		    ENDIF
		
		    IF USED("cur_items_oc_prov")
		        USE IN cur_items_oc_prov
		    ENDIF
		
		    IF USED("cur_oc_det_insertados")
		        USE IN cur_oc_det_insertados
		    ENDIF
		ENDSCAN
		
		*---------------------------------------------------------
		* 13. Si no se genero nada, salir
		*---------------------------------------------------------
		IF lnCountOC <= 0
		    MESSAGEBOX("No se genero ninguna OC.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 14. Guardar reportes por cada OC generada
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "GuardarReporteOCEnCarpeta", 5)
		    SELECT cur_ocs_generadas
		    GO TOP
		
		    SCAN
		        IF NOT THISFORMSET.GuardarReporteOCEnCarpeta(cur_ocs_generadas.orden_codi, lcCarpetaReportes)
		            llReportesOk = .F.
		        ENDIF
		    ENDSCAN
		ENDIF
		
		*---------------------------------------------------------
		* 15. Marcar solicitud como COMPRADO
		*---------------------------------------------------------
		IF lnCountOC > 0 AND llReportesOk
		    lnHandle = conectar_db(_screen.cn)
		
		    IF lnHandle > 0
		        SQLEXEC(lnHandle, ;
		            "UPDATE solicitud_compra " + ;
		            "SET estado = 'COMPRADO' " + ;
		            "WHERE soli_codi = ?lnSoliCodi AND UPPER(IFNULL(estado,'')) = 'PENDIENTE'")
		
		        desconectar_db(lnHandle)
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 16. Mensaje final
		*---------------------------------------------------------
		lcMsgFinal = "Proceso terminado." + CHR(13) + ;
		             "OCs generadas: " + ALLTRIM(TRANSFORM(NVL(lnCountOC, 0)))
		
		IF NOT EMPTY(lcCarpetaReportes)
		    lcMsgFinal = lcMsgFinal + CHR(13) + ;
		                 "Carpeta de salida: " + lcCarpetaReportes
		ENDIF
		
		IF NOT llReportesOk
		    lcMsgFinal = lcMsgFinal + CHR(13) + ;
		                 "Atencion: no todos los reportes pudieron guardarse automaticamente."
		ENDIF
		
		MESSAGEBOX(lcMsgFinal, 64, "Exito")
		
		*!*	IF PEMSTATUS(THISFORMSET, "RunPipeline", 5)
		*!*	    THISFORMSET.RunPipeline()
		*!*	ELSE
		*!*	    IF PEMSTATUS(THISFORM, "RunPipeline", 5)
		*!*	        THISFORM.RunPipeline()
		*!*	    ENDIF
		*!*	ENDIF
		
		*!*	thisform.grid1.RecordSource=''
		*!*	thisform.grid1.Refresh()
		*!*	thisform.grid2.RecordSource=''
		*!*	thisform.grid2.Refresh()
		
		*!*	thisform.txt_fecdes_hist.Value=DATE()
		*!*	thisform.txt_fechas_hist.Value=DATE()
		
		*!*	thisform.edit1.value=''
		
		
		thisformset.actualizarlabelestadooc()
		thisform.Refresh()
		
		thisform.command2.Click()
		
		RETURN .T.
	ENDPROC


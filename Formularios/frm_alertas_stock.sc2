		CASE nKeyCode = 24    && Flecha abajo
		    IF THIS.ListIndex < THIS.ListCount
		        IF !PEMSTATUS(THIS, "lOmitInteractive", 5)
		            THIS.AddProperty("lOmitInteractive", .F.)
		        ENDIF
		
		        THIS.lOmitInteractive = .T.
		        THIS.ListIndex = THIS.ListIndex + 1
		        DOEVENTS
		        THIS.lOmitInteractive = .F.
		
		        THIS.Click()
		    ENDIF
		    NODEFAULT
		
		CASE nKeyCode = 5     && Flecha arriba
		    IF THIS.ListIndex > 1
		        IF !PEMSTATUS(THIS, "lOmitInteractive", 5)
		            THIS.AddProperty("lOmitInteractive", .F.)
		        ENDIF
		
		        THIS.lOmitInteractive = .T.
		        THIS.ListIndex = THIS.ListIndex - 1
		        DOEVENTS
		        THIS.lOmitInteractive = .F.
		
		        THIS.Click()
		    ENDIF
		    NODEFAULT
		
		CASE nKeyCode = 13    && Enter
		    DOEVENTS
		    THIS.Click()
		    NODEFAULT
		
		ENDCASE
	ENDPROC

	PROCEDURE principal.Command1.Click
		*=========================================================
		* principal.Command1.Click
		* Botón Localizar artículo
		* - abre artload
		* - devuelve código a txt_add_codi
		* - renderiza panel del artículo
		* - NO agrega a temp_solicitud_compra
		* - NO muestra INPUTBOX
		*=========================================================
		PRIVATE codigo, nombre
		LOCAL loFrm
		LOCAL lnArtCodi, lcArtDesc, llOk
		
		codigo = 0
		nombre = ""
		
		DO FORM artload
		
		IF VARTYPE(codigo) <> "N" OR codigo <= 0
		    RETURN
		ENDIF
		
		loFrm = THISFORMSET.principal
		IF VARTYPE(loFrm) <> "O"
		    RETURN
		ENDIF
		
		lnArtCodi = codigo
		lcArtDesc = IIF(VARTYPE(nombre) = "C", ALLTRIM(nombre), "")
		
		*---------------------------------------------------------
		* 1) Volcar código al textbox del formulario
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "txt_add_codi", 5)
		    loFrm.txt_add_codi.Value = lnArtCodi
		    loFrm.txt_add_codi.Refresh()
		ENDIF
		
		*---------------------------------------------------------
		* 2) Opcional: si vino descripción desde artload,
		*    mostrarla de inmediato en text10
		*---------------------------------------------------------
		IF !EMPTY(lcArtDesc) AND PEMSTATUS(loFrm, "text10", 5)
		    loFrm.text10.Value = lcArtDesc
		    loFrm.text10.Refresh()
		ENDIF
		
		*---------------------------------------------------------
		* 3) Renderizar panel del artículo seleccionado
		*---------------------------------------------------------
		llOk = .T.
		
		IF PEMSTATUS(THISFORMSET, "CargarArticuloDesdeTxtAddCodi", 5)
		    llOk = THISFORMSET.CargarArticuloDesdeTxtAddCodi()
		ELSE
		    llOk = .F.
		    MESSAGEBOX("No existe el método CargarArticuloDesdeTxtAddCodi en el FormSet.", 16, "Error")
		ENDIF
		
		*---------------------------------------------------------
		* 4) Refrescar interfaz del formulario
		*---------------------------------------------------------
		loFrm.Refresh()
		
		*---------------------------------------------------------
		* 5) Devolver foco al botón Agregar
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "btn_add_manual", 5)
		    TRY
		        loFrm.btn_add_manual.SetFocus()
		    CATCH
		    ENDTRY
		ENDIF
		
		RETURN
	ENDPROC


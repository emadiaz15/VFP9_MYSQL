	PROCEDURE principal.consulta.Click
		*=========================================================
		* principal.btn_consulta.Click
		*=========================================================
		LOCAL ldDesde, ldHasta
		
		ldDesde = GOMONTH(DATE(), -12)
		ldHasta = DATE()
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		
		    THISFORMSET.principal.Enabled = .F.
		
			IF PEMSTATUS(THISFORMSET.secundario, "xHistInicializado", 5)
			    THISFORMSET.secundario.xHistInicializado = .F.
			ELSE
			    THISFORMSET.secundario.AddProperty("xHistInicializado", .F.)
			ENDIF
		
		    THISFORMSET.secundario.Visible     = .T.
		    THISFORMSET.secundario.WindowState = 0
		    THISFORMSET.secundario.ZOrder(0)
		
		    IF PEMSTATUS(THISFORMSET, "InicializarFechasHistorialSecundario", 5)
		        THISFORMSET.InicializarFechasHistorialSecundario(ldDesde, ldHasta)
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "CargarHistorialSolicitudesFiltrado", 5)
		        THISFORMSET.CargarHistorialSolicitudesFiltrado(ldDesde, ldHasta)
		    ENDIF
		
		    DOEVENTS
		
		    IF PEMSTATUS(THISFORMSET.secundario, "txt_fechas_hist", 5)
		        TRY
		            THISFORMSET.secundario.txt_fechas_hist.SetFocus()
		        CATCH
		        ENDTRY
		    ENDIF
		
		ELSE
		    MESSAGEBOX("No existe el formulario 'secundario' dentro del formset.", 16, "Error")
		ENDIF
		
	ENDPROC


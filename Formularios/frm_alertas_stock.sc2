	PROCEDURE principal.chkOrdenColor.Click
		&& FORMSET.PRINCIPAL.CHKORDENCOLOR.CLICK
		LOCAL loFS
		
		loFS = THISFORMSET
		IF VARTYPE(loFS) <> "O"
		    RETURN
		ENDIF
		
		*-- Inicializar propiedades de caché si no existen
		IF !PEMSTATUS(THISFORM, "xSortFieldSaved", 5)
		    THISFORM.AddProperty("xSortFieldSaved", "")
		ENDIF
		IF !PEMSTATUS(THISFORM, "xSortDescSaved", 5)
		    THISFORM.AddProperty("xSortDescSaved", .F.)
		ENDIF
		
		IF THIS.Value
		    *-- Guardar estado del sort por campo
		    THISFORM.xSortFieldSaved = IIF(PEMSTATUS(THISFORM,"xSortField",5), THISFORM.xSortField, "")
		    THISFORM.xSortDescSaved  = IIF(PEMSTATUS(THISFORM,"xSortDesc",5),  THISFORM.xSortDesc,  .F.)
		
		    *-- Limpiar índice activo para que ReaplicarOrdenActualCurAlerts pueda ordenar sin interferencia
		    IF USED("cur_alerts")
		        SELECT cur_alerts
		        SET ORDER TO
		    ENDIF
		
		    IF PEMSTATUS(THISFORM, "xOrdenColorDesc", 5)
		        THISFORM.xOrdenColorDesc = .T.
		    ENDIF
		    IF PEMSTATUS(loFS, "ReaplicarOrdenActualCurAlerts", 5)
		        loFS.ReaplicarOrdenActualCurAlerts()
		    ENDIF
		
		    IF PEMSTATUS(THISFORM, "xSortField", 5)
		        THISFORM.xSortField = ""
		    ENDIF
		
		ELSE
		    *-- Restaurar sort anterior
		    IF PEMSTATUS(THISFORM, "xOrdenColorDesc", 5)
		        THISFORM.xOrdenColorDesc = .F.
		    ENDIF
		
		    IF !EMPTY(THISFORM.xSortFieldSaved)
		        IF PEMSTATUS(loFS, "SortAlertsByField", 5)
		            loFS.SortAlertsByField(THISFORM.xSortFieldSaved, THISFORM.xSortDescSaved)
		        ENDIF
		    ELSE
		        IF PEMSTATUS(loFS, "ReaplicarOrdenActualCurAlerts", 5)
		            loFS.ReaplicarOrdenActualCurAlerts()
		        ENDIF
		    ENDIF
		
		ENDIF
		
		*-- Actualizar flechas en headers
		IF PEMSTATUS(loFS, "UpdateGridHeaderSortUI", 5)
		    loFS.UpdateGridHeaderSortUI()
		ENDIF
	ENDPROC

	PROCEDURE principal.cmd_cerrar.Click
		*=========================================================
		* principal.cmd_cerrar.Click
		* Cierre controlado del FormSet
		*=========================================================
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    IF !PEMSTATUS(THISFORMSET.secundario, "xCerrandoPorSistema", 5)
		        THISFORMSET.secundario.AddProperty("xCerrandoPorSistema", .T.)
		    ELSE
		        THISFORMSET.secundario.xCerrandoPorSistema = .T.
		    ENDIF
		ENDIF
		
		IF TYPE("THISFORMSET") = "O"
		    THISFORMSET.Release()
		ELSE
		    THISFORM.Release()
		ENDIF
		
		
	ENDPROC


	PROCEDURE secundario.Command3.Click
		*=========================================================
		* secundario.command3.Click
		* EDITAR / GUARDAR observaciones
		*=========================================================
		LOCAL lcCap
		
		lcCap = UPPER(ALLTRIM(THIS.Caption))
		
		DO CASE
		CASE lcCap == "EDITAR"
		    IF PEMSTATUS(THISFORMSET, "IniciarEdicionObservacion", 5)
		        RETURN THISFORMSET.IniciarEdicionObservacion()
		    ENDIF
		
		CASE lcCap == "GUARDAR"
		    IF PEMSTATUS(THISFORMSET, "GuardarObservacionDesdeEditor", 5)
		        RETURN THISFORMSET.GuardarObservacionDesdeEditor()
		    ENDIF
		ENDCASE
		
		RETURN .F.
	ENDPROC


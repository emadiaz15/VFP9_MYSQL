	PROCEDURE mostrarordencompraterciario
		*=========================================================
		* FormSet.MostrarOrdenCompraTerciario
		*=========================================================
		LOCAL loTer
		LOCAL lnOrdenCodi
		LOCAL lcTexto
		
		IF !PEMSTATUS(THISFORMSET, "terciario", 5)
		    RETURN .F.
		ENDIF
		
		loTer = THISFORMSET.terciario
		IF VARTYPE(loTer) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loTer, "text1", 5)
		    RETURN .F.
		ENDIF
		
		lcTexto = ""
		
		IF USED("cur_ter_compras") AND !EOF("cur_ter_compras")
		    lnOrdenCodi = VAL(TRANSFORM(NVL(cur_ter_compras.orden_codi, 0)))
		    IF lnOrdenCodi > 0
		        lcTexto = ALLTRIM(STR(lnOrdenCodi))
		    ENDIF
		ENDIF
		
		loTer.text1.Value = lcTexto
		
		RETURN .T.
	ENDPROC

	PROCEDURE obsmodalcancelar
		*=========================================================
		* FormSet.ObsModalCancelar
		* Handler del botón Cancelar/Cerrar del modal runtime
		*=========================================================
		LOCAL loDlg
		
		loDlg = .NULL.
		
		IF PEMSTATUS(THISFORMSET, "xObsModalForm", 5)
		    loDlg = THISFORMSET.xObsModalForm
		ENDIF
		
		IF VARTYPE(loDlg) <> "O"
		    RETURN .F.
		ENDIF
		
		loDlg.cValor     = ""
		loDlg.lCancelado = .T.
		
		THISFORMSET.xObsModalValor     = ""
		THISFORMSET.xObsModalCancelado = .T.
		
		CLEAR TYPEAHEAD
		loDlg.Hide()
		
		RETURN .T.
	ENDPROC

	PROCEDURE obsmodalguardar
		*=========================================================
		* FormSet.ObsModalGuardar
		* Handler del botón Guardar del modal runtime
		*=========================================================
		LOCAL loDlg, lcTexto
		
		loDlg   = .NULL.
		lcTexto = ""
		
		IF PEMSTATUS(THISFORMSET, "xObsModalForm", 5)
		    loDlg = THISFORMSET.xObsModalForm
		ENDIF
		
		IF VARTYPE(loDlg) <> "O"
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(loDlg, "edtObs", 5)
		    DO CASE
		    CASE VARTYPE(loDlg.edtObs.Value) = "C"
		        lcTexto = ALLTRIM(loDlg.edtObs.Value)
		
		    CASE VARTYPE(loDlg.edtObs.Value) = "M"
		        lcTexto = ALLTRIM(loDlg.edtObs.Value)
		
		    OTHERWISE
		        lcTexto = ""
		    ENDCASE
		ENDIF
		
		loDlg.cValor     = lcTexto
		loDlg.lCancelado = .F.
		
		THISFORMSET.xObsModalValor     = lcTexto
		THISFORMSET.xObsModalCancelado = .F.
		
		CLEAR TYPEAHEAD
		loDlg.Hide()
		
		RETURN .T.
	ENDPROC

	PROCEDURE obtenercarpetareportesmasivos
		*=========================================================
		* FormSet.ObtenerCarpetaReportesMasivos
		* - Devuelve carpeta destino en el Escritorio del usuario
		* - Nombre carpeta: Ord. Compras-DD-MM-AA-hh.mm
		*=========================================================
		LPARAMETERS tnSoliCodi
		
		LOCAL loWSH
		LOCAL lcDesktop, lcCarpetaFinal
		LOCAL lcFecha, lcHora, lcNombreCarpeta
		LOCAL ldHoy, lcHoraRaw
		
		lcDesktop       = ""
		lcCarpetaFinal  = ""
		lcFecha         = ""
		lcHora          = ""
		lcNombreCarpeta = ""
		ldHoy           = DATE()
		lcHoraRaw       = TIME()
		
		TRY
		    loWSH = CREATEOBJECT("WScript.Shell")
		    lcDesktop = ALLTRIM(loWSH.SpecialFolders("Desktop"))
		CATCH
		    lcDesktop = ""
		ENDTRY
		
		IF EMPTY(lcDesktop)
		    lcDesktop = ADDBS(SYS(2023))
		ENDIF
		
		IF EMPTY(lcDesktop) OR !DIRECTORY(lcDesktop)
		    MESSAGEBOX("No se pudo determinar el Escritorio del usuario.", 16, "Error")
		    RETURN ""
		ENDIF
		
		lcFecha = PADL(DAY(ldHoy), 2, "0") + "-" + ;
		          PADL(MONTH(ldHoy), 2, "0") + "-" + ;
		          RIGHT(TRANSFORM(YEAR(ldHoy)), 2)
		
		lcHora = LEFT(lcHoraRaw, 5)
		lcHora = STRTRAN(lcHora, ":", ".")
		
		lcNombreCarpeta = "Ord. Compras-" + lcFecha + "-" + lcHora
		lcCarpetaFinal  = ADDBS(lcDesktop) + lcNombreCarpeta
		
		IF !DIRECTORY(lcCarpetaFinal)
		    MD (lcCarpetaFinal)
		ENDIF
		
		IF !DIRECTORY(lcCarpetaFinal)
		    MESSAGEBOX("No se pudo crear la carpeta de reportes:" + CHR(13) + lcCarpetaFinal, 16, "Error")
		    RETURN ""
		ENDIF
		
		RETURN lcCarpetaFinal
	ENDPROC

	PROCEDURE obtenerreferenciacombo2
		*=========================================================
		* FormSet.ObtenerReferenciaCombo2
		* Devuelve la referencia descriptiva según el modo actual
		* de combo2 y su valor/texto visible
		*=========================================================
		LPARAMETERS tcModo, tuValor, tcTextoVisible
		
		LOCAL lcModo, lcTexto, lcRef
		LOCAL lnValor
		
		lcModo  = UPPER(ALLTRIM(NVL(tcModo, "")))
		lcTexto = UPPER(ALLTRIM(NVL(tcTextoVisible, "")))
		lcRef   = ""
		
		IF VARTYPE(tuValor) = "N" OR VARTYPE(tuValor) = "I"
		    lnValor = tuValor
		ELSE
		    lnValor = VAL(TRANSFORM(tuValor))
		ENDIF
		
		* Normalizar acentos por seguridad
		lcTexto = STRTRAN(lcTexto, "Á", "A")
		lcTexto = STRTRAN(lcTexto, "É", "E")
		lcTexto = STRTRAN(lcTexto, "Í", "I")
		lcTexto = STRTRAN(lcTexto, "Ó", "O")
		lcTexto = STRTRAN(lcTexto, "Ú", "U")
		
		DO CASE
		
		    *-----------------------------------------------------
		    * DEPURACION
		    *-----------------------------------------------------
		    CASE lcModo == "DEPURACION"
		        DO CASE
		            CASE lnValor = 1 OR lcTexto == "INACTIVOS"
		                lcRef = "Referencia: solo artículos inactivos (estado = 0)."
		
		            CASE lnValor = 2 OR lcTexto == "SIN STOCK MINIMO"
		                lcRef = "Referencia: artículos activos sin stock mínimo configurado."
		
		            CASE lnValor = 3 OR lcTexto == "SIN % ALERTA" OR lcTexto == "SIN % DE ALERTA"
		                lcRef = "Referencia: artículos activos sin porcentaje de alerta configurado."
		
		            CASE lnValor = 4 OR lcTexto == "SIN PARAMETRIZAR"
		                lcRef = "Referencia: artículos activos sin stock mínimo o sin porcentaje de alerta."
		
		            CASE lnValor = 5 OR lcTexto == "TODOS"
		                lcRef = "Referencia: muestra todos los artículos, activos e inactivos."
		
		            OTHERWISE
		                lcRef = "Referencia: opción de depuración seleccionada."
		        ENDCASE
		
		    *-----------------------------------------------------
		    * RUBROS
		    *-----------------------------------------------------
		    CASE lcModo == "RUBROS"
		        IF !EMPTY(lcTexto)
		            lcRef = "Referencia: rubro seleccionado = " + tcTextoVisible + "."
		        ELSE
		            lcRef = "Referencia: filtrando por rubro."
		        ENDIF
		
		    *-----------------------------------------------------
		    * PROVEEDOR
		    *-----------------------------------------------------
		    CASE lcModo == "PROVEEDOR"
		        IF !EMPTY(lcTexto)
		            lcRef = "Referencia: proveedor seleccionado = " + tcTextoVisible + "."
		        ELSE
		            lcRef = "Referencia: filtrando por proveedor."
		        ENDIF
		
		    OTHERWISE
		        lcRef = ""
		ENDCASE
		
		RETURN lcRef
	ENDPROC

	PROCEDURE obtenersolicodiseleccionadosecundario
		*=========================================================
		* FormSet.ObtenerSoliCodiSeleccionadoSecundario
		* Devuelve el soli_codi del registro actual seleccionado
		* en grid1 del form secundario.
		* Retorna 0 si no lo puede obtener.
		*=========================================================
		LOCAL loConsulta, lcAlias, lnSoliCodi
		
		lnSoliCodi = 0
		loConsulta = .NULL.
		lcAlias    = ""
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF VARTYPE(loConsulta) <> "O"
		    RETURN 0
		ENDIF
		
		IF !PEMSTATUS(loConsulta, "grid1", 5)
		    RETURN 0
		ENDIF
		
		*-- Intentar obtener alias desde RecordSource de la grilla
		lcAlias = ALLTRIM(NVL(loConsulta.grid1.RecordSource, ""))
		
		IF EMPTY(lcAlias)
		    RETURN 0
		ENDIF
		
		IF !USED(lcAlias)
		    RETURN 0
		ENDIF
		
		SELECT (lcAlias)
		
		IF EOF() OR BOF()
		    RETURN 0
		ENDIF
		
		IF TYPE(lcAlias + ".soli_codi") = "N"
		    lnSoliCodi = EVALUATE(lcAlias + ".soli_codi")
		ELSE
		    IF TYPE(lcAlias + ".soli_codi") = "C"
		        lnSoliCodi = VAL(EVALUATE(lcAlias + ".soli_codi"))
		    ENDIF
		ENDIF
		
		RETURN NVL(lnSoliCodi, 0)
	ENDPROC

	PROCEDURE ocultarcontrolesfiltrosauxiliares
		*=========================================================
		* FormSet.OcultarControlesFiltrosAuxiliares
		* - Oculta controles auxiliares usados por otros filtros
		* - Especialmente PEDIDOS / RUBROS / PROVEEDOR / DEPURACION
		* - Para volver limpio a SELECCIONADOS
		*=========================================================
		LOCAL loFrm
		
		loFrm = THISFORMSET.principal
		
		IF VARTYPE(loFrm) <> "O"
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Ocultar combo2
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "combo2", 5)
		    loFrm.combo2.Visible = .F.
		ENDIF
		
		*---------------------------------------------------------
		* Ocultar combo5
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "combo5", 5)
		    loFrm.combo5.Visible = .F.
		ENDIF
		
		*---------------------------------------------------------
		* Ocultar filtros de fecha PEDIDOS
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "txt_fecdes", 5)
		    loFrm.txt_fecdes.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(loFrm, "txt_fechas", 5)
		    loFrm.txt_fechas.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(loFrm, "etq_fecdes", 5)
		    loFrm.etq_fecdes.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(loFrm, "etq_fechas", 5)
		    loFrm.etq_fechas.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(loFrm, "cmdcal1", 5)
		    loFrm.cmdcal1.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(loFrm, "cmdcal2", 5)
		    loFrm.cmdcal2.Visible = .F.
		ENDIF
		
		loFrm.Refresh()
		
		RETURN .T.
	ENDPROC

	PROCEDURE ongridheaderclick
		*=========================================================
		* FormSet.OnGridHeaderClick
		* Click en header => alterna ASC/DESC y reaplica filtro
		*=========================================================
		LPARAMETERS tcField
		LOCAL loFrm, loConsulta
		LOCAL lcField
		
		loFrm      = THISFORMSET.principal
		loConsulta = THISFORMSET.secundario
		
		lcField = LOWER(ALLTRIM(tcField))
		IF EMPTY(lcField)
		    RETURN
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xSortField", 5)
		    loFrm.AddProperty("xSortField", "")
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xSortDesc", 5)
		    loFrm.AddProperty("xSortDesc", .T.)
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xFiltroActual", 5)
		    loFrm.AddProperty("xFiltroActual", "TODOS")
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xRubCodiActual", 5)
		    loFrm.AddProperty("xRubCodiActual", 0)
		ENDIF
		
		IF LOWER(loFrm.xSortField) == lcField
		    loFrm.xSortDesc = !loFrm.xSortDesc
		ELSE
		    loFrm.xSortField = lcField
		    loFrm.xSortDesc  = .T.
		ENDIF
		THISFORMSET.AplicarFiltroLocal(loFrm.xFiltroActual, loFrm.xRubCodiActual)
		
		IF PEMSTATUS(THISFORMSET, "UpdateGridHeaderSortUI", 5)
		    THISFORMSET.UpdateGridHeaderSortUI()
		ENDIF
		
		loFrm.LockScreen = .T.
		IF PEMSTATUS(loFrm, "grd_alerts", 5)
		    loFrm.grd_alerts.Refresh()
		ENDIF
		loFrm.Refresh()
		loFrm.LockScreen = .F.
	ENDPROC

	PROCEDURE ordenarcuralertsporcolor
		*=========================================================
		* FormSet.OrdenarCurAlertsPorColor
		* - Ordena de mas oscuro a mas claro
		*=========================================================
		LOCAL lnArea
		
		IF !USED("cur_alerts")
		    RETURN .F.
		ENDIF
		
		IF TYPE("cur_alerts.ui_color_rank") = "U"
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarColorRankCurAlerts", 5)
		    THISFORMSET.ActualizarColorRankCurAlerts()
		ENDIF
		
		lnArea = SELECT()
		
		SELECT cur_alerts
		
		INDEX ON PADL(TRANSFORM(999999 - NVL(ui_color_rank,0)), 6, '0') + ;
		         PADL(TRANSFORM(999999 - RECNO()), 6, '0') ;
		    TAG zcolor
		
		SET ORDER TO TAG zcolor IN cur_alerts
		GO TOP
		
		SELECT (lnArea)
		RETURN .T.
	ENDPROC

	PROCEDURE posicionarprimerregistroalerts
		*=========================================================
		* FormSet.PosicionarPrimerRegistroAlerts
		* - Reposiciona cur_alerts al primer registro
		* - Sincroniza foco/UI dependiente del artículo actual
		*=========================================================
		LOCAL loFrm
		
		loFrm = THISFORMSET.principal
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") <= 0
		    IF PEMSTATUS(loFrm, "xCurRec", 5)
		        loFrm.xCurRec = 0
		    ENDIF
		    IF PEMSTATUS(loFrm, "xCurArt", 5)
		        loFrm.xCurArt = 0
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "Text4", 5)
		        loFrm.Text4.Refresh()
		    ENDIF
		    IF PEMSTATUS(loFrm, "Text11", 5)
		        loFrm.Text11.Refresh()
		    ENDIF
		    IF PEMSTATUS(loFrm, "Text12", 5)
		        loFrm.Text12.Refresh()
		    ENDIF
		    IF PEMSTATUS(loFrm, "Text13", 5)
		        loFrm.Text13.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "RefreshVentaCompraGrid", 5)
		        THISFORMSET.RefreshVentaCompraGrid()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "CargarGrdProv", 5)
		        THISFORMSET.CargarGrdProv()
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		SELECT cur_alerts
		GO TOP
		
		IF PEMSTATUS(loFrm, "xCurRec", 5)
		    loFrm.xCurRec = RECNO("cur_alerts")
		ENDIF
		
		IF PEMSTATUS(loFrm, "xCurArt", 5)
		    loFrm.xCurArt = IIF(TYPE("cur_alerts.art_codi")="N", cur_alerts.art_codi, 0)
		ENDIF
		
		IF PEMSTATUS(loFrm, "grd_alerts", 5)
		    TRY
		        loFrm.grd_alerts.SetFocus()
		        loFrm.grd_alerts.ActivateCell(1, 1)
		    CATCH
		    ENDTRY
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		    THISFORMSET.ActualizarEfectoGrid(0)
		ENDIF
		
		*-- Restaurar alias por si ActualizarEfectoGrid cambia el workarea
		IF USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0
		    SELECT cur_alerts
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text4", 5)
		    loFrm.Text4.Refresh()
		ENDIF
		IF PEMSTATUS(loFrm, "Text11", 5)
		    loFrm.Text11.Refresh()
		ENDIF
		IF PEMSTATUS(loFrm, "Text12", 5)
		    loFrm.Text12.Refresh()
		ENDIF
		IF PEMSTATUS(loFrm, "Text13", 5)
		    loFrm.Text13.Refresh()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "RefreshVentaCompraGrid", 5)
		    THISFORMSET.RefreshVentaCompraGrid()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "CargarGrdProv", 5)
		    THISFORMSET.CargarGrdProv()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE postprocesaralertsfiltrados
		*=========================================================
		* FormSet.PostProcesarAlertsFiltrados
		*=========================================================
		LOCAL lcSafety
		LOCAL lnItem
		
		IF !USED("cur_alerts")
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "CargarProveedoresEnCurAlerts", 5)
		    THISFORMSET.CargarProveedoresEnCurAlerts()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "CargarUltProvCompra", 5)
		    THISFORMSET.CargarUltProvCompra()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "AutoAsignarProveedorMinCosto", 5)
		    THISFORMSET.AutoAsignarProveedorMinCosto()
		ENDIF
		
		IF USED("cur_sorted")
		    USE IN cur_sorted
		ENDIF
		
		IF RECCOUNT("cur_alerts") > 0
		    SELECT cur_alerts.* ;
		    FROM cur_alerts ;
		    ORDER BY prov_nomb_sel ASC, art_desc ASC ;
		    INTO CURSOR cur_sorted READWRITE
		
		    IF USED("cur_sorted")
		        lcSafety = SET("SAFETY")
		        SET SAFETY OFF
		
		        SELECT cur_alerts
		        ZAP
		        APPEND FROM (DBF("cur_sorted"))
		
		        IF UPPER(ALLTRIM(lcSafety)) == "ON"
		            SET SAFETY ON
		        ELSE
		            SET SAFETY OFF
		        ENDIF
		
		        USE IN cur_sorted
		    ENDIF
		ENDIF
		
		SELECT cur_alerts
		lnItem = 0
		GO TOP
		SCAN
		    lnItem = lnItem + 1
		    REPLACE ui_item WITH ALLTRIM(STR(lnItem))
		ENDSCAN
		GO TOP
		
		RETURN .T.
	ENDPROC

	PROCEDURE preparardatosreporteoc
		*=========================================================
		* FormSet.PrepararDatosReporteOC
		* - Prepara cursores del reporte ordendecompra
		* - Versión robusta para OCs masivas
		*=========================================================
		LPARAMETERS tnOrdenCodi
		
		LOCAL lnHandle
		LOCAL lcSql
		LOCAL lnTranCodi
		
		lnTranCodi = 0
		
		IF EMPTY(tnOrdenCodi) OR VARTYPE(tnOrdenCodi) $ "CL"
		    tnOrdenCodi = VAL(TRANSFORM(tnOrdenCodi))
		ENDIF
		
		IF tnOrdenCodi <= 0
		    MESSAGEBOX("Orden de compra inválida.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Cerrar cursores previos del reporte
		*---------------------------------------------------------
		IF USED("cur_datvar")
		    USE IN cur_datvar
		ENDIF
		IF USED("cur_ubic")
		    USE IN cur_ubic
		ENDIF
		IF USED("cur_arcom")
		    USE IN cur_arcom
		ENDIF
		IF USED("cur_cpra")
		    USE IN cur_cpra
		ENDIF
		IF USED("cur_tra")
		    USE IN cur_tra
		ENDIF
		
		lnHandle = conectar_db(_screen.cn)
		IF lnHandle <= 0
		    MESSAGEBOX("No se pudo conectar a la base de datos.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 1. Cabecera simple obligatoria
		*---------------------------------------------------------
		lcSql = ;
		    "SELECT * FROM compras WHERE orden_codi = ?tnOrdenCodi"
		
		IF SQLEXEC(lnHandle, lcSql, "cur_cpra") <= 0
		    desconectar_db(lnHandle)
		    MESSAGEBOX("No se pudo cargar cur_cpra.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_cpra") OR RECCOUNT("cur_cpra") = 0
		    desconectar_db(lnHandle)
		    MESSAGEBOX("No existe la OC N° " + ALLTRIM(TRANSFORM(tnOrdenCodi)) + " en compras.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		SELECT cur_cpra
		GO TOP
		lnTranCodi = NVL(cur_cpra.tran_codi, 0)
		
		*---------------------------------------------------------
		* 2. Cabecera ampliada ROBUSTA
		*    Ojo: LEFT JOIN para no perder la fila de compras
		*---------------------------------------------------------
		lcSql = ;
		    "SELECT " + ;
		    "a.orden_codi, a.orden_fech, a.prov_codi, a.orden_ref, a.orden_obser, " + ;
		    "a.orden_dto, a.tran_codi, a.iva_codi, a.cotiz_dolar, a.moneda, " + ;
		    "b.*, c.*, d.cond_desc " + ;
		    "FROM compras a " + ;
		    "LEFT JOIN iva b ON a.iva_codi = b.iva_codi " + ;
		    "LEFT JOIN proveedores c ON c.prov_codi = a.prov_codi " + ;
		    "LEFT JOIN condiva d ON c.cond_codi = d.cond_codi " + ;
		    "WHERE a.orden_codi = ?tnOrdenCodi"
		
		IF SQLEXEC(lnHandle, lcSql, "cur_datvar") <= 0
		    desconectar_db(lnHandle)
		    MESSAGEBOX("No se pudo cargar cur_datvar.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_datvar") OR RECCOUNT("cur_datvar") = 0
		    desconectar_db(lnHandle)
		    MESSAGEBOX("No se encontraron datos de cabecera para la OC N° " + ;
		               ALLTRIM(TRANSFORM(tnOrdenCodi)) + ".", 16, "Error")
		    RETURN .F.
		ENDIF
		
		SELECT cur_datvar
		GO TOP
		
		*---------------------------------------------------------
		* 3. Ubicación del proveedor
		*    Si falta, no abortar; crear cursor mínimo
		*---------------------------------------------------------
		IF TYPE("cur_datvar.loca_codi") <> "U" AND !ISNULL(cur_datvar.loca_codi) AND VAL(TRANSFORM(cur_datvar.loca_codi)) > 0
		    lcSql = ;
		        "SELECT a.*, b.cp_nro, c.provi_nomb " + ;
		        "FROM localidades a " + ;
		        "LEFT JOIN codipostales b ON a.cp_codi = b.cp_codi " + ;
		        "LEFT JOIN provincias c ON a.provi_codi = c.provi_codi " + ;
		        "WHERE a.loca_codi = ?cur_datvar.loca_codi"
		
		    IF SQLEXEC(lnHandle, lcSql, "cur_ubic") <= 0
		        IF USED("cur_ubic")
		            USE IN cur_ubic
		        ENDIF
		        CREATE CURSOR cur_ubic (loca_codi I, cp_nro C(10), provi_nomb C(60))
		        INSERT INTO cur_ubic VALUES (0, "", "")
		    ELSE
		        IF !USED("cur_ubic") OR RECCOUNT("cur_ubic") = 0
		            USE IN SELECT("cur_ubic")
		            CREATE CURSOR cur_ubic (loca_codi I, cp_nro C(10), provi_nomb C(60))
		            INSERT INTO cur_ubic VALUES (0, "", "")
		        ENDIF
		    ENDIF
		ELSE
		    CREATE CURSOR cur_ubic (loca_codi I, cp_nro C(10), provi_nomb C(60))
		    INSERT INTO cur_ubic VALUES (0, "", "")
		ENDIF
		
		LOCAL lcOldPt2, lcOldSep2, lcOldDec2
		lcOldPt2  = SET("POINT")
		lcOldSep2 = SET("SEPARATOR")
		lcOldDec2 = SET("DECIMALS")
		
		
		SET DECIMALS TO 4
		*---------------------------------------------------------
		* 4. Detalle de artículos
		*    MISMA LOGICA QUE altaocpra.command2
		*---------------------------------------------------------
		IF USED("cur_arcom")
		    USE IN cur_arcom
		ENDIF
		
		IF USED("cur_arcom_raw")
		    USE IN cur_arcom_raw
		ENDIF
		
		lcSql = ;
		    "SELECT a.artord_codi, a.orden_codi, a.art_codi, " + ;
		    "CAST(a.artord_precio AS DECIMAL(15,4)) AS artord_precio, " + ;
		    "CAST(a.artord_cant AS DECIMAL(15,3)) AS artord_cant, " + ;
		    "a.artord_ent, a.artord_dasc, a.artpro_codi, a.dap_codi, a.alter_iva, " + ;
		    "b.art_desc, b.art_med, b.art_alicuota, c.dap_desc " + ;
		    "FROM compras_articulos a " + ;
		    "INNER JOIN articulos b ON a.art_codi = b.art_codi " + ;
		    "LEFT JOIN desc_articulos_proveedores c ON c.dap_codi = a.dap_codi " + ;
		    "WHERE a.orden_codi = ?tnOrdenCodi " + ;
		    "ORDER BY a.artord_codi"
		
		IF SQLEXEC(lnHandle, lcSql, "cur_arcom") <= 0
		    desconectar_db(lnHandle)
		    MESSAGEBOX("No se pudo cargar cur_arcom.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_arcom") OR RECCOUNT("cur_arcom") = 0
		    desconectar_db(lnHandle)
		    MESSAGEBOX("La OC N° " + ALLTRIM(TRANSFORM(tnOrdenCodi)) + ;
		               " no tiene detalle de artículos para reportar.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 5. Transporte
		* - Igual lógica que altaocpra:
		*   cur_tra debe salir desde compras.tran_codi
		*---------------------------------------------------------
		IF USED("cur_tra")
		    USE IN cur_tra
		ENDIF
		
		lnTranCodi = 0
		
		IF USED("cur_cpra") AND RECCOUNT("cur_cpra") > 0
		    SELECT cur_cpra
		    GO TOP
		
		    IF TYPE("cur_cpra.tran_codi") <> "U"
		        lnTranCodi = INT(NVL(cur_cpra.tran_codi, 0))
		    ENDIF
		ENDIF
		
		IF lnTranCodi > 0
		
		    lcSql = "SELECT * FROM transportes WHERE tran_codi = ?lnTranCodi"
		
		    IF SQLEXEC(lnHandle, lcSql, "cur_tra") <= 0
		        IF USED("cur_tra")
		            USE IN cur_tra
		        ENDIF
		
		        CREATE CURSOR cur_tra ;
		            (tran_codi I, ;
		             tran_nomb C(80), ;
		             tran_desc C(80), ;
		             tran_domi C(80), ;
		             tran_tel  C(40))
		
		        INSERT INTO cur_tra VALUES ;
		            (0, "", "", "", "")
		    ELSE
		        IF !USED("cur_tra") OR RECCOUNT("cur_tra") = 0
		            IF USED("cur_tra")
		                USE IN cur_tra
		            ENDIF
		
		            CREATE CURSOR cur_tra ;
		                (tran_codi I, ;
		                 tran_nomb C(80), ;
		                 tran_desc C(80), ;
		                 tran_domi C(80), ;
		                 tran_tel  C(40))
		
		            INSERT INTO cur_tra VALUES ;
		                (0, "", "", "", "")
		        ENDIF
		    ENDIF
		
		ELSE
		
		    CREATE CURSOR cur_tra ;
		        (tran_codi I, ;
		         tran_nomb C(80), ;
		         tran_desc C(80), ;
		         tran_domi C(80), ;
		         tran_tel  C(40))
		
		    INSERT INTO cur_tra VALUES ;
		        (0, "", "", "", "")
		
		ENDIF
		
		desconectar_db(lnHandle)
		
		SET DATABASE TO
		SET POINT TO ","
		SET SEPARATOR TO "."
		
		SELECT cur_arcom
		GO TOP
		
		SET POINT TO (lcOldPt2)
		SET SEPARATOR TO (lcOldSep2)
		SET DECIMALS TO &lcOldDec2
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE prepararformularioinicial
		*=========================================================
		* FormSet.PrepararFormularioInicial
		* Carga completa ANTES de mostrar el formulario.
		*=========================================================
		LOCAL loFrm, llOk, loEx
		
		llOk = .F.
		
		IF TYPE("THIS.principal.Name") = "U"
		    RETURN .F.
		ENDIF
		
		loFrm = THIS.principal
		
		*-- Props de control del bootstrap
		IF !PEMSTATUS(THIS, "xEstaInicializando", 5)
		    THIS.AddProperty("xEstaInicializando", .F.)
		ENDIF
		IF !PEMSTATUS(THIS, "xMensajePendiente", 5)
		    THIS.AddProperty("xMensajePendiente", "")
		ENDIF
		IF !PEMSTATUS(THIS, "xInitVisualDone", 5)
		    THIS.AddProperty("xInitVisualDone", .F.)
		ENDIF
		
		THIS.xEstaInicializando = .T.
		THIS.xMensajePendiente  = ""
		THIS.xInitVisualDone    = .F.
		
		*-- Props locales del form
		IF !PEMSTATUS(loFrm, "xLoaded", 5)
		    loFrm.AddProperty("xLoaded", .F.)
		ENDIF
		IF !PEMSTATUS(loFrm, "xIsLoading", 5)
		    loFrm.AddProperty("xIsLoading", .F.)
		ENDIF
		
		loFrm.xIsLoading = .T.
		loFrm.xLoaded    = .F.
		
		loFrm.Visible    = .F.
		loFrm.LockScreen = .T.
		
		*-- Ocultar grids antes del armado
		IF PEMSTATUS(loFrm, "grd_alerts", 5)
		    loFrm.grd_alerts.Visible = .F.
		ENDIF
		IF PEMSTATUS(loFrm, "grd_prov", 5)
		    loFrm.grd_prov.Visible = .F.
		ENDIF
		IF PEMSTATUS(loFrm, "grd_venta_compra", 5)
		    loFrm.grd_venta_compra.Visible = .F.
		ENDIF
		
		*-- Defaults de combos
		IF PEMSTATUS(loFrm, "combo3", 5)
		    loFrm.combo3.Value     = "3"
		    loFrm.combo3.ListIndex = 3
		ENDIF
		IF PEMSTATUS(loFrm, "combo4", 5)
		    loFrm.combo4.Value     = "3"
		    loFrm.combo4.ListIndex = 1
		ENDIF
		
		*-- Sincronizar propiedades internas
		IF PEMSTATUS(loFrm, "xMesesCobertura", 5)
		    loFrm.xMesesCobertura = 3
		ENDIF
		IF PEMSTATUS(loFrm, "xMesesMuestra", 5)
		    loFrm.xMesesMuestra = 3
		ENDIF
		
		*-- Controles manuales ocultos al iniciar
		IF PEMSTATUS(loFrm, "text10", 5)
		    loFrm.text10.Visible = .F.
		    loFrm.text10.Value   = ""
		ENDIF
		IF PEMSTATUS(loFrm, "label15", 5)
		    loFrm.label15.Visible = .F.
		ENDIF
		IF PEMSTATUS(loFrm, "text7", 5)
		    loFrm.text7.Visible = .F.
		    loFrm.text7.Value   = 0
		ENDIF
		IF PEMSTATUS(loFrm, "label9", 5)
		    loFrm.label9.Visible = .F.
		ENDIF
		IF PEMSTATUS(loFrm, "label13", 5)
		    loFrm.label13.Visible = .F.
		ENDIF
		IF PEMSTATUS(loFrm, "label10", 5)
		    loFrm.label10.Visible = .F.
		ENDIF
		IF PEMSTATUS(loFrm, "label17", 5)
		    loFrm.label17.Visible = .F.
		ENDIF
		IF PEMSTATUS(loFrm, "label16", 5)
		    loFrm.label16.Visible = .F.
		ENDIF
		IF PEMSTATUS(loFrm, "text3", 5)
		    loFrm.text3.Visible = .F.
		    loFrm.text3.Value   = 0
		ENDIF
		IF PEMSTATUS(loFrm, "text6", 5)
		    loFrm.text6.Visible = .F.
		    loFrm.text6.Value   = 0
		ENDIF
		IF PEMSTATUS(loFrm, "text5", 5)
		    loFrm.text5.Visible = .F.
		    loFrm.text5.Value   = 0
		ENDIF
		IF PEMSTATUS(loFrm, "text9", 5)
		    loFrm.text9.Visible = .F.
		    loFrm.text9.Value   = 0
		ENDIF
		IF PEMSTATUS(loFrm, "text8", 5)
		    loFrm.text8.Visible = .F.
		    loFrm.text8.Value   = 0
		ENDIF
		
		TRY
		    *-----------------------------------------------------
		    * CARGA PESADA CENTRALIZADA
		    *-----------------------------------------------------
		    IF PEMSTATUS(THIS, "RunPipeline", 5)
		        llOk = THIS.RunPipeline()
		    ELSE
		        ERROR "El método RunPipeline no existe en el FormSet."
		    ENDIF
		
		    IF llOk
		        IF PEMSTATUS(THIS, "PosicionarPrimerRegistroAlerts", 5)
		            THIS.PosicionarPrimerRegistroAlerts()
		        ENDIF
		
		        IF PEMSTATUS(loFrm, "grd_alerts", 5)
		            loFrm.grd_alerts.Visible = .T.
		            loFrm.grd_alerts.Refresh()
		        ENDIF
		        IF PEMSTATUS(loFrm, "grd_prov", 5)
		            loFrm.grd_prov.Visible = .T.
		            loFrm.grd_prov.Refresh()
		        ENDIF
		        IF PEMSTATUS(loFrm, "grd_venta_compra", 5)
		            loFrm.grd_venta_compra.Visible = .T.
		            loFrm.grd_venta_compra.Refresh()
		        ENDIF
		
		        loFrm.Draw()
		    ENDIF
		
		CATCH TO loEx
		    llOk = .F.
		    MESSAGEBOX("Error en PrepararFormularioInicial: " + TRANSFORM(loEx.Message), 16, "FormSet")
		FINALLY
		    loFrm.LockScreen = .F.
		    loFrm.xIsLoading = .F.
		    loFrm.xLoaded    = llOk
		    THIS.xEstaInicializando = .F.
		ENDTRY
		
		IF llOk
		    THIS.xInitVisualDone = .T.
		ENDIF
		
		RETURN llOk
	ENDPROC

	PROCEDURE prepararreporteocmasivatemporal
		*=========================================================
		* FormSet.PrepararReporteOCMasivaTemporal
		* - Copia ordendecompra.frx/frt a TEMP
		* - Corrige SOLO en la copia el ancho del campo Cantidad
		* - NO modifica EXPR
		* - NO modifica PICTURE
		* - NO modifica ordendecompra original
		*=========================================================
		LPARAMETERS tcReporteBase
		
		LOCAL lcReporteBase
		LOCAL lcSrcFrx, lcSrcFrt
		LOCAL lcTmpBase, lcTmpFrx, lcTmpFrt
		LOCAL lcOldAlias
		LOCAL llOk
		
		llOk = .F.
		
		lcReporteBase = ALLTRIM(NVL(tcReporteBase, ""))
		
		IF EMPTY(lcReporteBase)
		    lcReporteBase = "ordendecompra"
		ENDIF
		
		lcReporteBase = STRTRAN(lcReporteBase, ".frx", "")
		lcReporteBase = STRTRAN(lcReporteBase, ".FRX", "")
		
		lcSrcFrx = ""
		lcSrcFrt = ""
		
		*---------------------------------------------------------
		* 1. Buscar en ruta actual / path de VFP
		*---------------------------------------------------------
		IF FILE(lcReporteBase + ".frx")
		    lcSrcFrx = FULLPATH(lcReporteBase + ".frx")
		ENDIF
		
		IF FILE(lcReporteBase + ".frt")
		    lcSrcFrt = FULLPATH(lcReporteBase + ".frt")
		ENDIF
		
		*---------------------------------------------------------
		* 2. Buscar en carpeta actual de ejecución
		*---------------------------------------------------------
		IF EMPTY(lcSrcFrx)
		    IF FILE(ADDBS(CURDIR()) + lcReporteBase + ".frx")
		        lcSrcFrx = ADDBS(CURDIR()) + lcReporteBase + ".frx"
		    ENDIF
		ENDIF
		
		IF EMPTY(lcSrcFrt)
		    IF FILE(ADDBS(CURDIR()) + lcReporteBase + ".frt")
		        lcSrcFrt = ADDBS(CURDIR()) + lcReporteBase + ".frt"
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 3. Buscar en carpeta FORMULARIOS conocida
		*---------------------------------------------------------
		IF EMPTY(lcSrcFrx)
		    IF FILE("C:\VFP9_MYSQL\FORMULARIOS\" + lcReporteBase + ".frx")
		        lcSrcFrx = "C:\VFP9_MYSQL\FORMULARIOS\" + lcReporteBase + ".frx"
		    ENDIF
		ENDIF
		
		IF EMPTY(lcSrcFrt)
		    IF FILE("C:\VFP9_MYSQL\FORMULARIOS\" + lcReporteBase + ".frt")
		        lcSrcFrt = "C:\VFP9_MYSQL\FORMULARIOS\" + lcReporteBase + ".frt"
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 4. Buscar en carpeta REPORTES, por si está separado
		*---------------------------------------------------------
		IF EMPTY(lcSrcFrx)
		    IF FILE("C:\VFP9_MYSQL\REPORTES\" + lcReporteBase + ".frx")
		        lcSrcFrx = "C:\VFP9_MYSQL\REPORTES\" + lcReporteBase + ".frx"
		    ENDIF
		ENDIF
		
		IF EMPTY(lcSrcFrt)
		    IF FILE("C:\VFP9_MYSQL\REPORTES\" + lcReporteBase + ".frt")
		        lcSrcFrt = "C:\VFP9_MYSQL\REPORTES\" + lcReporteBase + ".frt"
		    ENDIF
		ENDIF
		
		IF EMPTY(lcSrcFrx) OR !FILE(lcSrcFrx)
		    MESSAGEBOX("No se encontró " + lcReporteBase + ".frx." + CHR(13) + ;
		               "Buscado como reporte, no como formulario.", ;
		               16, "Error")
		    RETURN ""
		ENDIF
		
		IF EMPTY(lcSrcFrt) OR !FILE(lcSrcFrt)
		    MESSAGEBOX("No se encontró " + lcReporteBase + ".frt." + CHR(13) + ;
		               "Buscado como reporte, no como formulario.", ;
		               16, "Error")
		    RETURN ""
		ENDIF
		
		*---------------------------------------------------------
		* Crear copia temporal
		*---------------------------------------------------------
		lcTmpBase = ADDBS(SYS(2023)) + lcReporteBase + "_ocmasiva_" + SYS(2015)
		
		lcTmpFrx = lcTmpBase + ".frx"
		lcTmpFrt = lcTmpBase + ".frt"
		
		COPY FILE (lcSrcFrx) TO (lcTmpFrx)
		COPY FILE (lcSrcFrt) TO (lcTmpFrt)
		
		IF !FILE(lcTmpFrx) OR !FILE(lcTmpFrt)
		    MESSAGEBOX("No se pudo crear copia temporal del reporte OC masiva.", 16, "Error")
		    RETURN ""
		ENDIF
		
		lcOldAlias = ALIAS()
		
		USE (lcTmpFrx) EXCLUSIVE ALIAS rpt_ocmasiva
		
		*---------------------------------------------------------
		* Buscar SOLO el campo visual de cantidad.
		*
		* En ordendecompra.frx es:
		*   OBJTYPE = 8
		*   EXPR    = cur_arcom.artord_cant
		*   PICTURE = "999999.999"
		*
		* NO tocamos EXPR ni PICTURE.
		* Solo agrandamos WIDTH para evitar *********.
		*---------------------------------------------------------
		LOCATE FOR OBJTYPE = 8 AND ;
		    UPPER(ALLTRIM(EXPR)) == "CUR_ARCOM.ARTORD_CANT"
		
		IF FOUND()
		
		    *-----------------------------------------------------
		    * No tocar la expresión: sigue siendo numérica.
		    * Esto evita romper los cálculos del reporte.
		    *-----------------------------------------------------
		    REPLACE EXPR WITH "cur_arcom.artord_cant"
		
		    *-----------------------------------------------------
		    * Cambiar SOLO la máscara en la COPIA TEMPORAL.
		    * OJO: PICTURE es una expresión de carácter.
		    * Por eso debe guardarse con comillas internas.
		    *
		    * Correcto en el FRX:
		    *   "999999"
		    *
		    * Incorrecto:
		    *   999999
		    *
		    * Si queda sin comillas, VFP/FoxyPreviewer puede tirar:
		    *   Not a character expression.
		    *-----------------------------------------------------
		    REPLACE PICTURE WITH ["999999"]
		
		    *-----------------------------------------------------
		    * Agrandar un poco el ancho del campo Cant.
		    * Tu reporte original tiene aprox 0,822 in.
		    * Esto le da más aire en la copia temporal.
		    *-----------------------------------------------------
		    REPLACE WIDTH WITH 10000
		
		    llOk = .T.
		
		ELSE
		    MESSAGEBOX("No se encontró el campo visual cur_arcom.artord_cant dentro de la copia temporal de " + ;
		               lcReporteBase + ".", 48, "Aviso")
		ENDIF
		
		USE IN rpt_ocmasiva
		
		IF !EMPTY(lcOldAlias) AND USED(lcOldAlias)
		    SELECT (lcOldAlias)
		ENDIF
		
		IF !llOk
		    RETURN ""
		ENDIF
		
		RETURN lcTmpBase
	ENDPROC

	PROCEDURE probarpdfoc
		*=========================================================
		* FormSet.ProbarPDFOC
		* - Prueba rápida de generación PDF de una OC
		*=========================================================
		LOCAL llOk
		
		llOk = THISFORMSET.GuardarReporteOCEnCarpeta(24023, "C:\PDF_OC\")
		
		IF llOk
		    MESSAGEBOX("PDF generado correctamente.", 64, "Prueba OK")
		ELSE
		    MESSAGEBOX("No se pudo generar el PDF.", 16, "Prueba Error")
		ENDIF
		
		RETURN llOk
	ENDPROC

	PROCEDURE procesarcombo2
		*=========================================================
		* FormSet.ProcesarCombo2
		* Aplica el filtro según el modo actual de combo2
		* y refresca automáticamente la grilla
		*=========================================================
		LOCAL loFrm
		LOCAL lnValor, lcModo, lcTexto
		
		loFrm  = THISFORMSET.principal
		lnValor = 0
		lcModo  = ""
		lcTexto = ""
		
		IF VARTYPE(loFrm) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loFrm, "combo2", 5)
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Leer modo actual
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "xCombo2Mode", 5)
		    lcModo = UPPER(ALLTRIM(NVL(loFrm.xCombo2Mode, "")))
		ENDIF
		
		*---------------------------------------------------------
		* Leer valor actual del combo2
		*---------------------------------------------------------
		IF TYPE("loFrm.combo2.Value") $ "NI"
		    lnValor = loFrm.combo2.Value
		ELSE
		    lnValor = VAL(TRANSFORM(loFrm.combo2.Value))
		ENDIF
		
		lcTexto = ALLTRIM(NVL(loFrm.combo2.DisplayValue, ""))
		
		*---------------------------------------------------------
		* Guardar selección actual
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "xCombo2ValorActual", 5)
		    loFrm.xCombo2ValorActual = lnValor
		ENDIF
		
		DO CASE
		
		    CASE lcModo == "RUBROS"
		        IF PEMSTATUS(loFrm, "xRubCodiActual", 5)
		            loFrm.xRubCodiActual = lnValor
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		            THISFORMSET.AplicarFiltroLocal("RUBROS", lnValor)
		        ENDIF
		
		    CASE lcModo == "PROVEEDOR"
		        IF PEMSTATUS(loFrm, "xProveedorCodiActual", 5)
		            loFrm.xProveedorCodiActual = lnValor
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		            THISFORMSET.AplicarFiltroLocal("PROVEEDOR", lnValor)
		        ENDIF
		
		    CASE lcModo == "DEPURACION"
		        IF PEMSTATUS(loFrm, "xDepuracionActual", 5)
		            loFrm.xDepuracionActual = lnValor
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		            THISFORMSET.AplicarFiltroLocal("DEPURACION", lnValor)
		        ENDIF
		
		    OTHERWISE
		        RETURN .F.
		ENDCASE
		
		*---------------------------------------------------------
		* Refrescar info visual
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ActualizarInfoFiltro", 5)
		    THISFORMSET.ActualizarInfoFiltro()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		    THISFORMSET.RefrescarGrid()
		ENDIF
		
		IF PEMSTATUS(loFrm, "grd_alerts", 5)
		    loFrm.grd_alerts.Refresh()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE reaplicarordenactualcuralerts
		*=========================================================
		* FormSet.ReaplicarOrdenActualCurAlerts
		* - Reordena cur_alerts sin reconstruir el filtro
		* - Si xOrdenColorDesc=.T. => mas oscuro a mas claro
		* - Si xOrdenColorDesc=.F. => orden normal por compra
		*=========================================================
		LOCAL loFrm
		LOCAL lcSafety
		LOCAL lcArtproFecha, lcProvLista, lcColBack, lcColFore
		LOCAL lcObservacion
		LOCAL lnItem
		LOCAL lnPos, lnMin, lnPct, lnRank
		LOCAL lnPuntoAlerta, lnDif, lnRatio, lnLum, lnColor
		LOCAL lnR, lnG, lnB, lnLim
		
		loFrm = THISFORMSET.principal
		IF VARTYPE(loFrm) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") <= 0
		    RETURN .F.
		ENDIF
		
		IF USED("cur_sorted")
		    USE IN cur_sorted
		ENDIF
		
		*---------------------------------------------------------
		* Blindaje de campos opcionales
		*---------------------------------------------------------
		lcArtproFecha = IIF(TYPE("cur_alerts.artpro_fecha") = "U", ;
		    "CAST({} AS D)", ;
		    "CAST(NVL(cur_alerts.artpro_fecha,{}) AS D)")
		
		lcProvLista = IIF(TYPE("cur_alerts.prov_lista") = "U", ;
		    "CAST('' AS M)", ;
		    "CAST(NVL(cur_alerts.prov_lista,'') AS M)")
		
		lcColBack = IIF(TYPE("cur_alerts.col_back") = "U", ;
		    "CAST(0 AS N(12,0))", ;
		    "CAST(NVL(cur_alerts.col_back,0) AS N(12,0))")
		
		lcColFore = IIF(TYPE("cur_alerts.col_fore") = "U", ;
		    "CAST(0 AS N(12,0))", ;
		    "CAST(NVL(cur_alerts.col_fore,0) AS N(12,0))")
		
		lcObservacion = IIF(TYPE("cur_alerts.observacion") = "U", ;
		    "CAST('' AS M)", ;
		    "CAST(NVL(cur_alerts.observacion,'') AS M)")
		
		*---------------------------------------------------------
		* Blindar ui_color_rank si no existe
		*---------------------------------------------------------
		IF TYPE("cur_alerts.ui_color_rank") = "U"
		    SELECT cur_alerts
		    ALTER TABLE cur_alerts ADD COLUMN ui_color_rank I
		    REPLACE ALL ui_color_rank WITH 0
		ENDIF
		
		*---------------------------------------------------------
		* Calcular prioridad de color usando la MISMA logica
		* que DynBack_Alerta (mas oscuro = mayor prioridad)
		*---------------------------------------------------------
		SELECT cur_alerts
		GO TOP
		SCAN
		    lnPos = NVL(cur_alerts.posicion, 0)
		    lnMin = NVL(cur_alerts.art_stmin, 0)
		    lnPct = NVL(cur_alerts.art_pct_alerta, 0)
		
			lnPuntoAlerta = lnMin * (1 + (lnPct / 100))
		
			IF lnPos < 0
			    IF lnPuntoAlerta > 0
			        lnRatio = MIN(1, (-lnPos) / lnPuntoAlerta)
			    ELSE
			        lnRatio = 1
			    ENDIF
			    lnR = INT(160 - (70 * lnRatio))
			    lnG = INT(100 - (70 * lnRatio))
			    lnB = 255
			    lnColor = RGB(lnR, lnG, lnB)
			    lnRank  = 2000 + INT(lnRatio * 500)
			ELSE
			    IF lnPuntoAlerta <= 0 OR lnPos >= lnPuntoAlerta
			        lnColor = RGB(255,255,255)
			        lnRank  = 0
			    ELSE
			        lnDif   = lnPuntoAlerta - lnPos
			        lnRatio = MIN(1, MAX(0, lnDif / lnPuntoAlerta))
			        lnR = 255
			        lnG = INT(235 - (135 * lnRatio))
			        lnB = INT(235 - (135 * lnRatio))
			        lnColor = RGB(lnR, lnG, lnB)
			        lnLum  = (lnR * 0.299) + (lnG * 0.587) + (lnB * 0.114)
			        lnRank = 1000 - lnLum
			    ENDIF
			ENDIF
		
			REPLACE ui_color_rank WITH lnRank IN cur_alerts
		
		
		ENDSCAN
		
		*---------------------------------------------------------
		* Armar orden temporal
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "xOrdenColorDesc", 5) AND loFrm.xOrdenColorDesc
		    SELECT ;
		        art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		        pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		        ventas_metrics, promedio_venta, fecha_ult_venta, ;
		        compras_metrics, promedio_compra, fecha_ult_compra, ;
		        dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		        cant_soli, meses_cubiertos, meses_cob_proy, meses_cobert_solic, ;
		        score, rub_codi, rub_desc, estado, ;
		        prov_codi_sel, prov_nomb_sel, artpro_costo, artpro_moneda, ;
		        &lcArtproFecha AS artpro_fecha, ;
		        &lcProvLista   AS prov_lista, ;
		        &lcColBack     AS col_back, ;
		        &lcColFore     AS col_fore, ;
		        ui_color_rank, ;
		        &lcObservacion AS observacion, ;
		        ui_item, ui_sel ;
		    FROM cur_alerts ;
		    ORDER BY ui_color_rank DESC, sugerido_comprar DESC, pct_rotacion DESC, art_desc ASC ;
		    INTO CURSOR cur_sorted READWRITE
		ELSE
		    SELECT ;
		        art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		        pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		        ventas_metrics, promedio_venta, fecha_ult_venta, ;
		        compras_metrics, promedio_compra, fecha_ult_compra, ;
		        dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		        cant_soli, meses_cubiertos, meses_cob_proy, meses_cobert_solic, ;
		        score, rub_codi, rub_desc, estado, ;
		        prov_codi_sel, prov_nomb_sel, artpro_costo, artpro_moneda, ;
		        &lcArtproFecha AS artpro_fecha, ;
		        &lcProvLista   AS prov_lista, ;
		        &lcColBack     AS col_back, ;
		        &lcColFore     AS col_fore, ;
		        ui_color_rank, ;
		        &lcObservacion AS observacion, ;
		        ui_item, ui_sel ;
		    FROM cur_alerts ;
		    ORDER BY sugerido_comprar DESC, pct_rotacion DESC, art_desc ASC ;
		    INTO CURSOR cur_sorted READWRITE
		ENDIF
		
		IF !USED("cur_sorted")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Volver a cargar cur_alerts sin reconstruir filtro
		*---------------------------------------------------------
		lcSafety = SET("SAFETY")
		SET SAFETY OFF
		
		SELECT cur_alerts
		ZAP
		
		INSERT INTO cur_alerts ;
		    ( art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		      pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		      ventas_metrics, promedio_venta, fecha_ult_venta, ;
		      compras_metrics, promedio_compra, fecha_ult_compra, ;
		      dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		      cant_soli, meses_cubiertos, meses_cob_proy, meses_cobert_solic, ;
		      score, rub_codi, rub_desc, estado, ;
		      prov_codi_sel, prov_nomb_sel, artpro_costo, artpro_moneda, artpro_fecha, ;
		      prov_lista, col_back, col_fore, ui_color_rank, observacion, ui_item, ui_sel ) ;
		SELECT ;
		      art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		      pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		      ventas_metrics, promedio_venta, fecha_ult_venta, ;
		      compras_metrics, promedio_compra, fecha_ult_compra, ;
		      dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		      cant_soli, meses_cubiertos, meses_cob_proy, meses_cobert_solic, ;
		      score, rub_codi, rub_desc, estado, ;
		      prov_codi_sel, prov_nomb_sel, artpro_costo, artpro_moneda, artpro_fecha, ;
		      prov_lista, col_back, col_fore, ui_color_rank, observacion, ui_item, ui_sel ;
		FROM cur_sorted
		
		IF UPPER(ALLTRIM(lcSafety)) == "ON"
		    SET SAFETY ON
		ELSE
		    SET SAFETY OFF
		ENDIF
		
		USE IN cur_sorted
		
		*---------------------------------------------------------
		* Renumerar
		*---------------------------------------------------------
		SELECT cur_alerts
		lnItem = 0
		GO TOP
		SCAN
		    lnItem = lnItem + 1
		    REPLACE ui_item WITH ALLTRIM(STR(lnItem))
		ENDSCAN
		
		*---------------------------------------------------------
		* Reposicionar
		*---------------------------------------------------------
		IF RECCOUNT("cur_alerts") > 0
		    GO TOP
		    IF PEMSTATUS(loFrm, "xCurRec", 5)
		        loFrm.xCurRec = RECNO("cur_alerts")
		    ENDIF
		    IF PEMSTATUS(loFrm, "xCurArt", 5)
		        loFrm.xCurArt = IIF(TYPE("cur_alerts.art_codi") = "N", cur_alerts.art_codi, 0)
		    ENDIF
		ELSE
		    IF PEMSTATUS(loFrm, "xCurRec", 5)
		        loFrm.xCurRec = 0
		    ENDIF
		    IF PEMSTATUS(loFrm, "xCurArt", 5)
		        loFrm.xCurArt = 0
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* Sincronizar UI adicional
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		    THISFORMSET.SincronizarBotonMasivo()
		ENDIF
		
		*---------------------------------------------------------
		* Refrescar UI
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		    THISFORMSET.RefrescarGrid()
		ELSE
		    IF PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.Refresh()
		    ENDIF
		    IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		        THISFORMSET.ActualizarEfectoGrid()
		    ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE rebuildalertscursorfromraw
		*=========================================================
		* FormSet.RebuildAlertsCursorFromRaw
		* - Actualizado para:
		*   proveedor seleccionado / costo / lista proveedores
		* - Nunca reemplaza cur_alerts
		* - Siempre usa ZAP + APPEND para preservar bindings del grid
		*=========================================================
		LOCAL loFrm, loConsulta
		LOCAL laSel[1], lnSelCnt, lnItem, i
		LOCAL llHadAlerts, lcSafety
		LOCAL lcMesesCobProy, lcScore, lcPosicion, lcSugNeto, lcPctRotacion
		LOCAL lcFechaVenta, lcFechaCompra, lcVentasMetrics, lcComprasMetrics
		LOCAL lcProvCodiSel, lcProvNombSel, lcArtproCosto, lcProvLista
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF !USED("cur_raw")
		    MESSAGEBOX("cur_raw no existe.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		lnSelCnt    = 0
		llHadAlerts = USED("cur_alerts")
		
		IF llHadAlerts
		    SELECT cur_alerts
		    SCAN FOR ui_sel
		        lnSelCnt = lnSelCnt + 1
		        DIMENSION laSel[lnSelCnt]
		        laSel[lnSelCnt] = art_codi
		    ENDSCAN
		ENDIF
		
		IF USED("cur_temp")
		    USE IN cur_temp
		ENDIF
		
		lcPosicion       = IIF(TYPE("cur_raw.posicion")="U",       "CAST(0 AS N(15,3))",   "CAST(NVL(cur_raw.posicion,0) AS N(15,3))")
		lcSugNeto        = IIF(TYPE("cur_raw.sug_neto")="U",       "CAST(0 AS N(15,3))",   "CAST(NVL(cur_raw.sug_neto,0) AS N(15,3))")
		lcPctRotacion    = IIF(TYPE("cur_raw.pct_rotacion")="U",   "CAST(0 AS N(10,3))",   "CAST(NVL(cur_raw.pct_rotacion,0) AS N(10,3))")
		lcMesesCobProy   = IIF(TYPE("cur_raw.meses_cob_proy")="U", "CAST(0 AS N(15,3))",   "CAST(NVL(cur_raw.meses_cob_proy,0) AS N(15,3))")
		lcScore          = IIF(TYPE("cur_raw.score")="U",          "CAST(0 AS I)",         "CAST(NVL(cur_raw.score,0) AS I)")
		
		lcFechaVenta     = IIF(TYPE("cur_raw.fecha_ult_venta")="U",  "CAST({} AS D)",      "CAST(NVL(cur_raw.fecha_ult_venta,{}) AS D)")
		lcFechaCompra    = IIF(TYPE("cur_raw.fecha_ult_compra")="U", "CAST({} AS D)",      "CAST(NVL(cur_raw.fecha_ult_compra,{}) AS D)")
		
		lcVentasMetrics  = IIF(TYPE("cur_raw.ventas_metrics")="U",   "CAST('' AS M)",      "CAST(NVL(cur_raw.ventas_metrics,'') AS M)")
		lcComprasMetrics = IIF(TYPE("cur_raw.compras_metrics")="U",  "CAST('' AS M)",      "CAST(NVL(cur_raw.compras_metrics,'') AS M)")
		
		lcProvCodiSel    = IIF(TYPE("cur_raw.prov_codi_sel")="U",    "CAST(0 AS I)",       "CAST(NVL(cur_raw.prov_codi_sel,0) AS I)")
		lcProvNombSel    = IIF(TYPE("cur_raw.prov_nomb_sel")="U",    "CAST('' AS C(80))",  "CAST(NVL(cur_raw.prov_nomb_sel,'') AS C(80))")
		lcArtproCosto    = IIF(TYPE("cur_raw.artpro_costo")="U",     "CAST(0 AS N(15,4))", "CAST(NVL(cur_raw.artpro_costo,0) AS N(15,4))")
		lcProvLista      = IIF(TYPE("cur_raw.prov_lista")="U",       "CAST('' AS M)",      "CAST(NVL(cur_raw.prov_lista,'') AS M)")
		
		SELECT ;
		    cur_raw.art_codi, ;
		    cur_raw.art_desc, ;
		    CAST(NVL(cur_raw.art_stock,0) AS N(15,3)) AS art_stock, ;
		    CAST(NVL(cur_raw.art_stmin,0) AS N(15,3)) AS art_stmin, ;
		    CAST(NVL(cur_raw.pedidos,0)   AS N(15,3)) AS pedidos, ;
		    CAST(NVL(cur_raw.pedprov,0)   AS N(15,3)) AS pedprov, ;
		    CAST(IIF(TYPE("cur_raw.art_pct_alerta")="U",0,NVL(cur_raw.art_pct_alerta,0)) AS N(10,2)) AS art_pct_alerta, ;
		    &lcPosicion AS posicion, ;
		    &lcSugNeto AS sug_neto, ;
		    &lcPctRotacion AS pct_rotacion, ;
		    &lcVentasMetrics AS ventas_metrics, ;
		    CAST(IIF(TYPE("cur_raw.promedio_venta")="U",0,NVL(cur_raw.promedio_venta,0)) AS N(15,3)) AS promedio_venta, ;
		    &lcFechaVenta AS fecha_ult_venta, ;
		    &lcComprasMetrics AS compras_metrics, ;
		    CAST(IIF(TYPE("cur_raw.promedio_compra")="U",0,NVL(cur_raw.promedio_compra,0)) AS N(15,3)) AS promedio_compra, ;
		    &lcFechaCompra AS fecha_ult_compra, ;
		    CAST(IIF(TYPE("cur_raw.dias_demora_ent")="U",15,NVL(cur_raw.dias_demora_ent,15)) AS I) AS dias_demora_ent, ;
		    CAST(IIF(TYPE("cur_raw.pos_min_sug")="U",0,NVL(cur_raw.pos_min_sug,0)) AS N(15,3)) AS pos_min_sug, ;
		    CAST(IIF(TYPE("cur_raw.sugerido_comprar")="U",0,NVL(cur_raw.sugerido_comprar,0)) AS N(15,3)) AS sugerido_comprar, ;
		    CAST(IIF(TYPE("cur_raw.meses_cubiertos")="U",0,NVL(cur_raw.meses_cubiertos,0)) AS N(15,3)) AS meses_cubiertos, ;
		    &lcMesesCobProy AS meses_cob_proy, ;
		    CAST(IIF(TYPE("cur_raw.meses_cobert_solic")="U",3,NVL(cur_raw.meses_cobert_solic,3)) AS N(15,3)) AS meses_cobert_solic, ;
		    &lcScore AS score, ;
		    CAST(IIF(TYPE("cur_raw.rub_codi")="U",0,NVL(cur_raw.rub_codi,0)) AS I) AS rub_codi, ;
		    CAST(IIF(TYPE("cur_raw.rub_desc")="C",NVL(cur_raw.rub_desc,''),'') AS C(60)) AS rub_desc, ;
		    &lcProvCodiSel AS prov_codi_sel, ;
		    &lcProvNombSel AS prov_nomb_sel, ;
		    &lcArtproCosto AS artpro_costo, ;
		    &lcProvLista AS prov_lista, ;
		    CAST(0 AS N(12,0)) AS col_back, ;
		    CAST(0 AS N(12,0)) AS col_fore, ;
		    CAST("" AS C(8)) AS ui_item, ;
		    CAST(.F. AS L)   AS ui_sel ;
		FROM cur_raw ;
		INTO CURSOR cur_temp READWRITE
		
		USE IN cur_raw
		
		IF !USED("cur_temp")
		    MESSAGEBOX("No se pudo generar cur_temp.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*-- Siempre ZAP + APPEND, nunca SELECT INTO cur_alerts
		IF !USED("cur_alerts")
		    IF PEMSTATUS(THISFORMSET, "ConfigurarGrid", 5)
		        THISFORMSET.ConfigurarGrid()
		    ENDIF
		
		    IF !USED("cur_alerts")
		        MESSAGEBOX("cur_alerts no existe. Llame a ConfigurarGrid() antes.", 16, "Error")
		        USE IN cur_temp
		        RETURN .F.
		    ENDIF
		ENDIF
		
		lcSafety = SET("SAFETY")
		SET SAFETY OFF
		
		SELECT cur_alerts
		ZAP
		APPEND FROM (DBF("cur_temp"))
		
		IF UPPER(ALLTRIM(lcSafety)) == "ON"
		    SET SAFETY ON
		ELSE
		    SET SAFETY OFF
		ENDIF
		
		USE IN cur_temp
		
		*---------------------------------------------------------
		* Si el raw no trajo proveedor/costo/lista, enriquecer ahora
		*---------------------------------------------------------
		*!*	IF PEMSTATUS(THISFORMSET, "CargarProveedoresEnCurAlerts", 5)
		*!*	    THISFORMSET.CargarProveedoresEnCurAlerts()
		*!*	ENDIF
		
		IF lnSelCnt > 0
		    SELECT cur_alerts
		    FOR i = 1 TO lnSelCnt
		        LOCATE FOR art_codi = laSel[i]
		        IF FOUND()
		            REPLACE ui_sel WITH .T.
		        ENDIF
		    NEXT
		ENDIF
		
		lnItem = 0
		SELECT cur_alerts
		GO TOP
		SCAN
		    lnItem = lnItem + 1
		    REPLACE ui_item WITH ALLTRIM(STR(lnItem))
		ENDSCAN
		GO TOP
		
		IF PEMSTATUS(THISFORMSET, "RecalcularColoresGrid", 5)
		    THISFORMSET.RecalcularColoresGrid()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE recalcularcoloresgrid
		*=========================================================
		* FormSet.RecalcularColoresGrid
		*=========================================================
		LOCAL lnSavedRec, lnOldArea
		LOCAL lnPos, lnMin, lnPct, lnPunto
		LOCAL lnDif, lnRatio, lnG, lnBack, lnFore
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0
		    RETURN
		ENDIF
		
		IF TYPE("cur_alerts.col_back") = "U" OR TYPE("cur_alerts.col_fore") = "U"
		    RETURN
		ENDIF
		
		lnOldArea  = SELECT()
		lnSavedRec = RECNO("cur_alerts")
		
		SELECT cur_alerts
		GO TOP
		SCAN
		    lnPos   = NVL(cur_alerts.posicion, 0)
		    lnMin   = NVL(cur_alerts.art_stmin, 0)
		    lnPct   = NVL(cur_alerts.art_pct_alerta, 0)
			lnPunto = lnMin * (1 + (lnPct / 100))
		
			IF lnPos < 0
			    IF lnPunto > 0
			        lnRatio = MIN(1, (-lnPos) / lnPunto)
			    ELSE
			        lnRatio = 1
			    ENDIF
			    lnR    = INT(160 - (70 * lnRatio))
			    lnG    = INT(100 - (70 * lnRatio))
			    lnBack = RGB(lnR, lnG, 255)
			    lnFore = RGB(255, 255, 255)
			ELSE
			    IF lnPunto <= 0 OR lnPos >= lnPunto
			        lnBack = RGB(255, 255, 255)
			        lnFore = RGB(0, 0, 0)
			    ELSE
			        lnDif   = lnPunto - lnPos
			        lnRatio = MIN(1, MAX(0, lnDif / lnPunto))
			        lnG     = INT(235 - (135 * lnRatio))
			        lnBack  = RGB(255, lnG, lnG)
			        IF lnMin > 0 AND lnPos < lnMin
			            lnFore = RGB(60, 60, 60)
			        ELSE
			            lnFore = RGB(0, 0, 0)
			        ENDIF
			    ENDIF
			ENDIF
		
			REPLACE col_back WITH lnBack, ;
			        col_fore WITH lnFore
		
		
		ENDSCAN
		
		IF BETWEEN(lnSavedRec, 1, RECCOUNT("cur_alerts"))
		    GO lnSavedRec
		ENDIF
		
		IF lnOldArea > 0
		    SELECT (lnOldArea)
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE recalcularsugeridolocal
		*=========================================================
		* FormSet.RecalcularSugeridoLocal
		* - Recalcula métricas y reconstruye proveedor/costo/lista
		* - Respeta SIEMPRE el filtro activo y el valor actual de combo2
		*=========================================================
		LOCAL loFrm, loConsulta
		LOCAL lnCob, lnMue, lnConn, lnRet, lcSQL
		LOCAL lcFiltro, lcModoCombo2
		LOCAL lnCombo2Valor
		LOCAL llOk
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		lnCob = VAL(TRANSFORM(loFrm.combo3.Value))
		lnMue = VAL(TRANSFORM(loFrm.combo4.Value))
		
		lnCob = MIN(12, MAX(1, lnCob))
		lnMue = MIN(12, MAX(3, lnMue))
		
		IF !PEMSTATUS(loFrm, "xMesesCobertura", 5)
		    loFrm.AddProperty("xMesesCobertura", lnCob)
		ENDIF
		IF !PEMSTATUS(loFrm, "xMesesMuestra", 5)
		    loFrm.AddProperty("xMesesMuestra", lnMue)
		ENDIF
		IF !PEMSTATUS(loFrm, "xFiltroActual", 5)
		    loFrm.AddProperty("xFiltroActual", "TODOS")
		ENDIF
		IF !PEMSTATUS(loFrm, "xRubCodiActual", 5)
		    loFrm.AddProperty("xRubCodiActual", 0)
		ENDIF
		IF !PEMSTATUS(loFrm, "xCombo2Mode", 5)
		    loFrm.AddProperty("xCombo2Mode", "")
		ENDIF
		IF !PEMSTATUS(loFrm, "xCombo2ValorActual", 5)
		    loFrm.AddProperty("xCombo2ValorActual", 0)
		ENDIF
		IF !PEMSTATUS(loFrm, "xProveedorCodiActual", 5)
		    loFrm.AddProperty("xProveedorCodiActual", 0)
		ENDIF
		IF !PEMSTATUS(loFrm, "xDEPURACIÓNActual", 5)
		    loFrm.AddProperty("xDEPURACIÓNActual", 0)
		ENDIF
		
		loFrm.xMesesCobertura = lnCob
		loFrm.xMesesMuestra   = lnMue
		
		lcFiltro      = UPPER(ALLTRIM(NVL(loFrm.xFiltroActual, "TODOS")))
		lcModoCombo2  = UPPER(ALLTRIM(NVL(loFrm.xCombo2Mode, "")))
		lnCombo2Valor = 0
		
		IF PEMSTATUS(loFrm, "combo1", 5)
		    IF !EMPTY(ALLTRIM(loFrm.combo1.DisplayValue))
		        lcFiltro = UPPER(ALLTRIM(loFrm.combo1.DisplayValue))
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(loFrm, "combo2", 5)
		    IF TYPE("loFrm.combo2.Value") $ "NI"
		        lnCombo2Valor = loFrm.combo2.Value
		    ELSE
		        lnCombo2Valor = VAL(TRANSFORM(loFrm.combo2.Value))
		    ENDIF
		ENDIF
		
		IF lnCombo2Valor <= 0
		    lnCombo2Valor = NVL(loFrm.xCombo2ValorActual, 0)
		ENDIF
		
		loFrm.xFiltroActual      = lcFiltro
		loFrm.xCombo2Mode        = lcModoCombo2
		loFrm.xCombo2ValorActual = lnCombo2Valor
		
		IF lcFiltro == "RUBROS"
		    loFrm.xRubCodiActual = lnCombo2Valor
		ENDIF
		
		IF lcFiltro == "PROVEEDOR"
		    loFrm.xProveedorCodiActual = lnCombo2Valor
		ENDIF
		
		IF lcFiltro == "DEPURACIÓN"
		    loFrm.xDEPURACIÓNActual = lnCombo2Valor
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL para recalcular.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		WAIT WINDOW "Recalculando métricas en el servidor..." NOWAIT
		
		TEXT TO lcSQL NOSHOW PRETEXT 15
		    CALL usp_recalcular_art_metricas(?lnMue, ?lnCob)
		ENDTEXT
		
		lnRet = SQLEXEC(lnConn, lcSQL)
		Desconectar_DB(lnConn)
		
		IF lnRet < 0
		    WAIT CLEAR
		    MESSAGEBOX("Ocurrió un error al ejecutar el cálculo en MySQL.", 16, "Error SQL")
		    RETURN .F.
		ENDIF
		
		llOk = .T.
		
		IF PEMSTATUS(THISFORMSET, "CargarAlertasStockFull", 5)
		    llOk = THISFORMSET.CargarAlertasStockFull()
		ENDIF
		
		IF !llOk
		    WAIT CLEAR
		    RETURN .F.
		ENDIF
		
		DO CASE
		
		CASE lcFiltro == "RUBROS"
		
		    loFrm.xFiltroActual  = "RUBROS"
		    loFrm.xCombo2Mode    = "RUBROS"
		    loFrm.xRubCodiActual = lnCombo2Valor
		
		    IF PEMSTATUS(THISFORMSET, "CargarComboRubros", 5)
		        THISFORMSET.CargarComboRubros()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		        llOk = THISFORMSET.AplicarFiltroLocal("RUBROS", lnCombo2Valor)
		    ENDIF
		
		CASE lcFiltro == "PROVEEDOR"
		
		    loFrm.xFiltroActual        = "PROVEEDOR"
		    loFrm.xCombo2Mode          = "PROVEEDOR"
		    loFrm.xProveedorCodiActual = lnCombo2Valor
		
		    IF PEMSTATUS(THISFORMSET, "CargarComboProveedores", 5)
		        THISFORMSET.CargarComboProveedores()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroProveedor", 5)
		        llOk = THISFORMSET.AplicarFiltroProveedor(lnCombo2Valor)
		    ENDIF
		
		CASE lcFiltro == "DEPURACIÓN"
		
		    loFrm.xFiltroActual     = "DEPURACIÓN"
		    loFrm.xCombo2Mode       = "DEPURACIÓN"
		    loFrm.xDEPURACIÓNActual = lnCombo2Valor
		
		    IF PEMSTATUS(THISFORMSET, "CargarComboDEPURACIÓN", 5)
		        THISFORMSET.CargarComboDEPURACIÓN()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroDEPURACIÓN", 5)
		        llOk = THISFORMSET.AplicarFiltroDEPURACIÓN(lnCombo2Valor)
		    ENDIF
		
		OTHERWISE
		
		    loFrm.xFiltroActual = lcFiltro
		
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		        llOk = THISFORMSET.AplicarFiltroLocal(lcFiltro, 0)
		    ENDIF
		
		ENDCASE
		
		loFrm.LockScreen = .T.
		
		IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		    THISFORMSET.RefrescarGrid()
		ELSE
		    IF PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.Refresh()
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "SincronizarPedido", 5)
		    THISFORMSET.SincronizarPedido()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		    THISFORMSET.SincronizarBotonMasivo()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "PosicionarPrimerRegistroAlerts", 5)
		    THISFORMSET.PosicionarPrimerRegistroAlerts()
		ENDIF
		
		IF USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0
		    SELECT cur_alerts
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text4", 5)
		    loFrm.Text4.Refresh()
		ENDIF
		IF PEMSTATUS(loFrm, "Text11", 5)
		    loFrm.Text11.Refresh()
		ENDIF
		IF PEMSTATUS(loFrm, "Text13", 5)
		    loFrm.Text13.Refresh()
		ENDIF
		IF PEMSTATUS(loFrm, "Text12", 5)
		    loFrm.Text12.Refresh()
		ENDIF
		
		IF PEMSTATUS(loFrm, "combo1", 5)
		    loFrm.combo1.DisplayValue = lcFiltro
		ENDIF
		
		IF lcFiltro $ "RUBROS,PROVEEDOR,DEPURACIÓN" AND PEMSTATUS(loFrm, "combo2", 5)
		    TRY
		        loFrm.combo2.Value = lnCombo2Valor
		    CATCH
		    ENDTRY
		ENDIF
		
		loFrm.LockScreen = .F.
		loFrm.Draw()
		WAIT CLEAR
		RETURN llOk
	ENDPROC

	PROCEDURE refrescargrid
		*=========================================================
		* FormSet.RefrescarGrid
		* - Refresca grid
		* - Actualiza contador
		* - Reposiciona siempre en GO TOP
		* - Sincroniza xCurRec / xCurArt
		* - Reaplica ControlSources defensivamente
		*=========================================================
		LOCAL loFrm, loConsulta, loEx
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF !USED("cur_alerts")
		    RETURN .F.
		ENDIF
		
		SELECT cur_alerts
		
		IF RECCOUNT("cur_alerts") > 0
		    GO TOP
		
		    IF PEMSTATUS(loFrm, "xCurRec", 5)
		        loFrm.xCurRec = RECNO("cur_alerts")
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xCurArt", 5)
		        loFrm.xCurArt = IIF(TYPE("cur_alerts.art_codi") = "N", cur_alerts.art_codi, 0)
		    ENDIF
		ELSE
		    IF PEMSTATUS(loFrm, "xCurRec", 5)
		        loFrm.xCurRec = 0
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xCurArt", 5)
		        loFrm.xCurArt = 0
		    ENDIF
		ENDIF
		
		*-- Re-aplicar ControlSources siempre:
		*-- pueden perderse si cur_alerts fue reemplazado en algún punto
		IF PEMSTATUS(loFrm, "grd_alerts", 5) AND loFrm.grd_alerts.ColumnCount >= 13
		    WITH loFrm.grd_alerts
		        .RecordSource = "cur_alerts"
		        .Columns(1).ControlSource  = "cur_alerts.ui_item"
		        .Columns(2).ControlSource  = "cur_alerts.art_codi"
		        .Columns(3).ControlSource  = "cur_alerts.art_desc"
		        .Columns(4).ControlSource  = "cur_alerts.art_stock"
		        .Columns(5).ControlSource  = "cur_alerts.pedprov"
		        .Columns(6).ControlSource  = "cur_alerts.pedidos"
		        .Columns(7).ControlSource  = "cur_alerts.posicion"
		        .Columns(8).ControlSource  = "cur_alerts.art_stmin"
		
		        *-- Col 9 cambia según filtro
		        IF PEMSTATUS(loFrm, "xFiltroActual", 5) AND UPPER(ALLTRIM(loFrm.xFiltroActual)) == "SELECCIONADOS"
		            .Columns(9).ControlSource = "cur_alerts.cant_soli"
		        ELSE
		            .Columns(9).ControlSource = "cur_alerts.sugerido_comprar"
		        ENDIF
		
		        .Columns(10).ControlSource = "cur_alerts.prov_nomb_sel"
		        .Columns(11).ControlSource = "cur_alerts.artpro_costo"
		        .Columns(12).ControlSource = "cur_alerts.artpro_moneda"
		        .Columns(13).ControlSource = "cur_alerts.ui_sel"
				IF .ColumnCount >= 14
				    .Columns(14).ControlSource = "cur_alerts.ui_item"
				ENDIF
		    ENDWITH
		ENDIF
		
		IF PEMSTATUS(loFrm, "grd_alerts", 5)
		    loFrm.grd_alerts.Refresh()
		ENDIF
		
		IF PEMSTATUS(loFrm, "lbl_cont", 5)
		    loFrm.lbl_cont.Caption = ALLTRIM(STR(RECCOUNT("cur_alerts"))) + " registros"
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		    TRY
		        THISFORMSET.ActualizarEfectoGrid(0)
		    CATCH TO loEx
		        MESSAGEBOX("Error en ActualizarEfectoGrid:" + CHR(13) + loEx.Message, 16, "RefrescarGrid")
		    ENDTRY
		ENDIF
		
		*-- Si agregaste carga de grid1, envolver también
		IF PEMSTATUS(THISFORMSET, "CargarClientesArticuloSeleccionado", 5)
		    THISFORMSET.CargarClientesArticuloSeleccionado()
		ENDIF
		
		*-- ActualizarEfectoGrid puede dejar otro alias activo; restaurar
		IF USED("cur_alerts")
		    SELECT cur_alerts
		ENDIF
		
		*-- Refrescar textos de métricas
		IF PEMSTATUS(loFrm, "Text4", 5)
		    loFrm.Text4.Refresh()
		ENDIF
		IF PEMSTATUS(loFrm, "Text11", 5)
		    loFrm.Text11.Refresh()
		ENDIF
		IF PEMSTATUS(loFrm, "Text12", 5)
		    loFrm.Text12.Refresh()
		ENDIF
		IF PEMSTATUS(loFrm, "Text13", 5)
		    loFrm.Text13.Refresh()
		ENDIF
		IF PEMSTATUS(THISFORMSET, "ActualizarEstadoDetalle", 5)
		    THISFORMSET.ActualizarEstadoDetalle()
		ENDIF
		IF PEMSTATUS(THISFORMSET, "RefreshVentaCompraGrid", 5)
		    THISFORMSET.RefreshVentaCompraGrid()
		ENDIF
		IF PEMSTATUS(THISFORMSET, "CargarGrdProv", 5)
		    THISFORMSET.CargarGrdProv()
		ENDIF
		RETURN .T.
		
	ENDPROC

	PROCEDURE refrescargridtransporte
		*=========================================================
		* FormSet.RefrescarGridTransporte
		* Guarda transporte del item actual en solicitud_compra_art
		*
		* Permite seleccionar transporte vacío:
		* - En el combo se muestra como " "  (un espacio)
		* - En cur_soli_det se guarda como:
		*       tran_codi = 0
		*       tran_nomb = ""
		* - En MySQL se guarda como:
		*       tran_codi = NULL
		*
		* REGLA:
		* - NULL = vacío / sin asignar
		* - >0   = transporte seleccionado
		*=========================================================
		
		LOCAL loConsulta, loGrid, loCombo
		LOCAL lnSoliCodi, lnArtCodi, lnTranCodi
		LOCAL lcTranNomb, lcTranCodiTxt, lcTranNombRaw, lcBlancoVisual
		LOCAL lnConn, lnRet, lcSQL
		LOCAL lcAlias
		LOCAL lnListIndex
		LOCAL lcErrMsg
		LOCAL llComboSeleccionado
		LOCAL ARRAY laErr[1]
		
		loConsulta = .NULL.
		loGrid     = .NULL.
		loCombo    = .NULL.
		
		lnSoliCodi        = 0
		lnArtCodi         = 0
		lnTranCodi        = 0
		lcTranNomb        = ""
		lcTranNombRaw     = ""
		lcBlancoVisual    = CHR(160)
		lcTranCodiTxt     = ""
		lnListIndex       = 0
		lnConn            = 0
		lnRet             = 0
		lcSQL             = ""
		lcAlias           = ""
		lcErrMsg          = ""
		llComboSeleccionado = .F.
		
		*---------------------------------------------------------
		* 1) Obtener form secundario / grid2
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF VARTYPE(loConsulta) <> "O"
		    RETURN .F.
		ENDIF
		
		*-- No guardar mientras CargarDetalleSolicitud está reconstruyendo datos
		IF PEMSTATUS(loConsulta, "xCargandoDetalle", 5)
		    IF loConsulta.xCargandoDetalle
		        RETURN .T.
		    ENDIF
		ENDIF
		
		IF !PEMSTATUS(loConsulta, "xSoliCodiActual", 5)
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(loConsulta, "grid2", 5)
		    loGrid = loConsulta.grid2
		ENDIF
		
		IF VARTYPE(loGrid) <> "O" OR loGrid.ColumnCount < 8
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_soli_det") OR RECCOUNT("cur_soli_det") <= 0
		    RETURN .F.
		ENDIF
		
		IF EOF("cur_soli_det")
		    GO BOTTOM IN cur_soli_det
		ENDIF
		
		IF BOF("cur_soli_det")
		    GO TOP IN cur_soli_det
		ENDIF
		
		*---------------------------------------------------------
		* 2) Datos base de solicitud / artículo
		*---------------------------------------------------------
		lnSoliCodi = NVL(loConsulta.xSoliCodiActual, 0)
		lnArtCodi  = NVL(cur_soli_det.art_codi, 0)
		
		IF VARTYPE(lnSoliCodi) <> "N"
		    lnSoliCodi = VAL(TRANSFORM(lnSoliCodi))
		ENDIF
		
		IF VARTYPE(lnArtCodi) <> "N"
		    lnArtCodi = VAL(TRANSFORM(lnArtCodi))
		ENDIF
		
		lnSoliCodi = INT(NVL(lnSoliCodi, 0))
		lnArtCodi  = INT(NVL(lnArtCodi, 0))
		
		IF lnSoliCodi <= 0 OR lnArtCodi <= 0
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 3) Leer selección real desde el ComboBox
		*---------------------------------------------------------
		IF PEMSTATUS(loGrid.Columns(8), "cboTransporte", 5)
		    loCombo = loGrid.Columns(8).cboTransporte
		ENDIF
		
		IF VARTYPE(loCombo) = "O"
		
		    lnListIndex = loCombo.ListIndex
		
		    IF VARTYPE(lnListIndex) = "N" AND lnListIndex > 0
		
		        llComboSeleccionado = .T.
		
		        *-------------------------------------------------
		        * IMPORTANTE:
		        * No usar ALLTRIM todavía.
		        * El item vacío viene como " " y debe ser válido.
		        *-------------------------------------------------
		        lcTranNombRaw = TRANSFORM(loCombo.List(lnListIndex, 1))
		
		        *-- Columna 2: código oculto
		        lcTranCodiTxt = ALLTRIM(TRANSFORM(loCombo.List(lnListIndex, 2)))
		        lnTranCodi    = VAL(lcTranCodiTxt)
		
		        *-- Si eligió el espacio visual, guardar vacío real
				IF lnTranCodi <= 0 OR EMPTY(ALLTRIM(STRTRAN(lcTranNombRaw, lcBlancoVisual, "")))
				    lnTranCodi = 0
				    lcTranNomb = lcBlancoVisual
				ELSE
				    lcTranNomb = ALLTRIM(lcTranNombRaw)
				ENDIF
		
		    ELSE
		        llComboSeleccionado = .F.
		    ENDIF
		
		ENDIF
		
		*---------------------------------------------------------
		* 4) Fallback desde cur_soli_det SOLO si NO hubo selección
		*    explícita en el combo.
		*
		*    Esto evita que al elegir " " vuelva a tomar el
		*    transporte anterior del cursor.
		*---------------------------------------------------------
		IF !llComboSeleccionado
		
		    IF TYPE("cur_soli_det.tran_nomb") <> "U"
		        lcTranNomb = ALLTRIM(NVL(cur_soli_det.tran_nomb, ""))
		    ENDIF
		
		    IF TYPE("cur_soli_det.tran_codi") <> "U"
		        IF VARTYPE(cur_soli_det.tran_codi) = "N"
		            lnTranCodi = INT(NVL(cur_soli_det.tran_codi, 0))
		        ELSE
		            lnTranCodi = VAL(TRANSFORM(cur_soli_det.tran_codi))
		        ENDIF
		    ENDIF
		
		ENDIF
		
		*---------------------------------------------------------
		* 5) Resolver código/nombre contra cur_transportes
		*---------------------------------------------------------
		lcAlias = ALIAS()
		
		IF USED("cur_transportes")
		
		    SELECT cur_transportes
		
		    DO CASE
		
		    CASE llComboSeleccionado AND lnTranCodi <= 0
		        *-- Selección explícita de transporte vacío.
		        LOCATE FOR NVL(tran_codi, 0) = 0
		
		    CASE lnTranCodi > 0
		        LOCATE FOR NVL(tran_codi, 0) = m.lnTranCodi
		
		    CASE !EMPTY(ALLTRIM(lcTranNomb))
		        LOCATE FOR UPPER(ALLTRIM(tran_nomb)) == UPPER(ALLTRIM(m.lcTranNomb))
		
		    OTHERWISE
		        LOCATE FOR NVL(tran_codi, 0) = 0
		
		    ENDCASE
		
		    IF FOUND()
		        IF VARTYPE(cur_transportes.tran_codi) = "N"
		            lnTranCodi = INT(NVL(cur_transportes.tran_codi, 0))
		        ELSE
		            lnTranCodi = VAL(TRANSFORM(cur_transportes.tran_codi))
		        ENDIF
		
		        IF lnTranCodi <= 0
		            lcTranNomb = ""
		        ELSE
		            lcTranNomb = ALLTRIM(NVL(cur_transportes.tran_nomb, ""))
		        ENDIF
		    ELSE
		        lnTranCodi = 0
		        lcTranNomb = ""
		    ENDIF
		
		ENDIF
		
		IF !EMPTY(lcAlias) AND USED(lcAlias)
		    SELECT (lcAlias)
		ENDIF
		
		lnTranCodi = INT(NVL(lnTranCodi, 0))
		
		IF lnTranCodi <= 0
		    lcTranNomb = ""
		ENDIF
		
		*---------------------------------------------------------
		* 6) Sincronizar cursor local visual
		*---------------------------------------------------------
		lnTranCodi = INT(NVL(lnTranCodi, 0))
		
		IF lnTranCodi <= 0
		    *-- Vacío / sin asignar.
		    *-- Visualmente dejamos CHR(160) para que el combo/grid lo sostenga.
		    lnTranCodi = 0
		    lcTranNomb = lcBlancoVisual
		ELSE
		    lcTranNomb = ALLTRIM(lcTranNomb)
		ENDIF
		
		SELECT cur_soli_det
		
		IF !EOF("cur_soli_det")
		    REPLACE tran_codi WITH m.lnTranCodi, ;
		            tran_nomb WITH m.lcTranNomb ;
		        IN cur_soli_det
		ENDIF
		
		*---------------------------------------------------------
		* 7) Guardar en MySQL
		*---------------------------------------------------------
		lnConn = Conectar_DB(_screen.cn)
		
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL para guardar el transporte.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF lnTranCodi > 0
		
		    TEXT TO lcSQL NOSHOW PRETEXT 15
		UPDATE solicitud_compra_art
		SET tran_codi = ?lnTranCodi
		WHERE soli_codi = ?lnSoliCodi
		  AND art_codi  = ?lnArtCodi
		    ENDTEXT
		
		ELSE
		
		    TEXT TO lcSQL NOSHOW PRETEXT 15
		UPDATE solicitud_compra_art
		SET tran_codi = NULL
		WHERE soli_codi = ?lnSoliCodi
		  AND art_codi  = ?lnArtCodi
		    ENDTEXT
		
		ENDIF
		
		lnRet = SQLEXEC(lnConn, lcSQL)
		Desconectar_DB(lnConn)
		lnConn = 0
		
		IF lnRet < 0
		
		    lcErrMsg = "No se pudo guardar el transporte del artículo."
		
		    IF AERROR(laErr) > 0
		        IF TYPE("laErr[1,3]") <> "U"
		            lcErrMsg = lcErrMsg + CHR(13) + TRANSFORM(laErr[1,3])
		        ENDIF
		    ENDIF
		
		    MESSAGEBOX(lcErrMsg, 16, "Error SQL")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 8) Refrescar sin reconstruir grid2
		*---------------------------------------------------------
		IF VARTYPE(loGrid) = "O"
		    loGrid.Refresh()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE refreshventacompragrid
		*=========================================================
		* FormSet.RefreshVentaCompraGrid
		* - Actualiza cur_vc_months
		* - Calcula totales
		* - Refresca el grid SIN rebindear RecordSource
		*=========================================================
		LOCAL loFrm, loConsulta
		LOCAL lnTotalVentas, lnTotalCompras, lnRec
		LOCAL llOk, lcSafety
		
		loFrm      = THISFORMSET.principal
		loConsulta = THISFORMSET.secundario
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") <= 0 OR EOF("cur_alerts")
		
		    IF PEMSTATUS(loFrm, "Text1", 5)
		        loFrm.Text1.Value = 0
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "Text2", 5)
		        loFrm.Text2.Value = 0
		    ENDIF
		
		    IF USED("cur_vc_months")
		        lcSafety = SET("SAFETY")
		        SET SAFETY OFF
		        SELECT cur_vc_months
		        ZAP
		        IF UPPER(ALLTRIM(lcSafety)) == "ON"
		            SET SAFETY ON
		        ELSE
		            SET SAFETY OFF
		        ENDIF
		    ELSE
		        CREATE CURSOR cur_vc_months ( ;
		            mes      C(7), ;
		            compras  N(15,3), ;
		            ventas   N(15,3) )
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xCurRecVC", 5)
		        loFrm.xCurRecVC = 0
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "grd_venta_compra", 5)
		        loFrm.grd_venta_compra.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "shpSelVC", 5)
		        loFrm.shpSelVC.Visible = .F.
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 1) Actualizar cursor mensual
		*---------------------------------------------------------
		llOk = AU_ActualizarCursorVC("cur_alerts", "cur_vc_months")
		
		IF !llOk OR !USED("cur_vc_months")
		    IF PEMSTATUS(loFrm, "Text1", 5)
		        loFrm.Text1.Value = 0
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "Text2", 5)
		        loFrm.Text2.Value = 0
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xCurRecVC", 5)
		        loFrm.xCurRecVC = 0
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "grd_venta_compra", 5)
		        loFrm.grd_venta_compra.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "shpSelVC", 5)
		        loFrm.shpSelVC.Visible = .F.
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 2) Calcular totales
		*---------------------------------------------------------
		lnTotalVentas  = 0
		lnTotalCompras = 0
		
		SELECT cur_vc_months
		IF RECCOUNT("cur_vc_months") > 0
		    lnRec = RECNO()
		
		    CALCULATE SUM(ventas), SUM(compras) TO lnTotalVentas, lnTotalCompras
		
		    IF BETWEEN(lnRec, 1, RECCOUNT("cur_vc_months"))
		        GO lnRec
		    ELSE
		        GO TOP
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xCurRecVC", 5)
		        loFrm.xCurRecVC = RECNO("cur_vc_months")
		    ENDIF
		ELSE
		    IF PEMSTATUS(loFrm, "xCurRecVC", 5)
		        loFrm.xCurRecVC = 0
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 3) Actualizar TextBoxes
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "Text1", 5)
		    loFrm.Text1.Value = lnTotalVentas
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text2", 5)
		    loFrm.Text2.Value = lnTotalCompras
		ENDIF
		
		*---------------------------------------------------------
		* 4) Refresco LIVIANO del grid
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "grd_venta_compra", 5)
		    loFrm.grd_venta_compra.Refresh()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGridVC", 5)
		    THISFORMSET.ActualizarEfectoGridVC(0)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE renumeraritemsalerts
		*=========================================================
		* FormSet.RenumerarItemsAlerts
		* Numeración ui_item SOLO cuando cambia el dataset
		*=========================================================
		LOCAL loFrm, loConsulta
		LOCAL lnItem, lnRec, lnRecs
		
		loFrm      = THISFORMSET.principal
		loConsulta = THISFORMSET.secundario
		
		IF !USED("cur_alerts")
		    RETURN .F.
		ENDIF
		
		SELECT cur_alerts
		lnRecs = RECCOUNT()
		IF lnRecs <= 0
		    RETURN .T.
		ENDIF
		
		lnRec = RECNO()
		
		lnItem = 0
		GO TOP
		SCAN
		    lnItem = lnItem + 1
		    REPLACE ui_item WITH ALLTRIM(STR(lnItem))
		ENDSCAN
		
		IF lnRec > 0 AND lnRec <= RECCOUNT()
		    GO lnRec
		ELSE
		    GO TOP
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE resolverrutafoxypreviewer
		*=========================================================
		* FormSet.ResolverRutaFoxyPreviewer
		* Usa solo RUTA_SISTEMA_1
		* Soporta:
		*   1) \\192.168.0.222\c$\vfp9_mysql
		*   2) 192.168.0.222|c$|vfp9_mysql
		* Limpia espacios/caracteres raros insertados por ODBC
		*=========================================================
		LPARAMETERS tlMostrarDiagnostico
		
		LOCAL lcAppPath, lcRootFoxy, lcRutaFoxy, lcIntentos
		LOCAL lnConnFoxy, lnRetFoxy
		LOCAL laErr[1], lcErrSql
		
		lcAppPath   = ""
		lcRootFoxy  = ""
		lcRutaFoxy  = ""
		lcIntentos  = ""
		lnConnFoxy  = 0
		lnRetFoxy   = 0
		lcErrSql    = ""
		
		IF VARTYPE(tlMostrarDiagnostico) <> "L"
		    tlMostrarDiagnostico = .F.
		ENDIF
		
		*---------------------------------------------------------
		* 1) Buscar local / carpeta actual
		*---------------------------------------------------------
		lcRutaFoxy = FULLPATH("FoxyPreviewer.app")
		lcIntentos = lcIntentos + lcRutaFoxy + CHR(13)
		
		IF FILE(lcRutaFoxy)
		    RETURN lcRutaFoxy
		ENDIF
		
		lcRutaFoxy = "C:\VFP9_MYSQL\FoxyPreviewer.app"
		lcIntentos = lcIntentos + lcRutaFoxy + CHR(13)
		
		IF FILE(lcRutaFoxy)
		    RETURN lcRutaFoxy
		ENDIF
		
		*---------------------------------------------------------
		* 2) Leer RUTA_SISTEMA_1 desde variables_entorno
		*---------------------------------------------------------
		IF USED("cur_foxy_env")
		    USE IN cur_foxy_env
		ENDIF
		
		lnConnFoxy = Conectar_DB(_screen.cn)
		
		IF VARTYPE(lnConnFoxy) <> "N" OR lnConnFoxy <= 0
		    IF tlMostrarDiagnostico
		        MESSAGEBOX("No se pudo conectar a MySQL para leer RUTA_SISTEMA_1.", ;
		                   16, ;
		                   "Diagnóstico FoxyPreviewer")
		    ENDIF
		
		    RETURN ""
		ENDIF
		
		lnRetFoxy = SQLEXEC(lnConnFoxy, ;
		    "SELECT CAST(var_valor AS CHAR(255)) AS ruta " + ;
		    "FROM variables_entorno " + ;
		    "WHERE var_activo = 1 " + ;
		    "  AND var_clave = 'RUTA_SISTEMA_1' " + ;
		    "LIMIT 1", ;
		    "cur_foxy_env")
		
		IF lnRetFoxy < 0
		    AERROR(laErr)
		
		    IF TYPE("laErr[1,3]") <> "U"
		        lcErrSql = TRANSFORM(laErr[1,3])
		    ELSE
		        lcErrSql = "Error SQL no especificado."
		    ENDIF
		ENDIF
		
		Desconectar_DB(lnConnFoxy)
		lnConnFoxy = 0
		
		IF lnRetFoxy <= 0 OR !USED("cur_foxy_env") OR RECCOUNT("cur_foxy_env") <= 0
		    IF tlMostrarDiagnostico
		        MESSAGEBOX("No se pudo leer RUTA_SISTEMA_1." + CHR(13) + ;
		                   lcErrSql, ;
		                   16, ;
		                   "Diagnóstico FoxyPreviewer")
		    ENDIF
		
		    RETURN ""
		ENDIF
		
		SELECT cur_foxy_env
		GO TOP
		
		lcRootFoxy = ""
		
		IF TYPE("cur_foxy_env.ruta") <> "U" AND !ISNULL(cur_foxy_env.ruta)
		    DO CASE
		    CASE VARTYPE(cur_foxy_env.ruta) = "C"
		        lcRootFoxy = ALLTRIM(cur_foxy_env.ruta)
		
		    CASE VARTYPE(cur_foxy_env.ruta) = "M"
		        lcRootFoxy = ALLTRIM(cur_foxy_env.ruta)
		
		    OTHERWISE
		        lcRootFoxy = ALLTRIM(TRANSFORM(cur_foxy_env.ruta))
		    ENDCASE
		ENDIF
		
		IF USED("cur_foxy_env")
		    USE IN cur_foxy_env
		ENDIF
		
		*---------------------------------------------------------
		* 3) Limpiar valor leído desde MySQL/ODBC
		*---------------------------------------------------------
		lcRootFoxy = STRTRAN(lcRootFoxy, CHR(0), "")
		lcRootFoxy = STRTRAN(lcRootFoxy, CHR(9), "")
		lcRootFoxy = STRTRAN(lcRootFoxy, CHR(10), "")
		lcRootFoxy = STRTRAN(lcRootFoxy, CHR(13), "")
		
		*-- Si ODBC devuelve los caracteres separados por espacios:
		*-- \ \ 1 9 2 . 1 6 8 ...
		lcRootFoxy = STRTRAN(lcRootFoxy, " ", "")
		
		*-- Normalizar separadores
		lcRootFoxy = STRTRAN(lcRootFoxy, "/", "\")
		
		*-- Si se guardó en formato neutral:
		*-- 192.168.0.222|c$|vfp9_mysql
		IF AT("|", lcRootFoxy) > 0
		    lcRootFoxy = "\\" + STRTRAN(lcRootFoxy, "|", "\")
		ENDIF
		
		*!*	IF tlMostrarDiagnostico
		*!*	    MESSAGEBOX("Ruta leída desde MySQL:" + CHR(13) + ;
		*!*	               "[" + lcRootFoxy + "]" + CHR(13) + ;
		*!*	               "Largo VFP: " + TRANSFORM(LEN(lcRootFoxy)), ;
		*!*	               64, ;
		*!*	               "Debug RUTA_SISTEMA_1")
		*!*	ENDIF
		
		*---------------------------------------------------------
		* 4) Probar FoxyPreviewer.app
		*---------------------------------------------------------
		IF EMPTY(lcRootFoxy) OR lcRootFoxy == "\"
		    lcIntentos = lcIntentos + "RUTA_SISTEMA_1 vacía o inválida." + CHR(13)
		ELSE
		    IF RIGHT(lcRootFoxy, 1) <> "\"
		        lcRootFoxy = lcRootFoxy + "\"
		    ENDIF
		
		    lcRutaFoxy = lcRootFoxy + "FoxyPreviewer.app"
		    lcIntentos = lcIntentos + lcRutaFoxy + CHR(13)
		
		    IF FILE(lcRutaFoxy)
		        lcAppPath = lcRutaFoxy
		    ENDIF
		ENDIF
		
		IF EMPTY(lcAppPath) AND tlMostrarDiagnostico
		    MESSAGEBOX("No se encontró FoxyPreviewer.app." + CHR(13) + CHR(13) + ;
		               "Rutas probadas:" + CHR(13) + lcIntentos, ;
		               16, ;
		               "Diagnóstico FoxyPreviewer")
		ENDIF
		
		RETURN lcAppPath
		
	ENDPROC

	PROCEDURE restaurarfocogridalerts
		*=========================================================
		* FormSet.RestaurarFocoGridAlerts
		*=========================================================
		LPARAMETERS lnArtCodi, lnRecFallback
		LOCAL loFrm
		
		loFrm = .NULL.
		IF TYPE("THISFORMSET.principal.Name") <> "U"
		    loFrm = THISFORMSET.principal
		ENDIF
		
		IF USED("cur_alerts")
		    SELECT cur_alerts
		    LOCATE FOR art_codi = lnArtCodi
		    IF !FOUND() AND BETWEEN(m.lnRecFallback, 1, RECCOUNT("cur_alerts"))
		        GO m.lnRecFallback
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		    THISFORMSET.ActualizarEfectoGrid()
		ENDIF
		
		IF VARTYPE(loFrm) = "O" AND PEMSTATUS(loFrm, "grd_alerts", 5)
		    loFrm.grd_alerts.Refresh()
		    loFrm.grd_alerts.SetFocus()
		ENDIF
	ENDPROC

	PROCEDURE restaurarposiciongridalerts
		*=========================================================
		* FormSet.RestaurarPosicionGridAlerts
		*=========================================================
		LPARAMETERS tnArtCodi, tnRecOld
		LOCAL loFrm, loConsulta
		LOCAL lnRecs
		
		loFrm      = THISFORMSET.principal
		loConsulta = THISFORMSET.secundario
		
		IF !USED("cur_alerts")
		    RETURN .F.
		ENDIF
		
		SELECT cur_alerts
		lnRecs = RECCOUNT()
		IF lnRecs <= 0
		    RETURN .F.
		ENDIF
		
		IF VARTYPE(tnArtCodi)="N" AND tnArtCodi>0
		    LOCATE FOR art_codi = tnArtCodi
		    IF FOUND()
		        loFrm.xCurRec = RECNO("cur_alerts")
		        loFrm.xCurArt = art_codi
		        RETURN .T.
		    ENDIF
		ENDIF
		
		IF VARTYPE(tnRecOld)="N" AND BETWEEN(tnRecOld,1,lnRecs)
		    GO tnRecOld
		ELSE
		    GO TOP
		ENDIF
		
		loFrm.xCurRec = RECNO("cur_alerts")
		loFrm.xCurArt = IIF(TYPE("cur_alerts.art_codi")="N", art_codi, 0)
		
		RETURN .T.
	ENDPROC

	PROCEDURE runpipeline
		*=========================================================
		* FormSet.RunPipeline
		*=========================================================
		LOCAL llOk, loFrm, loConsulta, loEx
		LOCAL lcPaso
		LOCAL lcSafety
		LOCAL lnConnChk, lnRetChk, ldUltCalc, lnSegundos, llNecesitaSP
		LOCAL lnConnIni, lnRetIni, lcSqlIni
		
		llOk   = .F.
		lcPaso = "inicio"
		
		IF TYPE("THISFORMSET") # "O"
		    MESSAGEBOX("THISFORMSET no está disponible.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "principal", 5)
		    MESSAGEBOX("No existe principal en el formset.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		TRY
		    *-----------------------------------------------------
		    * 1) Sincronizar parámetros iniciales
		    *-----------------------------------------------------
		    lcPaso = "1.1 AddProperty xMesesCobertura"
		    IF !PEMSTATUS(loFrm, "xMesesCobertura", 5)
		        loFrm.AddProperty("xMesesCobertura", 3)
		    ENDIF
		
		    lcPaso = "1.2 AddProperty xMesesMuestra"
		    IF !PEMSTATUS(loFrm, "xMesesMuestra", 5)
		        loFrm.AddProperty("xMesesMuestra", 3)
		    ENDIF
		
		    lcPaso = "1.3 AddProperty xFiltroActual"
		    IF !PEMSTATUS(loFrm, "xFiltroActual", 5)
		        loFrm.AddProperty("xFiltroActual", "PEDIDOS")
		    ENDIF
		
		    lcPaso = "1.4 AddProperty xRubCodiActual"
		    IF !PEMSTATUS(loFrm, "xRubCodiActual", 5)
		        loFrm.AddProperty("xRubCodiActual", 0)
		    ENDIF
		
		    lcPaso = "1.5 AddProperty xCurRec"
		    IF !PEMSTATUS(loFrm, "xCurRec", 5)
		        loFrm.AddProperty("xCurRec", 0)
		    ENDIF
		
		    lcPaso = "1.6 AddProperty xCurArt"
		    IF !PEMSTATUS(loFrm, "xCurArt", 5)
		        loFrm.AddProperty("xCurArt", 0)
		    ENDIF
		
		    lcPaso = "1.7 Leer combo3"
		    IF PEMSTATUS(loFrm, "combo3", 5)
		        loFrm.xMesesCobertura = VAL(TRANSFORM(loFrm.combo3.Value))
		    ENDIF
		
		    lcPaso = "1.8 Leer combo4"
		    IF PEMSTATUS(loFrm, "combo4", 5)
		        loFrm.xMesesMuestra = VAL(TRANSFORM(loFrm.combo4.Value))
		    ENDIF
		
		    lcPaso = "1.9 Normalizar meses"
		    loFrm.xMesesCobertura = MIN(12, MAX(1, NVL(loFrm.xMesesCobertura, 3)))
		    loFrm.xMesesMuestra   = MIN(12, MAX(3, NVL(loFrm.xMesesMuestra, 3)))
		
		    *-----------------------------------------------------
		    * 1.10) Limpiar cursores visuales
		    *-----------------------------------------------------
		    lcSafety = SET("SAFETY")
		    SET SAFETY OFF
		
		    IF USED("cur_alerts")
		        SELECT cur_alerts
		        ZAP
		    ENDIF
		
		    IF USED("cur_provs_col10")
		        SELECT cur_provs_col10
		        ZAP
		    ENDIF
		
		    IF USED("cur_vc_months")
		        SELECT cur_vc_months
		        ZAP
		    ENDIF
		
		    IF UPPER(ALLTRIM(lcSafety)) == "ON"
		        SET SAFETY ON
		    ELSE
		        SET SAFETY OFF
		    ENDIF
		
		*!*	    *-----------------------------------------------------
		*!*	    * 2) Verificar si art_metricas necesita recalcularse
		*!*	    *-----------------------------------------------------
		*!*	    lcPaso = "2.0 Verificar antigüedad de métricas"
		*!*	    ldUltCalc    = DATETIME() - 99999
		*!*	    llNecesitaSP = .T.
		
		*!*	    lnConnChk = Conectar_DB(_screen.cn)
		*!*	    IF VARTYPE(lnConnChk) = "N" AND lnConnChk > 0
		*!*	        lnRetChk = SQLEXEC(lnConnChk, ;
		*!*	            "SELECT MAX(ult_actualizacion) AS ult_calc FROM art_metricas", ;
		*!*	            "cur_chk_calc")
		
		*!*	        IF lnRetChk > 0 AND USED("cur_chk_calc")
		*!*	            SELECT cur_chk_calc
		*!*	            GO TOP
		*!*	            IF !EOF() AND !ISNULL(cur_chk_calc.ult_calc) AND VARTYPE(cur_chk_calc.ult_calc) = "T"
		*!*	                ldUltCalc = cur_chk_calc.ult_calc
		*!*	            ENDIF
		*!*	            USE IN cur_chk_calc
		*!*	        ENDIF
		
		*!*	        Desconectar_DB(lnConnChk)
		*!*	    ENDIF
		
		*!*	    lnSegundos   = DATETIME() - ldUltCalc
		*!*	    llNecesitaSP = (lnSegundos > 1800)   && más de 30 minutos
		
		
		
			*-----------------------------------------------------
			* 2) Forzar recálculo SIEMPRE al iniciar
			*-----------------------------------------------------
			lcPaso = "2.0 Forzar recálculo de métricas al iniciar"
			llNecesitaSP = .T.
			
			
		    *-----------------------------------------------------
		    * FASE 1: Cargar datos actuales de art_metricas SIN recalcular
		    * El form aparece rápido con datos del último cálculo
		    *-----------------------------------------------------
		    lcPaso = "F1.1 CargarAlertasStockFull (datos actuales)"
		    llOk = THISFORMSET.CargarAlertasStockFull()
		
		    IF llOk
		        lcPaso = "F1.2 combo1"
		        IF PEMSTATUS(loFrm, "combo1", 5)
		            loFrm.combo1.DisplayValue = "PEDIDOS"
		        ENDIF
		
		        loFrm.xFiltroActual  = "PEDIDOS"
		        loFrm.xRubCodiActual = 0
		
		        lcPaso = "F1.3 AplicarFiltroLocal"
		        llOk = THISFORMSET.AplicarFiltroLocal("PEDIDOS", 0)
		
		        IF llOk
		            IF PEMSTATUS(THISFORMSET, "RenumerarItemsAlerts", 5)
		                THISFORMSET.RenumerarItemsAlerts()
		            ENDIF
		
		            IF USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0
		                SELECT cur_alerts
		                GO TOP
		                loFrm.xCurRec = RECNO("cur_alerts")
		                loFrm.xCurArt = IIF(TYPE("cur_alerts.art_codi") = "N", cur_alerts.art_codi, 0)
		            ELSE
		                loFrm.xCurRec = 0
		                loFrm.xCurArt = 0
		            ENDIF
		        ENDIF
		
		        *-- Configurar y mostrar UI con datos actuales
		        IF !PEMSTATUS(loFrm, "xGrdProvConfigurado", 5)
		            loFrm.AddProperty("xGrdProvConfigurado", .F.)
		        ENDIF
		
		        IF !loFrm.xGrdProvConfigurado
		            IF PEMSTATUS(THISFORMSET, "ConfigurarGrdProv", 5)
		                THISFORMSET.ConfigurarGrdProv()
		                loFrm.xGrdProvConfigurado = .T.
		            ENDIF
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		            THISFORMSET.RefrescarGrid()
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		            THISFORMSET.ActualizarEfectoGrid(0)
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "RefreshVentaCompraGrid", 5)
		            THISFORMSET.RefreshVentaCompraGrid()
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "SincronizarPedido", 5)
		            THISFORMSET.SincronizarPedido()
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		            THISFORMSET.SincronizarBotonMasivo()
		        ENDIF
		
		        IF PEMSTATUS(loFrm, "grd_alerts", 5)
		            loFrm.grd_alerts.Visible = .T.
		        ENDIF
		        IF PEMSTATUS(loFrm, "grd_prov", 5)
		            loFrm.grd_prov.Visible = .T.
		        ENDIF
		        IF PEMSTATUS(loFrm, "grd_venta_compra", 5)
		            loFrm.grd_venta_compra.Visible = .T.
		        ENDIF
		
		        loFrm.LockScreen = .F.
		        loFrm.Refresh()
		        DOEVENTS
		    ENDIF
		
			*-----------------------------------------------------
			* FASE 2: Recalcular SIEMPRE al iniciar
			*-----------------------------------------------------
			IF llNecesitaSP
			    lcPaso = "F2.1 usp_recalcular_art_metricas"
			    WAIT WINDOW "Actualizando métricas..." NOWAIT
			    lnConnIni = Conectar_DB(_screen.cn)
			    IF VARTYPE(lnConnIni) = "N" AND lnConnIni > 0
			        TEXT TO lcSqlIni NOSHOW PRETEXT 15
			            CALL usp_recalcular_art_metricas(?loFrm.xMesesMuestra, ?loFrm.xMesesCobertura)
			        ENDTEXT
		
			        lnRetIni = SQLEXEC(lnConnIni, lcSqlIni)
			        Desconectar_DB(lnConnIni)
		
			        IF lnRetIni >= 0
			            *-- Recargar con datos frescos (silencioso)
			            lcPaso = "F2.2 Recargar con métricas frescas"
			            loFrm.LockScreen = .T.
		
			            IF PEMSTATUS(THISFORMSET, "CargarAlertasStockFull", 5)
			                THISFORMSET.CargarAlertasStockFull()
			            ENDIF
		
			            IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
			                THISFORMSET.AplicarFiltroLocal(loFrm.xFiltroActual, loFrm.xRubCodiActual)
			            ENDIF
		
			            IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
			                THISFORMSET.RefrescarGrid()
			            ENDIF
		
			            IF PEMSTATUS(THISFORMSET, "RefreshVentaCompraGrid", 5)
			                THISFORMSET.RefreshVentaCompraGrid()
			            ENDIF
		
			            IF PEMSTATUS(THISFORMSET, "SincronizarPedido", 5)
			                THISFORMSET.SincronizarPedido()
			            ENDIF
		
			            loFrm.LockScreen = .F.
			            loFrm.Refresh()
			        ENDIF
			    ENDIF
		
			    WAIT CLEAR
			ENDIF
		    llOk = .T.
		
		CATCH TO loEx
		    WAIT CLEAR
		    MESSAGEBOX( ;
		        "Paso: " + lcPaso + CHR(13) + CHR(13) + ;
		        "Error en RunPipeline: " + TRANSFORM(loEx.Message), ;
		        16, "principal")
		    llOk = .F.
		ENDTRY
		
		RETURN llOk
	ENDPROC

	PROCEDURE setarticuloseleccionado
		*=========================================================
		* FormSet.SetArticuloSeleccionado
		* Guarda/Quita selección persistente por art_codi
		* - Preserva el alias activo
		*=========================================================
		LPARAMETERS tnArtCodi, tlSel
		
		LOCAL lnAreaOld
		
		IF VARTYPE(tnArtCodi) # "N" OR tnArtCodi <= 0
		    RETURN .F.
		ENDIF
		
		lnAreaOld = SELECT()
		
		IF !USED("cur_sel_articulos")
		    CREATE CURSOR cur_sel_articulos (art_codi I)
		    INDEX ON art_codi TAG art_codi
		ENDIF
		
		SELECT cur_sel_articulos
		SET ORDER TO TAG art_codi
		
		IF tlSel
		    IF !SEEK(tnArtCodi, "cur_sel_articulos", "art_codi")
		        INSERT INTO cur_sel_articulos (art_codi) VALUES (tnArtCodi)
		    ENDIF
		ELSE
		    IF SEEK(tnArtCodi, "cur_sel_articulos", "art_codi")
		        DELETE IN cur_sel_articulos
		    ENDIF
		ENDIF
		
		IF lnAreaOld > 0
		    SELECT (lnAreaOld)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE sincronizararticuloactualui
		*=========================================================
		* FormSet.SincronizarArticuloActualUI
		* Fuerza sincronización completa del artículo actual
		* - mueve el puntero físico de cur_alerts
		* - sincroniza xCurRec / xCurArt
		* - ejecuta el mismo pipeline que grd_alerts.AfterRowColChange
		*=========================================================
		LPARAMETERS tnRecDeseado, tnArtDeseado
		
		LOCAL loFrm
		LOCAL lnRecObj, lnArtObj
		LOCAL llPosicionado
		
		loFrm = THISFORMSET.principal
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0
		    RETURN .F.
		ENDIF
		
		SELECT cur_alerts
		
		lnRecObj = IIF(VARTYPE(tnRecDeseado) = "N", tnRecDeseado, 0)
		lnArtObj = IIF(VARTYPE(tnArtDeseado) = "N", tnArtDeseado, 0)
		llPosicionado = .F.
		
		*---------------------------------------------------------
		* 1) Posicionar físicamente el cursor
		*---------------------------------------------------------
		IF BETWEEN(lnRecObj, 1, RECCOUNT("cur_alerts"))
		    GO lnRecObj
		    llPosicionado = .T.
		ELSE
		    IF lnArtObj > 0
		        LOCATE FOR art_codi = lnArtObj
		        llPosicionado = FOUND()
		    ENDIF
		
		    IF !llPosicionado
		        GO TOP
		        llPosicionado = !EOF("cur_alerts")
		    ENDIF
		ENDIF
		
		IF !llPosicionado OR EOF("cur_alerts") OR BOF("cur_alerts")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 2) Sincronizar estado lógico
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "xCurRec", 5)
		    loFrm.xCurRec = RECNO("cur_alerts")
		ENDIF
		
		IF PEMSTATUS(loFrm, "xCurArt", 5)
		    loFrm.xCurArt = IIF(TYPE("cur_alerts.art_codi") = "N", cur_alerts.art_codi, 0)
		ENDIF
		
		*---------------------------------------------------------
		* 3) Pipeline equivalente a AfterRowColChange
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		    THISFORMSET.ActualizarEfectoGrid(0)
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarDependenciasArticuloActual", 5)
		    THISFORMSET.ActualizarDependenciasArticuloActual()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "RefreshVentaCompraGrid", 5)
		    THISFORMSET.RefreshVentaCompraGrid()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "BindMetricTexts", 5)
		    THISFORMSET.BindMetricTexts()
		ENDIF
		
		*---------------------------------------------------------
		* 4) Refrescar textbox de métricas
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "Text4", 5)
		    loFrm.Text4.Refresh()
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text11", 5)
		    loFrm.Text11.Refresh()
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text12", 5)
		    loFrm.Text12.Refresh()
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text13", 5)
		    loFrm.Text13.Refresh()
		ENDIF
		
		IF PEMSTATUS(loFrm, "grd_alerts", 5)
		    loFrm.grd_alerts.Refresh()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE sincronizarbotonmasivo
		*=========================================================
		* FormSet.SincronizarBotonMasivo
		*=========================================================
		LOCAL loFrm, loConsulta
		LOCAL lnTotal, lnMarcados
		
		loFrm      = THISFORMSET.principal
		loConsulta = THISFORMSET.secundario
		
		IF !PEMSTATUS(loFrm, "btn_marcar_todos", 5)
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0
		    loFrm.btn_marcar_todos.Caption = "MARCAR TODOS"
		    RETURN .T.
		ENDIF
		
		SELECT cur_alerts
		lnTotal = RECCOUNT()
		COUNT FOR ui_sel = .T. TO lnMarcados
		
		IF lnTotal > 0 AND lnMarcados == lnTotal
		    loFrm.btn_marcar_todos.Caption = "DESMARCAR TODOS"
		ELSE
		    loFrm.btn_marcar_todos.Caption = "MARCAR TODOS"
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE sincronizarcantidadgrid2
		*=========================================================
		* FormSet.SincronizarCantidadGrid2
		* Version directa sin TABLEUPDATE
		*=========================================================
		LOCAL loFrm, loGrid
		LOCAL lnCant, lcValor
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN .F.
		ENDIF
		
		loFrm = THISFORMSET.secundario
		
		IF VARTYPE(loFrm) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loFrm, "grid2", 5)
		    RETURN .F.
		ENDIF
		
		loGrid = loFrm.grid2
		
		IF VARTYPE(loGrid) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_soli_det")
		    RETURN .F.
		ENDIF
		
		IF RECCOUNT("cur_soli_det") <= 0 OR EOF("cur_soli_det")
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loGrid, "Column6", 5)
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loGrid.Column6, "Text1", 5)
		    RETURN .F.
		ENDIF
		
		*-- Forzar validación/salida lógica de edición
		loGrid.Column6.Text1.Value = loGrid.Column6.Text1.Value
		
		lcValor = ALLTRIM(TRANSFORM(loGrid.Column6.Text1.Value))
		
		*-- Normalizar número estilo argentino
		IF "," $ lcValor
		    lcValor = STRTRAN(lcValor, ".", "")
		    lcValor = STRTRAN(lcValor, ",", ".")
		ENDIF
		
		lnCant = VAL(lcValor)
		
		IF lnCant > 0
		    REPLACE cant_soli WITH lnCant IN cur_soli_det
		ENDIF
		
		loGrid.Refresh()
		
		RETURN .T.
	ENDPROC

	PROCEDURE sincronizarcombotransporte
		*=========================================================
		* FormSet.SincronizarComboTransporte
		* Posiciona el ListIndex del cboTransporte al tran_codi
		* del registro actual de cur_soli_det.
		*=========================================================
		LOCAL loGrid, loCombo
		LOCAL lnTranCodi, lnI
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN
		ENDIF
		
		loGrid = THISFORMSET.secundario.grid2
		
		IF VARTYPE(loGrid) <> "O" OR loGrid.ColumnCount < 8
		    RETURN
		ENDIF
		
		IF !PEMSTATUS(loGrid.Columns(8), "cboTransporte", 5)
		    RETURN
		ENDIF
		
		loCombo = loGrid.Columns(8).cboTransporte
		
		IF VARTYPE(loCombo) <> "O"
		    RETURN
		ENDIF
		
		*!*	IF !USED("cur_soli_det") OR EOF("cur_soli_det")
		*!*	    RETURN
		*!*	ENDIF
		
		
		IF !USED("cur_soli_det") OR RECCOUNT("cur_soli_det") <= 0
		    RETURN
		ENDIF
		IF EOF("cur_soli_det")
		    SELECT cur_soli_det
		    GO BOTTOM
		ENDIF
		
		
		
		
		*-- Leer tran_codi del registro actual
		lnTranCodi = 0
		IF TYPE("cur_soli_det.tran_codi") = "N"
		    lnTranCodi = INT(NVL(cur_soli_det.tran_codi, 0))
		ENDIF
		
		*-- Buscar en columna 2 del combo (la oculta con el código)
		loCombo.ListIndex = 0
		
		FOR lnI = 1 TO loCombo.ListCount
		    IF VAL(ALLTRIM(loCombo.List(lnI, 2))) = lnTranCodi
		        loCombo.ListIndex = lnI
		        EXIT
		    ENDIF
		NEXT lnI
		
		*-- Si no encontró nada (tran_codi=0 o no existe), forzar fila vacía (la primera)
		IF loCombo.ListIndex = 0 AND loCombo.ListCount > 0
		    loCombo.ListIndex = 1
		ENDIF
	ENDPROC

	PROCEDURE sincronizarpedido
		*=========================================================
		* FormSet.SincronizarPedido
		* Reconstruye cur_alerts_ped desde cur_alerts.ui_sel = .T.
		* - Alinea antes contra temp_solicitud_compra
		* - Actualizado para proveedor + costo
		* - FIX: evita INSERT...SELECT con prov_codi
		*=========================================================
		LOCAL loFrm, loConsulta
		LOCAL lcSafety, llTieneIndice
		LOCAL lnOldArea
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF !USED("cur_alerts")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 1) Alinear checks visuales contra la fuente de verdad real
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "SincronizarSeleccionDesdeTemp", 5)
		    THISFORMSET.SincronizarSeleccionDesdeTemp()
		ENDIF
		
		llTieneIndice = (TYPE("cur_alerts.indice_rotacion") <> "U")
		lnOldArea     = SELECT()
		
		IF USED("cur_alerts_ped_tmp")
		    USE IN cur_alerts_ped_tmp
		ENDIF
		
		*---------------------------------------------------------
		* 2) Asegurar / limpiar cursor destino
		*---------------------------------------------------------
		IF !USED("cur_alerts_ped")
		    IF llTieneIndice
		        CREATE CURSOR cur_alerts_ped ( ;
		            art_codi        I, ;
		            art_desc        C(80), ;
		            art_stock       N(15,3), ;
		            art_stmin       N(15,3), ;
		            pedidos         N(15,3), ;
		            pedprov         N(15,3), ;
		            sug_neto        N(15,3), ;
		            indice_rotacion N(10,3), ;
		            pct_rotacion    N(10,3), ;
		            prov_codi       I, ;
		            prov_nomb       C(80), ;
		            artpro_costo    N(15,4), ;
		            cant_ped        N(15,3) )
		    ELSE
		        CREATE CURSOR cur_alerts_ped ( ;
		            art_codi     I, ;
		            art_desc     C(80), ;
		            art_stock    N(15,3), ;
		            art_stmin    N(15,3), ;
		            pedidos      N(15,3), ;
		            pedprov      N(15,3), ;
		            sug_neto     N(15,3), ;
		            pct_rotacion N(10,3), ;
		            prov_codi    I, ;
		            prov_nomb    C(80), ;
		            artpro_costo N(15,4), ;
		            cant_ped     N(15,3) )
		    ENDIF
		ELSE
		    lcSafety = SET("SAFETY")
		    SET SAFETY OFF
		    SELECT cur_alerts_ped
		    ZAP
		    IF UPPER(ALLTRIM(lcSafety)) == "ON"
		        SET SAFETY ON
		    ELSE
		        SET SAFETY OFF
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 3) Armar cursor temporal desde los checks ya sincronizados
		*---------------------------------------------------------
		IF llTieneIndice
		    SELECT ;
		        cur_alerts.art_codi AS art_codi, ;
		        cur_alerts.art_desc AS art_desc, ;
		        cur_alerts.art_stock AS art_stock, ;
		        cur_alerts.art_stmin AS art_stmin, ;
		        cur_alerts.pedidos AS pedidos, ;
		        cur_alerts.pedprov AS pedprov, ;
		        cur_alerts.sug_neto AS sug_neto, ;
		        cur_alerts.indice_rotacion AS indice_rotacion, ;
		        cur_alerts.pct_rotacion AS pct_rotacion, ;
		        IIF(TYPE("cur_alerts.prov_codi_sel")="U",0,cur_alerts.prov_codi_sel) AS prov_codi, ;
		        IIF(TYPE("cur_alerts.prov_nomb_sel")="U","",cur_alerts.prov_nomb_sel) AS prov_nomb, ;
		        IIF(TYPE("cur_alerts.artpro_costo")="U",0,cur_alerts.artpro_costo) AS artpro_costo, ;
		        IIF(TYPE("cur_alerts.cant_soli")="U", cur_alerts.sug_neto, ;
		            IIF(NVL(cur_alerts.cant_soli,0)>0, cur_alerts.cant_soli, cur_alerts.sug_neto)) AS cant_ped ;
		    FROM cur_alerts ;
		    WHERE cur_alerts.ui_sel ;
		    INTO CURSOR cur_alerts_ped_tmp READWRITE
		ELSE
		    SELECT ;
		        cur_alerts.art_codi AS art_codi, ;
		        cur_alerts.art_desc AS art_desc, ;
		        cur_alerts.art_stock AS art_stock, ;
		        cur_alerts.art_stmin AS art_stmin, ;
		        cur_alerts.pedidos AS pedidos, ;
		        cur_alerts.pedprov AS pedprov, ;
		        cur_alerts.sug_neto AS sug_neto, ;
		        cur_alerts.pct_rotacion AS pct_rotacion, ;
		        IIF(TYPE("cur_alerts.prov_codi_sel")="U",0,cur_alerts.prov_codi_sel) AS prov_codi, ;
		        IIF(TYPE("cur_alerts.prov_nomb_sel")="U","",cur_alerts.prov_nomb_sel) AS prov_nomb, ;
		        IIF(TYPE("cur_alerts.artpro_costo")="U",0,cur_alerts.artpro_costo) AS artpro_costo, ;
		        IIF(TYPE("cur_alerts.cant_soli")="U", cur_alerts.sug_neto, ;
		            IIF(NVL(cur_alerts.cant_soli,0)>0, cur_alerts.cant_soli, cur_alerts.sug_neto)) AS cant_ped ;
		    FROM cur_alerts ;
		    WHERE cur_alerts.ui_sel ;
		    INTO CURSOR cur_alerts_ped_tmp READWRITE
		ENDIF
		
		*---------------------------------------------------------
		* 4) Volcar al cursor final
		*---------------------------------------------------------
		IF USED("cur_alerts_ped_tmp") AND RECCOUNT("cur_alerts_ped_tmp") > 0
		    SELECT cur_alerts_ped
		    APPEND FROM DBF("cur_alerts_ped_tmp")
		ENDIF
		
		IF USED("cur_alerts_ped_tmp")
		    USE IN cur_alerts_ped_tmp
		ENDIF
		
		*---------------------------------------------------------
		* 5) Actualizar label
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "lbl_ped", 5)
		    IF USED("cur_alerts_ped")
		        loFrm.lbl_ped.Caption = TRANSFORM(RECCOUNT("cur_alerts_ped")) + " en pedido"
		    ELSE
		        loFrm.lbl_ped.Caption = "0 en pedido"
		    ENDIF
		ENDIF
		
		IF lnOldArea > 0
		    SELECT (lnOldArea)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE sincronizarproveedoresseleccionadosentemp
		*=========================================================
		* FormSet.SincronizarProveedoresSeleccionadosEnTemp
		* Refleja en temp_solicitud_compra el proveedor/costo
		* visible en cur_alerts para los artículos seleccionados.
		*
		* Regla:
		* - si prov_codi_sel > 0 => usa ese código
		* - si prov_codi_sel = 0 pero prov_nomb_sel tiene valor =>
		*   intenta resolver el código por nombre en proveedores
		* - sincroniza aunque el costo sea 0
		*=========================================================
		LPARAMETERS tnConn
		
		LOCAL lnConnLocal, llConnExterna
		LOCAL lnArt, lnProvCodi, lnRet
		LOCAL lnArtProCosto
		LOCAL lcProvNomb, lcSQL
		LOCAL lnAreaOld
		LOCAL laErr[1]
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0
		    RETURN .T.
		ENDIF
		
		llConnExterna = (VARTYPE(tnConn) = "N" AND tnConn > 0)
		
		IF llConnExterna
		    lnConnLocal = tnConn
		ELSE
		    lnConnLocal = Conectar_DB(_screen.cn)
		    IF VARTYPE(lnConnLocal) <> "N" OR lnConnLocal <= 0
		        RETURN .F.
		    ENDIF
		ENDIF
		
		IF USED("cur_sync_prov_resolve")
		    USE IN cur_sync_prov_resolve
		ENDIF
		
		lnAreaOld = SELECT()
		
		SELECT cur_alerts
		GO TOP
		SCAN FOR TYPE("cur_alerts.ui_sel") = "L" AND cur_alerts.ui_sel
		
		    lnArt         = IIF(TYPE("cur_alerts.art_codi")="N", cur_alerts.art_codi, 0)
		    lnProvCodi    = IIF(TYPE("cur_alerts.prov_codi_sel")="N", cur_alerts.prov_codi_sel, 0)
		    lnArtProCosto = IIF(TYPE("cur_alerts.artpro_costo")="N", cur_alerts.artpro_costo, 0)
		    lcProvNomb    = IIF(TYPE("cur_alerts.prov_nomb_sel")="C", ALLTRIM(cur_alerts.prov_nomb_sel), "")
		
		    IF lnArt <= 0
		        LOOP
		    ENDIF
		
		    *-----------------------------------------------------
		    * Si no hay código pero sí nombre, resolver por nombre
		    *-----------------------------------------------------
		    IF lnProvCodi <= 0 AND !EMPTY(lcProvNomb)
		
		        IF USED("cur_sync_prov_resolve")
		            USE IN cur_sync_prov_resolve
		        ENDIF
		
		        TEXT TO lcSQL NOSHOW PRETEXT 15
		            SELECT prov_codi
		            FROM proveedores
		            WHERE UPPER(TRIM(prov_nomb)) = UPPER(TRIM(?lcProvNomb))
		            ORDER BY prov_codi
		        ENDTEXT
		
		        lnRet = SQLEXEC(lnConnLocal, lcSQL, "cur_sync_prov_resolve")
		        IF lnRet < 0
		            IF lnAreaOld > 0
		                SELECT (lnAreaOld)
		            ENDIF
		
		            IF USED("cur_sync_prov_resolve")
		                USE IN cur_sync_prov_resolve
		            ENDIF
		
		            IF !llConnExterna
		                Desconectar_DB(lnConnLocal)
		            ENDIF
		
		            RETURN .F.
		        ENDIF
		
		        IF USED("cur_sync_prov_resolve") AND RECCOUNT("cur_sync_prov_resolve") > 0
		            SELECT cur_sync_prov_resolve
		            GO TOP
		            lnProvCodi = IIF(TYPE("cur_sync_prov_resolve.prov_codi")="N", cur_sync_prov_resolve.prov_codi, VAL(TRANSFORM(cur_sync_prov_resolve.prov_codi)))
		        ENDIF
		
		        IF USED("cur_sync_prov_resolve")
		            USE IN cur_sync_prov_resolve
		        ENDIF
		    ENDIF
		
		    *-----------------------------------------------------
		    * Actualizar temp si logró obtener proveedor válido
		    *-----------------------------------------------------
		    IF lnProvCodi > 0
		        TEXT TO lcSQL NOSHOW PRETEXT 15
		            UPDATE temp_solicitud_compra
		            SET prov_codi = ?lnProvCodi,
		                artpro_costo = ?lnArtProCosto,
		                fecha_agregado = NOW()
		            WHERE art_codi = ?lnArt
		        ENDTEXT
		
		        lnRet = SQLEXEC(lnConnLocal, lcSQL)
		        IF lnRet < 0
		            IF lnAreaOld > 0
		                SELECT (lnAreaOld)
		            ENDIF
		
		            IF !llConnExterna
		                Desconectar_DB(lnConnLocal)
		            ENDIF
		
		            RETURN .F.
		        ENDIF
		    ENDIF
		
		ENDSCAN
		
		IF lnAreaOld > 0
		    SELECT (lnAreaOld)
		ENDIF
		
		IF USED("cur_sync_prov_resolve")
		    USE IN cur_sync_prov_resolve
		ENDIF
		
		IF !llConnExterna
		    Desconectar_DB(lnConnLocal)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE sincronizarselecciondesdetemp
		*=========================================================
		* FormSet.SincronizarSeleccionDesdeTemp
		* Sincroniza cur_alerts contra temp_solicitud_compra
		* Fuente de verdad:
		*   - temp_solicitud_compra
		* Reflejo visual:
		*   - cur_alerts.ui_sel
		*   - cur_alerts.cant_soli
		* Auxiliar local:
		*   - cur_sel_articulos
		*=========================================================
		LOCAL lnConn, lnRet, lcSQL
		LOCAL lnAreaOld
		LOCAL lcSafety
		LOCAL lnCantSoli_, lnProvCodi_, lnArtProCosto_
		
		IF !USED("cur_alerts")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 1) Asegurar cursor auxiliar local
		*---------------------------------------------------------
		IF !USED("cur_sel_articulos")
		    CREATE CURSOR cur_sel_articulos (art_codi I)
		    INDEX ON art_codi TAG art_codi
		ELSE
		    SELECT cur_sel_articulos
		    SET ORDER TO TAG art_codi
		ENDIF
		
		*---------------------------------------------------------
		* 2) Traer selección real desde MySQL
		*---------------------------------------------------------
		IF USED("cur_temp_sel_sync")
		    USE IN cur_temp_sel_sync
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    RETURN .F.
		ENDIF
		
		TEXT TO lcSQL NOSHOW
		SELECT
		    art_codi,
		    IFNULL(cant_soli,0)    AS cant_soli,
		    IFNULL(prov_codi,0)    AS prov_codi,
		    IFNULL(artpro_costo,0) AS artpro_costo
		FROM temp_solicitud_compra
		ENDTEXT
		
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_temp_sel_sync")
		Desconectar_DB(lnConn)
		
		IF lnRet < 0 OR !USED("cur_temp_sel_sync")
		    IF USED("cur_temp_sel_sync")
		        USE IN cur_temp_sel_sync
		    ENDIF
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 3) Indexar temporal real (solo porque recién se creó)
		*---------------------------------------------------------
		SELECT cur_temp_sel_sync
		INDEX ON art_codi TAG art_codi
		
		*---------------------------------------------------------
		* 4) Limpiar y reconstruir cur_sel_articulos
		*---------------------------------------------------------
		lcSafety = SET("SAFETY")
		SET SAFETY OFF
		
		SELECT cur_sel_articulos
		ZAP
		
		IF UPPER(ALLTRIM(lcSafety)) == "ON"
		    SET SAFETY ON
		ELSE
		    SET SAFETY OFF
		ENDIF
		
		SELECT cur_temp_sel_sync
		GO TOP
		SCAN
		    INSERT INTO cur_sel_articulos (art_codi) VALUES (VAL(TRANSFORM(cur_temp_sel_sync.art_codi)))
		ENDSCAN
		
		SELECT cur_sel_articulos
		SET ORDER TO TAG art_codi
		
		*---------------------------------------------------------
		* 5) Reflejar en cur_alerts
		*---------------------------------------------------------
		lnAreaOld = SELECT()
		
		SELECT cur_alerts
		GO TOP
		SCAN
		    IF SEEK(cur_alerts.art_codi, "cur_temp_sel_sync", "art_codi")
		
		        *-- Normalizar tipos antes del REPLACE
		        lnCantSoli_    = VAL(STRTRAN(ALLTRIM(TRANSFORM(NVL(cur_temp_sel_sync.cant_soli,0))), ",", "."))
		        lnProvCodi_    = VAL(TRANSFORM(NVL(cur_temp_sel_sync.prov_codi,0)))
				lnArtProCosto_ = IIF(TYPE("cur_temp_sel_sync.artpro_costo") = "N", ROUND(NVL(cur_temp_sel_sync.artpro_costo, 0), 4), 0)
		
		        REPLACE ui_sel WITH .T.
		
		        IF TYPE("cur_alerts.cant_soli") <> "U"
		            REPLACE cant_soli WITH ROUND(lnCantSoli_, 3)
		        ENDIF
		
		        IF TYPE("cur_alerts.prov_codi_sel") <> "U"
		            REPLACE prov_codi_sel WITH lnProvCodi_
		        ENDIF
		
		        IF TYPE("cur_alerts.artpro_costo") <> "U"
		            REPLACE artpro_costo WITH ROUND(lnArtProCosto_, 4)
		        ENDIF
		
		    ELSE
		        REPLACE ui_sel WITH .F.
		
		        IF TYPE("cur_alerts.cant_soli") <> "U"
		            REPLACE cant_soli WITH 0
		        ENDIF
		    ENDIF
		ENDSCAN
		
		IF lnAreaOld > 0
		    SELECT (lnAreaOld)
		ENDIF
		
		IF USED("cur_temp_sel_sync")
		    USE IN cur_temp_sel_sync
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE solicitudestacomprada
		LPARAMETERS tnSoliCodi
		
		LOCAL lcEstado, lnConn, lnRet, lnRecHist
		
		lcEstado  = ""
		lnConn    = 0
		lnRet     = 0
		lnRecHist = 0
		
		IF VARTYPE(tnSoliCodi) <> "N" OR tnSoliCodi <= 0
		    RETURN .F.
		ENDIF
		
		*-- Primero intentar desde cur_soli_hist
		IF USED("cur_soli_hist") AND RECCOUNT("cur_soli_hist") > 0
		    SELECT cur_soli_hist
		
		    IF !EOF("cur_soli_hist") AND !BOF("cur_soli_hist")
		        lnRecHist = RECNO("cur_soli_hist")
		    ENDIF
		
		    LOCATE FOR NVL(soli_codi, 0) = m.tnSoliCodi
		
		    IF FOUND() AND TYPE("cur_soli_hist.estado") <> "U"
		        lcEstado = UPPER(ALLTRIM(TRANSFORM(NVL(cur_soli_hist.estado, ""))))
		    ENDIF
		
		    IF lnRecHist > 0 AND lnRecHist <= RECCOUNT("cur_soli_hist")
		        GO lnRecHist IN cur_soli_hist
		    ENDIF
		ENDIF
		
		*-- Fallback MySQL
		IF EMPTY(lcEstado)
		    IF USED("cur_chk_soli_estado")
		        USE IN cur_chk_soli_estado
		    ENDIF
		
		    lnConn = Conectar_DB(_screen.cn)
		
		    IF VARTYPE(lnConn) = "N" AND lnConn > 0
		        lnRet = SQLEXEC(lnConn, ;
		            "SELECT UPPER(TRIM(IFNULL(estado,''))) AS estado " + ;
		            "FROM solicitud_compra " + ;
		            "WHERE soli_codi = ?tnSoliCodi", ;
		            "cur_chk_soli_estado")
		
		        Desconectar_DB(lnConn)
		
		        IF lnRet > 0 AND USED("cur_chk_soli_estado") AND RECCOUNT("cur_chk_soli_estado") > 0
		            SELECT cur_chk_soli_estado
		            GO TOP
		            lcEstado = UPPER(ALLTRIM(TRANSFORM(NVL(cur_chk_soli_estado.estado, ""))))
		        ENDIF
		    ENDIF
		
		    IF USED("cur_chk_soli_estado")
		        USE IN cur_chk_soli_estado
		    ENDIF
		ENDIF
		
		RETURN (lcEstado == "COMPRADO")
		
	ENDPROC

	PROCEDURE sortalertsbyfield
		*=========================================================
		* FormSet.SortAlertsByField
		* Ordena cur_alerts sin romper UI ni selección
		*=========================================================
		LPARAMETERS tcField, tvForceDesc
		
		LOCAL loFrm, lcField, llDesc
		LOCAL llHasField
		LOCAL lnN, lnFirstArt
		
		IF VARTYPE(tcField) <> "C" OR EMPTY(ALLTRIM(tcField))
		    RETURN .F.
		ENDIF
		
		IF TYPE("THISFORMSET.principal.Name") = "U"
		    RETURN .F.
		ENDIF
		
		loFrm  = THISFORMSET.principal
		lcField = ALLTRIM(tcField)
		
		IF VARTYPE(loFrm) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_alerts")
		    RETURN .F.
		ENDIF
		
		IF RECCOUNT("cur_alerts") = 0
		    RETURN .F.
		ENDIF
		
		*-- No ordenar por columnas visuales
		IF INLIST(LOWER(lcField), "ui_item", "ui_sel")
		    RETURN .F.
		ENDIF
		
		*-- Validar que el campo exista en cur_alerts
		llHasField = (TYPE("cur_alerts." + lcField) <> "U")
		IF !llHasField
		    RETURN .F.
		ENDIF
		
		*-- Inicializar propiedades de sort si no existen
		IF !PEMSTATUS(loFrm, "xSortField", 5)
		    loFrm.AddProperty("xSortField", "")
		ENDIF
		IF !PEMSTATUS(loFrm, "xSortDesc", 5)
		    loFrm.AddProperty("xSortDesc", .F.)
		ENDIF
		IF !PEMSTATUS(loFrm, "xCurArt", 5)
		    loFrm.AddProperty("xCurArt", 0)
		ENDIF
		IF !PEMSTATUS(loFrm, "xCurRec", 5)
		    loFrm.AddProperty("xCurRec", 1)
		ENDIF
		
		*-- Alternar ASC/DESC si repite campo; si cambia campo arranca ASC
		*-- Si viene tvForceDesc explícito (desde checkbox restore), respetar esa dirección
		IF UPPER(ALLTRIM(loFrm.xSortField)) == UPPER(lcField)
		    loFrm.xSortDesc = IIF(PCOUNT() >= 2, tvForceDesc, !loFrm.xSortDesc)
		ELSE
		    loFrm.xSortField = lcField
		    loFrm.xSortDesc  = IIF(PCOUNT() >= 2, tvForceDesc, .F.)
		ENDIF
		
		llDesc = loFrm.xSortDesc
		
		*-- Ordenar cur_alerts con INDEX (sin ZAP, sin mover datos)
		SELECT cur_alerts
		
		LOCAL lcSafety
		lcSafety = SET("SAFETY")
		SET SAFETY OFF
		
		IF llDesc
		    INDEX ON &lcField TAG zsort DESCENDING
		ELSE
		    INDEX ON &lcField TAG zsort
		ENDIF
		
		IF UPPER(lcSafety) == "ON"
		    SET SAFETY ON
		ENDIF
		
		SET ORDER TO TAG zsort
		
		
		GO TOP
		
		*-- Capturar primer artículo en el nuevo orden
		lnFirstArt = 0
		IF !EOF("cur_alerts") AND TYPE("cur_alerts.art_codi") <> "U"
		    lnFirstArt = NVL(cur_alerts.art_codi, 0)
		ENDIF
		
		*-- Renumerar ui_item respetando el orden del índice activo
		IF TYPE("cur_alerts.ui_item") <> "U"
		    lnN = 0
		    GO TOP
		    SCAN
		        lnN = lnN + 1
				REPLACE ui_item WITH TRANSFORM(lnN) IN cur_alerts
		    ENDSCAN
		    GO TOP
		ENDIF
		
		loFrm.xCurRec = 1
		loFrm.xCurArt = lnFirstArt
		
		IF PEMSTATUS(loFrm, "chkOrdenColor", 5)
		    loFrm.chkOrdenColor.Value = .F.
		ENDIF
		IF PEMSTATUS(loFrm, "xOrdenColorDesc", 5)
		    loFrm.xOrdenColorDesc = .F.
		ENDIF
		
		SELECT cur_alerts
		GO TOP
		
		IF PEMSTATUS(loFrm, "grd_alerts", 5)
		    loFrm.grd_alerts.Refresh()
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE updategridheadersortui
		*=========================================================
		* FormSet.UpdateGridHeaderSortUI
		* Flecha en header sin depender de xHeader1..xHeader12
		*=========================================================
		
		LOCAL loFrm, loGrid, lcField, llDesc, lnCol
		LOCAL lcBaseCaption, lcTag, lcMapField
		
		IF TYPE("THISFORMSET.principal.Name") = "U"
		    RETURN .F.
		ENDIF
		
		loFrm = THISFORMSET.principal
		IF VARTYPE(loFrm) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loFrm, "grd_alerts", 5)
		    RETURN .F.
		ENDIF
		
		loGrid = loFrm.grd_alerts
		
		IF !PEMSTATUS(loFrm, "xSortField", 5)
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xSortDesc", 5)
		    RETURN .F.
		ENDIF
		
		lcField = ALLTRIM(loFrm.xSortField)
		llDesc  = loFrm.xSortDesc
		
		FOR lnCol = 1 TO loGrid.ColumnCount
		    lcMapField = ""
		
		    DO CASE
		        CASE lnCol = 1
		            lcMapField = "ui_item"
		            lcBaseCaption = "Item"
		        CASE lnCol = 2
		            lcMapField = "art_codi"
		            lcBaseCaption = "Código"
		        CASE lnCol = 3
		            lcMapField = "art_desc"
		            lcBaseCaption = "Descripción"
		        CASE lnCol = 4
		            lcMapField = "art_stock"
		            lcBaseCaption = "Stock"
		        CASE lnCol = 5
		            lcMapField = "pedprov"
		            lcBaseCaption = "Compras"
		        CASE lnCol = 6
		            lcMapField = "pedidos"
		            lcBaseCaption = "Pedidos"
		        CASE lnCol = 7
		            lcMapField = "posicion"
		            lcBaseCaption = "Posición"
		        CASE lnCol = 8
		            lcMapField = "art_stmin"
		            lcBaseCaption = "Mínimo"
		        CASE lnCol = 9
		            lcMapField = "sug_neto"
		            lcBaseCaption = "Sugerido"
		        CASE lnCol = 10
		            lcMapField = "prov_nomb_sel"
		            lcBaseCaption = "Proveedor"
		        CASE lnCol = 11
		            lcMapField = "artpro_costo"
		            lcBaseCaption = "Costo"
		        CASE lnCol = 12
		            lcMapField = "artpro_moneda"
		            lcBaseCaption = "Mon"
		        CASE lnCol = 13
		            lcMapField = "ui_sel"
		            lcBaseCaption = "X"
		        OTHERWISE
		            lcBaseCaption = loGrid.Columns(lnCol).Header1.Caption
		    ENDCASE
		
		    lcTag = ""
		    IF UPPER(ALLTRIM(lcMapField)) == UPPER(lcField)
		        lcTag = IIF(llDesc, " [DESC]", " [ASC]")
		    ENDIF
		
		    loGrid.Columns(lnCol).Header1.Caption = lcBaseCaption + lcTag
		ENDFOR
		
		loGrid.Refresh()
		RETURN .T.
	ENDPROC

	PROCEDURE volcarcurtempencuralerts
		*=========================================================
		* FormSet.VolcarCurTempEnCurAlerts
		* Embudo oficial:
		* - valida cur_temp / cur_alerts
		* - vuelca cur_temp a cur_alerts por campos explícitos
		* - sincroniza selección real
		* - renumera ui_item
		*=========================================================
		LOCAL lcSafety
		LOCAL lnItem
		LOCAL lcArtproFecha, lcProvLista, lcColBack, lcColFore
		LOCAL lcEstado, lcObservacion, lcColorRank
		
		IF !USED("cur_temp")
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_alerts")
		    RETURN .F.
		ENDIF
		
		IF USED("cur_temp_ins")
		    USE IN cur_temp_ins
		ENDIF
		
		*---------------------------------------------------------
		* Blindaje de campos opcionales de cur_temp
		*---------------------------------------------------------
		lcArtproFecha = IIF(TYPE("cur_temp.artpro_fecha") = "U", ;
		    "CAST({} AS D)", ;
		    "CAST(NVL(cur_temp.artpro_fecha,{}) AS D)")
		
		lcProvLista = IIF(TYPE("cur_temp.prov_lista") = "U", ;
		    "CAST('' AS M)", ;
		    "CAST(NVL(cur_temp.prov_lista,'') AS M)")
		
		lcColBack = IIF(TYPE("cur_temp.col_back") = "U", ;
		    "CAST(0 AS N(12,0))", ;
		    "CAST(NVL(cur_temp.col_back,0) AS N(12,0))")
		
		lcColFore = IIF(TYPE("cur_temp.col_fore") = "U", ;
		    "CAST(0 AS N(12,0))", ;
		    "CAST(NVL(cur_temp.col_fore,0) AS N(12,0))")
		
		lcEstado = IIF(TYPE("cur_temp.estado") = "U", ;
		    "CAST(1 AS I)", ;
		    "CAST(NVL(cur_temp.estado,1) AS I)")
		
		lcObservacion = IIF(TYPE("cur_temp.observacion") = "U", ;
		    "CAST('' AS M)", ;
		    "CAST(NVL(cur_temp.observacion,'') AS M)")
		
		lcColorRank = IIF(TYPE("cur_temp.ui_color_rank") = "U", ;
		    "CAST(0 AS I)", ;
		    "CAST(NVL(cur_temp.ui_color_rank,0) AS I)")
		
		lcSafety = SET("SAFETY")
		SET SAFETY OFF
		
		SELECT cur_alerts
		ZAP
		
		SELECT ;
		      art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		      pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		      ventas_metrics, promedio_venta, fecha_ult_venta, ;
		      compras_metrics, promedio_compra, fecha_ult_compra, ;
		      dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		      cant_soli, meses_cubiertos, meses_cob_proy, meses_cobert_solic, ;
		      score, rub_codi, rub_desc, ;
		      &lcEstado      AS estado, ;
		      prov_codi_sel, prov_nomb_sel, artpro_costo, artpro_moneda, ;
		      &lcArtproFecha AS artpro_fecha, ;
		      &lcProvLista   AS prov_lista, ;
		      &lcColBack     AS col_back, ;
		      &lcColFore     AS col_fore, ;
		      &lcObservacion AS observacion, ;
		      &lcColorRank   AS ui_color_rank, ;
		      ui_item, ui_sel ;
		FROM cur_temp ;
		INTO CURSOR cur_temp_ins READWRITE
		
		INSERT INTO cur_alerts ;
		    ( art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		      pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		      ventas_metrics, promedio_venta, fecha_ult_venta, ;
		      compras_metrics, promedio_compra, fecha_ult_compra, ;
		      dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		      cant_soli, meses_cubiertos, meses_cob_proy, meses_cobert_solic, ;
		      score, rub_codi, rub_desc, estado, ;
		      prov_codi_sel, prov_nomb_sel, artpro_costo, artpro_moneda, artpro_fecha, ;
		      prov_lista, col_back, col_fore, ui_color_rank, observacion, ui_item, ui_sel ) ;
		SELECT ;
		      art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		      pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		      ventas_metrics, promedio_venta, fecha_ult_venta, ;
		      compras_metrics, promedio_compra, fecha_ult_compra, ;
		      dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		      cant_soli, meses_cubiertos, meses_cob_proy, meses_cobert_solic, ;
		      score, rub_codi, rub_desc, estado, ;
		      prov_codi_sel, prov_nomb_sel, artpro_costo, artpro_moneda, artpro_fecha, ;
		      prov_lista, col_back, col_fore, ui_color_rank, observacion, ui_item, ui_sel ;
		FROM cur_temp_ins
		
		USE IN cur_temp_ins
		
		IF UPPER(ALLTRIM(lcSafety)) == "ON"
		    SET SAFETY ON
		ELSE
		    SET SAFETY OFF
		ENDIF
		
		USE IN cur_temp
		
		IF PEMSTATUS(THISFORMSET, "SincronizarSeleccionDesdeTemp", 5)
		    THISFORMSET.SincronizarSeleccionDesdeTemp()
		ENDIF
		
		SELECT cur_alerts
		lnItem = 0
		GO TOP
		SCAN
		    lnItem = lnItem + 1
		    IF TYPE("cur_alerts.ui_item") <> "U"
		        REPLACE ui_item WITH ALLTRIM(STR(lnItem))
		    ENDIF
		ENDSCAN
		GO TOP
		
		RETURN .T.
	ENDPROC

	PROCEDURE xinputactivate
		*=========================================================
		* FormSet.xInputActivate
		* Selecciona todo el contenido del textbox la primera vez
		* que el diálogo toma foco
		*=========================================================
		LOCAL loFrm, lnLen
		
		loFrm = THISFORMSET.xTmpInputFrm
		IF VARTYPE(loFrm) <> "O"
		    RETURN
		ENDIF
		
		IF !PEMSTATUS(loFrm, "lDidActivate", 5)
		    RETURN
		ENDIF
		
		IF loFrm.lDidActivate
		    RETURN
		ENDIF
		
		IF !PEMSTATUS(loFrm, "txt1", 5)
		    RETURN
		ENDIF
		
		loFrm.lDidActivate = .T.
		
		loFrm.txt1.SetFocus()
		
		lnLen = LEN(loFrm.txt1.InputMask)
		IF lnLen <= 0
		    lnLen = 20
		ENDIF
		
		loFrm.txt1.SelStart  = 0
		loFrm.txt1.SelLength = lnLen
	ENDPROC

	PROCEDURE xinputcancelclick
		*=========================================================
		* FormSet.xInputCancelClick
		*=========================================================
		LOCAL loFrm
		loFrm = THISFORMSET.xTmpInputFrm
		IF VARTYPE(loFrm) <> "O"
		    RETURN
		ENDIF
		
		loFrm.lCancelled = .T.
		loFrm.Hide()
	ENDPROC

	PROCEDURE xinputokclick
		*=========================================================
		* FormSet.xInputOKClick
		* Handler BINDEVENT: cmdOK.Click del diálogo InputNumerico
		*=========================================================
		LOCAL loF
		loF = THISFORMSET.xTmpInputFrm
		IF VARTYPE(loF) = "O" AND !ISNULL(loF)
		    IF VARTYPE(loF.txt1.Value) = "N"
		        loF.nResult    = loF.txt1.Value
		        loF.lCancelled = .F.
		    ENDIF
		    loF.Hide()
		ENDIF
		
	ENDPROC

	PROCEDURE xinputqueryunload
		*=========================================================
		* FormSet.xInputQueryUnload
		*=========================================================
		LPARAMETERS nMode
		LOCAL loFrm
		
		loFrm = THISFORMSET.xTmpInputFrm
		IF VARTYPE(loFrm) <> "O"
		    RETURN
		ENDIF
		
		loFrm.lCancelled = .T.
		NODEFAULT
		
		IF loFrm.Visible
		    loFrm.Hide()
		ENDIF
	ENDPROC

	PROCEDURE cuaterno.Activate
		*=========================================================
		* cuaterno.Activate
		* - Limpia teclado residual
		* - Apaga Default/Cancel de botones
		* - En modo lectura NO fuerza foco al edit
		*=========================================================
		
		CLEAR TYPEAHEAD
		
		IF PEMSTATUS(THIS, "command1", 5)
		    THIS.command1.Default = .F.
		    THIS.command1.Cancel  = .F.
		ENDIF
		
		IF PEMSTATUS(THIS, "command2", 5)
		    THIS.command2.Default = .F.
		    THIS.command2.Cancel  = .F.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "xObsCuaternoAbierto", 5)
		    THISFORMSET.xObsCuaternoAbierto = .T.
		ENDIF
		
		*---------------------------------------------------------
		* Solo enfocar edit1 si NO está en modo lectura
		*---------------------------------------------------------
		IF PEMSTATUS(THIS, "edit1", 5) AND ;
		   THIS.edit1.Enabled AND ;
		   !THIS.edit1.ReadOnly
		
		    TRY
		        THIS.edit1.SetFocus()
		    CATCH
		    ENDTRY
		ENDIF
		
		CLEAR TYPEAHEAD
		
		RETURN .T.
	ENDPROC

	PROCEDURE cuaterno.Command1.Click
		*=========================================================
		* cuaterno.command1.Click
		* Guardar / Aceptar observación
		* - NO ejecuta confirmación
		* - Solo devuelve xValor / xCancelado y oculta el form
		* - Si está en modo OBS_ART, guarda observación del artículo
		* - En modo LECTURA no debería estar visible
		*=========================================================
		LOCAL lnDiffOpen
		LOCAL lcTexto
		LOCAL lnArtCodi
		LOCAL llOk
		
		lnDiffOpen = 999
		lcTexto    = ""
		lnArtCodi  = 0
		llOk       = .F.
		
		*---------------------------------------------------------
		* Blindaje anti ENTER/click fantasma
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORM, "xOpenSeconds", 5)
		    lnDiffOpen = SECONDS() - THISFORM.xOpenSeconds
		
		    IF lnDiffOpen < 0
		        lnDiffOpen = lnDiffOpen + 86400
		    ENDIF
		
		    IF lnDiffOpen < 0.80
		        CLEAR TYPEAHEAD
		        RETURN .F.
		    ENDIF
		ENDIF
		
		CLEAR TYPEAHEAD
		
		*---------------------------------------------------------
		* Si está en modo lectura, este botón no debe actuar
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "xModoCuaterno", 5) AND ;
		   UPPER(ALLTRIM(NVL(THISFORMSET.xModoCuaterno, ""))) == "LECTURA"
		
		    CLEAR TYPEAHEAD
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Asegurar propiedades internas
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORM, "xValor", 5)
		    THISFORM.AddProperty("xValor", "")
		ENDIF
		
		IF !PEMSTATUS(THISFORM, "xCancelado", 5)
		    THISFORM.AddProperty("xCancelado", .T.)
		ENDIF
		
		*---------------------------------------------------------
		* Leer texto
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORM, "edit1", 5)
		    DO CASE
		    CASE VARTYPE(THISFORM.edit1.Value) = "C"
		        lcTexto = ALLTRIM(THISFORM.edit1.Value)
		
		    CASE VARTYPE(THISFORM.edit1.Value) = "M"
		        lcTexto = ALLTRIM(THISFORM.edit1.Value)
		
		    OTHERWISE
		        lcTexto = ""
		    ENDCASE
		ENDIF
		
		*---------------------------------------------------------
		* Resultado aceptado
		*---------------------------------------------------------
		THISFORM.xValor     = lcTexto
		THISFORM.xCancelado = .F.
		
		IF PEMSTATUS(THISFORMSET, "xObsCuaternoValor", 5)
		    THISFORMSET.xObsCuaternoValor = lcTexto
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "xObsCuaternoCancelado", 5)
		    THISFORMSET.xObsCuaternoCancelado = .F.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "xObsCuaternoAbierto", 5)
		    THISFORMSET.xObsCuaternoAbierto = .F.
		ENDIF
		
		*---------------------------------------------------------
		* Modo observación por artículo
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "xModoCuaterno", 5) AND ;
		   UPPER(ALLTRIM(NVL(THISFORMSET.xModoCuaterno, ""))) == "OBS_ART"
		
		    IF PEMSTATUS(THISFORMSET, "xObsArtCodiEdit", 5)
		        lnArtCodi = THISFORMSET.xObsArtCodiEdit
		    ENDIF
		
		    IF VARTYPE(lnArtCodi) <> "N" OR lnArtCodi <= 0
		        MESSAGEBOX("No se pudo determinar el artículo a actualizar.", 16, "Error")
		        RETURN .F.
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "CRUDTempSolicitudCompra", 5)
		        llOk = THISFORMSET.CRUDTempSolicitudCompra( ;
		            "UPDATE_OBS", ;
		            lnArtCodi, ;
		            0, ;
		            0, ;
		            0, ;
		            "", ;
		            0, ;
		            lcTexto)
		    ELSE
		        MESSAGEBOX("No existe el método CRUDTempSolicitudCompra.", 16, "Error")
		        RETURN .F.
		    ENDIF
		
		    IF !llOk
		        MESSAGEBOX("No se pudo guardar la observación del artículo.", 16, "Error")
		        RETURN .F.
		    ENDIF
		
		    IF USED("cur_alerts")
		        SELECT cur_alerts
		        LOCATE FOR art_codi = lnArtCodi
		
		        IF FOUND() AND TYPE("cur_alerts.observacion") $ "CM"
		            REPLACE observacion WITH lcTexto IN cur_alerts
		        ENDIF
		    ENDIF
		
		    IF USED("cur_soli_det")
		        SELECT cur_soli_det
		        LOCATE FOR art_codi = lnArtCodi
		
		        IF FOUND() AND TYPE("cur_soli_det.observacion") $ "CM"
		            REPLACE observacion WITH lcTexto IN cur_soli_det
		        ENDIF
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "xModoCuaterno", 5)
		        THISFORMSET.xModoCuaterno = ""
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "xObsArtCodiEdit", 5)
		        THISFORMSET.xObsArtCodiEdit = 0
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "xObsArtDescEdit", 5)
		        THISFORMSET.xObsArtDescEdit = ""
		    ENDIF
		
		    CLEAR TYPEAHEAD
		    THISFORM.Hide()
		
		    IF PEMSTATUS(THISFORMSET, "principal", 5) AND ;
		       PEMSTATUS(THISFORMSET.principal, "grd_alerts", 5)
		        THISFORMSET.principal.grd_alerts.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "secundario", 5) AND ;
		       PEMSTATUS(THISFORMSET.secundario, "grid2", 5)
		        THISFORMSET.secundario.grid2.Refresh()
		    ENDIF
		
		    RETURN .T.
		ENDIF
		
		*---------------------------------------------------------
		* Modo observación general de solicitud
		* NO ejecutar confirmación acá
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "xModoCuaterno", 5)
		    THISFORMSET.xModoCuaterno = ""
		ENDIF
		
		CLEAR TYPEAHEAD
		THISFORM.Hide()
		
		RETURN .T.
	ENDPROC

	PROCEDURE cuaterno.Command1.MouseLeave
		&& frm_alertas_stock.cuarterno.command1.mouseleave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		WITH THISFORM.command1
		    .BackColor = RGB(240,240,240)
		    .ForeColor = RGB(40,40,40)
		    .FontBold  = .F.
		    .FontSize  = 9
		ENDWITH
		
	ENDPROC

	PROCEDURE cuaterno.Command1.MouseMove
		&& frm_alertas_stock.cuaterno.command1.mousemove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		WITH THISFORM.command1
		    .BackColor = RGB(225,225,225)
		    .ForeColor = RGB(20,20,20)
		    .FontBold  = .T.
		    .FontSize  = 10
		ENDWITH
		
	ENDPROC

	PROCEDURE cuaterno.Command2.Click
		*=========================================================
		* cuaterno.command2.Click
		* Cancelar / Cerrar observación
		* - Protegido contra ESC/click fantasma al abrir
		*=========================================================
		LOCAL lnDiffOpen
		
		lnDiffOpen = 999
		
		*---------------------------------------------------------
		* Blindaje anti ESC/click fantasma
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORM, "xOpenSeconds", 5)
		    lnDiffOpen = SECONDS() - THISFORM.xOpenSeconds
		
		    IF lnDiffOpen < 0
		        lnDiffOpen = lnDiffOpen + 86400
		    ENDIF
		
		    IF lnDiffOpen < 0.80
		        CLEAR TYPEAHEAD
		        RETURN .F.
		    ENDIF
		ENDIF
		
		CLEAR TYPEAHEAD
		
		IF !PEMSTATUS(THISFORM, "xValor", 5)
		    THISFORM.AddProperty("xValor", "")
		ENDIF
		
		IF !PEMSTATUS(THISFORM, "xCancelado", 5)
		    THISFORM.AddProperty("xCancelado", .T.)
		ENDIF
		
		THISFORM.xValor     = ""
		THISFORM.xCancelado = .T.
		
		IF PEMSTATUS(THISFORMSET, "xObsCuaternoValor", 5)
		    THISFORMSET.xObsCuaternoValor = ""
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "xObsCuaternoCancelado", 5)
		    THISFORMSET.xObsCuaternoCancelado = .T.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "xObsCuaternoAbierto", 5)
		    THISFORMSET.xObsCuaternoAbierto = .F.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "xModoCuaterno", 5)
		    THISFORMSET.xModoCuaterno = ""
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "xObsArtCodiEdit", 5)
		    THISFORMSET.xObsArtCodiEdit = 0
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "xObsArtDescEdit", 5)
		    THISFORMSET.xObsArtDescEdit = ""
		ENDIF
		
		CLEAR TYPEAHEAD
		
		THISFORM.Hide()
		
		RETURN .T.
	ENDPROC


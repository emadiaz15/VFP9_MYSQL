	PROCEDURE principal.Init
		*=========================================================
		* principal.Init
		* - Prepara propiedades, placeholders y estructura visual
		* - Ejecuta la carga REAL antes de mostrar el formulario
		*=========================================================
		LPARAMETERS xcondi
		LOCAL lnMesesCob, lnMesesMue
		LOCAL llOk, loEx
		
		SET PROCEDURE TO alerts_utils ADDITIVE
		SET DATE BRITISH
		SET CENTURY OFF
		
		THIS.LockScreen = .T.
		THIS.Visible    = .F.
		
		*---------------------------------------------------------
		* 1) Defaults negocio: combo3=3 y combo4=3 (si existen)
		*---------------------------------------------------------
		IF PEMSTATUS(THIS, "combo3", 5)
		    THIS.combo3.Value = "3"
		    THIS.combo3.ListIndex = 3
		ENDIF
		
		IF PEMSTATUS(THIS, "combo4", 5)
		    THIS.combo4.Value = "3"
		    THIS.combo4.ListIndex = 1
		ENDIF
		
		*---------------------------------------------------------
		* 2) Variables del form
		*---------------------------------------------------------
		IF !PEMSTATUS(THIS, "xMesesCobertura", 5)
		    THIS.AddProperty("xMesesCobertura", 3)
		ELSE
		    THIS.xMesesCobertura = 3
		ENDIF
		
		IF !PEMSTATUS(THIS, "xMesesMuestra", 5)
		    THIS.AddProperty("xMesesMuestra", 3)
		ELSE
		    THIS.xMesesMuestra = 3
		ENDIF
		
		*---------------------------------------------------------
		* 3) Flags
		*---------------------------------------------------------
		IF !PEMSTATUS(THIS, "xLoaded", 5)
		    THIS.AddProperty("xLoaded", .F.)
		ELSE
		    THIS.xLoaded = .F.
		ENDIF
		
		IF !PEMSTATUS(THIS, "xIsLoading", 5)
		    THIS.AddProperty("xIsLoading", .F.)
		ELSE
		    THIS.xIsLoading = .F.
		ENDIF
		
		IF !PEMSTATUS(THIS, "xIsFiltering", 5)
		    THIS.AddProperty("xIsFiltering", .F.)
		ELSE
		    THIS.xIsFiltering = .F.
		ENDIF
		
		*---------------------------------------------------------
		* 4) Estado UI
		*---------------------------------------------------------
		IF !PEMSTATUS(THIS, "xCurRec", 5)
		    THIS.AddProperty("xCurRec", 0)
		ELSE
		    THIS.xCurRec = 0
		ENDIF
		
		IF !PEMSTATUS(THIS, "xCurArt", 5)
		    THIS.AddProperty("xCurArt", 0)
		ELSE
		    THIS.xCurArt = 0
		ENDIF
		
		IF !PEMSTATUS(THIS, "xDblClickRec", 5)
		    THIS.AddProperty("xDblClickRec", 0)
		ELSE
		    THIS.xDblClickRec = 0
		ENDIF
		
		IF !PEMSTATUS(THIS, "xCurRecVC", 5)
		    THIS.AddProperty("xCurRecVC", 0)
		ELSE
		    THIS.xCurRecVC = 0
		ENDIF
		
		*---------------------------------------------------------
		* 5) Filtros / Combo2
		*---------------------------------------------------------
		IF !PEMSTATUS(THIS, "xFiltroActual", 5)
		    THIS.AddProperty("xFiltroActual", "PEDIDOS")
		ELSE
		    THIS.xFiltroActual = "PEDIDOS"
		ENDIF
		
		IF !PEMSTATUS(THIS, "xRubCodiActual", 5)
		    THIS.AddProperty("xRubCodiActual", 0)
		ELSE
		    THIS.xRubCodiActual = 0
		ENDIF
		
		IF !PEMSTATUS(THIS, "xProveedorCodiActual", 5)
		    THIS.AddProperty("xProveedorCodiActual", 0)
		ELSE
		    THIS.xProveedorCodiActual = 0
		ENDIF
		
		IF !PEMSTATUS(THIS, "xDepuracionActual", 5)
		    THIS.AddProperty("xDepuracionActual", 0)
		ELSE
		    THIS.xDepuracionActual = 0
		ENDIF
		
		IF !PEMSTATUS(THIS, "xCombo2Mode", 5)
		    THIS.AddProperty("xCombo2Mode", "")
		ELSE
		    THIS.xCombo2Mode = ""
		ENDIF
		
		IF !PEMSTATUS(THIS, "xCombo2ValorActual", 5)
		    THIS.AddProperty("xCombo2ValorActual", 0)
		ELSE
		    THIS.xCombo2ValorActual = 0
		ENDIF
		
		IF !PEMSTATUS(THIS, "xPedidosModoFiltro", 5)
		    THIS.AddProperty("xPedidosModoFiltro", "TODOS")
		ELSE
		    THIS.xPedidosModoFiltro = "TODOS"
		ENDIF
		
		IF !PEMSTATUS(THIS, "xCombo5ValorActual", 5)
		    THIS.AddProperty("xCombo5ValorActual", "TODOS")
		ELSE
		    THIS.xCombo5ValorActual = "TODOS"
		ENDIF
		
		*---------------------------------------------------------
		* 6) Filtro especial: Pedidos por fecha
		*---------------------------------------------------------
		IF !PEMSTATUS(THIS, "xFiltroPedidos", 5)
		    THIS.AddProperty("xFiltroPedidos", .F.)
		ELSE
		    THIS.xFiltroPedidos = .F.
		ENDIF
		
		IF !PEMSTATUS(THIS, "xPedFecDes", 5)
		    THIS.AddProperty("xPedFecDes", DATE())
		ELSE
		    THIS.xPedFecDes = DATE()
		ENDIF
		
		IF !PEMSTATUS(THIS, "xPedFecHas", 5)
		    THIS.AddProperty("xPedFecHas", DATE())
		ELSE
		    THIS.xPedFecHas = DATE()
		ENDIF
		
		*---------------------------------------------------------
		* 7) Sort
		*---------------------------------------------------------
		IF !PEMSTATUS(THIS, "xSortField", 5)
		    THIS.AddProperty("xSortField", "")
		ELSE
		    THIS.xSortField = ""
		ENDIF
		
		IF !PEMSTATUS(THIS, "xSortDesc", 5)
		    THIS.AddProperty("xSortDesc", .F.)
		ELSE
		    THIS.xSortDesc = .F.
		ENDIF
		
		IF !PEMSTATUS(THIS, "xOrdenColorDesc", 5)
		    THIS.AddProperty("xOrdenColorDesc", .T.)
		ELSE
		    THIS.xOrdenColorDesc = .T.
		ENDIF
		*=========================================================
		* 8) Propiedades visuales
		*=========================================================
		THIS.Caption      = "COMPRAS - REVISIÓN DE STOCK"
		THIS.BorderStyle  = 0
		THIS.Movable      = .T.
		THIS.AutoCenter   = .T.
		THIS.Themes       = .F.
		THIS.BackColor    = RGB(40,44,52)
		THIS.MaxButton    = .F.
		THIS.MinButton    = .F.
		THIS.WindowState  = 0
		
		*=========================================================
		* 9) Parámetros desde combos
		*=========================================================
		lnMesesCob = 3
		lnMesesMue = 6
		
		IF PEMSTATUS(THIS, "combo3", 5)
		    lnMesesCob = VAL(TRANSFORM(THIS.combo3.Value))
		ENDIF
		
		IF PEMSTATUS(THIS, "combo4", 5)
		    lnMesesMue = VAL(TRANSFORM(THIS.combo4.Value))
		ENDIF
		
		lnMesesMue = MIN(12, MAX(3, lnMesesMue))
		lnMesesCob = MIN(12, MAX(1, lnMesesCob))
		
		THIS.xMesesMuestra   = lnMesesMue
		THIS.xMesesCobertura = lnMesesCob
		
		*=========================================================
		* 10) Cursores placeholder
		*=========================================================
		IF !USED("cur_alerts")
		    CREATE CURSOR cur_alerts ( ;
		        art_codi           I,        ;
		        art_desc           C(80),    ;
		        art_stock          N(15,3),  ;
		        art_stmin          N(15,3),  ;
		        art_pct_alerta     N(10,2),  ;
		        pedidos            N(15,3),  ;
		        pedprov            N(15,3),  ;
		        posicion           N(15,3),  ;
		        sug_neto           N(15,3),  ;
		        pct_rotacion       N(10,3),  ;
		        ventas_metrics     M,        ;
		        promedio_venta     N(15,3),  ;
		        fecha_ult_venta    D,        ;
		        compras_metrics    M,        ;
		        promedio_compra    N(15,3),  ;
		        fecha_ult_compra   D,        ;
		        dias_demora_ent    I,        ;
		        pos_min_sug        N(15,3),  ;
		        sugerido_comprar   N(15,3),  ;
		        cant_soli          N(15,3),  ;
		        meses_cubiertos    N(15,3),  ;
		        meses_cob_proy     N(15,3),  ;
		        meses_cobert_solic N(15,3),  ;
		        score              I,        ;
		        estado             I,        ;
		        rub_codi           I,        ;
		        rub_desc           C(60),    ;
		        prov_codi_sel      I,        ;
		        prov_nomb_sel      C(80),    ;
		        artpro_costo       N(15,4),  ;
		        artpro_moneda      C(1),     ;
		        artpro_fecha       D,        ;
		        prov_lista         M,        ;
		        col_back           N(12,0),  ;
		        col_fore           N(12,0),  ;
		        ui_item            C(8),     ;
		        ui_sel             L,        ;        
		        ui_color_rank      I )
		        
		ENDIF
		
		IF !USED("cur_raw_full")
		    CREATE CURSOR cur_raw_full ( ;
		        art_codi           I,        ;
		        art_desc           C(80),    ;
		        art_stock          N(15,3),  ;
		        art_stmin          N(15,3),  ;
		        art_pct_alerta     N(10,2),  ;
		        pedidos            N(15,3),  ;
		        pedprov            N(15,3),  ;
		        posicion           N(15,3),  ;
		        sug_neto           N(15,3),  ;
		        pct_rotacion       N(10,3),  ;
		        ventas_metrics     M,        ;
		        promedio_venta     N(15,3),  ;
		        fecha_ult_venta    D,        ;
		        compras_metrics    M,        ;
		        promedio_compra    N(15,3),  ;
		        fecha_ult_compra   D,        ;
		        dias_demora_ent    I,        ;
		        pos_min_sug        N(15,3),  ;
		        sugerido_comprar   N(15,3),  ;
		        cant_soli          N(15,3),  ;
		        meses_cubiertos    N(15,3),  ;
		        meses_cob_proy     N(15,3),  ;
		        meses_cobert_solic N(15,3),  ;
		        score              I,        ;
		        estado             I,        ;
		        rub_codi           I,        ;
		        rub_desc           C(60),    ;
		        prov_codi_sel      I,        ;
		        prov_nomb_sel      C(80),    ;
		        artpro_costo       N(15,4),  ;
		        artpro_moneda      C(1),     ;
		        artpro_fecha       D,        ;
		        prov_lista         M )
		ENDIF
		
		IF !USED("cur_cli_art")
		    CREATE CURSOR cur_cli_art ( ;
		        fecha    D, ;
		        ped_codi I, ;
		        cantidad N(15,3), ;
		        cliente  C(120) )
		ENDIF
		
		IF !USED("cur_vc_months")
		    CREATE CURSOR cur_vc_months ( ;
		        mes      C(7),     ;
		        compras  N(15,3),  ;
		        ventas   N(15,3) )
		ENDIF
		
		*=========================================================
		* 11) Objetos visuales auxiliares
		*=========================================================
		IF !PEMSTATUS(THIS, "shpSelVC", 5)
		    THIS.AddObject("shpSelVC", "Shape")
		ENDIF
		
		WITH THIS.shpSelVC
		    .BackStyle   = 0
		    .BorderColor = RGB(0,0,0)
		    .BorderWidth = 1
		    .Visible     = .F.
		    .ZOrder(0)
		ENDWITH
		
		*=========================================================
		* 12) Estructura de grids
		*=========================================================
		IF PEMSTATUS(THISFORMSET, "ConfigurarGrid", 5)
		    THISFORMSET.ConfigurarGrid()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ConfigurarGridVentaCompra", 5)
		    THISFORMSET.ConfigurarGridVentaCompra()
		ENDIF
		
		IF PEMSTATUS(THIS, "grid1", 5)
		    THIS.grid1.RecordSource = "cur_cli_art"
		
		    IF THIS.grid1.ColumnCount >= 4
		        THIS.grid1.Columns(1).ControlSource = "cur_cli_art.fecha"
		        THIS.grid1.Columns(2).ControlSource = "cur_cli_art.ped_codi"
		        THIS.grid1.Columns(3).ControlSource = "cur_cli_art.cantidad"
		        THIS.grid1.Columns(4).ControlSource = "cur_cli_art.cliente"
		    ENDIF
		ENDIF
		
		*=========================================================
		* 13) Bind textos + combos
		*=========================================================
		IF PEMSTATUS(THISFORMSET, "BindMetricTexts", 5)
		    THISFORMSET.BindMetricTexts()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "SetupFiltros", 5)
		    THISFORMSET.SetupFiltros()
		ENDIF
		
		IF PEMSTATUS(THIS, "combo5", 5)
		    THIS.combo5.RowSourceType = 1
		    THIS.combo5.RowSource = "TODOS,POSICION < (POS.MINIMO + % ALERTA),COMPRA SUGERIDA > 0"
		    THIS.combo5.Value = "TODOS"
		    THIS.combo5.Visible = .F.
		ENDIF
		IF PEMSTATUS(THISFORMSET, "ActualizarInfoFiltro", 5)
		    THISFORMSET.ActualizarInfoFiltro()
		ENDIF
		
		*=========================================================
		* 14) Estado inicial filtro Pedidos
		*=========================================================
		THIS.xFiltroPedidos = .F.
		THIS.xPedFecDes     = DATE()
		THIS.xPedFecHas     = DATE()
		
		IF PEMSTATUS(THIS, "txt_fecdes", 5)
		    THIS.txt_fecdes.Value = THIS.xPedFecDes
		ENDIF
		
		IF PEMSTATUS(THIS, "txt_fechas", 5)
		    THIS.txt_fechas.Value = THIS.xPedFecHas
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "MostrarFiltroPedidos", 5)
		    THISFORMSET.MostrarFiltroPedidos(.F.)
		ENDIF
		
		*=========================================================
		* 15) Estado inicial UI si combo1 arranca en PEDIDOS
		*=========================================================
		IF PEMSTATUS(THIS, "combo1", 5)
		    IF UPPER(ALLTRIM(THIS.combo1.DisplayValue)) == "PEDIDOS"
		
				IF PEMSTATUS(THIS, "combo5", 5)
				    THIS.combo5.Visible = .T.
				    THIS.combo5.Value = "TODOS"
				ENDIF
		
				IF PEMSTATUS(THIS, "xPedidosModoFiltro", 5)
				    THIS.xPedidosModoFiltro = "TODOS"
				ENDIF
		
				IF PEMSTATUS(THIS, "xCombo5ValorActual", 5)
				    THIS.xCombo5ValorActual = "TODOS"
				ENDIF
		
		        THIS.xFiltroActual  = "PEDIDOS"
		        THIS.xFiltroPedidos = .T.
		        THIS.xPedFecDes     = DATE()
		        THIS.xPedFecHas     = DATE()
		
		        IF PEMSTATUS(THIS, "txt_fecdes", 5)
		            THIS.txt_fecdes.Value = THIS.xPedFecDes
		        ENDIF
		
		        IF PEMSTATUS(THIS, "txt_fechas", 5)
		            THIS.txt_fechas.Value = THIS.xPedFecHas
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "MostrarFiltroPedidos", 5)
		            THISFORMSET.MostrarFiltroPedidos(.T.)
		        ENDIF
		
		    ELSE
		
		        IF PEMSTATUS(THIS, "combo5", 5)
		            THIS.combo5.Visible = .F.
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "MostrarFiltroPedidos", 5)
		            THISFORMSET.MostrarFiltroPedidos(.F.)
		        ENDIF
		
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THIS, "chkOrdenColor", 5)
		    THIS.chkOrdenColor.Value = .T.
		ENDIF
		
		*=========================================================
		* 16) Ocultar grids durante bootstrap
		*=========================================================
		IF PEMSTATUS(THIS, "grd_alerts", 5)
		    THIS.grd_alerts.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(THIS, "grd_prov", 5)
		    THIS.grd_prov.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(THIS, "grd_venta_compra", 5)
		    THIS.grd_venta_compra.Visible = .F.
		ENDIF
		
		*=========================================================
		* 17) Controles manuales ocultos al iniciar
		*=========================================================
		IF PEMSTATUS(THIS, "text10", 5)
		    THIS.text10.Visible = .F.
		    THIS.text10.Value   = ""
		ENDIF
		
		IF PEMSTATUS(THIS, "label15", 5)
		    THIS.label15.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(THIS, "text7", 5)
		    THIS.text7.Visible = .F.
		    THIS.text7.Value   = 0
		ENDIF
		
		IF PEMSTATUS(THIS, "label9", 5)
		    THIS.label9.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(THIS, "label13", 5)
		    THIS.label13.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(THIS, "label10", 5)
		    THIS.label10.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(THIS, "label17", 5)
		    THIS.label17.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(THIS, "label16", 5)
		    THIS.label16.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(THIS, "text3", 5)
		    THIS.text3.Visible = .F.
		    THIS.text3.Value   = 0
		ENDIF
		
		IF PEMSTATUS(THIS, "text6", 5)
		    THIS.text6.Visible = .F.
		    THIS.text6.Value   = 0
		ENDIF
		
		IF PEMSTATUS(THIS, "text5", 5)
		    THIS.text5.Visible = .F.
		    THIS.text5.Value   = 0
		ENDIF
		
		IF PEMSTATUS(THIS, "text9", 5)
		    THIS.text9.Visible = .F.
		    THIS.text9.Value   = 0
		ENDIF
		
		IF PEMSTATUS(THIS, "text8", 5)
		    THIS.text8.Visible = .F.
		    THIS.text8.Value   = 0
		ENDIF
		
		*=========================================================
		* 18) Carga real ANTES de mostrar
		*=========================================================
		llOk = .F.
		THIS.xIsLoading = .T.
		
		IF !PEMSTATUS(THISFORMSET, "xEstaInicializando", 5)
		    THISFORMSET.AddProperty("xEstaInicializando", .F.)
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xMensajePendiente", 5)
		    THISFORMSET.AddProperty("xMensajePendiente", "")
		ENDIF
		
		THISFORMSET.xEstaInicializando = .T.
		
		TRY
		    IF PEMSTATUS(THISFORMSET, "RunPipeline", 5)
		        llOk = THISFORMSET.RunPipeline()
		    ELSE
		        ERROR "No existe THISFORMSET.RunPipeline()"
		    ENDIF
		
		CATCH TO loEx
		    MESSAGEBOX("Error en Init/RunPipeline: " + TRANSFORM(loEx.Message), 16, "principal")
		    llOk = .F.
		
		FINALLY
		    THISFORMSET.xEstaInicializando = .F.
		    THIS.xIsLoading = .F.
		ENDTRY
		
		THIS.xLoaded = llOk
		
		IF llOk
		    IF PEMSTATUS(THISFORMSET, "PosicionarPrimerRegistroAlerts", 5)
		        THISFORMSET.PosicionarPrimerRegistroAlerts()
		    ENDIF
		
		    IF PEMSTATUS(THIS, "grd_alerts", 5)
		        THIS.grd_alerts.Visible = .T.
		        THIS.grd_alerts.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(THIS, "grd_prov", 5)
		        THIS.grd_prov.Visible = .T.
		        THIS.grd_prov.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(THIS, "grd_venta_compra", 5)
		        THIS.grd_venta_compra.Visible = .T.
		        THIS.grd_venta_compra.Refresh()
		    ENDIF
		
		    THIS.LockScreen = .F.
		    THIS.Visible = .T.
		    THIS.Draw()
		
		    IF !EMPTY(THISFORMSET.xMensajePendiente)
		        MESSAGEBOX(THISFORMSET.xMensajePendiente, 64, "Filtro Pedidos")
		        THISFORMSET.xMensajePendiente = ""
		    ENDIF
		ELSE
		    THIS.LockScreen = .F.
		    THIS.Visible = .T.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE principal.lbl_cont.Init
		*=========================================================
		* && principal.lbl_cont.Init
		*=========================================================
		THIS.Caption   = "0 reg."
		THIS.ForeColor = RGB(220, 220, 220)
		THIS.BackStyle = 0
		THIS.FontBold  = .T.
	ENDPROC

	PROCEDURE principal.lbl_info_filtro.Init
		*=========================================================
		* principal.lbl_cont.Init
		*=========================================================
		THIS.ForeColor = RGB(220, 220, 220)
		THIS.BackStyle = 0
		THIS.FontBold  = .T.
	ENDPROC

	PROCEDURE principal.Load
		*=========================================================
		* principal.Load 
		*=========================================================
		SET TALK OFF
		SET ECHO OFF
		SET NOTIFY OFF
	ENDPROC

	PROCEDURE principal.Resize
		*=========================================================
		* principal.Resize
		*=========================================================
		LOCAL lnRest
		
		IF !PEMSTATUS(THIS, "grd_alerts", 5) OR THIS.grd_alerts.ColumnCount < 12
		    RETURN
		ENDIF
		
		WITH THIS.grd_alerts
		    .Left  = 15
		    .Width = THIS.Width - 30
		
		    * Ajustar descripción (col 3) dejando fijas las demás
		    lnRest = .Width - ( ;
		             .Columns(1).Width + .Columns(2).Width + .Columns(4).Width + ;
		             .Columns(5).Width + .Columns(6).Width + .Columns(7).Width + ;
		             .Columns(8).Width + .Columns(9).Width + .Columns(10).Width + ;
		             .Columns(11).Width + .Columns(12).Width )
		
		    .Columns(3).Width = MAX(150, lnRest - 20)
		ENDWITH
		
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		    THISFORMSET.ActualizarEfectoGrid(0)
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGridVC", 5)
		    THISFORMSET.ActualizarEfectoGridVC(0)
		ENDIF
	ENDPROC

	PROCEDURE principal.txt_add_codi.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE principal.txt_add_codi.InteractiveChange
		*=========================================================
		* principal.txt_add_codi.InteractiveChange
		*=========================================================
		LOCAL lcValor
		lcValor = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lcValor)
		    IF PEMSTATUS(THISFORMSET, "LimpiarPanelArticulo", 5)
		        THISFORMSET.LimpiarPanelArticulo()
		    ENDIF
		    IF PEMSTATUS(THISFORMSET, "MostrarOcultarPanelArticulo", 5)
		        THISFORMSET.MostrarOcultarPanelArticulo(.F.)
		    ENDIF
		    RETURN
		ENDIF
	ENDPROC

	PROCEDURE principal.txt_add_codi.LostFocus
		*=========================================================
		* principal.txt_add_codi.LostFocus
		*=========================================================
		IF PEMSTATUS(THISFORMSET, "CargarArticuloDesdeTxtAddCodi", 5)
		    THISFORMSET.CargarArticuloDesdeTxtAddCodi()
		ENDIF
	ENDPROC

	PROCEDURE principal.txt_fecdes.Click
		this.setfocus
		
	ENDPROC

	PROCEDURE principal.txt_fecdes.LostFocus
		*=========================================================
		* && principal.txt_fecdes.LostFocus
		*=========================================================
		IF PEMSTATUS(THISFORM, "txt_fechas", 5)
		    IF THIS.Value > THISFORM.txt_fechas.Value
		        THISFORM.txt_fechas.Value = THIS.Value
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORM, "xPedFecDes", 5)
		    THISFORM.xPedFecDes = THIS.Value
		ENDIF
		
		IF PEMSTATUS(THISFORM, "xPedFecHas", 5) AND PEMSTATUS(THISFORM, "txt_fechas", 5)
		    THISFORM.xPedFecHas = THISFORM.txt_fechas.Value
		ENDIF
	ENDPROC

	PROCEDURE principal.txt_fecdes.Valid
		*=========================================================
		* principal.txt_fecdes.Valid
		*=========================================================
		LOCAL llOk
		
		llOk = .T.
		
		*-- Acá poné tu validación real si existe
		IF PEMSTATUS(THISFORMSET, "AplicarRangoFechas", 5)
		    llOk = THISFORMSET.AplicarRangoFechas()
		ENDIF
		
		IF llOk
		    IF PEMSTATUS(THISFORM, "txt_fechas", 5)
		        TRY
		            THISFORM.txt_fechas.SetFocus()
		        CATCH
		        ENDTRY
		    ENDIF
		ENDIF
		
		RETURN llOk
	ENDPROC

	PROCEDURE principal.txt_fechas.Click
		&& principal.txt_fechas.click
		
		this.SetFocus
	ENDPROC

	PROCEDURE principal.txt_fechas.GotFocus
		*=========================================================
		* && principal.txt_fechas.GotFocus
		*=========================================================
		IF PEMSTATUS(THISFORM, "xPermitirSalirFechaHas", 5)
		    THISFORM.xPermitirSalirFechaHas = .F.
		ENDIF
	ENDPROC

	PROCEDURE principal.txt_fechas.KeyPress
		*=========================================================
		* && principal.txt_fechas.KeyPress
		*=========================================================
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = 13
		    NODEFAULT
		
		    *-- Permitir salir del textbox solo con Enter
		    IF PEMSTATUS(THISFORM, "xPermitirSalirFechaHas", 5)
		        THISFORM.xPermitirSalirFechaHas = .T.
		    ENDIF
		
		    *-- Guardar valores actuales
		    IF PEMSTATUS(THISFORM, "xPedFecHas", 5)
		        THISFORM.xPedFecHas = THIS.Value
		    ENDIF
		
		    IF PEMSTATUS(THISFORM, "xPedFecDes", 5) AND PEMSTATUS(THISFORM, "txt_fecdes", 5)
		        THISFORM.xPedFecDes = THISFORM.txt_fecdes.Value
		    ENDIF
		
		    *-- Ajustar rango si hace falta
		    IF PEMSTATUS(THISFORM, "txt_fecdes", 5)
		        IF THIS.Value < THISFORM.txt_fecdes.Value
		            THISFORM.txt_fecdes.Value = THIS.Value
		            IF PEMSTATUS(THISFORM, "xPedFecDes", 5)
		                THISFORM.xPedFecDes = THISFORM.txt_fecdes.Value
		            ENDIF
		        ENDIF
		    ENDIF
		
		    IF PEMSTATUS(THISFORM, "xFiltroActual", 5) ;
		       AND UPPER(ALLTRIM(THISFORM.xFiltroActual)) == "PEDIDOS"
		
		        IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		            THISFORMSET.AplicarFiltroLocal("PEDIDOS", 0)
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		            THISFORMSET.RefrescarGrid()
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "ActualizarInfoFiltro", 5)
		            THISFORMSET.ActualizarInfoFiltro()
		        ENDIF
		    ENDIF
		ENDIF
	ENDPROC

	PROCEDURE principal.txt_fechas.LostFocus
		*=========================================================
		* && principal.txt_fechas.LostFocus
		*=========================================================
		IF PEMSTATUS(THISFORM, "txt_fecdes", 5)
		    IF THIS.Value < THISFORM.txt_fecdes.Value
		        THISFORM.txt_fecdes.Value = THIS.Value
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORM, "xPedFecHas", 5)
		    THISFORM.xPedFecHas = THIS.Value
		ENDIF
		
		IF PEMSTATUS(THISFORM, "xPedFecDes", 5) AND PEMSTATUS(THISFORM, "txt_fecdes", 5)
		    THISFORM.xPedFecDes = THISFORM.txt_fecdes.Value
		ENDIF
		
		
	ENDPROC

	PROCEDURE principal.txt_fechas.Valid
		*=========================================================
		* && principal.txt_fechas.Valid
		*=========================================================
		IF PEMSTATUS(THISFORM, "xFiltroActual", 5) ;
		   AND UPPER(ALLTRIM(THISFORM.xFiltroActual)) == "PEDIDOS"
		
		    IF PEMSTATUS(THISFORM, "xPermitirSalirFechaHas", 5)
		        IF !THISFORM.xPermitirSalirFechaHas
		            RETURN 0
		        ENDIF
		    ENDIF
		ENDIF
		
		RETURN 1
	ENDPROC

	PROCEDURE principal.txt_fechas.When
		LOCAL lvValue
		
		lvValue= IIF(VARTYPE(thisform.txt_add_codi.Value) = "C", VAL(thisform.txt_add_codi.Value), thisform.txt_add_codi.Value)
		
		IF lvValue > 0
			KEYBOARD '{LEFTARROW}'
		ENDIF
	ENDPROC

	PROCEDURE principal.Unload
		*=========================================================
		* principal.Unload
		*=========================================================
		TRY
		    IF PEMSTATUS(THIS, "grd_alerts", 5)
		        THIS.grd_alerts.RecordSource = ""
		        UNBINDEVENTS(THIS.grd_alerts)
		    ENDIF
		CATCH
		ENDTRY
		
		TRY
		    IF PEMSTATUS(THIS, "grd_venta_compra", 5)
		        THIS.grd_venta_compra.RecordSource = ""
		        UNBINDEVENTS(THIS.grd_venta_compra)
		    ENDIF
		CATCH
		ENDTRY
		
		TRY
		    IF PEMSTATUS(THIS, "shpSelRow", 5)
		        UNBINDEVENTS(THIS.shpSelRow)
		    ENDIF
		CATCH
		ENDTRY
		
		TRY
		    IF PEMSTATUS(THIS, "shpSelVC", 5)
		        UNBINDEVENTS(THIS.shpSelVC)
		    ENDIF
		CATCH
		ENDTRY
		
		RETURN
	ENDPROC

	PROCEDURE secundario.Activate
		*=========================================================
		* formset.secundario.Activate
		*=========================================================
		LOCAL ldDesde, ldHasta
		
		IF PEMSTATUS(THISFORMSET, "xBloquearAfterGrid1", 5) AND ;
		   THISFORMSET.xBloquearAfterGrid1
		    RETURN
		ENDIF
		
		*-- Evita que al volver del calendario se reinicialicen fechas
		IF PEMSTATUS(THIS, "xHistInicializado", 5) AND THIS.xHistInicializado
		    RETURN
		ENDIF
		
		ldDesde = GOMONTH(DATE(), -12)
		ldHasta = DATE()
		
		IF !PEMSTATUS(THIS, "xHistInicializado", 5)
		    THIS.AddProperty("xHistInicializado", .F.)
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "InicializarFechasHistorialSecundario", 5)
		    THISFORMSET.InicializarFechasHistorialSecundario(ldDesde, ldHasta)
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "CargarHistorialSolicitudesFiltrado", 5)
		    THISFORMSET.CargarHistorialSolicitudesFiltrado(ldDesde, ldHasta)
		ENDIF
		
		THIS.xHistInicializado = .T.
		
		IF PEMSTATUS(THIS, "grid1", 5)
		    THIS.grid1.Refresh()
		ENDIF
		
		*-- Al abrir por primera vez, foco en FECHA HASTA
		IF PEMSTATUS(THIS, "txt_fechas_hist", 5)
		    TRY
		        THIS.txt_fechas_hist.SetFocus()
		    CATCH
		    ENDTRY
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "BloquearEdicionObservacionSecundario", 5)
		    THISFORMSET.BloquearEdicionObservacionSecundario()
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE secundario.Cmdcal1.Click
		*=========================================================
		* secundario.Cmdcal1.Click
		* Fecha Desde: luego pasa foco a Fecha Hasta
		*=========================================================
		LOCAL llOldAlways
		
		llOldAlways = THISFORM.AlwaysOnTop
		
		TRY
		    THISFORM.AlwaysOnTop = .F.
		CATCH
		ENDTRY
		
		DODEFAULT()
		
		TRY
		    THISFORM.AlwaysOnTop = llOldAlways
		CATCH
		ENDTRY
		
		IF PEMSTATUS(THISFORM, "txt_fechas_hist", 5)
		    TRY
		        THISFORM.txt_fechas_hist.SetFocus()
		    CATCH
		    ENDTRY
		ENDIF
		
		RETURN
		
		
	ENDPROC

	PROCEDURE secundario.Cmdcal2.Click
		*=========================================================
		* secundario.Cmdcal2.Click
		* Fecha Hasta: queda en Fecha Hasta
		* El filtro se aplica con Enter en txt_fechas_hist
		*=========================================================
		LOCAL llOldAlways
		
		llOldAlways = THISFORM.AlwaysOnTop
		
		TRY
		    THISFORM.AlwaysOnTop = .F.
		CATCH
		ENDTRY
		
		DODEFAULT()
		
		TRY
		    THISFORM.AlwaysOnTop = llOldAlways
		CATCH
		ENDTRY
		
		IF PEMSTATUS(THISFORM, "txt_fechas_hist", 5)
		    TRY
		        THISFORM.txt_fechas_hist.SetFocus()
		    CATCH
		    ENDTRY
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE secundario.cmd_cerrar.Click
		*=========================================================
		* secundario.cmd_imprimir.Click
		* Guarda observación si está en edición y luego imprime
		*=========================================================
		LOCAL lnSoliCodi
		LOCAL llOkGuardar
		
		lnSoliCodi  = 0
		llOkGuardar = .T.
		
		*-- Si está editando observaciones, guardar antes de imprimir
		IF PEMSTATUS(THISFORM, "xObsEditando", 5) AND THISFORM.xObsEditando
		    IF PEMSTATUS(THISFORMSET, "GuardarObservacionDesdeEditor", 5)
		        llOkGuardar = THISFORMSET.GuardarObservacionDesdeEditor()
		    ENDIF
		
		    IF !llOkGuardar
		        MESSAGEBOX("No se pudo guardar la observación. Se canceló la impresión.", 16, "Error")
		        RETURN .F.
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ObtenerSoliCodiSeleccionadoSecundario", 5)
		    lnSoliCodi = THISFORMSET.ObtenerSoliCodiSeleccionadoSecundario()
		ENDIF
		
		IF VARTYPE(lnSoliCodi) <> "N" OR lnSoliCodi <= 0
		    MESSAGEBOX("Debe seleccionar una solicitud válida en la grilla.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ImprimirSolicitudCompra", 5)
		    RETURN THISFORMSET.ImprimirSolicitudCompra(lnSoliCodi)
		ELSE
		    MESSAGEBOX("No existe el método ImprimirSolicitudCompra en el FormSet.", 16, "Error")
		    RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE secundario.cmd_cerrar.MouseLeave
		&& frm_alertas_stock.secundario.cmd_cerrar.mouseleave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		WITH THISFORM.cmd_cerrar
		    .BackColor = RGB(240,240,240)
		    .ForeColor = RGB(40,40,40)
		    .FontBold  = .F.
		    .FontSize  = 9
		ENDWITH
		
		
	ENDPROC


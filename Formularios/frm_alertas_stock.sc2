	PROCEDURE secundario.Command1.Click
		*=========================================================
		* secundario.btn_modificar.Click
		*=========================================================
		LOCAL lnSoliCodi
		
		IF !PEMSTATUS(THISFORM, "xSoliCodiActual", 5)
		    MESSAGEBOX("No hay solicitud seleccionada.", 48, "Aviso")
		    RETURN
		ENDIF
		
		lnSoliCodi = THISFORM.xSoliCodiActual
		
		IF VARTYPE(lnSoliCodi) <> "N" OR lnSoliCodi <= 0
		    MESSAGEBOX("Seleccione una solicitud del historial primero.", 48, "Aviso")
		    RETURN
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ModificarSolicitud", 5)
		    THISFORMSET.ModificarSolicitud(lnSoliCodi)
		ENDIF
	ENDPROC


		RETURN .T.
	ENDPROC

	PROCEDURE cuaterno.Init
		*=========================================================
		* cuaterno.Init
		* - Inicializa estado interno
		* - El form debe arrancar oculto
		* - Botones sin Default/Cancel para evitar cierre fantasma
		*=========================================================
		LPARAMETERS tcObsDefault
		
		LOCAL lcObsDefault
		
		lcObsDefault = ""
		
		IF !PEMSTATUS(THIS, "xCancelado", 5)
		    THIS.AddProperty("xCancelado", .T.)
		ENDIF
		
		IF !PEMSTATUS(THIS, "xValor", 5)
		    THIS.AddProperty("xValor", "")
		ENDIF
		
		DO CASE
		CASE VARTYPE(tcObsDefault) = "C"
		    lcObsDefault = ALLTRIM(tcObsDefault)
		
		CASE VARTYPE(tcObsDefault) = "M"
		    lcObsDefault = ALLTRIM(tcObsDefault)
		
		OTHERWISE
		    lcObsDefault = ""
		ENDCASE
		
		THIS.xCancelado = .T.
		THIS.xValor     = lcObsDefault
		
		IF PEMSTATUS(THIS, "edit1", 5)
		    THIS.edit1.Value    = lcObsDefault
		    THIS.edit1.Enabled  = .T.
		    THIS.edit1.ReadOnly = .F.
		ENDIF
		
		IF PEMSTATUS(THIS, "command1", 5)
		    THIS.command1.Default = .F.
		    THIS.command1.Cancel  = .F.
		ENDIF
		
		IF PEMSTATUS(THIS, "command2", 5)
		    THIS.command2.Default = .F.
		    THIS.command2.Cancel  = .F.
		ENDIF
		
		*---------------------------------------------------------
		* Importantísimo:
		* cuaterno NO debe quedar visible antes de Show(1)
		*---------------------------------------------------------
		THIS.Visible = .F.
		
		RETURN .T.
	ENDPROC

	PROCEDURE cuaterno.QueryUnload
		*=========================================================
		* cuaterno.QueryUnload
		* - Si el usuario intenta cerrar con X, se toma como cancelar
		* - No libera el form, solo deja marcado el estado
		*=========================================================
		LPARAMETERS nUnloadMode
		
		IF !PEMSTATUS(THIS, "xCancelado", 5)
		    THIS.AddProperty("xCancelado", .T.)
		ENDIF
		
		IF !PEMSTATUS(THIS, "xValor", 5)
		    THIS.AddProperty("xValor", "")
		ENDIF
		
		THIS.xCancelado = .T.
		THIS.xValor     = ""
		
		IF PEMSTATUS(THISFORMSET, "xObsCuaternoCancelado", 5)
		    THISFORMSET.xObsCuaternoCancelado = .T.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "xObsCuaternoValor", 5)
		    THISFORMSET.xObsCuaternoValor = ""
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "xObsCuaternoAbierto", 5)
		    THISFORMSET.xObsCuaternoAbierto = .F.
		ENDIF
		
		CLEAR TYPEAHEAD
		
		RETURN .T.
	ENDPROC

	PROCEDURE cuaterno.Unload
		*=========================================================
		* cuaterno.Unload
		* - No devuelve valores.
		* - El resultado se lee desde xValor / xCancelado.
		*=========================================================
		
		IF PEMSTATUS(THISFORMSET, "xObsCuaternoAbierto", 5)
		    THISFORMSET.xObsCuaternoAbierto = .F.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "xBloquearCierreCuaterno", 5)
		    THISFORMSET.xBloquearCierreCuaterno = .F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE principal.Activate
		*!*	*=========================================================
		*!*	* principal.Activate
		*!*	* Ya NO carga datos.
		*!*	* Solo asegura render visual final.
		*!*	*=========================================================
		*!*	IF !PEMSTATUS(THIS, "xLoaded", 5)
		*!*	    THIS.AddProperty("xLoaded", .F.)
		*!*	ENDIF
		
		*!*	IF !PEMSTATUS(THIS, "xIsLoading", 5)
		*!*	    THIS.AddProperty("xIsLoading", .F.)
		*!*	ENDIF
		
		*!*	IF THIS.xIsLoading
		*!*	    RETURN
		*!*	ENDIF
		
		*!*	IF THIS.xLoaded
		*!*	    IF PEMSTATUS(THIS, "grd_alerts", 5)
		*!*	        THIS.grd_alerts.Refresh()
		*!*	    ENDIF
		
		*!*	    IF PEMSTATUS(THIS, "grd_prov", 5)
		*!*	        THIS.grd_prov.Refresh()
		*!*	    ENDIF
		
		*!*	    IF PEMSTATUS(THIS, "grd_venta_compra", 5)
		*!*	        THIS.grd_venta_compra.Refresh()
		*!*	    ENDIF
		
		*!*	    THIS.Draw()
		*!*	ENDIF
		
		*!*	RETURN
	ENDPROC

	PROCEDURE principal.btn_add_manual.Click
		*=========================================================
		* btn_add_manual.Click
		*=========================================================
		LOCAL loTxtCodi, lvValue, lnArtCodi
		
		IF PEMSTATUS(THISFORM, "txt_add_codi", 5)
		    loTxtCodi = THISFORM.txt_add_codi
		ELSE
		    MESSAGEBOX("Error: No se encuentra 'txt_add_codi'.", 16, "Error")
		    RETURN
		ENDIF
		
		lvValue = loTxtCodi.Value
		lnArtCodi = IIF(VARTYPE(lvValue) = "C", VAL(ALLTRIM(lvValue)), lvValue)
		
		IF VARTYPE(lnArtCodi) <> "N" OR lnArtCodi <= 0
		    MESSAGEBOX("Ingrese un código numérico válido.", 48, "Aviso")
		    TRY
		        loTxtCodi.SetFocus()
		    CATCH
		    ENDTRY
		    RETURN
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "AgregarArticuloManual", 5)
		    IF THISFORMSET.AgregarArticuloManual(lnArtCodi, "")
		
		        *-- El método AgregarArticuloManual ya:
		        *-- 1) guarda el artículo
		        *-- 2) aplica el filtro SELECCIONADOS
		        *-- 3) reposiciona el cursor en el artículo nuevo
		        *-- 4) refresca grid / métricas / auxiliares
		
		        *-- Limpiar textbox para próxima carga manual
		        loTxtCodi.Value = 0
		
		        *-- Opcional: volver foco al textbox para seguir cargando rápido
		        TRY
		            loTxtCodi.SetFocus()
		        CATCH
		        ENDTRY
		    ENDIF
		ELSE
		    MESSAGEBOX("No existe el método AgregarArticuloManual en el FormSet.", 16, "Error")
		ENDIF
	ENDPROC


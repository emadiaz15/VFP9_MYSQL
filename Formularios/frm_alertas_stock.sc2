		*=========================================================
		RETURN
	ENDPROC

	PROCEDURE secundario.Grid1.AfterRowColChange
		*=========================================================
		* secundario.grid1.AfterRowColChange
		* - Actualiza solicitud actual
		* - Actualiza lbl_estado_oc con estado visual de OC
		* - Carga detalle de la solicitud seleccionada
		* - Respeta bloqueo temporal al cerrar modal desde grid2
		*=========================================================
		LPARAMETERS nColIndex
		
		IF PEMSTATUS(THISFORMSET, "xBloquearAfterGrid1", 5) AND ;
		   THISFORMSET.xBloquearAfterGrid1
		    RETURN .T.
		ENDIF
		
		LOCAL lnSoliCodi
		
		lnSoliCodi = 0
		
		*---------------------------------------------------------
		* BLOQUEO TEMPORAL:
		* Cuando se abre/cierra el modal de observación desde grid2,
		* NO debe recargar detalle ni mover foco.
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "xBloquearAfterGrid1", 5) AND ;
		   THISFORMSET.xBloquearAfterGrid1
		    RETURN .T.
		ENDIF
		
		*---------------------------------------------------------
		* Validar historial
		*---------------------------------------------------------
		IF !USED("cur_soli_hist") OR RECCOUNT("cur_soli_hist") <= 0
		
		    IF PEMSTATUS(THISFORM, "lbl_estado_oc", 5)
		        THISFORM.lbl_estado_oc.Caption   = "ESTADO: SIN DEFINIR"
		        THISFORM.lbl_estado_oc.ForeColor = RGB(220, 220, 220)
		        THISFORM.lbl_estado_oc.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(THISFORM, "xSoliCodiActual", 5)
		        THISFORM.xSoliCodiActual = 0
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		SELECT cur_soli_hist
		
		IF EOF("cur_soli_hist") OR BOF("cur_soli_hist")
		    GO TOP IN cur_soli_hist
		ENDIF
		
		IF EOF("cur_soli_hist") OR BOF("cur_soli_hist")
		
		    IF PEMSTATUS(THISFORM, "lbl_estado_oc", 5)
		        THISFORM.lbl_estado_oc.Caption   = "ESTADO: SIN DEFINIR"
		        THISFORM.lbl_estado_oc.ForeColor = RGB(220, 220, 220)
		        THISFORM.lbl_estado_oc.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(THISFORM, "xSoliCodiActual", 5)
		        THISFORM.xSoliCodiActual = 0
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Obtener solicitud actual
		*---------------------------------------------------------
		IF TYPE("cur_soli_hist.soli_codi") = "N"
		    lnSoliCodi = NVL(cur_soli_hist.soli_codi, 0)
		ELSE
		    lnSoliCodi = 0
		ENDIF
		
		IF lnSoliCodi <= 0
		
		    IF PEMSTATUS(THISFORM, "lbl_estado_oc", 5)
		        THISFORM.lbl_estado_oc.Caption   = "ESTADO: SIN DEFINIR"
		        THISFORM.lbl_estado_oc.ForeColor = RGB(220, 220, 220)
		        THISFORM.lbl_estado_oc.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(THISFORM, "xSoliCodiActual", 5)
		        THISFORM.xSoliCodiActual = 0
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Si seguimos en la misma solicitud, NO recargar detalle
		* Esto evita que al cerrar el modal se reconstruya grid2
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORM, "xSoliCodiActual", 5) AND ;
		   THISFORM.xSoliCodiActual = lnSoliCodi
		
		    IF PEMSTATUS(THISFORMSET, "ActualizarLabelEstadoOC", 5)
		        THISFORMSET.ActualizarLabelEstadoOC(lnSoliCodi)
		    ENDIF
		
		    RETURN .T.
		ENDIF
		
		*---------------------------------------------------------
		* Guardar solicitud actual solo si cambió realmente
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORM, "xSoliCodiActual", 5)
		    THISFORM.AddProperty("xSoliCodiActual", 0)
		ENDIF
		
		THISFORM.xSoliCodiActual = lnSoliCodi
		
		*---------------------------------------------------------
		* Cargar detalle SOLO si cambió la solicitud
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "CargarDetalleSolicitud", 5)
		    THISFORMSET.CargarDetalleSolicitud(lnSoliCodi)
		ENDIF
		
		*!*	*---------------------------------------------------------
		*!*	* Cargar detalle SOLO cuando el cambio es real del grid1
		*!*	* IMPORTANTE:
		*!*	* Si viene del modal, ya retornó arriba.
		*!*	*---------------------------------------------------------
		*!*	IF PEMSTATUS(THISFORMSET, "CargarDetalleSolicitud", 5)
		*!*	    THISFORMSET.CargarDetalleSolicitud(lnSoliCodi)
		*!*	ENDIF
		
		*---------------------------------------------------------
		* Actualizar label de estado OC
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ActualizarLabelEstadoOC", 5)
		
		    THISFORMSET.ActualizarLabelEstadoOC(lnSoliCodi)
		
		ELSE
		
		    * Fallback directo solamente si NO existe el método
		    IF PEMSTATUS(THISFORM, "lbl_estado_oc", 5)
		
		        IF TYPE("cur_soli_hist.estado") <> "U"
		            DO CASE
		            CASE UPPER(ALLTRIM(NVL(cur_soli_hist.estado, ""))) == "COMPRADO"
		                THISFORM.lbl_estado_oc.Caption   = "OC GENERADA"
		                THISFORM.lbl_estado_oc.ForeColor = RGB(80, 220, 120)
		
		            CASE UPPER(ALLTRIM(NVL(cur_soli_hist.estado, ""))) == "PENDIENTE"
		                THISFORM.lbl_estado_oc.Caption   = "OC SIN GENERAR"
		                THISFORM.lbl_estado_oc.ForeColor = RGB(255, 193, 7)
		
		            OTHERWISE
		                THISFORM.lbl_estado_oc.Caption   = "ESTADO: SIN DEFINIR"
		                THISFORM.lbl_estado_oc.ForeColor = RGB(220, 220, 220)
		            ENDCASE
		        ELSE
		            THISFORM.lbl_estado_oc.Caption   = "ESTADO: SIN DEFINIR"
		            THISFORM.lbl_estado_oc.ForeColor = RGB(220, 220, 220)
		        ENDIF
		
		        THISFORM.lbl_estado_oc.Refresh()
		    ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE secundario.Grid1.Click
		*=========================================================
		* secundario.grid1.Click
		*=========================================================
		LOCAL lnSoliCodi
		
		IF PEMSTATUS(THISFORMSET, "xBloquearAfterGrid1", 5) AND ;
		   THISFORMSET.xBloquearAfterGrid1
		    RETURN .T.
		ENDIF
		
		IF !USED("cur_soli_hist") OR RECCOUNT("cur_soli_hist") <= 0 OR EOF("cur_soli_hist")
		    RETURN .F.
		ENDIF
		
		SELECT cur_soli_hist
		
		lnSoliCodi = NVL(cur_soli_hist.soli_codi, 0)
		
		IF lnSoliCodi <= 0
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(THISFORM, "xSoliCodiActual", 5)
		    THISFORM.AddProperty("xSoliCodiActual", 0)
		ENDIF
		
		*---------------------------------------------------------
		* Si la solicitud no cambió, NO recargar detalle.
		*---------------------------------------------------------
		IF THISFORM.xSoliCodiActual = lnSoliCodi
		    RETURN .T.
		ENDIF
		
		THISFORM.xSoliCodiActual = lnSoliCodi
		
		IF PEMSTATUS(THISFORMSET, "CargarDetalleSolicitud", 5)
		    THISFORMSET.CargarDetalleSolicitud(lnSoliCodi)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE secundario.Grid1.DblClick
		*=========================================================
		* secundario.grid1.DblClick
		*=========================================================
		LOCAL lnSoliCodi
		
		IF !PEMSTATUS(THISFORM, "xSoliCodiActual", 5)
		    NODEFAULT
		    RETURN
		ENDIF
		
		lnSoliCodi = THISFORM.xSoliCodiActual
		
		IF VARTYPE(lnSoliCodi) <> "N" OR lnSoliCodi <= 0
		    MESSAGEBOX("No se pudo determinar la solicitud.", 48, "Aviso")
		    NODEFAULT
		    RETURN
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ModificarSolicitud", 5)
		    THISFORMSET.ModificarSolicitud(lnSoliCodi)
		ENDIF
		
		NODEFAULT
		RETURN
	ENDPROC

	PROCEDURE secundario.Grid1.KeyPress
		*=========================================================
		* secundario.grid1.KeyPress
		*=========================================================
		LPARAMETERS nKeyCode, nShiftAltCtrl
		LOCAL lnSoliCodi
		
		DO CASE
		    CASE INLIST(nKeyCode, 5, 24)  && Flecha arriba / abajo
		    CASE INLIST(nKeyCode, 18, 3)  && PgUp / PgDn
		    CASE INLIST(nKeyCode, 1, 6)   && Home / End
		    OTHERWISE
		        RETURN
		ENDCASE
		
		* Dejamos que VFP mueva primero el puntero
		NODEFAULT
		
		KEYBOARD CHR(nKeyCode)
		
		DOEVENTS
		
		IF !USED("cur_soli_hist") OR RECCOUNT("cur_soli_hist") <= 0 OR EOF("cur_soli_hist")
		    RETURN
		ENDIF
		
		lnSoliCodi = NVL(cur_soli_hist.soli_codi, 0)
		IF lnSoliCodi <= 0
		    RETURN
		ENDIF
		
		IF !PEMSTATUS(THISFORM, "xSoliCodiActual", 5)
		    THISFORM.AddProperty("xSoliCodiActual", 0)
		ENDIF
		
		*---------------------------------------------------------
		* Si la solicitud no cambió, NO recargar detalle
		*---------------------------------------------------------
		IF THISFORM.xSoliCodiActual = lnSoliCodi
		    IF PEMSTATUS(THISFORMSET, "ActualizarLabelEstadoOC", 5)
		        THISFORMSET.ActualizarLabelEstadoOC(lnSoliCodi)
		    ENDIF
		    RETURN
		ENDIF
		
		THISFORM.xSoliCodiActual = lnSoliCodi
		
		IF PEMSTATUS(THISFORMSET, "CargarDetalleSolicitud", 5)
		    THISFORMSET.CargarDetalleSolicitud(lnSoliCodi)
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarLabelEstadoOC", 5)
		    THISFORMSET.ActualizarLabelEstadoOC(lnSoliCodi)
		ENDIF
	ENDPROC

	PROCEDURE secundario.Grid2.ActivateCell
		*=========================================================
		* secundario.grid2.activateCell
		*=========================================================
		
		LPARAMETERS nRow, nCol
		
		IF USED("cur_soli_det") AND RECCOUNT("cur_soli_det") > 0
		    IF EOF("cur_soli_det")
		        GO BOTTOM IN cur_soli_det
		    ENDIF
		
		    IF BOF("cur_soli_det")
		        GO TOP IN cur_soli_det
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "SincronizarComboTransporte", 5)
		    THISFORMSET.SincronizarComboTransporte()
		ENDIF
		
		IF nCol = 8 AND PEMSTATUS(THISFORMSET, "AbrirComboTransporteGrid2", 5)
		    THISFORMSET.AbrirComboTransporteGrid2()
		ENDIF
		
		
	ENDPROC

	PROCEDURE secundario.Grid2.AfterRowColChange
		LPARAMETERS nColIndex
		
		IF PEMSTATUS(THISFORMSET, "Grid2AfterRowColChange", 5)
		    THISFORMSET.Grid2AfterRowColChange(nColIndex)
		ELSE
		    IF PEMSTATUS(THISFORMSET, "SincronizarComboTransporte", 5)
		        THISFORMSET.SincronizarComboTransporte()
		    ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE secundario.Grid2.Column9.Command1.Click
		*=========================================================
		* secundario.grid2.Column9.cmdObs.Click
		* Abre observación del artículo en modo lectura
		*=========================================================
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		NODEFAULT
		CLEAR TYPEAHEAD
		
		IF PEMSTATUS(THISFORMSET, "BtnObsArticuloClick", 5)
		    RETURN THISFORMSET.BtnObsArticuloClick(nButton, nShift, nXCoord, nYCoord)
		ENDIF
		
		RETURN .F.
	ENDPROC

	PROCEDURE secundario.Init
		*=========================================================
		* formset.secundario.Init
		*=========================================================
		THIS.Caption     = "Consulta de Solicitudes Históricas"
		THIS.Visible     = .F.
		THIS.WindowState = 0
		THIS.BackColor   = RGB(45,52,65)
		THIS.Themes      = .F.
		
		
		*-- El secundario no debe destruirse con la X.
		*-- Se oculta y se reutiliza.
		THIS.Closable = .T.
		
		IF !PEMSTATUS(THIS, "xCerrandoPorSistema", 5)
		    THIS.AddProperty("xCerrandoPorSistema", .F.)
		ELSE
		    THIS.xCerrandoPorSistema = .F.
		ENDIF
		
		
		IF !PEMSTATUS(THIS, "xObsEditando", 5)
		    THIS.AddProperty("xObsEditando", "")
		ENDIF
		
		IF !PEMSTATUS(THIS, "xObsOriginal", 5)
		    THIS.AddProperty("xObsOriginal", "")
		ENDIF
		
		
		IF !PEMSTATUS(THIS, "xSoliCodiActual", 5)
		    THIS.AddProperty("xSoliCodiActual", 0)
		ELSE
		    THIS.xSoliCodiActual = 0
		ENDIF
		
		IF !PEMSTATUS(THIS, "xHistFecDes", 5)
		    THIS.AddProperty("xHistFecDes", GOMONTH(DATE(), -12))
		ELSE
		    THIS.xHistFecDes = GOMONTH(DATE(), -12)
		ENDIF
		
		IF !PEMSTATUS(THIS, "xHistFecHas", 5)
		    THIS.AddProperty("xHistFecHas", DATE())
		ELSE
		    THIS.xHistFecHas = DATE()
		ENDIF
		
		IF USED("cur_soli_hist_sql")
		    USE IN cur_soli_hist_sql
		ENDIF
		
		IF USED("cur_soli_hist")
		    USE IN cur_soli_hist
		ENDIF
		
		CREATE CURSOR cur_soli_hist ( ;
		    soli_codi      I, ;
		    soli_fecha     D, ;
		    soli_fecha_txt C(8), ;
		    estado         C(20), ;
		    observaciones  M, ;
		    cant_items     I, ;
		    cant_total     N(9,2) )
		
		IF USED("cur_soli_det")
		    USE IN cur_soli_det
		ENDIF
		
		CREATE CURSOR cur_soli_det ( ;
		    ui_item      C(8),    ;
		    art_codi     I,       ;
		    art_desc     C(80),   ;
		    prov_codi    I,       ;
		    det_prov     C(80),   ;
		    det_moneda   C(3),    ;
		    artpro_costo N(15,4), ;
		    artpro_codi  I,       ;
		    cant_soli    N(9,3), ;
		    observacion  M,       ;
		    tran_codi    I, ;
		    tran_nomb    C(50) )
		    
		IF PEMSTATUS(THISFORMSET, "ConfigurarGridSolicitudes", 5)
		    THISFORMSET.ConfigurarGridSolicitudes()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ConfigurarGridDetalle", 5)
		    THISFORMSET.ConfigurarGridDetalle()
		ENDIF
		
		
		*-- Estado inicial: observación general bloqueada
		IF PEMSTATUS(THISFORMSET, "BloquearEdicionObservacionSecundario", 5)
		    THISFORMSET.BloquearEdicionObservacionSecundario("")
		ENDIF
		
		
		*---------------------------------------------------------
		* Flag global para evitar recargas al volver de modales
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "xBloquearAfterGrid1", 5)
		    THISFORMSET.AddProperty("xBloquearAfterGrid1", .F.)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE secundario.QueryUnload
		*=========================================================
		* secundario.QueryUnload
		* - Si el usuario cierra con X, solo oculta el form secundario
		* - Si el cierre viene por Release/QUIT/sistema, permite cerrar
		*=========================================================
		LPARAMETERS nCloseMode
		
		*---------------------------------------------------------
		* nCloseMode = 0  -> cierre manual con X
		* nCloseMode <> 0 -> cierre por código / QUIT / sistema
		*---------------------------------------------------------
		IF nCloseMode <> 0
		    RETURN .T.
		ENDIF
		
		IF PEMSTATUS(THIS, "xCerrandoPorSistema", 5)
		    IF THIS.xCerrandoPorSistema
		        RETURN .T.
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* Solo para la X del usuario: ocultar, no destruir
		*---------------------------------------------------------
		NODEFAULT
		
		TRY
		    THIS.LockScreen = .F.
		CATCH
		ENDTRY
		
		TRY
		    THIS.Enabled = .T.
		CATCH
		ENDTRY
		
		IF PEMSTATUS(THISFORMSET, "BloquearEdicionObservacionSecundario", 5)
		    THISFORMSET.BloquearEdicionObservacionSecundario()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "principal", 5)
		    TRY
		        THISFORMSET.principal.Enabled = .T.
		        THISFORMSET.principal.LockScreen = .F.
		        THISFORMSET.principal.Show()
		        THISFORMSET.principal.SetFocus()
		    CATCH
		    ENDTRY
		ENDIF
		
		THIS.Hide()
		
		RETURN .F.
		
	ENDPROC

	PROCEDURE secundario.txt_fecdes_hist.Click
		*=========================================================
		* && secundario.txt_fechas_hist.Click
		*=========================================================
		THIS.SetFocus
	ENDPROC

	PROCEDURE secundario.txt_fecdes_hist.KeyPress
		*=========================================================
		* secundario.txt_fecdes_hist.KeyPress
		* - Enter aplica filtro por fecha desde/hasta en Grid1
		*=========================================================
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = 13
		    NODEFAULT
		
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroHistorialSecundario", 5)
		        THISFORMSET.AplicarFiltroHistorialSecundario()
		    ENDIF
		    
		    thisform.txt_fechas_hist.SetFocus
		    
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE secundario.txt_fecdes_hist.LostFocus
		*=========================================================
		* secundario.txt_fecdes_hist.LostFocus
		* Solo valida fecha DESDE. No filtra.
		* No debe pisar la fecha elegida desde Cmdcal1.
		*=========================================================
		LOCAL ldDesde
		
		ldDesde = THIS.Value
		
		IF VARTYPE(ldDesde) <> "D" OR EMPTY(ldDesde)
		    ldDesde = GOMONTH(DATE(), -12)
		    THIS.Value = ldDesde
		ENDIF
		
		IF PEMSTATUS(THISFORM, "xHistFecDes", 5)
		    THISFORM.xHistFecDes = ldDesde
		ELSE
		    THISFORM.AddProperty("xHistFecDes", ldDesde)
		ENDIF
		
		THIS.Refresh()
		
		RETURN
		
	ENDPROC

	PROCEDURE secundario.txt_fechas_hist.Click
		*=========================================================
		* && secundario.txt_fechas_hist.Click
		*=========================================================
		THIS.SetFocus
	ENDPROC

	PROCEDURE secundario.txt_fechas_hist.GotFocus
		*=========================================================
		* secundario.txt_fechas_hist.GotFocus
		*=========================================================
		RETURN
		
	ENDPROC

	PROCEDURE secundario.txt_fechas_hist.KeyPress
		*=========================================================
		* secundario.txt_fechas_hist.KeyPress
		* Enter en Fecha Hasta aplica filtro por rango
		*=========================================================
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = 13
		    NODEFAULT
		
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroHistorialSecundario", 5)
		        THISFORMSET.AplicarFiltroHistorialSecundario()
		    ENDIF
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE secundario.txt_fechas_hist.LostFocus
		*=========================================================
		* secundario.txt_fechas_hist.LostFocus
		* Solo valida fecha HASTA. No filtra.
		*=========================================================
		LOCAL ldHasta
		
		ldHasta = THIS.Value
		
		IF VARTYPE(ldHasta) <> "D" OR EMPTY(ldHasta)
		    ldHasta = DATE()
		    THIS.Value = ldHasta
		ENDIF
		
		IF PEMSTATUS(THISFORM, "xHistFecHas", 5)
		    THISFORM.xHistFecHas = ldHasta
		ELSE
		    THISFORM.AddProperty("xHistFecHas", ldHasta)
		ENDIF
		
		THIS.Refresh()
		
		RETURN
		
	ENDPROC

	PROCEDURE secundario.txt_fechas_hist.Valid
		*=========================================================
		* secundario.txt_fechas_hist.Valid
		* No bloquear salida del control
		*=========================================================
		RETURN 1
		
	ENDPROC

	PROCEDURE secundario.Unload
		*=========================================================
		* secundario.Unload
		* Limpieza defensiva del formulario secundario
		*=========================================================
		TRY
		    THIS.LockScreen = .F.
		    THIS.Enabled = .T.
		CATCH
		ENDTRY
		
		TRY
		    IF PEMSTATUS(THIS, "grid1", 5)
		        THIS.grid1.RecordSource = ""
		        UNBINDEVENTS(THIS.grid1)
		    ENDIF
		CATCH
		ENDTRY
		
		TRY
		    IF PEMSTATUS(THIS, "grid2", 5)
		        THIS.grid2.RecordSource = ""
		        UNBINDEVENTS(THIS.grid2)
		    ENDIF
		CATCH
		ENDTRY
		
		TRY
		    IF PEMSTATUS(THISFORMSET, "principal", 5)
		        THISFORMSET.principal.Enabled = .T.
		        THISFORMSET.principal.LockScreen = .F.
		    ENDIF
		CATCH
		ENDTRY
		
		RETURN
	ENDPROC

	PROCEDURE terciario.Activate
		*=========================================================
		* terciario.Activate
		*=========================================================
		IF PEMSTATUS(THISFORMSET, "ActualizarHeaderTerciario", 5)
		    THISFORMSET.ActualizarHeaderTerciario()
		ENDIF
		RETURN
	ENDPROC

	PROCEDURE terciario.Command2.Click
		*=========================================================
		* terciario.cmd_cerrar.Click
		*=========================================================
		THISFORM.Visible = .F.
		THISFORMSET.principal.Enabled = .T.
		IF USED("cur_comprobantes")
		    USE IN cur_comprobantes
		ENDIF
	ENDPROC

	PROCEDURE terciario.Command2.MouseLeave
		&& frm_alertas_stock.terciario.command2.mouseleave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		WITH THISFORM.command2
		    .BackColor = RGB(240,240,240)
		    .ForeColor = RGB(40,40,40)
		    .FontBold  = .F.
		    .FontSize  = 9
		ENDWITH
		
	ENDPROC

	PROCEDURE terciario.Command2.MouseMove
		&& frm_alertas_stock.terciario.comman2.mousemove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		WITH THISFORM.command2
		    .BackColor = RGB(225,225,225)
		    .ForeColor = RGB(20,20,20)
		    .FontBold  = .T.
		    .FontSize  = 10
		ENDWITH
		
	ENDPROC

	PROCEDURE terciario.grd_ter_compras.AfterRowColChange
		*=========================================================
		* terciario.grd_ter_compras.AfterRowColChange
		* - Actualiza text1 con orden_codi del registro enfocado
		*=========================================================

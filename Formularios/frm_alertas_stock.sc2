	PROCEDURE terciario.grd_ter_compras.DblClick
		*=========================================================
		* principal.grd_venta_compra.DblClick
		*=========================================================
		IF PEMSTATUS(THISFORMSET, "AbrirRecepcionDesdeTerCompras", 5)
			pasrecep = 1
		    THISFORMSET.AbrirRecepcionDesdeTerCompras()
		ENDIF
		*!*	NODEFAULT
		RETURN
	ENDPROC

	PROCEDURE terciario.grd_ter_ventas.DblClick

	PROCEDURE secundario.Edit1.KeyPress
		*=========================================================
		* secundario.edit1.KeyPress
		* ESC cancela edición y restaura texto original
		*=========================================================
		LPARAMETERS nKeyCode, nShiftAltCtrl
		LOCAL lcOriginal
		
		IF nKeyCode = 27
		    IF PEMSTATUS(THISFORM, "xObsEditando", 5) AND THISFORM.xObsEditando
		        lcOriginal = ""
		        IF PEMSTATUS(THISFORM, "xObsOriginal", 5)
		            lcOriginal = THISFORM.xObsOriginal
		        ENDIF
		
		        THIS.Value = lcOriginal
		        THISFORM.xObsEditando = .F.
		        THIS.ReadOnly  = .T.
		        THIS.Enabled   = .F.
		        THIS.BackColor = RGB(245,245,245)
		        THIS.Refresh()
		
		        IF PEMSTATUS(THISFORM, "command3", 5)
		            THISFORM.command3.Caption = "EDITAR"
		            THISFORM.command3.Enabled = .T.
		            THISFORM.command3.Refresh()
		        ENDIF
		
		        NODEFAULT
		        RETURN
		    ENDIF
		ENDIF
		
		RETURN
	ENDPROC


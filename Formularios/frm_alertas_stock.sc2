	PROCEDURE abrircombotransportegrid2
		*=========================================================
		* FormSet.AbrirComboTransporteGrid2
		* Fuerza apertura del combo transporte en grid2
		*=========================================================
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		LOCAL loSec, loGrid, loCombo
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN .F.
		ENDIF
		
		loSec = THISFORMSET.secundario
		
		IF VARTYPE(loSec) <> "O" OR !PEMSTATUS(loSec, "grid2", 5)
		    RETURN .F.
		ENDIF
		
		loGrid = loSec.grid2
		
		IF VARTYPE(loGrid) <> "O" OR loGrid.ColumnCount < 8
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loGrid.Columns(8), "cboTransporte", 5)
		    RETURN .F.
		ENDIF
		
		loCombo = loGrid.Columns(8).cboTransporte
		
		IF VARTYPE(loCombo) <> "O"
		    RETURN .F.
		ENDIF
		
		IF USED("cur_transportes") AND RECCOUNT("cur_transportes") > 0
		    TRY
		        loCombo.DropDown()
		    CATCH
		    ENDTRY
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE abrircuaternoobservaciones
		*=========================================================
		* FormSet.AbrirCuaternoObservaciones
		* - Usa el form cuaterno YA contenido en el FormSet
		* - Lo muestra MODAL correctamente
		* - NO debe estar visible antes de Show(1)
		* - Evita ESC residual del grid/menu contextual
		* - Devuelve resultado en:
		*     THISFORMSET.xObsCuaternoValor
		*     THISFORMSET.xObsCuaternoCancelado
		*=========================================================
		LPARAMETERS tcObsDefault
		
		LOCAL loCuaterno, lcObsDefault
		
		loCuaterno   = .NULL.
		lcObsDefault = ""
		
		*---------------------------------------------------------
		* 1. Validar existencia del form cuaterno
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "cuaterno", 5)
		    MESSAGEBOX("No existe el formulario cuaterno dentro del FormSet.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		loCuaterno = THISFORMSET.cuaterno
		
		IF VARTYPE(loCuaterno) <> "O"
		    MESSAGEBOX("El formulario cuaterno no está disponible.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 2. Asegurar propiedades globales del FormSet
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "xObsCuaternoValor", 5)
		    THISFORMSET.AddProperty("xObsCuaternoValor", "")
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xObsCuaternoCancelado", 5)
		    THISFORMSET.AddProperty("xObsCuaternoCancelado", .T.)
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xObsCuaternoAbierto", 5)
		    THISFORMSET.AddProperty("xObsCuaternoAbierto", .F.)
		ENDIF
		
		*---------------------------------------------------------
		* 3. Asegurar propiedades internas del cuaterno
		*---------------------------------------------------------
		IF !PEMSTATUS(loCuaterno, "xValor", 5)
		    loCuaterno.AddProperty("xValor", "")
		ENDIF
		
		IF !PEMSTATUS(loCuaterno, "xCancelado", 5)
		    loCuaterno.AddProperty("xCancelado", .T.)
		ENDIF
		
		*---------------------------------------------------------
		* 4. Normalizar observación inicial
		*---------------------------------------------------------
		DO CASE
		CASE VARTYPE(tcObsDefault) = "C"
		    lcObsDefault = ALLTRIM(tcObsDefault)
		
		CASE VARTYPE(tcObsDefault) = "M"
		    lcObsDefault = ALLTRIM(tcObsDefault)
		
		OTHERWISE
		    lcObsDefault = ""
		ENDCASE
		
		*---------------------------------------------------------
		* 5. Reset de estado modal
		*---------------------------------------------------------
		loCuaterno.xValor     = lcObsDefault
		loCuaterno.xCancelado = .T.
		
		THISFORMSET.xObsCuaternoValor     = lcObsDefault
		THISFORMSET.xObsCuaternoCancelado = .T.
		THISFORMSET.xObsCuaternoAbierto   = .T.
		
		*---------------------------------------------------------
		* 6. Preparar controles internos
		*---------------------------------------------------------
		IF PEMSTATUS(loCuaterno, "edit1", 5)
		    loCuaterno.edit1.Enabled   = .T.
		    loCuaterno.edit1.ReadOnly  = .F.
		    loCuaterno.edit1.Value     = lcObsDefault
		    loCuaterno.edit1.BackColor = RGB(255,255,255)
		    loCuaterno.edit1.ForeColor = RGB(0,0,0)
		ENDIF
		
		IF PEMSTATUS(loCuaterno, "command1", 5)
		    loCuaterno.command1.Enabled = .T.
		    loCuaterno.command1.Visible = .T.
		    loCuaterno.command1.Default = .F.
		    loCuaterno.command1.Cancel  = .F.
		ENDIF
		
		IF PEMSTATUS(loCuaterno, "command2", 5)
		    loCuaterno.command2.Enabled = .T.
		    loCuaterno.command2.Visible = .T.
		    loCuaterno.command2.Default = .F.
		    loCuaterno.command2.Cancel  = .F.
		ENDIF
		*---------------------------------------------------------
		* 7. IMPORTANTE:
		*    El form NO puede estar visible antes de Show(1)
		*    porque VFP no permite cambiar modalidad de un form visible.
		*---------------------------------------------------------
		IF loCuaterno.Visible
		    loCuaterno.Hide()
		ENDIF
		
		loCuaterno.Visible = .F.
		
		*---------------------------------------------------------
		* 8. Preparar visual/modal
		*---------------------------------------------------------
		loCuaterno.AlwaysOnTop = .T.
		loCuaterno.AutoCenter  = .T.
		
		*---------------------------------------------------------
		* 9. Limpiar teclado residual antes de abrir
		*    Esto evita ESC fantasma desde grid/menu contextual.
		*---------------------------------------------------------
		CLEAR TYPEAHEAD
		
		
		
		*---------------------------------------------------------
		* 10. Protección anti-cierre instantáneo también para botón Ver
		*---------------------------------------------------------
		IF !PEMSTATUS(loCuaterno, "xOpenSeconds", 5)
		    loCuaterno.AddProperty("xOpenSeconds", 0)
		ENDIF
		
		loCuaterno.xOpenSeconds = SECONDS()
		
		CLEAR TYPEAHEAD
		
		loCuaterno.Show(1)
		
		CLEAR TYPEAHEAD
		
		*---------------------------------------------------------
		* 12. Recuperar resultado del modal
		*---------------------------------------------------------
		IF PEMSTATUS(loCuaterno, "xCancelado", 5) AND loCuaterno.xCancelado
		    THISFORMSET.xObsCuaternoValor     = ""
		    THISFORMSET.xObsCuaternoCancelado = .T.
		ELSE
		    IF PEMSTATUS(loCuaterno, "xValor", 5)
		        THISFORMSET.xObsCuaternoValor = ALLTRIM(NVL(loCuaterno.xValor, ""))
		    ELSE
		        THISFORMSET.xObsCuaternoValor = ""
		    ENDIF
		
		    THISFORMSET.xObsCuaternoCancelado = .F.
		ENDIF
		
		*---------------------------------------------------------
		* 13. Cierre seguro de estado
		*---------------------------------------------------------
		THISFORMSET.xObsCuaternoAbierto = .F.
		
		TRY
		    loCuaterno.AlwaysOnTop = .F.
		
		    IF loCuaterno.Visible
		        loCuaterno.Hide()
		    ENDIF
		CATCH
		ENDTRY
		
		RETURN .T.
	ENDPROC

	PROCEDURE abrirmodalobservacionaislado
		*=========================================================
		* FormSet.AbrirModalObservacionAislado
		* Modal runtime independiente del form cuaterno embebido.
		*
		* tcModo:
		*   "LECTURA"  = solo lectura
		*   "OBS_ART"  = editar observación de artículo
		*   "OBS_SOLI" = observación general solicitud
		*
		* Retorna:
		*   .T. si acepta/guarda
		*   .F. si cancela/cierra
		*
		* Devuelve:
		*   THISFORMSET.xObsModalValor
		*   THISFORMSET.xObsModalCancelado
		*=========================================================
		LPARAMETERS tcModo, tcTitulo, tcLabel, tcValorInicial, tlReadOnly
		
		LOCAL loDlg
		LOCAL lcModo, lcTitulo, lcLabel, lcValor
		LOCAL llReadOnly, llOk
		
		loDlg     = .NULL.
		lcModo    = ""
		lcTitulo  = ""
		lcLabel   = ""
		lcValor   = ""
		llReadOnly = .F.
		llOk      = .F.
		
		*---------------------------------------------------------
		* 1. Normalizar parámetros
		*---------------------------------------------------------
		IF VARTYPE(tcModo) = "C"
		    lcModo = UPPER(ALLTRIM(tcModo))
		ENDIF
		
		IF VARTYPE(tcTitulo) = "C" AND !EMPTY(ALLTRIM(tcTitulo))
		    lcTitulo = ALLTRIM(tcTitulo)
		ELSE
		    lcTitulo = "Observación"
		ENDIF
		
		IF VARTYPE(tcLabel) = "C"
		    lcLabel = ALLTRIM(tcLabel)
		ENDIF
		
		DO CASE
		CASE VARTYPE(tcValorInicial) = "C"
		    lcValor = ALLTRIM(tcValorInicial)
		
		CASE VARTYPE(tcValorInicial) = "M"
		    lcValor = ALLTRIM(tcValorInicial)
		
		OTHERWISE
		    lcValor = ""
		ENDCASE
		
		IF VARTYPE(tlReadOnly) = "L"
		    llReadOnly = tlReadOnly
		ELSE
		    llReadOnly = .F.
		ENDIF
		
		*---------------------------------------------------------
		* 2. Propiedades del FormSet para recuperar resultado
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "xObsModalForm", 5)
		    THISFORMSET.AddProperty("xObsModalForm", .NULL.)
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xObsModalModo", 5)
		    THISFORMSET.AddProperty("xObsModalModo", "")
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xObsModalValor", 5)
		    THISFORMSET.AddProperty("xObsModalValor", "")
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xObsModalCancelado", 5)
		    THISFORMSET.AddProperty("xObsModalCancelado", .T.)
		ENDIF
		
		THISFORMSET.xObsModalForm      = .NULL.
		THISFORMSET.xObsModalModo      = lcModo
		THISFORMSET.xObsModalValor     = lcValor
		THISFORMSET.xObsModalCancelado = .T.
		
		*---------------------------------------------------------
		* 3. Crear form runtime totalmente aislado
		* IMPORTANTE:
		* NO SETEAR ShowWindow. Es read-only en runtime.
		*---------------------------------------------------------
		loDlg = CREATEOBJECT("Form")
		
		ADDPROPERTY(loDlg, "cValor", lcValor)
		ADDPROPERTY(loDlg, "lCancelado", .T.)
		
		WITH loDlg
		    .Caption     = lcTitulo
		    .Width       = 400
		    .Height      = 250
		    .AutoCenter  = .T.
		    .BorderStyle = 0
		    .MaxButton   = .F.
		    .MinButton   = .F.
		    .Closable    = .F.
		    .WindowType  = 1
		    .BackColor   = RGB(45,52,65)
		    .KeyPreview  = .F.
		    .Visible     = .F.
		ENDWITH
		
		*---------------------------------------------------------
		* 4. Label informativo
		*---------------------------------------------------------
		loDlg.AddObject("lblInfo", "Label")
		
		WITH loDlg.lblInfo
		    .Left      = 12
		    .Top       = 8
		    .Width     = 490
		    .Height    = 35
		    .Caption   = lcLabel
		    .WordWrap  = .T.
		    .BackStyle = 0
		    .ForeColor = RGB(255,255,255)
		    .FontBold  = .T.
		    .Visible   = .T.
		ENDWITH
		
		*---------------------------------------------------------
		* 5. EditBox
		*---------------------------------------------------------
		loDlg.AddObject("edtObs", "EditBox")
		
		WITH loDlg.edtObs
		    .Left      = 5
		    .Top       = 40
		    .Width     = 390
		    .Height    = 150
		    .Value     = lcValor
		    .ReadOnly  = llReadOnly
		    .Enabled   = .T.
		    .BackColor = RGB(255,255,255)
		    .ForeColor = RGB(0,0,0)
		    .Visible   = .T.
		ENDWITH
		
		*---------------------------------------------------------
		* 6. Botón Guardar / Aceptar
		*---------------------------------------------------------
		loDlg.AddObject("cmdOk", "CommandButton")
		
		WITH loDlg.cmdOk
		    .Left      = 300
		    .Top       = 200
		    .Width     = 90
		    .Height    = 28
		    .Caption   = "Guardar"
		    .Visible   = !llReadOnly
		    .Enabled   = !llReadOnly
		    .Default   = .F.
		    .Cancel    = .F.
		    .TabStop   = .T.
		ENDWITH
		
		*---------------------------------------------------------
		* 7. Botón Cancelar / Cerrar
		*---------------------------------------------------------
		loDlg.AddObject("cmdCancel", "CommandButton")
		
		WITH loDlg.cmdCancel
		    .Left      = 200
		    .Top       = 200
		    .Width     = 90
		    .Height    = 28
		    .Caption   = IIF(llReadOnly, "Cerrar", "Cancelar")
		    .Visible   = .T.
		    .Enabled   = .T.
		    .Default   = .F.
		    .Cancel    = .F.
		    .TabStop   = .T.
		ENDWITH
		
		THISFORMSET.xObsModalForm = loDlg
		
		*---------------------------------------------------------
		* 8. Bind de botones
		*---------------------------------------------------------
		TRY
		    UNBINDEVENTS(loDlg.cmdOk)
		CATCH
		ENDTRY
		
		TRY
		    UNBINDEVENTS(loDlg.cmdCancel)
		CATCH
		ENDTRY
		
		BINDEVENT(loDlg.cmdOk,     "Click", THISFORMSET, "ObsModalGuardar")
		BINDEVENT(loDlg.cmdCancel, "Click", THISFORMSET, "ObsModalCancelar")
		
		*---------------------------------------------------------
		* 9. Abrir modal
		*---------------------------------------------------------
		CLEAR TYPEAHEAD
		
		loDlg.Show(1)
		
		CLEAR TYPEAHEAD
		
		*---------------------------------------------------------
		* 10. Recuperar resultado
		*---------------------------------------------------------
		IF VARTYPE(loDlg) = "O"
		    IF loDlg.lCancelado
		        THISFORMSET.xObsModalValor     = ""
		        THISFORMSET.xObsModalCancelado = .T.
		        llOk = .F.
		    ELSE
		        THISFORMSET.xObsModalValor     = ALLTRIM(NVL(loDlg.cValor, ""))
		        THISFORMSET.xObsModalCancelado = .F.
		        llOk = .T.
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 11. Limpieza
		*---------------------------------------------------------
		TRY
		    UNBINDEVENTS(loDlg.cmdOk)
		CATCH
		ENDTRY
		
		TRY
		    UNBINDEVENTS(loDlg.cmdCancel)
		CATCH
		ENDTRY
		
		THISFORMSET.xObsModalForm = .NULL.
		
		TRY
		    loDlg.Release()
		CATCH
		ENDTRY
		
		RETURN llOk
	ENDPROC

	PROCEDURE abrirmovimientoventacompra
		*=========================================================
		* FormSet.AbrirMovimientoVentaCompra
		* Abre remload o recepload según la fila seleccionada
		*=========================================================
		LPARAMETERS nColIndex
		
		LOCAL lcOrigen, lnCodi, lcFormPath
		
		IF !USED("cur_venta_compra")
		    RETURN .F.
		ENDIF
		
		SELECT cur_venta_compra
		IF EOF() OR BOF()
		    RETURN .F.
		ENDIF
		
		*-- Ajustar estos nombres a tu cursor real
		lcOrigen = UPPER(ALLTRIM(NVL(cur_venta_compra.origen, "")))
		lnCodi   = NVL(cur_venta_compra.comp_codi, 0)
		
		IF EMPTY(lcOrigen) OR lnCodi <= 0
		    MESSAGEBOX("No se pudo identificar el documento seleccionado.", 48, "Consulta")
		    RETURN .F.
		ENDIF
		
		DO CASE
		CASE lcOrigen == "V"
		    *-- Remito de venta
		    DO FORM remload WITH lnCodi
		
		CASE lcOrigen == "C"
		    *-- Recepción de compra
		    DO FORM recepload WITH lnCodi
		
		OTHERWISE
		    MESSAGEBOX("El tipo de movimiento no es válido: " + lcOrigen, 48, "Consulta")
		    RETURN .F.
		ENDCASE
		
		RETURN .T.
	ENDPROC

	PROCEDURE abrirpedidodesdegrid1
		*=========================================================
		* FormSet.AbrirPedidoDesdeGrid1
		* Abre el form del pedido según el ped_codi seleccionado
		*=========================================================
		LPARAMETERS nColIndex
		
		LOCAL loFrm
		LOCAL lnPedCodi, lnCond
		LOCAL lnConn, lnRet, lcSQL
		LOCAL laErr[1], lcMsg
		
		loFrm = THISFORMSET.principal
		
		IF VARTYPE(loFrm) # "O"
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_cli_art")
		    RETURN .F.
		ENDIF
		
		SELECT cur_cli_art
		IF EOF() OR BOF()
		    RETURN .F.
		ENDIF
		
		lnPedCodi = IIF(TYPE("cur_cli_art.ped_codi") = "N", cur_cli_art.ped_codi, 0)
		
		IF lnPedCodi <= 0
		    MESSAGEBOX("No se pudo identificar el pedido seleccionado.", 48, "Consulta")
		    RETURN .F.
		ENDIF
		
		lnCond = 0
		
		IF USED("cur_ped_open")
		    USE IN cur_ped_open
		ENDIF
		
		TEXT TO lcSQL NOSHOW
		SELECT
		    IFNULL(c.cond_codi,0) AS cond_codi
		FROM pedidos p
		LEFT JOIN clientes c
		    ON c.cli_codi = p.cli_codi
		WHERE p.ped_codi = ?lnPedCodi
		LIMIT 1
		ENDTEXT
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_ped_open")
		Desconectar_DB(lnConn)
		
		IF lnRet < 0 OR !USED("cur_ped_open") OR RECCOUNT("cur_ped_open") = 0
		    IF AERROR(laErr) > 0
		        lcMsg = "No se pudo abrir el pedido." + CHR(13) + CHR(13) + ;
		                TRANSFORM(laErr[1,3])
		    ELSE
		        lcMsg = "No se pudo obtener la condición del pedido."
		    ENDIF
		
		    IF USED("cur_ped_open")
		        USE IN cur_ped_open
		    ENDIF
		
		    MESSAGEBOX(lcMsg, 16, "Error")
		    RETURN .F.
		ENDIF
		
		SELECT cur_ped_open
		lnCond = IIF(TYPE("cur_ped_open.cond_codi") = "N", cur_ped_open.cond_codi, 0)
		USE IN cur_ped_open
		
		*-- Cambiá conspedicli por condpedi si ese es el nombre real del form
		DO FORM conspedicli WITH lnPedCodi, lnCond
		
		RETURN .T.
	ENDPROC

	PROCEDURE abrirrecepciondesdetercompras
		*=========================================================
		* FormSet.AbrirRecepcionDesdeTerCompras
		*=========================================================
		LOCAL lnRecepCodi, lnCondCodi, lnProvCodi
		LOCAL lnConn
		LOCAL laErr[1]
		
		IF !USED("cur_ter_compras") OR EOF("cur_ter_compras")
		    RETURN .F.
		ENDIF
		
		SELECT cur_ter_compras
		lnRecepCodi = VAL(TRANSFORM(NVL(cur_ter_compras.recep_codi, 0)))
		lnCondCodi  = VAL(TRANSFORM(NVL(cur_ter_compras.cond_codi, 0)))
		lnProvCodi  = VAL(TRANSFORM(NVL(cur_ter_compras.prov_codi, 0)))
		
		IF lnRecepCodi <= 0
		    MESSAGEBOX("Este movimiento no corresponde a una recepción consultable.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		IF lnProvCodi <= 0
		    MESSAGEBOX("No se pudo determinar el proveedor asociado a la recepción.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		IF USED("cur_prov")
		    USE IN cur_prov
		ENDIF
		
		lnConn = 0
		IF TYPE("_screen.cn") <> "U"
		    lnConn = Conectar_DB(_screen.cn)
		ENDIF
		
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No hay conexión MySQL disponible.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF SQLEXEC(lnConn, "CALL usp_buscarprov(?lnProvCodi)", "cur_prov") < 0
		    AERROR(laErr)
		    Desconectar_DB(lnConn)
		    MESSAGEBOX("No se pudo cargar el proveedor asociado." + CHR(13) + laErr[2], 16, "MySQL")
		    RETURN .F.
		ENDIF
		
		Desconectar_DB(lnConn)
		
		IF !USED("cur_prov") OR RECCOUNT("cur_prov") <= 0
		    MESSAGEBOX("No se encontró el proveedor asociado a la recepción.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		SELECT cur_prov
		GO TOP
		
		DO FORM consrecep WITH lnRecepCodi, lnCondCodi
		
		RETURN .T.
	ENDPROC

	PROCEDURE abrirremitodesdeterventas
		*=========================================================
		* FormSet.AbrirRemitoDesdeTerVentas
		*=========================================================
		LOCAL lnRemCodi, lnCondCodi
		
		IF !USED("cur_ter_ventas") OR EOF("cur_ter_ventas")
		    RETURN .F.
		ENDIF
		
		SELECT cur_ter_ventas
		lnRemCodi  = VAL(TRANSFORM(NVL(cur_ter_ventas.rem_codi, 0)))
		lnCondCodi = VAL(TRANSFORM(NVL(cur_ter_ventas.cond_codi, 0)))
		
		IF lnRemCodi <= 0
		    MESSAGEBOX("No se pudo determinar el código del remito.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		DO FORM consremito WITH lnRemCodi, lnCondCodi
		
		RETURN .T.
	ENDPROC

	PROCEDURE abrirsecundariohistorial
		*=========================================================
		* FormSet.AbrirSecundarioHistorial
		* Abre el historial con fechas precargadas
		*=========================================================
		LPARAMETERS tdDesde, tdHasta
		
		LOCAL loConsulta
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN .F.
		ENDIF
		
		loConsulta = THISFORMSET.secundario
		IF VARTYPE(loConsulta) <> "O"
		    RETURN .F.
		ENDIF
		
		IF VARTYPE(tdDesde) <> "D" OR EMPTY(tdDesde)
		    tdDesde = GOMONTH(DATE(), -12)
		ENDIF
		
		IF VARTYPE(tdHasta) <> "D" OR EMPTY(tdHasta)
		    tdHasta = DATE()
		ENDIF
		
		IF tdDesde > tdHasta
		    tdHasta = tdDesde
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "InicializarFechasHistorialSecundario", 5)
		    THISFORMSET.InicializarFechasHistorialSecundario(tdDesde, tdHasta)
		ENDIF
		
		loConsulta.Visible = .T.
		loConsulta.SetFocus()
		
		IF PEMSTATUS(THISFORMSET, "CargarHistorialSolicitudesFiltrado", 5)
		    THISFORMSET.CargarHistorialSolicitudesFiltrado(tdDesde, tdHasta)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE abrirterciariodesdegridvc
		*=========================================================
		* FormSet.AbrirTerciarioDesdeGridVC
		*=========================================================
		LOCAL loPrincipal
		LOCAL lnArtCodi, lcArtDesc, lcPeriodo
		
		IF TYPE("THISFORMSET.principal.Name") = "U"
		    RETURN .F.
		ENDIF
		
		loPrincipal = THISFORMSET.principal
		IF VARTYPE(loPrincipal) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_vc_months") OR RECCOUNT("cur_vc_months") = 0 OR EOF("cur_vc_months")
		    MESSAGEBOX("No hay período seleccionado en la grilla de ventas/compras.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		SELECT cur_vc_months
		lcPeriodo = ALLTRIM(NVL(cur_vc_months.mes, ""))
		
		IF EMPTY(lcPeriodo)
		    MESSAGEBOX("No se pudo determinar el período seleccionado.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* El artículo debe salir de una propiedad estable del principal
		*---------------------------------------------------------
		lnArtCodi = 0
		lcArtDesc = ""
		
		IF PEMSTATUS(loPrincipal, "xCurArt", 5)
		    lnArtCodi = VAL(TRANSFORM(NVL(loPrincipal.xCurArt, 0)))
		ENDIF
		
		IF PEMSTATUS(loPrincipal, "xCurArtDesc", 5)
		    lcArtDesc = ALLTRIM(NVL(loPrincipal.xCurArtDesc, ""))
		ELSE
		    IF USED("cur_alerts")
		        SELECT cur_alerts
		        IF !EOF("cur_alerts")
		            lcArtDesc = ALLTRIM(NVL(cur_alerts.art_desc, ""))
		        ENDIF
		    ENDIF
		ENDIF
		
		IF lnArtCodi <= 0
		    MESSAGEBOX("No se pudo determinar el artículo actual.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xTerArtCodi", 5)
		    THISFORMSET.AddProperty("xTerArtCodi", 0)
		ENDIF
		IF !PEMSTATUS(THISFORMSET, "xTerArtDesc", 5)
		    THISFORMSET.AddProperty("xTerArtDesc", "")
		ENDIF
		IF !PEMSTATUS(THISFORMSET, "xTerPeriodo", 5)
		    THISFORMSET.AddProperty("xTerPeriodo", "")
		ENDIF
		
		THISFORMSET.xTerArtCodi = lnArtCodi
		THISFORMSET.xTerArtDesc = lcArtDesc
		THISFORMSET.xTerPeriodo = lcPeriodo
		
		IF !PEMSTATUS(THISFORMSET, "terciario", 5)
		    MESSAGEBOX("No existe el formulario 'terciario' dentro del FormSet.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "CargarTerciarioMovimientosArticulo", 5)
		    IF !THISFORMSET.CargarTerciarioMovimientosArticulo()
		        RETURN .F.
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarHeaderTerciario", 5)
		    THISFORMSET.ActualizarHeaderTerciario()
		ENDIF
		
		THISFORMSET.principal.Enabled = .F.
		THISFORMSET.terciario.Refresh()
		THISFORMSET.terciario.Show(1)
		
		RETURN .T.
	ENDPROC

	PROCEDURE actualizarcolorrankcuralerts
		*=========================================================
		* FormSet.ActualizarColorRankCurAlerts
		* - Mayor valor = color mas oscuro / mayor criticidad
		*=========================================================
		LOCAL lnArea, lnPos, lnMin, lnPct, lnPedProv, lnStock
		LOCAL lnRank
		
		IF !USED("cur_alerts")
		    RETURN .F.
		ENDIF
		
		lnArea = SELECT()
		
		SELECT cur_alerts
		GO TOP
		
		SCAN
		    lnPos     = VAL(TRANSFORM(NVL(cur_alerts.posicion, 0)))
		    lnMin     = VAL(TRANSFORM(NVL(cur_alerts.art_stmin, 0)))
		    lnPct     = VAL(TRANSFORM(NVL(cur_alerts.art_pct_alerta, 30)))
		    lnPedProv = VAL(TRANSFORM(NVL(cur_alerts.pedprov, 0)))
		    lnStock   = VAL(TRANSFORM(NVL(cur_alerts.art_stock, 0)))
		
		    lnRank = 0
		
		    DO CASE
		    CASE lnPos <= 0 AND lnMin > 0
		        lnRank = 500
		
		    CASE lnMin > 0 AND lnPos < (lnMin * 0.25)
		        lnRank = 450
		
		    CASE lnMin > 0 AND lnPos < lnMin
		        lnRank = 400
		
		    CASE lnMin > 0 AND lnPos <= (lnMin + (lnMin * (lnPct / 100)))
		        lnRank = 300
		
		    CASE lnPedProv > 0
		        lnRank = 200
		
		    CASE lnStock > 0
		        lnRank = 100
		
		    OTHERWISE
		        lnRank = 0
		    ENDCASE
		
		    REPLACE ui_color_rank WITH lnRank IN cur_alerts
		ENDSCAN
		
		SELECT (lnArea)
		RETURN .T.
	ENDPROC

	PROCEDURE actualizardependenciasarticuloactual
		*=========================================================
		* FormSet.ActualizarDependenciasArticuloActual
		* Todo lo que depende del artículo actual
		* - grd_prov
		* - último cliente
		* - clientes del artículo
		*=========================================================
		LOCAL loFrm
		LOCAL lnArtActual, lnConnLC, lcNombCliente
		
		loFrm = THISFORMSET.principal
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0 OR EOF("cur_alerts")
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xComboCargadoArt", 5)
		    loFrm.AddProperty("xComboCargadoArt", 0)
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xUltCliArt", 5)
		    loFrm.AddProperty("xUltCliArt", 0)
		ENDIF
		
		lnArtActual = IIF(TYPE("cur_alerts.art_codi")="N", cur_alerts.art_codi, 0)
		IF lnArtActual <= 0
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 1) Cargar grd_prov solo si cambió el artículo
		*---------------------------------------------------------
		IF loFrm.xComboCargadoArt <> lnArtActual
		    loFrm.xComboCargadoArt = lnArtActual
		
		    IF PEMSTATUS(THISFORMSET, "CargarGrdProv", 5)
		        THISFORMSET.CargarGrdProv()
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 2) Último cliente solo si cambió el artículo
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "info_ult_cliente", 5)
		    IF lnArtActual <> loFrm.xUltCliArt
		        loFrm.xUltCliArt = lnArtActual
		        lcNombCliente = ""
		
		        lnConnLC = Conectar_DB(_screen.cn)
		        IF VARTYPE(lnConnLC) = "N" AND lnConnLC > 0
		            IF USED("cur_ult_cli")
		                USE IN cur_ult_cli
		            ENDIF
		
		            SQLEXEC(lnConnLC, ;
		                "SELECT MIN(c.cli_nomb) AS cli_nomb "    + ;
		                "FROM pedidos_articulos pa "             + ;
		                "INNER JOIN pedidos p2 "                 + ;
		                "    ON p2.ped_codi = pa.ped_codi "      + ;
		                "INNER JOIN clientes c "                 + ;
		                "    ON c.cli_codi = p2.cli_codi "       + ;
		                "WHERE pa.art_codi = ?lnArtActual "      + ;
		                "  AND p2.finalizado = 0", ;
		                "cur_ult_cli")
		
		            IF USED("cur_ult_cli") AND RECCOUNT("cur_ult_cli") > 0
		                lcNombCliente = ALLTRIM(NVL(cur_ult_cli.cli_nomb, ""))
		                USE IN cur_ult_cli
		            ENDIF
		
		            Desconectar_DB(lnConnLC)
		        ENDIF
		
		        IF EMPTY(lcNombCliente)
		            loFrm.info_ult_cliente.Caption = "Sin pedidos pendientes"
		        ELSE
		            loFrm.info_ult_cliente.Caption = "Últ. cliente: " + lcNombCliente
		        ENDIF
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 3) Grid clientes del artículo
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "CargarClientesArticuloSeleccionado", 5)
		    THISFORMSET.CargarClientesArticuloSeleccionado()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE actualizarefectogrid
		*=========================================================
		* FormSet.ActualizarEfectoGrid
		* SOLO efecto visual puro del grid
		* - NO carga datos del artículo
		* - NO consulta MySQL
		*=========================================================
		LPARAMETERS nParam1
		
		LOCAL loFrm, loConsulta
		LOCAL lnTop, lnHeader, lcSizeExpr, lnC
		LOCAL lnBack, lnFore
		LOCAL lnNuevoRec, lnShapeWidth
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF !USED("cur_alerts")
		    RETURN
		ENDIF
		
		IF !PEMSTATUS(loFrm, "grd_alerts", 5)
		    RETURN
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xCurRec", 5)
		    loFrm.AddProperty("xCurRec", 0)
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xCurArt", 5)
		    loFrm.AddProperty("xCurArt", 0)
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xPrevCurRec", 5)
		    loFrm.AddProperty("xPrevCurRec", 0)
		ENDIF
		
		lnNuevoRec = 0
		
		IF RECCOUNT("cur_alerts") > 0 AND !EOF("cur_alerts") AND !BOF("cur_alerts")
		    lnNuevoRec = RECNO("cur_alerts")
		
		    IF TYPE("cur_alerts.art_codi") = "N"
		        loFrm.xCurArt = cur_alerts.art_codi
		    ENDIF
		ENDIF
		
		WITH loFrm.grd_alerts
		
		    *-- DynamicFontSize / highlight solo si cambió la fila
			IF lnNuevoRec <> loFrm.xPrevCurRec
		        loFrm.xCurRec     = lnNuevoRec
		        loFrm.xPrevCurRec = lnNuevoRec
		        lcSizeExpr = "IIF(RECNO('cur_alerts')=" + TRANSFORM(INT(lnNuevoRec)) + ",10,9)"
		        
		        
		*!*			&&  -- Antes:
		*!*			FOR lnC = 1 TO .ColumnCount
		*!*			    IF lnC <> 13
		*!*			        TRY
		*!*			            .Columns(lnC).DynamicFontSize = lcSizeExpr
		*!*			        CATCH
		*!*			        ENDTRY
		*!*			    ENDIF
		*!*			NEXT lnC
		
				&&  -- Después (solo actualiza si realmente cambió la fila):
				
		*!*			IF lnNuevoRec <> loFrm.xPrevCurRec
		*!*			    FOR lnC = 1 TO MIN(.ColumnCount, 12)
					loFrm.LockScreen = .T.
					FOR lnC = 1 TO MIN(.ColumnCount, 12)
					
				        TRY
				            .Columns(lnC).DynamicFontSize = lcSizeExpr
				        CATCH
				        ENDTRY
		*!*			    NEXT lnC
		*!*			ENDIF
		
					    NEXT lnC
						loFrm.LockScreen = .F.
		    ENDIF
		    
		    
		    *-- Siempre actualizar highlight del registro con foco
		    *-- (los colores pueden cambiar sin que cambie el numero de registro)
		    IF PEMSTATUS(THISFORMSET, "DynBack_Alerta", 5)
		        lnBack = THISFORMSET.DynBack_Alerta()
		        IF VARTYPE(lnBack) = "N"
		            .HighlightBackColor = lnBack
		        ENDIF
		    ENDIF
		    IF PEMSTATUS(THISFORMSET, "DynFore_Alerta", 5)
		        lnFore = THISFORMSET.DynFore_Alerta()
		        IF VARTYPE(lnFore) = "N"
		            .HighlightForeColor = lnFore
		        ENDIF
		    ENDIF
		
		    *-- Shape indicador de fila
		    IF .RelativeRow > 0
		        lnHeader = IIF(.HeaderHeight > 0, .HeaderHeight, 0)
		        lnTop    = .Top + lnHeader + ((.RelativeRow - 1) * .RowHeight)
		
				IF PEMSTATUS(loFrm, "shpSelRow", 5)
				    lnShapeWidth = 0
		
				    IF .ColumnCount >= 13
				        lnShapeWidth = ;
				            .Columns(1).Width + .Columns(2).Width + .Columns(3).Width + ;
				            .Columns(4).Width + .Columns(5).Width + .Columns(6).Width + ;
				            .Columns(7).Width + .Columns(8).Width + .Columns(9).Width + ;
				            .Columns(10).Width + .Columns(11).Width + .Columns(12).Width + ;
				            .Columns(13).Width
				    ELSE
				        lnShapeWidth = .Width - 2
				    ENDIF
		
					loFrm.shpSelRow.Top     = lnTop
					loFrm.shpSelRow.Left    = .Left
					loFrm.shpSelRow.Width   = lnShapeWidth
					loFrm.shpSelRow.Height  = .RowHeight
					loFrm.shpSelRow.Visible = .T.
					loFrm.shpSelRow.ZOrder(0)
				ENDIF
		    ELSE
		        IF PEMSTATUS(loFrm, "shpSelRow", 5)
		            loFrm.shpSelRow.Visible = .F.
		        ENDIF
		    ENDIF
		
		ENDWITH
		
		*-- Restaurar alias principal
		IF USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0 AND !EOF("cur_alerts")
		    SELECT cur_alerts
		ENDIF
		
		*-- Refrescar textos de métricas
		IF PEMSTATUS(loFrm, "Text4", 5)
		    loFrm.Text4.Refresh()
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text11", 5)
		    loFrm.Text11.Refresh()
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text12", 5)
		    loFrm.Text12.Refresh()
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text13", 5)
		    loFrm.Text13.Refresh()
		ENDIF
		
		*-- Color checkbox selección col 13
		IF USED("cur_alerts") AND !EOF("cur_alerts") AND !BOF("cur_alerts")
		    IF TYPE("cur_alerts.col_back") = "N" AND TYPE("cur_alerts.col_fore") = "N"
		        LOCAL loG, lnBack_, lnFore_
		        loG     = loFrm.grd_alerts
		        lnBack_ = cur_alerts.col_back
		        lnFore_ = cur_alerts.col_fore
		
		        IF PEMSTATUS(loG.Columns(13), "chkSel", 5)
		            loG.Columns(13).chkSel.BackColor = lnBack_
		            loG.Columns(13).chkSel.ForeColor = lnFore_
		        ENDIF
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarEstadoDetalle", 5)
		    THISFORMSET.ActualizarEstadoDetalle()
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE actualizarefectogridscroll
		*=========================================================
		* FormSet.ActualizarEfectoGridScroll
		* Version liviana para scroll — solo mueve el shape
		*=========================================================
		LPARAMETERS nDirection
		LOCAL loFrm, lnTop, lnHeader, lnShapeWidth
		
		loFrm = THISFORMSET.principal
		
		IF !PEMSTATUS(loFrm, "grd_alerts", 5) OR !PEMSTATUS(loFrm, "shpSelRow", 5)
		    RETURN
		ENDIF
		
		WITH loFrm.grd_alerts
		    IF .RelativeRow > 0
		        lnHeader = IIF(.HeaderHeight > 0, .HeaderHeight, 0)
		        lnTop    = .Top + lnHeader + ((.RelativeRow - 1) * .RowHeight)
				lnShapeWidth = 0
		
				IF .ColumnCount >= 13
				    lnShapeWidth = ;
				        .Columns(1).Width + .Columns(2).Width + .Columns(3).Width + ;
				        .Columns(4).Width + .Columns(5).Width + .Columns(6).Width + ;
				        .Columns(7).Width + .Columns(8).Width + .Columns(9).Width + ;
				        .Columns(10).Width + .Columns(11).Width + .Columns(12).Width + ;
				        .Columns(13).Width
				ELSE
				    lnShapeWidth = .Width - 2
				ENDIF
		
				loFrm.shpSelRow.Top     = lnTop
				loFrm.shpSelRow.Left    = .Left
				loFrm.shpSelRow.Width   = lnShapeWidth
				loFrm.shpSelRow.Height  = .RowHeight
				loFrm.shpSelRow.Visible = .T.
				loFrm.shpSelRow.ZOrder(0)
		    ELSE
		        loFrm.shpSelRow.Visible = .F.
		    ENDIF
		ENDWITH
		
		RETURN
		
	ENDPROC

	PROCEDURE actualizarefectogridvc
		*=========================================================
		* FormSet.ActualizarEfectoGridVC
		*=========================================================
		LPARAMETERS nParam1
		LOCAL loFrm, loConsulta
		LOCAL loGrid, lnTop, lnHeader
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF !USED("cur_vc_months")
		    IF PEMSTATUS(loFrm, "shpSelVC", 5)
		        loFrm.shpSelVC.Visible = .F.
		    ENDIF
		    RETURN
		ENDIF
		
		IF !PEMSTATUS(loFrm, "grd_venta_compra", 5)
		    RETURN
		ENDIF
		
		loGrid = loFrm.grd_venta_compra
		
		*-- Cache del registro actual
		IF !PEMSTATUS(loFrm, "xCurRecVC", 5)
		    loFrm.AddProperty("xCurRecVC", 0)
		ENDIF
		
		IF RECCOUNT("cur_vc_months") > 0 AND !EOF("cur_vc_months")
		    loFrm.xCurRecVC = RECNO("cur_vc_months")
		ELSE
		    loFrm.xCurRecVC = 0
		ENDIF
		
		*-- Posicionar shape
		IF PEMSTATUS(loFrm, "shpSelVC", 5)
		    IF loGrid.RelativeRow > 0 AND RECCOUNT("cur_vc_months") > 0
		        lnHeader = IIF(loGrid.HeaderHeight > 0, loGrid.HeaderHeight, 0)
		        lnTop    = loGrid.Top + lnHeader + ((loGrid.RelativeRow - 1) * loGrid.RowHeight)
		        WITH loFrm.shpSelVC
		            .Top     = lnTop
		            .Left    = loGrid.Left + 1
		            .Width   = loGrid.Width - 2
		            .Height  = loGrid.RowHeight
		            .Visible = .T.
		            .ZOrder(0)
		        ENDWITH
		    ELSE
		        loFrm.shpSelVC.Visible = .F.
		    ENDIF
		ENDIF
		
		*-- Refresco liviano
		IF loGrid.Visible
		    loGrid.Refresh()
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE actualizarestadodetalle
		*=========================================================
		* FormSet.ActualizarEstadoDetalle
		* - Deshabilita/habilita Text4, Text11, Text12, Text13
		*   según si hay artículo válido en cur_alerts
		* - Mantiene SIEMPRE el mismo BackColor
		*=========================================================
		LOCAL loFrm, llSinSel, lnBackColor, lnT, loCtrl
		LOCAL laTexts[4]
		
		loFrm = THISFORMSET.principal
		IF VARTYPE(loFrm) <> "O"
		    RETURN
		ENDIF
		
		lnBackColor = RGB(40, 44, 52)
		llSinSel = .T.
		
		IF USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0 AND !EOF("cur_alerts")
		    IF TYPE("cur_alerts.art_codi") = "N" AND cur_alerts.art_codi > 0
		        llSinSel = .F.
		    ENDIF
		ENDIF
		
		laTexts[1] = "Text4"
		laTexts[2] = "Text11"
		laTexts[3] = "Text12"
		laTexts[4] = "Text13"
		
		FOR lnT = 1 TO 4
		    IF PEMSTATUS(loFrm, laTexts[lnT], 5)
		        TRY
		            loCtrl = EVALUATE("loFrm." + laTexts[lnT])
		
		            IF VARTYPE(loCtrl) = "O"
		                *-- El fondo NUNCA cambia
		                loCtrl.BackColor = lnBackColor
		
		                IF llSinSel
		                    loCtrl.Enabled   = .F.
		                    loCtrl.ForeColor = RGB(120, 120, 120)
		                ELSE
		                    loCtrl.Enabled   = .T.
		                    loCtrl.ForeColor = RGB(220, 220, 220)
		                ENDIF
		
		                loCtrl.Refresh()
		            ENDIF
		        CATCH
		        ENDTRY
		    ENDIF
		NEXT lnT
		
		RETURN
	ENDPROC

	PROCEDURE actualizarformulariocompleto
		*=========================================================
		* FormSet.ActualizarFormularioCompleto
		* Refresca todo el formulario sin cerrarlo:
		* - recarga base
		* - reaplica filtro actual
		* - conserva combos, fechas y selección visual
		*=========================================================
		LOCAL loFrm
		LOCAL lcFiltro, lcCombo2Mode
		LOCAL lnRubCodi, lnProvCodi, lnCombo2Valor
		LOCAL lnMesesCob, lnMesesMue
		LOCAL ldFecDes, ldFecHas
		LOCAL lnArtActual, lnRecActual
		LOCAL llOk
		
		loFrm = THISFORMSET.principal
		
		IF VARTYPE(loFrm) <> "O"
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 1) Asegurar propiedades de estado
		*---------------------------------------------------------
		IF !PEMSTATUS(loFrm, "xFiltroActual", 5)
		    loFrm.AddProperty("xFiltroActual", "TODOS")
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xCombo2Mode", 5)
		    loFrm.AddProperty("xCombo2Mode", "")
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xCombo2ValorActual", 5)
		    loFrm.AddProperty("xCombo2ValorActual", 0)
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xRubCodiActual", 5)
		    loFrm.AddProperty("xRubCodiActual", 0)
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xProveedorCodiActual", 5)
		    loFrm.AddProperty("xProveedorCodiActual", 0)
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xMesesCobertura", 5)
		    loFrm.AddProperty("xMesesCobertura", 3)
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xMesesMuestra", 5)
		    loFrm.AddProperty("xMesesMuestra", 6)
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xPedFecDes", 5)
		    loFrm.AddProperty("xPedFecDes", DATE())
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xPedFecHas", 5)
		    loFrm.AddProperty("xPedFecHas", DATE())
		ENDIF
		
		*---------------------------------------------------------
		* 2) Guardar estado actual UI
		*---------------------------------------------------------
		lcFiltro      = UPPER(ALLTRIM(NVL(loFrm.xFiltroActual, "TODOS")))
		lcCombo2Mode  = UPPER(ALLTRIM(NVL(loFrm.xCombo2Mode, "")))
		lnRubCodi     = NVL(loFrm.xRubCodiActual, 0)
		lnProvCodi    = NVL(loFrm.xProveedorCodiActual, 0)
		lnCombo2Valor = NVL(loFrm.xCombo2ValorActual, 0)
		lnMesesCob    = NVL(loFrm.xMesesCobertura, 3)
		lnMesesMue    = NVL(loFrm.xMesesMuestra, 6)
		ldFecDes      = NVL(loFrm.xPedFecDes, DATE())
		ldFecHas      = NVL(loFrm.xPedFecHas, DATE())
		
		IF PEMSTATUS(loFrm, "combo1", 5)
		    IF !EMPTY(ALLTRIM(loFrm.combo1.DisplayValue))
		        lcFiltro = UPPER(ALLTRIM(loFrm.combo1.DisplayValue))
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(loFrm, "combo2", 5)
		    IF TYPE("loFrm.combo2.Value") $ "NI"
		        lnCombo2Valor = loFrm.combo2.Value
		    ELSE
		        lnCombo2Valor = VAL(TRANSFORM(loFrm.combo2.Value))
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(loFrm, "combo3", 5)
		    lnMesesCob = VAL(TRANSFORM(loFrm.combo3.Value))
		ENDIF
		
		IF PEMSTATUS(loFrm, "combo4", 5)
		    lnMesesMue = VAL(TRANSFORM(loFrm.combo4.Value))
		ENDIF
		
		IF PEMSTATUS(loFrm, "txt_fecdes", 5) AND VARTYPE(loFrm.txt_fecdes.Value)="D"
		    ldFecDes = loFrm.txt_fecdes.Value
		ENDIF
		
		IF PEMSTATUS(loFrm, "txt_fechas", 5) AND VARTYPE(loFrm.txt_fechas.Value)="D"
		    ldFecHas = loFrm.txt_fechas.Value
		ENDIF
		
		*---------------------------------------------------------
		* 3) Guardar posición actual
		*---------------------------------------------------------
		lnArtActual = 0
		lnRecActual = 0
		
		IF USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0
		    SELECT cur_alerts
		    IF !EOF()
		        lnRecActual = RECNO("cur_alerts")
		        lnArtActual = IIF(TYPE("cur_alerts.art_codi")="N", cur_alerts.art_codi, 0)
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 4) Congelar UI
		*---------------------------------------------------------
		loFrm.LockScreen = .T.
		WAIT WINDOW "Actualizando información..." NOWAIT
		
		*---------------------------------------------------------
		* 5) Recalcular métricas si corresponde
		*---------------------------------------------------------
		loFrm.xMesesCobertura = lnMesesCob
		loFrm.xMesesMuestra   = lnMesesMue
		
		IF PEMSTATUS(loFrm, "combo3", 5)
		    loFrm.combo3.Value = lnMesesCob
		ENDIF
		
		IF PEMSTATUS(loFrm, "combo4", 5)
		    loFrm.combo4.Value = lnMesesMue
		ENDIF
		
		*-- Refrescar base completa desde MySQL
		llOk = .T.
		IF PEMSTATUS(THISFORMSET, "CargarAlertasStockFull", 5)
		    llOk = THISFORMSET.CargarAlertasStockFull()
		ENDIF
		
		IF !llOk
		    loFrm.LockScreen = .F.
		    WAIT CLEAR
		    MESSAGEBOX("No se pudo recargar la base del formulario.", 16, "Actualizar")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 6) Restaurar fechas PEDIDOS
		*---------------------------------------------------------
		loFrm.xPedFecDes = ldFecDes
		loFrm.xPedFecHas = ldFecHas
		
		IF PEMSTATUS(loFrm, "txt_fecdes", 5)
		    loFrm.txt_fecdes.Value = ldFecDes
		ENDIF
		
		IF PEMSTATUS(loFrm, "txt_fechas", 5)
		    loFrm.txt_fechas.Value = ldFecHas
		ENDIF
		
		*---------------------------------------------------------
		* 7) Restaurar combos / estado filtro
		*---------------------------------------------------------
		loFrm.xFiltroActual      = lcFiltro
		loFrm.xCombo2Mode        = lcCombo2Mode
		loFrm.xCombo2ValorActual = lnCombo2Valor
		loFrm.xRubCodiActual     = lnRubCodi
		loFrm.xProveedorCodiActual = lnProvCodi
		
		IF PEMSTATUS(loFrm, "combo1", 5)
		    loFrm.combo1.DisplayValue = lcFiltro
		ENDIF
		
		*---------------------------------------------------------
		* 8) Recargar combo2 según filtro actual
		*---------------------------------------------------------
		DO CASE
		CASE lcFiltro == "RUBROS"
		    loFrm.xCombo2Mode = "RUBROS"
		    IF PEMSTATUS(THISFORMSET, "CargarComboRubros", 5)
		        THISFORMSET.CargarComboRubros()
		    ENDIF
		
		CASE lcFiltro == "PROVEEDOR"
		    loFrm.xCombo2Mode = "PROVEEDOR"
		    IF PEMSTATUS(THISFORMSET, "CargarComboProveedores", 5)
		        THISFORMSET.CargarComboProveedores()
		    ENDIF
		ENDCASE
		
		*---------------------------------------------------------
		* 9) Reaplicar filtro activo
		*---------------------------------------------------------
		DO CASE
		CASE lcFiltro == "RUBROS"
		    IF lnCombo2Valor <= 0
		        lnCombo2Valor = lnRubCodi
		    ENDIF
		
		    loFrm.xRubCodiActual     = lnCombo2Valor
		    loFrm.xCombo2ValorActual = lnCombo2Valor
		
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		        llOk = THISFORMSET.AplicarFiltroLocal("RUBROS", lnCombo2Valor)
		    ENDIF
		
		CASE lcFiltro == "PROVEEDOR"
		    IF lnCombo2Valor <= 0
		        lnCombo2Valor = lnProvCodi
		    ENDIF
		
		    loFrm.xProveedorCodiActual = lnCombo2Valor
		    loFrm.xCombo2ValorActual   = lnCombo2Valor
		
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroProveedor", 5)
		        llOk = THISFORMSET.AplicarFiltroProveedor(lnCombo2Valor)
		    ELSE
		        IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		            llOk = THISFORMSET.AplicarFiltroLocal("PROVEEDOR", 0)
		        ENDIF
		    ENDIF
		
		CASE lcFiltro == "PEDIDOS"
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		        llOk = THISFORMSET.AplicarFiltroLocal("PEDIDOS", 0)
		    ENDIF
		
		CASE lcFiltro == "SELECCIONADOS"
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		        llOk = THISFORMSET.AplicarFiltroLocal("SELECCIONADOS", 0)
		    ENDIF
		
		OTHERWISE
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		        llOk = THISFORMSET.AplicarFiltroLocal(lcFiltro, 0)
		    ENDIF
		ENDCASE
		
		*---------------------------------------------------------
		* 10) Restaurar combo2 visual
		*---------------------------------------------------------
		IF lcFiltro $ "RUBROS,PROVEEDOR" AND PEMSTATUS(loFrm, "combo2", 5)
		    TRY
		        loFrm.combo2.Value = lnCombo2Valor
		    CATCH
		    ENDTRY
		ENDIF
		
		*---------------------------------------------------------
		* 11) Sincronización final
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "SincronizarPedido", 5)
		    THISFORMSET.SincronizarPedido()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		    THISFORMSET.SincronizarBotonMasivo()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		    THISFORMSET.RefrescarGrid()
		ELSE
		    IF PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.Refresh()
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 12) Restaurar posición
		*---------------------------------------------------------
		IF USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0
		    SELECT cur_alerts
		
		    IF lnArtActual > 0
		        LOCATE FOR art_codi = lnArtActual
		    ENDIF
		
		    IF !FOUND() AND BETWEEN(lnRecActual, 1, RECCOUNT("cur_alerts"))
		        GO lnRecActual
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xCurArt", 5)
		        loFrm.xCurArt = IIF(TYPE("cur_alerts.art_codi")="N", cur_alerts.art_codi, 0)
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xCurRec", 5)
		        loFrm.xCurRec = RECNO("cur_alerts")
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		    THISFORMSET.ActualizarEfectoGrid(0)
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "RefreshVentaCompraGrid", 5)
		    THISFORMSET.RefreshVentaCompraGrid()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "BindMetricTexts", 5)
		    THISFORMSET.BindMetricTexts()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarInfoFiltro", 5)
		    THISFORMSET.ActualizarInfoFiltro()
		ENDIF
		
		loFrm.LockScreen = .F.
		loFrm.Refresh()
		loFrm.Draw()
		WAIT CLEAR
		
		RETURN .T.
	ENDPROC

	PROCEDURE actualizarheaderterciario
		*=========================================================
		* FormSet.ActualizarHeaderTerciario
		*=========================================================
		LOCAL loTer
		LOCAL lcPeriodo, lcArtDesc, lcContexto
		LOCAL lnArtCodi
		
		IF !PEMSTATUS(THISFORMSET, "terciario", 5)
		    RETURN .F.
		ENDIF
		
		loTer = THISFORMSET.terciario
		IF VARTYPE(loTer) <> "O"
		    RETURN .F.
		ENDIF
		
		lnArtCodi = VAL(TRANSFORM(NVL(THISFORMSET.xTerArtCodi, 0)))
		lcArtDesc = ALLTRIM(NVL(THISFORMSET.xTerArtDesc, ""))
		lcPeriodo = ALLTRIM(NVL(THISFORMSET.xTerPeriodo, ""))
		
		lcContexto = "Movimientos del artículo | Período: " + lcPeriodo
		
		IF PEMSTATUS(loTer, "lbl_contexto", 5)
		    loTer.lbl_contexto.Caption = lcContexto
		ENDIF
		
		IF PEMSTATUS(loTer, "Label8", 5)
		    loTer.Label8.Caption = TRANSFORM(lnArtCodi)
		ENDIF
		
		IF PEMSTATUS(loTer, "Label1", 5)
		    loTer.Label1.Caption = lcArtDesc
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE actualizarinfofiltro
		*=========================================================
		* FormSet.ActualizarInfoFiltro
		*=========================================================
		LOCAL loFrm
		LOCAL lcDesc, lcFiltro, lcRef
		LOCAL lcCombo2Modo, lcCombo2Texto, lcCombo2Norm
		LOCAL lnCombo2Valor
		
		loFrm = THISFORMSET.principal
		
		lcDesc        = ""
		lcFiltro      = ""
		lcRef         = ""
		lcCombo2Modo  = ""
		lcCombo2Texto = ""
		lcCombo2Norm  = ""
		lnCombo2Valor = 0
		
		IF VARTYPE(loFrm) <> "O"
		    RETURN
		ENDIF
		
		*---------------------------------------------------------
		* Leer combo1
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "combo1", 5)
		    lcFiltro = ALLTRIM(NVL(loFrm.combo1.DisplayValue, ""))
		ENDIF
		
		*---------------------------------------------------------
		* Leer modo interno combo2
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "xCombo2Mode", 5)
		    lcCombo2Modo = ALLTRIM(NVL(loFrm.xCombo2Mode, ""))
		ENDIF
		
		*----------------------------------------------------------*
		IF PEMSTATUS(loFrm, "combo2", 5)
		
		    IF loFrm.combo2.RowSourceType = 2 AND ;
		       !EMPTY(ALLTRIM(loFrm.combo2.RowSource)) AND ;
		       !USED(ALLTRIM(loFrm.combo2.RowSource))
		
		        WITH loFrm.combo2
		            .Visible       = .F.
		            .RowSourceType = 0
		            .RowSource     = ""
		            .ListIndex     = 0
		            .Value         = 0
		        ENDWITH
		
		    ELSE
		        lcCombo2Texto = ALLTRIM(NVL(loFrm.combo2.DisplayValue, ""))
		
		        IF TYPE("loFrm.combo2.Value") $ "NI"
		            lnCombo2Valor = loFrm.combo2.Value
		        ELSE
		            lnCombo2Valor = VAL(TRANSFORM(loFrm.combo2.Value))
		        ENDIF
		    ENDIF
		ENDIF
		*-----------------------------------------------------------*
		
		
		
		*---------------------------------------------------------
		* Leer combo2 visible + valor
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "combo2", 5)
		    lcCombo2Texto = ALLTRIM(NVL(loFrm.combo2.DisplayValue, ""))
		
		    IF TYPE("loFrm.combo2.Value") $ "NI"
		        lnCombo2Valor = loFrm.combo2.Value
		    ELSE
		        lnCombo2Valor = VAL(TRANSFORM(loFrm.combo2.Value))
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* Normalizar tildes / mayúsculas
		*---------------------------------------------------------
		lcFiltro      = UPPER(lcFiltro)
		lcCombo2Modo  = UPPER(lcCombo2Modo)
		lcCombo2Norm  = UPPER(lcCombo2Texto)
		
		lcFiltro      = STRTRAN(lcFiltro, "Á", "A")
		lcFiltro      = STRTRAN(lcFiltro, "É", "E")
		lcFiltro      = STRTRAN(lcFiltro, "Í", "I")
		lcFiltro      = STRTRAN(lcFiltro, "Ó", "O")
		lcFiltro      = STRTRAN(lcFiltro, "Ú", "U")
		
		lcCombo2Modo  = STRTRAN(lcCombo2Modo, "Á", "A")
		lcCombo2Modo  = STRTRAN(lcCombo2Modo, "É", "E")
		lcCombo2Modo  = STRTRAN(lcCombo2Modo, "Í", "I")
		lcCombo2Modo  = STRTRAN(lcCombo2Modo, "Ó", "O")
		lcCombo2Modo  = STRTRAN(lcCombo2Modo, "Ú", "U")
		
		lcCombo2Norm  = STRTRAN(lcCombo2Norm, "Á", "A")
		lcCombo2Norm  = STRTRAN(lcCombo2Norm, "É", "E")
		lcCombo2Norm  = STRTRAN(lcCombo2Norm, "Í", "I")
		lcCombo2Norm  = STRTRAN(lcCombo2Norm, "Ó", "O")
		lcCombo2Norm  = STRTRAN(lcCombo2Norm, "Ú", "U")
		
		*---------------------------------------------------------
		* Resolver descripción principal + referencia
		*---------------------------------------------------------
		DO CASE
		    CASE lcFiltro == "SELECCIONADOS"
		        lcDesc = "Artículos que ya están en tu lista de solicitud de compra actual."
		
		    CASE lcFiltro == "PEDIDOS"
		        lcDesc = "Artículos que se encuentran en pedidos. Filtra por fechas."
		        IF PEMSTATUS(loFrm, "txt_fecdes", 5) AND PEMSTATUS(loFrm, "txt_fechas", 5)
		            IF VARTYPE(loFrm.txt_fecdes.Value) = "D" AND VARTYPE(loFrm.txt_fechas.Value) = "D"
		                lcRef = "Referencia: desde " + DTOC(loFrm.txt_fecdes.Value) + ;
		                        " hasta " + DTOC(loFrm.txt_fechas.Value) + "."
		            ENDIF
		        ENDIF
		
		    CASE lcFiltro == "POSICION < (POS.MINIMO + % ALERTA)"
		        lcDesc = "Posición < (Mínimo + % alerta)."
		
		    CASE lcFiltro == "SUGERIDO > 0"
		        lcDesc = "Artículos para los que el sistema ya calculó que conviene comprar."
		
		    CASE lcFiltro == "POSICION < POSICION MIN"
		        lcDesc = "Artículos donde la Posición (Stock + Compras - Pedidos) es menor a la posición mínima."
		
		    CASE lcFiltro == "STOCK (-)"
		        lcDesc = "Artículos con stock negativo."
		
		    CASE lcFiltro == "POSICION (-)"
		        lcDesc = "Ni sumando el stock + compras se cubren los pedidos de clientes."
		
		    CASE lcFiltro == "COMPRA URGENTE"
		        lcDesc = "Artículos debajo de la posición mínima y sin compras pendientes." + CHR(13) + CHR(10) + ;
		                 "Condición: pedprov <= 0 y posicion < art_stmin."
		
		    CASE lcFiltro == "RUBROS"
		        lcDesc = "Filtra la lista de alertas por una categoría o rubro específico."
		        IF !EMPTY(lcCombo2Texto)
		            lcRef = "Referencia: rubro seleccionado = " + lcCombo2Texto + "."
		        ENDIF
		
		    CASE lcFiltro == "PROVEEDOR"
		        lcDesc = "Filtra los artículos con faltantes asociados a un proveedor determinado."
		        IF !EMPTY(lcCombo2Texto)
		            lcRef = "Referencia: proveedor seleccionado = " + lcCombo2Texto + "."
		        ENDIF
		
		    CASE lcFiltro == "DEPURACION"
		        lcDesc = "Vista de control para detectar artículos con problemas de parametrización o estado."
		
		        DO CASE
		            CASE lnCombo2Valor = 1 OR lcCombo2Norm == "INACTIVOS"
		                lcRef = "Referencia: muestra únicamente artículos inactivos (estado = 0)."
		
		            CASE lnCombo2Valor = 2 OR lcCombo2Norm == "SIN STOCK MINIMO"
		                lcRef = "Referencia: muestra artículos activos sin stock mínimo configurado."
		
		            CASE lnCombo2Valor = 3 OR lcCombo2Norm == "SIN % ALERTA" OR lcCombo2Norm == "SIN % DE ALERTA"
		                lcRef = "Referencia: muestra artículos activos sin porcentaje de alerta configurado."
		
		            CASE lnCombo2Valor = 4 OR lcCombo2Norm == "SIN PARAMETRIZAR"
		                lcRef = "Referencia: muestra artículos activos sin stock mínimo o sin porcentaje de alerta."
		
		            CASE lnCombo2Valor = 5 OR lcCombo2Norm == "TODOS"
		                lcRef = "Referencia: muestra todos los artículos, activos e inactivos."
		
		            OTHERWISE
		                IF !EMPTY(lcCombo2Texto)
		                    lcRef = "Referencia: opción seleccionada = " + lcCombo2Texto + "."
		                ELSE
		                    lcRef = "Referencia: seleccione una opción de depuración."
		                ENDIF
		        ENDCASE
		
		    OTHERWISE
		        lcDesc = "Vista general de artículos con métricas de rotación y salud de stock."
		ENDCASE
		
		IF !EMPTY(lcRef)
		    lcDesc = lcDesc + CHR(13) + CHR(10) + lcRef
		ENDIF
		
		IF PEMSTATUS(loFrm, "lbl_info_filtro", 5)
		    loFrm.lbl_info_filtro.Caption = lcDesc
		    loFrm.lbl_info_filtro.Refresh
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE actualizarlabelestadooc
		*=========================================================
		* FormSet.ActualizarLabelEstadoOC
		* - Muestra estado visual de OC según solicitud seleccionada
		* - PENDIENTE = OC SIN GENERAR
		* - COMPRADO  = OC GENERADA
		* - Robusto al iniciar secundario por primera vez
		*=========================================================
		LPARAMETERS tnSoliCodi
		
		LOCAL loFrm, lcEstado, lnConn, lnRet
		LOCAL lnSoliActual, lnRecActual
		
		loFrm        = THISFORMSET.secundario
		lcEstado     = ""
		lnConn       = 0
		lnRet        = 0
		lnSoliActual = 0
		lnRecActual  = 0
		
		IF VARTYPE(loFrm) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loFrm, "lbl_estado_oc", 5)
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 1. Normalizar soli_codi recibido
		*---------------------------------------------------------
		IF VARTYPE(tnSoliCodi) = "N" AND tnSoliCodi > 0
		    lnSoliActual = tnSoliCodi
		ELSE
		    lnSoliActual = 0
		ENDIF
		
		*---------------------------------------------------------
		* 2. Si no vino parámetro, tomarlo desde xSoliCodiActual
		*---------------------------------------------------------
		IF lnSoliActual <= 0
		    IF PEMSTATUS(loFrm, "xSoliCodiActual", 5)
		        lnSoliActual = VAL(TRANSFORM(NVL(loFrm.xSoliCodiActual, 0)))
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 3. Si todavía no hay soli_codi, tomar registro actual
		*    de cur_soli_hist. Si está EOF/BOF al iniciar, GO TOP.
		*---------------------------------------------------------
		IF lnSoliActual <= 0 AND USED("cur_soli_hist") AND RECCOUNT("cur_soli_hist") > 0
		
		    SELECT cur_soli_hist
		
		    IF EOF("cur_soli_hist") OR BOF("cur_soli_hist")
		        GO TOP IN cur_soli_hist
		    ENDIF
		
		    IF !EOF("cur_soli_hist") AND !BOF("cur_soli_hist")
		        IF TYPE("cur_soli_hist.soli_codi") = "N"
		            lnSoliActual = NVL(cur_soli_hist.soli_codi, 0)
		        ENDIF
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 4. Intentar leer estado desde cur_soli_hist
		*    Primero por soli_codi, después por registro actual.
		*---------------------------------------------------------
		IF USED("cur_soli_hist") AND RECCOUNT("cur_soli_hist") > 0
		
		    SELECT cur_soli_hist
		
		    IF !EOF("cur_soli_hist") AND !BOF("cur_soli_hist")
		        lnRecActual = RECNO("cur_soli_hist")
		    ENDIF
		
		    IF lnSoliActual > 0
		        LOCATE FOR soli_codi = lnSoliActual
		    ELSE
		        IF EOF("cur_soli_hist") OR BOF("cur_soli_hist")
		            GO TOP IN cur_soli_hist
		        ENDIF
		    ENDIF
		
		    IF FOUND() OR (!EOF("cur_soli_hist") AND !BOF("cur_soli_hist"))
		        IF TYPE("cur_soli_hist.estado") <> "U"
		            lcEstado = UPPER(ALLTRIM(TRANSFORM(NVL(cur_soli_hist.estado, ""))))
		        ENDIF
		
		        IF lnSoliActual <= 0 AND TYPE("cur_soli_hist.soli_codi") = "N"
		            lnSoliActual = NVL(cur_soli_hist.soli_codi, 0)
		        ENDIF
		    ENDIF
		
		    *-- Restaurar posición anterior si era válida
		    IF lnRecActual > 0 AND lnRecActual <= RECCOUNT("cur_soli_hist")
		        GO lnRecActual IN cur_soli_hist
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 5. Si no está disponible en cursor, consultar MySQL
		*---------------------------------------------------------
		IF EMPTY(lcEstado) AND lnSoliActual > 0
		
		    IF USED("cur_estado_label_oc")
		        USE IN cur_estado_label_oc
		    ENDIF
		
		    lnConn = Conectar_DB(_screen.cn)
		
		    IF VARTYPE(lnConn) = "N" AND lnConn > 0
		
		        lnRet = SQLEXEC(lnConn, ;
		            "SELECT UPPER(TRIM(IFNULL(estado,''))) AS estado " + ;
		            "FROM solicitud_compra " + ;
		            "WHERE soli_codi = ?lnSoliActual", ;
		            "cur_estado_label_oc")
		
		        IF VARTYPE(lnConn) = "N" AND lnConn > 0
		            Desconectar_DB(lnConn)
		            lnConn = 0
		        ENDIF
		
		        IF lnRet > 0 AND USED("cur_estado_label_oc") AND RECCOUNT("cur_estado_label_oc") > 0
		            SELECT cur_estado_label_oc
		            GO TOP
		            lcEstado = UPPER(ALLTRIM(TRANSFORM(NVL(cur_estado_label_oc.estado, ""))))
		        ENDIF
		    ENDIF
		
		    IF USED("cur_estado_label_oc")
		        USE IN cur_estado_label_oc
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 6. Guardar soli actual en secundario
		*---------------------------------------------------------
		IF lnSoliActual > 0
		    IF !PEMSTATUS(loFrm, "xSoliCodiActual", 5)
		        loFrm.AddProperty("xSoliCodiActual", 0)
		    ENDIF
		
		    loFrm.xSoliCodiActual = lnSoliActual
		ENDIF
		
		*---------------------------------------------------------
		* 7. Aplicar caption visual
		*---------------------------------------------------------
		DO CASE
		
		CASE lcEstado == "COMPRADO"
		    loFrm.lbl_estado_oc.Caption   = "OC GENERADA"
		    loFrm.lbl_estado_oc.Fontbold  = .T.
		    loFrm.lbl_estado_oc.FontItalic  = .T.
		    loFrm.lbl_estado_oc.ForeColor = RGB(80, 220, 120)
		
		CASE lcEstado == "PENDIENTE"
		    loFrm.lbl_estado_oc.Caption   = "OC SIN GENERAR"
		    loFrm.lbl_estado_oc.Fontbold  = .T.
		    loFrm.lbl_estado_oc.FontItalic  = .T.
		    loFrm.lbl_estado_oc.ForeColor = RGB(255, 193, 7)
		
		CASE EMPTY(lcEstado)
		    loFrm.lbl_estado_oc.Caption   = "ESTADO: SIN DEFINIR"
		    loFrm.lbl_estado_oc.Fontbold  = .T.
		    loFrm.lbl_estado_oc.FontItalic  = .T.
		    loFrm.lbl_estado_oc.ForeColor = RGB(220, 220, 220)
		
		OTHERWISE
		    loFrm.lbl_estado_oc.Caption   = "ESTADO: " + lcEstado
		    loFrm.lbl_estado_oc.Fontbold  = .T.
		    loFrm.lbl_estado_oc.FontItalic  = .T.
		    loFrm.lbl_estado_oc.ForeColor = RGB(220, 220, 220)
		
		ENDCASE
		
		
		
		
		loFrm.lbl_estado_oc.Refresh()
		
		
		*---------------------------------------------------------
		* Bloquear/habilitar edición de observación y confirmacion oc según estado
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "command3", 5)
		    loFrm.command3.Caption = "EDITAR"
		
		    IF lcEstado == "COMPRADO"
		        loFrm.command3.Enabled = .F.
		    ELSE
		        loFrm.command3.Enabled = (lnSoliActual > 0)
		    ENDIF
		
		    loFrm.command3.Refresh()
		ENDIF
		
		IF PEMSTATUS(loFrm, "confirm_oc", 5)
		    IF lcEstado == "COMPRADO"
		        loFrm.confirm_oc.Enabled = .F.
		    ELSE
		        loFrm.confirm_oc.Enabled = (lnSoliActual > 0)
		    ENDIF
		
		    loFrm.confirm_oc.Refresh()
		ENDIF
		
		
		IF lcEstado == "COMPRADO"
		    IF PEMSTATUS(loFrm, "edit1", 5)
		        loFrm.edit1.ReadOnly  = .T.
		        loFrm.edit1.Enabled   = .F.
		        loFrm.edit1.BackColor = RGB(245,245,245)
		        loFrm.edit1.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xObsEditando", 5)
		        loFrm.xObsEditando = .F.
		    ENDIF
		ENDIF
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE actualizarordencoditerciario
		*=========================================================
		* FormSet.ActualizarOrdenCodiTerciario
		* - Muestra en terciario.text1 el orden_codi del registro
		*   actualmente enfocado en grd_ter_compras / cur_ter_compras
		* - Si no hay orden_codi válido, oculta label7 y text1
		*=========================================================
		LOCAL loTer, loGrid
		LOCAL lnOrdenCodi
		LOCAL lcAliasActual
		
		loTer         = .NULL.
		loGrid        = .NULL.
		lnOrdenCodi   = 0
		lcAliasActual = ALIAS()
		
		*---------------------------------------------------------
		* Validar form terciario
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "terciario", 5)
		    loTer = THISFORMSET.terciario
		ENDIF
		
		IF VARTYPE(loTer) <> "O"
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(loTer, "grd_ter_compras", 5)
		    loGrid = loTer.grd_ter_compras
		ENDIF
		
		*---------------------------------------------------------
		* Leer orden_codi desde el registro actual del cursor
		* cur_ter_compras. Este cursor es el RecordSource del grid.
		*---------------------------------------------------------
		IF USED("cur_ter_compras") AND RECCOUNT("cur_ter_compras") > 0
		
		    SELECT cur_ter_compras
		
		    IF EOF("cur_ter_compras") OR BOF("cur_ter_compras")
		        GO TOP IN cur_ter_compras
		    ENDIF
		
		    IF !EOF("cur_ter_compras") AND !BOF("cur_ter_compras")
		        IF TYPE("cur_ter_compras.orden_codi") <> "U"
		            lnOrdenCodi = VAL(TRANSFORM(NVL(cur_ter_compras.orden_codi, 0)))
		        ENDIF
		    ENDIF
		
		ENDIF
		
		*---------------------------------------------------------
		* Mostrar / ocultar según orden_codi del registro enfocado
		*---------------------------------------------------------
		IF lnOrdenCodi > 0
		
		    IF PEMSTATUS(loTer, "label7", 5)
		        loTer.label7.Caption = "Orden Compra:"
		        loTer.label7.Visible = .T.
		        loTer.label7.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(loTer, "text1", 5)
		        loTer.text1.Value    = TRANSFORM(lnOrdenCodi)
		        loTer.text1.Visible  = .T.
		        loTer.text1.Enabled  = .F.
		        loTer.text1.ReadOnly = .T.
		        loTer.text1.Refresh()
		    ENDIF
		
		ELSE
		
		    IF PEMSTATUS(loTer, "label7", 5)
		        loTer.label7.Visible = .F.
		        loTer.label7.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(loTer, "text1", 5)
		        loTer.text1.Value   = ""
		        loTer.text1.Visible = .F.
		        loTer.text1.Refresh()
		    ENDIF
		
		ENDIF
		
		*---------------------------------------------------------
		* Restaurar alias anterior
		*---------------------------------------------------------
		IF !EMPTY(lcAliasActual) AND USED(lcAliasActual)
		    SELECT (lcAliasActual)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE actualizarvisibilidadcolumnaobservacion
		*=========================================================
		* FormSet.ActualizarVisibilidadColumnaObservacion
		* - Muestra la columna 14 solo en filtro SELECCIONADOS
		* - Restaura anchos normales cuando no corresponde
		*=========================================================
		
		LOCAL loFrm
		LOCAL loGrid
		LOCAL lcFiltro
		LOCAL llVisible
		
		loFrm = THISFORMSET.principal
		
		IF VARTYPE(loFrm) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loFrm, "grd_alerts", 5)
		    RETURN .F.
		ENDIF
		
		loGrid = loFrm.grd_alerts
		
		IF VARTYPE(loGrid) <> "O"
		    RETURN .F.
		ENDIF
		
		IF loGrid.ColumnCount < 14
		    RETURN .F.
		ENDIF
		
		lcFiltro = ""
		IF PEMSTATUS(loFrm, "xFiltroActual", 5)
		    lcFiltro = UPPER(ALLTRIM(TRANSFORM(loFrm.xFiltroActual)))
		ENDIF
		
		llVisible = (lcFiltro == "SELECCIONADOS")
		
		WITH loGrid
		    IF llVisible
		        *---------------------------------------------
		        * Layout con columna 14 visible
		        *---------------------------------------------
		        .Columns(1).Width  = 38
		        .Columns(2).Width  = 70
		        .Columns(3).Width  = 240
		        .Columns(4).Width  = 70
		        .Columns(5).Width  = 70
		        .Columns(6).Width  = 70
		        .Columns(7).Width  = 75
		        .Columns(8).Width  = 70
		        .Columns(9).Width  = 75
		        .Columns(10).Width = 165
		        .Columns(11).Width = 75
		        .Columns(12).Width = 40
		        .Columns(13).Width = 40
		        .Columns(14).Width = 30
		
		        .Columns(14).Visible = .T.
		    ELSE
		        *---------------------------------------------
		        * Layout original sin columna 14
		        *---------------------------------------------
		        .Columns(14).Visible = .F.
		
		        .Columns(1).Width  = 40
		        .Columns(2).Width  = 70
		        .Columns(3).Width  = 260
		        .Columns(4).Width  = 70
		        .Columns(5).Width  = 70
		        .Columns(6).Width  = 70
		        .Columns(7).Width  = 75
		        .Columns(8).Width  = 70
		        .Columns(9).Width  = 75
		        .Columns(10).Width = 185
		        .Columns(11).Width = 85
		        .Columns(12).Width = 40
		        .Columns(13).Width = 50
		    ENDIF
		
		    .Refresh()
		ENDWITH
		
		RETURN .T.
	ENDPROC

	PROCEDURE agregararticulomanual
		*=========================================================
		* FormSet.AgregarArticuloManual
		* Alta manual unificada:
		* - sirve para artículo elegido desde artload
		* - sirve para artículo ingresado por código
		* - valida si ya existe en temp_solicitud_compra
		* - usa CRUDTempSolicitudCompra("SAVE")
		* - resuelve proveedor/costo real desde DB si cur_alerts no lo tiene
		*=========================================================
		LPARAMETERS tnArtCodi, tcArtDesc
		
		LOCAL loFrm
		LOCAL lcArtDesc, lcInput
		LOCAL lnCant, lnProvCodi_, lnProvCosto_
		LOCAL llOk
		LOCAL lnRecOld, lnArtOld
		LOCAL lnConn, lnRet
		LOCAL lcSQL
		LOCAL laErr[1], lcErrMsg
		
		loFrm = THISFORMSET.principal
		
		*---------------------------------------------------------
		* 0) Validación de código
		*---------------------------------------------------------
		IF VARTYPE(tnArtCodi) <> "N" OR tnArtCodi <= 0
		    MESSAGEBOX("Ingrese un código de artículo válido.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		lcArtDesc = IIF(VARTYPE(tcArtDesc) = "C", ALLTRIM(tcArtDesc), "")
		
		*---------------------------------------------------------
		* 1) Si no vino descripción, buscarla en MySQL
		*---------------------------------------------------------
		IF EMPTY(lcArtDesc)
		
		    IF USED("cur_valida_art_manual")
		        USE IN cur_valida_art_manual
		    ENDIF
		
		    lnConn = Conectar_DB(_screen.cn)
		    IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		        MESSAGEBOX("Sin conexión al servidor.", 16, "Error")
		        RETURN .F.
		    ENDIF
		
		    lcSQL = "SELECT art_desc FROM articulos WHERE art_codi = ?tnArtCodi"
		
		    lnRet = SQLEXEC(lnConn, lcSQL, "cur_valida_art_manual")
		
		    IF lnRet < 0
		        IF AERROR(laErr) > 0
		            lcErrMsg = IIF(TYPE("laErr[1,3]") <> "U", TRANSFORM(laErr[1,3]), "Error SQL")
		        ELSE
		            lcErrMsg = "Error SQL desconocido."
		        ENDIF
		
		        Desconectar_DB(lnConn)
		        MESSAGEBOX("No se pudo validar el artículo." + CHR(13) + lcErrMsg, 16, "Error")
		        RETURN .F.
		    ENDIF
		
		    Desconectar_DB(lnConn)
		
		    IF !USED("cur_valida_art_manual") OR RECCOUNT("cur_valida_art_manual") = 0
		        IF USED("cur_valida_art_manual")
		            USE IN cur_valida_art_manual
		        ENDIF
		        MESSAGEBOX("El código " + TRANSFORM(tnArtCodi) + " no existe.", 48, "Aviso")
		        RETURN .F.
		    ENDIF
		
		    SELECT cur_valida_art_manual
		    lcArtDesc = ALLTRIM(NVL(cur_valida_art_manual.art_desc, ""))
		
		    USE IN cur_valida_art_manual
		
		    IF EMPTY(lcArtDesc)
		        MESSAGEBOX("El artículo no tiene descripción válida.", 48, "Aviso")
		        RETURN .F.
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 2) Validar si ya existe en temp_solicitud_compra
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "CRUDTempSolicitudCompra", 5)
			llOk = THISFORMSET.CRUDTempSolicitudCompra("GET", tnArtCodi, 0, 0, 0, "cur_tmp_exist_art", 0, "")
		    IF llOk
		        IF USED("cur_tmp_exist_art") AND RECCOUNT("cur_tmp_exist_art") > 0
		            MESSAGEBOX("El artículo ya se encuentra cargado en la lista temporal.", 48, "Aviso")
		
		            IF USED("cur_tmp_exist_art")
		                USE IN cur_tmp_exist_art
		            ENDIF
		
		            RETURN .F.
		        ENDIF
		    ENDIF
		
		    IF USED("cur_tmp_exist_art")
		        USE IN cur_tmp_exist_art
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 3) Recordar posición actual del grid
		*---------------------------------------------------------
		lnRecOld = 0
		lnArtOld = 0
		
		IF USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0
		    SELECT cur_alerts
		    IF !EOF()
		        lnRecOld = RECNO("cur_alerts")
		        lnArtOld = IIF(TYPE("cur_alerts.art_codi") = "N", cur_alerts.art_codi, 0)
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 4) Si el artículo ya está visible en cur_alerts y seleccionado,
		*    usar cant_soli actual como default; si no, usar sugerido/1
		*---------------------------------------------------------
		lnCant = 1
		
		IF USED("cur_alerts")
		    SELECT cur_alerts
		    LOCATE FOR art_codi = tnArtCodi
		    IF FOUND()
		        DO CASE
		        CASE TYPE("cur_alerts.ui_sel") = "L" AND cur_alerts.ui_sel AND TYPE("cur_alerts.cant_soli") = "N" AND cur_alerts.cant_soli > 0
		            lnCant = cur_alerts.cant_soli
		        CASE TYPE("cur_alerts.sugerido_comprar") = "N" AND cur_alerts.sugerido_comprar > 0
		            lnCant = cur_alerts.sugerido_comprar
		        OTHERWISE
		            lnCant = 1
		        ENDCASE
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 5) Pedir cantidad
		*---------------------------------------------------------
		lcInput = INPUTBOX( ;
		    "Artículo: " + lcArtDesc + CHR(13) + ;
		    "Código: " + TRANSFORM(tnArtCodi) + CHR(13) + CHR(13) + ;
		    "Ingrese cantidad:", ;
		    "Agregar artículo", ;
		    TRANSFORM(lnCant))
		
		IF EMPTY(ALLTRIM(lcInput))
		    RETURN .F.
		ENDIF
		
		lnCant = VAL(STRTRAN(ALLTRIM(lcInput), ",", "."))
		
		IF lnCant <= 0
		    MESSAGEBOX("La cantidad debe ser mayor a cero.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 6) Resolver proveedor/costo
		*    Orden:
		*    A) intentar desde cur_alerts
		*    B) si falta proveedor o costo, resolver desde DB
		*---------------------------------------------------------
		lnProvCodi_  = 0
		lnProvCosto_ = 0
		
		IF USED("cur_alerts")
		    SELECT cur_alerts
		    LOCATE FOR art_codi = tnArtCodi
		    IF FOUND()
		        lnProvCodi_  = IIF(TYPE("cur_alerts.prov_codi_sel") = "N", cur_alerts.prov_codi_sel, 0)
		        lnProvCosto_ = IIF(TYPE("cur_alerts.artpro_costo")  = "N", cur_alerts.artpro_costo,  0)
		    ENDIF
		ENDIF
		
		*-- Si falta proveedor o falta costo, resolverlos desde MySQL
		IF lnProvCodi_ <= 0 OR lnProvCosto_ <= 0
		
		    IF USED("cur_ap_manual")
		        USE IN cur_ap_manual
		    ENDIF
		
		    lnConn = Conectar_DB(_screen.cn)
		    IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		        MESSAGEBOX("No se pudo conectar para resolver proveedor/costo.", 16, "Error")
		        RETURN .F.
		    ENDIF
		
		    TEXT TO lcSQL NOSHOW PRETEXT 15
		        SELECT
		            ap.prov_codi,
		            COALESCE(
		                MAX(CASE WHEN ap.cotiz = 1 AND ap.artpro_costo > 0 THEN ap.artpro_costo END),
		                MIN(CASE WHEN ap.artpro_costo > 0 THEN ap.artpro_costo END),
		                0
		            ) AS artpro_costo
		        FROM articulos_proveedores ap
		        WHERE ap.art_codi = ?tnArtCodi
		        GROUP BY ap.prov_codi
		        ORDER BY
		            CASE
		                WHEN MAX(CASE WHEN ap.cotiz = 1 AND ap.artpro_costo > 0 THEN 1 ELSE 0 END) = 1 THEN 0
		                ELSE 1
		            END,
		            COALESCE(
		                MAX(CASE WHEN ap.cotiz = 1 AND ap.artpro_costo > 0 THEN ap.artpro_costo END),
		                MIN(CASE WHEN ap.artpro_costo > 0 THEN ap.artpro_costo END),
		                999999999
		            ),
		            ap.prov_codi
		    ENDTEXT
		
		    lnRet = SQLEXEC(lnConn, lcSQL, "cur_ap_manual")
		
		    IF lnRet < 0
		        IF AERROR(laErr) > 0
		            lcErrMsg = IIF(TYPE("laErr[1,3]") <> "U", TRANSFORM(laErr[1,3]), "Error SQL")
		        ELSE
		            lcErrMsg = "Error SQL desconocido."
		        ENDIF
		
		        IF USED("cur_ap_manual")
		            USE IN cur_ap_manual
		        ENDIF
		
		        Desconectar_DB(lnConn)
		        MESSAGEBOX("No se pudo resolver proveedor/costo." + CHR(13) + lcErrMsg, 16, "Error")
		        RETURN .F.
		    ENDIF
		
		    IF USED("cur_ap_manual") AND RECCOUNT("cur_ap_manual") > 0
		        SELECT cur_ap_manual
		        GO TOP
		
		        IF lnProvCodi_ <= 0
		            lnProvCodi_ = IIF(TYPE("cur_ap_manual.prov_codi") = "N", cur_ap_manual.prov_codi, VAL(TRANSFORM(cur_ap_manual.prov_codi)))
		        ENDIF
		
				IF lnProvCosto_ <= 0
				    lnProvCosto_ = IIF(INLIST(TYPE("cur_ap_manual.artpro_costo"), "N", "F"), ;
				        ROUND(NVL(cur_ap_manual.artpro_costo, 0), 4), 0)
				ENDIF
		
		    ENDIF
		
		    IF USED("cur_ap_manual")
		        USE IN cur_ap_manual
		    ENDIF
		
		    Desconectar_DB(lnConn)
		ENDIF
		
		*---------------------------------------------------------
		* 7) Guardar en temp_solicitud_compra usando CRUD central
		*---------------------------------------------------------
		WAIT WINDOW "Agregando artículo..." NOWAIT
		
		llOk = THISFORMSET.CRUDTempSolicitudCompra("SAVE", tnArtCodi, lnCant, lnProvCodi_, lnProvCosto_, "", 0, "")
		WAIT CLEAR
		
		IF !llOk
		    MESSAGEBOX("No se pudo guardar el artículo en la lista temporal.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 8) Refrescar dataset base y aplicar filtro SELECCIONADOS
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "CargarAlertasStockFull", 5)
		    THISFORMSET.CargarAlertasStockFull()
		ENDIF
		
		IF PEMSTATUS(loFrm, "xFiltroActual", 5)
		    loFrm.xFiltroActual = "SELECCIONADOS"
		ENDIF
		
		IF PEMSTATUS(loFrm, "xRubCodiActual", 5)
		    loFrm.xRubCodiActual = 0
		ENDIF
		
		IF PEMSTATUS(loFrm, "combo1", 5)
		    loFrm.combo1.DisplayValue = "SELECCIONADOS"
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		    THISFORMSET.AplicarFiltroLocal("SELECCIONADOS", 0)
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarVisibilidadColumnaObservacion", 5)
		    THISFORMSET.ActualizarVisibilidadColumnaObservacion()
		ENDIF
		*---------------------------------------------------------
		* 9) Reposicionar sobre el artículo recién agregado
		*---------------------------------------------------------
		IF USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0
		    SELECT cur_alerts
		
		    IF PEMSTATUS(loFrm, "xCurArt", 5)
		        loFrm.xCurArt = 0
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xCurRec", 5)
		        loFrm.xCurRec = 0
		    ENDIF
		
		    LOCATE FOR art_codi = tnArtCodi
		
		    IF !FOUND() AND lnArtOld > 0
		        LOCATE FOR art_codi = lnArtOld
		    ENDIF
		
		    IF !FOUND() AND BETWEEN(lnRecOld, 1, RECCOUNT("cur_alerts"))
		        GO lnRecOld
		    ENDIF
		
		    IF !EOF()
		        *-- MUY IMPORTANTE: dejar físicamente parado el cursor
		        GO RECNO("cur_alerts")
		
		        IF PEMSTATUS(loFrm, "xCurArt", 5)
		            loFrm.xCurArt = IIF(TYPE("cur_alerts.art_codi") = "N", cur_alerts.art_codi, 0)
		        ENDIF
		
		        IF PEMSTATUS(loFrm, "xCurRec", 5)
		            loFrm.xCurRec = RECNO("cur_alerts")
		        ENDIF
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 10) Sincronización final de interfaz
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		    THISFORMSET.RefrescarGrid()
		ELSE
		    IF PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.Refresh()
		    ENDIF
		ENDIF
		
		*-- Forzar sincronización real del artículo recién agregado
		IF PEMSTATUS(THISFORMSET, "SincronizarArticuloActualUI", 5)
		    THISFORMSET.SincronizarArticuloActualUI(loFrm.xCurRec, tnArtCodi)
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "SincronizarPedido", 5)
		    THISFORMSET.SincronizarPedido()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		    THISFORMSET.SincronizarBotonMasivo()
		ENDIF
		
		MESSAGEBOX("Artículo agregado correctamente.", 64, "Éxito")
		
		IF PEMSTATUS(loFrm, "txt_add_codi", 5)
		    TRY
		        loFrm.txt_add_codi.SetFocus()
		    CATCH
		    ENDTRY
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE aplicarfiltrodepuracion
		*=========================================================
		* FormSet.AplicarFiltroDepuracion
		* Construye cur_temp desde cur_raw_full según condición
		* del filtro DEPURACION
		*
		* Códigos:
		*   1 = INACTIVOS          => estado = 0
		*   2 = SIN STOCK MINIMO   => art_stmin = 0
		*   3 = SIN % ALERTA       => art_pct_alerta = 0
		*   4 = SIN PARAMETRIZAR   => art_stmin = 0 OR art_pct_alerta = 0
		*   5 = TODOS
		*=========================================================
		LPARAMETERS tnCondicion
		
		LOCAL loFrm
		LOCAL lcCantSoli, lcMesesCobProy, lcScore, lcEstado
		LOCAL lcProvCodiSel, lcProvNombSel, lcArtproCosto, lcArtproMoneda
		LOCAL lcArtproFecha, lcProvLista, lcColBack, lcColFore
		LOCAL lnConn2, lnRet2, lcSQL2
		
		loFrm = THISFORMSET.principal
		
		IF VARTYPE(tnCondicion) <> "N" OR tnCondicion <= 0
		    MESSAGEBOX("Condición inválida para filtro DEPURACION.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_raw_full")
		    MESSAGEBOX("cur_raw_full no existe.", 16, "Depuración")
		    RETURN .F.
		ENDIF
		
		IF USED("cur_temp")
		    USE IN cur_temp
		ENDIF
		
		IF USED("cur_dep_filtro")
		    USE IN cur_dep_filtro
		ENDIF
		
		*---------------------------------------------------------
		* Blindaje de campos opcionales
		*---------------------------------------------------------
		lcCantSoli = IIF(TYPE("cur_raw_full.cant_soli") = "U", ;
		    "CAST(0 AS N(15,3))", ;
		    "CAST(NVL(cur_raw_full.cant_soli,0) AS N(15,3))")
		
		lcMesesCobProy = IIF(TYPE("cur_raw_full.meses_cob_proy") = "U", ;
		    "CAST(0 AS N(15,3))", ;
		    "CAST(NVL(cur_raw_full.meses_cob_proy,0) AS N(15,3))")
		
		lcScore = IIF(TYPE("cur_raw_full.score") = "U", ;
		    "CAST(0 AS I)", ;
		    "CAST(NVL(cur_raw_full.score,0) AS I)")
		
		lcEstado = IIF(TYPE("cur_raw_full.estado") = "U", ;
		    "CAST(1 AS I)", ;
		    "CAST(NVL(cur_raw_full.estado,1) AS I)")
		
		lcProvCodiSel = IIF(TYPE("cur_raw_full.prov_codi_sel") = "U", ;
		    "CAST(0 AS I)", ;
		    "CAST(NVL(cur_raw_full.prov_codi_sel,0) AS I)")
		
		lcProvNombSel = IIF(TYPE("cur_raw_full.prov_nomb_sel") = "U", ;
		    "CAST('' AS C(80))", ;
		    "CAST(NVL(cur_raw_full.prov_nomb_sel,'') AS C(80))")
		
		lcArtproCosto = IIF(TYPE("cur_raw_full.artpro_costo") = "U", ;
		    "CAST(0 AS N(15,4))", ;
		    "CAST(NVL(cur_raw_full.artpro_costo,0) AS N(15,4))")
		
		lcArtproMoneda = IIF(TYPE("cur_raw_full.artpro_moneda") = "U", ;
		    "CAST('' AS C(1))", ;
		    "CAST(NVL(cur_raw_full.artpro_moneda,'') AS C(1))")
		
		lcArtproFecha = IIF(TYPE("cur_raw_full.artpro_fecha") = "U", ;
		    "CAST({} AS D)", ;
		    "CAST(NVL(cur_raw_full.artpro_fecha,{}) AS D)")
		
		lcProvLista = IIF(TYPE("cur_raw_full.prov_lista") = "U", ;
		    "CAST('' AS M)", ;
		    "CAST(NVL(cur_raw_full.prov_lista,'') AS M)")
		
		lcColBack = IIF(TYPE("cur_raw_full.col_back") = "U", ;
		    "CAST(0 AS N(12,0))", ;
		    "CAST(NVL(cur_raw_full.col_back,0) AS N(12,0))")
		
		lcColFore = IIF(TYPE("cur_raw_full.col_fore") = "U", ;
		    "CAST(0 AS N(12,0))", ;
		    "CAST(NVL(cur_raw_full.col_fore,0) AS N(12,0))")
		
		*---------------------------------------------------------
		* Condición del filtro
		*---------------------------------------------------------
		DO CASE
		
		CASE tnCondicion = 1
		    *--- INACTIVOS: SOLO estado = 0, sin usar cur_dep_filtro ---
		    SELECT ;
		        art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		        pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		        ventas_metrics, promedio_venta, fecha_ult_venta, ;
		        compras_metrics, promedio_compra, fecha_ult_compra, ;
		        dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		        &lcCantSoli     AS cant_soli, ;
		        meses_cubiertos, &lcMesesCobProy AS meses_cob_proy, meses_cobert_solic, ;
		        &lcScore        AS score, ;
		        CAST(0 AS I)    AS estado, ;
		        rub_codi, rub_desc, ;
		        &lcProvCodiSel  AS prov_codi_sel, ;
		        &lcProvNombSel  AS prov_nomb_sel, ;
		        &lcArtproCosto  AS artpro_costo, ;
		        &lcArtproMoneda AS artpro_moneda, ;
		        &lcArtproFecha  AS artpro_fecha, ;
		        &lcProvLista    AS prov_lista, ;
		        &lcColBack      AS col_back, ;
		        &lcColFore      AS col_fore, ;
		        CAST('' AS C(8)) AS ui_item, ;
		        CAST(.F. AS L)   AS ui_sel ;
		    FROM cur_raw_full ;
		    WHERE NVL(estado,1) = 0 ;
		    ORDER BY art_desc ASC ;
		    INTO CURSOR cur_temp READWRITE
		
		CASE tnCondicion = 2 OR tnCondicion = 3 OR tnCondicion = 4 OR tnCondicion = 5
		
		    *--- Consultar artículos fresco para obtener art_pct_alerta / art_stmin reales ---
		    DO CASE
		    CASE tnCondicion = 2
		        lcSQL2 = ;
		            "SELECT a.art_codi " + ;
		            "FROM articulos a " + ;
		            "WHERE IFNULL(a.art_stmin,0) = 0"
		
		    CASE tnCondicion = 3
		        lcSQL2 = ;
		            "SELECT a.art_codi " + ;
		            "FROM articulos a " + ;
		            "LEFT JOIN art_metricas m ON m.art_codi = a.art_codi " + ;
		            "WHERE IFNULL(m.art_pct_alerta,30.00) = 0"
		
		    CASE tnCondicion = 4
		        lcSQL2 = ;
		            "SELECT a.art_codi " + ;
		            "FROM articulos a " + ;
		            "LEFT JOIN art_metricas m ON m.art_codi = a.art_codi " + ;
		            "WHERE IFNULL(a.art_stmin,0) = 0 " + ;
		            "   OR IFNULL(m.art_pct_alerta,30.00) = 0"
		
		    CASE tnCondicion = 5
		        lcSQL2 = ;
		            "SELECT a.art_codi " + ;
		            "FROM articulos a"
		    ENDCASE
		
		    lnConn2 = Conectar_DB(_screen.cn)
		    IF VARTYPE(lnConn2) <> "N" OR lnConn2 <= 0
		        MESSAGEBOX("No se pudo conectar para filtro DEPURACION.", 16, "Error")
		        RETURN .F.
		    ENDIF
		
		    lnRet2 = SQLEXEC(lnConn2, lcSQL2, "cur_dep_filtro")
		    Desconectar_DB(lnConn2)
		
		    IF lnRet2 < 0 OR !USED("cur_dep_filtro")
		        MESSAGEBOX("Error al consultar artículos para DEPURACION.", 16, "Error")
		        RETURN .F.
		    ENDIF
		
		    SELECT cur_dep_filtro
		    INDEX ON art_codi TAG tdep_idx
		
		    *--- Casos 2,3,4: sólo ACTIVOS ---
		    IF INLIST(tnCondicion, 2, 3, 4)
		        SELECT ;
		            art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		            pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		            ventas_metrics, promedio_venta, fecha_ult_venta, ;
		            compras_metrics, promedio_compra, fecha_ult_compra, ;
		            dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		            &lcCantSoli     AS cant_soli, ;
		            meses_cubiertos, &lcMesesCobProy AS meses_cob_proy, meses_cobert_solic, ;
		            &lcScore        AS score, ;
		            &lcEstado       AS estado, ;
		            rub_codi, rub_desc, ;
		            &lcProvCodiSel  AS prov_codi_sel, ;
		            &lcProvNombSel  AS prov_nomb_sel, ;
		            &lcArtproCosto  AS artpro_costo, ;
		            &lcArtproMoneda AS artpro_moneda, ;
		            &lcArtproFecha  AS artpro_fecha, ;
		            &lcProvLista    AS prov_lista, ;
		            &lcColBack      AS col_back, ;
		            &lcColFore      AS col_fore, ;
		            CAST('' AS C(8)) AS ui_item, ;
		            CAST(.F. AS L)   AS ui_sel ;
		        FROM cur_raw_full ;
		        WHERE NVL(estado,1) = 1 ;
		          AND SEEK(cur_raw_full.art_codi, "cur_dep_filtro", "tdep_idx") ;
		        ORDER BY art_desc ASC ;
		        INTO CURSOR cur_temp READWRITE
		    ELSE
		        *--- TODOS: sin filtrar por estado ---
		        SELECT ;
		            art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		            pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		            ventas_metrics, promedio_venta, fecha_ult_venta, ;
		            compras_metrics, promedio_compra, fecha_ult_compra, ;
		            dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		            &lcCantSoli     AS cant_soli, ;
		            meses_cubiertos, &lcMesesCobProy AS meses_cob_proy, meses_cobert_solic, ;
		            &lcScore        AS score, ;
		            &lcEstado       AS estado, ;
		            rub_codi, rub_desc, ;
		            &lcProvCodiSel  AS prov_codi_sel, ;
		            &lcProvNombSel  AS prov_nomb_sel, ;
		            &lcArtproCosto  AS artpro_costo, ;
		            &lcArtproMoneda AS artpro_moneda, ;
		            &lcArtproFecha  AS artpro_fecha, ;
		            &lcProvLista    AS prov_lista, ;
		            &lcColBack      AS col_back, ;
		            &lcColFore      AS col_fore, ;
		            CAST('' AS C(8)) AS ui_item, ;
		            CAST(.F. AS L)   AS ui_sel ;
		        FROM cur_raw_full ;
		        WHERE SEEK(cur_raw_full.art_codi, "cur_dep_filtro", "tdep_idx") ;
		        ORDER BY art_desc ASC ;
		        INTO CURSOR cur_temp READWRITE
		    ENDIF
		
		    IF USED("cur_dep_filtro")
		        USE IN cur_dep_filtro
		    ENDIF
		
		OTHERWISE
		    MESSAGEBOX("No existe la condición solicitada para DEPURACION.", 16, "Error")
		    RETURN .F.
		ENDCASE
		
		RETURN USED("cur_temp")
	ENDPROC

	PROCEDURE aplicarfiltrohistorialsecundario
		*=========================================================
		* FormSet.AplicarFiltroHistorialSecundario
		* Aplica filtro por txt_fecdes_hist / txt_fechas_hist
		*=========================================================
		LOCAL loSec
		LOCAL ldDesde, ldHasta
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN .F.
		ENDIF
		
		loSec = THISFORMSET.secundario
		
		IF VARTYPE(loSec) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loSec, "txt_fecdes_hist", 5) OR ;
		   !PEMSTATUS(loSec, "txt_fechas_hist", 5)
		    RETURN .F.
		ENDIF
		
		ldDesde = loSec.txt_fecdes_hist.Value
		ldHasta = loSec.txt_fechas_hist.Value
		
		IF VARTYPE(ldDesde) <> "D" OR EMPTY(ldDesde)
		    ldDesde = GOMONTH(DATE(), -12)
		    loSec.txt_fecdes_hist.Value = ldDesde
		ENDIF
		
		IF VARTYPE(ldHasta) <> "D" OR EMPTY(ldHasta)
		    ldHasta = DATE()
		    loSec.txt_fechas_hist.Value = ldHasta
		ENDIF
		
		IF ldDesde > ldHasta
		    ldHasta = ldDesde
		    loSec.txt_fechas_hist.Value = ldHasta
		ENDIF
		
		IF PEMSTATUS(loSec, "xHistFecDes", 5)
		    loSec.xHistFecDes = ldDesde
		ELSE
		    loSec.AddProperty("xHistFecDes", ldDesde)
		ENDIF
		
		IF PEMSTATUS(loSec, "xHistFecHas", 5)
		    loSec.xHistFecHas = ldHasta
		ELSE
		    loSec.AddProperty("xHistFecHas", ldHasta)
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "CargarHistorialSolicitudesFiltrado", 5)
		    THISFORMSET.CargarHistorialSolicitudesFiltrado(ldDesde, ldHasta)
		ENDIF
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE aplicarfiltrolocal
		*=========================================================
		* FormSet.AplicarFiltroLocal
		* Coordinador estable
		*=========================================================
		LPARAMETERS tcFiltro, tnFiltroValor
		LOCAL loFrm, loConsulta
		LOCAL llOk
		LOCAL lcArtproFecha, lcProvLista, lcColBack, lcColFore
		
		loFrm = THISFORMSET.principal
		llOk  = .F.
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		*---------------------------------------------------------
		* Normalizar filtro
		*---------------------------------------------------------
		IF VARTYPE(tcFiltro) <> "C"
		    tcFiltro = "TODOS"
		ENDIF
		tcFiltro = UPPER(ALLTRIM(tcFiltro))
		
		IF VARTYPE(tnFiltroValor) <> "N"
		    tnFiltroValor = 0
		ENDIF
		
		IF !USED("cur_raw_full") AND tcFiltro <> "SELECCIONADOS" AND tcFiltro <> "PEDIDOS"
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_alerts")
		    MESSAGEBOX("cur_alerts no existe. Debe crearse en Init.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Limpiar temporales
		*---------------------------------------------------------
		IF USED("cur_temp")
		    USE IN cur_temp
		ENDIF
		
		IF USED("cur_raw_cart_tmp")
		    USE IN cur_raw_cart_tmp
		ENDIF
		
		IF USED("cur_sorted")
		    USE IN cur_sorted
		ENDIF
		
		*---------------------------------------------------------
		* Construir cur_temp según filtro
		*---------------------------------------------------------
		DO CASE
		CASE tcFiltro == "PEDIDOS"
		    IF PEMSTATUS(THISFORMSET, "CargarFiltroPedidos", 5)
		        llOk = THISFORMSET.CargarFiltroPedidos()
		    ENDIF
		
		CASE tcFiltro == "SELECCIONADOS"
		    IF PEMSTATUS(THISFORMSET, "ConstruirCurTempSeleccionados", 5)
		        llOk = THISFORMSET.ConstruirCurTempSeleccionados()
		    ENDIF
		
		CASE tcFiltro == "DEPURACION"
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroDepuracion", 5)
		        llOk = THISFORMSET.AplicarFiltroDepuracion(tnFiltroValor)
		    ELSE
		        MESSAGEBOX("No existe el método AplicarFiltroDepuracion en el FormSet.", 16, "Error")
		        RETURN .F.
		    ENDIF
		
		CASE tcFiltro == "PROVEEDOR"
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroProveedor", 5)
		        llOk = THISFORMSET.AplicarFiltroProveedor(tnFiltroValor)
		    ELSE
		        MESSAGEBOX("No existe el método AplicarFiltroProveedor en el FormSet.", 16, "Error")
		        RETURN .F.
		    ENDIF
		
		OTHERWISE
		    IF PEMSTATUS(THISFORMSET, "ConstruirCurTempDesdeCurRawFull", 5)
		        llOk = THISFORMSET.ConstruirCurTempDesdeCurRawFull(tcFiltro, tnFiltroValor)
		    ENDIF
		ENDCASE
		
		*---------------------------------------------------------
		* PROVEEDOR ya resolvió todo internamente (incl. RefrescarGrid)
		*---------------------------------------------------------
		IF tcFiltro == "PROVEEDOR"
		    IF PEMSTATUS(THISFORMSET, "ActualizarVisibilidadColumnaObservacion", 5)
		        THISFORMSET.ActualizarVisibilidadColumnaObservacion()
		    ENDIF
		    RETURN llOk
		ENDIF
		
		IF !llOk OR !USED("cur_temp")
		    RETURN llOk
		ENDIF
		
		*---------------------------------------------------------
		* Volcado estable cur_temp -> cur_alerts
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "VolcarCurTempEnCurAlerts", 5)
		    IF !THISFORMSET.VolcarCurTempEnCurAlerts()
		        RETURN .F.
		    ENDIF
		ELSE
		    RETURN .F.
		ENDIF
		
		
		
		*!*	*---------------------------------------------------------
		*!*	* Subfiltro extra para PEDIDOS segun combo5
		*!*	*---------------------------------------------------------
		*!*	IF tcFiltro == "PEDIDOS" AND USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0
		*!*	    LOCAL lcModoPedidos, lcSafetyPedidos
		
		*!*	    lcModoPedidos = ""
		*!*	    IF PEMSTATUS(loFrm, "xPedidosModoFiltro", 5)
		*!*	        lcModoPedidos = UPPER(ALLTRIM(TRANSFORM(loFrm.xPedidosModoFiltro)))
		*!*	    ENDIF
		
		*!*	    IF lcModoPedidos == "POSICION < (POS.MINIMO + % ALERTA)"
		*!*	        IF USED("cur_pedidos_filtrado")
		*!*	            USE IN cur_pedidos_filtrado
		*!*	        ENDIF
		
		*!*	        SELECT * ;
		*!*	        FROM cur_alerts ;
		*!*	        WHERE NVL(posicion, 0) < ( NVL(art_stmin, 0) + ( NVL(art_stmin, 0) * ( NVL(art_pct_alerta, 0) / 100 ) ) ) ;
		*!*	        INTO CURSOR cur_pedidos_filtrado READWRITE
		
		*!*	        lcSafetyPedidos = SET("SAFETY")
		*!*	        SET SAFETY OFF
		
		*!*	        SELECT cur_alerts
		*!*	        ZAP
		
		*!*	        IF USED("cur_pedidos_filtrado") AND RECCOUNT("cur_pedidos_filtrado") > 0
		*!*	            INSERT INTO cur_alerts ;
		*!*	            SELECT * FROM cur_pedidos_filtrado
		*!*	        ENDIF
		
		*!*	        IF UPPER(ALLTRIM(lcSafetyPedidos)) == "ON"
		*!*	            SET SAFETY ON
		*!*	        ELSE
		*!*	            SET SAFETY OFF
		*!*	        ENDIF
		
		*!*	        IF USED("cur_pedidos_filtrado")
		*!*	            USE IN cur_pedidos_filtrado
		*!*	        ENDIF
		*!*	    ENDIF
		*!*	ENDIF
		
		
		
		
		
		
		
		*---------------------------------------------------------
		* Subfiltro extra para PEDIDOS segun combo5
		*---------------------------------------------------------
		IF tcFiltro == "PEDIDOS" AND USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0
		    LOCAL lcModoPedidos, lcSafetyPedidos
		
		    lcModoPedidos = ""
		    IF PEMSTATUS(loFrm, "xPedidosModoFiltro", 5)
		        lcModoPedidos = UPPER(ALLTRIM(TRANSFORM(loFrm.xPedidosModoFiltro)))
		    ENDIF
		
		    DO CASE
		
		    CASE lcModoPedidos == "POSICION < (POS.MINIMO + % ALERTA)"
		        IF USED("cur_pedidos_filtrado")
		            USE IN cur_pedidos_filtrado
		        ENDIF
		
		        SELECT * ;
		        FROM cur_alerts ;
		        WHERE NVL(posicion, 0) < ( NVL(art_stmin, 0) + ( NVL(art_stmin, 0) * ( NVL(art_pct_alerta, 0) / 100 ) ) ) ;
		        INTO CURSOR cur_pedidos_filtrado READWRITE
		
		        lcSafetyPedidos = SET("SAFETY")
		        SET SAFETY OFF
		
		        SELECT cur_alerts
		        ZAP
		
		        IF USED("cur_pedidos_filtrado") AND RECCOUNT("cur_pedidos_filtrado") > 0
		            INSERT INTO cur_alerts ;
		            SELECT * FROM cur_pedidos_filtrado
		        ENDIF
		
		        IF UPPER(ALLTRIM(lcSafetyPedidos)) == "ON"
		            SET SAFETY ON
		        ELSE
		            SET SAFETY OFF
		        ENDIF
		
		        IF USED("cur_pedidos_filtrado")
		            USE IN cur_pedidos_filtrado
		        ENDIF
		
		    CASE lcModoPedidos == "COMPRA SUGERIDA > 0"
		        IF USED("cur_pedidos_filtrado")
		            USE IN cur_pedidos_filtrado
		        ENDIF
		
		        SELECT * ;
		        FROM cur_alerts ;
		        WHERE NVL(sugerido_comprar, 0) > 0 ;
		        INTO CURSOR cur_pedidos_filtrado READWRITE
		
		        lcSafetyPedidos = SET("SAFETY")
		        SET SAFETY OFF
		
		        SELECT cur_alerts
		        ZAP
		
		        IF USED("cur_pedidos_filtrado") AND RECCOUNT("cur_pedidos_filtrado") > 0
		            INSERT INTO cur_alerts ;
		            SELECT * FROM cur_pedidos_filtrado
		        ENDIF
		
		        IF UPPER(ALLTRIM(lcSafetyPedidos)) == "ON"
		            SET SAFETY ON
		        ELSE
		            SET SAFETY OFF
		        ENDIF
		
		        IF USED("cur_pedidos_filtrado")
		            USE IN cur_pedidos_filtrado
		        ENDIF
		
		    CASE lcModoPedidos == "TODOS"
		        * No aplicar subfiltro extra
		
		    ENDCASE
		ENDIF
		
		
		
		
		
		
		
		
		
		
		
		*---------------------------------------------------------
		* Enriquecer / sincronizar
		*---------------------------------------------------------
		IF tcFiltro <> "DEPURACION"
		    *-- Ya vienen resueltos desde CargarAlertasStockFull en MySQL:
		    *-- prov_codi_sel, prov_nomb_sel, artpro_costo, artpro_moneda, prov_lista
		
		    IF PEMSTATUS(THISFORMSET, "CargarUltProvCompra", 5)
		        THISFORMSET.CargarUltProvCompra()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "SincronizarSeleccionDesdeTemp", 5)
		        THISFORMSET.SincronizarSeleccionDesdeTemp()
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* Blindaje de campos opcionales de cur_alerts
		*---------------------------------------------------------
		lcArtproFecha = IIF(TYPE("cur_alerts.artpro_fecha") = "U", ;
		    "CAST({} AS D)", ;
		    "CAST(NVL(cur_alerts.artpro_fecha,{}) AS D)")
		
		lcProvLista = IIF(TYPE("cur_alerts.prov_lista") = "U", ;
		    "CAST('' AS M)", ;
		    "CAST(NVL(cur_alerts.prov_lista,'') AS M)")
		
		lcColBack = IIF(TYPE("cur_alerts.col_back") = "U", ;
		    "CAST(0 AS N(12,0))", ;
		    "CAST(NVL(cur_alerts.col_back,0) AS N(12,0))")
		
		lcColFore = IIF(TYPE("cur_alerts.col_fore") = "U", ;
		    "CAST(0 AS N(12,0))", ;
		    "CAST(NVL(cur_alerts.col_fore,0) AS N(12,0))")
		
		*---------------------------------------------------------
		* Guardar filtro actual ANTES de reordenar/refrescar
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "xFiltroActual", 5)
		    loFrm.xFiltroActual = tcFiltro
		ENDIF
		
		*---------------------------------------------------------
		* Reordenar sin reconstruir cur_alerts
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ReaplicarOrdenActualCurAlerts", 5)
		    llOk = THISFORMSET.ReaplicarOrdenActualCurAlerts()
		ELSE
		    llOk = .F.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarVisibilidadColumnaObservacion", 5)
		    THISFORMSET.ActualizarVisibilidadColumnaObservacion()
		ENDIF
		
		RETURN llOk
	ENDPROC

	PROCEDURE aplicarfiltroproveedor
		*=========================================================
		* FormSet.AplicarFiltroProveedor
		*=========================================================
		LPARAMETERS tnProvCodi
		LOCAL loFrm
		LOCAL lnConn, lnRet, lcSQL
		LOCAL laErr[1], lcMsg
		LOCAL lnItem
		LOCAL lcProvNomb
		LOCAL lcSafety
		loFrm = THISFORMSET.principal
		IF VARTYPE(tnProvCodi) <> "N" OR tnProvCodi <= 0
		    RETURN .F.
		ENDIF
		IF !USED("cur_raw_full")
		    MESSAGEBOX("cur_raw_full no existe.", 16, "Proveedor")
		    RETURN .F.
		ENDIF
		IF !USED("cur_alerts")
		    MESSAGEBOX("cur_alerts no existe.", 16, "Proveedor")
		    RETURN .F.
		ENDIF
		IF USED("cur_temp")
		    USE IN cur_temp
		ENDIF
		IF USED("cur_aprov")
		    USE IN cur_aprov
		ENDIF
		IF USED("cur_sorted")
		    USE IN cur_sorted
		ENDIF
		lcProvNomb = ""
		*---------------------------------------------------------
		* 1) Traer artículos del proveedor seleccionado
		*---------------------------------------------------------
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.", 16, "Proveedor")
		    RETURN .F.
		ENDIF
		TEXT TO lcSQL NOSHOW PRETEXT 15
		SELECT
		    apx.art_codi,
		    apx.prov_codi,
		    IFNULL(p.prov_nomb,'') AS prov_nomb,
		    COALESCE(
		        MAX(CASE WHEN ap.artpro_costo > 0 AND ap.cotiz = 1 THEN ap.artpro_costo END),
		        MIN(CASE WHEN ap.artpro_costo > 0 THEN ap.artpro_costo END),
		        0
		    ) AS artpro_costo,
		    COALESCE(
		        MAX(CASE WHEN ap.artpro_costo > 0 AND ap.cotiz = 1 THEN ap.moneda END),
		        MAX(ap.moneda),
		        ''
		    ) AS artpro_moneda
		FROM (
		    SELECT DISTINCT
		        art_codi,
		        prov_codi
		    FROM articulos_proveedores
		    WHERE prov_codi = ?tnProvCodi
		) apx
		LEFT JOIN articulos_proveedores ap
		       ON ap.art_codi  = apx.art_codi
		      AND ap.prov_codi = apx.prov_codi
		LEFT JOIN proveedores p
		       ON p.prov_codi = apx.prov_codi
		GROUP BY
		    apx.art_codi,
		    apx.prov_codi,
		    p.prov_nomb
		ORDER BY apx.art_codi
		ENDTEXT
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_aprov")
		IF lnRet < 0 OR !USED("cur_aprov")
		    IF AERROR(laErr) > 0
		        lcMsg = IIF(TYPE("laErr[1,3]") <> "U", TRANSFORM(laErr[1,3]), "Error SQL")
		    ELSE
		        lcMsg = "Error cargando artículos del proveedor."
		    ENDIF
		    Desconectar_DB(lnConn)
		    MESSAGEBOX(lcMsg, 16, "Proveedor")
		    RETURN .F.
		ENDIF
		IF RECCOUNT("cur_aprov") > 0
		    SELECT cur_aprov
		    GO TOP
		    lcProvNomb = ALLTRIM(NVL(cur_aprov.prov_nomb, ""))
		ENDIF
		Desconectar_DB(lnConn)
		*---------------------------------------------------------
		* 2) Si no hay artículos, crear cur_temp vacío
		*---------------------------------------------------------
		IF RECCOUNT("cur_aprov") = 0
		    IF PEMSTATUS(THISFORMSET, "CrearCurTempVacioAlerts", 5)
		        THISFORMSET.CrearCurTempVacioAlerts()
		    ENDIF
		    IF PEMSTATUS(THISFORMSET, "VolcarCurTempEnCurAlerts", 5)
		        THISFORMSET.VolcarCurTempEnCurAlerts()
		    ENDIF
		    IF USED("cur_aprov")
		        USE IN cur_aprov
		    ENDIF
		    IF PEMSTATUS(loFrm, "xFiltroActual", 5)
		        loFrm.xFiltroActual = "PROVEEDOR"
		    ENDIF
		    IF PEMSTATUS(loFrm, "xCombo2Mode", 5)
		        loFrm.xCombo2Mode = "PROVEEDOR"
		    ENDIF
		    IF PEMSTATUS(loFrm, "xCombo2ValorActual", 5)
		        loFrm.xCombo2ValorActual = tnProvCodi
		    ENDIF
		    IF PEMSTATUS(loFrm, "xProveedorCodiActual", 5)
		        loFrm.xProveedorCodiActual = tnProvCodi
		    ENDIF
		    IF PEMSTATUS(loFrm, "xCurRec", 5)
		        loFrm.xCurRec = 0
		    ENDIF
		    IF PEMSTATUS(loFrm, "xCurArt", 5)
		        loFrm.xCurArt = 0
		    ENDIF
		    IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		        THISFORMSET.SincronizarBotonMasivo()
		    ENDIF
		    IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		        THISFORMSET.RefrescarGrid()
		    ENDIF
		    RETURN .T.
		ENDIF   && ? cierra IF RECCOUNT("cur_aprov") = 0
		*---------------------------------------------------------
		* 3) Construir cur_temp forzando SIEMPRE el proveedor filtrado
		*---------------------------------------------------------
		SELECT ;
		    CAST(NVL(r.art_codi,0) AS I) AS art_codi, ;
		    CAST(NVL(r.art_desc,'') AS C(80)) AS art_desc, ;
		    CAST(NVL(r.art_stock,0) AS N(15,3)) AS art_stock, ;
		    CAST(NVL(r.art_stmin,0) AS N(15,3)) AS art_stmin, ;
		    CAST(NVL(r.art_pct_alerta,0) AS N(10,2)) AS art_pct_alerta, ;
		    CAST(NVL(r.pedidos,0) AS N(15,3)) AS pedidos, ;
		    CAST(NVL(r.pedprov,0) AS N(15,3)) AS pedprov, ;
		    CAST(NVL(r.posicion,0) AS N(15,3)) AS posicion, ;
		    CAST(NVL(r.sug_neto,0) AS N(15,3)) AS sug_neto, ;
		    CAST(NVL(r.pct_rotacion,0) AS N(10,3)) AS pct_rotacion, ;
		    CAST(NVL(r.ventas_metrics,'') AS M) AS ventas_metrics, ;
		    CAST(NVL(r.promedio_venta,0) AS N(15,3)) AS promedio_venta, ;
		    CAST(NVL(r.fecha_ult_venta,{}) AS D) AS fecha_ult_venta, ;
		    CAST(NVL(r.compras_metrics,'') AS M) AS compras_metrics, ;
		    CAST(NVL(r.promedio_compra,0) AS N(15,3)) AS promedio_compra, ;
		    CAST(NVL(r.fecha_ult_compra,{}) AS D) AS fecha_ult_compra, ;
		    CAST(NVL(r.dias_demora_ent,15) AS I) AS dias_demora_ent, ;
		    CAST(NVL(r.pos_min_sug,0) AS N(15,3)) AS pos_min_sug, ;
		    CAST(NVL(r.sugerido_comprar,0) AS N(15,3)) AS sugerido_comprar, ;
		    CAST(NVL(r.cant_soli,0) AS N(15,3)) AS cant_soli, ;
		    CAST(NVL(r.meses_cubiertos,0) AS N(15,3)) AS meses_cubiertos, ;
		    CAST(NVL(r.meses_cob_proy,0) AS N(15,3)) AS meses_cob_proy, ;
		    CAST(NVL(r.meses_cobert_solic,3) AS N(15,3)) AS meses_cobert_solic, ;
		    CAST(NVL(r.score,0) AS I) AS score, ;
		    CAST(NVL(r.estado,1) AS I) AS estado, ;
		    CAST(NVL(r.rub_codi,0) AS I) AS rub_codi, ;
		    CAST(NVL(r.rub_desc,'') AS C(60)) AS rub_desc, ;
		    CAST(NVL(a.prov_codi,0) AS I) AS prov_codi_sel, ;
		    CAST(NVL(a.prov_nomb,'') AS C(80)) AS prov_nomb_sel, ;
		    CAST(NVL(a.artpro_costo,0) AS N(15,4)) AS artpro_costo, ;
		    CAST(NVL(a.artpro_moneda,'') AS C(1)) AS artpro_moneda, ;
		    CAST({} AS D) AS artpro_fecha, ;
		    CAST(NVL(r.prov_lista,'') AS M) AS prov_lista, ;
		    CAST(0 AS N(12,0)) AS col_back, ;
		    CAST(0 AS N(12,0)) AS col_fore, ;
		    CAST('' AS C(8)) AS ui_item, ;
		    CAST(.F. AS L) AS ui_sel ;
		FROM cur_raw_full r ;
		JOIN cur_aprov a ;
		    ON a.art_codi = r.art_codi ;
		WHERE NVL(r.estado,1) = 1 ;
		ORDER BY r.art_desc ;
		INTO CURSOR cur_temp READWRITE
		USE IN cur_aprov
		IF !USED("cur_temp")
		    RETURN .F.
		ENDIF
		*---------------------------------------------------------
		* 4) Volcar cur_temp -> cur_alerts
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "VolcarCurTempEnCurAlerts", 5)
		    IF !THISFORMSET.VolcarCurTempEnCurAlerts()
		        RETURN .F.
		    ENDIF
		ELSE
		    RETURN .F.
		ENDIF
		*---------------------------------------------------------
		* 5) Sincronizar selección real desde temp
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "SincronizarSeleccionDesdeTemp", 5)
		    THISFORMSET.SincronizarSeleccionDesdeTemp()
		ENDIF
		*---------------------------------------------------------
		* 6) Reforzar nuevamente proveedor filtrado
		*---------------------------------------------------------
		SELECT cur_alerts
		GO TOP
		SCAN
		    REPLACE prov_codi_sel WITH tnProvCodi
		    IF !EMPTY(lcProvNomb)
		        REPLACE prov_nomb_sel WITH lcProvNomb
		    ENDIF
		ENDSCAN
		*---------------------------------------------------------
		* 7) Reordenar por importancia de compra
		*---------------------------------------------------------
		IF USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0
			SELECT ;
			    art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
			    pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
			    ventas_metrics, promedio_venta, fecha_ult_venta, ;
			    compras_metrics, promedio_compra, fecha_ult_compra, ;
			    dias_demora_ent, pos_min_sug, sugerido_comprar, ;
			    cant_soli, meses_cubiertos, meses_cob_proy, meses_cobert_solic, ;
			    score, rub_codi, rub_desc, estado, ;
			    prov_codi_sel, prov_nomb_sel, artpro_costo, artpro_moneda, artpro_fecha, ;
			    prov_lista, col_back, col_fore, ui_item, ui_sel ;
			FROM cur_alerts ;
			ORDER BY sugerido_comprar DESC, pct_rotacion DESC, art_desc ASC ;
			INTO CURSOR cur_sorted READWRITE
		
		    IF USED("cur_sorted")
		        lcSafety = SET("SAFETY")
		        SET SAFETY OFF
		
		        SELECT cur_alerts
		        ZAP
		
				INSERT INTO cur_alerts ;
				    ( art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
				      pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
				      ventas_metrics, promedio_venta, fecha_ult_venta, ;
				      compras_metrics, promedio_compra, fecha_ult_compra, ;
				      dias_demora_ent, pos_min_sug, sugerido_comprar, ;
				      cant_soli, meses_cubiertos, meses_cob_proy, meses_cobert_solic, ;
				      score, rub_codi, rub_desc, estado, ;
				      prov_codi_sel, prov_nomb_sel, artpro_costo, artpro_moneda, artpro_fecha, ;
				      prov_lista, col_back, col_fore, ui_item, ui_sel ) ;
				SELECT ;
				      art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
				      pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
				      ventas_metrics, promedio_venta, fecha_ult_venta, ;
				      compras_metrics, promedio_compra, fecha_ult_compra, ;
				      dias_demora_ent, pos_min_sug, sugerido_comprar, ;
				      cant_soli, meses_cubiertos, meses_cob_proy, meses_cobert_solic, ;
				      score, rub_codi, rub_desc, estado, ;
				      prov_codi_sel, prov_nomb_sel, artpro_costo, artpro_moneda, artpro_fecha, ;
				      prov_lista, col_back, col_fore, ui_item, ui_sel ;
				FROM cur_sorted
		
		        IF UPPER(ALLTRIM(lcSafety)) == "ON"
		            SET SAFETY ON
		        ELSE
		            SET SAFETY OFF
		        ENDIF
		
		        USE IN cur_sorted
		    ENDIF
		ENDIF
		*---------------------------------------------------------
		* 8) Numerar + TOP + estado UI
		*---------------------------------------------------------
		lnItem = 0
		SELECT cur_alerts
		GO TOP
		SCAN
		    lnItem = lnItem + 1
		    REPLACE ui_item WITH ALLTRIM(STR(lnItem))
		ENDSCAN
		GO TOP
		IF PEMSTATUS(loFrm, "xFiltroActual", 5)
		    loFrm.xFiltroActual = "PROVEEDOR"
		ENDIF
		IF PEMSTATUS(loFrm, "xCombo2Mode", 5)
		    loFrm.xCombo2Mode = "PROVEEDOR"
		ENDIF
		IF PEMSTATUS(loFrm, "xCombo2ValorActual", 5)
		    loFrm.xCombo2ValorActual = tnProvCodi
		ENDIF
		IF PEMSTATUS(loFrm, "xProveedorCodiActual", 5)
		    loFrm.xProveedorCodiActual = tnProvCodi
		ENDIF
		IF USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0
		    SELECT cur_alerts
		    GO TOP
		    IF PEMSTATUS(loFrm, "xCurRec", 5)
		        loFrm.xCurRec = RECNO("cur_alerts")
		    ENDIF
		    IF PEMSTATUS(loFrm, "xCurArt", 5)
		        loFrm.xCurArt = IIF(TYPE("cur_alerts.art_codi") = "N", cur_alerts.art_codi, 0)
		    ENDIF
		ELSE
		    IF PEMSTATUS(loFrm, "xCurRec", 5)
		        loFrm.xCurRec = 0
		    ENDIF
		    IF PEMSTATUS(loFrm, "xCurArt", 5)
		        loFrm.xCurArt = 0
		    ENDIF
		ENDIF
		IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		    THISFORMSET.SincronizarBotonMasivo()
		ENDIF
		*---------------------------------------------------------
		* RefrescarGrid: reaplica los 13 ControlSources + lbl_cont
		*               + ActualizarEfectoGrid
		* xFiltroActual ya está seteado a "PROVEEDOR" arriba
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		    THISFORMSET.RefrescarGrid()
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE aplicarpostuifiltroalerts
		*=========================================================
		* FormSet.AplicarPostUIFiltroAlerts
		*=========================================================
		LPARAMETERS tcFiltro
		
		LOCAL loFrm
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		    THISFORMSET.SincronizarBotonMasivo()
		ENDIF
		
		IF PEMSTATUS(loFrm, "lbl_cont", 5)
		    loFrm.lbl_cont.Caption = TRANSFORM(RECCOUNT("cur_alerts")) + " reg."
		ENDIF
		
		IF PEMSTATUS(loFrm, "grd_alerts", 5)
		    IF tcFiltro == "SELECCIONADOS"
		        loFrm.grd_alerts.Columns(9).ControlSource = "cur_alerts.cant_soli"
		    ELSE
		        loFrm.grd_alerts.Columns(9).ControlSource = "cur_alerts.sugerido_comprar"
		    ENDIF
		
		    loFrm.grd_alerts.RecordSource = "cur_alerts"
		    loFrm.grd_alerts.Refresh()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE autoasignarproveedormincosto
		*=========================================================
		* FormSet.AutoAsignarProveedorMinCosto
		* Para cada art en cur_alerts donde prov_codi_sel = 0:
		*   - busca proveedor con MIN(artpro_costo) > 0 y cotiz = 1
		*   - si existe: asigna prov_codi_sel, prov_nomb_sel,
		*                artpro_costo, artpro_moneda
		*   - si no existe: deja las celdas vacías
		* NO toca registros donde prov_codi_sel > 0
		*   (el usuario ya eligió manualmente)
		*=========================================================
		LOCAL lnConn, lnRet, lcInList, lcSQL, lnSaved, lnCodi_
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0
		    RETURN .F.
		ENDIF
		
		IF TYPE("cur_alerts.prov_codi_sel") = "U"
		    RETURN .F.
		ENDIF
		
		IF USED("cur_min_prov_tmp")
		    USE IN cur_min_prov_tmp
		ENDIF
		
		*---------------------------------------------------------
		* 1) Armar lista solo de artículos sin proveedor asignado
		*---------------------------------------------------------
		lcInList = ""
		
		SELECT cur_alerts
		SCAN FOR NVL(prov_codi_sel, 0) = 0
		    lcInList = lcInList + TRANSFORM(art_codi) + ","
		ENDSCAN
		
		IF EMPTY(ALLTRIM(CHRTRAN(lcInList, ",", "")))
		    RETURN .T.   && todos ya tienen proveedor
		ENDIF
		
		lcInList = LEFT(lcInList, LEN(lcInList) - 1)
		
		*---------------------------------------------------------
		* 2) Conectar
		*---------------------------------------------------------
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 3) Traer proveedor de menor costo > 0 con cotiz = 1
		*    Orden estable por art_codi, artpro_costo, prov_codi
		*---------------------------------------------------------
		TEXT TO lcSQL NOSHOW
		SELECT
		    ap.art_codi,
		    IFNULL(p.prov_nomb,'')    AS prov_nomb,
		    ap.prov_codi,
			CAST(IFNULL(ap.artpro_costo,0) AS DECIMAL(15,4)) AS artpro_costo,
			IFNULL(ap.moneda,'') AS moneda
		FROM articulos_proveedores ap
		INNER JOIN proveedores p
		    ON p.prov_codi = ap.prov_codi
		INNER JOIN (
		    SELECT
		        art_codi,
		        MIN(artpro_costo) AS min_costo
		    FROM articulos_proveedores
		    WHERE art_codi IN (<<lcInList>>)
		      AND cotiz = 1
		      AND artpro_costo > 0
		    GROUP BY art_codi
		) mc
		    ON mc.art_codi  = ap.art_codi
		   AND mc.min_costo = ap.artpro_costo
		WHERE ap.art_codi IN (<<lcInList>>)
		  AND ap.cotiz = 1
		  AND ap.artpro_costo > 0
		ORDER BY ap.art_codi, ap.artpro_costo, ap.prov_codi
		ENDTEXT
		
		lcSQL = STRTRAN(lcSQL, "<<lcInList>>", lcInList)
		
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_min_prov_tmp")
		Desconectar_DB(lnConn)
		
		IF lnRet <= 0 OR !USED("cur_min_prov_tmp")
		    IF USED("cur_min_prov_tmp")
		        USE IN cur_min_prov_tmp
		    ENDIF
		    RETURN .F.
		ENDIF
		
		SELECT cur_min_prov_tmp
		INDEX ON art_codi TAG art_codi
		
		*---------------------------------------------------------
		* 4) Actualizar cur_alerts fila por fila
		*    Solo donde prov_codi_sel = 0
		*---------------------------------------------------------
		SELECT cur_alerts
		lnSaved = IIF(RECCOUNT("cur_alerts") > 0 AND !EOF("cur_alerts"), RECNO("cur_alerts"), 0)
		
		SCAN FOR NVL(prov_codi_sel, 0) = 0
		    lnCodi_ = cur_alerts.art_codi
		
		    IF SEEK(lnCodi_, "cur_min_prov_tmp", "art_codi")
		        *-- Asignación DIRECTA numérica: no usar TRANSFORM/VAL
		        REPLACE ;
		            prov_codi_sel WITH NVL(cur_min_prov_tmp.prov_codi, 0), ;
		            prov_nomb_sel WITH ALLTRIM(NVL(cur_min_prov_tmp.prov_nomb, "")), ;
		            artpro_costo  WITH NVL(cur_min_prov_tmp.artpro_costo, 0), ;
		            artpro_moneda WITH ALLTRIM(NVL(cur_min_prov_tmp.moneda, ""))
		    ELSE
		        REPLACE ;
		            prov_codi_sel WITH 0, ;
		            prov_nomb_sel WITH "", ;
		            artpro_costo  WITH 0, ;
		            artpro_moneda WITH ""
		    ENDIF
		ENDSCAN
		
		*---------------------------------------------------------
		* 5) Restaurar posición
		*---------------------------------------------------------
		IF BETWEEN(lnSaved, 1, RECCOUNT("cur_alerts"))
		    SELECT cur_alerts
		    GO lnSaved
		ENDIF
		
		IF USED("cur_min_prov_tmp")
		    USE IN cur_min_prov_tmp
		ENDIF
		
		RETURN .T.
		
		
		*!*	*=========================================================
		*!*	* FormSet.AutoAsignarProveedorMinCosto
		*!*	* Para cada art en cur_alerts donde prov_codi_sel = 0:
		*!*	*   ? busca proveedor con MIN(artpro_costo) > 0 y cotiz = 1
		*!*	*   ? si existe: asigna prov_codi_sel, prov_nomb_sel,
		*!*	*                artpro_costo, artpro_moneda
		*!*	*   ? si no existe: deja las celdas vacías
		*!*	* NO toca registros donde prov_codi_sel > 0
		*!*	*   (el usuario ya eligió manualmente)
		*!*	*=========================================================
		*!*	IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0
		*!*	    RETURN
		*!*	ENDIF
		*!*	IF TYPE("cur_alerts.prov_codi_sel") = "U"
		*!*	    RETURN
		*!*	ENDIF
		*!*	LOCAL lnConn, lnRet, lcInList, lcSQL, lnSaved, lnCodi_
		*!*	*--- Solo armar la lista de los que NO tienen proveedor asignado
		*!*	lcInList = ""
		*!*	SELECT cur_alerts
		*!*	SCAN FOR prov_codi_sel = 0
		*!*	    lcInList = lcInList + TRANSFORM(art_codi) + ","
		*!*	ENDSCAN
		*!*	IF EMPTY(ALLTRIM(CHRTRAN(lcInList, ",", "")))
		*!*	    RETURN  && todos ya tienen proveedor
		*!*	ENDIF
		*!*	lcInList = LEFT(lcInList, LEN(lcInList) - 1)  && quitar última coma
		*!*	lnConn = Conectar_DB(_screen.cn)
		*!*	IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		*!*	    RETURN
		*!*	ENDIF
		*!*	*--- Un solo query: min costo > 0 con cotiz = 1 por artículo
		*!*	lcSQL = "SELECT ap.art_codi, p.prov_nomb, ap.prov_codi, " + ;
		*!*	        "       ap.artpro_costo, IFNULL(ap.moneda,'') AS moneda " + ;
		*!*	        "FROM articulos_proveedores ap " + ;
		*!*	        "INNER JOIN proveedores p ON p.prov_codi = ap.prov_codi " + ;
		*!*	        "INNER JOIN ( " + ;
		*!*	        "    SELECT art_codi, MIN(artpro_costo) AS min_costo " + ;
		*!*	        "    FROM articulos_proveedores " + ;
		*!*	        "    WHERE art_codi IN (" + lcInList + ") " + ;
		*!*	        "      AND cotiz = 1 " + ;
		*!*	        "      AND artpro_costo > 0 " + ;
		*!*	        "    GROUP BY art_codi " + ;
		*!*	        ") mc ON mc.art_codi = ap.art_codi " + ;
		*!*	        "      AND mc.min_costo = ap.artpro_costo " + ;
		*!*	        "WHERE ap.art_codi IN (" + lcInList + ") " + ;
		*!*	        "  AND ap.cotiz = 1 " + ;
		*!*	        "  AND ap.artpro_costo > 0"
		*!*	lnRet = SQLEXEC(lnConn, lcSQL, "cur_min_prov_tmp")
		*!*	Desconectar_DB(lnConn)
		*!*	IF lnRet <= 0 OR !USED("cur_min_prov_tmp")
		*!*	    IF USED("cur_min_prov_tmp")
		*!*	        USE IN cur_min_prov_tmp
		*!*	    ENDIF
		*!*	    RETURN
		*!*	ENDIF
		*!*	*--- Actualizar cur_alerts fila por fila (solo prov_codi_sel = 0)
		*!*	lnSaved = RECNO("cur_alerts")
		*!*	SELECT cur_alerts
		*!*	SCAN FOR prov_codi_sel = 0
		*!*	    lnCodi_ = cur_alerts.art_codi
		*!*	    SELECT cur_min_prov_tmp
		*!*	    LOCATE FOR art_codi = lnCodi_
		*!*	    IF FOUND()
		*!*	        *--- Hay proveedor válido ? asignar
		*!*	        SELECT cur_alerts
		*!*			REPLACE prov_codi_sel WITH VAL(TRANSFORM(cur_min_prov_tmp.prov_codi)), ;
		*!*			        prov_nomb_sel WITH ALLTRIM(cur_min_prov_tmp.prov_nomb), ;
		*!*			        artpro_costo  WITH VAL(STRTRAN(ALLTRIM(TRANSFORM(cur_min_prov_tmp.artpro_costo)), ",", ".")), ;
		*!*			        artpro_moneda WITH ALLTRIM(cur_min_prov_tmp.moneda)
		*!*	    ELSE
		*!*	        *--- Sin proveedor válido ? celdas vacías
		*!*	        SELECT cur_alerts
		*!*	        REPLACE prov_codi_sel WITH 0,  ;
		*!*	                prov_nomb_sel WITH "", ;
		*!*	                artpro_costo  WITH 0,  ;
		*!*	                artpro_moneda WITH ""
		*!*	    ENDIF
		*!*	ENDSCAN
		*!*	IF BETWEEN(lnSaved, 1, RECCOUNT("cur_alerts"))
		*!*	    SELECT cur_alerts
		*!*	    GO lnSaved
		*!*	ENDIF
		*!*	IF USED("cur_min_prov_tmp")
		*!*	    USE IN cur_min_prov_tmp
		*!*	ENDIF
		*!*	RETURN
	ENDPROC

	PROCEDURE bindmetrictexts
		*=========================================================
		* FormSet.BindMetricTexts
		* Solo enlaza los datos, respetando el diseño visual
		*=========================================================
		LOCAL loFrm, loConsulta
		LOCAL lcAlias
		LOCAL lnBackColor, lnForeColor
		
		loFrm      = THISFORMSET.principal
		loConsulta = THISFORMSET.secundario
		
		lcAlias      = "cur_alerts"
		lnBackColor  = RGB(40, 44, 52)
		lnForeColor  = RGB(220, 220, 220)
		
		IF !USED(lcAlias)
		    RETURN .F.
		ENDIF
		
		SELECT cur_alerts
		
		IF PEMSTATUS(loFrm, "Text4", 5)
		    loFrm.Text4.ControlSource = lcAlias + ".promedio_venta"
		    loFrm.Text4.InputMask     = "999999999999.99"
		    loFrm.Text4.BackColor     = lnBackColor
		    loFrm.Text4.ForeColor     = lnForeColor
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text11", 5)
		    loFrm.Text11.ControlSource = lcAlias + ".pos_min_sug"
		    loFrm.Text11.InputMask     = "999999999999.99"
		    loFrm.Text11.BackColor     = lnBackColor
		    loFrm.Text11.ForeColor     = lnForeColor
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text13", 5)
		    loFrm.Text13.ControlSource = lcAlias + ".meses_cubiertos"
		    loFrm.Text13.InputMask     = "999999999999.99"
		    loFrm.Text13.BackColor     = lnBackColor
		    loFrm.Text13.ForeColor     = lnForeColor
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text12", 5)
		    loFrm.Text12.ControlSource = lcAlias + ".sugerido_comprar"
		    loFrm.Text12.InputMask     = "999999999999.99"
		    loFrm.Text12.BackColor     = lnBackColor
		    loFrm.Text12.ForeColor     = lnForeColor
		ENDIF
		
		*---------------------------------------------------------
		* TOTALES CALCULADOS (Se asignan en RefreshVentaCompraGrid)
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "Text1", 5)
		    loFrm.Text1.ControlSource = ""
		ENDIF
		
		IF PEMSTATUS(loFrm, "Text2", 5)
		    loFrm.Text2.ControlSource = ""
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE bloquearedicionobservacionsecundario
		*=========================================================
		* FormSet.BloquearEdicionObservacionSecundario
		* Deja edit1 en modo NO edición
		*=========================================================
		LPARAMETERS tcValorObs
		
		LOCAL loSec, lcObs
		
		loSec = .NULL.
		lcObs = ""
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loSec = THISFORMSET.secundario
		ENDIF
		
		IF VARTYPE(loSec) <> "O"
		    RETURN .F.
		ENDIF
		
		DO CASE
		CASE VARTYPE(tcValorObs) = "C"
		    lcObs = tcValorObs
		CASE VARTYPE(tcValorObs) = "M"
		    lcObs = tcValorObs
		OTHERWISE
		    IF PEMSTATUS(loSec, "edit1", 5)
		        IF VARTYPE(loSec.edit1.Value) $ "CM"
		            lcObs = loSec.edit1.Value
		        ELSE
		            lcObs = ""
		        ENDIF
		    ENDIF
		ENDCASE
		
		IF PEMSTATUS(loSec, "edit1", 5)
		    WITH loSec.edit1
		        .Value     = m.lcObs
		        .ReadOnly  = .T.
		        .Enabled   = .F.
		        .BackColor = RGB(245,245,245)
		        .ForeColor = RGB(0,0,0)
		        .Refresh()
		    ENDWITH
		ENDIF
		
		IF PEMSTATUS(loSec, "command3", 5)
		    loSec.command3.Caption = "EDITAR"
		    loSec.command3.Enabled = IIF(PEMSTATUS(loSec, "xSoliCodiActual", 5), loSec.xSoliCodiActual > 0, .F.)
		    loSec.command3.Refresh()
		ENDIF
		
		IF PEMSTATUS(loSec, "xObsEditando", 5)
		    loSec.xObsEditando = .F.
		ENDIF
		
		IF PEMSTATUS(loSec, "xObsOriginal", 5)
		    loSec.xObsOriginal = m.lcObs
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE btnobsarticuloclick
		*=========================================================
		* FormSet.BtnObsArticuloClick
		* Click en botón "Ver" de columna 9 de secundario.grid2
		* - Abre modal runtime SOLO LECTURA
		* - Conserva posición de grid1 y grid2
		* - Evita que AfterRowColChange de grid1 recargue el detalle
		*=========================================================
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		LOCAL loSec, loGrid1, loGrid2
		LOCAL lnSoliCodi, lnArtCodi
		LOCAL lnRecHist, lnRecDet
		LOCAL lcObs, lcDesc, lcLabel
		LOCAL lcAliasActual
		LOCAL llOk
		LOCAL lnOldGrid2Col, lnOldGrid2LeftCol
		
		loSec         = .NULL.
		loGrid1       = .NULL.
		loGrid2       = .NULL.
		lnSoliCodi    = 0
		lnArtCodi     = 0
		lnRecHist     = 0
		lnRecDet      = 0
		lcObs         = ""
		lcDesc        = ""
		lcLabel       = ""
		lcAliasActual = ALIAS()
		llOk          = .F.
		lnOldGrid2Col = 0
		lnOldGrid2LeftCol = 1
		
		CLEAR TYPEAHEAD
		
		*---------------------------------------------------------
		* 1. Validar form secundario
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loSec = THISFORMSET.secundario
		ENDIF
		
		IF VARTYPE(loSec) <> "O"
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(loSec, "grid1", 5)
		    loGrid1 = loSec.grid1
		ENDIF
		
		IF PEMSTATUS(loSec, "grid2", 5)
		    loGrid2 = loSec.grid2
		ENDIF
		
		*---------------------------------------------------------
		* 2. Asegurar flag de bloqueo para grid1.AfterRowColChange
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "xBloquearAfterGrid1", 5)
		    THISFORMSET.AddProperty("xBloquearAfterGrid1", .F.)
		ENDIF
		
		*---------------------------------------------------------
		* 3. Guardar posición actual de grid1 / cur_soli_hist
		*---------------------------------------------------------
		IF USED("cur_soli_hist") AND RECCOUNT("cur_soli_hist") > 0
		    SELECT cur_soli_hist
		
		    IF EOF("cur_soli_hist") OR BOF("cur_soli_hist")
		        GO TOP IN cur_soli_hist
		    ENDIF
		
		    IF !EOF("cur_soli_hist") AND !BOF("cur_soli_hist")
		        lnRecHist = RECNO("cur_soli_hist")
		
		        IF TYPE("cur_soli_hist.soli_codi") = "N"
		            lnSoliCodi = NVL(cur_soli_hist.soli_codi, 0)
		        ENDIF
		    ENDIF
		ENDIF
		
		IF lnSoliCodi <= 0 AND PEMSTATUS(loSec, "xSoliCodiActual", 5)
		    lnSoliCodi = VAL(TRANSFORM(NVL(loSec.xSoliCodiActual, 0)))
		ENDIF
		
		*---------------------------------------------------------
		* 4. Guardar posición actual de grid2 / cur_soli_det
		*---------------------------------------------------------
		IF !USED("cur_soli_det") OR RECCOUNT("cur_soli_det") <= 0
		    RETURN .F.
		ENDIF
		
		SELECT cur_soli_det
		
		IF EOF("cur_soli_det") OR BOF("cur_soli_det")
		    RETURN .F.
		ENDIF
		
		lnRecDet = RECNO("cur_soli_det")
		
		IF VARTYPE(loGrid2) = "O"
		    TRY
		        lnOldGrid2Col = loGrid2.ActiveColumn
		    CATCH
		        lnOldGrid2Col = 0
		    ENDTRY
		
		    TRY
		        lnOldGrid2LeftCol = loGrid2.LeftColumn
		    CATCH
		        lnOldGrid2LeftCol = 1
		    ENDTRY
		ENDIF
		
		IF TYPE("cur_soli_det.art_codi") = "N"
		    lnArtCodi = NVL(cur_soli_det.art_codi, 0)
		ENDIF
		
		IF TYPE("cur_soli_det.art_desc") <> "U"
		    lcDesc = ALLTRIM(TRANSFORM(NVL(cur_soli_det.art_desc, "")))
		ENDIF
		
		IF TYPE("cur_soli_det.observacion") <> "U"
		    lcObs = ALLTRIM(TRANSFORM(NVL(cur_soli_det.observacion, "")))
		ENDIF
		
		IF lnArtCodi <= 0 OR EMPTY(lcObs)
		    RETURN .F.
		ENDIF
		
		lcLabel = "Artículo: " + TRANSFORM(lnArtCodi) + " - " + lcDesc
		
		*---------------------------------------------------------
		* 5. Validar modal runtime
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "AbrirModalObservacionAislado", 5)
		    MESSAGEBOX("No existe el método AbrirModalObservacionAislado.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 6. Bloquear AfterRowColChange antes de abrir modal
		*---------------------------------------------------------
		THISFORMSET.xBloquearAfterGrid1 = .T.
		
		TRY
		    loSec.LockScreen = .T.
		CATCH
		ENDTRY
		
		CLEAR TYPEAHEAD
		
		llOk = THISFORMSET.AbrirModalObservacionAislado( ;
		    "LECTURA", ;
		    "Consulta de Observación", ;
		    lcLabel, ;
		    lcObs, ;
		    .T. )
		
		CLEAR TYPEAHEAD
		
		*---------------------------------------------------------
		* 7. Restaurar posición de grid1 / cur_soli_hist
		*---------------------------------------------------------
		IF USED("cur_soli_hist") AND RECCOUNT("cur_soli_hist") > 0
		
		    SELECT cur_soli_hist
		
		    IF lnSoliCodi > 0
		        LOCATE FOR soli_codi = lnSoliCodi
		    ENDIF
		
		    IF !FOUND() AND lnRecHist > 0 AND lnRecHist <= RECCOUNT("cur_soli_hist")
		        GO lnRecHist IN cur_soli_hist
		    ENDIF
		
		    IF !PEMSTATUS(loSec, "xSoliCodiActual", 5)
		        loSec.AddProperty("xSoliCodiActual", lnSoliCodi)
		    ELSE
		        loSec.xSoliCodiActual = lnSoliCodi
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 8. Restaurar posición de grid2 / cur_soli_det
		*---------------------------------------------------------
		IF USED("cur_soli_det") AND RECCOUNT("cur_soli_det") > 0
		
		    SELECT cur_soli_det
		
		    IF lnArtCodi > 0
		        LOCATE FOR art_codi = lnArtCodi
		    ENDIF
		
		    IF !FOUND() AND lnRecDet > 0 AND lnRecDet <= RECCOUNT("cur_soli_det")
		        GO lnRecDet IN cur_soli_det
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 9. Refrescar solo visual, SIN recargar datos
		*---------------------------------------------------------
		*!*	IF VARTYPE(loGrid1) = "O"
		*!*	    TRY
		*!*	        loGrid1.Refresh()
		*!*	    CATCH
		*!*	    ENDTRY
		*!*	ENDIF
		
		IF VARTYPE(loGrid2) = "O"
		
		    *-- Eliminar columna huérfana si VFP la generó
		*!*	    TRY
		*!*	        IF loGrid2.ColumnCount > 9
		*!*	            loGrid2.ColumnCount = 9
		*!*	        ENDIF
		*!*	    CATCH
		*!*	    ENDTRY
		
		    *-- Restaurar scroll horizontal
		    TRY
		        IF lnOldGrid2LeftCol > 0
		            loGrid2.LeftColumn = lnOldGrid2LeftCol
		        ELSE
		            loGrid2.LeftColumn = 1
		        ENDIF
		    CATCH
		    ENDTRY
		
		    *-- Restaurar columna activa
		    TRY
		        IF lnOldGrid2Col > 0 AND lnOldGrid2Col <= loGrid2.ColumnCount
		            loGrid2.ActiveColumn = lnOldGrid2Col
		        ENDIF
		    CATCH
		    ENDTRY
		
		ENDIF
		TRY
		    loSec.LockScreen = .F.
		CATCH
		ENDTRY
		
		*---------------------------------------------------------
		* 10. Procesar eventos pendientes y restaurar otra vez
		*---------------------------------------------------------
		DOEVENTS FORCE
		
		IF USED("cur_soli_hist") AND RECCOUNT("cur_soli_hist") > 0
		
		    SELECT cur_soli_hist
		
		    IF lnSoliCodi > 0
		        LOCATE FOR soli_codi = lnSoliCodi
		    ENDIF
		
		    IF !FOUND() AND lnRecHist > 0 AND lnRecHist <= RECCOUNT("cur_soli_hist")
		        GO lnRecHist IN cur_soli_hist
		    ENDIF
		
		    IF PEMSTATUS(loSec, "xSoliCodiActual", 5)
		        loSec.xSoliCodiActual = lnSoliCodi
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* Restaurar nuevamente posición real del detalle/grid2
		* después de DOEVENTS FORCE.
		*---------------------------------------------------------
		IF USED("cur_soli_det") AND RECCOUNT("cur_soli_det") > 0
		
		    SELECT cur_soli_det
		
		    IF lnArtCodi > 0
		        LOCATE FOR art_codi = lnArtCodi
		    ENDIF
		
		    IF !FOUND() AND lnRecDet > 0 AND lnRecDet <= RECCOUNT("cur_soli_det")
		        GO lnRecDet IN cur_soli_det
		    ENDIF
		
		ENDIF
		
		IF VARTYPE(loGrid2) = "O"
		
		*!*	    TRY
		*!*	        IF loGrid2.ColumnCount > 9
		*!*	            loGrid2.ColumnCount = 9
		*!*	        ENDIF
		*!*	    CATCH
		*!*	    ENDTRY
		
		    TRY
		        IF lnOldGrid2LeftCol > 0
		            loGrid2.LeftColumn = lnOldGrid2LeftCol
		        ELSE
		            loGrid2.LeftColumn = 1
		        ENDIF
		    CATCH
		    ENDTRY
		
		    TRY
		        IF lnOldGrid2Col > 0 AND lnOldGrid2Col <= loGrid2.ColumnCount
		            loGrid2.ActiveColumn = lnOldGrid2Col
		        ENDIF
		    CATCH
		    ENDTRY
		
		ENDIF
		
		*---------------------------------------------------------
		* 11. Foco real al grid2
		* IMPORTANTE:
		* Todavía NO desbloquear AfterRowColChange.
		*---------------------------------------------------------
		IF VARTYPE(loGrid2) = "O"
		
		*!*	    TRY
		*!*	        IF loGrid2.ColumnCount > 9
		*!*	            loGrid2.ColumnCount = 9
		*!*	        ENDIF
		*!*	    CATCH
		*!*	    ENDTRY
		
		    TRY
		        IF lnOldGrid2LeftCol > 0
		            loGrid2.LeftColumn = lnOldGrid2LeftCol
		        ELSE
		            loGrid2.LeftColumn = 1
		        ENDIF
		    CATCH
		    ENDTRY
		
		    TRY
		        IF lnOldGrid2Col > 0 AND lnOldGrid2Col <= loGrid2.ColumnCount
		            loGrid2.ActiveColumn = lnOldGrid2Col
		        ENDIF
		    CATCH
		    ENDTRY
		
		    TRY
		        loGrid2.SetFocus()
		    CATCH
		    ENDTRY
		
		    TRY
		        loGrid2.Refresh()
		    CATCH
		    ENDTRY
		
		ENDIF
		
		*!*	TRY
		*!*	    loSec.Refresh()
		*!*	CATCH
		*!*	ENDTRY
		
		*---------------------------------------------------------
		* 12. Ahora sí desbloquear AfterRowColChange
		*---------------------------------------------------------
		THISFORMSET.xBloquearAfterGrid1 = .F.
		
		*---------------------------------------------------------
		* 13. Restaurar alias anterior
		*---------------------------------------------------------
		IF !EMPTY(lcAliasActual) AND USED(lcAliasActual)
		    SELECT (lcAliasActual)
		ENDIF
		
		RETURN llOk
	ENDPROC

	PROCEDURE btnobsarticuloclickprincipal
		*=========================================================
		* FormSet.BtnObsArticuloClickPrincipal
		* Observación desde principal.grd_alerts
		* Abre modal runtime para agregar/editar observación del artículo
		*=========================================================
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		LOCAL lnArtCodi, lcObs, lcDesc, lcLabel
		LOCAL llOk, lcTexto
		
		lnArtCodi = 0
		lcObs     = ""
		lcDesc    = ""
		lcLabel   = ""
		llOk      = .F.
		lcTexto   = ""
		
		CLEAR TYPEAHEAD
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") <= 0 OR EOF("cur_alerts")
		    RETURN .F.
		ENDIF
		
		SELECT cur_alerts
		
		IF TYPE("cur_alerts.art_codi") = "N"
		    lnArtCodi = NVL(cur_alerts.art_codi, 0)
		ENDIF
		
		IF TYPE("cur_alerts.art_desc") <> "U"
		    lcDesc = ALLTRIM(TRANSFORM(NVL(cur_alerts.art_desc, "")))
		ENDIF
		
		IF TYPE("cur_alerts.observacion") <> "U"
		    lcObs = ALLTRIM(TRANSFORM(NVL(cur_alerts.observacion, "")))
		ENDIF
		
		IF lnArtCodi <= 0
		    RETURN .F.
		ENDIF
		
		lcLabel = "Artículo: " + TRANSFORM(lnArtCodi) + " - " + lcDesc
		
		IF !PEMSTATUS(THISFORMSET, "AbrirModalObservacionAislado", 5)
		    MESSAGEBOX("No existe el método AbrirModalObservacionAislado.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		llOk = THISFORMSET.AbrirModalObservacionAislado( ;
		    "OBS_ART", ;
		    "Editar Observación", ;
		    lcLabel, ;
		    lcObs, ;
		    .F. )
		
		IF !llOk
		    RETURN .F.
		ENDIF
		
		lcTexto = ""
		IF PEMSTATUS(THISFORMSET, "xObsModalValor", 5)
		    lcTexto = ALLTRIM(NVL(THISFORMSET.xObsModalValor, ""))
		ENDIF
		
		*---------------------------------------------------------
		* Guardar observación en temp_solicitud_compra
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "CRUDTempSolicitudCompra", 5)
		    llOk = THISFORMSET.CRUDTempSolicitudCompra( ;
		        "UPDATE_OBS", ;
		        lnArtCodi, ;
		        0, ;
		        0, ;
		        0, ;
		        "", ;
		        0, ;
		        lcTexto)
		ELSE
		    MESSAGEBOX("No existe el método CRUDTempSolicitudCompra.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF !llOk
		    MESSAGEBOX("No se pudo guardar la observación del artículo.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Reflejar en cur_alerts
		*---------------------------------------------------------
		IF USED("cur_alerts")
		    SELECT cur_alerts
		    LOCATE FOR art_codi = lnArtCodi
		
		    IF FOUND()
		        IF TYPE("cur_alerts.observacion") $ "CM"
		            REPLACE observacion WITH lcTexto IN cur_alerts
		        ENDIF
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "principal", 5) AND ;
		   PEMSTATUS(THISFORMSET.principal, "grd_alerts", 5)
		    THISFORMSET.principal.grd_alerts.Refresh()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargaralertasstockfull
		*=========================================================
		* FormSet.CargarAlertasStockFull
		* - Carga base completa de alertas desde MySQL
		* - Resuelve proveedor default + costo + lista de proveedores
		* - Incluye campo estado para filtro DEPURACIÓN
		* - Evita problemas de costos grandes usando DECIMAL(15,4)
		*=========================================================
		
		LOCAL loFrm, loConsulta
		LOCAL lnConn, lnRet, lcSQL
		LOCAL laErr[1], lcMsg
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF USED("cur_raw_full")
		    USE IN cur_raw_full
		ENDIF
		
		IF USED("cur_raw_tmp")
		    USE IN cur_raw_tmp
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*-- Habilitar GROUP_CONCAT largo
		SQLEXEC(lnConn, "SET SESSION group_concat_max_len = 65536")
		
		TEXT TO lcSQL NOSHOW
		SELECT
		  a.art_codi,
		  a.art_desc,
		  IFNULL(a.art_stock,0) AS art_stock,
		  IFNULL(a.art_stmin,0) AS art_stmin,
		  IFNULL(m.art_pct_alerta,30) AS art_pct_alerta,
		  IFNULL(a.pedidos,0) AS pedidos,
		  IFNULL(a.pedprov,0) AS pedprov,
		  IFNULL(m.pct_rotacion,0) AS pct_rotacion,
		  IFNULL(m.ventas_metrics,'') AS ventas_metrics,
		  IFNULL(m.compras_metrics,'') AS compras_metrics,
		  IFNULL(m.promedio_venta,0) AS promedio_venta,
		  m.fecha_ult_venta,
		  IFNULL(m.promedio_compra,0) AS promedio_compra,
		  m.fecha_ult_compra,
		  IFNULL(m.dias_demora_ent,15) AS dias_demora_ent,
		  IFNULL(m.estado,1) AS estado,
		  IFNULL(m.pos_min_sug,0) AS pos_min_sug,
		  IFNULL(m.sugerido_comprar,0) AS sugerido_comprar,
		  IFNULL(m.meses_cubiertos,0) AS meses_cubiertos,
		  IFNULL(m.meses_cobert_solic,3) AS meses_cobert_solic,
		  GREATEST(0, IFNULL(m.sugerido_comprar,0) - IFNULL(a.pedprov,0)) AS sug_neto,
		  (IFNULL(a.art_stock,0) + IFNULL(a.pedprov,0) - IFNULL(a.pedidos,0)) AS posicion,
		  IFNULL(a.rub_codi,0) AS rub_codi,
		  COALESCE(r.rub_desc,'') AS rub_desc,
		  IFNULL(bp.prov_codi_sel, 0) AS prov_codi_sel,
		  IFNULL(bp.prov_nomb_sel, '') AS prov_nomb_sel,
		  CAST(IFNULL(bp.artpro_costo, 0) AS DECIMAL(15,4)) AS artpro_costo,
		  IFNULL(bp.artpro_moneda, '') AS artpro_moneda,
		  IFNULL(pl.prov_lista, '') AS prov_lista
		FROM articulos a
		LEFT JOIN art_metricas m
		       ON m.art_codi = a.art_codi
		LEFT JOIN rubros r
		       ON r.rub_codi = a.rub_codi
		LEFT JOIN (
		    SELECT
		        ap2.art_codi,
		        GROUP_CONCAT(
		            CONCAT(
		                IFNULL(p2.prov_nomb,''), '^',
		                ap2.prov_codi, '^',
		                CAST(IFNULL(ap2.artpro_costo,0) AS DECIMAL(15,4)), '^',
		                IFNULL(ap2.moneda,'P'), '^',
		                IFNULL(ap2.lista,0), '^',
		                IFNULL(ap2.cotiz,0), '^',
		                IFNULL(DATE_FORMAT(hm.histo_fech,'%Y-%m-%d %H:%i:%s'),'')
		            )
		            ORDER BY p2.prov_nomb, ap2.artpro_costo
		            SEPARATOR '\n'
		        ) AS prov_lista
		    FROM articulos_proveedores ap2
		    INNER JOIN proveedores p2
		            ON p2.prov_codi = ap2.prov_codi
		    LEFT JOIN (
		        SELECT
		            artpro_codi,
		            MAX(histo_fech) AS histo_fech
		        FROM histocosto
		        GROUP BY artpro_codi
		    ) hm
		        ON hm.artpro_codi = ap2.artpro_codi
		    GROUP BY ap2.art_codi
		) pl
		    ON pl.art_codi = a.art_codi
		LEFT JOIN (
		    SELECT
		        ap.art_codi,
		        ap.prov_codi AS prov_codi_sel,
		        p.prov_nomb AS prov_nomb_sel,
		        CAST(IFNULL(ap.artpro_costo,0) AS DECIMAL(15,4)) AS artpro_costo,
		        IFNULL(ap.moneda,'P') AS artpro_moneda
		    FROM articulos_proveedores ap
		    INNER JOIN proveedores p
		            ON p.prov_codi = ap.prov_codi
		    WHERE ap.artpro_codi = (
		        SELECT a2.artpro_codi
		        FROM articulos_proveedores a2
		        WHERE a2.art_codi = ap.art_codi
		        ORDER BY
		            CASE
		                WHEN IFNULL(a2.cotiz,0) = 1 AND IFNULL(a2.artpro_costo,0) > 0 THEN 1
		                WHEN IFNULL(a2.artpro_costo,0) > 0 THEN 2
		                ELSE 3
		            END,
		            a2.artpro_costo ASC,
		            a2.prov_codi ASC
		        LIMIT 1
		    )
		) bp
		    ON bp.art_codi = a.art_codi
		WHERE 1 = 1
		ENDTEXT
		
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_raw_tmp")
		
		IF lnRet < 0
		
		    IF AERROR(laErr) > 0
		        lcMsg = "Error SQL: " + TRANSFORM(laErr[1,3])
		    ELSE
		        lcMsg = "Error desconocido al cargar desde MySQL."
		    ENDIF
		
		    Desconectar_DB(lnConn)
		
		    MESSAGEBOX(lcMsg, 16, "principal")
		    RETURN .F.
		
		ENDIF
		
		Desconectar_DB(lnConn)
		
		*---------------------------------------------------------
		* NORMALIZACIÓN BLINDADA LOCAL VFP
		* Acá sí usamos N(15,4), porque esto ya es SELECT local VFP.
		*---------------------------------------------------------
		SELECT ;
		    art_codi, ;
		    art_desc, ;
		    CAST(art_stock AS N(15,3)) AS art_stock, ;
		    CAST(art_stmin AS N(15,3)) AS art_stmin, ;
		    CAST(art_pct_alerta AS N(10,2)) AS art_pct_alerta, ;
		    CAST(pedidos AS N(15,3)) AS pedidos, ;
		    CAST(pedprov AS N(15,3)) AS pedprov, ;
		    CAST(posicion AS N(15,3)) AS posicion, ;
		    CAST(sug_neto AS N(15,3)) AS sug_neto, ;
		    CAST(pct_rotacion AS N(10,3)) AS pct_rotacion, ;
		    CAST(NVL(ventas_metrics,'') AS M) AS ventas_metrics, ;
		    CAST(NVL(compras_metrics,'') AS M) AS compras_metrics, ;
		    CAST(promedio_venta AS N(15,3)) AS promedio_venta, ;
		    CAST(NVL(fecha_ult_venta,{}) AS D) AS fecha_ult_venta, ;
		    CAST(promedio_compra AS N(15,3)) AS promedio_compra, ;
		    CAST(NVL(fecha_ult_compra,{}) AS D) AS fecha_ult_compra, ;
		    CAST(dias_demora_ent AS I) AS dias_demora_ent, ;
		    CAST(NVL(estado,1) AS I) AS estado, ;
		    CAST(pos_min_sug AS N(15,3)) AS pos_min_sug, ;
		    CAST(sugerido_comprar AS N(15,3)) AS sugerido_comprar, ;
		    CAST(0 AS N(15,3)) AS cant_soli, ;
		    CAST(meses_cubiertos AS N(15,3)) AS meses_cubiertos, ;
		    CAST(0 AS N(15,3)) AS meses_cob_proy, ;
		    CAST(meses_cobert_solic AS N(15,3)) AS meses_cobert_solic, ;
		    CAST(0 AS I) AS score, ;
		    CAST(rub_codi AS I) AS rub_codi, ;
		    CAST(rub_desc AS C(60)) AS rub_desc, ;
		    CAST(NVL(prov_codi_sel, 0) AS I) AS prov_codi_sel, ;
		    CAST(NVL(prov_nomb_sel, '') AS C(80)) AS prov_nomb_sel, ;
		    CAST(NVL(artpro_costo, 0) AS N(15,4)) AS artpro_costo, ;
		    CAST(NVL(artpro_moneda, '') AS C(1)) AS artpro_moneda, ;
		    CAST({} AS D) AS artpro_fecha, ;
		    CAST(NVL(prov_lista, '') AS M) AS prov_lista ;
		FROM cur_raw_tmp ;
		INTO CURSOR cur_raw_full READWRITE
		
		USE IN cur_raw_tmp
		
		*---------------------------------------------------------
		* Recalcular colores del grid
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "RecalcularColoresGrid", 5)
		    THISFORMSET.RecalcularColoresGrid()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargaralertasstockporproveedor
		*=========================================================
		* FormSet.CargarAlertasStockPorProveedor
		* - Permite repetir artículos por proveedor
		* - Trae costo proveedor
		*=========================================================
		LPARAMETERS tnProvCodi
		LOCAL loFrm, loConsulta
		LOCAL lnConn, lnRet, lcSQL
		LOCAL laErr[1], lnErr, lcMsg
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET,"secundario",5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF VARTYPE(tnProvCodi) <> "N" OR tnProvCodi <= 0
		    MESSAGEBOX("Proveedor inválido.",16,"Error")
		    RETURN .F.
		ENDIF
		
		IF USED("cur_raw")
		    USE IN cur_raw
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.",16,"Error")
		    RETURN .F.
		ENDIF
		
		TEXT TO lcSQL NOSHOW
		SELECT
		  a.art_codi,
		  a.art_desc,
		
		  IFNULL(a.art_stock,0) AS art_stock,
		  IFNULL(a.art_stmin,0) AS art_stmin,
		
		  IFNULL(a.pedidos,0) AS pedidos,
		  IFNULL(a.pedprov,0) AS pedprov,
		
		  (IFNULL(a.art_stock,0) + IFNULL(a.pedprov,0) - IFNULL(a.pedidos,0)) AS posicion,
		
		  GREATEST(0, IFNULL(m.sugerido_comprar,0) - IFNULL(a.pedprov,0)) AS sug_neto,
		
		  IFNULL(m.pct_rotacion,0) AS pct_rotacion,
		
		  IFNULL(m.ventas_metrics,'')  AS ventas_metrics,
		  IFNULL(m.compras_metrics,'') AS compras_metrics,
		
		  IFNULL(m.promedio_venta,0) AS promedio_venta,
		  m.fecha_ult_venta,
		
		  IFNULL(m.promedio_compra,0) AS promedio_compra,
		  m.fecha_ult_compra,
		
		  IFNULL(m.dias_demora_ent,15) AS dias_demora_ent,
		
		  IFNULL(m.pos_min_sug,0) AS pos_min_sug,
		  IFNULL(m.sugerido_comprar,0) AS sugerido_comprar,
		
		  IFNULL(m.meses_cubiertos,0) AS meses_cubiertos,
		  IFNULL(m.meses_cobert_solic,3) AS meses_cobert_solic,
		
		  IFNULL(a.rub_codi,0) AS rub_codi,
		  COALESCE(r.rub_desc,'') AS rub_desc,
		
		  IFNULL(m.art_pct_alerta,30.00) AS art_pct_alerta,
		
		  ap.prov_codi AS prov_codi_sel,
		  p.prov_nomb AS prov_nomb_sel,
		  IFNULL(ap.artpro_costo,0) + 0E0     AS artpro_costo
		  
		FROM art_metricas m
		
		JOIN articulos a
		    ON a.art_codi = m.art_codi
		
		JOIN articulos_proveedores ap
		    ON ap.art_codi = a.art_codi
		
		LEFT JOIN proveedores p
		    ON p.prov_codi = ap.prov_codi
		
		LEFT JOIN rubros r
		    ON r.rub_codi = a.rub_codi
		
		WHERE m.estado = 1
		  AND ap.prov_codi = ?tnProvCodi
		
		  AND (IFNULL(a.art_stock,0) + IFNULL(a.pedprov,0) - IFNULL(a.pedidos,0))
		      < IFNULL(a.art_stmin,0)
		
		ORDER BY
		      posicion ASC,
		      IFNULL(m.pct_rotacion,0) DESC
		ENDTEXT
		
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_raw")
		
		IF lnRet < 0
		    lnErr = AERROR(laErr)
		    lcMsg = "Error SQL." + CHR(13) + IIF(lnErr>=1, laErr[1,3], "(sin mensaje)")
		    Desconectar_DB(lnConn)
		    MESSAGEBOX(lcMsg,16,"MySQL")
		    RETURN .F.
		ENDIF
		
		Desconectar_DB(lnConn)
		
		IF !USED("cur_raw")
		    MESSAGEBOX("No se creó cur_raw.",16,"MySQL")
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET,"RebuildAlertsCursorFromRaw",5)
		    THISFORMSET.RebuildAlertsCursorFromRaw()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargaralertasstockporrubro
		*=========================================================
		* FormSet.CargarAlertasStockPorRubro
		* - Actualizado para nueva estructura:
		*   proveedor seleccionado / costo / lista proveedores
		*=========================================================
		LPARAMETERS tnRubCodi
		LOCAL loFrm, loConsulta
		LOCAL lnConn, lnRet, lcSQL
		LOCAL laErr[1], lnErr, lcMsg, lcState
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF VARTYPE(tnRubCodi) <> "N" OR tnRubCodi <= 0
		    MESSAGEBOX("Rubro inválido.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF USED("cur_raw")
		    USE IN cur_raw
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		TEXT TO lcSQL NOSHOW
		SELECT
		  a.art_codi,
		  a.art_desc,
		  IFNULL(a.art_stock,0) AS art_stock,
		  IFNULL(a.art_stmin,0) AS art_stmin,
		  IFNULL(a.pedidos,0)   AS pedidos,
		  IFNULL(a.pedprov,0)   AS pedprov,
		  (IFNULL(a.art_stock,0) + IFNULL(a.pedprov,0) - IFNULL(a.pedidos,0)) AS posicion,
		  GREATEST(0, IFNULL(m.sugerido_comprar,0) - IFNULL(a.pedprov,0)) AS sug_neto,
		  IFNULL(m.pct_rotacion,0) AS pct_rotacion,
		  IFNULL(m.ventas_metrics,'') AS ventas_metrics,
		  IFNULL(m.compras_metrics,'') AS compras_metrics,
		  IFNULL(m.promedio_venta,0) AS promedio_venta,
		  m.fecha_ult_venta,
		  IFNULL(m.promedio_compra,0) AS promedio_compra,
		  m.fecha_ult_compra,
		  IFNULL(m.dias_demora_ent,15) AS dias_demora_ent,
		  IFNULL(m.pos_min_sug,0) AS pos_min_sug,
		  IFNULL(m.sugerido_comprar,0) AS sugerido_comprar,
		  IFNULL(m.meses_cubiertos,0) AS meses_cubiertos,
		  IFNULL(m.meses_cobert_solic,3) AS meses_cobert_solic,
		  IFNULL(m.art_pct_alerta,30.00) AS art_pct_alerta,
		  IFNULL(a.rub_codi,0) AS rub_codi,
		  COALESCE(r.rub_desc,'') AS rub_desc,
		  0 AS prov_codi_sel,
		  '' AS prov_nomb_sel,
		  0 AS artpro_costo,
		  '' AS prov_lista
		FROM art_metricas m
		JOIN articulos a
		    ON a.art_codi = m.art_codi
		LEFT JOIN rubros r
		    ON r.rub_codi = a.rub_codi
		WHERE m.estado = 1
		  AND a.rub_codi = ?tnRubCodi
		  AND GREATEST(0, IFNULL(m.sugerido_comprar,0) - IFNULL(a.pedprov,0)) > 0
		ORDER BY IFNULL(m.pct_rotacion,0) DESC,
		         GREATEST(0, IFNULL(m.sugerido_comprar,0) - IFNULL(a.pedprov,0)) DESC
		ENDTEXT
		
		lnRet   = SQLEXEC(lnConn, lcSQL, "cur_raw")
		lcState = TRANSFORM(SQLGETPROP(lnConn, "SQLSTATE"))
		
		IF lnRet < 0
		    lnErr = AERROR(laErr)
		    lcMsg = "Error SQL (Rubro)." + CHR(13) + ;
		            "Código: "  + TRANSFORM(IIF(lnErr>=1, laErr[1,2], 0)) + CHR(13) + ;
		            "Mensaje: " + IIF(lnErr>=1, laErr[1,3], "(sin mensaje)") + CHR(13) + ;
		            "SQLSTATE: " + lcState + CHR(13) + ;
		            "SQL:" + CHR(13) + lcSQL
		    Desconectar_DB(lnConn)
		    MESSAGEBOX(lcMsg, 16, "MySQL")
		    RETURN .F.
		ENDIF
		
		Desconectar_DB(lnConn)
		
		IF !USED("cur_raw")
		    MESSAGEBOX("No se creó cur_raw (Rubro).", 16, "MySQL")
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "RebuildAlertsCursorFromRaw", 5)
		    THISFORMSET.RebuildAlertsCursorFromRaw()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargararticulodesdetxtaddcodi
		*=========================================================
		* FormSet.CargarArticuloDesdeTxtAddCodi
		* Lee txt_add_codi, busca artículo y renderiza datos
		* - Si txt_add_codi está vacío/inválido: limpia y oculta
		* - Si el artículo existe: carga valores y muestra controles
		*=========================================================
		LOCAL loFrm
		LOCAL lnArtCodi, lnConn, lnRet
		LOCAL lcSQL, lcAlias, lcValor, lcErr
		LOCAL laErr[1]
		
		IF TYPE("THISFORMSET.principal.Name") = "U"
		    RETURN .F.
		ENDIF
		
		loFrm = THISFORMSET.principal
		IF VARTYPE(loFrm) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loFrm, "txt_add_codi", 5)
		    RETURN .F.
		ENDIF
		
		lcValor = ALLTRIM(TRANSFORM(loFrm.txt_add_codi.Value))
		lcAlias = "cur_art_add"
		
		*---------------------------------------------------------
		* Si está vacío: limpiar, ocultar y salir
		*---------------------------------------------------------
		IF EMPTY(lcValor) OR VAL(lcValor) <= 0
		
		    IF PEMSTATUS(loFrm, "text10", 5)
		        loFrm.text10.Value   = ""
		        loFrm.text10.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label15", 5)
		        loFrm.label15.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text7", 5)
		        loFrm.text7.Value   = 0
		        loFrm.text7.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label9", 5)
		        loFrm.label9.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label13", 5)
		        loFrm.label13.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label10", 5)
		        loFrm.label10.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label17", 5)
		        loFrm.label17.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label16", 5)
		        loFrm.label16.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text3", 5)
		        loFrm.text3.Value   = 0
		        loFrm.text3.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text6", 5)
		        loFrm.text6.Value   = 0
		        loFrm.text6.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text5", 5)
		        loFrm.text5.Value   = 0
		        loFrm.text5.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text9", 5)
		        loFrm.text9.Value   = 0
		        loFrm.text9.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text8", 5)
		        loFrm.text8.Value   = 0
		        loFrm.text8.Visible = .F.
		    ENDIF
		
		    loFrm.Refresh()
		    RETURN .T.
		ENDIF
		
		lnArtCodi = VAL(lcValor)
		IF lnArtCodi <= 0
		
		    IF PEMSTATUS(loFrm, "text10", 5)
		        loFrm.text10.Value   = ""
		        loFrm.text10.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label15", 5)
		        loFrm.label15.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text7", 5)
		        loFrm.text7.Value   = 0
		        loFrm.text7.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label9", 5)
		        loFrm.label9.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label13", 5)
		        loFrm.label13.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label10", 5)
		        loFrm.label10.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label17", 5)
		        loFrm.label17.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label16", 5)
		        loFrm.label16.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text3", 5)
		        loFrm.text3.Value   = 0
		        loFrm.text3.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text6", 5)
		        loFrm.text6.Value   = 0
		        loFrm.text6.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text5", 5)
		        loFrm.text5.Value   = 0
		        loFrm.text5.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text9", 5)
		        loFrm.text9.Value   = 0
		        loFrm.text9.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text8", 5)
		        loFrm.text8.Value   = 0
		        loFrm.text8.Visible = .F.
		    ENDIF
		
		    loFrm.Refresh()
		    RETURN .F.
		ENDIF
		
		IF USED(lcAlias)
		    USE IN (lcAlias)
		ENDIF
		
		lnConn = Conectar_DB(_SCREEN.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a la base de datos.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		TEXT TO lcSQL NOSHOW
		SELECT
		    a.art_codi,
		    IFNULL(a.art_desc,'')        AS art_desc,
		    IFNULL(a.art_stock,0)        AS art_stock,
		    IFNULL(a.pedprov,0)          AS art_pedprov,
		    IFNULL(a.pedidos,0)          AS art_pedidos,
		    IFNULL(am.art_pct_alerta,30) AS art_pct_alerta,
		    IFNULL(a.art_stmin,0)        AS art_stmin
		FROM articulos a
		LEFT JOIN art_metricas am ON am.art_codi = a.art_codi
		WHERE a.art_codi =  ?lnArtCodi
		ENDTEXT
		
		lnRet = SQLEXEC(lnConn, lcSQL, lcAlias)
		
		IF lnRet < 0
		    AERROR(laErr)
		    lcErr = MESSAGE()
		
		    IF EMPTY(lcErr) AND TYPE("laErr[1,2]") <> "U"
		        lcErr = TRANSFORM(laErr[1,2])
		    ENDIF
		
		    IF EMPTY(lcErr) AND TYPE("laErr[1]") <> "U"
		        lcErr = TRANSFORM(laErr[1])
		    ENDIF
		
		    IF EMPTY(lcErr)
		        lcErr = "Error SQL desconocido"
		    ENDIF
		
		    MESSAGEBOX("Error al consultar el artículo." + CHR(13) + lcErr, 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF !USED(lcAlias) OR RECCOUNT(lcAlias) = 0
		
		    IF PEMSTATUS(loFrm, "text10", 5)
		        loFrm.text10.Value   = ""
		        loFrm.text10.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label15", 5)
		        loFrm.label15.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text7", 5)
		        loFrm.text7.Value   = 0
		        loFrm.text7.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label9", 5)
		        loFrm.label9.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label13", 5)
		        loFrm.label13.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label10", 5)
		        loFrm.label10.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label17", 5)
		        loFrm.label17.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "label16", 5)
		        loFrm.label16.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text3", 5)
		        loFrm.text3.Value   = 0
		        loFrm.text3.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text6", 5)
		        loFrm.text6.Value   = 0
		        loFrm.text6.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text5", 5)
		        loFrm.text5.Value   = 0
		        loFrm.text5.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text9", 5)
		        loFrm.text9.Value   = 0
		        loFrm.text9.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "text8", 5)
		        loFrm.text8.Value   = 0
		        loFrm.text8.Visible = .F.
		    ENDIF
		
		    loFrm.Refresh()
		    MESSAGEBOX("No existe el artículo código " + TRANSFORM(lnArtCodi) + ".", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		SELECT (lcAlias)
		GO TOP
		
		IF PEMSTATUS(loFrm, "text10", 5)
		    loFrm.text10.Value   = ALLTRIM(cur_art_add.art_desc)
		    loFrm.text10.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(loFrm, "label15", 5)
		    loFrm.label15.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(loFrm, "text7", 5)
		    loFrm.text7.Value   = cur_art_add.art_stock
		    loFrm.text7.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(loFrm, "label9", 5)
		    loFrm.label9.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(loFrm, "label13", 5)
		    loFrm.label13.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(loFrm, "label10", 5)
		    loFrm.label10.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(loFrm, "label17", 5)
		    loFrm.label17.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(loFrm, "label16", 5)
		    loFrm.label16.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(loFrm, "text3", 5)
		    loFrm.text3.Value   = cur_art_add.art_pedprov
		    loFrm.text3.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(loFrm, "text6", 5)
		    loFrm.text6.Value   = cur_art_add.art_pedidos
		    loFrm.text6.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(loFrm, "text5", 5)
		    loFrm.text5.Value   = cur_art_add.art_stock + cur_art_add.art_pedprov - cur_art_add.art_pedidos
		    loFrm.text5.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(loFrm, "text9", 5)
		    loFrm.text9.Value   = cur_art_add.art_pct_alerta
		    loFrm.text9.Visible = .T.
		ENDIF
		
		IF PEMSTATUS(loFrm, "text8", 5)
		    loFrm.text8.Value   = cur_art_add.art_stmin
		    loFrm.text8.Visible = .T.
		ENDIF
		
		loFrm.Refresh()
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargarclientesarticuloseleccionado
		*=========================================================
		* FormSet.CargarClientesArticuloSeleccionado
		* - Carga grid1 con los clientes que compraron
		*   el artículo seleccionado en cur_alerts
		* - Orden: fecha descendente
		* - No rompe el form si falla MySQL
		* - Al hacer doble click en grid1 abre el pedido seleccionado
		*=========================================================
		LOCAL loFrm, lnArtCodi, lnConn, lnRet, lcSql
		LOCAL lcSafety, laErr[1], lcErrMsg
		loFrm = THISFORMSET.principal
		IF VARTYPE(loFrm) # "O"
		    RETURN .F.
		ENDIF
		IF !USED("cur_alerts")
		    RETURN .F.
		ENDIF
		IF !USED("cur_cli_art")
		    CREATE CURSOR cur_cli_art ( ;
		        fecha    D, ;
		        ped_codi I, ;
		        cantidad N(15,3), ;
		        cliente  C(120) )
		ENDIF
		lnArtCodi = 0
		SELECT cur_alerts
		IF RECCOUNT("cur_alerts") > 0
		    IF TYPE("cur_alerts.art_codi") = "N"
		        lnArtCodi = cur_alerts.art_codi
		    ENDIF
		ENDIF
		*-- Limpiar cursor destino
		lcSafety = SET("SAFETY")
		SET SAFETY OFF
		SELECT cur_cli_art
		ZAP
		IF UPPER(ALLTRIM(lcSafety)) == "ON"
		    SET SAFETY ON
		ELSE
		    SET SAFETY OFF
		ENDIF
		
		*-- Cache: evitar re-query si el artículo no cambió
		IF !PEMSTATUS(THISFORMSET, "xLastCliArtCodi", 5)
		    THISFORMSET.AddProperty("xLastCliArtCodi", 0)
		ENDIF
		IF lnArtCodi > 0 AND lnArtCodi = THISFORMSET.xLastCliArtCodi ;
		        AND USED("cur_cli_art") AND RECCOUNT("cur_cli_art") > 0
		    RETURN .T.
		ENDIF
		
		IF lnArtCodi <= 0
		    IF PEMSTATUS(loFrm, "grid1", 5)
		        loFrm.grid1.RecordSource = "cur_cli_art"
		        loFrm.grid1.Refresh()
		        TRY
		            UNBINDEVENTS(loFrm.grid1, "Click", THISFORMSET, "AbrirPedidoDesdeGrid1")
		        CATCH
		        ENDTRY
		        TRY
		            UNBINDEVENTS(loFrm.grid1, "DblClick", THISFORMSET, "AbrirPedidoDesdeGrid1")
		        CATCH
		        ENDTRY
		    ENDIF
		    RETURN .F.
		ENDIF
		IF USED("cur_cli_art_tmp")
		    USE IN cur_cli_art_tmp
		ENDIF
		TEXT TO lcSql NOSHOW
		SELECT
		    p.ped_fech AS fecha,
		    p.ped_codi,
		    SUM(IFNULL(pa.artped_cant,0)) AS cantidad,
		    IFNULL(c.cli_nomb,'') AS cliente
		FROM pedidos p
		JOIN pedidos_articulos pa
		    ON pa.ped_codi = p.ped_codi
		LEFT JOIN clientes c
		    ON c.cli_codi = p.cli_codi
		WHERE pa.art_codi = ?lnArtCodi
		GROUP BY
		    p.ped_fech,
		    p.ped_codi,
		    c.cli_nomb
		ORDER BY
		    p.ped_fech DESC,
		    p.ped_codi DESC
		ENDTEXT
		lnConn = conectar_db(_screen.cn)
		lnRet  = SQLEXEC(lnConn, lcSql, "cur_cli_art_tmp")
		IF lnRet < 0
		    AERROR(laErr)
		    lcErrMsg = "Error al cargar clientes del artículo." + CHR(13) + CHR(13)
		    IF TYPE("laErr[1,2]") # "U"
		        lcErrMsg = lcErrMsg + "Detalle: " + TRANSFORM(laErr[1,2])
		    ENDIF
		    IF TYPE("laErr[1,3]") # "U"
		        lcErrMsg = lcErrMsg + CHR(13) + "ODBC/MySQL: " + TRANSFORM(laErr[1,3])
		    ENDIF
		    desconectar_db(lnConn)
		    *-- dejar grid vacío pero no romper
		    IF USED("cur_cli_art_tmp")
		        USE IN cur_cli_art_tmp
		    ENDIF
		    IF PEMSTATUS(loFrm, "grid1", 5)
		        loFrm.grid1.RecordSource = "cur_cli_art"
		        loFrm.grid1.Refresh()
		        TRY
		            UNBINDEVENTS(loFrm.grid1, "Click", THISFORMSET, "AbrirPedidoDesdeGrid1")
		        CATCH
		        ENDTRY
		        TRY
		            UNBINDEVENTS(loFrm.grid1, "DblClick", THISFORMSET, "AbrirPedidoDesdeGrid1")
		        CATCH
		        ENDTRY
		    ENDIF
		    MESSAGEBOX(lcErrMsg, 16, "grid1 / MySQL")
		    RETURN .F.
		ENDIF
		desconectar_db(lnConn)
		IF !USED("cur_cli_art_tmp")
		    IF PEMSTATUS(loFrm, "grid1", 5)
		        loFrm.grid1.RecordSource = "cur_cli_art"
		        loFrm.grid1.Refresh()
		        TRY
		            UNBINDEVENTS(loFrm.grid1, "Click", THISFORMSET, "AbrirPedidoDesdeGrid1")
		        CATCH
		        ENDTRY
		        TRY
		            UNBINDEVENTS(loFrm.grid1, "DblClick", THISFORMSET, "AbrirPedidoDesdeGrid1")
		        CATCH
		        ENDTRY
		    ENDIF
		    RETURN .F.
		ENDIF
		IF RECCOUNT("cur_cli_art_tmp") > 0
		    SELECT cur_cli_art
		    APPEND FROM DBF("cur_cli_art_tmp")
		ENDIF
		USE IN cur_cli_art_tmp
		IF USED("cur_cli_art") AND RECCOUNT("cur_cli_art") > 0
		    SELECT cur_cli_art
		    GO TOP
		ENDIF
		IF PEMSTATUS(loFrm, "grid1", 5)
		    loFrm.grid1.RecordSource = "cur_cli_art"
		    IF loFrm.grid1.ColumnCount >= 4
		        loFrm.grid1.Columns(1).ControlSource = "cur_cli_art.fecha"
		        loFrm.grid1.Columns(2).ControlSource = "cur_cli_art.ped_codi"
		        loFrm.grid1.Columns(3).ControlSource = "cur_cli_art.cantidad"
		        loFrm.grid1.Columns(4).ControlSource = "cur_cli_art.cliente"
		    ENDIF
		*!*	*!*	    TRY
		*!*	*!*	        UNBINDEVENTS(loFrm.grid1, "Click", THISFORMSET, "AbrirPedidoDesdeGrid1")
		*!*	*!*	    CATCH
		*!*	    ENDTRY
		    TRY
		        UNBINDEVENTS(loFrm.grid1, "DblClick", THISFORMSET, "AbrirPedidoDesdeGrid1")
		    CATCH
		    ENDTRY
		*!*	    BINDEVENT(loFrm.grid1, "Click",    THISFORMSET, "AbrirPedidoDesdeGrid1")
		    BINDEVENT(loFrm.grid1, "DblClick", THISFORMSET, "AbrirPedidoDesdeGrid1")
		    loFrm.grid1.Refresh()
		ENDIF
		
		THISFORMSET.xLastCliArtCodi = lnArtCodi
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargarcombodepuracion
		*=========================================================
		* FormSet.CargarComboDepuracion
		* combo2 muestra opciones del filtro DEPURACION
		*=========================================================
		LOCAL loFrm
		
		loFrm = THISFORMSET.principal
		
		IF VARTYPE(loFrm) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loFrm, "combo2", 5)
		    MESSAGEBOX("No existe combo2 en el formulario.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		
		*--------------------*
		WITH loFrm.combo2
		    .Visible       = .F.
		    .RowSourceType = 0
		    .RowSource     = ""
		    .ListIndex     = 0
		    .Value         = 0
		ENDWITH
		*-------------------*
		
		
		
		IF USED("cur_depura_ui")
		    USE IN cur_depura_ui
		ENDIF
		
		CREATE CURSOR cur_depura_ui (x_desc C(50), x_codi I)
		
		INSERT INTO cur_depura_ui VALUES ("INACTIVOS", 1)
		INSERT INTO cur_depura_ui VALUES ("SIN STOCK MINIMO", 2)
		INSERT INTO cur_depura_ui VALUES ("SIN % ALERTA", 3)
		INSERT INTO cur_depura_ui VALUES ("SIN PARAMETRIZAR", 4)
		INSERT INTO cur_depura_ui VALUES ("TODOS", 5)
		
		SELECT cur_depura_ui
		GO TOP
		
		WITH loFrm.combo2
		    .Visible       = .F.
		    .Enabled       = .T.
		    .RowSourceType = 0
		    .RowSource     = ""
		    .Value         = 0
		    .RowSourceType = 2
		    .RowSource     = "cur_depura_ui"
		    .ColumnCount   = 2
		    .BoundColumn   = 2
		    .BoundTo       = .T.
		    .ColumnWidths  = "220,0"
		    .ListIndex     = 0
		    .Visible       = .T.
		    .Refresh()
		ENDWITH
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargarcomboproveedores
		*=========================================================
		* FormSet.CargarComboProveedores
		* - combo2 muestra prov_nomb
		* - combo2.Value = prov_codi
		*=========================================================
		LOCAL loFrm, loConsulta
		LOCAL lnConn, lnRet, lcSQL
		LOCAL laErr[1], lnErr, lcMsg
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF !PEMSTATUS(loFrm, "combo2", 5)
		    MESSAGEBOX("No existe combo2 en el formulario.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF USED("cur_provs")
		    USE IN cur_provs
		ENDIF
		
		IF USED("cur_provs_ui")
		    USE IN cur_provs_ui
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		TEXT TO lcSQL NOSHOW
		SELECT
		    p.prov_codi,
		    IFNULL(p.prov_nomb,'') AS prov_nomb
		FROM proveedores p
		WHERE EXISTS (
		    SELECT 1
		    FROM articulos_proveedores ap
		    JOIN articulos a ON a.art_codi = ap.art_codi
		    LEFT JOIN art_metricas m ON m.art_codi = a.art_codi
		    WHERE ap.prov_codi = p.prov_codi
		      AND (m.art_codi IS NULL OR m.estado = 1)
		)
		ORDER BY p.prov_nomb
		ENDTEXT
		
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_provs")
		
		IF lnRet < 0 OR !USED("cur_provs")
		    lnErr = AERROR(laErr)
		    lcMsg = "Error cargando proveedores." + CHR(13) + ;
		            "Mensaje: " + IIF(lnErr >= 1, TRANSFORM(laErr[1,3]), "(sin mensaje)") + CHR(13) + ;
		            "SQL:" + CHR(13) + lcSQL
		    Desconectar_DB(lnConn)
		    MESSAGEBOX(lcMsg, 16, "MySQL")
		    RETURN .F.
		ENDIF
		
		Desconectar_DB(lnConn)
		
		IF RECCOUNT("cur_provs") = 0
		    MESSAGEBOX("No se encontraron proveedores.", 64, "Info")
		    RETURN .F.
		ENDIF
		
		SELECT ;
		    CAST(cur_provs.prov_nomb AS C(80)) AS x_desc, ;
		    CAST(cur_provs.prov_codi AS I)     AS x_codi ;
		FROM cur_provs ;
		ORDER BY x_desc ;
		INTO CURSOR cur_provs_ui READWRITE
		
		SELECT cur_provs_ui
		GO TOP
		
		WITH loFrm.combo2
		    .Visible       = .F.
		    .RowSourceType = 0
		    .RowSource     = ""
		    .Value         = 0
		
		    .RowSourceType = 2
		    .RowSource     = "cur_provs_ui"
		    .ColumnCount   = 2
		    .ColumnWidths  = "250,0"
		    .BoundColumn   = 2
		    .BoundTo       = .T.
		    .Style         = 2
		    .ListIndex     = 0
		    .Visible       = .T.
		ENDWITH
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargarcomborubros
		*=========================================================
		* FormSet.CargarComboRubros
		* - combo2 muestra rub_desc
		* - combo2.Value = rub_codi
		*=========================================================
		LOCAL loFrm, lnConn, lnRet, lcSQL
		LOCAL laErr[1], lnErr, lcMsg
		
		loFrm = THISFORMSET.principal
		
		IF !PEMSTATUS(loFrm, "combo2", 5)
		    RETURN .F.
		ENDIF
		
		IF USED("cur_rubros")
		    USE IN cur_rubros
		ENDIF
		
		IF USED("cur_rubros_ui")
		    USE IN cur_rubros_ui
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		lcSQL = ;
		    "SELECT r.rub_codi, COALESCE(r.rub_desc,'') AS rub_desc" + ;
		    " FROM rubros r" + ;
		    " WHERE EXISTS (" + ;
		    "   SELECT 1" + ;
		    "   FROM articulos a" + ;
		    "   JOIN art_metricas m ON m.art_codi = a.art_codi" + ;
		    "   WHERE a.rub_codi = r.rub_codi" + ;
		    "   AND m.estado = 1" + ;
		    "   AND GREATEST(0, m.sugerido_comprar - COALESCE(a.pedprov,0)) > 0" + ;
		    " )" + ;
		    " ORDER BY r.rub_desc"
		
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_rubros")
		Desconectar_DB(lnConn)
		
		IF lnRet < 0 OR !USED("cur_rubros")
		    lnErr = AERROR(laErr)
		    lcMsg = "Error cargando rubros."
		
		    IF lnErr >= 1
		        IF TYPE("laErr[1,3]") <> "U"
		            lcMsg = lcMsg + CHR(13) + CHR(13) + TRANSFORM(laErr[1,3])
		        ENDIF
		    ENDIF
		
		    MESSAGEBOX(lcMsg, 16, "MySQL")
		    RETURN .F.
		ENDIF
		
		IF RECCOUNT("cur_rubros") = 0
		    MESSAGEBOX("No se encontraron rubros.", 64, "Info")
		    RETURN .F.
		ENDIF
		
		SELECT ;
		    CAST(cur_rubros.rub_desc AS C(80)) AS x_desc, ;
		    CAST(cur_rubros.rub_codi AS I)     AS x_codi ;
		FROM cur_rubros ;
		ORDER BY x_desc ;
		INTO CURSOR cur_rubros_ui READWRITE
		
		SELECT cur_rubros_ui
		GO TOP
		
		WITH loFrm.combo2
		    .Visible       = .F.
		    .RowSourceType = 0
		    .RowSource     = ""
		    .Value         = 0
		
		    .RowSourceType = 2
		    .RowSource     = "cur_rubros_ui"
		    .ColumnCount   = 2
		    .ColumnWidths  = "250,0"
		    .BoundColumn   = 2
		    .BoundTo       = .T.
		    .Style         = 2
		    .ListIndex     = 0
		    .Visible       = .T.
		ENDWITH
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargardetallesolicitud
		*=============================================================
		* FormSet.CargarDetalleSolicitud
		* Parámetro: tnSoliCodi  I  — código de la solicitud seleccionada
		*=============================================================
		LPARAMETERS tnSoliCodi
		
		LOCAL loConsulta, lcObsSolicitud
		LOCAL lnAreaAnterior
		LOCAL lcSQL, lnRet, lnConn
		LOCAL lnItem, lxVal
		LOCAL lnProvSync, lnTranSync
		LOCAL lcErrMsg
		LOCAL ARRAY laErr[1]
		
		IF VARTYPE(tnSoliCodi) <> "N" OR tnSoliCodi <= 0
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN .F.
		ENDIF
		
		loConsulta = THISFORMSET.secundario
		
		IF VARTYPE(loConsulta) <> "O"
		    RETURN .F.
		ENDIF
		
		lnAreaAnterior = SELECT()
		lnConn         = 0
		lcObsSolicitud = ""
		
		*----------------------------------------------------
		* Evitar que eventos del grid guarden mientras carga
		*----------------------------------------------------
		IF !PEMSTATUS(loConsulta, "xCargandoDetalle", 5)
		    loConsulta.AddProperty("xCargandoDetalle", .F.)
		ENDIF
		loConsulta.xCargandoDetalle = .T.
		
		IF !PEMSTATUS(loConsulta, "xSoliCodiActual", 5)
		    loConsulta.AddProperty("xSoliCodiActual", 0)
		ENDIF
		
		*----------------------------------------------------
		* Conexión
		*----------------------------------------------------
		lnConn = Conectar_DB(_screen.cn)
		
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    loConsulta.xCargandoDetalle = .F.
		    MESSAGEBOX("No se pudo conectar a la base de datos.", 16, "Error")
		
		    IF lnAreaAnterior > 0
		        SELECT (lnAreaAnterior)
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		
		*----------------------------------------------------
		* Sincronizar transporte por última compra del proveedor
		*
		* REGLA:
		* - No mira artículos.
		* - Busca la última compra de cada proveedor de la solicitud.
		* - Si la última compra tiene tran_codi válido > 0:
		*       solicitud_compra_art.tran_codi = ese tran_codi
		* - Si la última compra tiene tran_codi = 0, NULL o inválido:
		*       solicitud_compra_art.tran_codi = NULL
		*
		* IMPORTANTE:
		* Este bloque NO debe impedir que grid2 cargue artículos.
		*----------------------------------------------------
		IF USED("cur_sync_tran_prov")
		    USE IN cur_sync_tran_prov
		ENDIF
		
		TEXT TO lcSQL NOSHOW PRETEXT 15
		SELECT
		    sp.prov_codi,
		    CAST(IFNULL((
		        SELECT
		            CASE
		                WHEN IFNULL(c2.tran_codi, 0) > 0
		                     AND EXISTS (
		                         SELECT 1
		                         FROM transportes t
		                         WHERE t.tran_codi = c2.tran_codi
		                     )
		                THEN c2.tran_codi
		                ELSE 0
		            END
		        FROM compras c2
		        WHERE c2.prov_codi = sp.prov_codi
		          AND UPPER(TRIM(IFNULL(c2.anulado, ''))) NOT IN ('S', '1')
		        ORDER BY c2.orden_fech DESC, c2.orden_codi DESC
		        LIMIT 1
		    ), 0) AS SIGNED) AS tran_codi
		FROM (
		    SELECT DISTINCT
		        prov_codi
		    FROM solicitud_compra_art
		    WHERE soli_codi = ?tnSoliCodi
		      AND IFNULL(prov_codi, 0) > 0
		) sp
		ENDTEXT
		
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_sync_tran_prov")
		
		IF lnRet < 0
		    *-- No cortar la carga del detalle.
		    *-- Si esto falla, igual seguimos para que grid2 muestre artículos.
		    lcErrMsg = "Aviso: no se pudo consultar la última compra por proveedor." + CHR(13) + ;
		               "El detalle se cargará igualmente."
		
		    IF AERROR(laErr) > 0
		        IF TYPE("laErr[1,3]") <> "U"
		            lcErrMsg = lcErrMsg + CHR(13) + TRANSFORM(laErr[1,3])
		        ENDIF
		    ENDIF
		
		    MESSAGEBOX(lcErrMsg, 48, "Aviso Transporte")
		
		ELSE
		
		    IF USED("cur_sync_tran_prov")
		        SELECT cur_sync_tran_prov
		        GO TOP
		
				SCAN
				    *-----------------------------------------------------
				    * Normalizar prov_codi de forma segura
				    * ODBC puede devolver N, I, C, NULL, etc.
				    *-----------------------------------------------------
				    lxVal = cur_sync_tran_prov.prov_codi
		
				    DO CASE
				    CASE ISNULL(lxVal)
				        lnProvSync = 0
		
				    CASE VARTYPE(lxVal) = "N" OR VARTYPE(lxVal) = "I"
				        lnProvSync = INT(lxVal)
		
				    CASE VARTYPE(lxVal) = "C"
				        lnProvSync = INT(VAL(ALLTRIM(lxVal)))
		
				    OTHERWISE
				        lnProvSync = INT(VAL(TRANSFORM(lxVal)))
				    ENDCASE
		
				    *-----------------------------------------------------
				    * Normalizar tran_codi de forma segura
				    * No usar INT(NVL(...)) directo.
				    *-----------------------------------------------------
				    lxVal = cur_sync_tran_prov.tran_codi
		
				    DO CASE
				    CASE ISNULL(lxVal)
				        lnTranSync = 0
		
				    CASE VARTYPE(lxVal) = "N" OR VARTYPE(lxVal) = "I"
				        lnTranSync = INT(lxVal)
		
				    CASE VARTYPE(lxVal) = "C"
				        lnTranSync = INT(VAL(ALLTRIM(lxVal)))
		
				    OTHERWISE
				        lnTranSync = INT(VAL(TRANSFORM(lxVal)))
				    ENDCASE
		
				    IF lnProvSync <= 0
				        LOOP
				    ENDIF
		
		*!*	            IF lnTranSync > 0
		
		*!*	                TEXT TO lcSQL NOSHOW PRETEXT 15
		*!*						UPDATE solicitud_compra_art
		*!*						SET tran_codi = ?lnTranSync
		*!*						WHERE soli_codi = ?tnSoliCodi
		*!*						  AND prov_codi = ?lnProvSync
		*!*						                ENDTEXT
		
		*!*					ELSE
		
		*!*					TEXT TO lcSQL NOSHOW PRETEXT 15
		*!*						UPDATE solicitud_compra_art
		*!*						SET tran_codi = NULL
		*!*						WHERE soli_codi = ?tnSoliCodi
		*!*						  AND prov_codi = ?lnProvSync
		*!*					ENDTEXT
		
		*!*	            ENDIF
		
		
		
		
						IF lnTranSync <= 0
						    SELECT cur_sync_tran_prov
						    LOOP
						ENDIF
		
						TEXT TO lcSQL NOSHOW PRETEXT 15
						UPDATE solicitud_compra_art
						SET tran_codi = ?lnTranSync
						WHERE soli_codi = ?tnSoliCodi
						  AND prov_codi = ?lnProvSync
						  AND IFNULL(tran_codi, 0) <= 0
						ENDTEXT
		
						SQLEXEC(lnConn, lcSQL)
		
		            SELECT cur_sync_tran_prov
		        ENDSCAN
		    ENDIF
		
		ENDIF
		
		IF USED("cur_sync_tran_prov")
		    USE IN cur_sync_tran_prov
		ENDIF
		
		
		*----------------------------------------------------
		* Recrear cur_soli_det limpio
		*----------------------------------------------------
		IF USED("cur_soli_det")
		    USE IN cur_soli_det
		ENDIF
		
		CREATE CURSOR cur_soli_det ( ;
		    ui_item      C(8),    ;
		    art_codi     I,       ;
		    art_desc     C(80),   ;
		    prov_codi    I,       ;
		    det_prov     C(80),   ;
		    det_moneda   C(3),    ;
		    artpro_costo N(15,4), ;
		    artpro_codi  I,       ;
		    cant_soli    N(15,3), ;
		    observacion  M,       ;
		    tran_codi    I,       ;
		    tran_nomb    C(50) )
		
		*----------------------------------------------------
		* Traer detalle completo desde MySQL
		* IMPORTANTE:
		* - tran_codi ya viene sincronizado previamente en solicitud_compra_art
		* - Este SELECT NO debe volver a consultar compras
		* - Solo lee lo que quedó guardado en solicitud_compra_art.tran_codi
		*----------------------------------------------------
		TEXT TO lcSQL NOSHOW PRETEXT 15
		SELECT
		    q.art_codi,
		    q.art_desc,
		    q.prov_codi,
		    q.det_prov,
		    q.det_moneda,
		    q.artpro_costo,
		    q.artpro_codi,
		    q.cant_soli,
		    q.observacion,
		    q.tran_codi,
		    IFNULL(t.tran_nomb, '') AS tran_nomb
		FROM (
		    SELECT
		        CAST(IFNULL(sa.art_codi, 0) AS SIGNED) AS art_codi,
		        IFNULL(a.art_desc, '') AS art_desc,
		        CAST(IFNULL(sa.prov_codi, 0) AS SIGNED) AS prov_codi,
		        IFNULL(p.prov_nomb, '') AS det_prov,
		        IFNULL(ap.moneda, 'P') AS det_moneda,
				IFNULL(sa.artpro_costo, IFNULL(ap.artpro_costo, 0)) + 0E0 AS artpro_costo,
		        CAST(IFNULL(ap.artpro_codi, 0) AS SIGNED) AS artpro_codi,
		        CAST(IFNULL(sa.cant_soli, 0) AS DECIMAL(15,3)) AS cant_soli,
		        IFNULL(sa.observacion, '') AS observacion,
		        CAST(IFNULL(sa.tran_codi, 0) AS SIGNED) AS tran_codi
		    FROM solicitud_compra_art sa
		    LEFT JOIN articulos a
		           ON a.art_codi = sa.art_codi
		    LEFT JOIN proveedores p
		           ON p.prov_codi = sa.prov_codi
		    LEFT JOIN (
		        SELECT
		            art_codi,
		            prov_codi,
		            MIN(artpro_codi) AS artpro_codi,
		            MAX(moneda) AS moneda,
		            MAX(artpro_costo) AS artpro_costo
		        FROM articulos_proveedores
		        GROUP BY art_codi, prov_codi
		    ) ap
		           ON ap.art_codi = sa.art_codi
		          AND ap.prov_codi = sa.prov_codi
		    WHERE sa.soli_codi = ?tnSoliCodi
		) q
		LEFT JOIN transportes t
		       ON t.tran_codi = q.tran_codi
		ORDER BY q.det_prov, q.art_desc
		ENDTEXT
		
		
		
		IF USED("_tmp_soli_det")
		    USE IN _tmp_soli_det
		ENDIF
		
		lnRet = SQLEXEC(lnConn, lcSQL, "_tmp_soli_det")
		
		IF lnRet < 0
		    lcErrMsg = "Error al cargar artículos."
		
		    IF AERROR(laErr) > 0
		        IF TYPE("laErr[1,3]") <> "U"
		            lcErrMsg = lcErrMsg + CHR(13) + TRANSFORM(laErr[1,3])
		        ENDIF
		    ENDIF
		
		    Desconectar_DB(lnConn)
		    lnConn = 0
		
		    loConsulta.xCargandoDetalle = .F.
		    MESSAGEBOX(lcErrMsg, 16, "Error SQL")
		
		    IF lnAreaAnterior > 0
		        SELECT (lnAreaAnterior)
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		*----------------------------------------------------
		* Pasar cursor SQL a cursor local estable
		*----------------------------------------------------
		IF USED("_tmp_soli_det") AND RECCOUNT("_tmp_soli_det") > 0
		
		    lnItem = 0
		
		    SELECT _tmp_soli_det
		    GO TOP
		
		    SCAN
		        lnItem = lnItem + 1
		
		        SELECT cur_soli_det
		        APPEND BLANK
		
		        REPLACE ui_item WITH PADL(TRANSFORM(lnItem), 8)
		
				*-- art_codi
				lxVal = _tmp_soli_det.art_codi
				DO CASE
				CASE VARTYPE(lxVal) = "N"
				    REPLACE art_codi WITH INT(NVL(lxVal, 0))
				CASE VARTYPE(lxVal) = "C"
				    REPLACE art_codi WITH INT(VAL(ALLTRIM(lxVal)))
				OTHERWISE
				    REPLACE art_codi WITH INT(VAL(TRANSFORM(NVL(lxVal, 0))))
				ENDCASE
		
					*-- art_desc
					lxVal = _tmp_soli_det.art_desc
					REPLACE art_desc WITH IIF(VARTYPE(lxVal) = "C", ALLTRIM(lxVal), "")
		
					*-- prov_codi
					lxVal = _tmp_soli_det.prov_codi
					DO CASE
					CASE VARTYPE(lxVal) = "N"
					    REPLACE prov_codi WITH INT(NVL(lxVal, 0))
					CASE VARTYPE(lxVal) = "C"
					    REPLACE prov_codi WITH INT(VAL(ALLTRIM(lxVal)))
					OTHERWISE
					    REPLACE prov_codi WITH INT(VAL(TRANSFORM(NVL(lxVal, 0))))
					ENDCASE
		
					*-- det_prov
					lxVal = _tmp_soli_det.det_prov
					REPLACE det_prov WITH IIF(VARTYPE(lxVal) = "C", ALLTRIM(lxVal), "")
		
					*-- det_moneda
					lxVal = _tmp_soli_det.det_moneda
					REPLACE det_moneda WITH IIF(VARTYPE(lxVal) = "C" AND !EMPTY(ALLTRIM(lxVal)), ALLTRIM(lxVal), "P")
		
					*-- artpro_costo
					lxVal = _tmp_soli_det.artpro_costo
					DO CASE
					CASE INLIST(VARTYPE(lxVal), "N", "F")
					    REPLACE artpro_costo WITH ROUND(NVL(lxVal, 0), 4)
					CASE VARTYPE(lxVal) = "C" AND !EMPTY(ALLTRIM(lxVal))
					    *-- MySQL CHAR siempre usa punto como separador decimal
					    REPLACE artpro_costo WITH ROUND(VAL(ALLTRIM(lxVal)), 4)
					OTHERWISE
					    REPLACE artpro_costo WITH 0
					ENDCASE
		
					*-- artpro_codi
					lxVal = _tmp_soli_det.artpro_codi
					DO CASE
					CASE VARTYPE(lxVal) = "N"
					    REPLACE artpro_codi WITH INT(NVL(lxVal, 0))
					CASE VARTYPE(lxVal) = "C"
					    REPLACE artpro_codi WITH INT(VAL(ALLTRIM(lxVal)))
					OTHERWISE
					    REPLACE artpro_codi WITH INT(VAL(TRANSFORM(NVL(lxVal, 0))))
					ENDCASE
		
					*-- cant_soli
					lxVal = _tmp_soli_det.cant_soli
					DO CASE
					CASE VARTYPE(lxVal) = "N"
					    REPLACE cant_soli WITH NVL(lxVal, 0)
					CASE VARTYPE(lxVal) = "C"
					    REPLACE cant_soli WITH VAL(STRTRAN(ALLTRIM(lxVal), ",", "."))
					OTHERWISE
					    REPLACE cant_soli WITH VAL(STRTRAN(TRANSFORM(NVL(lxVal, 0)), ",", "."))
					ENDCASE
		
		        lxVal = _tmp_soli_det.observacion
		        DO CASE
		        CASE VARTYPE(lxVal) = "C"
		            REPLACE observacion WITH lxVal
		        CASE VARTYPE(lxVal) = "M"
		            REPLACE observacion WITH lxVal
		        OTHERWISE
		            REPLACE observacion WITH ""
		        ENDCASE
		
			lxVal = _tmp_soli_det.tran_codi
			DO CASE
			CASE VARTYPE(lxVal) = "N"
			    REPLACE tran_codi WITH INT(NVL(lxVal, 0))
			CASE VARTYPE(lxVal) = "C"
			    REPLACE tran_codi WITH INT(VAL(ALLTRIM(lxVal)))
			OTHERWISE
			    REPLACE tran_codi WITH INT(VAL(TRANSFORM(NVL(lxVal, 0))))
			ENDCASE
		
				lxVal = _tmp_soli_det.tran_nomb
		
				IF NVL(cur_soli_det.tran_codi, 0) <= 0
				    *-- Blanco visual estable para el combo.
				    *-- Se ve vacío, pero el ComboBox lo puede sostener mejor que "".
				    REPLACE tran_nomb WITH CHR(160)
				ELSE
				    REPLACE tran_nomb WITH IIF(VARTYPE(lxVal) = "C", ALLTRIM(lxVal), "")
				ENDIF
		
		        SELECT _tmp_soli_det
		    ENDSCAN
		
		    *-- Registro fantasma: absorbe artefacto EOF del grid VFP
		*!*	    SELECT cur_soli_det
		*!*	    APPEND BLANK
		*!*	    GO BOTTOM
		*!*	    DELETE
		
		ENDIF
		
		IF USED("_tmp_soli_det")
		    USE IN _tmp_soli_det
		ENDIF
		
		*!*	*----------------------------------------------------
		*!*	* Diagnóstico TEMPORAL de carga del detalle
		*!*	*----------------------------------------------------
		*!*	STORE 0 TO lnTotDet, lnSinProv
		
		*!*	IF USED("cur_soli_det")
		*!*	    SELECT cur_soli_det
		
		*!*	    COUNT TO lnTotDet
		*!*	    COUNT FOR NVL(prov_codi, 0) <= 0 TO lnSinProv
		
		*!*	    MESSAGEBOX( ;
		*!*	        "Detalle cargado:" + CHR(13) + ;
		*!*	        "Solicitud: " + TRANSFORM(tnSoliCodi) + CHR(13) + ;
		*!*	        "Items: " + TRANSFORM(lnTotDet) + CHR(13) + ;
		*!*	        "Sin prov_codi: " + TRANSFORM(lnSinProv), ;
		*!*	        64, ;
		*!*	        "Diagnostico CargarDetalleSolicitud" ;
		*!*	    )
		
		*!*	    IF RECCOUNT("cur_soli_det") > 0
		*!*	        GO TOP
		*!*	    ENDIF
		*!*	ENDIF
		
		*----------------------------------------------------
		* Leer observación GENERAL de la solicitud
		*----------------------------------------------------
		lcObsSolicitud = ""
		
		TEXT TO lcSQL NOSHOW PRETEXT 15
		SELECT
		    IFNULL(observaciones, '') AS observaciones
		FROM solicitud_compra
		WHERE soli_codi = ?tnSoliCodi
		LIMIT 1
		ENDTEXT
		
		IF USED("_tmp_obs")
		    USE IN _tmp_obs
		ENDIF
		
		lnRet = SQLEXEC(lnConn, lcSQL, "_tmp_obs")
		
		IF lnRet > 0 AND USED("_tmp_obs") AND RECCOUNT("_tmp_obs") > 0
		    SELECT _tmp_obs
		    GO TOP
		
		    lxVal = _tmp_obs.observaciones
		
		    DO CASE
		    CASE VARTYPE(lxVal) = "C"
		        lcObsSolicitud = ALLTRIM(lxVal)
		    CASE VARTYPE(lxVal) = "M"
		        lcObsSolicitud = ALLTRIM(lxVal)
		    OTHERWISE
		        lcObsSolicitud = ""
		    ENDCASE
		ENDIF
		
		IF USED("_tmp_obs")
		    USE IN _tmp_obs
		ENDIF
		
		*----------------------------------------------------
		* Cerrar conexión
		*----------------------------------------------------
		Desconectar_DB(lnConn)
		lnConn = 0
		
		*----------------------------------------------------
		* Estado del formulario secundario
		*----------------------------------------------------
		WITH loConsulta
		
		    .xSoliCodiActual = tnSoliCodi
		
		    IF PEMSTATUS(THISFORMSET, "BloquearEdicionObservacionSecundario", 5)
		        THISFORMSET.BloquearEdicionObservacionSecundario(m.lcObsSolicitud)
		    ELSE
		        IF PEMSTATUS(loConsulta, "edit1", 5)
		            .edit1.Value     = m.lcObsSolicitud
		            .edit1.Enabled   = .F.
		            .edit1.ReadOnly  = .T.
		            .edit1.BackColor = RGB(245,245,245)
		            .edit1.ForeColor = RGB(0,0,0)
		            .edit1.Refresh()
		        ENDIF
		    ENDIF
		
		    IF PEMSTATUS(loConsulta, "xObsOriginal", 5)
		        .xObsOriginal = m.lcObsSolicitud
		    ENDIF
		
		    IF PEMSTATUS(loConsulta, "xObsEditando", 5)
		        .xObsEditando = .F.
		    ENDIF
		
			IF PEMSTATUS(loConsulta, "command3", 5)
			    .command3.Caption = "EDITAR"
			    .command3.Enabled = .F.
			    .command3.Refresh()
			ENDIF
		
		
		ENDWITH
		
		*----------------------------------------------------
		* Configurar grid2
		*----------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ConfigurarGridDetalle", 5)
		    THISFORMSET.ConfigurarGridDetalle(.T.)
		ENDIF
		
		IF USED("cur_soli_det") AND RECCOUNT("cur_soli_det") > 0
		    SELECT cur_soli_det
		    GO TOP
		ENDIF
		
		IF PEMSTATUS(loConsulta, "grid2", 5)
		    loConsulta.grid2.Refresh()
		ENDIF
		
		*-- Preseleccionar combo transporte en el primer registro
		IF PEMSTATUS(THISFORMSET, "SincronizarComboTransporte", 5)
		    THISFORMSET.SincronizarComboTransporte()
		ENDIF
		
		*-- Reasignar edit1 por seguridad sin habilitar edición
		IF PEMSTATUS(loConsulta, "edit1", 5)
		    loConsulta.edit1.Value     = m.lcObsSolicitud
		    loConsulta.edit1.Enabled   = .F.
		    loConsulta.edit1.ReadOnly  = .T.
		    loConsulta.edit1.BackColor = RGB(245,245,245)
		    loConsulta.edit1.ForeColor = RGB(0,0,0)
		    loConsulta.edit1.Refresh()
		ENDIF
		
		loConsulta.xCargandoDetalle = .F.
		
		IF lnAreaAnterior > 0
		    SELECT (lnAreaAnterior)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargarfiltropedidos
		*=========================================================
		* FormSet.CargarFiltroPedidos
		* Construye cur_temp desde pedidos por rango fecha
		* - NO repite artículos
		* - Conserva métricas de cur_raw_full para labels y grd_venta_compra
		* - Compatible con campos Memo (sin DISTINCT)
		*=========================================================
		LOCAL loFrm, lnConn, lcSql, ldDesde, ldHasta
		LOCAL lnRet, laErr[1], lcErrMsg
		
		IF TYPE("THISFORMSET.principal.Name") = "U"
		    RETURN .F.
		ENDIF
		
		loFrm = THISFORMSET.principal
		IF VARTYPE(loFrm) # "O"
		    RETURN .F.
		ENDIF
		
		*-- Resetear mensaje pendiente: solo importa el resultado de la llamada más reciente
		IF PEMSTATUS(THISFORMSET, "xMensajePendiente", 5)
		    THISFORMSET.xMensajePendiente = ""
		ENDIF
		
		IF !USED("cur_raw_full")
		    MESSAGEBOX("cur_raw_full no existe. Debe cargarse antes del filtro PEDIDOS.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		ldDesde = DATE()
		ldHasta = DATE()
		
		IF PEMSTATUS(loFrm, "txt_fecdes", 5) AND VARTYPE(loFrm.txt_fecdes.Value) = "D"
		    ldDesde = loFrm.txt_fecdes.Value
		ENDIF
		
		IF PEMSTATUS(loFrm, "txt_fechas", 5) AND VARTYPE(loFrm.txt_fechas.Value) = "D"
		    ldHasta = loFrm.txt_fechas.Value
		ENDIF
		
		IF ldDesde > ldHasta
		    ldHasta = ldDesde
		    IF PEMSTATUS(loFrm, "txt_fechas", 5)
		        loFrm.txt_fechas.Value = ldHasta
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(loFrm, "xPedFecDes", 5)
		    loFrm.xPedFecDes = ldDesde
		ENDIF
		
		IF PEMSTATUS(loFrm, "xPedFecHas", 5)
		    loFrm.xPedFecHas = ldHasta
		ENDIF
		
		IF USED("cur_temp")
		    USE IN cur_temp
		ENDIF
		
		IF USED("cur_pedidos_art")
		    USE IN cur_pedidos_art
		ENDIF
		
		IF USED("cur_ped_dup")
		    USE IN cur_ped_dup
		ENDIF
		
		IF USED("cur_raw_dup")
		    USE IN cur_raw_dup
		ENDIF
		
		TEXT TO lcSql NOSHOW
		SELECT
		    pa.art_codi,
		    SUM(IFNULL(pa.artped_cant,0) - IFNULL(pa.artped_ent,0)) AS pedidos_rango
		FROM pedidos p
		JOIN pedidos_articulos pa
		    ON pa.ped_codi = p.ped_codi
		LEFT JOIN art_metricas m
		    ON m.art_codi = pa.art_codi
		WHERE p.ped_fech BETWEEN ?ldDesde AND ?ldHasta
		  AND IFNULL(m.estado,1) = 1
		GROUP BY pa.art_codi
		ORDER BY pa.art_codi
		ENDTEXT
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		lnRet = SQLEXEC(lnConn, lcSql, "cur_pedidos_art")
		
		IF lnRet < 0
		    AERROR(laErr)
		    lcErrMsg = "No se pudo consultar pedidos." + CHR(13) + CHR(13)
		
		    IF TYPE("laErr[1,2]") # "U"
		        lcErrMsg = lcErrMsg + "Detalle: " + TRANSFORM(laErr[1,2])
		    ENDIF
		
		    IF TYPE("laErr[1,3]") # "U"
		        lcErrMsg = lcErrMsg + CHR(13) + "MySQL/ODBC: " + TRANSFORM(laErr[1,3])
		    ENDIF
		
		    Desconectar_DB(lnConn)
		    MESSAGEBOX(lcErrMsg, 16, "Error SQL")
		    RETURN .F.
		ENDIF
		
		Desconectar_DB(lnConn)
		
		IF !USED("cur_pedidos_art")
		    MESSAGEBOX("No se creó el cursor cur_pedidos_art.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Validación diagnóstica: cur_pedidos_art no debe repetir art_codi
		*---------------------------------------------------------
		SELECT ;
		    art_codi, ;
		    COUNT(*) AS cant ;
		FROM cur_pedidos_art ;
		GROUP BY art_codi ;
		HAVING COUNT(*) > 1 ;
		INTO CURSOR cur_ped_dup READWRITE
		
		IF USED("cur_ped_dup") AND RECCOUNT("cur_ped_dup") > 0
		    MESSAGEBOX("Se detectaron artículos repetidos en cur_pedidos_art. Revisar construcción del filtro PEDIDOS.", 16, "Validación")
		    USE IN cur_ped_dup
		    USE IN cur_pedidos_art
		    RETURN .F.
		ENDIF
		
		IF USED("cur_ped_dup")
		    USE IN cur_ped_dup
		ENDIF
		
		IF RECCOUNT("cur_pedidos_art") = 0
		    IF PEMSTATUS(THISFORMSET, "CrearCurTempVacioAlerts", 5)
		        THISFORMSET.CrearCurTempVacioAlerts()
		    ENDIF
		
		    USE IN cur_pedidos_art
		
			LOCAL lcMsg
			lcMsg = "No existen pedidos pendientes entre " + DTOC(ldDesde) + " y " + DTOC(ldHasta) + "."
		
			IF PEMSTATUS(THISFORMSET, "xEstaInicializando", 5) AND THISFORMSET.xEstaInicializando
			    * Guardar mensaje para mostrarlo después del renderizado (solo el primero)
			    IF EMPTY(THISFORMSET.xMensajePendiente)
			        THISFORMSET.xMensajePendiente = lcMsg
			    ENDIF
			ELSE
			    MESSAGEBOX(lcMsg, 64, "Filtro Pedidos")
			ENDIF
			
		    RETURN .T.
		ENDIF
		
		*---------------------------------------------------------
		* Validación diagnóstica: cur_raw_full no debe repetir art_codi
		*---------------------------------------------------------
		SELECT ;
		    art_codi, ;
		    COUNT(*) AS cant ;
		FROM cur_raw_full ;
		GROUP BY art_codi ;
		HAVING COUNT(*) > 1 ;
		INTO CURSOR cur_raw_dup READWRITE
		
		IF USED("cur_raw_dup") AND RECCOUNT("cur_raw_dup") > 0
		    MESSAGEBOX("cur_raw_full tiene artículos repetidos. Revisar carga base antes del filtro PEDIDOS.", 16, "Validación")
		    USE IN cur_raw_dup
		    USE IN cur_pedidos_art
		    RETURN .F.
		ENDIF
		
		IF USED("cur_raw_dup")
		    USE IN cur_raw_dup
		ENDIF
		
		*---------------------------------------------------------
		* Cruce contra cur_raw_full para conservar métricas completas
		* SIN DISTINCT porque hay campos Memo
		*---------------------------------------------------------
		SELECT ;
		    r.art_codi, ;
		    r.art_desc, ;
		    r.art_stock, ;
		    r.art_stmin, ;
		    r.art_pct_alerta, ;
		    p.pedidos_rango AS pedidos, ;
		    r.pedprov, ;
		    (NVL(r.art_stock,0) + NVL(r.pedprov,0) - NVL(p.pedidos_rango,0)) AS posicion, ;
		    r.sug_neto, ;
		    r.pct_rotacion, ;
		    CAST(NVL(r.ventas_metrics,'') AS M) AS ventas_metrics, ;
		    r.promedio_venta, ;
		    CAST(NVL(r.fecha_ult_venta,{}) AS D) AS fecha_ult_venta, ;
		    CAST(NVL(r.compras_metrics,'') AS M) AS compras_metrics, ;
		    r.promedio_compra, ;
		    CAST(NVL(r.fecha_ult_compra,{}) AS D) AS fecha_ult_compra, ;
		    r.dias_demora_ent, ;
		    r.pos_min_sug, ;
		    r.sugerido_comprar, ;
		    CAST(0 AS N(15,3)) AS cant_soli, ;
		    r.meses_cubiertos, ;
		    r.meses_cob_proy, ;
		    r.meses_cobert_solic, ;
		    r.score, ;
		    CAST(NVL(r.estado,1) AS I) AS estado, ;
		    r.rub_codi, ;
		    r.rub_desc, ;
		    r.prov_codi_sel, ;
		    r.prov_nomb_sel, ;
		    r.artpro_costo, ;
		    r.artpro_moneda, ;
		    CAST({} AS D) AS artpro_fecha, ;
		    CAST(NVL(r.prov_lista,'') AS M) AS prov_lista, ;
		    CAST(0 AS N(12,0)) AS col_back, ;
		    CAST(0 AS N(12,0)) AS col_fore, ;
		    CAST('' AS C(8)) AS ui_item, ;
		    CAST(.F. AS L)   AS ui_sel ;
		FROM cur_raw_full r ;
		JOIN cur_pedidos_art p ;
		    ON p.art_codi = r.art_codi ;
		WHERE NVL(r.estado,1) = 1 ;
		ORDER BY r.art_desc ;
		INTO CURSOR cur_temp READWRITE
		
		USE IN cur_pedidos_art
		
		RETURN USED("cur_temp")
	ENDPROC

	PROCEDURE cargargrdprov
		*=========================================================
		* FormSet.CargarGrdProv
		*=========================================================
		LOCAL loFrm, lcProvLista
		LOCAL lcCostoTxt
		LOCAL ARRAY laLines[1]
		LOCAL lnLines, lnI, lcEntry
		LOCAL lnC1, lnC2, lnC3, lnC4, lnC5, lnC6
		LOCAL lcNomb, lnCodi, lnCosto, lcMoneda, ldFecha
		LOCAL lcSafety, lcFechaTxt
		LOCAL lnLista, lnCotiz
		LOCAL llFormatoNuevo
		loFrm = THISFORMSET.principal
		IF !USED("cur_provs_col10")
		    RETURN .F.
		ENDIF
		*-- Limpiar registros anteriores
		lcSafety = SET("SAFETY")
		SET SAFETY OFF
		SELECT cur_provs_col10
		ZAP
		IF UPPER(ALLTRIM(lcSafety)) == "ON"
		    SET SAFETY ON
		ELSE
		    SET SAFETY OFF
		ENDIF
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0 OR EOF("cur_alerts")
		    IF PEMSTATUS(loFrm, "grd_prov", 5)
		        loFrm.grd_prov.Refresh()
		    ENDIF
		    RETURN .T.
		ENDIF
		lcProvLista = ""
		IF TYPE("cur_alerts.prov_lista") # "U"
		    lcProvLista = ALLTRIM(cur_alerts.prov_lista)
		ENDIF
		
		IF EMPTY(lcProvLista)
		    *-- Cursor ya fue ZAPeado arriba, solo refrescar
		    IF PEMSTATUS(loFrm, "grd_prov", 5)
		        loFrm.grd_prov.Refresh()
		    ENDIF
		    RETURN .T.
		ENDIF
		lnLines = ALINES(laLines, lcProvLista, .T., CHR(10))
		FOR lnI = 1 TO lnLines
		    lcEntry = ALLTRIM(laLines[lnI])
		    IF EMPTY(lcEntry)
		        LOOP
		    ENDIF
		    lnC1 = AT("^", lcEntry)
		    lnC2 = AT("^", lcEntry, 2)
		    lnC3 = AT("^", lcEntry, 3)
		    lnC4 = AT("^", lcEntry, 4)
		    lnC5 = AT("^", lcEntry, 5)
		    lnC6 = AT("^", lcEntry, 6)
		    IF lnC1 = 0 OR lnC2 = 0 OR lnC3 = 0
		        LOOP
		    ENDIF
		    lcNomb   = ALLTRIM(SUBSTR(lcEntry, 1, lnC1 - 1))
		    lnCodi   = VAL(IIF(lnC2 > lnC1, ALLTRIM(SUBSTR(lcEntry, lnC1+1, lnC2-lnC1-1)), "0"))
		    
		    
			LOCAL lcOldPoint
		
			lcCostoTxt = IIF(lnC3 > lnC2, ALLTRIM(SUBSTR(lcEntry, lnC2+1, lnC3-lnC2-1)), "0")
			lcCostoTxt = STRTRAN(lcCostoTxt, " ", "")
		
			*---------------------------------------------------------
			* Normalizar separador decimal.
			* MySQL normalmente devuelve decimal con punto.
			* VFP puede estar usando coma por configuración regional.
			* Por eso antes de VAL() forzamos SET POINT TO "."
			*---------------------------------------------------------
			DO CASE
		
			CASE "," $ lcCostoTxt AND "." $ lcCostoTxt
		
			    IF RAT(",", lcCostoTxt) > RAT(".", lcCostoTxt)
			        * Ejemplo: 53.106,5600
			        * Punto = miles / Coma = decimal
			        lcCostoTxt = STRTRAN(lcCostoTxt, ".", "")
			        lcCostoTxt = STRTRAN(lcCostoTxt, ",", ".")
			    ELSE
			        * Ejemplo: 53,106.5600
			        * Coma = miles / Punto = decimal
			        lcCostoTxt = STRTRAN(lcCostoTxt, ",", "")
			    ENDIF
		
			CASE "," $ lcCostoTxt
			    * Ejemplo: 53106,5600
			    lcCostoTxt = STRTRAN(lcCostoTxt, ",", ".")
		
			ENDCASE
		
			lcOldPoint = SET("POINT")
			SET POINT TO "."
		
			lnCosto = VAL(lcCostoTxt)
		
			SET POINT TO (lcOldPoint)
		
		
		    IF lnC4 > lnC3
		        lcMoneda = ALLTRIM(SUBSTR(lcEntry, lnC3+1, lnC4-lnC3-1))
		    ELSE
		        lcMoneda = "P"
		    ENDIF
		    *-- Detectar si la línea viene en formato nuevo o viejo
		    llFormatoNuevo = (lnC5 > lnC4 AND lnC6 > lnC5)
		    lnLista    = 0
		    lnCotiz    = 0
		    ldFecha    = {}
		    lcFechaTxt = ""
		    IF llFormatoNuevo
		        *-- Formato nuevo: nomb^codi^costo^moneda^lista^cotiz^fecha
		        lnLista = VAL(ALLTRIM(SUBSTR(lcEntry, lnC4+1, lnC5-lnC4-1)))
		        lnCotiz = VAL(ALLTRIM(SUBSTR(lcEntry, lnC5+1, lnC6-lnC5-1)))
		        IF lnC6 < LEN(lcEntry)
		            lcFechaTxt = ALLTRIM(SUBSTR(lcEntry, lnC6 + 1))
		        ENDIF
		    ELSE
		        *-- Formato viejo: nomb^codi^costo^moneda^fecha
		        IF lnC4 < LEN(lcEntry)
		            lcFechaTxt = ALLTRIM(SUBSTR(lcEntry, lnC4 + 1))
		        ENDIF
		    ENDIF
			IF !EMPTY(lcFechaTxt)
			    ldFecha = {}
			    lcFechaTxt = ALLTRIM(lcFechaTxt)
		
			    *-- Espera formato ISO: YYYY-MM-DD HH:MM:SS
			    IF LEN(lcFechaTxt) >= 10 ;
			       AND SUBSTR(lcFechaTxt, 5, 1) = "-" ;
			       AND SUBSTR(lcFechaTxt, 8, 1) = "-"
		
			        LOCAL lnAnio, lnMes, lnDia
			        lnAnio = VAL(SUBSTR(lcFechaTxt, 1, 4))
			        lnMes  = VAL(SUBSTR(lcFechaTxt, 6, 2))
			        lnDia  = VAL(SUBSTR(lcFechaTxt, 9, 2))
		
			        IF BETWEEN(lnAnio, 1900, 2100) ;
			           AND BETWEEN(lnMes, 1, 12) ;
			           AND BETWEEN(lnDia, 1, 31)
			            TRY
			                ldFecha = DATE(lnAnio, lnMes, lnDia)
			            CATCH
			                ldFecha = {}
			            ENDTRY
			        ENDIF
			    ENDIF
			ENDIF
		    IF EMPTY(lcNomb)
		        LOOP
		    ENDIF
		    SELECT cur_provs_col10
		    APPEND BLANK
		    REPLACE prov_nomb     WITH lcNomb,   ;
		            prov_codi     WITH lnCodi,   ;
		            artpro_costo  WITH lnCosto,  ;
		            artpro_moneda WITH lcMoneda, ;
		            artpro_fecha  WITH ldFecha
		    IF TYPE("cur_provs_col10.lista") # "U"
		        REPLACE lista WITH lnLista, ;
		                cotiz WITH lnCotiz
		    ENDIF
		NEXT lnI
		SELECT cur_provs_col10
		IF RECCOUNT() > 0
		    GO TOP
		ENDIF
		*-- Camaleón: ajustar HighlightBackColor al primer registro antes del Refresh
		IF PEMSTATUS(loFrm, "grd_prov", 5)
		    IF RECCOUNT("cur_provs_col10") > 0 AND !EOF("cur_provs_col10") ;
		        AND PEMSTATUS(THISFORMSET, "DarkenColor", 5)
		        LOCAL lnL_, lnC_, llCol_, lnHB_, lnHF_
		        lnL_   = IIF(TYPE("cur_provs_col10.lista")="N", cur_provs_col10.lista, 0)
		        lnC_   = IIF(TYPE("cur_provs_col10.cotiz")="N", cur_provs_col10.cotiz, 0)
		        llCol_ = (lnL_ = 1 OR lnC_ = 1)
		        DO CASE
		            CASE lnL_=1 AND lnC_=0
		                lnHB_ = THISFORMSET.DarkenColor(RGB(144,238,144), 0.72)
		            CASE lnL_=0 AND lnC_=1
		                lnHB_ = THISFORMSET.DarkenColor(RGB(230,240,20),  0.72)
		            CASE lnL_=1 AND lnC_=1
		                lnHB_ = THISFORMSET.DarkenColor(RGB(255,211,168), 0.72)
		            OTHERWISE
		                lnHB_ = RGB(70, 130, 180)
		        ENDCASE
		        lnHF_ = IIF(llCol_, RGB(0,0,0), RGB(255,255,255))
		        loFrm.grd_prov.HighlightBackColor = lnHB_
		        loFrm.grd_prov.HighlightForeColor = lnHF_
		    ENDIF
		    loFrm.grd_prov.Refresh()
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE cargarhistorialsolicitudes
		*=========================================================
		* FormSet.CargarHistorialSolicitudes
		*=========================================================
		LOCAL loFrm, loConsulta
		LOCAL lnConn, lnRet, lcSQL, laErr[1], lcMsg
		LOCAL lcSafety
		
		loFrm = THISFORMSET.principal
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		*---------------------------------------------------------
		* Asegurar estructura estable del cursor historial
		*---------------------------------------------------------
		IF USED("cur_soli_hist")
		    IF TYPE("cur_soli_hist.soli_codi") = "U" OR ;
		       TYPE("cur_soli_hist.soli_fecha_txt") = "U"
		        USE IN cur_soli_hist
		    ENDIF
		ENDIF
		
		IF !USED("cur_soli_hist")
		    CREATE CURSOR cur_soli_hist ( ;
		        soli_codi      I, ;
		        soli_fecha     D, ;
		        soli_fecha_txt C(10), ;
		        estado         C(20), ;
		        observaciones  M, ;
		        cant_items     I, ;
		        cant_total     N(9,2) )
		ENDIF
		
		*---------------------------------------------------------
		* Limpiar cursor destino
		*---------------------------------------------------------
		lcSafety = SET("SAFETY")
		SET SAFETY OFF
		SELECT cur_soli_hist
		ZAP
		IF UPPER(ALLTRIM(lcSafety)) == "ON"
		    SET SAFETY ON
		ELSE
		    SET SAFETY OFF
		ENDIF
		
		IF USED("cur_soli_hist_tmp")
		    USE IN cur_soli_hist_tmp
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		TEXT TO lcSQL NOSHOW
		SELECT
		    sc.soli_codi,
		    DATE(sc.soli_fecha) AS soli_fecha,
		    DATE_FORMAT(sc.soli_fecha, '%d/%m/%y') AS soli_fecha_txt,
		    UPPER(TRIM(IFNULL(sc.estado, 'PENDIENTE'))) AS estado,
		    IFNULL(sc.observaciones, '') AS observaciones,
		    IFNULL(COUNT(d.art_codi), 0) AS cant_items,
		    IFNULL(SUM(d.cant_soli), 0) AS cant_total
		FROM solicitud_compra sc
		LEFT JOIN solicitud_compra_art d
		    ON d.soli_codi = sc.soli_codi
		GROUP BY
		    sc.soli_codi,
		    sc.soli_fecha,
		    sc.estado,
		    sc.observaciones
		ORDER BY sc.soli_codi DESC
		ENDTEXT
		
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_soli_hist_tmp")
		Desconectar_DB(lnConn)
		
		IF lnRet < 0 OR !USED("cur_soli_hist_tmp")
		    IF AERROR(laErr) > 0
		        lcMsg = laErr[1,3]
		    ELSE
		        lcMsg = "No se pudieron cargar las solicitudes."
		    ENDIF
		    MESSAGEBOX(lcMsg, 16, "Error")
		    RETURN .F.
		ENDIF
		
		SELECT cur_soli_hist_tmp
		SCAN
		    INSERT INTO cur_soli_hist ;
		        (soli_codi, soli_fecha, soli_fecha_txt, estado, observaciones, cant_items, cant_total) ;
		    VALUES ;
		        ( ;
		        VAL(TRANSFORM(cur_soli_hist_tmp.soli_codi)), ;
		        IIF(VARTYPE(cur_soli_hist_tmp.soli_fecha) = "D", ;
		            cur_soli_hist_tmp.soli_fecha, ;
		            TTOD(cur_soli_hist_tmp.soli_fecha)), ;
		        ALLTRIM(TRANSFORM(cur_soli_hist_tmp.soli_fecha_txt)), ;
		        UPPER(ALLTRIM(TRANSFORM(NVL(cur_soli_hist_tmp.estado, "PENDIENTE")))), ;
		        TRANSFORM(NVL(cur_soli_hist_tmp.observaciones, "")), ;
		        VAL(TRANSFORM(NVL(cur_soli_hist_tmp.cant_items, 0))), ;
		        VAL(TRANSFORM(NVL(cur_soli_hist_tmp.cant_total, 0))) ;
		        )
		ENDSCAN
		
		USE IN cur_soli_hist_tmp
		
		IF !PEMSTATUS(loConsulta, "xSoliCodiActual", 5)
		    loConsulta.AddProperty("xSoliCodiActual", 0)
		ENDIF
		
		IF RECCOUNT("cur_soli_hist") > 0
		    SELECT cur_soli_hist
		    GO TOP
		
		    loConsulta.xSoliCodiActual = cur_soli_hist.soli_codi
		
		    IF PEMSTATUS(THISFORMSET, "CargarDetalleSolicitud", 5)
		        THISFORMSET.CargarDetalleSolicitud(cur_soli_hist.soli_codi)
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "ActualizarLabelEstadoOC", 5)
		        THISFORMSET.ActualizarLabelEstadoOC(cur_soli_hist.soli_codi)
		    ENDIF
		    
		ELSE
		    loConsulta.xSoliCodiActual = 0
		
		    IF PEMSTATUS(THISFORMSET, "LimpiarDetalleSolicitud", 5)
		        THISFORMSET.LimpiarDetalleSolicitud()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "ActualizarLabelEstadoOC", 5)
		        THISFORMSET.ActualizarLabelEstadoOC(0)
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(loConsulta, "grid1", 5)
		    loConsulta.grid1.RecordSource = ""
		    loConsulta.grid1.RecordSource = "cur_soli_hist"
		    loConsulta.grid1.Refresh()
		ENDIF
		
		IF PEMSTATUS(loConsulta, "grid2", 5)
		    loConsulta.grid2.Refresh()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargarhistorialsolicitudesfiltrado
		*=========================================================
		* FormSet.CargarHistorialSolicitudesFiltrado
		* - Carga historial de solicitudes por rango de fechas
		* - Filtra solicitud_compra.soli_fecha
		* - Refresca secundario.Grid1 sin perder formato
		*=========================================================
		LPARAMETERS tdDesde, tdHasta
		
		LOCAL loConsulta
		LOCAL lnConn, lnRet, lcSQL
		LOCAL laErr[1], lcErrMsg
		LOCAL lnSoliCodi
		LOCAL lcSafety
		LOCAL ldFechaFox
		LOCAL lcFechaTxt
		LOCAL lcFechaISO
		
		LOCAL lnSoliIns, lcEstadoIns, lcObsIns, lnItemsIns, lnTotalIns
		LOCAL lnAnio, lnMes, lnDia
		LOCAL tdHastaNext
		LOCAL lcDesdeISO, lcHastaISO
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN .F.
		ENDIF
		
		loConsulta = THISFORMSET.secundario
		
		IF VARTYPE(loConsulta) <> "O"
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 1) Normalizar fechas recibidas
		*---------------------------------------------------------
		IF VARTYPE(tdDesde) <> "D" OR EMPTY(tdDesde)
		    tdDesde = GOMONTH(DATE(), -12)
		ENDIF
		
		IF VARTYPE(tdHasta) <> "D" OR EMPTY(tdHasta)
		    tdHasta = DATE()
		ENDIF
		
		IF tdDesde > tdHasta
		    tdHasta = tdDesde
		ENDIF
		
		tdHastaNext = tdHasta + 1
		
		lcDesdeISO = ;
		    TRANSFORM(YEAR(tdDesde)) + "-" + ;
		    PADL(TRANSFORM(MONTH(tdDesde)), 2, "0") + "-" + ;
		    PADL(TRANSFORM(DAY(tdDesde)), 2, "0") + " 00:00:00"
		
		lcHastaISO = ;
		    TRANSFORM(YEAR(tdHastaNext)) + "-" + ;
		    PADL(TRANSFORM(MONTH(tdHastaNext)), 2, "0") + "-" + ;
		    PADL(TRANSFORM(DAY(tdHastaNext)), 2, "0") + " 00:00:00"
		
		*---------------------------------------------------------
		* 2) Guardar estado en form secundario
		*---------------------------------------------------------
		IF PEMSTATUS(loConsulta, "xHistFecDes", 5)
		    loConsulta.xHistFecDes = tdDesde
		ELSE
		    loConsulta.AddProperty("xHistFecDes", tdDesde)
		ENDIF
		
		IF PEMSTATUS(loConsulta, "xHistFecHas", 5)
		    loConsulta.xHistFecHas = tdHasta
		ELSE
		    loConsulta.AddProperty("xHistFecHas", tdHasta)
		ENDIF
		
		*---------------------------------------------------------
		* 3) Refrescar controles visuales
		*---------------------------------------------------------
		IF PEMSTATUS(loConsulta, "txt_fecdes_hist", 5)
		    loConsulta.txt_fecdes_hist.Value = tdDesde
		    loConsulta.txt_fecdes_hist.Refresh()
		ENDIF
		
		IF PEMSTATUS(loConsulta, "txt_fechas_hist", 5)
		    loConsulta.txt_fechas_hist.Value = tdHasta
		    loConsulta.txt_fechas_hist.Refresh()
		ENDIF
		
		*---------------------------------------------------------
		* 4) Limpiar / crear cursores
		*---------------------------------------------------------
		IF USED("cur_soli_hist_sql")
		    USE IN cur_soli_hist_sql
		ENDIF
		
		lcSafety = SET("SAFETY")
		SET SAFETY OFF
		
		IF USED("cur_soli_hist")
		    SELECT cur_soli_hist
		    ZAP
		ELSE
		    CREATE CURSOR cur_soli_hist ( ;
		        soli_codi      I, ;
		        soli_fecha     D, ;
		        soli_fecha_txt C(10), ;
		        estado         C(20), ;
		        observaciones  M, ;
		        cant_items     I, ;
		        cant_total     N(15,3) )
		ENDIF
		
		IF USED("cur_soli_det")
		    SELECT cur_soli_det
		    ZAP
		ENDIF
		
		IF UPPER(ALLTRIM(lcSafety)) == "ON"
		    SET SAFETY ON
		ELSE
		    SET SAFETY OFF
		ENDIF
		
		*---------------------------------------------------------
		* 5) Consultar MySQL
		*---------------------------------------------------------
		lnConn = Conectar_DB(_screen.cn)
		
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL para cargar historial.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		TEXT TO lcSQL NOSHOW PRETEXT 15
		SELECT
		    s.soli_codi,
		    DATE_FORMAT(s.soli_fecha, '%Y-%m-%d') AS soli_fecha_iso,
		    DATE_FORMAT(s.soli_fecha, '%d/%m/%y') AS soli_fecha_txt_sql,
		    IFNULL(s.estado,'')                   AS estado,
		    IFNULL(s.observaciones,'')            AS observaciones,
		    COUNT(d.art_codi)                     AS cant_items,
		    IFNULL(SUM(IFNULL(d.cant_soli,0)),0)  AS cant_total
		FROM solicitud_compra s
		LEFT JOIN solicitud_compra_art d
		       ON d.soli_codi = s.soli_codi
		WHERE s.soli_fecha >= ?lcDesdeISO
		  AND s.soli_fecha <  ?lcHastaISO
		GROUP BY
		    s.soli_codi,
		    s.soli_fecha,
		    s.estado,
		    s.observaciones
		ORDER BY s.soli_codi DESC
		ENDTEXT
		
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_soli_hist_sql")
		
		IF lnRet < 0 OR !USED("cur_soli_hist_sql")
		    AERROR(laErr)
		
		    lcErrMsg = "No se pudo cargar el historial de solicitudes."
		
		    IF TYPE("laErr[1,3]") <> "U"
		        lcErrMsg = lcErrMsg + CHR(13) + TRANSFORM(laErr[1,3])
		    ENDIF
		
		    Desconectar_DB(lnConn)
		    MESSAGEBOX(lcErrMsg, 16, "Error SQL")
		    RETURN .F.
		ENDIF
		
		Desconectar_DB(lnConn)
		
		*---------------------------------------------------------
		* 6) Volcar SQL a cursor final cur_soli_hist
		*---------------------------------------------------------
		SELECT cur_soli_hist_sql
		GO TOP
		
		SCAN
		
		    ldFechaFox = {}
		    lcFechaTxt = ""
		    lcFechaISO = ""
		
		    IF TYPE("cur_soli_hist_sql.soli_fecha_iso") <> "U"
		        lcFechaISO = ALLTRIM(TRANSFORM(NVL(cur_soli_hist_sql.soli_fecha_iso, "")))
		    ENDIF
		
		    IF TYPE("cur_soli_hist_sql.soli_fecha_txt_sql") <> "U"
		        lcFechaTxt = ALLTRIM(TRANSFORM(NVL(cur_soli_hist_sql.soli_fecha_txt_sql, "")))
		    ENDIF
		
		    IF LEN(lcFechaISO) = 10
		        lnAnio = VAL(SUBSTR(lcFechaISO, 1, 4))
		        lnMes  = VAL(SUBSTR(lcFechaISO, 6, 2))
		        lnDia  = VAL(SUBSTR(lcFechaISO, 9, 2))
		
		        IF BETWEEN(lnAnio, 1900, 2500) AND ;
		           BETWEEN(lnMes, 1, 12) AND ;
		           BETWEEN(lnDia, 1, 31)
		
		            ldFechaFox = DATE(lnAnio, lnMes, lnDia)
		        ENDIF
		    ENDIF
		
		    IF EMPTY(lcFechaTxt) AND VARTYPE(ldFechaFox) = "D" AND !EMPTY(ldFechaFox)
		        lcFechaTxt = DTOC(ldFechaFox)
		    ENDIF
		
		    DO CASE
		    CASE VARTYPE(cur_soli_hist_sql.soli_codi) $ "NI"
		        lnSoliIns = cur_soli_hist_sql.soli_codi
		    OTHERWISE
		        lnSoliIns = VAL(TRANSFORM(cur_soli_hist_sql.soli_codi))
		    ENDCASE
		
		    lnSoliIns = INT(NVL(lnSoliIns, 0))
		
		    lcEstadoIns = ""
		    IF TYPE("cur_soli_hist_sql.estado") <> "U"
		        lcEstadoIns = LEFT(ALLTRIM(TRANSFORM(NVL(cur_soli_hist_sql.estado, ""))), 20)
		    ENDIF
		
		    lcObsIns = ""
		    IF TYPE("cur_soli_hist_sql.observaciones") <> "U"
		        lcObsIns = "" + NVL(cur_soli_hist_sql.observaciones, "")
		    ENDIF
		
		    DO CASE
		    CASE VARTYPE(cur_soli_hist_sql.cant_items) $ "NI"
		        lnItemsIns = cur_soli_hist_sql.cant_items
		    OTHERWISE
		        lnItemsIns = VAL(TRANSFORM(cur_soli_hist_sql.cant_items))
		    ENDCASE
		
		    lnItemsIns = INT(NVL(lnItemsIns, 0))
		
		    DO CASE
		    CASE VARTYPE(cur_soli_hist_sql.cant_total) $ "NYB"
		        lnTotalIns = cur_soli_hist_sql.cant_total
		    OTHERWISE
		        lnTotalIns = VAL(TRANSFORM(cur_soli_hist_sql.cant_total))
		    ENDCASE
		
		    lnTotalIns = NVL(lnTotalIns, 0)
		
		    INSERT INTO cur_soli_hist ;
		        (soli_codi, soli_fecha, soli_fecha_txt, estado, observaciones, cant_items, cant_total) ;
		    VALUES ;
		        (m.lnSoliIns, ;
		         m.ldFechaFox, ;
		         LEFT(m.lcFechaTxt, 10), ;
		         m.lcEstadoIns, ;
		         m.lcObsIns, ;
		         m.lnItemsIns, ;
		         m.lnTotalIns)
		
		ENDSCAN
		
		USE IN cur_soli_hist_sql
		
		*---------------------------------------------------------
		* 7) Refrescar Grid1 restaurando formato
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ConfigurarGridSolicitudes", 5)
		    THISFORMSET.ConfigurarGridSolicitudes()
		ELSE
		    IF PEMSTATUS(loConsulta, "grid1", 5)
		        loConsulta.grid1.RecordSource = "cur_soli_hist"
		        loConsulta.grid1.Refresh()
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 8) Cargar detalle de la primera solicitud filtrada
		*---------------------------------------------------------
		IF USED("cur_soli_hist") AND RECCOUNT("cur_soli_hist") > 0
		
		    SELECT cur_soli_hist
		    GO TOP
		
		    lnSoliCodi = NVL(cur_soli_hist.soli_codi, 0)
		
		    IF PEMSTATUS(loConsulta, "xSoliCodiActual", 5)
		        loConsulta.xSoliCodiActual = lnSoliCodi
		    ELSE
		        loConsulta.AddProperty("xSoliCodiActual", lnSoliCodi)
		    ENDIF
		
		    IF PEMSTATUS(loConsulta, "grid1", 5)
		        loConsulta.grid1.Refresh()
		    ENDIF
		
		    IF lnSoliCodi > 0 AND PEMSTATUS(THISFORMSET, "CargarDetalleSolicitud", 5)
		        THISFORMSET.CargarDetalleSolicitud(lnSoliCodi)
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "ActualizarLabelEstadoOC", 5)
		        THISFORMSET.ActualizarLabelEstadoOC(lnSoliCodi)
		    ENDIF
		
		ELSE
		
		    IF PEMSTATUS(loConsulta, "xSoliCodiActual", 5)
		        loConsulta.xSoliCodiActual = 0
		    ELSE
		        loConsulta.AddProperty("xSoliCodiActual", 0)
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "LimpiarDetalleSolicitud", 5)
		        THISFORMSET.LimpiarDetalleSolicitud()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "ActualizarLabelEstadoOC", 5)
		        THISFORMSET.ActualizarLabelEstadoOC(0)
		    ENDIF
		
		    IF PEMSTATUS(loConsulta, "grid2", 5)
		        loConsulta.grid2.Refresh()
		    ENDIF
		
		ENDIF
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE cargarobservacionsolicitud
		*=========================================================
		* FormSet.CargarObservacionSolicitud
		* Carga solicitud_compra.observaciones en secundario.edit1
		*=========================================================
		LPARAMETERS tnSoliCodi
		LOCAL lnConn, lnRet, lcSQL, lcObs, loSec
		
		lcObs = ""
		loSec = .NULL.
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN ""
		ENDIF
		
		loSec = THISFORMSET.secundario
		IF VARTYPE(loSec) <> "O"
		    RETURN ""
		ENDIF
		
		IF VARTYPE(tnSoliCodi) <> "N" OR tnSoliCodi <= 0
		    IF PEMSTATUS(loSec, "edit1", 5)
		        loSec.edit1.Value     = ""
		        loSec.edit1.ReadOnly  = .T.
		        loSec.edit1.Enabled   = .F.
		        loSec.edit1.BackColor = RGB(245,245,245)
		        loSec.edit1.Refresh()
		    ENDIF
		
			IF PEMSTATUS(loSec, "command3", 5)
			    loSec.command3.Caption = "EDITAR"
			    loSec.command3.Enabled = .F.
			    loSec.command3.Refresh()
			ENDIF
		
		
		    IF PEMSTATUS(loSec, "xObsEditando", 5)
		        loSec.xObsEditando = .F.
		    ENDIF
		
		    IF PEMSTATUS(loSec, "xObsOriginal", 5)
		        loSec.xObsOriginal = ""
		    ENDIF
		
		    IF PEMSTATUS(loSec, "xSoliCodiActual", 5)
		        loSec.xSoliCodiActual = 0
		    ENDIF
		
		    RETURN ""
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    RETURN ""
		ENDIF
		
		lcSQL = "SELECT IFNULL(observaciones,'') AS obs FROM solicitud_compra WHERE soli_codi = ?tnSoliCodi"
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_obs_tmp")
		Desconectar_DB(lnConn)
		
		IF lnRet > 0 AND USED("cur_obs_tmp") AND !EOF("cur_obs_tmp")
		    lcObs = NVL(cur_obs_tmp.obs, "")
		ENDIF
		
		IF USED("cur_obs_tmp")
		    USE IN cur_obs_tmp
		ENDIF
		
		IF PEMSTATUS(loSec, "edit1", 5)
		    loSec.edit1.Value     = lcObs
		    loSec.edit1.ReadOnly  = .T.
		    loSec.edit1.Enabled   = .F.
		    loSec.edit1.BackColor = RGB(245,245,245)
		    loSec.edit1.Refresh()
		ENDIF
		
		IF PEMSTATUS(loSec, "command3", 5)
		    loSec.command3.Caption = "EDITAR"
		    loSec.command3.Enabled = .T.
		    loSec.command3.Refresh()
		ENDIF
		
		IF PEMSTATUS(loSec, "xObsEditando", 5)
		    loSec.xObsEditando = .F.
		ENDIF
		
		IF PEMSTATUS(loSec, "xObsOriginal", 5)
		    loSec.xObsOriginal = lcObs
		ENDIF
		
		IF PEMSTATUS(loSec, "xSoliCodiActual", 5)
		    loSec.xSoliCodiActual = tnSoliCodi
		ENDIF
		
		RETURN lcObs
	ENDPROC

	PROCEDURE cargarproveedoresencuralerts
		*=========================================================
		* FormSet.CargarProveedoresEnCurAlerts
		* - Completa prov_lista
		* - Asigna proveedor/costo por fallback inteligente
		* Regla:
		*   1) cotiz = 1 y costo > 0
		*   2) cualquier proveedor con costo > 0
		*   3) primer proveedor disponible
		*   4) si no hay proveedor -> vacío
		*=========================================================
		LPARAMETERS tcAlias
		
		LOCAL lnConn, lnRet, lcSQL, lcAlias
		LOCAL lnArtCodi, lcProvLista
		LOCAL llFirstEntry
		LOCAL lnOldArea
		
		*-- Mejor candidato
		LOCAL lcBestNomb, lnBestCodi, lnBestCosto, lcBestMoneda
		LOCAL lnBestRank, lnRankActual
		
		*-- Primer proveedor disponible (fallback duro)
		LOCAL lcAnyNomb, lnAnyCodi, lnAnyCosto, lcAnyMoneda
		LOCAL llTieneAlguno
		
		IF VARTYPE(tcAlias) <> "C" OR EMPTY(ALLTRIM(tcAlias))
		    lcAlias = "cur_alerts"
		ELSE
		    lcAlias = ALLTRIM(tcAlias)
		ENDIF
		
		IF !USED(lcAlias) OR RECCOUNT(lcAlias) = 0
		    RETURN .F.
		ENDIF
		
		IF USED("cur_all_provs_tmp")
		    USE IN cur_all_provs_tmp
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    RETURN .F.
		ENDIF
		
		TEXT TO lcSQL NOSHOW
		SELECT
		    ap.art_codi,
		    IFNULL(p.prov_nomb,'')                       AS prov_nomb,
		    ap.prov_codi,
		    CAST(IFNULL(ap.artpro_costo, 0) AS CHAR(20)) AS artpro_costo,
		    IFNULL(ap.moneda,'P')                        AS moneda,
		    IFNULL(ap.lista,0)                           AS lista,
		    IFNULL(ap.cotiz,0)                           AS cotiz,
		    MAX(h.histo_fech)                            AS artpro_fecha
		FROM articulos_proveedores ap
		INNER JOIN proveedores p
		    ON p.prov_codi = ap.prov_codi
		LEFT JOIN histocosto h
		    ON h.artpro_codi = ap.artpro_codi
		GROUP BY
		    ap.art_codi,
		    ap.prov_codi,
		    p.prov_nomb,
		    ap.artpro_costo,
		    ap.moneda,
		    ap.lista,
		    ap.cotiz
		ORDER BY
		    ap.art_codi,
		    ap.artpro_costo,
		    ap.prov_codi,
		    p.prov_nomb
		ENDTEXT
		
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_all_provs_tmp")
		Desconectar_DB(lnConn)
		
		IF lnRet < 0 OR !USED("cur_all_provs_tmp")
		    RETURN .F.
		ENDIF
		
		SELECT cur_all_provs_tmp
		INDEX ON art_codi TAG art_codi
		
		lnOldArea = SELECT(0)
		
		SELECT (lcAlias)
		GO TOP
		SCAN
		    lnArtCodi    = EVALUATE(lcAlias + ".art_codi")
		    lcProvLista  = ""
		    llFirstEntry = .T.
		
		    lcBestNomb   = ""
		    lnBestCodi   = 0
		    lnBestCosto  = 0
		    lcBestMoneda = ""
		    lnBestRank   = 999
		
		    lcAnyNomb     = ""
		    lnAnyCodi     = 0
		    lnAnyCosto    = 0
		    lcAnyMoneda   = ""
		    llTieneAlguno = .F.
		
		    SELECT cur_all_provs_tmp
		    IF SEEK(lnArtCodi, "cur_all_provs_tmp", "art_codi")
		
		        DO WHILE !EOF("cur_all_provs_tmp") AND cur_all_provs_tmp.art_codi = lnArtCodi
		
		            IF !llFirstEntry
		                lcProvLista = lcProvLista + CHR(10)
		            ENDIF
		            llFirstEntry = .F.
		
		            lcProvLista = lcProvLista + ;
		                ALLTRIM(NVL(cur_all_provs_tmp.prov_nomb, ""))  + "^" + ;
		                TRANSFORM(NVL(cur_all_provs_tmp.prov_codi, 0)) + "^" + ;
		                ALLTRIM(NVL(cur_all_provs_tmp.artpro_costo, "0.0000")) + "^" + ;
		                ALLTRIM(NVL(cur_all_provs_tmp.moneda, ""))     + "^" + ;
		                TRANSFORM(IIF(VARTYPE(cur_all_provs_tmp.lista) = "N", cur_all_provs_tmp.lista, 0)) + "^" + ;
		                TRANSFORM(IIF(VARTYPE(cur_all_provs_tmp.cotiz) = "N", cur_all_provs_tmp.cotiz, 0)) + "^" + ;
		                IIF(VARTYPE(cur_all_provs_tmp.artpro_fecha) = "T" AND !EMPTY(cur_all_provs_tmp.artpro_fecha), ;
		                    TTOC(cur_all_provs_tmp.artpro_fecha), "")
		
		            IF !llTieneAlguno
		                lcAnyNomb     = ALLTRIM(NVL(cur_all_provs_tmp.prov_nomb, ""))
		                lnAnyCodi     = NVL(cur_all_provs_tmp.prov_codi, 0)
		                lnAnyCosto    = VAL(NVL(cur_all_provs_tmp.artpro_costo, "0"))
		                lcAnyMoneda   = ALLTRIM(NVL(cur_all_provs_tmp.moneda, ""))
		                llTieneAlguno = .T.
		            ENDIF
		
		            lnRankActual = 3
		
		            IF NVL(cur_all_provs_tmp.cotiz, 0) = 1 AND VAL(NVL(cur_all_provs_tmp.artpro_costo, "0")) > 0
		                lnRankActual = 1
		            ELSE
		                IF VAL(NVL(cur_all_provs_tmp.artpro_costo, "0")) > 0
		                    lnRankActual = 2
		                ENDIF
		            ENDIF
		
		            IF lnRankActual < lnBestRank
		                lnBestRank   = lnRankActual
		                lcBestNomb   = ALLTRIM(NVL(cur_all_provs_tmp.prov_nomb, ""))
		                lnBestCodi   = NVL(cur_all_provs_tmp.prov_codi, 0)
		                lnBestCosto  = VAL(NVL(cur_all_provs_tmp.artpro_costo, "0"))
		                lcBestMoneda = ALLTRIM(NVL(cur_all_provs_tmp.moneda, ""))
		            ELSE
		                IF lnRankActual = lnBestRank
		                    DO CASE
		                    CASE lnBestRank <= 2 AND VAL(NVL(cur_all_provs_tmp.artpro_costo, "0")) < lnBestCosto
		                        lcBestNomb   = ALLTRIM(NVL(cur_all_provs_tmp.prov_nomb, ""))
		                        lnBestCodi   = NVL(cur_all_provs_tmp.prov_codi, 0)
		                        lnBestCosto  = VAL(NVL(cur_all_provs_tmp.artpro_costo, "0"))
		                        lcBestMoneda = ALLTRIM(NVL(cur_all_provs_tmp.moneda, ""))
		                    CASE VAL(NVL(cur_all_provs_tmp.artpro_costo, "0")) = lnBestCosto AND ;
		                         NVL(cur_all_provs_tmp.prov_codi, 0) < lnBestCodi
		                        lcBestNomb   = ALLTRIM(NVL(cur_all_provs_tmp.prov_nomb, ""))
		                        lnBestCodi   = NVL(cur_all_provs_tmp.prov_codi, 0)
		                        lnBestCosto  = VAL(NVL(cur_all_provs_tmp.artpro_costo, "0"))
		                        lcBestMoneda = ALLTRIM(NVL(cur_all_provs_tmp.moneda, ""))
		                    ENDCASE
		                ENDIF
		            ENDIF
		
		            SKIP IN cur_all_provs_tmp
		        ENDDO
		    ENDIF
		
		    SELECT (lcAlias)
		    REPLACE prov_lista WITH lcProvLista
		
		    IF !EMPTY(lcBestNomb)
		        REPLACE ;
		            prov_nomb_sel WITH lcBestNomb,   ;
		            prov_codi_sel WITH lnBestCodi,   ;
		            artpro_costo  WITH lnBestCosto,  ;
		            artpro_moneda WITH lcBestMoneda
		    ELSE
		        IF llTieneAlguno
		            REPLACE ;
		                prov_nomb_sel WITH lcAnyNomb,   ;
		                prov_codi_sel WITH lnAnyCodi,   ;
		                artpro_costo  WITH lnAnyCosto,  ;
		                artpro_moneda WITH lcAnyMoneda
		        ELSE
		            REPLACE ;
		                prov_nomb_sel WITH "",  ;
		                prov_codi_sel WITH 0,   ;
		                artpro_costo  WITH 0,   ;
		                artpro_moneda WITH ""
		        ENDIF
		    ENDIF
		ENDSCAN
		
		IF lnOldArea > 0
		    SELECT (lnOldArea)
		ENDIF
		
		IF USED("cur_all_provs_tmp")
		    USE IN cur_all_provs_tmp
		ENDIF
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE cargarsolicitudeshistoricas
		*=========================================================
		* FormSet.CargarSolicitudesHistoricas
		* - Recupera una solicitud histórica para modificar
		* - Agrega sus artículos a cur_alerts
		* - Marca ui_sel = .T.
		* - Normaliza tipos para evitar Data type mismatch
		*=========================================================
		LPARAMETERS tnSoliCodi
		
		LOCAL loFrm, loConsulta
		LOCAL lnConn, lnRet, lcSQL, lcSafety
		LOCAL lnItem
		LOCAL lnArtCodi_, lcArtDesc_, lnArtStock_, lnArtStmin_
		LOCAL lnArtPctAlerta_, lnPedidos_, lnPedprov_, lnPosicion_
		LOCAL lnPctRotacion_, lcVentasMetrics_, lnPromedioVenta_
		LOCAL ldFechaUltVenta_, lcComprasMetrics_, lnPromedioCompra_
		LOCAL ldFechaUltCompra_, lnDiasDemora_, lnPosMinSug_
		LOCAL lnSugeridoComprar_, lnMesesCubiertos_, lnMesesCobProy_
		LOCAL lnMesesCobertSolic_, lnScore_, lnRubCodi_, lcRubDesc_
		LOCAL lnProvCodiSel_, lcProvNombSel_, lnArtproCosto_
		LOCAL lcArtproMoneda_, lcObservacion_
		LOCAL lxVal
		
		loFrm      = THISFORMSET.principal
		loConsulta = .NULL.
		lnConn     = 0
		lnRet      = 0
		lcSQL      = ""
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF VARTYPE(tnSoliCodi) <> "N" OR tnSoliCodi <= 0
		    MESSAGEBOX("Solicitud inválida.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Traer detalle histórico
		* IMPORTANTE:
		* Se agrega d.observacion para conservar obs por artículo.
		*---------------------------------------------------------
		TEXT TO lcSQL NOSHOW PRETEXT 15
		    SELECT
		        d.art_codi,
		        IFNULL(a.art_desc,'') AS art_desc,
		        IFNULL(a.art_stock,0) AS art_stock,
		        IFNULL(a.art_stmin,0) AS art_stmin,
		        IFNULL(m.art_pct_alerta,30.00) AS art_pct_alerta,
		        IFNULL(a.pedidos,0) AS pedidos,
		        IFNULL(a.pedprov,0) AS pedprov,
		        (IFNULL(a.art_stock,0) + IFNULL(a.pedprov,0) - IFNULL(a.pedidos,0)) AS posicion,
		        IFNULL(m.pct_rotacion,0) AS pct_rotacion,
		        IFNULL(m.ventas_metrics,'') AS ventas_metrics,
		        IFNULL(m.promedio_venta,0) AS promedio_venta,
		        m.fecha_ult_venta,
		        IFNULL(m.compras_metrics,'') AS compras_metrics,
		        IFNULL(m.promedio_compra,0) AS promedio_compra,
		        m.fecha_ult_compra,
		        IFNULL(m.dias_demora_ent,15) AS dias_demora_ent,
		        IFNULL(m.pos_min_sug,0) AS pos_min_sug,
		        IFNULL(m.sugerido_comprar,0) AS sugerido_comprar,
		        IFNULL(m.meses_cubiertos,0) AS meses_cubiertos,
		        IFNULL(m.meses_cobert_solic,3) AS meses_cobert_solic,
		        0 AS meses_cob_proy,
		        0 AS score,
		        IFNULL(a.rub_codi,0) AS rub_codi,
		        COALESCE(r.rub_desc,'') AS rub_desc,
		        IFNULL(d.cant_soli,0) AS cant_soli,
		        IFNULL(d.prov_codi,0) AS prov_codi_sel,
		        COALESCE(p.prov_nomb,'') AS prov_nomb_sel,
		        IFNULL(d.artpro_costo,0) AS artpro_costo,
		        COALESCE(ap.moneda,'P') AS artpro_moneda,
		        IFNULL(d.observacion,'') AS observacion
		    FROM solicitud_compra_art d
		    INNER JOIN articulos a
		        ON a.art_codi = d.art_codi
		    LEFT JOIN proveedores p
		        ON p.prov_codi = d.prov_codi
		    LEFT JOIN art_metricas m
		        ON m.art_codi = a.art_codi
		    LEFT JOIN rubros r
		        ON r.rub_codi = a.rub_codi
		    LEFT JOIN articulos_proveedores ap
		        ON ap.art_codi = d.art_codi
		       AND ap.prov_codi = d.prov_codi
		    WHERE d.soli_codi = ?tnSoliCodi
		    ORDER BY p.prov_nomb ASC, a.art_desc ASC
		ENDTEXT
		
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_soli_edit_tmp")
		
		IF VARTYPE(lnConn) = "N" AND lnConn > 0
		    Desconectar_DB(lnConn)
		    lnConn = 0
		ENDIF
		
		IF lnRet < 0 OR !USED("cur_soli_edit_tmp")
		    MESSAGEBOX("No se pudo cargar la solicitud histórica.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Asegurar que cur_alerts exista
		*---------------------------------------------------------
		IF !USED("cur_alerts")
		    MESSAGEBOX("cur_alerts no está abierto.", 16, "Error")
		
		    IF USED("cur_soli_edit_tmp")
		        USE IN cur_soli_edit_tmp
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Limpiar cur_alerts_ped si existe
		*---------------------------------------------------------
		lcSafety = SET("SAFETY")
		SET SAFETY OFF
		
		IF USED("cur_alerts_ped")
		    SELECT cur_alerts_ped
		    ZAP
		ENDIF
		
		IF UPPER(ALLTRIM(lcSafety)) == "ON"
		    SET SAFETY ON
		ELSE
		    SET SAFETY OFF
		ENDIF
		
		*---------------------------------------------------------
		* Insertar artículos históricos que no existan en cur_alerts
		*---------------------------------------------------------
		SELECT cur_soli_edit_tmp
		GO TOP
		
		lnItem = RECCOUNT("cur_alerts")
		
		SCAN
		
		    *-----------------------------------------------------
		    * Normalizar numéricos
		    *-----------------------------------------------------
		    lnArtCodi_ = 0
		    lxVal = cur_soli_edit_tmp.art_codi
		
		    DO CASE
		    CASE ISNULL(lxVal)
		        lnArtCodi_ = 0
		    CASE VARTYPE(lxVal) = "N" OR VARTYPE(lxVal) = "I"
		        lnArtCodi_ = INT(lxVal)
		    OTHERWISE
		        lnArtCodi_ = INT(VAL(TRANSFORM(lxVal)))
		    ENDCASE
		
		    lcArtDesc_ = ALLTRIM(TRANSFORM(NVL(cur_soli_edit_tmp.art_desc, "")))
		
		    lnArtStock_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.art_stock, 0)))
		    lnArtStmin_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.art_stmin, 0)))
		    lnArtPctAlerta_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.art_pct_alerta, 0)))
		    lnPedidos_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.pedidos, 0)))
		    lnPedprov_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.pedprov, 0)))
		    lnPosicion_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.posicion, 0)))
		    lnPctRotacion_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.pct_rotacion, 0)))
		    lnPromedioVenta_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.promedio_venta, 0)))
		    lnPromedioCompra_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.promedio_compra, 0)))
		    lnDiasDemora_ = INT(VAL(TRANSFORM(NVL(cur_soli_edit_tmp.dias_demora_ent, 0))))
		    lnPosMinSug_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.pos_min_sug, 0)))
		    lnSugeridoComprar_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.sugerido_comprar, 0)))
		    lnMesesCubiertos_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.meses_cubiertos, 0)))
		    lnMesesCobProy_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.meses_cob_proy, 0)))
		    lnMesesCobertSolic_ = VAL(TRANSFORM(NVL(cur_soli_edit_tmp.meses_cobert_solic, 0)))
		    lnScore_ = INT(VAL(TRANSFORM(NVL(cur_soli_edit_tmp.score, 0))))
		    lnRubCodi_ = INT(VAL(TRANSFORM(NVL(cur_soli_edit_tmp.rub_codi, 0))))
		    lnProvCodiSel_ = INT(VAL(TRANSFORM(NVL(cur_soli_edit_tmp.prov_codi_sel, 0))))
			lnArtproCosto_ = NVL(cur_soli_edit_tmp.artpro_costo, 0)
		
		    *-----------------------------------------------------
		    * Normalizar textos / memo
		    *-----------------------------------------------------
		    lcRubDesc_ = ALLTRIM(TRANSFORM(NVL(cur_soli_edit_tmp.rub_desc, "")))
		    lcProvNombSel_ = ALLTRIM(TRANSFORM(NVL(cur_soli_edit_tmp.prov_nomb_sel, "")))
		    lcArtproMoneda_ = LEFT(ALLTRIM(TRANSFORM(NVL(cur_soli_edit_tmp.artpro_moneda, "P"))), 1)
		    lcVentasMetrics_ = TRANSFORM(NVL(cur_soli_edit_tmp.ventas_metrics, ""))
		    lcComprasMetrics_ = TRANSFORM(NVL(cur_soli_edit_tmp.compras_metrics, ""))
		    lcObservacion_ = TRANSFORM(NVL(cur_soli_edit_tmp.observacion, ""))
		
		    *-----------------------------------------------------
		    * Normalizar fecha_ult_venta a tipo Date
		    * cur_alerts.fecha_ult_venta es D.
		    * MySQL/ODBC puede traer T.
		    *-----------------------------------------------------
		    ldFechaUltVenta_ = {}
		
		    IF TYPE("cur_soli_edit_tmp.fecha_ult_venta") <> "U"
		        lxVal = cur_soli_edit_tmp.fecha_ult_venta
		
		        DO CASE
		        CASE ISNULL(lxVal)
		            ldFechaUltVenta_ = {}
		
		        CASE VARTYPE(lxVal) = "D"
		            ldFechaUltVenta_ = lxVal
		
		        CASE VARTYPE(lxVal) = "T"
		            ldFechaUltVenta_ = TTOD(lxVal)
		
		        CASE VARTYPE(lxVal) = "C" AND !EMPTY(ALLTRIM(lxVal))
		            ldFechaUltVenta_ = CTOD(ALLTRIM(lxVal))
		
		        OTHERWISE
		            ldFechaUltVenta_ = {}
		        ENDCASE
		    ENDIF
		
		    *-----------------------------------------------------
		    * Normalizar fecha_ult_compra a tipo Date
		    * cur_alerts.fecha_ult_compra es D.
		    *-----------------------------------------------------
		    ldFechaUltCompra_ = {}
		
		    IF TYPE("cur_soli_edit_tmp.fecha_ult_compra") <> "U"
		        lxVal = cur_soli_edit_tmp.fecha_ult_compra
		
		        DO CASE
		        CASE ISNULL(lxVal)
		            ldFechaUltCompra_ = {}
		
		        CASE VARTYPE(lxVal) = "D"
		            ldFechaUltCompra_ = lxVal
		
		        CASE VARTYPE(lxVal) = "T"
		            ldFechaUltCompra_ = TTOD(lxVal)
		
		        CASE VARTYPE(lxVal) = "C" AND !EMPTY(ALLTRIM(lxVal))
		            ldFechaUltCompra_ = CTOD(ALLTRIM(lxVal))
		
		        OTHERWISE
		            ldFechaUltCompra_ = {}
		        ENDCASE
		    ENDIF
		
		    IF lnArtCodi_ <= 0
		        SELECT cur_soli_edit_tmp
		        LOOP
		    ENDIF
		
		    *-----------------------------------------------------
		    * Verificar si ya existe en cur_alerts
		    *-----------------------------------------------------
		    SELECT cur_alerts
		    LOCATE FOR art_codi = lnArtCodi_
		
		    IF FOUND()
		
		        *-- Ya existe: marcar y actualizar datos de edición
		        REPLACE ;
		            ui_sel         WITH .T., ;
		            cant_soli      WITH lnSugeridoComprar_, ;
		            prov_codi_sel  WITH lnProvCodiSel_, ;
		            prov_nomb_sel  WITH lcProvNombSel_, ;
		            artpro_costo   WITH lnArtproCosto_, ;
		            artpro_moneda  WITH lcArtproMoneda_ ;
		        IN cur_alerts
		
		        IF TYPE("cur_alerts.observacion") $ "CM"
		            REPLACE observacion WITH lcObservacion_ IN cur_alerts
		        ENDIF
		
		    ELSE
		
		        *-------------------------------------------------
		        * No existe: insertar normalizado
		        *-------------------------------------------------
		        lnItem = lnItem + 1
		
		        INSERT INTO cur_alerts ;
		            ( art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		              pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		              ventas_metrics, promedio_venta, fecha_ult_venta, ;
		              compras_metrics, promedio_compra, fecha_ult_compra, ;
		              dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		              meses_cubiertos, meses_cob_proy, meses_cobert_solic, ;
		              score, rub_codi, rub_desc, ;
		              prov_codi_sel, prov_nomb_sel, artpro_costo, artpro_moneda, ;
		              prov_lista, observacion, ui_item, ui_sel ) ;
		        VALUES ;
		            ( lnArtCodi_, lcArtDesc_, lnArtStock_, lnArtStmin_, lnArtPctAlerta_, ;
		              lnPedidos_, lnPedprov_, lnPosicion_, lnSugeridoComprar_, lnPctRotacion_, ;
		              lcVentasMetrics_, lnPromedioVenta_, ldFechaUltVenta_, ;
		              lcComprasMetrics_, lnPromedioCompra_, ldFechaUltCompra_, ;
		              lnDiasDemora_, lnPosMinSug_, lnSugeridoComprar_, ;
		              lnMesesCubiertos_, lnMesesCobProy_, lnMesesCobertSolic_, ;
		              lnScore_, lnRubCodi_, lcRubDesc_, ;
		              lnProvCodiSel_, lcProvNombSel_, lnArtproCosto_, lcArtproMoneda_, ;
		              "", lcObservacion_, ALLTRIM(STR(lnItem)), .T. )
		
		    ENDIF
		
		    SELECT cur_soli_edit_tmp
		
		ENDSCAN
		
		IF USED("cur_soli_edit_tmp")
		    USE IN cur_soli_edit_tmp
		ENDIF
		
		*---------------------------------------------------------
		* Renumerar ui_item
		*---------------------------------------------------------
		SELECT cur_alerts
		
		lnItem = 0
		GO TOP
		
		SCAN
		    lnItem = lnItem + 1
		    REPLACE ui_item WITH ALLTRIM(STR(lnItem)) IN cur_alerts
		ENDSCAN
		
		*---------------------------------------------------------
		* Refrescos
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "RecalcularColoresGrid", 5)
		    THISFORMSET.RecalcularColoresGrid()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "SincronizarPedido", 5)
		    THISFORMSET.SincronizarPedido()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		    THISFORMSET.RefrescarGrid()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "RefreshVentaCompraGrid", 5)
		    THISFORMSET.RefreshVentaCompraGrid()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		    THISFORMSET.SincronizarBotonMasivo()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargarterciariomovimientosarticulo
		*=========================================================
		* FormSet.CargarTerciarioMovimientosArticulo
		*=========================================================
		LOCAL lnArtCodi, lcPeriodo
		LOCAL ldDesde, ldHasta
		LOCAL lnConn
		LOCAL lcSQLCompras, lcSQLVentas
		LOCAL laErr[1]
		LOCAL lcDesdeSQL, lcHastaSQL
		LOCAL lnMes, lnAnio
		LOCAL lcSafety
		LOCAL lnItem
		
		lnArtCodi = INT(VAL(TRANSFORM(NVL(THISFORMSET.xTerArtCodi, 0))))
		lcPeriodo = ALLTRIM(NVL(THISFORMSET.xTerPeriodo, ""))
		
		IF lnArtCodi <= 0
		    MESSAGEBOX("No hay artículo definido para el formulario terciario.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		ldDesde = {}
		ldHasta = {}
		lnMes   = 0
		lnAnio  = 0
		
		DO CASE
		CASE LEN(lcPeriodo) = 7 AND SUBSTR(lcPeriodo, 5, 1) = "-"
		    lnAnio = VAL(LEFT(lcPeriodo, 4))
		    lnMes  = VAL(RIGHT(lcPeriodo, 2))
		CASE LEN(lcPeriodo) = 7 AND SUBSTR(lcPeriodo, 3, 1) = "/"
		    lnMes  = VAL(LEFT(lcPeriodo, 2))
		    lnAnio = VAL(RIGHT(lcPeriodo, 4))
		OTHERWISE
		    MESSAGEBOX("Formato de período no reconocido: [" + lcPeriodo + "]", 16, "Error")
		    RETURN .F.
		ENDCASE
		
		IF lnAnio <= 0 OR !BETWEEN(lnMes, 1, 12)
		    MESSAGEBOX("Período inválido: [" + lcPeriodo + "]", 16, "Error")
		    RETURN .F.
		ENDIF
		
		ldDesde = DATE(lnAnio, lnMes, 1)
		ldHasta = GOMONTH(ldDesde, 1) - 1
		
		lcDesdeSQL = DTOC(ldDesde, 1)
		lcHastaSQL = DTOC(ldHasta, 1)
		
		lnConn = 0
		IF TYPE("_screen.cn") <> "U"
		    lnConn = Conectar_DB(_screen.cn)
		ENDIF
		
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No hay conexión MySQL disponible.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Asegurar alias persistentes y vaciarlos, no recrearlos
		*---------------------------------------------------------
		IF USED("cur_ter_compras")
		    IF TYPE("cur_ter_compras.prov_codi") = "U" OR ;
		       TYPE("cur_ter_compras.cond_codi") = "U" OR ;
		       TYPE("cur_ter_compras.recep_codi") = "U" OR ;
		       TYPE("cur_ter_compras.orden_codi") = "U"
		        USE IN cur_ter_compras
		    ENDIF
		ENDIF
		
		IF !USED("cur_ter_compras")
		    CREATE CURSOR cur_ter_compras ( ;
		        nro_item    I, ;
		        fecha       D, ;
		        comprobante C(30), ;
		        cantidad    N(15,3), ;
		        prov_nomb   C(50), ;
		        prov_codi   I, ;
		        cond_codi   I, ;
		        recep_codi  I, ;
		        orden_codi  I )
		ELSE
		    lcSafety = SET("SAFETY")
		    SET SAFETY OFF
		    SELECT cur_ter_compras
		    ZAP
		    SET SAFETY &lcSafety
		ENDIF
		
		*----------------------------------------------*
		
		IF USED("cur_ter_ventas")
		    IF TYPE("cur_ter_ventas.rem_pto") = "U" OR ;
		       TYPE("cur_ter_ventas.rem_nro") = "U" OR ;
		       TYPE("cur_ter_ventas.rem_codi") = "U" OR ;
		       TYPE("cur_ter_ventas.cond_codi") = "U"
		        USE IN cur_ter_ventas
		    ENDIF
		ENDIF
		
		IF !USED("cur_ter_ventas")
		    CREATE CURSOR cur_ter_ventas ( ;
		        nro_item    I, ;
		        fecha       D, ;
		        comprobante C(30), ;
		        cantidad    N(15,3), ;
		        cli_nomb    C(50), ;
		        rem_pto     I, ;
		        rem_nro     I, ;
		        rem_codi    I, ;
		        cond_codi   I )
		ELSE
		    lcSafety = SET("SAFETY")
		    SET SAFETY OFF
		    SELECT cur_ter_ventas
		    ZAP
		    SET SAFETY &lcSafety
		ENDIF
		
		*---------------------------------------------------------
		* SQL COMPRAS
		* - Compras = ingresos reales
		* - Fuentes: recepciones + fabricados
		*---------------------------------------------------------
		TEXT TO lcSQLCompras NOSHOW
		SELECT
		    x.fecha,
		    x.comprobante,
		    x.cantidad,
		    x.prov_nomb,
		    x.prov_codi,
		    x.cond_codi,
		    x.recep_codi,
		    x.orden_codi
		FROM (
		    SELECT
		        r.recep_fec AS fecha,
		        CONCAT('R-', LPAD(r.recep_codi, 8, '0')) AS comprobante,
		        IFNULL(ra.artrecep_cant, 0) AS cantidad,
		        IFNULL(p.prov_nomb, '') AS prov_nomb,
		        IFNULL(p.prov_codi, 0) AS prov_codi,
		        IFNULL(p.cond_codi, 0) AS cond_codi,
		        IFNULL(r.recep_codi, 0) AS recep_codi,
		        IFNULL(ra.orden_codi, 0) AS orden_codi
		    FROM recepciones r
		    INNER JOIN recepciones_articulos ra
		        ON ra.recep_codi = r.recep_codi
		    LEFT JOIN proveedores p
		        ON p.prov_codi = r.prov_codi
		    WHERE ra.art_codi = ?lnArtCodi
		      AND r.recep_fec BETWEEN ?lcDesdeSQL AND ?lcHastaSQL
		      AND IFNULL(r.anulado, 'N') <> 'S'
		
		    UNION ALL
		
		    SELECT
		        f.fab_fech AS fecha,
		        CONCAT('F-', LPAD(f.fab_codi, 8, '0')) AS comprobante,
		        IFNULL(fca.fabart_cant, 0) AS cantidad,
		        'FABRICACION' AS prov_nomb,
		        0 AS prov_codi,
		        0 AS cond_codi,
		        0 AS recep_codi,
		        IFNULL(ca.orden_codi, 0) AS orden_codi
		    FROM fabricados f
		    INNER JOIN fabricados_compras_articulos fca
		        ON fca.fab_codi = f.fab_codi
		    INNER JOIN compras_articulos ca
		        ON ca.artord_codi = fca.artord_codi
		    INNER JOIN compras co
		        ON co.orden_codi = ca.orden_codi
		    WHERE ca.art_codi = ?lnArtCodi
		      AND f.fab_fech BETWEEN ?lcDesdeSQL AND ?lcHastaSQL
		      AND IFNULL(co.anulado, 'N') <> 'S'
		) x
		ORDER BY x.fecha ASC, x.comprobante ASC
		ENDTEXT
		
		*---------------------------------------------------------
		* SQL VENTAS
		*---------------------------------------------------------
		TEXT TO lcSQLVentas NOSHOW
		SELECT
		    r.rem_codi AS rem_codi,
		    r.rem_fech AS fecha,
		    IFNULL(r.rem_pto, 0) AS rem_pto,
		    IFNULL(r.rem_nro, 0) AS rem_nro,
		    IFNULL(c.cond_codi, 0) AS cond_codi,
		    CONCAT(
		        LPAD(IFNULL(r.rem_pto, 0), 4, '0'),
		        ' - ',
		        LPAD(IFNULL(r.rem_nro, 0), 8, '0')
		    ) AS comprobante,
		    IFNULL(ra.artrem_cant, 0) AS cantidad,
		    IFNULL(c.cli_nomb, '') AS cli_nomb
		FROM remitos r
		INNER JOIN remitos_articulos ra ON r.rem_codi = ra.rem_codi
		LEFT JOIN clientes c ON c.cli_codi = r.cli_codi
		WHERE ra.art_codi = ?lnArtCodi
		  AND r.rem_fech >= ?lcDesdeSQL
		  AND r.rem_fech <= ?lcHastaSQL
		  AND IFNULL(r.anulado, 'N') <> 'S'
		ORDER BY r.rem_fech ASC, r.rem_codi ASC
		ENDTEXT
		
		*---------------------------------------------------------
		* Ejecutar compras
		*---------------------------------------------------------
		IF USED("q_ter_compras")
		    USE IN q_ter_compras
		ENDIF
		
		IF SQLEXEC(lnConn, lcSQLCompras, "q_ter_compras") < 0
		    AERROR(laErr)
		    Desconectar_DB(lnConn)
		    MESSAGEBOX("Error al consultar recepciones." + CHR(13) + laErr[2], 16, "MySQL")
		    RETURN .F.
		ENDIF
		
		IF USED("q_ter_compras") AND RECCOUNT("q_ter_compras") > 0
		    lnItem = 0
		    SELECT q_ter_compras
		    SCAN
		        lnItem = lnItem + 1
		        SELECT cur_ter_compras
		        APPEND BLANK
		        REPLACE ;
		            nro_item    WITH lnItem, ;
		            fecha       WITH q_ter_compras.fecha, ;
		            comprobante WITH ALLTRIM(TRANSFORM(q_ter_compras.comprobante)), ;
		            cantidad    WITH q_ter_compras.cantidad, ;
		            prov_nomb   WITH ALLTRIM(q_ter_compras.prov_nomb), ;
		            prov_codi   WITH VAL(TRANSFORM(NVL(q_ter_compras.prov_codi, 0))), ;
		            cond_codi   WITH VAL(TRANSFORM(NVL(q_ter_compras.cond_codi, 0))), ;
		            recep_codi  WITH VAL(TRANSFORM(NVL(q_ter_compras.recep_codi, 0))), ;
		            orden_codi  WITH VAL(TRANSFORM(NVL(q_ter_compras.orden_codi, 0)))
		        SELECT q_ter_compras
		    ENDSCAN
		ENDIF
		
		IF USED("q_ter_compras")
		    USE IN q_ter_compras
		ENDIF
		
		*---------------------------------------------------------
		* Ejecutar ventas
		*---------------------------------------------------------
		IF USED("q_ter_ventas")
		    USE IN q_ter_ventas
		ENDIF
		
		IF SQLEXEC(lnConn, lcSQLVentas, "q_ter_ventas") < 0
		    AERROR(laErr)
		    Desconectar_DB(lnConn)
		    MESSAGEBOX("Error al consultar remitos." + CHR(13) + laErr[2], 16, "MySQL")
		    RETURN .F.
		ENDIF
		
		IF USED("q_ter_ventas") AND RECCOUNT("q_ter_ventas") > 0
		    lnItem = 0
		    SELECT q_ter_ventas
		    SCAN
		        lnItem = lnItem + 1
		        SELECT cur_ter_ventas
		        APPEND BLANK
		        REPLACE ;
		            nro_item    WITH lnItem, ;
		            fecha       WITH q_ter_ventas.fecha, ;
		            comprobante WITH ALLTRIM(q_ter_ventas.comprobante), ;
		            cantidad    WITH q_ter_ventas.cantidad, ;
		            cli_nomb    WITH ALLTRIM(q_ter_ventas.cli_nomb), ;
		            rem_pto     WITH VAL(TRANSFORM(NVL(q_ter_ventas.rem_pto, 0))), ;
		            rem_nro     WITH VAL(TRANSFORM(NVL(q_ter_ventas.rem_nro, 0))), ;
		            rem_codi    WITH VAL(TRANSFORM(NVL(q_ter_ventas.rem_codi, 0)))
		        SELECT q_ter_ventas
		    ENDSCAN
		ENDIF
		
		IF USED("q_ter_ventas")
		    USE IN q_ter_ventas
		ENDIF
		
		Desconectar_DB(lnConn)
		
		IF USED("cur_ter_compras") AND RECCOUNT("cur_ter_compras") > 0
		    SELECT cur_ter_compras
		    GO TOP
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarOrdenCodiTerciario", 5)
		    THISFORMSET.ActualizarOrdenCodiTerciario()
		ENDIF
		
		IF USED("cur_ter_ventas") AND RECCOUNT("cur_ter_ventas") > 0
		    SELECT cur_ter_ventas
		    GO TOP
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "terciario", 5)
		    IF PEMSTATUS(THISFORMSET.terciario, "grd_ter_compras", 5)
		        THISFORMSET.terciario.grd_ter_compras.Refresh()
		    ENDIF
		    IF PEMSTATUS(THISFORMSET.terciario, "grd_ter_ventas", 5)
		        THISFORMSET.terciario.grd_ter_ventas.Refresh()
		    ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargartransportescombo
		*=========================================================
		* FormSet.CargarTransportesCombo
		* Carga cur_transportes para usar en grid2 / combo transporte
		*=========================================================
		LOCAL lnConn, lnRet, lcSQL
		LOCAL lnTranCodi, lcTranNomb
		LOCAL lcErrMsg
		LOCAL ARRAY laErr[1]
		
		IF USED("cur_transportes")
		    USE IN cur_transportes
		ENDIF
		
		CREATE CURSOR cur_transportes ( ;
		    tran_nomb C(80), ;
		    tran_codi I )
		
		*-- Primera opción vacía
		INSERT INTO cur_transportes (tran_nomb, tran_codi) ;
		VALUES ("", 0)
		
		lnConn = Conectar_DB(_screen.cn)
		
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    RETURN .F.
		ENDIF
		
		TEXT TO lcSQL NOSHOW PRETEXT 15
		SELECT
		    tran_codi,
		    IFNULL(tran_nomb, '') AS tran_nomb
		FROM transportes
		ORDER BY tran_nomb
		ENDTEXT
		
		IF USED("_tmp_transportes")
		    USE IN _tmp_transportes
		ENDIF
		
		lnRet = SQLEXEC(lnConn, lcSQL, "_tmp_transportes")
		Desconectar_DB(lnConn)
		
		IF lnRet < 0 OR !USED("_tmp_transportes")
		    lcErrMsg = "No se pudieron cargar los transportes."
		
		    IF AERROR(laErr) > 0
		        IF TYPE("laErr[1,3]") <> "U"
		            lcErrMsg = lcErrMsg + CHR(13) + TRANSFORM(laErr[1,3])
		        ENDIF
		    ENDIF
		
		    MESSAGEBOX(lcErrMsg, 16, "Error SQL")
		    RETURN .F.
		ENDIF
		
		SELECT _tmp_transportes
		GO TOP
		
		SCAN
		    lnTranCodi = 0
		    lcTranNomb = ""
		
		    IF VARTYPE(_tmp_transportes.tran_codi) = "N"
		        lnTranCodi = INT(_tmp_transportes.tran_codi)
		    ELSE
		        lnTranCodi = VAL(TRANSFORM(_tmp_transportes.tran_codi))
		    ENDIF
		
		    IF VARTYPE(_tmp_transportes.tran_nomb) = "C"
		        lcTranNomb = ALLTRIM(_tmp_transportes.tran_nomb)
		    ELSE
		        lcTranNomb = ALLTRIM(TRANSFORM(_tmp_transportes.tran_nomb))
		    ENDIF
		
		    IF lnTranCodi > 0
		        INSERT INTO cur_transportes (tran_nomb, tran_codi) ;
		        VALUES (m.lcTranNomb, m.lnTranCodi)
		    ENDIF
		
		    SELECT _tmp_transportes
		ENDSCAN
		
		USE IN _tmp_transportes
		
		RETURN .T.
	ENDPROC

	PROCEDURE cerrarcursorestemporales
		*=========================================================
		* FormSet.CerrarCursoresTemporales
		* Cierra todos los cursores temporales del formulario
		*=========================================================
		LOCAL ARRAY laCurs[1]
		LOCAL lnI, lcAlias
		LOCAL loFrm, loSec
		
		loFrm = .NULL.
		loSec = .NULL.
		
		*---------------------------------------------------------
		* 1) Desvincular controles antes de cerrar cursores
		*---------------------------------------------------------
		TRY
		    IF PEMSTATUS(THISFORMSET, "principal", 5)
		        loFrm = THISFORMSET.principal
		    ENDIF
		
		    IF VARTYPE(loFrm) = "O"
		
		        IF PEMSTATUS(loFrm, "grd_alerts", 5)
		            loFrm.grd_alerts.RecordSource = ""
		        ENDIF
		
		        IF PEMSTATUS(loFrm, "grid1", 5)
		            loFrm.grid1.RecordSource = ""
		        ENDIF
		
		        IF PEMSTATUS(loFrm, "grid2", 5)
		            loFrm.grid2.RecordSource = ""
		        ENDIF
		
		        IF PEMSTATUS(loFrm, "combo1", 5)
		            loFrm.combo1.RowSource = ""
		        ENDIF
		
		*------------------------------------------------*
				IF PEMSTATUS(loFrm, "combo2", 5)
				    WITH loFrm.combo2
				        .Visible       = .F.
				        .RowSourceType = 0
				        .RowSource     = ""
				        .ListIndex     = 0
				        .Value         = 0
				    ENDWITH
				ENDIF
		*-----------------------------------------------*
		
		        loFrm.Refresh()
		    ENDIF
		CATCH
		ENDTRY
		
		TRY
		    IF PEMSTATUS(THISFORMSET, "secundario", 5)
		        loSec = THISFORMSET.secundario
		    ENDIF
		
		    IF VARTYPE(loSec) = "O"
		
		        IF PEMSTATUS(loSec, "grid1", 5)
		            loSec.grid1.RecordSource = ""
		        ENDIF
		
		        IF PEMSTATUS(loSec, "grid2", 5)
		            loSec.grid2.RecordSource = ""
		        ENDIF
		
		        loSec.Refresh()
		    ENDIF
		CATCH
		ENDTRY
		
		*---------------------------------------------------------
		* 2) Lista explícita de cursores usados por el formulario
		*---------------------------------------------------------
		DIMENSION laCurs[93]
		
		laCurs[1]  = "cur_alerts"
		laCurs[2]  = "cur_alerts_ped"
		laCurs[3]  = "cur_alerts_ped_tmp"
		laCurs[4]  = "cur_all_provs_tmp"

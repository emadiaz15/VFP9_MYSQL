	PROCEDURE principal.Combo1.Init
		*=========================================================
		* && principal.combo1.Init
		*=========================================================
		THIS.RowSourceType = 1
		THIS.RowSource     = "PEDIDOS,SELECCIONADOS,POSICION < (POS.MÍNIMO + % ALERTA),SUGERIDO > 0,POSICIÓN < POSICIÓN MIN,STOCK (-),POSICIÓN (-),COMPRA URGENTE,RUBROS,PROVEEDOR,DEPURACIÓN"
		THIS.Value         = 1
		THIS.Style         = 2   && DropDown List
	ENDPROC

	PROCEDURE principal.Combo1.InteractiveChange
		*=========================================================
		* && principal.combo1.InteractiveChange
		*=========================================================
		LOCAL lcFiltro, llSoloCargaCombo
		
		IF !PEMSTATUS(THISFORM, "xIsFiltering", 5)
		    THISFORM.AddProperty("xIsFiltering", .F.)
		ENDIF
		
		IF THISFORM.xIsFiltering
		    RETURN
		ENDIF
		
		THISFORM.xIsFiltering = .T.
		llSoloCargaCombo = .F.
		
		TRY
		    IF !PEMSTATUS(THISFORM, "xCombo2Mode", 5)
		        THISFORM.AddProperty("xCombo2Mode", "")
		    ENDIF
		
		    IF !PEMSTATUS(THISFORM, "xCombo2ValorActual", 5)
		        THISFORM.AddProperty("xCombo2ValorActual", 0)
		    ENDIF
		
		    IF !PEMSTATUS(THISFORM, "xRubCodiActual", 5)
		        THISFORM.AddProperty("xRubCodiActual", 0)
		    ENDIF
		
		    IF !PEMSTATUS(THISFORM, "xProveedorCodiActual", 5)
		        THISFORM.AddProperty("xProveedorCodiActual", 0)
		    ENDIF
		
		    IF !PEMSTATUS(THISFORM, "xDepuracionActual", 5)
		        THISFORM.AddProperty("xDepuracionActual", 0)
		    ENDIF
		
		    IF !PEMSTATUS(THISFORM, "xFiltroPedidos", 5)
		        THISFORM.AddProperty("xFiltroPedidos", .F.)
		    ENDIF
		
		    IF !PEMSTATUS(THISFORM, "xPedFecDes", 5)
		        THISFORM.AddProperty("xPedFecDes", DATE())
		    ENDIF
		
		    IF !PEMSTATUS(THISFORM, "xPedFecHas", 5)
		        THISFORM.AddProperty("xPedFecHas", DATE())
		    ENDIF
		
		    IF !PEMSTATUS(THISFORM, "xPermitirSalirFechaHas", 5)
		        THISFORM.AddProperty("xPermitirSalirFechaHas", .F.)
		    ENDIF
		
		    IF !PEMSTATUS(THISFORM, "xFiltroActual", 5)
		        THISFORM.AddProperty("xFiltroActual", "TODOS")
		    ENDIF
		
		    *-----------------------------------------------------
		    * Normalizar valor visible del combo1
		    *-----------------------------------------------------
		    lcFiltro = UPPER(ALLTRIM(TRANSFORM(THIS.DisplayValue)))
		    lcFiltro = STRTRAN(lcFiltro, "Á", "A")
		    lcFiltro = STRTRAN(lcFiltro, "É", "E")
		    lcFiltro = STRTRAN(lcFiltro, "Í", "I")
		    lcFiltro = STRTRAN(lcFiltro, "Ó", "O")
		    lcFiltro = STRTRAN(lcFiltro, "Ú", "U")
		
		    IF PEMSTATUS(THISFORM, "combo2", 5)
		        THISFORM.combo2.Visible = .F.
		    ENDIF
		
		    *-- Ocultar por defecto el filtro especial de Pedidos
		    IF PEMSTATUS(THISFORMSET, "MostrarFiltroPedidos", 5)
		        THISFORMSET.MostrarFiltroPedidos(.F.)
		    ENDIF
		
		    DO CASE
		
				CASE lcFiltro == "RUBROS"
				    THISFORM.xFiltroPedidos = .F.
				    THISFORM.xCombo2Mode = "RUBROS"
				    THISFORM.xFiltroActual = "RUBROS"
				    llSoloCargaCombo = .T.
		
				    IF PEMSTATUS(THISFORM, "combo2", 5)
				        THISFORM.combo2.Visible = .T.
				    ENDIF
		
				    IF PEMSTATUS(THISFORMSET, "CargarComboRubros", 5)
				        THISFORMSET.CargarComboRubros()
				    ENDIF
		
				    IF PEMSTATUS(THISFORM, "combo2", 5)
				        THISFORM.combo2.Visible = .T.
				        THISFORM.combo2.Refresh()
				        DOEVENTS
				    ENDIF
		
				    IF PEMSTATUS(THISFORMSET, "ActualizarInfoFiltro", 5)
				        THISFORMSET.ActualizarInfoFiltro()
				    ENDIF
		
				CASE lcFiltro == "PROVEEDOR"
				    THISFORM.xFiltroPedidos = .F.
				    THISFORM.xCombo2Mode = "PROVEEDOR"
				    THISFORM.xFiltroActual = "PROVEEDOR"
				    llSoloCargaCombo = .T.
		
				    IF PEMSTATUS(THISFORM, "combo2", 5)
				        THISFORM.combo2.Visible = .T.
				    ENDIF
		
				    IF PEMSTATUS(THISFORMSET, "CargarComboProveedores", 5)
				        THISFORMSET.CargarComboProveedores()
				    ENDIF
		
				    IF PEMSTATUS(THISFORM, "combo2", 5)
				        THISFORM.combo2.Visible = .T.
				        THISFORM.combo2.Refresh()
				        DOEVENTS
				    ENDIF
		
				    IF PEMSTATUS(THISFORMSET, "ActualizarInfoFiltro", 5)
				        THISFORMSET.ActualizarInfoFiltro()
				    ENDIF
				    
				CASE lcFiltro == "DEPURACION"
				    THISFORM.xFiltroPedidos = .F.
				    THISFORM.xCombo2Mode = "DEPURACION"
				    THISFORM.xFiltroActual = "DEPURACION"
				    THISFORM.xCombo2ValorActual = 0
				    THISFORM.xDepuracionActual = 0
				    llSoloCargaCombo = .T.
		
				    IF PEMSTATUS(THISFORMSET, "MostrarFiltroPedidos", 5)
				        THISFORMSET.MostrarFiltroPedidos(.F.)
				    ENDIF
		
				    IF PEMSTATUS(THISFORMSET, "CargarComboDepuracion", 5)
				        IF !THISFORMSET.CargarComboDepuracion()
				            MESSAGEBOX("No se pudo cargar el combo de depuración.", 16, "Error")
				            RETURN
				        ENDIF
				    ELSE
				        MESSAGEBOX("No existe el método CargarComboDepuracion en el FormSet.", 16, "Error")
				        RETURN
				    ENDIF
		
				    IF PEMSTATUS(THISFORM, "combo2", 5)
				        THISFORM.combo2.Visible = .T.
				        THISFORM.combo2.Enabled = .T.
				        THISFORM.combo2.Refresh()
				        DOEVENTS
				    ENDIF
		
				    IF PEMSTATUS(THISFORMSET, "ActualizarInfoFiltro", 5)
				        THISFORMSET.ActualizarInfoFiltro()
				    ENDIF
		
				    IF PEMSTATUS(THISFORM, "combo2", 5)
				        TRY
				            THISFORM.combo2.SetFocus()
				        CATCH
				        ENDTRY
				    ENDIF
		
		        CASE lcFiltro == "PEDIDOS"
		            THISFORM.xPermitirSalirFechaHas = .F.
		            THISFORM.xFiltroPedidos = .T.
		            THISFORM.xCombo2Mode   = ""
		            THISFORM.xFiltroActual = "PEDIDOS"
		
		            IF !PEMSTATUS(THISFORM, "xPedFecDes", 5)
		                THISFORM.AddProperty("xPedFecDes", DATE())
		            ENDIF
		
		            IF !PEMSTATUS(THISFORM, "xPedFecHas", 5)
		                THISFORM.AddProperty("xPedFecHas", DATE())
		            ENDIF
		
		            IF VARTYPE(THISFORM.xPedFecDes) # "D" OR EMPTY(THISFORM.xPedFecDes)
		                THISFORM.xPedFecDes = DATE()
		            ENDIF
		
		            IF VARTYPE(THISFORM.xPedFecHas) # "D" OR EMPTY(THISFORM.xPedFecHas)
		                THISFORM.xPedFecHas = DATE()
		            ENDIF
		
		            IF PEMSTATUS(THISFORM, "txt_fecdes", 5)
		                THISFORM.txt_fecdes.Value = THISFORM.xPedFecDes
		            ENDIF
		
		            IF PEMSTATUS(THISFORM, "txt_fechas", 5)
		                THISFORM.txt_fechas.Value = THISFORM.xPedFecHas
		            ENDIF
		
		            IF PEMSTATUS(THISFORMSET, "MostrarFiltroPedidos", 5)
		                THISFORMSET.MostrarFiltroPedidos(.T.)
		            ENDIF
		
		            WAIT WINDOW "Cargando pedidos..." NOWAIT
		
		            IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		                THISFORMSET.AplicarFiltroLocal("PEDIDOS", 0)
		            ENDIF
		
		            IF PEMSTATUS(THISFORM, "grd_alerts", 5)
		                THISFORM.grd_alerts.RecordSource = "cur_alerts"
		                THISFORM.grd_alerts.Refresh()
		            ENDIF
		
		            IF USED("cur_alerts")
		                SELECT cur_alerts
		                IF RECCOUNT("cur_alerts") > 0
		                    GO TOP
		                ENDIF
		            ENDIF
		
		            IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		                THISFORMSET.RefrescarGrid()
		            ENDIF
		
		            IF PEMSTATUS(THISFORMSET, "ActualizarInfoFiltro", 5)
		                THISFORMSET.ActualizarInfoFiltro()
		            ENDIF
		
		            WAIT CLEAR
		
		            IF PEMSTATUS(THISFORM, "txt_fecdes", 5)
		                TRY
		                    THISFORM.txt_fecdes.AutoTab = .F.
		                CATCH
		                ENDTRY
		                THISFORM.txt_fecdes.Visible = .T.
		                THISFORM.txt_fecdes.Enabled = .T.
		            ENDIF
		
		            IF PEMSTATUS(THISFORM, "txt_fechas", 5)
		                TRY
		                    THISFORM.txt_fechas.AutoTab = .F.
		                CATCH
		                ENDTRY
		            ENDIF
		
		            DOEVENTS
		
		            IF PEMSTATUS(THISFORM, "txt_fecdes", 5)
		                TRY
		                    THISFORM.txt_fecdes.SetFocus()
		                CATCH
		                ENDTRY
		            ENDIF
		
		        CASE lcFiltro == "SELECCIONADOS"
		            THISFORM.xFiltroPedidos = .F.
		            THISFORM.xCombo2Mode   = ""
		            THISFORM.xFiltroActual = "SELECCIONADOS"
		
		            IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		                THISFORMSET.AplicarFiltroLocal("SELECCIONADOS", 0)
		            ENDIF
		
		            IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		                THISFORMSET.RefrescarGrid()
		            ENDIF
		
		        OTHERWISE
		            THISFORM.xFiltroPedidos = .F.
		            THISFORM.xCombo2Mode   = ""
		            THISFORM.xFiltroActual = lcFiltro
		
		            WAIT WINDOW "Filtrando..." NOWAIT
		
		            IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		                THISFORMSET.AplicarFiltroLocal(lcFiltro, 0)
		            ENDIF
		
		            IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		                THISFORMSET.RefrescarGrid()
		            ENDIF
		
		            WAIT CLEAR
		    ENDCASE
		
		    IF !llSoloCargaCombo
		        IF PEMSTATUS(THISFORMSET, "ActualizarInfoFiltro", 5)
		            THISFORMSET.ActualizarInfoFiltro()
		        ENDIF
		    ENDIF
		
		FINALLY
		    THISFORM.xIsFiltering = .F.
		    WAIT CLEAR
		ENDTRY
	ENDPROC

	PROCEDURE principal.Combo2.Click
		*=========================================================
		* principal.combo2.Click  — entrada única de filtro combo2
		*=========================================================
		LOCAL loFS, loFrm
		LOCAL lnValor, lcModo
		
		loFS = THISFORMSET
		IF VARTYPE(loFS) <> "O"
		    RETURN
		ENDIF
		
		IF TYPE("loFS.principal.Name") = "U"
		    RETURN
		ENDIF
		
		loFrm = loFS.principal
		IF VARTYPE(loFrm) <> "O"
		    RETURN
		ENDIF
		
		*---------------------------------------------------------
		* Anti reentrada
		*---------------------------------------------------------
		IF !PEMSTATUS(loFrm, "xProcesandoCombo2", 5)
		    loFrm.AddProperty("xProcesandoCombo2", .F.)
		ENDIF
		
		IF loFrm.xProcesandoCombo2
		    RETURN
		ENDIF
		
		loFrm.xProcesandoCombo2 = .T.
		
		TRY
		    *-----------------------------------------------------
		    * Leer valor numérico del combo
		    *-----------------------------------------------------
		    IF TYPE("THIS.Value") $ "NI"
		        lnValor = THIS.Value
		    ELSE
		        lnValor = VAL(TRANSFORM(THIS.Value))
		    ENDIF
		
		    *-----------------------------------------------------
		    * Leer modo actual del combo
		    *-----------------------------------------------------
		    lcModo = ""
		    IF PEMSTATUS(loFrm, "xCombo2Mode", 5)
		        lcModo = UPPER(ALLTRIM(NVL(loFrm.xCombo2Mode, "")))
		    ENDIF
		
		    *-----------------------------------------------------
		    * Guardar valor actual
		    *-----------------------------------------------------
		    IF PEMSTATUS(loFrm, "xCombo2ValorActual", 5)
		        loFrm.xCombo2ValorActual = lnValor
		    ENDIF
		
		    *-----------------------------------------------------
		    * Despachar SIEMPRE por AplicarFiltroLocal
		    *-----------------------------------------------------
		    DO CASE
		    CASE lcModo == "RUBROS"
		        IF PEMSTATUS(loFrm, "xRubCodiActual", 5)
		            loFrm.xRubCodiActual = lnValor
		        ENDIF
		
		        IF PEMSTATUS(loFS, "AplicarFiltroLocal", 5)
		            loFS.AplicarFiltroLocal("RUBROS", lnValor)
		        ENDIF
		
		    CASE lcModo == "PROVEEDOR"
		        IF PEMSTATUS(loFrm, "xProveedorCodiActual", 5)
		            loFrm.xProveedorCodiActual = lnValor
		        ENDIF
		
		        * NO llamar AplicarFiltroProveedor directamente.
		        * AplicarFiltroLocal lo delega internamente.
		        IF PEMSTATUS(loFS, "AplicarFiltroLocal", 5)
		            loFS.AplicarFiltroLocal("PROVEEDOR", lnValor)
		        ENDIF
		
		    CASE lcModo == "DEPURACION"
		        IF PEMSTATUS(loFrm, "xDepuracionActual", 5)
		            loFrm.xDepuracionActual = lnValor
		        ENDIF
		
		        IF PEMSTATUS(loFS, "AplicarFiltroLocal", 5)
		            loFS.AplicarFiltroLocal("DEPURACION", lnValor)
		        ENDIF
		
		    OTHERWISE
		        * modo no reconocido, no hacer nada
		    ENDCASE
		
		    *-----------------------------------------------------
		    * Actualizar referencia descriptiva
		    *-----------------------------------------------------
		    IF PEMSTATUS(loFS, "ActualizarInfoFiltro", 5)
		        loFS.ActualizarInfoFiltro()
		    ENDIF
		
		    *-----------------------------------------------------
		    * Refuerzo visual de la grilla
		    *-----------------------------------------------------
		    IF PEMSTATUS(loFS, "RefrescarGrid", 5)
		        loFS.RefrescarGrid()
		    ELSE
		        IF PEMSTATUS(loFrm, "grd_alerts", 5)
		            loFrm.grd_alerts.Refresh()
		        ENDIF
		    ENDIF
		
		FINALLY
		    loFrm.xProcesandoCombo2 = .F.
		ENDTRY
		
		RETURN
	ENDPROC

	PROCEDURE principal.Combo2.Init
		*=========================================================
		*&& principal.combo2.Init
		*=========================================================
		THIS.Visible       = .F.
		THIS.RowSourceType = 0
		THIS.Style         = 0   && DropDown (permite tipear)
	ENDPROC

	PROCEDURE principal.Combo2.InteractiveChange
		*=========================================================
		* principal.combo2.InteractiveChange
		*=========================================================
		IF PEMSTATUS(THIS, "lOmitInteractive", 5) AND THIS.lOmitInteractive
		    RETURN
		ENDIF
		
		THIS.Click()
		RETURN
	ENDPROC

	PROCEDURE principal.Combo2.KeyPress
		*=========================================================
		* && principal.combo2.KeyPress
		*=========================================================
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		DO CASE
		
		CASE nKeyCode = 24    && Flecha abajo
		    IF THIS.ListIndex < THIS.ListCount
		        IF !PEMSTATUS(THIS, "lOmitInteractive", 5)
		            THIS.AddProperty("lOmitInteractive", .F.)
		        ENDIF
		
		        THIS.lOmitInteractive = .T.
		        THIS.ListIndex = THIS.ListIndex + 1
		        DOEVENTS
		        THIS.lOmitInteractive = .F.
		
		        THIS.Click()
		    ENDIF
		    NODEFAULT
		
		CASE nKeyCode = 5     && Flecha arriba
		    IF THIS.ListIndex > 1
		        IF !PEMSTATUS(THIS, "lOmitInteractive", 5)
		            THIS.AddProperty("lOmitInteractive", .F.)
		        ENDIF
		
		        THIS.lOmitInteractive = .T.
		        THIS.ListIndex = THIS.ListIndex - 1
		        DOEVENTS
		        THIS.lOmitInteractive = .F.
		
		        THIS.Click()
		    ENDIF
		    NODEFAULT
		
		CASE nKeyCode = 13    && Enter
		    DOEVENTS
		    THIS.Click()
		    NODEFAULT
		
		ENDCASE
	ENDPROC


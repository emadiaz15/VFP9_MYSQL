	PROCEDURE principal.grd_alerts.DblClick
		*=========================================================
		* principal.grd_alerts.DblClick
		*=========================================================
		IF !PEMSTATUS(THISFORMSET, "xEnDblClick", 5)
		    THISFORMSET.AddProperty("xEnDblClick", .F.)
		ENDIF
		
		IF THISFORMSET.xEnDblClick
		    NODEFAULT
		    RETURN
		ENDIF
		
		THISFORMSET.xEnDblClick = .T.
		
		TRY
		    IF PEMSTATUS(THISFORMSET, "GridDblClick", 5)
		        THISFORMSET.GridDblClick()
		    ENDIF
		CATCH
		ENDTRY
		
		THISFORMSET.xEnDblClick = .F.
		NODEFAULT
		RETURN
	ENDPROC

	PROCEDURE principal.grd_alerts.MouseDown
		*=========================================================
		* principal.grd_alerts.MouseDown
		* - Click en Header para ordenar
		* - Click en cuerpo para mantener modo fila
		*=========================================================
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		LOCAL lnCol, lnAcc, lcCS, lcField
		
		IF !USED("cur_alerts") OR EOF("cur_alerts")
		    RETURN
		ENDIF
		
		*---------------------------------------------------------
		* CLICK IZQUIERDO EN HEADER = ORDENAR
		*---------------------------------------------------------
		IF nButton = 1 AND nYCoord <= THIS.HeaderHeight
		
		    lnAcc = 0
		    lnCol = 0
		
		    FOR lnCol = 1 TO THIS.ColumnCount
		        lnAcc = lnAcc + THIS.Columns(lnCol).Width
		        IF nXCoord <= lnAcc
		            EXIT
		        ENDIF
		    NEXT
		
		    IF lnCol < 1 OR lnCol > THIS.ColumnCount
		        RETURN
		    ENDIF
		
		    lcCS = ALLTRIM(THIS.Columns(lnCol).ControlSource)
		    IF EMPTY(lcCS)
		        RETURN
		    ENDIF
		
		    lcField = IIF("." $ lcCS, SUBSTR(lcCS, AT(".", lcCS) + 1), lcCS)
		    lcField = LOWER(ALLTRIM(lcField))
		
		    * no ordenar por selector
		    IF lcField == "ui_sel"
		        NODEFAULT
		        RETURN
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "SortAlertsByField", 5)
		        THISFORMSET.SortAlertsByField(lcField)
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "UpdateGridHeaderSortUI", 5)
		        THISFORMSET.UpdateGridHeaderSortUI()
		    ENDIF
		
		    NODEFAULT
		    RETURN
		ENDIF
		
		*---------------------------------------------------------
		* CLICK IZQUIERDO EN CUERPO = COMPORTAMIENTO POR FILA
		*---------------------------------------------------------
		IF nButton = 1 AND nYCoord > THIS.HeaderHeight
		    TRY
		        THIS.SetFocus()
		    CATCH
		    ENDTRY
		
		    IF PEMSTATUS(THISFORM, "shpSelRow", 5)
		        THISFORM.shpSelRow.Visible = .T.
		    ENDIF
		
		    NODEFAULT
		    RETURN
		ENDIF
		
		*---------------------------------------------------------
		* CLICK DERECHO:
		* lo maneja RightClick, no intervenir acá
		*---------------------------------------------------------
		
		
		IF nButton = 2 AND nYCoord > THIS.HeaderHeight
		    LOCAL lnWhere, lnRelRow, lnRelCol
		
		    lnWhere  = 0
		    lnRelRow = 0
		    lnRelCol = 0
		
		    IF THIS.GridHitTest(nXCoord, nYCoord, @lnWhere, @lnRelRow, @lnRelCol)
		        IF lnRelRow > 0 AND lnRelCol > 0
		            TRY
		                THIS.SetFocus()
		                THIS.ActivateCell(lnRelRow, lnRelCol)
		            CATCH
		            ENDTRY
		        ENDIF
		    ENDIF
		
		    NODEFAULT
		    RETURN
		ENDIF
		
		
		RETURN
	ENDPROC

	PROCEDURE principal.grd_alerts.RightClick
		*=========================================================
		* grd_alerts.RightClick — menú contextual
		* Disponible en cualquier filtro
		* Delega lógica a FormSet.MostrarMenuContextoGrid
		*=========================================================
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0 OR EOF("cur_alerts")
		    RETURN
		ENDIF
		IF !PEMSTATUS(THISFORMSET, "MostrarMenuContextoGrid", 5)
		    RETURN
		ENDIF
		THISFORMSET.MostrarMenuContextoGrid()
		
		
		
		
		
		*!*	*=========================================================
		*!*	* grd_alerts.RightClick — menú contextual
		*!*	* Solo disponible en filtro "SELECCIONADOS"
		*!*	*=========================================================
		*!*	IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0 OR EOF("cur_alerts")
		*!*	    RETURN
		*!*	ENDIF
		
		*!*	IF !PEMSTATUS(THISFORMSET, "principal", 5)
		*!*	    RETURN
		*!*	ENDIF
		
		*!*	IF !PEMSTATUS(THISFORMSET.principal, "combo1", 5)
		*!*	    RETURN
		*!*	ENDIF
		
		*!*	IF UPPER(ALLTRIM(TRANSFORM(THISFORMSET.principal.combo1.DisplayValue))) <> "SELECCIONADOS"
		*!*	    RETURN
		*!*	ENDIF
		
		*!*	LOCAL llEditar
		*!*	llEditar = .F.
		
		*!*	TRY
		*!*	    RELEASE POPUP _mnu_grd_alerts
		*!*	CATCH
		*!*	ENDTRY
		
		*!*	DEFINE POPUP _mnu_grd_alerts SHORTCUT RELATIVE FROM MROW(), MCOL()
		*!*	DEFINE BAR 1 OF _mnu_grd_alerts PROMPT "\<Editar Cantidad"
		*!*	ON SELECTION BAR 1 OF _mnu_grd_alerts llEditar = .T.
		
		*!*	ACTIVATE POPUP _mnu_grd_alerts
		
		*!*	TRY
		*!*	    RELEASE POPUP _mnu_grd_alerts
		*!*	CATCH
		*!*	ENDTRY
		
		*!*	IF llEditar AND PEMSTATUS(THISFORMSET, "EditarCantidadAlerta", 5)
		*!*	    THISFORMSET.EditarCantidadAlerta()
		*!*	ENDIF
		
		*!*	RETURN
		
		
		
	ENDPROC

	PROCEDURE principal.grd_prov.AfterRowColChange
		LPARAMETERS nColIndex
		*=========================================================
		* grd_prov.AfterRowColChange — efecto camaleón
		*=========================================================
		IF !USED("cur_provs_col10") OR RECCOUNT("cur_provs_col10") = 0 OR EOF("cur_provs_col10")
		    RETURN
		ENDIF
		
		LOCAL lnLista, lnCotiz, llTieneColor, lnBase, lnHighBack, lnHighFore
		
		lnLista      = IIF(TYPE("cur_provs_col10.lista")="N", cur_provs_col10.lista, 0)
		lnCotiz      = IIF(TYPE("cur_provs_col10.cotiz")="N", cur_provs_col10.cotiz, 0)
		llTieneColor = (lnLista = 1 OR lnCotiz = 1)
		
		DO CASE
		    CASE lnLista=1 AND lnCotiz=0
		        lnBase = RGB(144,238,144)
		    CASE lnLista=0 AND lnCotiz=1
		        lnBase = RGB(230,240,20)
		    CASE lnLista=1 AND lnCotiz=1
		        lnBase = RGB(255,211,168)
		    OTHERWISE
		        lnBase = RGB(40,44,52)
		ENDCASE
		
		IF llTieneColor AND PEMSTATUS(THISFORMSET, "DarkenColor", 5)
		    lnHighBack = THISFORMSET.DarkenColor(lnBase, 0.72)
		    lnHighFore = RGB(0, 0, 0)
		ELSE
		    *-- Fila sin color especial ? azul estándar
		    lnHighBack = RGB(70, 130, 180)
		    lnHighFore = RGB(255, 255, 255)
		ENDIF
		
		THIS.HighlightBackColor = lnHighBack
		THIS.HighlightForeColor = lnHighFore
	ENDPROC


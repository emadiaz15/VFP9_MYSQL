		laCurs[85] = "cur_transportes"
		laCurs[86] = "cur_transportes_tmp"
		laCurs[87] = "cur_ubic"
		laCurs[88] = "cur_ult_cli"
		laCurs[89] = "cur_val_soli"
		laCurs[90] = "cur_valida_art_manual"
		laCurs[91] = "cur_valida_mone"
		laCurs[92] = "cur_vc_months"
		laCurs[93] = "cur_venta_compra"
		
		*---------------------------------------------------------
		* 3) Cerrar cursores
		*---------------------------------------------------------
		FOR lnI = 1 TO ALEN(laCurs, 1)
		    lcAlias = laCurs[lnI]
		
		    IF USED(lcAlias)
		        TRY
		            USE IN (lcAlias)
		        CATCH
		        ENDTRY
		    ENDIF
		NEXT
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE configurargrdprov
		*=========================================================
		* FormSet.ConfigurarGrdProv
		* - Configura grd_prov del form principal
		* - Muestra proveedores, costo, moneda y fecha
		* - Corrige visualización de decimales en artpro_costo
		*=========================================================
		
		LOCAL loFrm, loGrid, lnC
		
		loFrm = THISFORMSET.principal
		
		IF !PEMSTATUS(loFrm, "grd_prov", 5)
		    RETURN .F.
		ENDIF
		
		loGrid = loFrm.grd_prov
		
		*---------------------------------------------------------
		* Asegurar cursor cur_provs_col10
		* Si no existe o artpro_fecha quedó como T, se recrea
		*---------------------------------------------------------
		IF !USED("cur_provs_col10")                          OR ;
		   TYPE("cur_provs_col10.artpro_fecha") = "U"        OR ;
		   TYPE("cur_provs_col10.artpro_fecha") = "T"
		
		    IF USED("cur_provs_col10")
		        USE IN cur_provs_col10
		    ENDIF
		
		    CREATE CURSOR cur_provs_col10 ( ;
		        prov_nomb     C(80),   ;
		        prov_codi     I,       ;
		        artpro_costo  N(15,4), ;
		        artpro_moneda C(1),    ;
		        artpro_fecha  D,       ;
		        lista         I,       ;
		        cotiz         I )
		ENDIF
		
		WITH loGrid
		
		    *-----------------------------------------------------
		    * Configuración base del grid
		    *-----------------------------------------------------
		    .RecordSourceType   = 1
		    .RecordSource       = "cur_provs_col10"
		    .ColumnCount        = 4
		    .DeleteMark         = .F.
		    .RecordMark         = .F.
		    .AllowCellSelection = .F.
		    .ReadOnly           = .T.
		    .GridLines          = 0
		    .RowHeight          = 17
		    .FontSize           = 8
		    .Themes             = .F.
		    .HighlightBackColor = RGB(70, 130, 180)
		    .HighlightForeColor = RGB(255, 255, 255)
		    .HighlightStyle     = 2
		
		    *-----------------------------------------------------
		    * ControlSource
		    * prov_codi se usa desde el cursor, no necesita columna
		    *-----------------------------------------------------
		    .Columns(1).ControlSource = "cur_provs_col10.prov_nomb"
		    .Columns(2).ControlSource = "cur_provs_col10.artpro_costo"
		    .Columns(3).ControlSource = "cur_provs_col10.artpro_moneda"
		    .Columns(4).ControlSource = "cur_provs_col10.artpro_fecha"
		
		    *-----------------------------------------------------
		    * Anchos
		    *-----------------------------------------------------
		    .Columns(1).Width = 131
		    .Columns(2).Width = 85
		    .Columns(3).Width = 34
		    .Columns(4).Width = 78
		
		    *-----------------------------------------------------
		    * Alineaciones de columna
		    *-----------------------------------------------------
		    .Columns(1).Alignment = 0
		    .Columns(2).Alignment = 1
		    .Columns(3).Alignment = 2
		    .Columns(4).Alignment = 2
		
		    *-----------------------------------------------------
		    * Estética general de columnas, headers y Text1
		    *-----------------------------------------------------
		    FOR lnC = 1 TO 4
		
		        .Columns(lnC).BackColor = RGB(40, 44, 52)
		        .Columns(lnC).ForeColor = RGB(220, 220, 220)
		        .Columns(lnC).FontSize  = 8
		
		        IF PEMSTATUS(.Columns(lnC), "Header1", 5)
		            WITH .Columns(lnC).Header1
		                .BackColor = RGB(70, 130, 180)
		                .ForeColor = RGB(255, 255, 255)
		                .Alignment = 2
		                .FontSize  = 8
		            ENDWITH
		        ENDIF
		
		        IF PEMSTATUS(.Columns(lnC), "Text1", 5)
		            WITH .Columns(lnC).Text1
		                .BorderStyle = 0
		                .Margin      = 0
		                .BackColor   = RGB(40, 44, 52)
		                .ForeColor   = RGB(220, 220, 220)
		                .FontSize    = 8
		            ENDWITH
		        ENDIF
		
		    NEXT lnC
		
		    *-----------------------------------------------------
		    * Columna 2: Costo
		    * Importante:
		    * - artpro_costo es N(15,4)
		    * - InputMask fuerza la visualización con 4 decimales
		    * - Format = "Z" evita relleno visual innecesario
		    *-----------------------------------------------------
		    IF PEMSTATUS(.Columns(2), "Text1", 5)
		        WITH .Columns(2).Text1
		            .Alignment = 1
		            .InputMask = "999999999999.9999"
		            .Format    = "Z"
		        ENDWITH
		    ENDIF
		
		    *-----------------------------------------------------
		    * Columna 4: Fecha
		    *-----------------------------------------------------
		    IF PEMSTATUS(.Columns(4), "Text1", 5)
		        .Columns(4).Text1.Format = "D"
		    ENDIF
		
		    *-----------------------------------------------------
		    * Colores dinámicos por proveedor lista/cotización
		    * Verde: lista=1 cotiz=0
		    * Amarillo: lista=0 cotiz=1
		    * Naranja: lista=1 cotiz=1
		    * Oscuro: normal
		    *-----------------------------------------------------
		    FOR lnC = 1 TO 4
		
		        .Columns(lnC).DynamicBackColor = ;
		            "IIF(cur_provs_col10.lista=1 AND cur_provs_col10.cotiz=0, RGB(144,238,144), " + ;
		            "IIF(cur_provs_col10.lista=0 AND cur_provs_col10.cotiz=1, RGB(230,240,20), " + ;
		            "IIF(cur_provs_col10.lista=1 AND cur_provs_col10.cotiz=1, RGB(255,211,168), RGB(40,44,52))))"
		
		        .Columns(lnC).DynamicForeColor = ;
		            "IIF(cur_provs_col10.lista=1 OR cur_provs_col10.cotiz=1, RGB(0,0,0), RGB(220,220,220))"
		
		    NEXT lnC
		
		    *-----------------------------------------------------
		    * Captions
		    *-----------------------------------------------------
		    IF PEMSTATUS(.Columns(1), "Header1", 5)
		        .Columns(1).Header1.Caption = "Proveedor"
		    ENDIF
		
		    IF PEMSTATUS(.Columns(2), "Header1", 5)
		        .Columns(2).Header1.Caption = "Costo"
		    ENDIF
		
		    IF PEMSTATUS(.Columns(3), "Header1", 5)
		        .Columns(3).Header1.Caption = "Mon"
		    ENDIF
		
		    IF PEMSTATUS(.Columns(4), "Header1", 5)
		        .Columns(4).Header1.Caption = "Fecha"
		    ENDIF
		
		    *-----------------------------------------------------
		    * Evento doble click
		    *-----------------------------------------------------
		    UNBINDEVENTS(loGrid)
		    BINDEVENT(loGrid, "DblClick", THISFORMSET, "GrdProvDblClick")
		
		    .Refresh()
		
		ENDWITH
		
		RETURN .T.
	ENDPROC

	PROCEDURE configurargrid
		*=========================================================
		* FormSet.ConfigurarGrid
		*=========================================================
		
		LOCAL loFrm, loConsulta
		LOCAL lcSizeExpr, lnCol10Width
		LOCAL lcSafety, lnC
		
		loFrm = THISFORMSET.principal
		loConsulta = .NULL.
		
		IF !PEMSTATUS(loFrm, "xObsIconPath", 5)
		    loFrm.AddProperty("xObsIconPath", "")
		ENDIF
		
		IF EMPTY(ALLTRIM(loFrm.xObsIconPath)) OR !FILE(loFrm.xObsIconPath)
		    loFrm.xObsIconPath = "C:\VFP9_MYSQL\Imagen\add.ico"
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xObsBlankPath", 5)
		    loFrm.AddProperty("xObsBlankPath", "")
		ENDIF
		
		*!*	IF EMPTY(ALLTRIM(loFrm.xObsBlankPath)) OR !FILE(loFrm.xObsBlankPath)
		*!*	    loFrm.xObsBlankPath = "C:\VFP9_MYSQL\Imagen\add.ico"
		*!*	ENDIF
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		*---------------------------------------------------------
		* Asegurar estructura nueva de cur_alerts
		*---------------------------------------------------------
		IF USED("cur_alerts")
		    IF TYPE("cur_alerts.prov_nomb_sel") = "U" OR ;
		       TYPE("cur_alerts.artpro_costo")  = "U" OR ;
		       TYPE("cur_alerts.prov_codi_sel") = "U" OR ;
		       TYPE("cur_alerts.prov_lista")    = "U" OR ;
		       TYPE("cur_alerts.artpro_moneda") = "U" OR ;
		       TYPE("cur_alerts.artpro_fecha")  = "U" OR ;
		       TYPE("cur_alerts.cant_soli")     = "U" OR ;
		       TYPE("cur_alerts.col_back")      = "U" OR ;
		       TYPE("cur_alerts.col_fore")      = "U" OR ;
		       TYPE("cur_alerts.estado")        = "U" OR ;
		       TYPE("cur_alerts.ui_color_rank") = "U" OR ;
		       TYPE("cur_alerts.observacion")   = "U"
		        USE IN cur_alerts
		    ENDIF
		ENDIF
		
		IF !USED("cur_alerts")
		    CREATE CURSOR cur_alerts ( ;
		        art_codi           I,       ;
		        art_desc           C(80),   ;
		        art_stock          N(15,3), ;
		        art_stmin          N(15,3), ;
		        art_pct_alerta     N(10,2), ;
		        pedidos            N(15,3), ;
		        pedprov            N(15,3), ;
		        posicion           N(15,3), ;
		        sug_neto           N(15,3), ;
		        pct_rotacion       N(10,3), ;
		        ventas_metrics     M,       ;
		        promedio_venta     N(15,3), ;
		        fecha_ult_venta    D,       ;
		        compras_metrics    M,       ;
		        promedio_compra    N(15,3), ;
		        fecha_ult_compra   D,       ;
		        dias_demora_ent    I,       ;
		        pos_min_sug        N(15,3), ;
		        sugerido_comprar   N(15,3), ;
		        cant_soli          N(15,3), ;
		        meses_cubiertos    N(15,3), ;
		        meses_cob_proy     N(15,3), ;
		        meses_cobert_solic N(15,3), ;
		        score              I,       ;
		        rub_codi           I,       ;
		        rub_desc           C(60),   ;
		        estado             I,       ;
		        prov_codi_sel      I,       ;
		        prov_nomb_sel      C(80),   ;
		        artpro_costo       N(15,4), ;
		        artpro_moneda      C(1),    ;
		        artpro_fecha       D,       ;
		        prov_lista         M,       ;
		        col_back           N(12,0), ;
		        col_fore           N(12,0), ;
		        ui_color_rank      I,       ;
		        observacion        M,       ;
		        ui_item            C(8),    ;
		        ui_sel             L )
		ENDIF
		
		*---------------------------------------------------------
		* cur_provs_col10
		*---------------------------------------------------------
		IF USED("cur_provs_col10")
		    IF TYPE("cur_provs_col10.artpro_moneda") = "U" OR ;
		       TYPE("cur_provs_col10.artpro_fecha")  = "U" OR ;
		       TYPE("cur_provs_col10.artpro_fecha")  = "T" OR ;
		       TYPE("cur_provs_col10.lista")         = "U" OR ;
		       TYPE("cur_provs_col10.cotiz")         = "U"
		        USE IN cur_provs_col10
		    ELSE
		        lcSafety = SET("SAFETY")
		        SET SAFETY OFF
		        SELECT cur_provs_col10
		        ZAP
		        IF UPPER(ALLTRIM(lcSafety)) == "ON"
		            SET SAFETY ON
		        ELSE
		            SET SAFETY OFF
		        ENDIF
		    ENDIF
		ENDIF
		
		IF !USED("cur_provs_col10")
		    CREATE CURSOR cur_provs_col10 ( ;
		        prov_nomb     C(80),   ;
		        prov_codi     I,       ;
		        artpro_costo  N(15,4), ;
		        artpro_moneda C(1),    ;
		        artpro_fecha  D,       ;
		        lista         I,       ;
		        cotiz         I )
		ENDIF
		
		*---------------------------------------------------------
		* Propiedades auxiliares del form
		*---------------------------------------------------------
		IF !PEMSTATUS(loFrm, "xCurRec", 5)
		    loFrm.AddProperty("xCurRec", IIF(USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0, RECNO("cur_alerts"), 0))
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xCurArt", 5)
		    loFrm.AddProperty("xCurArt", IIF(TYPE("cur_alerts.art_codi") = "N", cur_alerts.art_codi, 0))
		ENDIF
		
		IF !PEMSTATUS(loFrm, "shpSelRow", 5)
		    loFrm.AddObject("shpSelRow", "Shape")
		ENDIF
		
		WITH loFrm.shpSelRow
		    .BackStyle   = 0
		    .BorderStyle = 0
		    .Visible     = .F.
		ENDWITH
		*---------------------------------------------------------
		* Asegurar columnas físicas
		*---------------------------------------------------------
		IF loFrm.grd_alerts.ColumnCount < 14
		    loFrm.grd_alerts.ColumnCount = 14
		ENDIF
		
		lnCol10Width = loFrm.grd_alerts.Columns(10).Width
		
		WITH loFrm.grd_alerts
		    .Visible            = .F.
		    .RecordSourceType   = 1
		    .RecordSource       = "cur_alerts"
		    .ColumnCount        = 14
		    .BackColor          = RGB(255,255,255)
		    .AllowCellSelection = .F.
		    .HighlightStyle     = 2
		    .DeleteMark         = .F.
		    .RecordMark         = .F.
		
		    *-----------------------------------------------------
		    * ControlSource
		    *-----------------------------------------------------
		    .Columns(1).ControlSource  = "cur_alerts.ui_item"
		    .Columns(2).ControlSource  = "cur_alerts.art_codi"
		    .Columns(3).ControlSource  = "cur_alerts.art_desc"
		    .Columns(4).ControlSource  = "cur_alerts.art_stock"
		    .Columns(5).ControlSource  = "cur_alerts.pedprov"
		    .Columns(6).ControlSource  = "cur_alerts.pedidos"
		    .Columns(7).ControlSource  = "cur_alerts.posicion"
		    .Columns(8).ControlSource  = "cur_alerts.art_stmin"
		    .Columns(9).ControlSource  = "cur_alerts.sugerido_comprar"
		    .Columns(10).ControlSource = "cur_alerts.prov_nomb_sel"
		    .Columns(11).ControlSource = "cur_alerts.artpro_costo"
		    .Columns(12).ControlSource = "cur_alerts.artpro_moneda"
		    .Columns(13).ControlSource = "cur_alerts.ui_sel"
			.Columns(14).ControlSource = "cur_alerts.ui_item"
			
		    *-----------------------------------------------------
		    * Width
		    *-----------------------------------------------------
		    .Columns(1).Width  = 38
		    .Columns(2).Width  = 70
		    .Columns(3).Width  = 240
		    .Columns(4).Width  = 70
		    .Columns(5).Width  = 70
		    .Columns(6).Width  = 70
		    .Columns(7).Width  = 75
		    .Columns(8).Width  = 70
		    .Columns(9).Width  = 75
		    .Columns(10).Width = 165
		    .Columns(11).Width = 75
		    .Columns(12).Width = 40
		    .Columns(13).Width = 40
		    .Columns(14).Width = 30
		
		    lnCol10Width = .Columns(10).Width
		    *-----------------------------------------------------
		    * ReadOnly
		    *-----------------------------------------------------
		    .Columns(1).ReadOnly  = .T.
		    .Columns(2).ReadOnly  = .T.
		    .Columns(3).ReadOnly  = .T.
		    .Columns(4).ReadOnly  = .T.
		    .Columns(5).ReadOnly  = .T.
		    .Columns(6).ReadOnly  = .T.
		    .Columns(7).ReadOnly  = .T.
		    .Columns(8).ReadOnly  = .T.
		    .Columns(9).ReadOnly  = .T.
		    .Columns(10).ReadOnly = .T.
		    .Columns(11).ReadOnly = .T.
		    .Columns(12).ReadOnly = .T.
		    .Columns(13).ReadOnly = .F.
			.Columns(14).ReadOnly = .T.
			.Columns(14).Visible  = .T.
		
		    *-----------------------------------------------------
		    * Headers
		    *-----------------------------------------------------
		    .Columns(1).Header1.Caption  = "Item"
		    .Columns(2).Header1.Caption  = "Código"
		    .Columns(3).Header1.Caption  = "Descripción"
		    .Columns(4).Header1.Caption  = "Stock"
		    .Columns(5).Header1.Caption  = "Compras"
		    .Columns(6).Header1.Caption  = "Pedidos"
		    .Columns(7).Header1.Caption  = "Posición"
		    .Columns(8).Header1.Caption  = "Mínimo"
		    .Columns(9).Header1.Caption  = "Sugerido"
		    .Columns(10).Header1.Caption = "Proveedor"
		    .Columns(11).Header1.Caption = "Costo"
		    .Columns(12).Header1.Caption = "Mon"
		    .Columns(13).Header1.Caption = "X"
		    
		    
			.Columns(14).Header1.Caption   = "Obs"
			.Columns(14).Header1.BackColor = RGB(70,130,180)
			.Columns(14).Header1.ForeColor = RGB(255,255,255)
			.Columns(14).Header1.Alignment = 2
			.Columns(14).Header1.FontBold  = .T.
		
		    *-----------------------------------------------------
		    * Columna 10 — texto plano
		    *-----------------------------------------------------
		    IF PEMSTATUS(.Columns(10), "cmbProv", 5)
		        .Columns(10).RemoveObject("cmbProv")
		    ENDIF
		
		    IF PEMSTATUS(.Columns(10), "Text1", 5)
		        WITH .Columns(10).Text1
		            .Visible     = .T.
		            .BorderStyle = 0
		            .BackStyle   = 1
		            .Enabled     = .F.
		            .TabStop     = .F.
		        ENDWITH
		    ENDIF
		    
		    
		    *-- Columna 11: Costo – 4 decimales
			IF PEMSTATUS(.Columns(11), "Text1", 5)
			    .Columns(11).Text1.InputMask = "999999999999.9999"
			    .Columns(11).Text1.Alignment = 1
			ENDIF
		
		    
			*-----------------------------------------------------
			* Columna 13 — CheckBox selección
			*-----------------------------------------------------
			IF PEMSTATUS(.Columns(13), "chkSel", 5)
			    .Columns(13).RemoveObject("chkSel")
			ENDIF
		
			IF PEMSTATUS(.Columns(13), "Text1", 5)
			    .Columns(13).Text1.Visible = .F.
			ENDIF
		
			.Columns(13).AddObject("chkSel", "CheckBox")
			.Columns(13).CurrentControl = "chkSel"
			.Columns(13).Sparse         = .F.
		
			WITH .Columns(13).chkSel
			    .Caption   = ""
			    .BackStyle = 1
			    .BackColor = RGB(255,255,255)
			    .ForeColor = RGB(0,0,0)
			    .FontSize  = 8
			    .FontBold  = .F.
			    .Alignment = 0
			    .Width     = 50
			    .Height    = 18
			    .Visible   = .T.
			    .Enabled   = .F.
			ENDWITH
			* ==========================================================
			* CONFIGURACIÓN COLUMNA 14 - OBSERVACIÓN PRINCIPAL
			* (PEGAR DENTRO DE FormSet.ConfigurarGrid)
			* ==========================================================
			LOCAL loCol14, loFS
			loFS = THISFORMSET
			loCol14 = loFrm.grd_alerts.Columns(14)
		
			*-- Limpiar controles anteriores de la columna 14
			DO WHILE loCol14.ControlCount > 1
			    loCol14.RemoveObject(loCol14.Controls(2).Name)
			ENDDO
		
			*-- Propiedades base de la columna
			loCol14.ReadOnly  = .T.
			loCol14.Enabled   = .T.
			loCol14.Bound     = .F.
			loCol14.Sparse    = .F.
			loCol14.Width     = 40
			loCol14.BackColor = RGB(255,255,255)
			loCol14.ForeColor = RGB(255,255,255)
		
			IF PEMSTATUS(loCol14, "Text1", 5)
			    loCol14.Text1.Visible = .F.
			ENDIF
		
			*---------------------------------------------------------
			* Estado ON: hay observación
			*---------------------------------------------------------
			loCol14.AddObject("lblObsOn", "Label")
			WITH loCol14.lblObsOn
			    .Caption      = "Ver"
			    .Alignment    = 2
			    .FontBold     = .T.
			    .FontSize     = 8
			    .BackStyle    = 1
			    .BackColor    = RGB(0,0,0)
			    .ForeColor    = RGB(255,255,255)
			    .BorderStyle  = 0
			    .MousePointer = 15
			    .Visible      = .T.
			ENDWITH
		
			*---------------------------------------------------------
			* Estado OFF: sin observación
			*---------------------------------------------------------
			loCol14.AddObject("lblObsOff", "Label")
			WITH loCol14.lblObsOff
			    .Caption      = "-"
			    .Alignment    = 2
			    .FontBold     = .T.
			    .FontSize     = 10
			    .BackStyle    = 1
			    .BackColor    = RGB(0,0,0)
			    .ForeColor    = RGB(255,255,255)
			    .BorderStyle  = 0
			    .MousePointer = 15
			    .Visible      = .T.
			ENDWITH
		
			*---------------------------------------------------------
			* Bind seguro SOLO si el método existe en el FormSet
			*---------------------------------------------------------
			IF PEMSTATUS(loFS, "BtnObsArticuloClickPrincipal", 5)
			    TRY
			        UNBINDEVENTS(loCol14.lblObsOn)
			    CATCH
			    ENDTRY
			    TRY
			        UNBINDEVENTS(loCol14.lblObsOff)
			    CATCH
			    ENDTRY
		
				BINDEVENT(loCol14.lblObsOn, "Click", loFS, "BtnObsArticuloClickPrincipal")
			ENDIF
		
			loCol14.CurrentControl        = "lblObsOff"
			loCol14.DynamicCurrentControl = ;
			    "IIF(!EMPTY(ALLTRIM(NVL(cur_alerts.observacion,''))), 'lblObsOn', 'lblObsOff')"
			*-----------------------------------------------------
		    * Alineaciones
		    *-----------------------------------------------------
		    .Columns(1).Alignment  = 2
		    .Columns(2).Alignment  = 2
		    .Columns(3).Alignment  = 0
		    .Columns(4).Alignment  = 1
		    .Columns(5).Alignment  = 1
		    .Columns(6).Alignment  = 1
		    .Columns(7).Alignment  = 1
		    .Columns(8).Alignment  = 1
		    .Columns(9).Alignment  = 1
		    .Columns(10).Alignment = 0
		    .Columns(11).Alignment = 1
		    .Columns(12).Alignment = 2
		    .Columns(13).Alignment = 2
		    .Columns(14).Alignment = 2
		
		    *-----------------------------------------------------
		    * Apariencia base
		    *-----------------------------------------------------
		    FOR lnC = 1 TO 14
		        IF INLIST(lnC, 13, 14)
		            LOOP
		        ENDIF
		
		        IF PEMSTATUS(.Columns(lnC), "Text1", 5)
		            WITH .Columns(lnC).Text1
		                .BorderStyle = 0
		                .BackStyle   = 1
		                .Enabled     = .F.
		                .TabStop     = .F.
		
		                IF lnC = 9
		                    .FontBold = .T.
		                ELSE
		                    .FontBold = .F.
		                ENDIF
		            ENDWITH
		        ENDIF
		
		        .Columns(lnC).Sparse = .T.
		    NEXT
		
		    *-----------------------------------------------------
		    * Dynamic colors / size
		    *-----------------------------------------------------
		    lcSizeExpr = "IIF(RECNO('cur_alerts') = THISFORMSET.principal.xCurRec, 11, 9)"
		
		    FOR lnC = 1 TO 14
		        IF lnC = 13
		            LOOP
		        ENDIF
		
				IF lnC = 14
					.Columns(14).DynamicBackColor = "RGB(0,0,0)"         && <--- AHORA SÍ: FONDO NEGRO PURO
					.Columns(14).DynamicForeColor = "RGB(255,255,255)"   && <--- AHORA SÍ: LETRA BLANCA
					.Columns(14).DynamicFontBold  = ".T."                && (Opcional) .T. para que resalte más
					.Columns(14).DynamicFontSize  = lcSizeExpr
				    LOOP
				ENDIF
		
		        .Columns(lnC).DynamicBackColor = "THISFORMSET.DynBack_Alerta()"
		        .Columns(lnC).DynamicForeColor = "THISFORMSET.DynFore_Alerta()"
		        .Columns(lnC).DynamicFontSize  = lcSizeExpr
		
		        IF lnC = 9
		            .Columns(lnC).DynamicFontBold = ".T."
		        ELSE
		            .Columns(lnC).DynamicFontBold = ".F."
		        ENDIF
		        .Columns(lnC).DynamicFontBold = "NVL(cur_alerts.posicion, 0) < 0"
		
		    NEXT
		
			*-----------------------------------------------------
			* BINDEVENTS
			*-----------------------------------------------------
			TRY
			    UNBINDEVENTS(loFrm.grd_alerts)
			CATCH
			ENDTRY
		
			TRY
			    UNBINDEVENTS(loFrm.shpSelRow)
			CATCH
			ENDTRY
		
			BINDEVENT(loFrm.grd_alerts, "AfterRowColChange", THISFORMSET, "ActualizarEfectoGrid")
			BINDEVENT(loFrm.grd_alerts, "Scrolled",          THISFORMSET, "ActualizarEfectoGridScroll")
		
			BINDEVENT(loFrm.grd_alerts, "Click",             THISFORMSET, "GridClick")
			BINDEVENT(loFrm.grd_alerts, "DblClick",          THISFORMSET, "GridDblClick")
		
			BINDEVENT(loFrm.shpSelRow,  "Click",             THISFORMSET, "GridClick")
			BINDEVENT(loFrm.shpSelRow,  "DblClick",          THISFORMSET, "GridDblClick")
			BINDEVENT(loFrm.shpSelRow,  "RightClick",        loFrm.grd_alerts, "RightClick")
		*!*		TRY
		*!*		    UNBINDEVENT(loFrm.grd_alerts.Columns(14).cmdObsOn, "Click", THISFORMSET, "BtnObsArticuloClick")
		*!*		CATCH
		*!*		ENDTRY
		
		*!*		BINDEVENT(loFrm.grd_alerts.Columns(14).cmdObsOn, "Click", THISFORMSET, "BtnObsArticuloClick")
			*-----------------------------------------------------
		    * Posicionar cursor
		    *-----------------------------------------------------
		    SELECT cur_alerts
		    IF RECCOUNT("cur_alerts") > 0
		        GO TOP
		        loFrm.xCurRec = RECNO("cur_alerts")
		        loFrm.xCurArt = IIF(TYPE("cur_alerts.art_codi") = "N", cur_alerts.art_codi, 0)
		    ELSE
		        loFrm.xCurRec = 0
		        loFrm.xCurArt = 0
		    ENDIF
		
		    .Visible = .T.
		    .Refresh()
		
		    IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		        THISFORMSET.ActualizarEfectoGrid(0)
		    ENDIF
		ENDWITH
		
		IF PEMSTATUS(THISFORMSET, "ActualizarVisibilidadColumnaObservacion", 5)
		    THISFORMSET.ActualizarVisibilidadColumnaObservacion()
		ENDIF
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE configurargriddetalle
		*=========================================================
		* FormSet.ConfigurarGridDetalle
		* Crea/configura secundario.grid2
		*
		* Columnas:
		*  1 Item
		*  2 Código
		*  3 Descripción
		*  4 Proveedor
		*  5 Costo
		*  6 Moneda
		*  7 Cantidad
		*  8 Transporte
		*  9 Obs - CommandButton solo lectura, abre cuaterno si tiene observación
		*=========================================================
		LPARAMETERS tlForzar
		LOCAL lnRecDet, lnTranCodi, lcTranNomb
		LOCAL loConsulta, loGrid
		LOCAL lnC, loCol
		LOCAL loColTran, loColObs
		
		IF VARTYPE(tlForzar) <> "L"
		    tlForzar = .F.
		ENDIF
		
		loConsulta = .NULL.
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		IF VARTYPE(loConsulta) <> "O" OR !PEMSTATUS(loConsulta, "grid2", 5)
		    RETURN .F.
		ENDIF
		
		loGrid = loConsulta.grid2
		
		*---------------------------------------------------------
		* Propiedad de control interno
		*---------------------------------------------------------
		IF !PEMSTATUS(loGrid, "xGrid2Configurado", 5)
		    loGrid.AddProperty("xGrid2Configurado", .F.)
		ENDIF
		
		*---------------------------------------------------------
		* Asegurar cursor detalle
		*---------------------------------------------------------
		IF !USED("cur_soli_det")
		    CREATE CURSOR cur_soli_det ( ;
		        ui_item      C(8),    ;
		        art_codi     I,       ;
		        art_desc     C(80),   ;
		        prov_codi    I,       ;
		        det_prov     C(80),   ;
		        det_moneda   C(3),    ;
		        artpro_costo N(15,4), ;
		        artpro_codi  I,       ;
		        cant_soli    N(15,3), ;
		        observacion  M,       ;
		        tran_codi    I,       ;
		        tran_nomb    C(50) )
		ENDIF
		
		*---------------------------------------------------------
		* Asegurar transportes para combo
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "CargarTransportesCombo", 5)
		    THISFORMSET.CargarTransportesCombo()
		ENDIF
		
		IF !USED("cur_transportes")
		    CREATE CURSOR cur_transportes ( ;
		        tran_nomb C(80), ;
		        tran_codi I )
		
		    INSERT INTO cur_transportes (tran_nomb, tran_codi) ;
		    VALUES ("", 0)
		ELSE
		    SELECT cur_transportes
		    LOCATE FOR NVL(tran_codi, 0) = 0
		
		    IF !FOUND()
		        INSERT INTO cur_transportes (tran_nomb, tran_codi) ;
		        VALUES ("", 0)
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* Reordenar transportes: opción vacía primero
		* No usar SELECT SQL acá para evitar problemas con ""
		*---------------------------------------------------------
		IF USED("cur_transportes_tmp")
		    USE IN cur_transportes_tmp
		ENDIF
		
		CREATE CURSOR cur_transportes_tmp ( ;
		    tran_nomb C(80), ;
		    tran_codi I )
		
		INSERT INTO cur_transportes_tmp (tran_nomb, tran_codi) ;
		VALUES ("", 0)
		
		IF USED("cur_transportes")
		    SELECT cur_transportes
		    GO TOP
		
		    SCAN
		        IF NVL(cur_transportes.tran_codi, 0) > 0
		            INSERT INTO cur_transportes_tmp (tran_nomb, tran_codi) ;
		            VALUES ( ;
		                ALLTRIM(NVL(cur_transportes.tran_nomb, "")), ;
		                INT(NVL(cur_transportes.tran_codi, 0)) ;
		            )
		        ENDIF
		    ENDSCAN
		ENDIF
		
		IF USED("cur_transportes")
		    USE IN cur_transportes
		ENDIF
		
		CREATE CURSOR cur_transportes ( ;
		    tran_nomb C(80), ;
		    tran_codi I )
		
		SELECT cur_transportes_tmp
		GO TOP
		
		SCAN
		    INSERT INTO cur_transportes (tran_nomb, tran_codi) ;
		    VALUES ( ;
		        ALLTRIM(NVL(cur_transportes_tmp.tran_nomb, "")), ;
		        INT(NVL(cur_transportes_tmp.tran_codi, 0)) ;
		    )
		ENDSCAN
		
		IF USED("cur_transportes_tmp")
		    USE IN cur_transportes_tmp
		ENDIF
		
		IF USED("cur_soli_det") AND USED("cur_transportes") AND RECCOUNT("cur_soli_det") > 0
		    lnRecDet = IIF(EOF("cur_soli_det") OR BOF("cur_soli_det"), 0, RECNO("cur_soli_det"))
		
		    SELECT cur_soli_det
		    GO TOP
		
		    SCAN FOR NVL(tran_codi, 0) > 0
		        lnTranCodi = INT(NVL(cur_soli_det.tran_codi, 0))
		        lcTranNomb = ""
		
		        SELECT cur_transportes
		        LOCATE FOR INT(NVL(tran_codi, 0)) = m.lnTranCodi
		
		        IF FOUND()
		            lcTranNomb = ALLTRIM(NVL(cur_transportes.tran_nomb, ""))
		        ENDIF
		
		        SELECT cur_soli_det
		
		        IF !EMPTY(lcTranNomb)
		            REPLACE tran_nomb WITH m.lcTranNomb IN cur_soli_det
		        ENDIF
		    ENDSCAN
		
		    IF lnRecDet > 0 AND lnRecDet <= RECCOUNT("cur_soli_det")
		        GO lnRecDet IN cur_soli_det
		    ELSE
		        GO TOP IN cur_soli_det
		    ENDIF
		ENDIF
		
		TRY
		    loConsulta.LockScreen = .T.
		CATCH
		ENDTRY
		
		IF USED("cur_soli_det") AND RECCOUNT("cur_soli_det") > 0
		    SELECT cur_soli_det
		    GO TOP
		ENDIF
		
		WITH loGrid
		
			*-----------------------------------------------------
			* Reset DURO de columnas
			* Evita columnas huérfanas tipo Header1
			*-----------------------------------------------------
			.Visible = .F.
			.RecordSource = ""
		
			TRY
			    .ColumnCount = 0
			CATCH
			ENDTRY
		
			.ColumnCount  = 9
			.RecordSource = "cur_soli_det"
		
		    *-----------------------------------------------------
		    * Estilo general
		    *-----------------------------------------------------
		    .BackColor          = RGB(40,44,52)
		    .ForeColor          = RGB(255,255,255)
		    .GridLineColor      = RGB(60,65,75)
		    .AllowCellSelection = .T.
		    .ReadOnly           = .F.
		    .Themes             = .F.
		    .DeleteMark         = .F.
		    .RecordMark         = .F.
		    .ScrollBars         = 2
		
		    .HighlightStyle     = 2
		    .HighlightBackColor = RGB(40,44,52)
		    .HighlightForeColor = RGB(255,255,255)
		
		    *-----------------------------------------------------
		    * ControlSource
		    * Orden visual:
		    * 5 Costo / 6 Moneda / 7 Cantidad solicitada
		    *-----------------------------------------------------
		    .Columns(1).ControlSource = "cur_soli_det.ui_item"
		    .Columns(2).ControlSource = "cur_soli_det.art_codi"
		    .Columns(3).ControlSource = "cur_soli_det.art_desc"
		    .Columns(4).ControlSource = "cur_soli_det.det_prov"
		    .Columns(5).ControlSource = "cur_soli_det.artpro_costo"
		    .Columns(6).ControlSource = "cur_soli_det.det_moneda"
		    .Columns(7).ControlSource = "cur_soli_det.cant_soli"
		    .Columns(8).ControlSource = "cur_soli_det.tran_nomb"
		    .Columns(9).ControlSource = "cur_soli_det.observacion"
		
		    *-----------------------------------------------------
		    * Headers
		    *-----------------------------------------------------
		    .Columns(1).Header1.Caption = "Item"
		    .Columns(2).Header1.Caption = "Código"
		    .Columns(3).Header1.Caption = "Descripción"
		    .Columns(4).Header1.Caption = "Proveedor"
		    .Columns(5).Header1.Caption = "Costo"
		    .Columns(6).Header1.Caption = "Mon"
		    .Columns(7).Header1.Caption = "Cantidad"
		    .Columns(8).Header1.Caption = "Transporte"
		    .Columns(9).Header1.Caption = "Obs"
		
		    *-----------------------------------------------------
		    * Configuración común de columnas
		    *-----------------------------------------------------
		    FOR lnC = 1 TO 9
		
		        loCol = .Columns(lnC)
		
		        loCol.Header1.BackColor = RGB(70,130,180)
		        loCol.Header1.ForeColor = RGB(255,255,255)
		        loCol.Header1.FontBold  = .T.
		        loCol.Header1.Alignment = 2
		
		        DO CASE
		        CASE lnC = 1
		            loCol.Width = 35
		
		        CASE lnC = 2
		            loCol.Width = 70
		
		        CASE lnC = 3
		            loCol.Width = 300
		
		        CASE lnC = 4
		            loCol.Width = 150
		
		        CASE lnC = 5
		            loCol.Width = 85
		
		        CASE lnC = 6
		            loCol.Width = 40
		
		        CASE lnC = 7
		            loCol.Width = 85
		
				CASE lnC = 8
				    loCol.Width = 165
		
				CASE lnC = 9
				    loCol.Width = 70
		        ENDCASE
		
		        *-- Solo transporte y observación tienen interacción visual
		        loCol.ReadOnly = IIF(INLIST(lnC, 8, 9), .F., .T.)
		
		        loCol.DynamicBackColor = "RGB(40,44,52)"
		        loCol.DynamicForeColor = "RGB(255,255,255)"
		        loCol.DynamicFontBold  = ".F."
		
		        IF PEMSTATUS(loCol, "Text1", 5)
		            WITH loCol.Text1
		                .BackColor          = RGB(40,44,52)
		                .ForeColor          = RGB(255,255,255)
		                .SelectedBackColor  = RGB(40,44,52)
		                .SelectedForeColor  = RGB(255,255,255)
		                .DisabledBackColor  = RGB(40,44,52)
		                .DisabledForeColor  = RGB(255,255,255)
		                .BorderStyle        = 0
		                .ReadOnly           = .T.
		                .MousePointer       = 1
		                .Alignment          = IIF(INLIST(lnC, 1, 2, 5, 7), 1, IIF(lnC = 6, 2, 0))
		
		                IF INLIST(lnC, 1, 2, 3, 4, 5, 6, 7)
		                    .Enabled = .F.
		                ELSE
		                    .Enabled = .T.
		                ENDIF
		                
		                IF lnC = 5
						    .InputMask = "999999999999.9999"
						    .Alignment = 1
						ENDIF
		
		                
		                
		            ENDWITH
		        ENDIF
		
		    NEXT lnC
		
		    *=====================================================
		    * COLUMNA 8: TRANSPORTE
		    *=====================================================
		    loColTran = .Columns(8)
		
		    loColTran.ControlSource = "cur_soli_det.tran_nomb"
		    loColTran.Width         = 165
		    loColTran.ReadOnly      = .F.
			loColTran.Sparse        = .F.
		
		    loColTran.DynamicBackColor = "RGB(40,44,52)"
		    loColTran.DynamicForeColor = "RGB(255,255,255)"
		
		    *-- Limpiar controles extra, dejando Text1 base
		    DO WHILE loColTran.ControlCount > 1
		        loColTran.RemoveObject(loColTran.Controls(2).Name)
		    ENDDO
		
		    IF PEMSTATUS(loColTran, "Text1", 5)
		        WITH loColTran.Text1
		            .BackColor          = RGB(40,44,52)
		            .ForeColor          = RGB(255,255,255)
		            .SelectedBackColor  = RGB(40,44,52)
		            .SelectedForeColor  = RGB(255,255,255)
		            .DisabledBackColor  = RGB(40,44,52)
		            .DisabledForeColor  = RGB(255,255,255)
		            .BorderStyle        = 0
		            .ReadOnly           = .T.
		            .Enabled            = .T.
		            .MousePointer       = 1
		        ENDWITH
		    ENDIF
		
		    loColTran.AddObject("cboTransporte", "ComboBox")
		
		    WITH loColTran.cboTransporte
		
		        .RowSource     = ""
		        .RowSourceType = 0
		
		        .ColumnCount   = 2
		        .ColumnWidths  = "175,0"
				.BoundColumn   = 1
				.BoundTo       = .F.
				.Style         = 2
		        .Enabled       = .T.
		        .Visible       = .T.
		
		        .BackColor          = RGB(40,44,52)
		        .ForeColor          = RGB(255,255,255)
		        .SelectedBackColor  = RGB(70,130,180)
		        .SelectedForeColor  = RGB(255,255,255)
		        .DisabledBackColor  = RGB(40,44,52)
		        .DisabledForeColor  = RGB(255,255,255)
		        .BorderStyle        = 0
		        .MousePointer       = 1
		
		        .Clear
		
		        IF USED("cur_transportes")
		            SELECT cur_transportes
		            GO TOP
		
		            SCAN
		                IF NVL(cur_transportes.tran_codi, 0) <= 0
		                    .AddItem(CHR(160))
		                    .List(.ListCount, 2) = "0"
		                ELSE
		                    .AddItem(ALLTRIM(NVL(cur_transportes.tran_nomb, "")))
		                    .List(.ListCount, 2) = TRANSFORM(NVL(cur_transportes.tran_codi, 0))
		                ENDIF
		
		                SELECT cur_transportes
		            ENDSCAN
		        ENDIF
		
		        IF .ListCount = 0
		            .AddItem(CHR(160))
		            .List(.ListCount, 2) = "0"
		        ENDIF
		
		    ENDWITH
		
		    loColTran.CurrentControl = "cboTransporte"
			loColTran.DynamicCurrentControl = "'cboTransporte'"
		
		    TRY
		        UNBINDEVENTS(loColTran.cboTransporte)
		    CATCH
		    ENDTRY
		
		    IF PEMSTATUS(THISFORMSET, "RefrescarGridTransporte", 5)
		        BINDEVENT(loColTran.cboTransporte, "InteractiveChange", ;
		            THISFORMSET, "RefrescarGridTransporte")
		
		        BINDEVENT(loColTran.cboTransporte, "Valid", ;
		            THISFORMSET, "RefrescarGridTransporte")
		    ENDIF
		
			*=====================================================
			* COLUMNA 9: OBSERVACIÓN CON COMMANDBUTTON
			*=====================================================
			loColObs = .Columns(9)
		
			loColObs.ControlSource = "cur_soli_det.observacion"
			loColObs.Width         = 70
			loColObs.ReadOnly      = .F.
			loColObs.Sparse        = .F.
		
			loColObs.DynamicBackColor = "RGB(40,44,52)"
			loColObs.DynamicForeColor = "RGB(255,255,255)"
		
			*-- Limpiar controles extra, dejando Text1 base
			DO WHILE loColObs.ControlCount > 1
			    loColObs.RemoveObject(loColObs.Controls(2).Name)
			ENDDO
		
			IF PEMSTATUS(loColObs, "Text1", 5)
			    WITH loColObs.Text1
			        .BackColor          = RGB(40,44,52)
			        .ForeColor          = RGB(255,255,255)
			        .SelectedBackColor  = RGB(40,44,52)
			        .SelectedForeColor  = RGB(255,255,255)
			        .DisabledBackColor  = RGB(40,44,52)
			        .DisabledForeColor  = RGB(255,255,255)
			        .BorderStyle        = 0
			        .ReadOnly           = .T.
			        .Enabled            = .F.
			        .Visible            = .F.
			    ENDWITH
			ENDIF
		
			*-----------------------------------------------------
			* cmdObsOn:
			* - Botón real
			* - Solo aparece cuando hay observación
			* - Abre cuaterno en modo lectura
			*-----------------------------------------------------
			loColObs.AddObject("cmdObsOn", "CommandButton")
		
			WITH loColObs.cmdObsOn
			    .Caption       = "Ver"
			    .Visible       = .T.
			    .Enabled       = .T.
			    .FontBold      = .T.
			    .FontSize      = 7
			    .BackColor     = RGB(70,130,180)
			    .ForeColor     = RGB(255,255,255)
			    .SpecialEffect = 1
			    .Style         = 0
			    .TabStop       = .F.
			    .Default       = .F.
			    .Cancel        = .F.
			    .MousePointer  = 15
			    .Width         = 68
			ENDWITH
		
			TRY
			    UNBINDEVENTS(loColObs.cmdObsOn)
			CATCH
			ENDTRY
		
			IF PEMSTATUS(THISFORMSET, "BtnObsArticuloClick", 5)
			    BINDEVENT(loColObs.cmdObsOn, "Click", ;
			        THISFORMSET, "BtnObsArticuloClick")
			ENDIF
		
			*-----------------------------------------------------
			* cmdObsOff:
			* - Botón decorativo/deshabilitado
			* - Aparece cuando NO hay observación
			* - No abre nada
			*-----------------------------------------------------
			loColObs.AddObject("cmdObsOff", "CommandButton")
		
			WITH loColObs.cmdObsOff
			    .Caption       = "-"
			    .Visible       = .T.
			    .Enabled       = .F.
			    .FontBold      = .T.
			    .FontSize      = 7
			    .BackColor     = RGB(40,44,52)
			    .ForeColor     = RGB(180,180,180)
			    .DisabledBackColor = RGB(40,44,52)
			    .DisabledForeColor = RGB(120,120,120)
			    .SpecialEffect = 1
			    .Style         = 0
			    .TabStop       = .F.
			    .Default       = .F.
			    .Cancel        = .F.
			    .MousePointer  = 1
			    .Width         = 68
			ENDWITH
		
			*-----------------------------------------------------
			* txtFantasma:
			* - Fallback seguro
			* - No debe editar nada
			*-----------------------------------------------------
			loColObs.AddObject("txtFantasma", "TextBox")
		
			WITH loColObs.txtFantasma
			    .BackColor          = RGB(40,44,52)
			    .ForeColor          = RGB(255,255,255)
			    .SelectedBackColor  = RGB(40,44,52)
			    .SelectedForeColor  = RGB(255,255,255)
			    .DisabledBackColor  = RGB(40,44,52)
			    .DisabledForeColor  = RGB(255,255,255)
			    .BorderStyle        = 0
			    .Visible            = .T.
			    .Enabled            = .F.
			    .ReadOnly           = .T.
			ENDWITH
		
			loColObs.CurrentControl = "cmdObsOn"
			loColObs.DynamicCurrentControl = ;
			    "IIF(!EMPTY(ALLTRIM(NVL(cur_soli_det.observacion,''))), 'cmdObsOn', 'cmdObsOff')"
			
			loColObs.DynamicBackColor = "RGB(40,44,52)"
			loColObs.DynamicForeColor = "RGB(255,255,255)"
		    
			.ColumnCount = 9
		    .Visible = .T.
		    .Refresh()
		
		ENDWITH
		
		TRY
		    loConsulta.LockScreen = .F.
		CATCH
		ENDTRY
		
		loGrid.xGrid2Configurado = .T.
		
		RETURN .T.
	ENDPROC

	PROCEDURE configurargridsolicitudes
		*=========================================================
		* FormSet.ConfigurarGridSolicitudes
		* Configura secundario.grid1 sin perder formato
		*=========================================================
		LOCAL loConsulta, loGrid, lnC
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN .F.
		ENDIF
		
		loConsulta = THISFORMSET.secundario
		
		IF VARTYPE(loConsulta) <> "O" OR !PEMSTATUS(loConsulta, "grid1", 5)
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_soli_hist")
		    CREATE CURSOR cur_soli_hist ( ;
		        soli_codi      I, ;
		        soli_fecha     D, ;
		        soli_fecha_txt C(10), ;
		        estado         C(20), ;
		        observaciones  M, ;
		        cant_items     I, ;
		        cant_total     N(15,3) )
		ENDIF
		
		loGrid = loConsulta.grid1
		
		WITH loGrid
		    .Visible = .F.
		
		    .RecordSource     = ""
		    .RecordSourceType = 1
		    .ColumnCount      = 2
		    .RecordSource     = "cur_soli_hist"
		
		    .AllowCellSelection = .F.
		    .DeleteMark         = .F.
		    .RecordMark         = .F.
		    .Themes             = .F.
		    .GridLines          = 0
		    .ScrollBars         = 2
		    .HighlightStyle     = 2
		    .HighlightBackColor = RGB(70,130,180)
		    .HighlightForeColor = RGB(255,255,255)
		    .BackColor          = RGB(40,44,52)
		    .ForeColor          = RGB(220,220,220)
		
		    .Columns(1).ControlSource = "cur_soli_hist.soli_codi"
		    .Columns(2).ControlSource = "cur_soli_hist.soli_fecha_txt"
		
		    .Columns(1).Header1.Caption = "N° Solic."
		    .Columns(2).Header1.Caption = "Fecha"
		
		    .Columns(1).Width = 49
		    .Columns(2).Width = 85
		
		    FOR lnC = 1 TO 2
		        WITH .Columns(lnC)
		            .Alignment = 2
		            .BackColor = RGB(40,44,52)
		            .ForeColor = RGB(220,220,220)
		            .ReadOnly  = .T.
		
		            .DynamicBackColor = "RGB(40,44,52)"
		            .DynamicForeColor = "RGB(220,220,220)"
		
		            WITH .Header1
		                .Alignment = 2
		                .BackColor = RGB(70,130,180)
		                .ForeColor = RGB(255,255,255)
		                .FontBold  = .T.
		            ENDWITH
		
		            IF PEMSTATUS(.Text1, "Name", 5)
		                WITH .Text1
		                    .Alignment = 2
		                    .BackColor = RGB(40,44,52)
		                    .ForeColor = RGB(220,220,220)
		                    .BorderStyle = 0
		                    .Margin = 0
		                    .ReadOnly = .T.
		                    .Format = ""
		                    .InputMask = ""
		                ENDWITH
		            ENDIF
		        ENDWITH
		    NEXT
		
		    .Visible = .T.
		    .Refresh()
		ENDWITH
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE configurargridtercompras
		*=========================================================
		* FormSet.ConfigurarGridTerCompras
		*=========================================================
		LOCAL loTer, loGrid
		
		IF !PEMSTATUS(THISFORMSET, "terciario", 5)
		    RETURN .F.
		ENDIF
		
		loTer = THISFORMSET.terciario
		IF VARTYPE(loTer) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loTer, "grd_ter_compras", 5)
		    RETURN .F.
		ENDIF
		
		loGrid = loTer.grd_ter_compras
		IF VARTYPE(loGrid) <> "O"
		    RETURN .F.
		ENDIF
		
		WITH loGrid
		    .Visible            = .F.
		    .RecordSourceType   = 1
		    .RecordSource       = "cur_ter_compras"
		    .DeleteMark         = .F.
		    .RecordMark         = .F.
		    .AllowCellSelection = .F.
		    .ReadOnly           = .T.
		    .Themes             = .F.
		
		    IF .ColumnCount >= 1
		        .Columns(1).ControlSource = "cur_ter_compras.nro_item"
		*!*	        .Columns(1).Header1.Caption = "#"
		    ENDIF
		    IF .ColumnCount >= 2
		        .Columns(2).ControlSource = "cur_ter_compras.fecha"
		*!*	        .Columns(2).Header1.Caption = "Fecha"
		    ENDIF
		    IF .ColumnCount >= 3
		        .Columns(3).ControlSource = "cur_ter_compras.comprobante"
		*!*			.Columns(3).Header1.Caption = "N° Recep"
		    ENDIF
		    IF .ColumnCount >= 4
		        .Columns(4).ControlSource = "cur_ter_compras.cantidad"
		*!*	        .Columns(4).Header1.Caption = "Cantidad"
		    ENDIF
		    IF .ColumnCount >= 5
		        .Columns(5).ControlSource = "cur_ter_compras.prov_nomb"
		*!*	        .Columns(5).Header1.Caption = "Proveedor"
		    ENDIF
		
		    .Refresh()
		    .Visible = .T.
		ENDWITH
		
		RETURN .T.
	ENDPROC

	PROCEDURE configurargridterventas
		*=========================================================
		* FormSet.ConfigurarGridTerVentas
		*=========================================================
		LOCAL loTer, loGrid
		
		IF !PEMSTATUS(THISFORMSET, "terciario", 5)
		    RETURN .F.
		ENDIF
		
		loTer = THISFORMSET.terciario
		IF VARTYPE(loTer) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loTer, "grd_ter_ventas", 5)
		    RETURN .F.
		ENDIF
		
		loGrid = loTer.grd_ter_ventas
		IF VARTYPE(loGrid) <> "O"
		    RETURN .F.
		ENDIF
		
		WITH loGrid
		    .Visible            = .F.
		    .RecordSourceType   = 1
		    .RecordSource       = "cur_ter_ventas"
		    .DeleteMark         = .F.
		    .RecordMark         = .F.
		    .AllowCellSelection = .F.
		    .ReadOnly           = .T.
		    .Themes             = .F.
		
		    IF .ColumnCount >= 1
		        .Columns(1).ControlSource = "cur_ter_ventas.nro_item"
		*!*	        .Columns(1).Header1.Caption = "#"
		    ENDIF
		    IF .ColumnCount >= 2
		        .Columns(2).ControlSource = "cur_ter_ventas.fecha"
		*!*	        .Columns(2).Header1.Caption = "Fecha"
		    ENDIF
		    IF .ColumnCount >= 3
		        .Columns(3).ControlSource = "cur_ter_ventas.comprobante"
		*!*	        .Columns(3).Header1.Caption = "N° Rem"
		    ENDIF
		    IF .ColumnCount >= 4
		        .Columns(4).ControlSource = "cur_ter_ventas.cantidad"
		*!*	        .Columns(4).Header1.Caption = "Cantidad"
		    ENDIF
		    IF .ColumnCount >= 5
		        .Columns(5).ControlSource = "cur_ter_ventas.cli_nomb"
		*!*	        .Columns(5).Header1.Caption = "Cliente"
		    ENDIF
		
		    .Refresh()
		    .Visible = .T.
		ENDWITH
		
		RETURN .T.
	ENDPROC

	PROCEDURE configurargridventacompra
		*=========================================================
		* FormSet.ConfigurarGridVentaCompra
		*=========================================================
		LOCAL loFrm, loConsulta
		LOCAL loGrid, lnTotalW, lnC
		
		loFrm      = THISFORMSET.principal
		loConsulta = THISFORMSET.secundario
		
		IF !PEMSTATUS(loFrm, "grd_venta_compra", 5)
		    RETURN .F.
		ENDIF
		
		loGrid = loFrm.grd_venta_compra
		
		IF !USED("cur_vc_months")
		    CREATE CURSOR cur_vc_months ( ;
		        mes     C(7),    ;
		        compras N(15,3), ;
		        ventas  N(15,3) )
		ENDIF
		
		IF !PEMSTATUS(loFrm, "xCurRecVC", 5)
		    loFrm.AddProperty("xCurRecVC", 0)
		ENDIF
		
		WITH loGrid
		    .Visible            = .F.
		    .RecordSource       = ""
		    .RecordSourceType   = 1
		    .RecordSource       = "cur_vc_months"
		    .ColumnCount        = 3
		    .Themes             = .F.
		    .GridLines          = 0
		    .RowHeight          = 17
		    .FontSize           = 8
		    .DeleteMark         = .F.
		    .RecordMark         = .F.
		    .AllowCellSelection = .F.
		
		    .BackColor          = RGB(40, 44, 52)
		    .ForeColor          = RGB(220, 220, 220)
		    .HighlightBackColor = RGB(70, 130, 180)
		    .HighlightForeColor = RGB(255, 255, 255)
		    .HighlightStyle     = 2
		
		    lnTotalW = MAX(120, .Width - 25)
		    .Columns(1).Width = INT(lnTotalW * 0.30)
		    .Columns(2).Width = INT(lnTotalW * 0.35)
		    .Columns(3).Width = lnTotalW - .Columns(1).Width - .Columns(2).Width
		
		    .Columns(1).ControlSource = "cur_vc_months.mes"
		    .Columns(2).ControlSource = "cur_vc_months.compras"
		    .Columns(3).ControlSource = "cur_vc_months.ventas"
		
		    .Columns(1).ReadOnly = .T.
		    .Columns(2).ReadOnly = .T.
		    .Columns(3).ReadOnly = .T.
		
		    .Columns(1).Alignment = 2
		    .Columns(2).Alignment = 1
		    .Columns(3).Alignment = 1
		
		    FOR lnC = 1 TO 3
		        .Columns(lnC).BackColor = RGB(40, 44, 52)
		        .Columns(lnC).ForeColor = RGB(220, 220, 220)
		        .Columns(lnC).FontSize  = 8
		
		        .Columns(lnC).DynamicBackColor = "RGB(40,44,52)"
		        .Columns(lnC).DynamicForeColor = "RGB(220,220,220)"
		        .Columns(lnC).DynamicFontSize  = ;
		            "IIF(RECNO('cur_vc_months')=THISFORMSET.principal.xCurRecVC,9,8)"
		
		        WITH .Columns(lnC).Header1
		            .BackColor = RGB(70, 130, 180)
		            .ForeColor = RGB(255, 255, 255)
		            .Alignment = 2
		            .FontSize  = 8
		        ENDWITH
		
		        IF PEMSTATUS(.Columns(lnC), "Text1", 5)
		            WITH .Columns(lnC).Text1
		                .BorderStyle = 0
		                .Margin      = 0
		                .BackColor   = RGB(40, 44, 52)
		                .ForeColor   = RGB(220, 220, 220)
		                .FontSize    = 8
		            ENDWITH
		        ENDIF
		    NEXT lnC
		
		    .Columns(1).Header1.Caption = "Mes/Año"
		    .Columns(2).Header1.Caption = "Compras"
		    .Columns(3).Header1.Caption = "Ventas"
		
		    TRY
		        UNBINDEVENTS(loGrid)
		    CATCH
		    ENDTRY
		
		*!*	    BINDEVENT(loGrid, "AfterRowColChange", THISFORMSET, "ActualizarEfectoGridVC")
		*!*	    BINDEVENT(loGrid, "Scrolled",          THISFORMSET, "ActualizarEfectoGridVC")
		*!*	    BINDEVENT(loGrid, "KeyPress",          THISFORMSET, "GrdVC_KeyPress")
		*!*	    BINDEVENT(loGrid, "DblClick",          THISFORMSET, "AbrirTerciarioDesdeGridVC")
		
		*!*	    IF loGrid.ColumnCount >= 3
		*!*	        IF PEMSTATUS(loGrid.Columns(1), "Text1", 5)
		*!*	            BINDEVENT(loGrid.Columns(1).Text1, "DblClick", THISFORMSET, "AbrirTerciarioDesdeGridVC")
		*!*	        ENDIF
		
		*!*	        IF PEMSTATUS(loGrid.Columns(2), "Text1", 5)
		*!*	            BINDEVENT(loGrid.Columns(2).Text1, "DblClick", THISFORMSET, "AbrirTerciarioDesdeGridVC")
		*!*	        ENDIF
		
		*!*	        IF PEMSTATUS(loGrid.Columns(3), "Text1", 5)
		*!*	            BINDEVENT(loGrid.Columns(3).Text1, "DblClick", THISFORMSET, "AbrirTerciarioDesdeGridVC")
		*!*	        ENDIF
		*!*	    ENDIF
		
		    .Visible = .T.
		    .Refresh()
		ENDWITH
		
		RETURN .T.
	ENDPROC

	PROCEDURE configurartextfechassecundario
		*=========================================================
		* FormSet.ConfigurarTextFechasSecundario
		*=========================================================
		LOCAL loConsulta
		
		loConsulta = THISFORMSET.secundario
		IF VARTYPE(loConsulta) <> "O"
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(loConsulta, "txt_fecdes_hist", 5)
		    WITH loConsulta.txt_fecdes_hist
		        TRY
		            .ControlSource = ""
		        CATCH
		        ENDTRY
		        TRY
		            .Value = loConsulta.xHistFecDes
		        CATCH
		        ENDTRY
		        .Refresh()
		    ENDWITH
		ENDIF
		
		IF PEMSTATUS(loConsulta, "txt_fechas_hist", 5)
		    WITH loConsulta.txt_fechas_hist
		        TRY
		            .ControlSource = ""
		        CATCH
		        ENDTRY
		        TRY
		            .Value = loConsulta.xHistFecHas
		        CATCH
		        ENDTRY
		        .Refresh()
		    ENDWITH
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE confirmarguardarobservacion
		*=========================================================
		* FormSet.ConfirmarGuardarObservacion
		*=========================================================
		LOCAL loSec, lnSoliCodi, lcNuevo, lcOriginal
		LOCAL llOk
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN .F.
		ENDIF
		
		loSec = THISFORMSET.secundario
		IF VARTYPE(loSec) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loSec, "xObsEditando", 5) OR !loSec.xObsEditando
		    RETURN .T.
		ENDIF
		
		IF !PEMSTATUS(loSec, "edit1", 5)
		    RETURN .F.
		ENDIF
		
		lnSoliCodi = IIF(PEMSTATUS(loSec, "xSoliCodiActual", 5), NVL(loSec.xSoliCodiActual, 0), 0)
		IF lnSoliCodi <= 0
		    loSec.xObsEditando    = .F.
		    loSec.edit1.ReadOnly  = .T.
		    loSec.edit1.BackColor = RGB(245,245,245)
		    RETURN .F.
		ENDIF
		
		lcNuevo    = IIF(VARTYPE(loSec.edit1.Value) $ "CM", ALLTRIM(loSec.edit1.Value), "")
		lcOriginal = IIF(PEMSTATUS(loSec, "xObsOriginal", 5), ALLTRIM(loSec.xObsOriginal), "")
		
		IF lcNuevo == lcOriginal
		    loSec.xObsEditando    = .F.
		    loSec.edit1.ReadOnly  = .T.
		    loSec.edit1.BackColor = RGB(245,245,245)
		    loSec.edit1.Refresh()
		    RETURN .T.
		ENDIF
		
		llOk = .F.
		IF PEMSTATUS(THISFORMSET, "GuardarObservacionSolicitud", 5)
		    llOk = THISFORMSET.GuardarObservacionSolicitud(lnSoliCodi, lcNuevo)
		ENDIF
		
		IF llOk
		    loSec.xObsOriginal    = lcNuevo
		    loSec.xObsEditando    = .F.
		    loSec.edit1.ReadOnly  = .T.
		    loSec.edit1.BackColor = RGB(245,245,245)
		    loSec.edit1.Refresh()
		    WAIT WINDOW "Observación guardada." TIMEOUT 1
		    RETURN .T.
		ELSE
		    MESSAGEBOX("No se pudo guardar la observación.", 16, "Error")
		    loSec.edit1.Value     = lcOriginal
		    loSec.xObsEditando    = .F.
		    loSec.edit1.ReadOnly  = .T.
		    loSec.edit1.BackColor = RGB(245,245,245)
		    loSec.edit1.Refresh()
		    RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE confirmarsolicituddefinitiva
		*=========================================================
		* FormSet.ConfirmarSolicitudDefinitiva
		* - Valida y decide el flujo
		* - Si el usuario quiere observación: abre cuaterno MODAL
		* - Si guarda: confirma con observación
		* - Si cancela cuaterno: confirma SIN observación
		* - Si no quiere observación: confirma directo
		*=========================================================
		LOCAL loFrm
		LOCAL lnConn, lnRet, lnResp
		LOCAL lnItemsTmp
		LOCAL llModoEdicion
		LOCAL lcObsDefault
		LOCAL lcObsFinal
		LOCAL llAbrioCuaterno
		
		loFrm = THISFORMSET.principal
		
		lnConn          = 0
		lnItemsTmp      = 0
		llModoEdicion   = .F.
		lcObsDefault    = ""
		lcObsFinal      = ""
		llAbrioCuaterno = .F.
		
		*---------------------------------------------------------
		* Asegurar propiedades de edición / flujo
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "xSoliEditando", 5)
		    THISFORMSET.AddProperty("xSoliEditando", 0)
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xObsEditando", 5)
		    THISFORMSET.AddProperty("xObsEditando", "")
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xConfirmacionPendiente", 5)
		    THISFORMSET.AddProperty("xConfirmacionPendiente", .F.)
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xObsCuaternoValor", 5)
		    THISFORMSET.AddProperty("xObsCuaternoValor", "")
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xObsCuaternoCancelado", 5)
		    THISFORMSET.AddProperty("xObsCuaternoCancelado", .T.)
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xObsCuaternoAbierto", 5)
		    THISFORMSET.AddProperty("xObsCuaternoAbierto", .F.)
		ENDIF
		
		THISFORMSET.xConfirmacionPendiente = .F.
		THISFORMSET.xObsCuaternoAbierto    = .F.
		THISFORMSET.xObsCuaternoValor      = ""
		THISFORMSET.xObsCuaternoCancelado  = .T.
		
		IF VARTYPE(THISFORMSET.xSoliEditando) = "N" AND THISFORMSET.xSoliEditando > 0
		    llModoEdicion = .T.
		ENDIF
		
		*---------------------------------------------------------
		* 1. VALIDACIÓN PREVIA
		*---------------------------------------------------------
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0
		    MESSAGEBOX("No hay artículos visibles en la grilla.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		lnRet = SQLEXEC(lnConn, ;
		    "SELECT COUNT(*) AS cant FROM temp_solicitud_compra", ;
		    "cur_tmp_chk")
		
		IF lnRet < 0 OR !USED("cur_tmp_chk")
		    Desconectar_DB(lnConn)
		    lnConn = 0
		
		    MESSAGEBOX("No se pudo validar la lista temporal de compra.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		SELECT cur_tmp_chk
		
		IF RECCOUNT("cur_tmp_chk") > 0
		    IF VARTYPE(cur_tmp_chk.cant) = "C"
		        lnItemsTmp = VAL(ALLTRIM(cur_tmp_chk.cant))
		    ELSE
		        lnItemsTmp = NVL(cur_tmp_chk.cant, 0)
		    ENDIF
		ELSE
		    lnItemsTmp = 0
		ENDIF
		
		USE IN cur_tmp_chk
		
		IF lnItemsTmp <= 0
		    Desconectar_DB(lnConn)
		    lnConn = 0
		
		    MESSAGEBOX("La lista temporal de compra está vacía. Debe seleccionar al menos un artículo.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 2. Confirmación principal
		*---------------------------------------------------------
		IF llModoEdicion
		    lnResp = MESSAGEBOX( ;
		        "¿Desea GUARDAR los cambios en la Solicitud N° " + ;
		        TRANSFORM(THISFORMSET.xSoliEditando) + "?" + CHR(13) + ;
		        "Se actualizará la misma solicitud, no se creará una nueva.", ;
		        36, ;
		        "Confirmar Modificación")
		ELSE
		    lnResp = MESSAGEBOX( ;
		        "¿Desea cerrar la lista actual y generar la Solicitud de Compra Definitiva?", ;
		        36, ;
		        "Confirmar")
		ENDIF
		
		IF lnResp <> 6
		    Desconectar_DB(lnConn)
		    lnConn = 0
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 3. Default robusto para observaciones
		*---------------------------------------------------------
		lcObsDefault = ""
		
		IF PEMSTATUS(THISFORMSET, "xObsEditando", 5)
		    DO CASE
		    CASE VARTYPE(THISFORMSET.xObsEditando) = "C"
		        lcObsDefault = ALLTRIM(NVL(THISFORMSET.xObsEditando, ""))
		
		    CASE VARTYPE(THISFORMSET.xObsEditando) = "M"
		        lcObsDefault = ALLTRIM(NVL(THISFORMSET.xObsEditando, ""))
		
		    OTHERWISE
		        lcObsDefault = ""
		    ENDCASE
		ENDIF
		
		*---------------------------------------------------------
		* 4. Preguntar si desea agregar observación
		*---------------------------------------------------------
		lnResp = MESSAGEBOX( ;
		    "¿Desea agregar una observación a la solicitud?", ;
		    36, ;
		    "Observaciones")
		
		* Ya no necesitamos esta conexión acá
		Desconectar_DB(lnConn)
		lnConn = 0
		
		
		*---------------------------------------------------------
		* 5. Si desea observación, abrir modal runtime aislado
		*---------------------------------------------------------
		IF lnResp = 6
		
		    *-----------------------------------------------------
		    * Abrir modal nuevo, NO usar cuaterno embebido viejo
		    *-----------------------------------------------------
		    IF PEMSTATUS(THISFORMSET, "AbrirModalObservacionAislado", 5)
		
		        CLEAR TYPEAHEAD
		
		        llAbrioCuaterno = THISFORMSET.AbrirModalObservacionAislado( ;
		            "OBS_SOLI", ;
		            "Observación de Solicitud", ;
		            "Ingrese una observación general para la solicitud de compra:", ;
		            lcObsDefault, ;
		            .F. )
		
		        CLEAR TYPEAHEAD
		
		        *-------------------------------------------------
		        * Si presionó Guardar, tomar texto y continuar
		        * Si presionó Cancelar/Cerrar, confirmar sin obs
		        *-------------------------------------------------
		        IF llAbrioCuaterno
		
		            IF PEMSTATUS(THISFORMSET, "xObsModalValor", 5)
		                lcObsFinal = ALLTRIM(NVL(THISFORMSET.xObsModalValor, ""))
		            ELSE
		                lcObsFinal = ""
		            ENDIF
		
		        ELSE
		            lcObsFinal = ""
		        ENDIF
		
		    ELSE
		        MESSAGEBOX("No existe el método AbrirModalObservacionAislado.", 16, "Error")
		        RETURN .F.
		    ENDIF
		
		ELSE
		    lcObsFinal = ""
		ENDIF
		*---------------------------------------------------------
		* 6. Ejecutar confirmación definitiva
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "EjecutarConfirmacionSolicitud", 5)
		    RETURN THISFORMSET.EjecutarConfirmacionSolicitud(lcObsFinal)
		ELSE
		    MESSAGEBOX("No existe el método EjecutarConfirmacionSolicitud.", 16, "Error")
		    RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE construircurtempdesdecurrawfull
		*=========================================================
		* FormSet.ConstruirCurTempDesdeCurRawFull
		* Construye cur_temp desde cur_raw_full para filtros locales
		* conservando estructura completa esperada por cur_alerts
		*
		* Regla de estado:
		* - Todos los filtros locales normales muestran SOLO activos
		*   => NVL(estado,1) = 1
		* - Las excepciones de INACTIVOS / TODOS se resuelven en
		*   AplicarFiltroDepuracion, no aquí.
		*=========================================================
		LPARAMETERS tcFiltro, tnRubCodi
		
		LOCAL lcCantSoli
		LOCAL lcProvCodiSel, lcProvNombSel, lcArtproCosto, lcArtproMoneda, lcProvLista
		LOCAL lcMesesCobProy, lcScore, lcEstado
		
		IF USED("cur_temp")
		    USE IN cur_temp
		ENDIF
		
		IF !USED("cur_raw_full")
		    RETURN .F.
		ENDIF
		
		IF VARTYPE(tcFiltro) <> "C"
		    tcFiltro = "TODOS"
		ENDIF
		tcFiltro = UPPER(ALLTRIM(tcFiltro))
		
		*---------------------------------------------------------
		* Blindaje de campos opcionales
		*---------------------------------------------------------
		lcCantSoli     = IIF(TYPE("cur_raw_full.cant_soli") = "U", ;
		                    "CAST(0 AS N(15,3))", ;
		                    "CAST(NVL(cur_raw_full.cant_soli,0) AS N(15,3))")
		
		lcMesesCobProy = IIF(TYPE("cur_raw_full.meses_cob_proy") = "U", ;
		                    "CAST(0 AS N(15,3))", ;
		                    "CAST(NVL(cur_raw_full.meses_cob_proy,0) AS N(15,3))")
		
		lcScore        = IIF(TYPE("cur_raw_full.score") = "U", ;
		                    "CAST(0 AS I)", ;
		                    "CAST(NVL(cur_raw_full.score,0) AS I)")
		
		lcEstado       = IIF(TYPE("cur_raw_full.estado") = "U", ;
		                    "CAST(1 AS I)", ;
		                    "CAST(NVL(cur_raw_full.estado,1) AS I)")
		
		lcProvCodiSel  = IIF(TYPE("cur_raw_full.prov_codi_sel") = "U", ;
		                    "CAST(0 AS I)", ;
		                    "CAST(NVL(cur_raw_full.prov_codi_sel,0) AS I)")
		
		lcProvNombSel  = IIF(TYPE("cur_raw_full.prov_nomb_sel") = "U", ;
		                    "CAST('' AS C(80))", ;
		                    "CAST(NVL(cur_raw_full.prov_nomb_sel,'') AS C(80))")
		
		lcArtproCosto  = IIF(TYPE("cur_raw_full.artpro_costo") = "U", ;
		                    "CAST(0 AS N(15,4))", ;
		                    "CAST(NVL(cur_raw_full.artpro_costo,0) AS N(15,4))")
		
		lcArtproMoneda = IIF(TYPE("cur_raw_full.artpro_moneda") = "U", ;
		                    "CAST('' AS C(1))", ;
		                    "CAST(NVL(cur_raw_full.artpro_moneda,'') AS C(1))")
		
		lcProvLista    = IIF(TYPE("cur_raw_full.prov_lista") = "U", ;
		                    "CAST('' AS M)", ;
		                    "CAST(NVL(cur_raw_full.prov_lista,'') AS M)")
		
		DO CASE
		
		CASE tcFiltro == "SUGERIDO > 0"
		    SELECT ;
		        art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		        pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		        ventas_metrics, promedio_venta, fecha_ult_venta, ;
		        compras_metrics, promedio_compra, fecha_ult_compra, ;
		        dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		        &lcCantSoli     AS cant_soli, ;
		        meses_cubiertos, &lcMesesCobProy AS meses_cob_proy, meses_cobert_solic, ;
		        &lcScore        AS score, ;
		        &lcEstado       AS estado, ;
		        rub_codi, rub_desc, ;
		        &lcProvCodiSel  AS prov_codi_sel, ;
		        &lcProvNombSel  AS prov_nomb_sel, ;
		        &lcArtproCosto  AS artpro_costo, ;
		        &lcArtproMoneda AS artpro_moneda, ;
		        &lcProvLista    AS prov_lista, ;
		        CAST('' AS C(8)) AS ui_item, ;
		        CAST(.F. AS L)   AS ui_sel ;
		    FROM cur_raw_full ;
		    WHERE NVL(estado,1) = 1 ;
		      AND NVL(sugerido_comprar,0) > 0.001 ;
		    ORDER BY sugerido_comprar DESC ;
		    INTO CURSOR cur_temp READWRITE
		
		*--- FIX: CASE con $ para evitar fallo por Í acentuada (CP1252) ---*
		*--- FIX WHERE: eliminados "posicion > 0" y "posicion >= art_stmin" ---*
		CASE ("POS.M" $ tcFiltro) AND ("ALERTA" $ tcFiltro)
		    SELECT ;
		        art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		        pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		        ventas_metrics, promedio_venta, fecha_ult_venta, ;
		        compras_metrics, promedio_compra, fecha_ult_compra, ;
		        dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		        &lcCantSoli     AS cant_soli, ;
		        meses_cubiertos, &lcMesesCobProy AS meses_cob_proy, meses_cobert_solic, ;
		        &lcScore        AS score, ;
		        &lcEstado       AS estado, ;
		        rub_codi, rub_desc, ;
		        &lcProvCodiSel  AS prov_codi_sel, ;
		        &lcProvNombSel  AS prov_nomb_sel, ;
		        &lcArtproCosto  AS artpro_costo, ;
		        &lcArtproMoneda AS artpro_moneda, ;
		        &lcProvLista    AS prov_lista, ;
		        CAST('' AS C(8)) AS ui_item, ;
		        CAST(.F. AS L)   AS ui_sel ;
		    FROM cur_raw_full ;
		    WHERE NVL(estado,1) = 1 ;
		      AND NVL(art_stmin,0) > 0 ;
			  AND NVL(art_pct_alerta,0) <> 0 ;
		      AND NVL(posicion,0) < (NVL(art_stmin,0) + (NVL(art_stmin,0) * NVL(art_pct_alerta,0) / 100)) ;
		    ORDER BY posicion ASC, sugerido_comprar DESC, art_desc ASC ;
		    INTO CURSOR cur_temp READWRITE
		
		CASE tcFiltro == "STOCK (-)"
		    SELECT ;
		        art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		        pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		        ventas_metrics, promedio_venta, fecha_ult_venta, ;
		        compras_metrics, promedio_compra, fecha_ult_compra, ;
		        dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		        &lcCantSoli     AS cant_soli, ;
		        meses_cubiertos, &lcMesesCobProy AS meses_cob_proy, meses_cobert_solic, ;
		        &lcScore        AS score, ;
		        &lcEstado       AS estado, ;
		        rub_codi, rub_desc, ;
		        &lcProvCodiSel  AS prov_codi_sel, ;
		        &lcProvNombSel  AS prov_nomb_sel, ;
		        &lcArtproCosto  AS artpro_costo, ;
		        &lcArtproMoneda AS artpro_moneda, ;
		        &lcProvLista    AS prov_lista, ;
		        CAST('' AS C(8)) AS ui_item, ;
		        CAST(.F. AS L)   AS ui_sel ;
		    FROM cur_raw_full ;
		    WHERE NVL(estado,1) = 1 ;
		      AND NVL(art_stock,0) < 0 ;
		    ORDER BY art_stock ASC ;
		    INTO CURSOR cur_temp READWRITE
		
		*--- FIX: CASE con $ para evitar fallo por Ó acentuada (CP1252) ---*
		CASE ("POSICI" $ tcFiltro) AND ("(-)" $ tcFiltro)
		    SELECT ;
		        art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		        pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		        ventas_metrics, promedio_venta, fecha_ult_venta, ;
		        compras_metrics, promedio_compra, fecha_ult_compra, ;
		        dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		        &lcCantSoli     AS cant_soli, ;
		        meses_cubiertos, &lcMesesCobProy AS meses_cob_proy, meses_cobert_solic, ;
		        &lcScore        AS score, ;
		        &lcEstado       AS estado, ;
		        rub_codi, rub_desc, ;
		        &lcProvCodiSel  AS prov_codi_sel, ;
		        &lcProvNombSel  AS prov_nomb_sel, ;
		        &lcArtproCosto  AS artpro_costo, ;
		        &lcArtproMoneda AS artpro_moneda, ;
		        &lcProvLista    AS prov_lista, ;
		        CAST('' AS C(8)) AS ui_item, ;
		        CAST(.F. AS L)   AS ui_sel ;
		    FROM cur_raw_full ;
		    WHERE NVL(estado,1) = 1 ;
		      AND NVL(posicion,0) < 0 ;
		    ORDER BY posicion ASC ;
		    INTO CURSOR cur_temp READWRITE
		
		*--- NUEVO: POSICIÓN < POSICIÓN MIN (sin alerta, sin negativo) ---*
		CASE ("POSICI" $ tcFiltro) AND ("MIN" $ tcFiltro) AND !("ALERTA" $ tcFiltro) AND !("(-)" $ tcFiltro)
		    SELECT ;
		        art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		        pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		        ventas_metrics, promedio_venta, fecha_ult_venta, ;
		        compras_metrics, promedio_compra, fecha_ult_compra, ;
		        dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		        &lcCantSoli     AS cant_soli, ;
		        meses_cubiertos, &lcMesesCobProy AS meses_cob_proy, meses_cobert_solic, ;
		        &lcScore        AS score, ;
		        &lcEstado       AS estado, ;
		        rub_codi, rub_desc, ;
		        &lcProvCodiSel  AS prov_codi_sel, ;
		        &lcProvNombSel  AS prov_nomb_sel, ;
		        &lcArtproCosto  AS artpro_costo, ;
		        &lcArtproMoneda AS artpro_moneda, ;
		        &lcProvLista    AS prov_lista, ;
		        CAST('' AS C(8)) AS ui_item, ;
		        CAST(.F. AS L)   AS ui_sel ;
		    FROM cur_raw_full ;
		    WHERE NVL(estado,1) = 1 ;
		      AND NVL(art_stmin,0) > 0 ;
		      AND NVL(posicion,0) < NVL(art_stmin,0) ;
		    ORDER BY posicion ASC, sugerido_comprar DESC, art_desc ASC ;
		    INTO CURSOR cur_temp READWRITE
		
		CASE tcFiltro == "COMPRA URGENTE"
		    SELECT ;
		        art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		        pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		        ventas_metrics, promedio_venta, fecha_ult_venta, ;
		        compras_metrics, promedio_compra, fecha_ult_compra, ;
		        dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		        &lcCantSoli     AS cant_soli, ;
		        meses_cubiertos, &lcMesesCobProy AS meses_cob_proy, meses_cobert_solic, ;
		        &lcScore        AS score, ;
		        &lcEstado       AS estado, ;
		        rub_codi, rub_desc, ;
		        &lcProvCodiSel  AS prov_codi_sel, ;
		        &lcProvNombSel  AS prov_nomb_sel, ;
		        &lcArtproCosto  AS artpro_costo, ;
		        &lcArtproMoneda AS artpro_moneda, ;
		        &lcProvLista    AS prov_lista, ;
		        CAST('' AS C(8)) AS ui_item, ;
		        CAST(.F. AS L)   AS ui_sel ;
		    FROM cur_raw_full ;
		    WHERE NVL(estado,1) = 1 ;
		      AND NVL(pedprov,0) = 0 ;
		      AND NVL(posicion,0) < NVL(art_stmin,0) ;
		    ORDER BY pct_rotacion DESC ;
		    INTO CURSOR cur_temp READWRITE
		
		CASE tcFiltro == "RUBROS"
		    IF VARTYPE(tnRubCodi) = "N" AND tnRubCodi > 0
		        SELECT ;
		            art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		            pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		            ventas_metrics, promedio_venta, fecha_ult_venta, ;
		            compras_metrics, promedio_compra, fecha_ult_compra, ;
		            dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		            &lcCantSoli     AS cant_soli, ;
		            meses_cubiertos, &lcMesesCobProy AS meses_cob_proy, meses_cobert_solic, ;
		            &lcScore        AS score, ;
		            &lcEstado       AS estado, ;
		            rub_codi, rub_desc, ;
		            &lcProvCodiSel  AS prov_codi_sel, ;
		            &lcProvNombSel  AS prov_nomb_sel, ;
		            &lcArtproCosto  AS artpro_costo, ;
		            &lcArtproMoneda AS artpro_moneda, ;
		            &lcProvLista    AS prov_lista, ;
		            CAST('' AS C(8)) AS ui_item, ;
		            CAST(.F. AS L)   AS ui_sel ;
		        FROM cur_raw_full ;
		        WHERE NVL(estado,1) = 1 ;
		          AND rub_codi = tnRubCodi ;
		        ORDER BY art_desc ;
		        INTO CURSOR cur_temp READWRITE
		    ELSE
		        SELECT ;
		            art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		            pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		            ventas_metrics, promedio_venta, fecha_ult_venta, ;
		            compras_metrics, promedio_compra, fecha_ult_compra, ;
		            dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		            &lcCantSoli     AS cant_soli, ;
		            meses_cubiertos, &lcMesesCobProy AS meses_cob_proy, meses_cobert_solic, ;
		            &lcScore        AS score, ;
		            &lcEstado       AS estado, ;
		            rub_codi, rub_desc, ;
		            &lcProvCodiSel  AS prov_codi_sel, ;
		            &lcProvNombSel  AS prov_nomb_sel, ;
		            &lcArtproCosto  AS artpro_costo, ;
		            &lcArtproMoneda AS artpro_moneda, ;
		            &lcProvLista    AS prov_lista, ;
		            CAST('' AS C(8)) AS ui_item, ;
		            CAST(.F. AS L)   AS ui_sel ;
		        FROM cur_raw_full ;
		        WHERE NVL(estado,1) = 1 ;
		        ORDER BY art_desc ;
		        INTO CURSOR cur_temp READWRITE
		    ENDIF
		
		OTHERWISE
		    SELECT ;
		        art_codi, art_desc, art_stock, art_stmin, art_pct_alerta, ;
		        pedidos, pedprov, posicion, sug_neto, pct_rotacion, ;
		        ventas_metrics, promedio_venta, fecha_ult_venta, ;
		        compras_metrics, promedio_compra, fecha_ult_compra, ;
		        dias_demora_ent, pos_min_sug, sugerido_comprar, ;
		        &lcCantSoli     AS cant_soli, ;
		        meses_cubiertos, &lcMesesCobProy AS meses_cob_proy, meses_cobert_solic, ;
		        &lcScore        AS score, ;
		        &lcEstado       AS estado, ;
		        rub_codi, rub_desc, ;
		        &lcProvCodiSel  AS prov_codi_sel, ;
		        &lcProvNombSel  AS prov_nomb_sel, ;
		        &lcArtproCosto  AS artpro_costo, ;
		        &lcArtproMoneda AS artpro_moneda, ;
		        &lcProvLista    AS prov_lista, ;
		        CAST('' AS C(8)) AS ui_item, ;
		        CAST(.F. AS L)   AS ui_sel ;
		    FROM cur_raw_full ;
		    WHERE NVL(estado,1) = 1 ;
		    ORDER BY pct_rotacion DESC ;
		    INTO CURSOR cur_temp READWRITE
		
		ENDCASE
		
		RETURN USED("cur_temp")
	ENDPROC

	PROCEDURE construircurtempseleccionados
		*=========================================================
		* FormSet.ConstruirCurTempSeleccionados
		* Construye cur_temp para filtro SELECCIONADOS
		*=========================================================
		LOCAL lnConn, lnRet, lcSQL
		IF USED("cur_raw_cart_tmp")
		    USE IN cur_raw_cart_tmp
		ENDIF
		IF USED("cur_temp")
		    USE IN cur_temp
		ENDIF
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No hay conexión a MySQL.", 16, "Error")
		    RETURN .F.
		ENDIF
		WAIT WINDOW "Cargando lista de seleccionados" NOWAIT
		TEXT TO lcSQL NOSHOW
		SELECT
		    a.art_codi,
		    a.art_desc,
		    IFNULL(a.art_stock,0)               AS art_stock,
		    IFNULL(a.art_stmin,0)               AS art_stmin,
		    IFNULL(a.pedidos,0)                 AS pedidos,
		    IFNULL(a.pedprov,0)                 AS pedprov,
		    (IFNULL(a.art_stock,0) + IFNULL(a.pedprov,0) - IFNULL(a.pedidos,0)) AS posicion,
		    GREATEST(0, IFNULL(m.sugerido_comprar,0) - IFNULL(a.pedprov,0))     AS sug_neto,
		    IFNULL(m.pct_rotacion,0)            AS pct_rotacion,
		    IFNULL(m.ventas_metrics,'')         AS ventas_metrics,
		    IFNULL(m.promedio_venta,0)          AS promedio_venta,
		    m.fecha_ult_venta,
		    IFNULL(m.compras_metrics,'')        AS compras_metrics,
		    IFNULL(m.promedio_compra,0)         AS promedio_compra,
		    m.fecha_ult_compra,
		    IFNULL(m.dias_demora_ent,15)        AS dias_demora_ent,
		    IFNULL(m.pos_min_sug,0)             AS pos_min_sug,
		    IFNULL(m.sugerido_comprar,0)        AS sugerido_comprar,
		    IFNULL(t.cant_soli,0)               AS cant_soli,
		    IFNULL(t.observacion,'')            AS observacion,
		    IFNULL(m.meses_cubiertos,0)         AS meses_cubiertos,
		    IFNULL(m.meses_cobert_solic,3)      AS meses_cobert_solic,
		    IFNULL(m.art_pct_alerta,30.00)      AS art_pct_alerta,
		    0                                   AS meses_cob_proy,
		    0                                   AS score,
		    IFNULL(a.rub_codi,0)                AS rub_codi,
		    COALESCE(r.rub_desc,'')             AS rub_desc,
		    IFNULL(t.prov_codi,0)               AS prov_codi_sel,
		    IFNULL(p.prov_nomb,'')              AS prov_nomb_sel,
		    IFNULL(ap2.artpro_costo,0)          AS artpro_costo,
		    IFNULL(ap2.moneda,'')               AS artpro_moneda,
		    IFNULL(pl.prov_lista,'')            AS prov_lista
		FROM temp_solicitud_compra t
		JOIN articulos a ON a.art_codi = t.art_codi
		LEFT JOIN art_metricas m       ON m.art_codi   = a.art_codi
		LEFT JOIN rubros r             ON r.rub_codi   = a.rub_codi
		LEFT JOIN proveedores p        ON p.prov_codi  = t.prov_codi
		LEFT JOIN articulos_proveedores ap2
		                               ON ap2.prov_codi = t.prov_codi
		                              AND ap2.art_codi  = t.art_codi
		LEFT JOIN (
		    SELECT ap3.art_codi,
		           GROUP_CONCAT(
		               CONCAT(
		                   IFNULL(p3.prov_nomb,''), '^',
		                   ap3.prov_codi,           '^',
		                   IFNULL(ap3.artpro_costo,0), '^',
		                   IFNULL(ap3.moneda,'P'),  '^',
		                   IFNULL(ap3.lista,0),     '^',
		                   IFNULL(ap3.cotiz,0),     '^',
		                   IFNULL(DATE_FORMAT(hm.histo_fech,'%Y-%m-%d %H:%i:%s'),'')
		               )
		               ORDER BY p3.prov_nomb, ap3.artpro_costo
		               SEPARATOR '\n'
		           ) AS prov_lista
		    FROM articulos_proveedores ap3
		    INNER JOIN proveedores p3 ON p3.prov_codi = ap3.prov_codi
		    LEFT JOIN (
		        SELECT artpro_codi, MAX(histo_fech) AS histo_fech
		        FROM histocosto
		        GROUP BY artpro_codi
		    ) hm ON hm.artpro_codi = ap3.artpro_codi
		    GROUP BY ap3.art_codi
		) pl ON pl.art_codi = a.art_codi
		ORDER BY prov_nomb_sel ASC, a.art_desc ASC
		ENDTEXT
		SQLEXEC(lnConn, "SET SESSION group_concat_max_len = 65536")
		lnRet = SQLEXEC(lnConn, lcSQL, "cur_raw_cart_tmp")
		Desconectar_DB(lnConn)
		WAIT CLEAR
		IF lnRet <= 0 OR !USED("cur_raw_cart_tmp")
		    MESSAGEBOX("No se pudo cargar el carrito o está vacío.", 48, "Lista Temporal")
		    RETURN .F.
		ENDIF
		SELECT ;
		    art_codi, art_desc, art_stock, art_stmin, pedidos, pedprov, posicion, sug_neto, ;
		    pct_rotacion, CAST(NVL(art_pct_alerta,0) AS N(10,2)) AS art_pct_alerta, ;
		    CAST(NVL(ventas_metrics,'') AS M) AS ventas_metrics, ;
		    promedio_venta, ;
		    CAST(NVL(fecha_ult_venta,{}) AS D) AS fecha_ult_venta, ;
		    CAST(NVL(compras_metrics,'') AS M) AS compras_metrics, ;
		    promedio_compra, ;
		    CAST(NVL(fecha_ult_compra,{}) AS D) AS fecha_ult_compra, ;
		    dias_demora_ent, pos_min_sug, sugerido_comprar, meses_cubiertos, ;
		    meses_cobert_solic, meses_cob_proy, score, rub_codi, rub_desc, ;
		    CAST(NVL(prov_codi_sel,0)  AS I)       AS prov_codi_sel, ;
		    CAST(NVL(prov_nomb_sel,'') AS C(80))   AS prov_nomb_sel, ;
		    CAST(NVL(artpro_costo,0)   AS N(15,4)) AS artpro_costo, ;
		    CAST(NVL(artpro_moneda,'') AS C(1))    AS artpro_moneda, ;
		    CAST(NVL(prov_lista,'')    AS M)       AS prov_lista, ;
		    CAST(NVL(cant_soli,0)      AS N(15,3)) AS cant_soli, ;
			CAST(NVL(observacion,'') AS M) AS observacion, ;
		    CAST('' AS C(8)) AS ui_item, ;
		    CAST(.T. AS L)   AS ui_sel ;
		FROM cur_raw_cart_tmp ;
		INTO CURSOR cur_temp READWRITE
		USE IN cur_raw_cart_tmp
		RETURN USED("cur_temp")
	ENDPROC

	PROCEDURE crearcurtempvacioalerts
		*=========================================================
		* FormSet.CrearCurTempVacioAlerts
		* Crea cur_temp vacío con la estructura completa esperada
		* por cur_alerts
		*=========================================================
		IF USED("cur_temp")
		    USE IN cur_temp
		ENDIF
		
		CREATE CURSOR cur_temp ( ;
		    art_codi           I, ;
		    art_desc           C(80), ;
		    art_stock          N(15,3), ;
		    art_stmin          N(15,3), ;
		    art_pct_alerta     N(10,2), ;
		    pedidos            N(15,3), ;
		    pedprov            N(15,3), ;
		    posicion           N(15,3), ;
		    sug_neto           N(15,3), ;
		    pct_rotacion       N(10,3), ;
		    ventas_metrics     M, ;
		    promedio_venta     N(15,3), ;
		    fecha_ult_venta    D, ;
		    compras_metrics    M, ;
		    promedio_compra    N(15,3), ;
		    fecha_ult_compra   D, ;
		    dias_demora_ent    I, ;
		    pos_min_sug        N(15,3), ;
		    sugerido_comprar   N(15,3), ;
		    cant_soli          N(15,3), ;
		    meses_cubiertos    N(15,3), ;
		    meses_cob_proy     N(15,3), ;
		    meses_cobert_solic N(15,3), ;
		    score              I, ;
		    rub_codi           I, ;
		    rub_desc           C(60), ;
		    prov_codi_sel      I, ;
		    prov_nomb_sel      C(80), ;
		    artpro_costo       N(15,4), ;
		    artpro_moneda      C(1), ;
		    artpro_fecha       D, ;
		    prov_lista         M, ;
		    col_back           N(12,0), ;
		    col_fore           N(12,0), ;
		    ui_item            C(8), ;
		    ui_sel             L )
		
		RETURN .T.
	ENDPROC

	PROCEDURE crudtempsolicitudcompra
		*=========================================================
		* FormSet.CRUDTempSolicitudCompra
		* CRUD centralizado de temp_solicitud_compra
		*
		* Acciones:
		*   SAVE         = inserta o actualiza todo
		*   DELETE       = elimina por art_codi
		*   EXISTS       = verifica existencia
		*   GET          = devuelve registro en cursor
		*   UPDATE_CANT  = actualiza solo cantidad
		*   UPDATE_PROV  = actualiza solo proveedor/costo
		*   UPDATE_TRAN  = actualiza solo transporte
		*   UPDATE_OBS   = actualiza solo observación
		*   CLEAR        = limpia tabla completa
		*
		* Parámetros:
		*   tcAccion
		*   tnArtCodi
		*   tnCantSoli
		*   tnProvCodi
		*   tnArtProCosto
		*   tcCursorOut
		*   tnConnExt
		*   tcObservacion
		*   tnTranCodi       && opcional
		*
		* IMPORTANTE:
		* - Para UPDATE_TRAN podés pasar el transporte en tnTranCodi.
		* - Si no lo pasás, usa tnProvCodi como fallback para no romper compatibilidad.
		*
		* Si tnConnExt viene informado y válido:
		* - usa esa conexión
		* - NO la cierra
		*=========================================================
		LPARAMETERS tcAccion, tnArtCodi, tnCantSoli, tnProvCodi, tnArtProCosto, tcCursorOut, tnConnExt, tcObservacion, tnTranCodi
		
		LOCAL lnConn, lnRet, lcSQL, lcAccion, lcOut
		LOCAL laErr[1], lcErrMsg
		LOCAL llUsaConnExterna
		LOCAL lcObs
		LOCAL lnTranCodi
		
		lcAccion = UPPER(ALLTRIM(IIF(VARTYPE(tcAccion) = "C", tcAccion, "")))
		lcOut    = IIF(VARTYPE(tcCursorOut) = "C" AND !EMPTY(tcCursorOut), ALLTRIM(tcCursorOut), "cur_temp_soli_out")
		
		DO CASE
		CASE VARTYPE(tcObservacion) = "C"
		    lcObs = ALLTRIM(tcObservacion)
		CASE VARTYPE(tcObservacion) = "M"
		    lcObs = ALLTRIM(tcObservacion)
		OTHERWISE
		    lcObs = ""
		ENDCASE
		
		IF !INLIST(lcAccion, ;
		    "SAVE", ;
		    "DELETE", ;
		    "EXISTS", ;
		    "GET", ;
		    "UPDATE_CANT", ;
		    "UPDATE_PROV", ;
		    "UPDATE_TRAN", ;
		    "UPDATE_OBS", ;
		    "CLEAR")
		    RETURN .F.
		ENDIF
		
		IF USED(lcOut)
		    USE IN (lcOut)
		ENDIF
		
		IF VARTYPE(tnArtCodi) <> "N"
		    tnArtCodi = 0
		ENDIF
		
		IF VARTYPE(tnCantSoli) <> "N"
		    tnCantSoli = 0
		ENDIF
		
		IF VARTYPE(tnProvCodi) <> "N"
		    tnProvCodi = 0
		ENDIF
		
		IF VARTYPE(tnArtProCosto) <> "N"
		    tnArtProCosto = 0
		ENDIF
		
		*---------------------------------------------------------
		* Transporte:
		* - Si viene tnTranCodi, usa ese.
		* - Si no viene, usa tnProvCodi como fallback para UPDATE_TRAN.
		*   Esto permite llamar:
		*   CRUDTempSolicitudCompra("UPDATE_TRAN", lnArt, 0, lnTran, 0)
		*---------------------------------------------------------
		IF VARTYPE(tnTranCodi) = "N"
		    lnTranCodi = tnTranCodi
		ELSE
		    lnTranCodi = 0
		ENDIF
		
		IF lcAccion == "UPDATE_TRAN" AND lnTranCodi <= 0
		    lnTranCodi = tnProvCodi
		ENDIF
		
		IF VARTYPE(lnTranCodi) <> "N"
		    lnTranCodi = VAL(TRANSFORM(lnTranCodi))
		ENDIF
		
		lnTranCodi = INT(NVL(lnTranCodi, 0))
		
		llUsaConnExterna = (VARTYPE(tnConnExt) = "N" AND tnConnExt > 0)
		
		IF llUsaConnExterna
		    lnConn = tnConnExt
		ELSE
		    lnConn = Conectar_DB(_screen.cn)
		
		    IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		        RETURN .F.
		    ENDIF
		ENDIF
		
		DO CASE
		
		*---------------------------------------------------------
		* SAVE
		* Inserta o actualiza artículo seleccionado en temp.
		* También guarda tran_codi si viene informado.
		*---------------------------------------------------------
		CASE lcAccion == "SAVE"
		
		    IF tnArtCodi <= 0 OR tnCantSoli <= 0
		        IF !llUsaConnExterna
		            Desconectar_DB(lnConn)
		        ENDIF
		        RETURN .F.
		    ENDIF
		
		    TEXT TO lcSQL NOSHOW PRETEXT 15
		        INSERT INTO temp_solicitud_compra (
		            art_codi,
		            cant_soli,
		            fecha_agregado,
		            prov_codi,
		            tran_codi,
		            artpro_costo,
		            observacion
		        )
		        VALUES (
		            ?tnArtCodi,
		            ?tnCantSoli,
		            NOW(),
		            NULLIF(?tnProvCodi, 0),
		            NULLIF(?lnTranCodi, 0),
		            ?tnArtProCosto,
		            NULLIF(?lcObs, '')
		        )
		        ON DUPLICATE KEY UPDATE
		            cant_soli      = VALUES(cant_soli),
		            fecha_agregado = NOW(),
		            prov_codi      = VALUES(prov_codi),
		            tran_codi      = VALUES(tran_codi),
		            artpro_costo   = VALUES(artpro_costo),
		            observacion    = VALUES(observacion)
		    ENDTEXT
		
		    lnRet = SQLEXEC(lnConn, lcSQL)
		
		*---------------------------------------------------------
		* DELETE
		*---------------------------------------------------------
		CASE lcAccion == "DELETE"
		
		    IF tnArtCodi <= 0
		        IF !llUsaConnExterna
		            Desconectar_DB(lnConn)
		        ENDIF
		        RETURN .F.
		    ENDIF
		
		    TEXT TO lcSQL NOSHOW PRETEXT 15
		        DELETE FROM temp_solicitud_compra
		        WHERE art_codi = ?tnArtCodi
		    ENDTEXT
		
		    lnRet = SQLEXEC(lnConn, lcSQL)
		
		*---------------------------------------------------------
		* EXISTS
		*---------------------------------------------------------
		CASE lcAccion == "EXISTS"
		
		    IF tnArtCodi <= 0
		        IF !llUsaConnExterna
		            Desconectar_DB(lnConn)
		        ENDIF
		        RETURN .F.
		    ENDIF
		
		    TEXT TO lcSQL NOSHOW PRETEXT 15
		        SELECT art_codi
		        FROM temp_solicitud_compra
		        WHERE art_codi = ?tnArtCodi
		    ENDTEXT
		
		    lnRet = SQLEXEC(lnConn, lcSQL, lcOut)
		
		*---------------------------------------------------------
		* GET
		* Devuelve también tran_codi.
		*---------------------------------------------------------
		CASE lcAccion == "GET"
		
		    IF tnArtCodi <= 0
		        IF !llUsaConnExterna
		            Desconectar_DB(lnConn)
		        ENDIF
		        RETURN .F.
		    ENDIF
		
		    TEXT TO lcSQL NOSHOW PRETEXT 15
		        SELECT
		            art_codi,
		            cant_soli,
		            fecha_agregado,
		            IFNULL(prov_codi, 0)      AS prov_codi,
		            IFNULL(tran_codi, 0)      AS tran_codi,
		            IFNULL(artpro_costo, 0)   AS artpro_costo,
		            IFNULL(observacion, '')   AS observacion
		        FROM temp_solicitud_compra
		        WHERE art_codi = ?tnArtCodi
		    ENDTEXT
		
		    lnRet = SQLEXEC(lnConn, lcSQL, lcOut)
		
		*---------------------------------------------------------
		* UPDATE_CANT
		*---------------------------------------------------------
		CASE lcAccion == "UPDATE_CANT"
		
		    IF tnArtCodi <= 0 OR tnCantSoli <= 0
		        IF !llUsaConnExterna
		            Desconectar_DB(lnConn)
		        ENDIF
		        RETURN .F.
		    ENDIF
		
		    TEXT TO lcSQL NOSHOW PRETEXT 15
		        UPDATE temp_solicitud_compra
		        SET cant_soli = ?tnCantSoli,
		            fecha_agregado = NOW()
		        WHERE art_codi = ?tnArtCodi
		    ENDTEXT
		
		    lnRet = SQLEXEC(lnConn, lcSQL)
		
		*---------------------------------------------------------
		* UPDATE_PROV
		* Solo proveedor/costo.
		* No toca tran_codi para no pisar transporte ya elegido.
		*---------------------------------------------------------
		CASE lcAccion == "UPDATE_PROV"
		
		    IF tnArtCodi <= 0
		        IF !llUsaConnExterna
		            Desconectar_DB(lnConn)
		        ENDIF
		        RETURN .F.
		    ENDIF
		
		    TEXT TO lcSQL NOSHOW PRETEXT 15
		        UPDATE temp_solicitud_compra
		        SET prov_codi = NULLIF(?tnProvCodi, 0),
		            artpro_costo = ?tnArtProCosto,
		            fecha_agregado = NOW()
		        WHERE art_codi = ?tnArtCodi
		    ENDTEXT
		
		    lnRet = SQLEXEC(lnConn, lcSQL)
		
		*---------------------------------------------------------
		* UPDATE_TRAN
		* Solo transporte.
		* Si lnTranCodi = 0, guarda NULL.
		*---------------------------------------------------------
		CASE lcAccion == "UPDATE_TRAN"
		
		    IF tnArtCodi <= 0
		        IF !llUsaConnExterna
		            Desconectar_DB(lnConn)
		        ENDIF
		        RETURN .F.
		    ENDIF
		
		    TEXT TO lcSQL NOSHOW PRETEXT 15
		        UPDATE temp_solicitud_compra
		        SET tran_codi = NULLIF(?lnTranCodi, 0),
		            fecha_agregado = NOW()
		        WHERE art_codi = ?tnArtCodi
		    ENDTEXT
		
		    lnRet = SQLEXEC(lnConn, lcSQL)
		
		*---------------------------------------------------------
		* UPDATE_OBS
		*---------------------------------------------------------
		CASE lcAccion == "UPDATE_OBS"
		
		    IF tnArtCodi <= 0
		        IF !llUsaConnExterna
		            Desconectar_DB(lnConn)
		        ENDIF
		        RETURN .F.
		    ENDIF
		
		    TEXT TO lcSQL NOSHOW PRETEXT 15
		        UPDATE temp_solicitud_compra
		        SET observacion = NULLIF(?lcObs, ''),
		            fecha_agregado = NOW()
		        WHERE art_codi = ?tnArtCodi
		    ENDTEXT
		
		    lnRet = SQLEXEC(lnConn, lcSQL)
		
		*---------------------------------------------------------
		* CLEAR
		*---------------------------------------------------------
		CASE lcAccion == "CLEAR"
		
		    lnRet = SQLEXEC(lnConn, "TRUNCATE TABLE temp_solicitud_compra")
		
		OTHERWISE
		
		    lnRet = -1
		
		ENDCASE
		
		*---------------------------------------------------------
		* Manejo de error SQL
		*---------------------------------------------------------
		IF lnRet < 0
		
		    IF AERROR(laErr) > 0
		        lcErrMsg = IIF(TYPE("laErr[1,3]") <> "U", TRANSFORM(laErr[1,3]), "Error SQL")
		    ELSE
		        lcErrMsg = "Error SQL desconocido."
		    ENDIF
		
		    IF !llUsaConnExterna
		        Desconectar_DB(lnConn)
		    ENDIF
		
		    MESSAGEBOX(lcErrMsg, 16, "Error SQL - temp_solicitud_compra")
		    RETURN .F.
		ENDIF
		
		IF !llUsaConnExterna
		    Desconectar_DB(lnConn)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE darkencolor
		* FormSet.DarkenColor
		LPARAMETERS tnColor, tnFactor
		LOCAL loFrm, loConsulta
		LOCAL lnR, lnG, lnB
		
		loFrm      = THISFORMSET.principal
		loConsulta = THISFORMSET.secundario
		
		IF VARTYPE(tnColor) <> "N"
		    RETURN tnColor
		ENDIF
		
		IF VARTYPE(tnFactor) <> "N" OR tnFactor <= 0 OR tnFactor > 1
		    tnFactor = 0.88
		ENDIF
		
		* COLORREF: 0x00BBGGRR
		lnR = BITAND(tnColor, 255)
		lnG = BITRSHIFT(BITAND(tnColor, 65280), 8)
		lnB = BITRSHIFT(BITAND(tnColor, 16711680), 16)
		
		lnR = ROUND(lnR * tnFactor, 0)
		lnG = ROUND(lnG * tnFactor, 0)
		lnB = ROUND(lnB * tnFactor, 0)
		
		IF lnR < 0
		    lnR = 0
		ELSE
		    IF lnR > 255
		        lnR = 255
		    ENDIF
		ENDIF
		
		IF lnG < 0
		    lnG = 0
		ELSE
		    IF lnG > 255
		        lnG = 255
		    ENDIF
		ENDIF
		
		IF lnB < 0
		    lnB = 0
		ELSE
		    IF lnB > 255
		        lnB = 255
		    ENDIF
		ENDIF
		
		RETURN RGB(lnR, lnG, lnB)
	ENDPROC

	PROCEDURE Destroy
		*=========================================================
		* FormSet.Destroy
		*=========================================================
		TRY
		    IF PEMSTATUS(THISFORMSET, "CerrarCursoresTemporales", 5)
		        THISFORMSET.CerrarCursoresTemporales()
		    ENDIF
		CATCH
		ENDTRY
		
		RETURN
	ENDPROC

	PROCEDURE dynback_alerta
		*=========================================================
		* FormSet.DynBack_Alerta
		*=========================================================
		LOCAL loFrm
		LOCAL lnPos, lnMin, lnPct, lnPuntoAlerta, lnDif, lnRatio, lnR, lnG, lnB, lnLim
		LOCAL lnBaseColor
		
		IF PEMSTATUS(THISFORMSET, "principal", 5)
		    loFrm = THISFORMSET.principal
		ENDIF
		
		IF !USED("cur_alerts")
		    RETURN RGB(255,255,255)
		ENDIF
		
		lnPos = NVL(cur_alerts.posicion, 0)
		lnMin = NVL(cur_alerts.art_stmin, 0)
		lnPct = NVL(cur_alerts.art_pct_alerta, 0)
		
		lnPuntoAlerta = lnMin * (1 + (lnPct / 100))
		
		IF lnPos < 0
		    IF lnPuntoAlerta > 0
		        lnRatio = MIN(1, (-lnPos) / lnPuntoAlerta)
		    ELSE
		        lnRatio = 1
		    ENDIF
		    lnR = INT(160 - (70 * lnRatio))
		    lnG = INT(100 - (70 * lnRatio))
		    lnB = 255
		    RETURN RGB(lnR, lnG, lnB)
		ENDIF
		
		IF lnPuntoAlerta <= 0 OR lnPos >= lnPuntoAlerta
		    lnBaseColor = RGB(255,255,255)
		ELSE
		    lnDif   = lnPuntoAlerta - lnPos
		    lnRatio = MIN(1, MAX(0, lnDif / lnPuntoAlerta))
		    lnR = 255
		    lnG = INT(235 - (135 * lnRatio))
		    lnB = INT(235 - (135 * lnRatio))
		    lnBaseColor = RGB(lnR, lnG, lnB)
		ENDIF
		
		RETURN lnBaseColor
		
	ENDPROC

	PROCEDURE dynfore_alerta
		*=========================================================
		* FormSet.DynFore_Alerta
		*=========================================================
		LOCAL loFrm
		LOCAL lnPos, lnMin
		LOCAL lnPuntoAlerta, lnRatio, lnVal
		LOCAL lnPct
		
		IF PEMSTATUS(THISFORMSET, "principal", 5)
		    loFrm = THISFORMSET.principal
		ENDIF
		
		IF !USED("cur_alerts")
		    RETURN RGB(0,0,0)
		ENDIF
		
		lnPos = NVL(cur_alerts.posicion, 0)
		lnMin = NVL(cur_alerts.art_stmin, 0)
		
		IF lnPos < 0
		    RETURN RGB(255, 255, 255)
		ENDIF
		
		IF lnMin > 0 AND lnPos < lnMin
		    RETURN RGB(60,60,60)
		ENDIF
		
		RETURN RGB(0,0,0)
		
	ENDPROC

	PROCEDURE editarcantidadalerta
		*=========================================================
		* FormSet.EditarCantidadAlerta
		* Edita cantidad del artículo actual usando CRUDTempSolicitudCompra
		*=========================================================
		LOCAL loFrm, lnArt, lcDesc
		LOCAL lnCantActual, lcResp, lnCantNueva
		LOCAL lnProvCodi, lnArtproCosto
		LOCAL lnRecActual, lnArtActual
		LOCAL llOk
		
		loFrm = THISFORMSET.principal
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0 OR EOF("cur_alerts")
		    RETURN
		ENDIF
		
		lnArt  = IIF(TYPE("cur_alerts.art_codi")="N", cur_alerts.art_codi, 0)
		lcDesc = IIF(TYPE("cur_alerts.art_desc")="C", ALLTRIM(cur_alerts.art_desc), "Artículo " + TRANSFORM(lnArt))
		
		IF lnArt <= 0
		    RETURN
		ENDIF
		
		lnRecActual = RECNO("cur_alerts")
		lnArtActual = lnArt
		
		*---------------------------------------------------------
		* 1) Obtener cantidad actual
		*---------------------------------------------------------
		lnCantActual = 0
		
		IF TYPE("cur_alerts.ui_sel")="L" AND cur_alerts.ui_sel
		    IF THISFORMSET.CRUDTempSolicitudCompra("GET", lnArt, 0, 0, 0, "cur_cant_tmp")
		        IF USED("cur_cant_tmp") AND RECCOUNT("cur_cant_tmp") > 0
		            SELECT cur_cant_tmp
		            lnCantActual = NVL(cur_cant_tmp.cant_soli, 0)
		        ENDIF
		        IF USED("cur_cant_tmp")
		            USE IN cur_cant_tmp
		        ENDIF
		    ENDIF
		
		    SELECT cur_alerts
		ELSE
		    *-- Si aún no está seleccionado, usar sugerido como referencia
		    IF TYPE("cur_alerts.sugerido_comprar")="N" AND cur_alerts.sugerido_comprar > 0
		        lnCantActual = MAX(1, cur_alerts.sugerido_comprar)
		    ELSE
		        lnCantActual = 1
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 2) Pedir nueva cantidad
		*---------------------------------------------------------
		lcResp = INPUTBOX("Cantidad a pedir:", "Editar Cantidad — " + lcDesc, TRANSFORM(lnCantActual))
		
		IF ISNULL(lcResp) OR EMPTY(ALLTRIM(lcResp))
		    RETURN
		ENDIF
		
		lnCantNueva = VAL(STRTRAN(ALLTRIM(lcResp), ",", "."))
		
		IF lnCantNueva <= 0
		    MESSAGEBOX("La cantidad debe ser mayor a cero.", 48, "Atención")
		    RETURN
		ENDIF
		
		*---------------------------------------------------------
		* 3) Guardar en temp_solicitud_compra usando CRUD central
		*---------------------------------------------------------
		lnProvCodi    = IIF(TYPE("cur_alerts.prov_codi_sel")="N", cur_alerts.prov_codi_sel, 0)
		lnArtproCosto = IIF(TYPE("cur_alerts.artpro_costo")="N",  cur_alerts.artpro_costo,  0)
		
		llOk = THISFORMSET.CRUDTempSolicitudCompra("SAVE", lnArt, lnCantNueva, lnProvCodi, lnArtproCosto, "")
		
		IF !llOk
		    MESSAGEBOX("No se pudo guardar la cantidad en la lista temporal.", 16, "Error")
		    RETURN
		ENDIF
		
		*---------------------------------------------------------
		* 4) Reflejar cambios en cur_alerts
		*---------------------------------------------------------
		SELECT cur_alerts
		
		IF TYPE("cur_alerts.ui_sel")="L" AND !cur_alerts.ui_sel
		    REPLACE ui_sel WITH .T.
		ENDIF
		
		IF TYPE("cur_alerts.cant_soli") = "N"
		    REPLACE cant_soli WITH ROUND(lnCantNueva, 3)
		ENDIF
		
		*---------------------------------------------------------
		* 5) Sincronizar auxiliares
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "SincronizarPedido", 5)
		    THISFORMSET.SincronizarPedido()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		    THISFORMSET.SincronizarBotonMasivo()
		ENDIF
		
		*---------------------------------------------------------
		* 6) Restaurar posición sobre el mismo artículo
		*---------------------------------------------------------
		IF USED("cur_alerts") AND RECCOUNT("cur_alerts") > 0
		    SELECT cur_alerts
		
		    IF lnArtActual > 0
		        LOCATE FOR art_codi = lnArtActual
		        IF !FOUND() AND BETWEEN(lnRecActual, 1, RECCOUNT("cur_alerts"))
		            GO lnRecActual
		        ENDIF
		    ELSE
		        IF BETWEEN(lnRecActual, 1, RECCOUNT("cur_alerts"))
		            GO lnRecActual
		        ENDIF
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xCurRec", 5)
		        loFrm.xCurRec = RECNO("cur_alerts")
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xCurArt", 5)
		        loFrm.xCurArt = IIF(TYPE("cur_alerts.art_codi")="N", cur_alerts.art_codi, 0)
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 7) Refresco visual final
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		    THISFORMSET.ActualizarEfectoGrid(0)
		ENDIF
		
		IF PEMSTATUS(loFrm, "grd_alerts", 5)
		    loFrm.grd_alerts.Refresh()
		    TRY
		        loFrm.grd_alerts.SetFocus()
		    CATCH
		    ENDTRY
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE editarestado
		*=========================================================
		* FormSet.EditarEstado
		* Cambia art_metricas.estado para el artículo actual
		* Usa MsgBoxEx: Activo / Inactivo / Cancelar + X/ESC
		*=========================================================
		LPARAMETERS lnArtCodi, lnEstadoActual
		LOCAL lnSel, lnNuevoEstado, lnConn, lnRet, lcDesc
		
		*--- Normalizar: MySQL tinyint(1) llega como Lógico (L) vía SQLEXEC ---
		lnEstadoActual = IIF(VARTYPE(lnEstadoActual) = "L", ;
		    IIF(lnEstadoActual, 1, 0), ;
		    INT(NVL(lnEstadoActual, 1)))
		
		lcDesc = IIF(lnEstadoActual = 1, "ACTIVO", "INACTIVO")
		lnSel = msgboxex( ;
		    "Estado actual del artículo " + TRANSFORM(lnArtCodi) + ": " + lcDesc + CHR(13) + ;
		    "Seleccione el nuevo estado:", ;
		    "?", "Estado del Artículo", ;
		    "Activo,Inactivo,Cancelar")
		
		DO CASE
		CASE lnSel = 1
		    lnNuevoEstado = 1
		CASE lnSel = 2
		    lnNuevoEstado = 0
		OTHERWISE
		    RETURN  && X, ESC o Cancelar
		ENDCASE
		
		IF lnNuevoEstado = lnEstadoActual
		    RETURN  && sin cambio
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a la base de datos.", 16, "Error")
		    RETURN
		ENDIF
		lnRet = SQLEXEC(lnConn, ;
		    "UPDATE art_metricas SET estado = " + TRANSFORM(lnNuevoEstado) + ;
		    " WHERE art_codi = " + TRANSFORM(lnArtCodi))
		
		IF lnRet >= 0
		    lnRet = SQLEXEC(lnConn, ;
		        "INSERT INTO art_metricas (art_codi, estado) " + ;
		        "SELECT " + TRANSFORM(lnArtCodi) + ", " + TRANSFORM(lnNuevoEstado) + ;
		        " WHERE NOT EXISTS (SELECT 1 FROM art_metricas WHERE art_codi = " + TRANSFORM(lnArtCodi) + ")")
		ENDIF
		
		Desconectar_DB(lnConn)
		
		
		IF lnRet < 0
		    MESSAGEBOX("Error al guardar Estado.", 16, "Error")
		    RETURN
		ENDIF
		
		IF USED("cur_alerts")
		    SELECT cur_alerts
		    IF TYPE("cur_alerts.estado") <> "U"
		        REPLACE estado WITH lnNuevoEstado
		    ENDIF
		ENDIF
		
		IF USED("cur_raw_full")
		    SELECT cur_raw_full
		    LOCATE FOR art_codi = lnArtCodi
		    IF FOUND() AND TYPE("cur_raw_full.estado") <> "U"
		        REPLACE estado WITH lnNuevoEstado
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORMSET.principal, "grd_alerts", 5)
		    THISFORMSET.principal.grd_alerts.Refresh()
		ENDIF
		
		MESSAGEBOX("Estado actualizado a " + IIF(lnNuevoEstado=1,"ACTIVO","INACTIVO") + ".", 64, "OK")
		
	ENDPROC

	PROCEDURE editarobservacionarticulo
		*=========================================================
		* FormSet.EditarObservacionArticulo
		* - Agrega/Edita observación del artículo
		* - Usa modal runtime aislado, NO usa cuaterno embebido
		* - Guarda en temp_solicitud_compra
		* - Refleja en cur_alerts / cur_soli_det
		*
		* Parámetros:
		*   tlReadOnly    = .T. solo lectura / .F. edición
		*   tcCursorName  = "cur_alerts" o "cur_soli_det"
		*=========================================================
		LPARAMETERS tlReadOnly, tcCursorName
		
		LOCAL lnArtCodi
		LOCAL lcObsActual, lcObsNueva, lcDesc, lcLabel
		LOCAL lnRecNoActual, lnRecNoHist
		LOCAL lcAliasActual, lcCursorUpper
		LOCAL llOk, llAbreOk
		LOCAL loFrm, loSec
		
		lnArtCodi     = 0
		lcObsActual   = ""
		lcObsNueva    = ""
		lcDesc        = ""
		lcLabel       = ""
		lnRecNoActual = 0
		lnRecNoHist   = 0
		lcAliasActual = ALIAS()
		llOk          = .F.
		llAbreOk      = .F.
		loFrm         = .NULL.
		loSec         = .NULL.
		
		*---------------------------------------------------------
		* 1. Normalizar parámetros
		*---------------------------------------------------------
		IF VARTYPE(tlReadOnly) <> "L"
		    tlReadOnly = .F.
		ENDIF
		
		IF VARTYPE(tcCursorName) <> "C" OR EMPTY(ALLTRIM(tcCursorName))
		    tcCursorName = "cur_alerts"
		ENDIF
		
		tcCursorName  = ALLTRIM(tcCursorName)
		lcCursorUpper = UPPER(tcCursorName)
		
		*---------------------------------------------------------
		* 2. Validar cursor origen
		*---------------------------------------------------------
		IF !USED(tcCursorName) OR RECCOUNT(tcCursorName) <= 0 OR EOF(tcCursorName)
		    MESSAGEBOX("No hay datos para editar observación en " + tcCursorName + ".", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		SELECT (tcCursorName)
		
		IF EOF(tcCursorName) OR BOF(tcCursorName)
		    RETURN .F.
		ENDIF
		
		lnRecNoActual = RECNO(tcCursorName)
		
		IF USED("cur_soli_hist")
		    lnRecNoHist = RECNO("cur_soli_hist")
		ENDIF
		
		*---------------------------------------------------------
		* 3. Leer datos del registro actual
		*---------------------------------------------------------
		IF TYPE(tcCursorName + ".art_codi") = "N"
		    lnArtCodi = NVL(EVALUATE(tcCursorName + ".art_codi"), 0)
		ENDIF
		
		IF TYPE(tcCursorName + ".art_desc") <> "U"
		    lcDesc = ALLTRIM(TRANSFORM(NVL(EVALUATE(tcCursorName + ".art_desc"), "")))
		ENDIF
		
		IF TYPE(tcCursorName + ".observacion") <> "U"
		    lcObsActual = ALLTRIM(TRANSFORM(NVL(EVALUATE(tcCursorName + ".observacion"), "")))
		ENDIF
		
		IF lnArtCodi <= 0
		    MESSAGEBOX("No se pudo determinar el código del artículo.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		lcLabel = "Artículo: " + TRANSFORM(lnArtCodi) + " - " + lcDesc
		
		*---------------------------------------------------------
		* 4. Si es solo lectura y no hay observación, salir
		*---------------------------------------------------------
		IF tlReadOnly AND EMPTY(lcObsActual)
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 5. Abrir modal runtime aislado
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "AbrirModalObservacionAislado", 5)
		    MESSAGEBOX("No existe el método AbrirModalObservacionAislado en el FormSet.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		CLEAR TYPEAHEAD
		
		IF tlReadOnly
		    llAbreOk = THISFORMSET.AbrirModalObservacionAislado( ;
		        "LECTURA", ;
		        "Consulta de Observación", ;
		        lcLabel, ;
		        lcObsActual, ;
		        .T. )
		ELSE
		    llAbreOk = THISFORMSET.AbrirModalObservacionAislado( ;
		        "OBS_ART", ;
		        IIF(EMPTY(lcObsActual), "Agregar Observación", "Editar Observación"), ;
		        lcLabel, ;
		        lcObsActual, ;
		        .F. )
		ENDIF
		
		CLEAR TYPEAHEAD
		
		*---------------------------------------------------------
		* 6. Si era solo lectura, no hay nada que guardar
		*---------------------------------------------------------
		IF tlReadOnly
		    RETURN llAbreOk
		ENDIF
		
		*---------------------------------------------------------
		* 7. Si canceló, no guardar nada
		*---------------------------------------------------------
		IF !llAbreOk
		    IF !EMPTY(lcAliasActual) AND USED(lcAliasActual)
		        SELECT (lcAliasActual)
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "xObsModalCancelado", 5) AND THISFORMSET.xObsModalCancelado
		    IF !EMPTY(lcAliasActual) AND USED(lcAliasActual)
		        SELECT (lcAliasActual)
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 8. Tomar texto nuevo del modal runtime
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "xObsModalValor", 5)
		    lcObsNueva = ALLTRIM(NVL(THISFORMSET.xObsModalValor, ""))
		ELSE
		    lcObsNueva = ""
		ENDIF
		
		*---------------------------------------------------------
		* 9. Guardar observación en temp_solicitud_compra
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "CRUDTempSolicitudCompra", 5)
		
		    llOk = THISFORMSET.CRUDTempSolicitudCompra( ;
		        "UPDATE_OBS", ;
		        lnArtCodi, ;
		        0, ;
		        0, ;
		        0, ;
		        "", ;
		        0, ;
		        lcObsNueva)
		
		ELSE
		    MESSAGEBOX("No existe el método CRUDTempSolicitudCompra.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF !llOk
		    MESSAGEBOX( ;
		        "No se pudo guardar la observación del artículo." + CHR(13) + ;
		        "Verificá que el artículo esté seleccionado en temp_solicitud_compra.", ;
		        16, ;
		        "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 10. Reflejar en cur_alerts si existe
		*---------------------------------------------------------
		IF USED("cur_alerts")
		    SELECT cur_alerts
		    LOCATE FOR art_codi = lnArtCodi
		
		    IF FOUND()
		        IF TYPE("cur_alerts.observacion") $ "CM"
		            REPLACE observacion WITH lcObsNueva IN cur_alerts
		        ENDIF
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 11. Reflejar en cur_soli_det si existe
		*---------------------------------------------------------
		IF USED("cur_soli_det")
		    SELECT cur_soli_det
		    LOCATE FOR art_codi = lnArtCodi
		
		    IF FOUND()
		        IF TYPE("cur_soli_det.observacion") $ "CM"
		            REPLACE observacion WITH lcObsNueva IN cur_soli_det
		        ENDIF
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 12. Restaurar posición y refrescar
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "principal", 5)
		    loFrm = THISFORMSET.principal
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loSec = THISFORMSET.secundario
		ENDIF
		
		DO CASE
		CASE lcCursorUpper == "CUR_SOLI_DET"
		
		    IF USED("cur_soli_hist") AND lnRecNoHist > 0 AND lnRecNoHist <= RECCOUNT("cur_soli_hist")
		        GO lnRecNoHist IN cur_soli_hist
		    ENDIF
		
		    IF USED("cur_soli_det") AND lnRecNoActual > 0 AND lnRecNoActual <= RECCOUNT("cur_soli_det")
		        GO lnRecNoActual IN cur_soli_det
		    ENDIF
		
		    IF VARTYPE(loSec) = "O" AND PEMSTATUS(loSec, "grid2", 5)
		        loSec.grid2.Refresh()
		    ENDIF
		
		OTHERWISE
		
		    IF USED(tcCursorName) AND lnRecNoActual > 0 AND lnRecNoActual <= RECCOUNT(tcCursorName)
		        GO lnRecNoActual IN (tcCursorName)
		    ENDIF
		
		    IF VARTYPE(loFrm) = "O" AND PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.Refresh()
		    ENDIF
		
		ENDCASE
		
		*---------------------------------------------------------
		* 13. Actualizar visibilidad / efectos si existen
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ActualizarVisibilidadColumnaObservacion", 5)
		    THISFORMSET.ActualizarVisibilidadColumnaObservacion()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		    THISFORMSET.ActualizarEfectoGrid(0)
		ENDIF
		
		IF !EMPTY(lcAliasActual) AND USED(lcAliasActual)
		    SELECT (lcAliasActual)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE editarpctalerta
		*=========================================================
		* FormSet.EditarPctAlerta
		* Ajusta art_pct_alerta en art_metricas para el artículo actual
		* y mantiene foco/posición en grd_alerts
		*=========================================================
		LPARAMETERS lnArtCodi, lnValorActual
		LOCAL lnNuevo, lnConn, lnRet
		LOCAL lcNuevo, lcArtCodi
		LOCAL lnRecAlerts, lnMinPct, lnMaxPct
		LOCAL loFrm
		lnMinPct    = -99
		lnMaxPct    =  99
		lnRecAlerts = 0
		loFrm       = .NULL.
		IF TYPE("THISFORMSET.principal.Name") <> "U"
		    loFrm = THISFORMSET.principal
		ENDIF
		*--- Guardar posición actual en cur_alerts
		IF USED("cur_alerts")
		    SELECT cur_alerts
		    IF !EOF()
		        lnRecAlerts = RECNO()
		    ENDIF
		ENDIF
		lnNuevo = THISFORMSET.InputNumerico( ;
		    "Ajustar % de Alerta", ;
		    "Ingrese el nuevo % de Alerta (" + TRANSFORM(lnMinPct) + " a " + ;
		        TRANSFORM(lnMaxPct) + ") para el artículo " + TRANSFORM(lnArtCodi) + ":", ;
		    lnValorActual, 0, lnMinPct, lnMaxPct)
		IF ISNULL(lnNuevo)
		    IF PEMSTATUS(THISFORMSET, "RestaurarFocoGridAlerts", 5)
		        THISFORMSET.RestaurarFocoGridAlerts(lnArtCodi, lnRecAlerts)
		    ELSE
		        IF USED("cur_alerts")
		            SELECT cur_alerts
		            LOCATE FOR art_codi = lnArtCodi
		            IF !FOUND() AND BETWEEN(lnRecAlerts, 1, RECCOUNT("cur_alerts"))
		                GO lnRecAlerts
		            ENDIF
		        ENDIF
		        IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		            THISFORMSET.ActualizarEfectoGrid()
		        ENDIF
		        IF VARTYPE(loFrm) = "O" AND PEMSTATUS(loFrm, "grd_alerts", 5)
		            loFrm.grd_alerts.Refresh()
		            loFrm.grd_alerts.SetFocus()
		        ENDIF
		    ENDIF
		    RETURN
		ENDIF
		IF VARTYPE(lnNuevo) <> "N"
		    MESSAGEBOX("El valor ingresado no es válido.", 48, "Valor inválido")
		    IF PEMSTATUS(THISFORMSET, "RestaurarFocoGridAlerts", 5)
		        THISFORMSET.RestaurarFocoGridAlerts(lnArtCodi, lnRecAlerts)
		    ENDIF
		    RETURN
		ENDIF
		IF lnNuevo < lnMinPct OR lnNuevo > lnMaxPct
		    MESSAGEBOX("El % debe estar entre " + TRANSFORM(lnMinPct) + ;
		               " y " + TRANSFORM(lnMaxPct) + ".", 48, "Valor inválido")
		    IF PEMSTATUS(THISFORMSET, "RestaurarFocoGridAlerts", 5)
		        THISFORMSET.RestaurarFocoGridAlerts(lnArtCodi, lnRecAlerts)
		    ENDIF
		    RETURN
		ENDIF
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a la base de datos.", 16, "Error")
		    IF PEMSTATUS(THISFORMSET, "RestaurarFocoGridAlerts", 5)
		        THISFORMSET.RestaurarFocoGridAlerts(lnArtCodi, lnRecAlerts)
		    ENDIF
		    RETURN
		ENDIF
		lcNuevo   = ALLTRIM(STR(lnNuevo, 10, 0))
		lcNuevo   = STRTRAN(lcNuevo, ",", ".")
		lcArtCodi = ALLTRIM(STR(lnArtCodi))
		lnRet = SQLEXEC(lnConn, ;
		    "UPDATE art_metricas SET art_pct_alerta = " + lcNuevo + ;
		    " WHERE art_codi = " + lcArtCodi)
		Desconectar_DB(lnConn)
		IF lnRet < 0
		    MESSAGEBOX("Error al guardar % Alerta.", 16, "Error")
		    IF PEMSTATUS(THISFORMSET, "RestaurarFocoGridAlerts", 5)
		        THISFORMSET.RestaurarFocoGridAlerts(lnArtCodi, lnRecAlerts)
		    ENDIF
		    RETURN
		ENDIF
		*--- Actualizar cur_alerts
		IF USED("cur_alerts")
		    SELECT cur_alerts
		    LOCATE FOR art_codi = lnArtCodi
		    IF FOUND()
		        REPLACE art_pct_alerta WITH lnNuevo
		    ENDIF
		ENDIF
		*--- Actualizar cur_raw_full
		IF USED("cur_raw_full")
		    SELECT cur_raw_full
		    LOCATE FOR art_codi = lnArtCodi
		    IF FOUND()
		        REPLACE art_pct_alerta WITH lnNuevo
		    ENDIF
		ENDIF
		*--- Refrescar UI
		IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		    THISFORMSET.RefrescarGrid()
		ENDIF
		*--- Restaurar posición/foco
		IF PEMSTATUS(THISFORMSET, "RestaurarFocoGridAlerts", 5)
		    THISFORMSET.RestaurarFocoGridAlerts(lnArtCodi, lnRecAlerts)
		ELSE
		    IF USED("cur_alerts")
		        SELECT cur_alerts
		        LOCATE FOR art_codi = lnArtCodi
		        IF !FOUND() AND BETWEEN(lnRecAlerts, 1, RECCOUNT("cur_alerts"))
		            GO lnRecAlerts
		        ENDIF
		    ENDIF
		    IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		        THISFORMSET.ActualizarEfectoGrid()
		    ENDIF
		    IF VARTYPE(loFrm) = "O" AND PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.Refresh()
		        loFrm.grd_alerts.SetFocus()
		    ENDIF
		ENDIF
	ENDPROC

	PROCEDURE editarposmin
		*=========================================================
		* FormSet.EditarPosMin
		* Ajusta art_stmin en articulos para el artículo actual
		* y mantiene foco/posición en grd_alerts
		*=========================================================
		LPARAMETERS lnArtCodi, lnValorActual
		LOCAL lnNuevo, lnConn, lnRet
		LOCAL lcNuevo, lcArtCodi
		LOCAL lnRecAlerts, llFound
		LOCAL loFrm
		
		llFound     = .F.
		lnRecAlerts = 0
		loFrm       = .NULL.
		
		IF TYPE("THISFORMSET.principal.Name") <> "U"
		    loFrm = THISFORMSET.principal
		ENDIF
		
		*--- Guardar posición actual en cur_alerts
		IF USED("cur_alerts")
		    SELECT cur_alerts
		    IF !EOF()
		        lnRecAlerts = RECNO()
		    ENDIF
		ENDIF
		
		lnNuevo = THISFORMSET.InputNumerico( ;
		    "Ajustar Posición Mínima", ;
		    "Ingrese el nuevo valor de Pos.Min. para el artículo " + TRANSFORM(lnArtCodi) + ":", ;
		    lnValorActual, 3)
		
		IF ISNULL(lnNuevo)
		    *-- devolver foco aunque cancele
		    IF USED("cur_alerts")
		        SELECT cur_alerts
		        LOCATE FOR art_codi = lnArtCodi
		    ENDIF
		    IF VARTYPE(loFrm) = "O" AND PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.SetFocus()
		    ENDIF
		    RETURN
		ENDIF
		
		IF VARTYPE(lnNuevo) <> "N"
		    MESSAGEBOX("El valor ingresado no es válido.", 48, "Valor inválido")
		    IF VARTYPE(loFrm) = "O" AND PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.SetFocus()
		    ENDIF
		    RETURN
		ENDIF
		
		IF lnNuevo < 0
		    MESSAGEBOX("El valor no puede ser negativo.", 48, "Valor inválido")
		    IF VARTYPE(loFrm) = "O" AND PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.SetFocus()
		    ENDIF
		    RETURN
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a la base de datos.", 16, "Error")
		    IF VARTYPE(loFrm) = "O" AND PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.SetFocus()
		    ENDIF
		    RETURN
		ENDIF
		
		lcNuevo   = ALLTRIM(STR(lnNuevo, 15, 3))
		lcNuevo   = STRTRAN(lcNuevo, ",", ".")
		lcArtCodi = ALLTRIM(STR(lnArtCodi))
		
		lnRet = SQLEXEC(lnConn, ;
		    "UPDATE articulos SET art_stmin = " + lcNuevo + ;
		    " WHERE art_codi = " + lcArtCodi)
		
		Desconectar_DB(lnConn)
		
		IF lnRet < 0
		    MESSAGEBOX("Error al guardar Pos.Min.", 16, "Error")
		    IF VARTYPE(loFrm) = "O" AND PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.SetFocus()
		    ENDIF
		    RETURN
		ENDIF
		
		*--- Actualizar cur_alerts
		IF USED("cur_alerts")
		    SELECT cur_alerts
		    LOCATE FOR art_codi = lnArtCodi
		    IF FOUND()
		        REPLACE art_stmin WITH lnNuevo
		        llFound = .T.
		    ENDIF
		ENDIF
		
		*--- Actualizar cur_raw_full
		IF USED("cur_raw_full")
		    SELECT cur_raw_full
		    LOCATE FOR art_codi = lnArtCodi
		    IF FOUND()
		        REPLACE art_stmin WITH lnNuevo
		    ENDIF
		ENDIF
		
		*--- Refrescar UI
		IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		    THISFORMSET.RefrescarGrid()
		ENDIF
		
		*--- Reposicionar nuevamente en el artículo editado
		IF USED("cur_alerts")
		    SELECT cur_alerts
		    LOCATE FOR art_codi = lnArtCodi
		    IF !FOUND() AND BETWEEN(lnRecAlerts, 1, RECCOUNT("cur_alerts"))
		        GO lnRecAlerts
		    ENDIF
		ENDIF
		
		*--- Sincronizar selección visual / variables del formulario
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		    THISFORMSET.ActualizarEfectoGrid()
		ENDIF
		
		*--- Devolver foco a la grilla
		IF VARTYPE(loFrm) = "O" AND PEMSTATUS(loFrm, "grd_alerts", 5)
		    loFrm.grd_alerts.SetFocus()
		    loFrm.grd_alerts.Refresh()
		ENDIF
	ENDPROC

	PROCEDURE ejecutarconfirmacionsolicitud
		*=========================================================
		* FormSet.EjecutarConfirmacionSolicitud
		* - Ejecuta la creación/modificación REAL de la solicitud
		* - Recibe la observación final ya resuelta
		*=========================================================
		LPARAMETERS tcObs
		
		LOCAL loFrm, loConsulta
		LOCAL lnConn, lnRet, lnSoliCodi, lcSQL, lcObs, loEx
		LOCAL lcOldSafety, lnConnReport, lnRetReport, lcSQLReport
		LOCAL llErrorTransaccion, lcAliasReport, lcAliasRawReport
		LOCAL lnErr, lcErrMsg, llModoEdicion
		LOCAL lnCantVal, lnCantDet
		LOCAL lnOrdenLinea, lcObsArt
		LOCAL lnItemReporte
		LOCAL ARRAY laError[1]
		
		loFrm = THISFORMSET.principal
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		lcAliasReport      = "cur_print_solicitud"
		lcAliasRawReport   = "cur_print_solicitud_raw"
		lnConn             = 0
		lnConnReport       = 0
		lnRetReport        = 0
		llErrorTransaccion = .F.
		lcErrMsg           = ""
		lnCantVal          = 0
		lnCantDet          = 0
		llModoEdicion      = .F.
		lcObs              = ""
		lnOrdenLinea       = 0
		lnItemReporte      = 0
		lcObsArt           = ""
		
		IF VARTYPE(tcObs) = "C"
		    lcObs = ALLTRIM(tcObs)
		ELSE
		    lcObs = ""
		ENDIF
		
		*---------------------------------------------------------
		* Asegurar propiedades de edición
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "xSoliEditando", 5)
		    THISFORMSET.AddProperty("xSoliEditando", 0)
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xObsEditando", 5)
		    THISFORMSET.AddProperty("xObsEditando", "")
		ENDIF
		
		IF VARTYPE(THISFORMSET.xSoliEditando) = "N"
		    IF THISFORMSET.xSoliEditando > 0
		        llModoEdicion = .T.
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* Conexión
		*---------------------------------------------------------
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		TRY
		    *-----------------------------------------------------
		    * 2. TRANSACCIÓN
		    *-----------------------------------------------------
		    IF SQLEXEC(lnConn, "START TRANSACTION") < 0
		        ERROR "No se pudo iniciar la transacción."
		    ENDIF
		
		    IF llModoEdicion
		        *-------------------------------------------------
		        * MODO EDICIÓN: ACTUALIZA LA MISMA SOLICITUD
		        *-------------------------------------------------
		        lnSoliCodi = THISFORMSET.xSoliEditando
		
		        IF VARTYPE(lnSoliCodi) <> "N" OR lnSoliCodi <= 0
		            ERROR "La solicitud en edición es inválida."
		        ENDIF
		
		        lnCantVal = 0
		        IF SQLEXEC(lnConn, ;
		            "SELECT COUNT(*) AS cant FROM solicitud_compra WHERE soli_codi = ?lnSoliCodi", ;
		            "cur_val_soli") < 0 OR !USED("cur_val_soli")
		            ERROR "No se pudo validar la solicitud a modificar."
		        ENDIF
		
		        SELECT cur_val_soli
		        IF RECCOUNT("cur_val_soli") > 0
		            IF VARTYPE(cur_val_soli.cant) = "C"
		                lnCantVal = VAL(ALLTRIM(cur_val_soli.cant))
		            ELSE
		                lnCantVal = NVL(cur_val_soli.cant, 0)
		            ENDIF
		        ELSE
		            lnCantVal = 0
		        ENDIF
		        USE IN cur_val_soli
		
		        IF lnCantVal <= 0
		            ERROR "La solicitud que intenta modificar ya no existe."
		        ENDIF
		
		        lcSQL = ;
		            "UPDATE solicitud_compra " + ;
		            "SET observaciones = ?lcObs, soli_fecha = NOW() " + ;
		            "WHERE soli_codi = ?lnSoliCodi"
		
		        IF SQLEXEC(lnConn, lcSQL) < 0
		            ERROR "Error al actualizar el encabezado de la solicitud."
		        ENDIF
		
		        lcSQL = "DELETE FROM solicitud_compra_art WHERE soli_codi = ?lnSoliCodi"
		        IF SQLEXEC(lnConn, lcSQL) < 0
		            ERROR "Error al eliminar el detalle anterior de la solicitud."
		        ENDIF
		
		    ELSE
		        *-------------------------------------------------
		        * MODO NUEVO: CREA NUEVA SOLICITUD
		        *-------------------------------------------------
		        lcSQL = ;
		            "INSERT INTO solicitud_compra (soli_fecha, estado, observaciones) " + ;
		            "VALUES (NOW(), 'PENDIENTE', ?lcObs)"
		
		        IF SQLEXEC(lnConn, lcSQL) < 0
		            ERROR "Error al insertar el encabezado en la base de datos."
		        ENDIF
		
		        IF SQLEXEC(lnConn, "SELECT LAST_INSERT_ID() AS nuevo_id", "cur_id") < 0 OR !USED("cur_id")
		            ERROR "No se pudo obtener el ID de la solicitud generada."
		        ENDIF
		
		        SELECT cur_id
		        IF RECCOUNT("cur_id") > 0
		            IF VARTYPE(cur_id.nuevo_id) = "C"
		                lnSoliCodi = VAL(ALLTRIM(cur_id.nuevo_id))
		            ELSE
		                lnSoliCodi = NVL(cur_id.nuevo_id, 0)
		            ENDIF
		        ELSE
		            lnSoliCodi = 0
		        ENDIF
		        USE IN cur_id
		
		        IF lnSoliCodi <= 0
		            ERROR "El ID de la solicitud generado es inválido."
		        ENDIF
		    ENDIF
		
		    *-------------------------------------------------
		    * Sincronizar proveedor/costo elegidos en pantalla
		    *-------------------------------------------------
		    IF PEMSTATUS(THISFORMSET, "SincronizarProveedoresSeleccionadosEnTemp", 5)
		        IF !THISFORMSET.SincronizarProveedoresSeleccionadosEnTemp(lnConn)
		            ERROR "No se pudo sincronizar proveedor/costo de los artículos seleccionados."
		        ENDIF
		    ENDIF
		
			*-------------------------------------------------
			* Insertar nuevo detalle desde temp
			* Regla de transporte:
			* - Si temp_solicitud_compra.tran_codi viene informado, se respeta.
			* - Si viene NULL/0, se toma el último transporte usado
			*   por el proveedor en compras.
			* - Todos los artículos del mismo prov_codi heredan el mismo tran_codi.
			*-------------------------------------------------
			TEXT TO lcSQL NOSHOW PRETEXT 15
			    INSERT INTO solicitud_compra_art (
			        soli_codi,
			        art_codi,
			        cant_soli,
			        posicion,
			        art_stmin,
			        prov_codi,
			        tran_codi,
			        artpro_costo,
			        observacion
			    )
			    SELECT
			        ?lnSoliCodi,
			        t.art_codi,
			        IFNULL(t.cant_soli, 0),
			        (IFNULL(a.art_stock,0) + IFNULL(a.pedprov,0) - IFNULL(a.pedidos,0)) AS posicion,
			        IFNULL(a.art_stmin, 0) AS art_stmin,
			        NULLIF(IFNULL(t.prov_codi, 0), 0) AS prov_codi,
		
			        NULLIF(
			            IFNULL(
			                NULLIF(IFNULL(t.tran_codi, 0), 0),
			                IFNULL((
			                    SELECT c2.tran_codi
			                    FROM compras c2
			                    WHERE c2.prov_codi = t.prov_codi
			                      AND IFNULL(c2.tran_codi, 0) > 0
			                      AND UPPER(TRIM(IFNULL(c2.anulado, ''))) NOT IN ('S', '1')
			                    ORDER BY c2.orden_fech DESC, c2.orden_codi DESC
			                    LIMIT 1
			                ), 0)
			            ),
			            0
			        ) AS tran_codi,
		
			        IFNULL(t.artpro_costo, 0),
			        NULLIF(IFNULL(t.observacion,''), '')
			    FROM temp_solicitud_compra t
			    INNER JOIN articulos a
			        ON a.art_codi = t.art_codi
			ENDTEXT
		
			IF SQLEXEC(lnConn, lcSQL) < 0
			    ERROR "Error al insertar el detalle de los artículos."
			ENDIF
		
		    *-------------------------------------------------
		    * Validar detalle final
		    *-------------------------------------------------
		    lnCantDet = 0
		    lcSQL = "SELECT COUNT(*) AS cant_det FROM solicitud_compra_art WHERE soli_codi = ?lnSoliCodi"
		
		    IF SQLEXEC(lnConn, lcSQL, "cur_chk_det") < 0 OR !USED("cur_chk_det")
		        ERROR "No se pudo validar el detalle insertado."
		    ENDIF
		
		    SELECT cur_chk_det
		    IF RECCOUNT("cur_chk_det") > 0
		        IF VARTYPE(cur_chk_det.cant_det) = "C"
		            lnCantDet = VAL(ALLTRIM(cur_chk_det.cant_det))
		        ELSE
		            lnCantDet = NVL(cur_chk_det.cant_det, 0)
		        ENDIF
		    ELSE
		        lnCantDet = 0
		    ENDIF
		    USE IN cur_chk_det
		
		    IF lnCantDet <= 0
		        ERROR "La solicitud no tiene detalle. Operación cancelada."
		    ENDIF
		
		    *-------------------------------------------------
		    * Limpiar temp dentro de la misma transacción
		    *-------------------------------------------------
		    IF !THISFORMSET.CRUDTempSolicitudCompra("CLEAR", 0, 0, 0, 0, "", lnConn)
		        ERROR "No se pudo limpiar la tabla temporal."
		    ENDIF
		
		    IF SQLEXEC(lnConn, "COMMIT") < 0
		        ERROR "No se pudo confirmar la transacción."
		    ENDIF
		
		    Desconectar_DB(lnConn)
		    lnConn = 0
		
		    *-----------------------------------------------------
		    * 3. LIMPIEZA Y REFRESH UI
		    *-----------------------------------------------------
		    THISFORMSET.xSoliEditando = 0
		    THISFORMSET.xObsEditando  = ""
		
		    lcOldSafety = SET("SAFETY")
		    SET SAFETY OFF
		
		    IF USED("cur_alerts")
		        SELECT cur_alerts
		        ZAP
		    ENDIF
		
		    IF USED("cur_alerts_ped")
		        SELECT cur_alerts_ped
		        ZAP
		    ENDIF
		
		    IF UPPER(ALLTRIM(lcOldSafety)) == "ON"
		        SET SAFETY ON
		    ELSE
		        SET SAFETY OFF
		    ENDIF
		
		    IF USED("cur_raw_full")
		        THISFORMSET.CargarAlertasStockFull()
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xFiltroActual", 5)
		        loFrm.xFiltroActual = "SELECCIONADOS"
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xRubCodiActual", 5)
		        loFrm.xRubCodiActual = 0
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "combo1", 5)
		        loFrm.combo1.DisplayValue = "SELECCIONADOS"
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "cmd_confirmar", 5)
		        loFrm.cmd_confirmar.Caption = "Confirmar"
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "lbl_modo_edicion", 5)
		        loFrm.lbl_modo_edicion.Caption = ""
		        loFrm.lbl_modo_edicion.Visible = .F.
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		        THISFORMSET.AplicarFiltroLocal("SELECCIONADOS", 0)
		    ENDIF
		    
		    IF PEMSTATUS(THISFORMSET, "ActualizarVisibilidadColumnaObservacion", 5)
		    	THISFORMSET.ActualizarVisibilidadColumnaObservacion()
			ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		        THISFORMSET.RefrescarGrid()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "SincronizarPedido", 5)
		        THISFORMSET.SincronizarPedido()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		        THISFORMSET.SincronizarBotonMasivo()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "RefreshVentaCompraGrid", 5)
		        THISFORMSET.RefreshVentaCompraGrid()
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "CargarHistorialSolicitudes", 5)
		        THISFORMSET.CargarHistorialSolicitudes()
		    ENDIF
		
		    IF VARTYPE(loConsulta) = "O"
		        IF PEMSTATUS(loConsulta, "xSoliCodiActual", 5)
		            loConsulta.xSoliCodiActual = lnSoliCodi
		        ENDIF
		    ENDIF
		
		    WAIT CLEAR
		
		    IF llModoEdicion
		        MESSAGEBOX("¡Solicitud N° " + TRANSFORM(lnSoliCodi) + " modificada con éxito!", 64, "Guardado")
		    ELSE
		        MESSAGEBOX("¡ÉXITO! Se ha generado la Solicitud N° " + TRANSFORM(lnSoliCodi), 64, "Proceso Terminado")
		    ENDIF
		
		CATCH TO loEx
		    IF VARTYPE(lnConn) = "N" AND lnConn > 0
		        SQLEXEC(lnConn, "ROLLBACK")
		        Desconectar_DB(lnConn)
		        lnConn = 0
		    ENDIF
		
		    llErrorTransaccion = .T.
		    WAIT CLEAR
		    MESSAGEBOX("Error Crítico en Transacción:" + CHR(13) + TRANSFORM(loEx.Message), 16, "Error")
		ENDTRY
		
		IF llErrorTransaccion OR lnSoliCodi <= 0
		    WAIT CLEAR
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 4. REPORTE
		*---------------------------------------------------------
		WAIT WINDOW "Abriendo entorno de impresión..." NOWAIT
		
		IF USED(lcAliasReport)
		    USE IN (lcAliasReport)
		ENDIF
		
		lnConnReport = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConnReport) <> "N" OR lnConnReport <= 0
		    WAIT CLEAR
		    MESSAGEBOX("No se pudo conectar para el reporte.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		SQLEXEC(lnConnReport, "SET SESSION group_concat_max_len = 65536")
		
		TEXT TO lcSQLReport NOSHOW PRETEXT 15
		    SELECT
				s.soli_codi,
				s.soli_fecha,
				s.observaciones,
				IFNULL(d.observacion, '') AS observacion_articulo,
				d.art_codi,
		        a.art_desc,
		        COALESCE(p.prov_nomb, '')           AS prov_nomb,
		        IFNULL(d.artpro_costo, 0)           AS artpro_costo,
		        IFNULL(ap.moneda, 'ARS')            AS moneda,
		        d.cant_soli                         AS cant_sug,
		        IFNULL(a.art_stock, 0)              AS art_stock,
		        IFNULL(a.pedprov, 0)                AS art_pedprov,
		        IFNULL(a.pedidos, 0)                AS art_pedidos,
		        d.posicion,
		        d.art_stmin,
		        IFNULL(m.art_pct_alerta, 30.00)     AS art_pct_alerta,
		        COALESCE(cult.cli_nomb, '')         AS ult_cliente
		    FROM solicitud_compra s
		    INNER JOIN solicitud_compra_art d
		        ON s.soli_codi = d.soli_codi
		    INNER JOIN articulos a
		        ON d.art_codi = a.art_codi
		    LEFT JOIN art_metricas m
		        ON m.art_codi = a.art_codi
		    LEFT JOIN proveedores p
		        ON p.prov_codi = d.prov_codi
		    LEFT JOIN articulos_proveedores ap
		        ON ap.art_codi  = d.art_codi
		       AND ap.prov_codi = d.prov_codi
		    LEFT JOIN (
		        SELECT pa.art_codi,
		               SUBSTRING_INDEX(
		                   GROUP_CONCAT(c.cli_nomb
		                       ORDER BY p2.ped_fech DESC, p2.ped_codi DESC
		                       SEPARATOR '||'),
		                   '||', 1
		               ) AS cli_nomb
		        FROM pedidos_articulos pa
		        INNER JOIN pedidos p2 ON p2.ped_codi = pa.ped_codi
		        INNER JOIN clientes c ON c.cli_codi = p2.cli_codi
		        WHERE p2.finalizado = 0
		        GROUP BY pa.art_codi
		    ) cult ON cult.art_codi = d.art_codi
		    WHERE s.soli_codi = ?lnSoliCodi
		    ORDER BY prov_nomb ASC, a.art_desc ASC
		ENDTEXT
		
		IF USED(lcAliasRawReport)
		    USE IN (lcAliasRawReport)
		ENDIF
		
		lnRetReport = SQLEXEC(lnConnReport, lcSQLReport, lcAliasRawReport)
		
		IF lnRetReport > 0 AND USED(lcAliasRawReport)
		
		    SELECT (lcAliasRawReport)
		
		    IF RECCOUNT() > 0
		
		        IF USED(lcAliasReport)
		            USE IN (lcAliasReport)
		        ENDIF
		
				CREATE CURSOR cur_print_solicitud ( ;
				    orden_linea          I, ;
				    item_reporte         C(8), ;
				    tipo_linea           C(1), ;
		            soli_codi            I, ;
		            soli_fecha           T, ;
		            observaciones        M, ;
		            observacion_articulo M, ;
		            art_codi             I, ;
		            art_desc             C(250), ;
		            prov_nomb            C(100), ;
		            artpro_costo         N(15,4), ;
		            moneda               C(10), ;
		            cant_sug             N(15,3), ;
		            art_stock            N(15,3), ;
		            art_pedprov          N(15,3), ;
		            art_pedidos          N(15,3), ;
		            posicion             N(15,3), ;
		            art_stmin            N(15,3), ;
		            art_pct_alerta       N(10,2), ;
		            ult_cliente          C(100) )
		
		        lnOrdenLinea = 0
		
		        SELECT (lcAliasRawReport)
		        GO TOP
		
		        SCAN
		
						*---------------------------------------------
						* Línea normal del artículo
						*---------------------------------------------
						lnOrdenLinea  = lnOrdenLinea + 1
						lnItemReporte = lnItemReporte + 1
		
						INSERT INTO cur_print_solicitud ;
						    (orden_linea, item_reporte, tipo_linea, soli_codi, soli_fecha, observaciones, ;
						     observacion_articulo, art_codi, art_desc, prov_nomb, artpro_costo, ;
						     moneda, cant_sug, art_stock, art_pedprov, art_pedidos, posicion, ;
						     art_stmin, art_pct_alerta, ult_cliente) ;
						VALUES ;
						    (lnOrdenLinea, ;
						     TRANSFORM(lnItemReporte), ;
						     "A", ;
		                 cur_print_solicitud_raw.soli_codi, ;
		                 cur_print_solicitud_raw.soli_fecha, ;
		                 cur_print_solicitud_raw.observaciones, ;
		                 cur_print_solicitud_raw.observacion_articulo, ;
		                 cur_print_solicitud_raw.art_codi, ;
		                 cur_print_solicitud_raw.art_desc, ;
		                 cur_print_solicitud_raw.prov_nomb, ;
		                 cur_print_solicitud_raw.artpro_costo, ;
		                 cur_print_solicitud_raw.moneda, ;
		                 cur_print_solicitud_raw.cant_sug, ;
		                 cur_print_solicitud_raw.art_stock, ;
		                 cur_print_solicitud_raw.art_pedprov, ;
		                 cur_print_solicitud_raw.art_pedidos, ;
		                 cur_print_solicitud_raw.posicion, ;
		                 cur_print_solicitud_raw.art_stmin, ;
		                 cur_print_solicitud_raw.art_pct_alerta, ;
		                 cur_print_solicitud_raw.ult_cliente )
		
		            *---------------------------------------------
		            * Línea de observación del artículo
		            *---------------------------------------------
		            lcObsArt = ""
		
		            IF TYPE("cur_print_solicitud_raw.observacion_articulo") <> "U"
		                lcObsArt = ALLTRIM(NVL(cur_print_solicitud_raw.observacion_articulo, ""))
		            ENDIF
		
		            IF !EMPTY(lcObsArt)
		
		                lnOrdenLinea = lnOrdenLinea + 1
		
							INSERT INTO cur_print_solicitud ;
							    (orden_linea, item_reporte, tipo_linea, soli_codi, soli_fecha, observaciones, ;
							     observacion_articulo, art_codi, art_desc, prov_nomb, artpro_costo, ;
							     moneda, cant_sug, art_stock, art_pedprov, art_pedidos, posicion, ;
							     art_stmin, art_pct_alerta, ult_cliente) ;
							VALUES ;
							    (lnOrdenLinea, ;
							     "", ;
							     "O", ;
		                     cur_print_solicitud_raw.soli_codi, ;
		                     cur_print_solicitud_raw.soli_fecha, ;
		                     cur_print_solicitud_raw.observaciones, ;
		                     lcObsArt, ;
		                     0, ;
		                     "   Obs:", ;
		                     "", ;
		                     0, ;
		                     "", ;
		                     0, ;
		                     0, ;
		                     0, ;
		                     0, ;
		                     0, ;
		                     0, ;
		                     0, ;
		                     "" )
		
		            ENDIF
		
		            SELECT (lcAliasRawReport)
		
		        ENDSCAN
		
		        USE IN (lcAliasRawReport)
		
		        SELECT cur_print_solicitud
		        GO TOP
		
		        WAIT CLEAR
		        REPORT FORM rpt_solicitud_compra TO PRINTER PROMPT NOCONSOLE
		
		    ELSE
		        WAIT CLEAR
		        MESSAGEBOX("MySQL no encontró registros para la Solicitud N° " + TRANSFORM(lnSoliCodi), 48, "Sin Datos")
		    ENDIF
		
		ELSE
		    lnErr = AERROR(laError)
		    lcErrMsg = "Desconocido"
		    IF lnErr > 0
		        IF ALEN(laError, 1) >= 1
		            IF TYPE("laError[1,3]") <> "U"
		                lcErrMsg = TRANSFORM(laError[1,3])
		            ELSE
		                lcErrMsg = TRANSFORM(laError[1])
		            ENDIF
		        ENDIF
		    ENDIF
		
		    WAIT CLEAR
		    MESSAGEBOX("Error al generar cursor de reporte:" + CHR(13) + lcErrMsg, 16, "Error de MySQL")
		ENDIF
		
		IF VARTYPE(lnConnReport) = "N" AND lnConnReport > 0
		    Desconectar_DB(lnConnReport)
		ENDIF
		
		WAIT CLEAR
		RETURN .T.
	ENDPROC

	PROCEDURE forzarcomboseleccionados
		*=========================================================
		* FormSet.ForzarComboSeleccionados
		* - Fuerza combo1 al valor SELECCIONADOS
		* - Compatible con RowSourceType 1 / listas simples
		*=========================================================
		LOCAL loFrm, loCombo
		LOCAL lnI, lcItem
		
		loFrm = THISFORMSET.principal
		
		IF VARTYPE(loFrm) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loFrm, "combo1", 5)
		    RETURN .F.
		ENDIF
		
		loCombo = loFrm.combo1
		
		*---------------------------------------------------------
		* Estado lógico del filtro
		*---------------------------------------------------------
		IF !PEMSTATUS(loFrm, "xFiltroActual", 5)
		    loFrm.AddProperty("xFiltroActual", "")
		ENDIF
		
		loFrm.xFiltroActual = "SELECCIONADOS"
		
		*---------------------------------------------------------
		* Intento directo
		*---------------------------------------------------------
		TRY
		    loCombo.Value = "SELECCIONADOS"
		CATCH
		ENDTRY
		
		TRY
		    loCombo.DisplayValue = "SELECCIONADOS"
		CATCH
		ENDTRY
		
		*---------------------------------------------------------
		* Intento por ListIndex
		*---------------------------------------------------------
		TRY
		    FOR lnI = 1 TO loCombo.ListCount
		        lcItem = UPPER(ALLTRIM(TRANSFORM(loCombo.List(lnI))))
		
		        IF lcItem == "SELECCIONADOS"
		            loCombo.ListIndex = lnI
		            EXIT
		        ENDIF
		    ENDFOR
		CATCH
		ENDTRY
		
		loCombo.Refresh()
		
		RETURN .T.
	ENDPROC

	PROCEDURE grabarorden
		&& altaocpra.GrabarOrden
		LPARAMETERS tcCursorItems
		
		LOCAL xcodip, xfecha, xref, xdto, xcoti, xdasc, xarti, xdap
		LOCAL xcant, xprec, xmone, lnLock, frmaltac, xcadena, xdesc_item
		
		IF !USED(tcCursorItems) OR RECCOUNT(tcCursorItems) = 0
		    RETURN .F.
		ENDIF
		
		xmone  = _screen.moneocpra
		xfecha = thisform.text13.value
		xdto   = thisform.text19.value
		xref   = ALLTRIM(thisform.text20.value)
		
		frmaltac = conectar_db(_screen.cn)
		    SQLEXEC(frmaltac,"select param_impo from parametros where param_codi=9;","cur_coti")
		    xcoti = cur_coti.param_impo
		    cerrar_cursor("cur_coti")
		desconectar_db(frmaltac)
		
		*-- 1. Cabecera
		frmaltac = conectar_db(_screen.cn)
		    lnLock = MySQL_LockTables("LOCK","compras WRITE",frmaltac)
		    SQLEXEC(frmaltac,"select cast(orden_codi+1 as DECIMAL(8,0)) as orden_codi from compras order by orden_codi desc limit 1;","cur_nvoc")
		    xcodip = cur_nvoc.orden_codi
		    cerrar_cursor("cur_nvoc")
		    SQLEXEC(frmaltac,"insert into compras values(?xcodip,?xfecha,?thisform.codiprov,?xref,?obser,?xdto,?coditran,?codiva,'','',?xcoti,?xmone);")
		    lnLock = MySQL_LockTables("UNLOCK","",frmaltac)
		desconectar_db(frmaltac)
		
		*-- 2. Artículos
		SELECT (tcCursorItems)
		SCAN
		    *-- Leer todos los campos al inicio, antes de cualquier SELECT intermedio
		    xarti      = art_codi
		    xcant      = art_cant
		    xprec      = art_prec
		    xdesc_item = art_desc
		    xdasc      = ""
		    xdap       = 0
		
		    IF xarti <= 5
		        xdasc = ALLTRIM(xdesc_item)
		    ENDIF
		
		    IF xarti > 5
		        frmaltac = conectar_db(_screen.cn)
		            SQLEXEC(frmaltac,"select * from articulos_proveedores where prov_codi=?thisform.codiprov and art_codi=?xarti;","cur_artpro")
		        desconectar_db(frmaltac)
		        IF RECCOUNT("cur_artpro") > 0
		            xcadena = ALLTRIM(STR(cur_artpro.artpro_codi)) + ALLTRIM(xdesc_item)
		            frmaltac = conectar_db(_screen.cn)
		                SQLEXEC(frmaltac,"select * from desc_articulos_proveedores where concat(cast(artpro_codi as char),TRIM(dap_desc))=?xcadena;","cur_ddes")
		            desconectar_db(frmaltac)
		            IF RECCOUNT("cur_ddes") > 0
		                xdap = cur_ddes.dap_codi
		            ENDIF
		            cerrar_cursor("cur_ddes")
		        ENDIF
		        cerrar_cursor("cur_artpro")
		    ENDIF
		
		    frmaltac = conectar_db(_screen.cn)
		        lnLock = MySQL_LockTables("LOCK","compras_articulos WRITE",frmaltac)
		        SQLEXEC(frmaltac,"select cast(artord_codi+1 as DECIMAL(8,0)) as artord_codi from compras_articulos order by artord_codi desc limit 1;","cur_ordnva")
		        SQLEXEC(frmaltac,"insert into compras_articulos values(?cur_ordnva.artord_codi,?xcodip,?xarti,?xprec,?xcant,0,?xdasc,0,?xdap,0);")
		        cerrar_cursor("cur_ordnva")
		        lnLock = MySQL_LockTables("UNLOCK","",frmaltac)
		    desconectar_db(frmaltac)
		
		    IF xarti > 5
		        Campo_ppr(xarti)
		    ENDIF
		
		    *-- Volver al cursor de items para que SCAN avance correctamente
		    SELECT (tcCursorItems)
		ENDSCAN
		
		*-- 3. Reporte
		frmaltac = conectar_db(_screen.cn)
		    SQLEXEC(frmaltac,"select b.*,c.*,d.cond_desc from compras a inner join iva b on a.iva_codi=b.iva_codi inner join proveedores c on c.prov_codi=a.prov_codi inner join condiva d on c.cond_codi=d.cond_codi where a.orden_codi=?xcodip;","cur_datvar")
		    SQLEXEC(frmaltac,"select a.*,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on c.provi_coci=a.provi_coci where a.loca_codi=?cur_datvar.loca_codi;","cur_ubic")
		    SQLEXEC(frmaltac,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dap_desc from compras_articulos a inner join articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_proveedores c on c.dap_codi=a.dap_codi where a.orden_codi=?xcodip order by a.artord_codi;","cur_arcom")
		    SQLEXEC(frmaltac,"select * from compras where orden_codi=?xcodip;","cur_cpra")
		    SQLEXEC(frmaltac,"select * from transportes where tran_codi=?coditran;","cur_tra")
		desconectar_db(frmaltac)
		
		SET DATABASE TO
		LOCAL lcOldPt, lcOldSep, lcOldDec
		lcOldPt  = SET("POINT")
		lcOldSep = SET("SEPARATOR")
		lcOldDec = SET("DECIMALS")
		SET DECIMALS TO 4
		SET POINT TO ","
		SET SEPARATOR TO "."
		SELECT cur_arcom
		GO TOP
		report form ordendecompra for cur_cpra.orden_codi=xcodip to printer noconsole
		SET POINT TO (lcOldPt)
		SET SEPARATOR TO (lcOldSep)
		SET DECIMALS TO &lcOldDec
		
		RETURN xcodip
		
	ENDPROC

	PROCEDURE grdprovdblclick
		*=========================================================
		* FormSet.GrdProvDblClick
		*=========================================================
		LOCAL loFrm
		LOCAL lcNomb, lnCodi, lnCosto, lcMoneda
		LOCAL lnResp, lnConn, lnArt
		
		loFrm = THISFORMSET.principal
		
		IF !USED("cur_provs_col10") OR RECCOUNT("cur_provs_col10") = 0 OR EOF("cur_provs_col10")
		    RETURN
		ENDIF
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0 OR EOF("cur_alerts")
		    RETURN
		ENDIF
		
		SELECT cur_provs_col10
		lcNomb   = ALLTRIM(cur_provs_col10.prov_nomb)
		lnCodi   = cur_provs_col10.prov_codi
		lnCosto  = cur_provs_col10.artpro_costo
		lcMoneda = ALLTRIM(cur_provs_col10.artpro_moneda)
		
		IF EMPTY(lcNomb)
		    RETURN
		ENDIF
		
		lnResp = MESSAGEBOX( ;
		    "¿Seleccionar proveedor para:" + CHR(13) + ;
		    "   " + ALLTRIM(cur_alerts.art_desc) + CHR(13) + CHR(13) + ;
		    "Proveedor:  " + lcNomb + CHR(13) + ;
		    "Costo:      " + TRANSFORM(lnCosto) + "  " + lcMoneda, ;
		    36, "Confirmar proveedor")
		
		IF lnResp <> 6
		    RETURN
		ENDIF
		
		*-- 1) Actualizar cur_alerts
		SELECT cur_alerts
		REPLACE prov_nomb_sel WITH lcNomb,   ;
		        prov_codi_sel WITH lnCodi,   ;
		        artpro_costo  WITH lnCosto,  ;
		        artpro_moneda WITH lcMoneda
		
		*-- 2) Si el ítem está seleccionado, actualizar MySQL
		IF TYPE("cur_alerts.ui_sel") = "L" AND cur_alerts.ui_sel
		    lnArt = cur_alerts.art_codi
		    TRY
		        lnConn = Conectar_DB(_screen.cn)
		        IF VARTYPE(lnConn) = "N" AND lnConn > 0
		            SQLEXEC(lnConn, ;
		                "UPDATE temp_solicitud_compra " + ;
		                "SET prov_codi = ?lnCodi, artpro_costo = ?lnCosto " + ;
		                "WHERE art_codi = ?lnArt")
		            Desconectar_DB(lnConn)
		        ENDIF
		    CATCH
		    ENDTRY
		ENDIF
		
		*-- 3) Refrescar columnas afectadas
		TRY
		    loFrm.grd_alerts.Columns(10).Refresh()
		    loFrm.grd_alerts.Columns(11).Refresh()
		    loFrm.grd_alerts.Columns(12).Refresh()
		CATCH
		ENDTRY
		
		IF PEMSTATUS(loFrm, "shpSelRow", 5)
		    loFrm.shpSelRow.Visible = .T.
		ENDIF
		
		TRY
		    loFrm.grd_alerts.SetFocus()
		CATCH
		ENDTRY
		
		RETURN
		
	ENDPROC

	PROCEDURE grdvc_keypress
		*=========================================================
		* FormSet.GrdVC_KeyPress
		* Enter sobre grd_venta_compra = equivalente a DblClick
		*=========================================================
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode <> 13
		    RETURN
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "AbrirTerciarioDesdeGridVC", 5)
		    THISFORMSET.AbrirTerciarioDesdeGridVC()
		ENDIF
		
		NODEFAULT
		RETURN
	ENDPROC

	PROCEDURE grid2afterrowcolchange
		*=========================================================
		* FormSet.Grid2AfterRowColChange
		* Auto-abre el combo de transporte al entrar a columna 8
		*=========================================================
		LPARAMETERS nColIndex
		
		*-- Sincronizar combo en cualquier cambio de fila
		IF PEMSTATUS(THISFORMSET, "SincronizarComboTransporte", 5)
		    THISFORMSET.SincronizarComboTransporte()
		ENDIF
		
		*-- Auto-abrir dropdown solo si el usuario está parado en col 8
		*-- Sincronizar combo en cualquier cambio de fila
		IF PEMSTATUS(THISFORMSET, "SincronizarComboTransporte", 5)
		    THISFORMSET.SincronizarComboTransporte()
		ENDIF
		
		IF nColIndex <> 8
		    RETURN
		ENDIF
		
		LOCAL loGrid, loCombo
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN
		ENDIF
		
		loGrid = THISFORMSET.secundario.grid2
		
		IF VARTYPE(loGrid) <> "O"
		    RETURN
		ENDIF
		
		IF !PEMSTATUS(loGrid.Columns(8), "cboTransporte", 5)
		    RETURN
		ENDIF
		
		loCombo = loGrid.Columns(8).cboTransporte
		
		IF VARTYPE(loCombo) <> "O"
		    RETURN
		ENDIF
		
		TRY
		    loCombo.SetFocus()
		    loCombo.DropDown()
		CATCH
		ENDTRY
		
	ENDPROC

	PROCEDURE gridclick
		*=========================================================
		* FormSet.GridClick - Interacción exacta por coordenadas
		*=========================================================
		LOCAL loFrm, lnX, lnY, lnWhere, lnRelRow, lnRelCol, lnRealColIndex
		
		loFrm = THISFORMSET.principal
		
		IF !PEMSTATUS(loFrm, "grd_alerts", 5)
		    RETURN .F.
		ENDIF
		
		* 1. Capturamos las coordenadas del mouse en píxeles relativas al formulario
		lnX = MCOL(loFrm.Name, 3)
		lnY = MROW(loFrm.Name, 3)
		
		lnWhere  = 0
		lnRelRow = 0
		lnRelCol = 0
		
		* 2. Consultamos exactamente qué hay debajo del puntero del mouse
		IF loFrm.grd_alerts.GridHitTest(lnX, lnY, @lnWhere, @lnRelRow, @lnRelCol)
		    
		    * lnWhere = 3 significa que el clic fue estrictamente dentro de una CELDA
		    IF lnWhere = 3 AND lnRelCol > 0
		        
		        * 3. Calculamos la columna real (esto evita errores si la grilla tiene barra de scroll horizontal)
		        lnRealColIndex = loFrm.grd_alerts.LeftColumn + lnRelCol - 1
		        
		        * 4. Si es la columna 14, disparamos la apertura del form cuaterno
		        IF lnRealColIndex = 14
		            
		            * Opcional: Mantener visible el shape de selección
		            IF PEMSTATUS(loFrm, "shpSelRow", 5)
		                loFrm.shpSelRow.Visible = .T.
		            ENDIF
		            
		            * Disparamos tu método
		            IF PEMSTATUS(THISFORMSET, "BtnObsArticuloClickPrincipal", 5)
		                THISFORMSET.BtnObsArticuloClickPrincipal()
		            ENDIF
		            
		            RETURN .T.
		        ENDIF
		        
		    ENDIF
		ENDIF
		
		* Resto del comportamiento por defecto si se hace clic en otra parte
		IF PEMSTATUS(loFrm, "shpSelRow", 5)
		    loFrm.shpSelRow.Visible = .T.
		ENDIF
		
		TRY
		    loFrm.grd_alerts.SetFocus()
		CATCH
		ENDTRY
		
		RETURN .T.
	ENDPROC

	PROCEDURE griddblclick
		*=========================================================
		* FormSet.GridDblClick
		*=========================================================
		LOCAL loFrm
		LOCAL lnArtCodi, lnRecOld, lcFiltroActual, lnCol
		LOCAL lnCant, lcInput, lcArtDesc, lnResp
		LOCAL loEx
		LOCAL llSalir, llOk
		LOCAL lnProvCodi_, lnProvCosto_
		LOCAL laErr[1], lcDet, lnErrs
		LOCAL lnTargetArtCodi, lnRecActual
		
		loFrm = THISFORMSET.principal
		
		*---------------------------------------------------------
		* CONTROL ANTI-REBOTE (Debounce)
		* Evita el doble disparo si se encoló un "Doble Clic" físico 
		* mientras se estaba respondiendo un MessageBox/InputBox.
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "xUltimoTickDblClick", 5)
		    THISFORMSET.AddProperty("xUltimoTickDblClick", 0.00)
		ENDIF
		
		* Si la última acción finalizó hace menos de medio segundo, descartamos el evento residual
		IF SECONDS() - THISFORMSET.xUltimoTickDblClick < 0.5
		    THISFORMSET.xUltimoTickDblClick = SECONDS()
		    RETURN .T.
		ENDIF
		*---------------------------------------------------------
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") <= 0 OR EOF("cur_alerts")
		    RETURN .F.
		ENDIF
		
		lnCol = 0
		IF PEMSTATUS(loFrm, "grd_alerts", 5) AND PEMSTATUS(loFrm.grd_alerts, "ActiveColumn", 5)
		    lnCol = loFrm.grd_alerts.ActiveColumn
		ENDIF
		
		IF lnCol = 14
		    THISFORMSET.xUltimoTickDblClick = SECONDS()
		    IF PEMSTATUS(THISFORMSET, "BtnObsArticuloClickPrincipal", 5)
		        RETURN THISFORMSET.BtnObsArticuloClickPrincipal()
		    ENDIF
		    RETURN .T.
		ENDIF
		
		SELECT cur_alerts
		IF BOF()
		    GO TOP
		ENDIF
		
		lnArtCodi      = IIF(TYPE("cur_alerts.art_codi")="N", cur_alerts.art_codi, 0)
		lcArtDesc      = IIF(TYPE("cur_alerts.art_desc")="C", ALLTRIM(cur_alerts.art_desc), "")
		lnRecOld       = RECNO("cur_alerts")
		lcFiltroActual = UPPER(ALLTRIM(IIF(PEMSTATUS(loFrm, "xFiltroActual", 5), NVL(loFrm.xFiltroActual, ""), "")))
		
		IF lnArtCodi <= 0
		    RETURN .F.
		ENDIF
		
		llSalir      = .F.
		llOk         = .F.
		lnProvCodi_  = 0
		lnProvCosto_ = 0
		
		lnTargetArtCodi = lnArtCodi
		
		IF NVL(cur_alerts.ui_sel, .F.) AND lcFiltroActual == "SELECCIONADOS"
		    lnRecActual = RECNO("cur_alerts")
		    SKIP 1
		    IF !EOF("cur_alerts")
		        lnTargetArtCodi = art_codi
		    ELSE
		        GO lnRecActual IN cur_alerts
		        SKIP -1
		        IF !BOF("cur_alerts")
		            lnTargetArtCodi = art_codi
		        ELSE
		            lnTargetArtCodi = 0
		        ENDIF
		    ENDIF
		    GO lnRecActual IN cur_alerts
		ENDIF
		
		TRY
		    IF !NVL(cur_alerts.ui_sel, .F.)
		        *-----------------------------
		        * A) AGREGAR
		        *-----------------------------
		        lcInput = INPUTBOX( ;
		            "Ingrese cantidad para:" + CHR(13) + lcArtDesc, ;
		            "Agregar a Lista", ;
		            TRANSFORM(IIF(NVL(cur_alerts.sug_neto,0)>0, cur_alerts.sug_neto, 1)) )
		
		        IF EMPTY(ALLTRIM(lcInput))
		            llSalir = .T.
		        ELSE
		            lnCant = VAL(STRTRAN(ALLTRIM(lcInput), ",", "."))
		
		            IF lnCant <= 0
		                llSalir = .T.
		            ELSE
		                lnProvCodi_  = IIF(TYPE("cur_alerts.prov_codi_sel")="N", cur_alerts.prov_codi_sel, 0)
		                lnProvCosto_ = IIF(TYPE("cur_alerts.artpro_costo")="N", cur_alerts.artpro_costo, 0)
		
		                llOk = THISFORMSET.CRUDTempSolicitudCompra("SAVE", lnArtCodi, lnCant, lnProvCodi_, lnProvCosto_, "")
		
		                IF !llOk
		                    ERROR "Error SQL al agregar."
		                ENDIF
		
		                SELECT cur_alerts
		                LOCATE FOR art_codi = lnArtCodi
		                IF FOUND()
		                    REPLACE ui_sel WITH .T. IN cur_alerts
		
		                    IF PEMSTATUS(THISFORMSET, "SetArticuloSeleccionado", 5)
		                        THISFORMSET.SetArticuloSeleccionado(lnArtCodi, .T.)
		                    ENDIF
		
		                    IF TYPE("cur_alerts.cant_soli") = "N"
		                        REPLACE cant_soli WITH ROUND(lnCant, 3) IN cur_alerts
		                    ENDIF
		                ENDIF
		            ENDIF
		        ENDIF
		
		    ELSE
		        *-----------------------------
		        * B) QUITAR
		        *-----------------------------
		        lnResp = MESSAGEBOX( ;
		            "¿Está seguro de quitar de la lista?" + CHR(13) + lcArtDesc, ;
		            36, "Confirmar")
		
		        IF lnResp <> 6
		            llSalir = .T.
		        ELSE
		            llOk = THISFORMSET.CRUDTempSolicitudCompra("DELETE", lnArtCodi, 0, 0, 0, "")
		
		            IF !llOk
		                ERROR "Error SQL al eliminar."
		            ENDIF
		
		            IF lcFiltroActual == "SELECCIONADOS"
		                THISFORMSET.AplicarFiltroLocal("SELECCIONADOS", 0)
		            ELSE
		                SELECT cur_alerts
		                LOCATE FOR art_codi = lnArtCodi
		                IF FOUND()
		                    REPLACE ui_sel WITH .F. IN cur_alerts
		
		                    IF PEMSTATUS(THISFORMSET, "SetArticuloSeleccionado", 5)
		                        THISFORMSET.SetArticuloSeleccionado(lnArtCodi, .F.)
		                    ENDIF
		
		                    IF TYPE("cur_alerts.cant_soli") = "N"
		                        REPLACE cant_soli WITH 0 IN cur_alerts
		                    ENDIF
		                ENDIF
		            ENDIF
		        ENDIF
		    ENDIF
		
		    *-----------------------------------------------------
		    * Post-proceso (Solo si NO canceló)
		    *-----------------------------------------------------
		    IF !llSalir
		        IF PEMSTATUS(THISFORMSET, "SincronizarPedido", 5)
		            THISFORMSET.SincronizarPedido()
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		            THISFORMSET.SincronizarBotonMasivo()
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		            THISFORMSET.RefrescarGrid()
		        ELSE
		            IF PEMSTATUS(loFrm, "grd_alerts", 5)
		                loFrm.grd_alerts.Refresh()
		            ENDIF
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "RestaurarPosicionGridAlerts", 5)
		            THISFORMSET.RestaurarPosicionGridAlerts(lnTargetArtCodi, lnRecOld)
		        ENDIF
		
		        IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		            THISFORMSET.ActualizarEfectoGrid(0)
		        ENDIF
		
		        loFrm.Refresh()
		    ENDIF
		
		CATCH TO loEx
		    lcDet  = ""
		    lnErrs = AERROR(laErr)
		
		    IF lnErrs > 0
		        IF TYPE("laErr[1,2]") <> "U"
		            lcDet = lcDet + "Código: " + TRANSFORM(laErr[1,2]) + CHR(13)
		        ENDIF
		        IF TYPE("laErr[1,3]") <> "U"
		            lcDet = lcDet + "Detalle: " + TRANSFORM(laErr[1,3]) + CHR(13)
		        ENDIF
		    ENDIF
		
		    lcDet = lcDet + ;
		        "Mensaje: " + TRANSFORM(loEx.Message) + CHR(13) + ;
		        "Procedimiento: " + TRANSFORM(loEx.Procedure) + CHR(13) + ;
		        "Línea: " + TRANSFORM(loEx.LineNo)
		
		    MESSAGEBOX("Error en la operación:" + CHR(13) + CHR(13) + lcDet, 16, "MySQL Error")
		    llSalir = .T.
		ENDTRY
		
		* --- ACTUALIZA EL RELOJ AL FINALIZAR LA INTERACCIÓN ---
		THISFORMSET.xUltimoTickDblClick = SECONDS()
		RETURN .T.
	ENDPROC

	PROCEDURE guardarobservaciondesdeeditor
		*=========================================================
		* FormSet.GuardarObservacionDesdeEditor
		* Guarda observaciones desde secundario.edit1
		*=========================================================
		LOCAL loSec, lnSoliCodi, lcNuevo, lcOriginal
		LOCAL llOk
		
		loSec      = .NULL.
		lnSoliCodi = 0
		lcNuevo    = ""
		lcOriginal = ""
		llOk       = .F.
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN .F.
		ENDIF
		
		loSec = THISFORMSET.secundario
		IF VARTYPE(loSec) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loSec, "edit1", 5)
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(loSec, "xSoliCodiActual", 5)
		    lnSoliCodi = NVL(loSec.xSoliCodiActual, 0)
		ENDIF
		
		IF VARTYPE(lnSoliCodi) <> "N" OR lnSoliCodi <= 0
		    MESSAGEBOX("No hay una solicitud válida para guardar.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		lcNuevo = IIF(VARTYPE(loSec.edit1.Value) $ "CM", ALLTRIM(loSec.edit1.Value), "")
		
		IF PEMSTATUS(loSec, "xObsOriginal", 5)
		    lcOriginal = ALLTRIM(loSec.xObsOriginal)
		ENDIF
		
		*-- Si no hubo cambios, volver a modo bloqueado
		IF lcNuevo == lcOriginal
		    loSec.xObsEditando    = .F.
		    loSec.edit1.ReadOnly  = .T.
		    loSec.edit1.Enabled   = .F.
		    loSec.edit1.BackColor = RGB(245,245,245)
		    loSec.edit1.Refresh()
		
		    IF PEMSTATUS(loSec, "command3", 5)
		        loSec.command3.Caption = "EDITAR"
		        loSec.command3.Enabled = .T.
		        loSec.command3.Refresh()
		    ENDIF
		
		    RETURN .T.
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "GuardarObservacionSolicitud", 5)
		    llOk = THISFORMSET.GuardarObservacionSolicitud(lnSoliCodi, lcNuevo)
		ENDIF
		
		IF llOk
		    loSec.xObsOriginal    = lcNuevo
		    loSec.xObsEditando    = .F.
		    loSec.edit1.ReadOnly  = .T.
		    loSec.edit1.Enabled   = .F.
		    loSec.edit1.BackColor = RGB(245,245,245)
		    loSec.edit1.Refresh()
		
		    IF PEMSTATUS(loSec, "command3", 5)
		        loSec.command3.Caption = "EDITAR"
		        loSec.command3.Enabled = .T.
		        loSec.command3.Refresh()
		    ENDIF
		
		    MESSAGEBOX("Observación guardada correctamente.", 64, "Información")
		    RETURN .T.
		ELSE
		    MESSAGEBOX("No se pudo guardar la observación.", 16, "Error")
		    RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE guardarobservacionsolicitud
		*=========================================================
		* FormSet.GuardarObservacionSolicitud
		* Guarda observaciones en solicitud_compra
		*=========================================================
		LPARAMETERS tnSoliCodi, tcObservacion
		LOCAL lnConn, lnRet, lcSQL, lcObs
		
		IF VARTYPE(tnSoliCodi) <> "N" OR tnSoliCodi <= 0
		    RETURN .F.
		ENDIF
		
		
		IF PEMSTATUS(THISFORMSET, "SolicitudEstaComprada", 5) AND ;
		   THISFORMSET.SolicitudEstaComprada(tnSoliCodi)
		
		    MESSAGEBOX( ;
		        "La Solicitud N° " + TRANSFORM(tnSoliCodi) + " ya fue COMPRADA." + CHR(13) + ;
		        "No se puede guardar la observación.", ;
		        48, ;
		        "Solicitud bloqueada")
		
		    RETURN .F.
		ENDIF
		
		
		
		DO CASE
		    CASE VARTYPE(tcObservacion) = "C"
		        lcObs = ALLTRIM(tcObservacion)
		    CASE VARTYPE(tcObservacion) = "M"
		        lcObs = ALLTRIM(tcObservacion)
		    OTHERWISE
		        lcObs = ""
		ENDCASE
		
		lnConn = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    RETURN .F.
		ENDIF
		
		lcSQL = ;
		    "UPDATE solicitud_compra " + ;
		    "SET observaciones = ?lcObs " + ;
			"WHERE soli_codi = ?tnSoliCodi " + ;
			"AND UPPER(TRIM(IFNULL(estado,''))) <> 'COMPRADO'"
		
		
		lnRet = SQLEXEC(lnConn, lcSQL)
		Desconectar_DB(lnConn)
		
		RETURN (lnRet > 0)
	ENDPROC

	PROCEDURE guardarreporteocencarpeta
		*=========================================================
		* FormSet.GuardarReporteOCEnCarpeta
		* - Genera PDF directo usando FoxyPreviewer
		* - Nombre: OC_<orden_codi>_<prov_nomb>.pdf
		*=========================================================
		LPARAMETERS tnOrdenCodi, tcCarpetaDestino
		
		LOCAL llOk
		LOCAL lcProvNomb, lcTranNomb, lcNombreArchivo, lcRutaFinal
		LOCAL lcAppPath, lcBasePath
		LOCAL llFoxyOk
		LOCAL loEx
		LOCAL lnSumaDetalle
		LOCAL lcOldPoint, lcOldSeparator, lcOldDecimals
		LOCAL lcReporteTmp, lnWaitPdf
		
		llOk            = .F.
		lcProvNomb      = "SIN PROVEEDOR"
		lcTranNomb      = "SIN TRANSPORTE"
		lcNombreArchivo = ""
		lcRutaFinal     = ""
		lcAppPath       = ""
		lcBasePath      = ""
		llFoxyOk        = .F.
		lnSumaDetalle   = 0
		lcReporteTmp    = ""
		lnWaitPdf       = 0
		
		IF EMPTY(tnOrdenCodi) OR VARTYPE(tnOrdenCodi) $ "CL"
		    tnOrdenCodi = VAL(TRANSFORM(tnOrdenCodi))
		ENDIF
		
		IF tnOrdenCodi <= 0
		    MESSAGEBOX("Orden de compra inválida.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF EMPTY(ALLTRIM(tcCarpetaDestino))
		    MESSAGEBOX("No se indicó carpeta destino para el PDF.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF !DIRECTORY(tcCarpetaDestino)
		    MD (tcCarpetaDestino)
		
		    IF !DIRECTORY(tcCarpetaDestino)
		        MESSAGEBOX("No se pudo crear la carpeta destino:" + CHR(13) + tcCarpetaDestino, 16, "Error")
		        RETURN .F.
		    ENDIF
		ENDIF
		
		
		*---------------------------------------------------------
		* 0. Validar FoxyPreviewer ANTES de generar OCs
		*---------------------------------------------------------
		LOCAL lcFoxyPrecheck
		
		lcFoxyPrecheck = ""
		
		IF PEMSTATUS(THISFORMSET, "ResolverRutaFoxyPreviewer", 5)
		    lcFoxyPrecheck = THISFORMSET.ResolverRutaFoxyPreviewer(.T.)
		ENDIF
		
		IF EMPTY(lcFoxyPrecheck) OR !FILE(lcFoxyPrecheck)
		    MESSAGEBOX("No se encontró FoxyPreviewer.app." + CHR(13) + ;
		               "No se generará ninguna Orden de Compra.", ;
		               16, "Proceso cancelado")
		    RETURN .F.
		ENDIF
		
		
		
		*---------------------------------------------------------
		* 1. Preparar cursores del reporte
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "PrepararDatosReporteOC", 5)
		    MESSAGEBOX("No existe el método PrepararDatosReporteOC.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF !THISFORMSET.PrepararDatosReporteOC(tnOrdenCodi)
		    MESSAGEBOX("No se pudieron preparar los datos del reporte para la OC N° " + ;
		               ALLTRIM(TRANSFORM(tnOrdenCodi)) + ".", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 2. Obtener proveedor desde cur_datvar
		*---------------------------------------------------------
		IF USED("cur_datvar") AND RECCOUNT("cur_datvar") > 0
		    SELECT cur_datvar
		    GO TOP
		
		    IF TYPE("cur_datvar.prov_nomb") # "U"
		        lcProvNomb = ALLTRIM(NVL(cur_datvar.prov_nomb, "SIN PROVEEDOR"))
		    ENDIF
		ENDIF
		
		IF EMPTY(lcProvNomb)
		    lcProvNomb = "SIN PROVEEDOR"
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "LimpiarNombreArchivoWindows", 5)
		    lcProvNomb = THISFORMSET.LimpiarNombreArchivoWindows(lcProvNomb)
		ENDIF
		
		*---------------------------------------------------------
		* 2.0 Obtener transporte desde cur_tra
		*---------------------------------------------------------
		lcTranNomb = ""
		
		IF USED("cur_tra") AND RECCOUNT("cur_tra") > 0
		    SELECT cur_tra
		    GO TOP
		
		    IF TYPE("cur_tra.tran_nomb") # "U"
		        lcTranNomb = ALLTRIM(NVL(cur_tra.tran_nomb, ""))
		    ENDIF
		ENDIF
		
		IF EMPTY(lcTranNomb)
		    lcTranNomb = "SIN TRANSPORTE"
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "LimpiarNombreArchivoWindows", 5)
		    lcTranNomb = THISFORMSET.LimpiarNombreArchivoWindows(lcTranNomb)
		ENDIF
		
		*---------------------------------------------------------
		* 2.1 Nombre seguro para PDF
		* IMPORTANTE: limpiar proveedor ANTES de agregar ".pdf"
		*---------------------------------------------------------
		lcProvNomb = ALLTRIM(lcProvNomb)
		
		lcProvNomb = STRTRAN(lcProvNomb, ".", "")
		lcProvNomb = STRTRAN(lcProvNomb, ",", "")
		lcProvNomb = STRTRAN(lcProvNomb, " ", "_")
		lcProvNomb = STRTRAN(lcProvNomb, "°", "")
		lcProvNomb = STRTRAN(lcProvNomb, "/", "-")
		lcProvNomb = STRTRAN(lcProvNomb, "\", "-")
		lcProvNomb = STRTRAN(lcProvNomb, ":", "-")
		lcProvNomb = STRTRAN(lcProvNomb, "*", "")
		lcProvNomb = STRTRAN(lcProvNomb, "?", "")
		lcProvNomb = STRTRAN(lcProvNomb, CHR(34), "")
		lcProvNomb = STRTRAN(lcProvNomb, "<", "")
		lcProvNomb = STRTRAN(lcProvNomb, ">", "")
		lcProvNomb = STRTRAN(lcProvNomb, "|", "")
		
		lcProvNomb = STRTRAN(lcProvNomb, "Ñ", "N")
		lcProvNomb = STRTRAN(lcProvNomb, "ñ", "n")
		lcProvNomb = STRTRAN(lcProvNomb, "Á", "A")
		lcProvNomb = STRTRAN(lcProvNomb, "É", "E")
		lcProvNomb = STRTRAN(lcProvNomb, "Í", "I")
		lcProvNomb = STRTRAN(lcProvNomb, "Ó", "O")
		lcProvNomb = STRTRAN(lcProvNomb, "Ú", "U")
		lcProvNomb = STRTRAN(lcProvNomb, "á", "a")
		lcProvNomb = STRTRAN(lcProvNomb, "é", "e")
		lcProvNomb = STRTRAN(lcProvNomb, "í", "i")
		lcProvNomb = STRTRAN(lcProvNomb, "ó", "o")
		lcProvNomb = STRTRAN(lcProvNomb, "ú", "u")
		
		IF EMPTY(lcProvNomb)
		    lcProvNomb = "SIN_PROVEEDOR"
		ENDIF
		
		*---------------------------------------------------------
		* 2.1.1 Nombre seguro del transporte
		*---------------------------------------------------------
		lcTranNomb = ALLTRIM(lcTranNomb)
		
		lcTranNomb = STRTRAN(lcTranNomb, ".", "")
		lcTranNomb = STRTRAN(lcTranNomb, ",", "")
		lcTranNomb = STRTRAN(lcTranNomb, " ", "_")
		lcTranNomb = STRTRAN(lcTranNomb, "°", "")
		lcTranNomb = STRTRAN(lcTranNomb, "/", "-")
		lcTranNomb = STRTRAN(lcTranNomb, "\", "-")
		lcTranNomb = STRTRAN(lcTranNomb, ":", "-")
		lcTranNomb = STRTRAN(lcTranNomb, "*", "")
		lcTranNomb = STRTRAN(lcTranNomb, "?", "")
		lcTranNomb = STRTRAN(lcTranNomb, CHR(34), "")
		lcTranNomb = STRTRAN(lcTranNomb, "<", "")
		lcTranNomb = STRTRAN(lcTranNomb, ">", "")
		lcTranNomb = STRTRAN(lcTranNomb, "|", "")
		
		lcTranNomb = STRTRAN(lcTranNomb, "Ñ", "N")
		lcTranNomb = STRTRAN(lcTranNomb, "ñ", "n")
		lcTranNomb = STRTRAN(lcTranNomb, "Á", "A")
		lcTranNomb = STRTRAN(lcTranNomb, "É", "E")
		lcTranNomb = STRTRAN(lcTranNomb, "Í", "I")
		lcTranNomb = STRTRAN(lcTranNomb, "Ó", "O")
		lcTranNomb = STRTRAN(lcTranNomb, "Ú", "U")
		lcTranNomb = STRTRAN(lcTranNomb, "á", "a")
		lcTranNomb = STRTRAN(lcTranNomb, "é", "e")
		lcTranNomb = STRTRAN(lcTranNomb, "í", "i")
		lcTranNomb = STRTRAN(lcTranNomb, "ó", "o")
		lcTranNomb = STRTRAN(lcTranNomb, "ú", "u")
		
		IF EMPTY(lcTranNomb)
		    lcTranNomb = "SIN_TRANSPORTE"
		ENDIF
		
		lcNombreArchivo = "OC_" + ALLTRIM(TRANSFORM(tnOrdenCodi)) + "_" + ;
		                  lcProvNomb + "_TRANSP_" + lcTranNomb + ".pdf"
		
		*---------------------------------------------------------
		* 2.2 Ruta final del PDF
		*---------------------------------------------------------
		IF RIGHT(ALLTRIM(tcCarpetaDestino), 1) $ "\/"
		    lcRutaFinal = ALLTRIM(tcCarpetaDestino) + lcNombreArchivo
		ELSE
		    lcRutaFinal = ALLTRIM(tcCarpetaDestino) + "\" + lcNombreArchivo
		ENDIF
		
		IF EMPTY(lcRutaFinal)
		    MESSAGEBOX("No se pudo construir la ruta final del PDF.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 3. Variables globales que usa el reporte ordendecompra
		*---------------------------------------------------------
		PUBLIC lg, cantreg, ivari, ivarni, totalri, totalrni, totsiva, totcpra
		
		lg       = 6
		cantreg  = 0
		ivari    = 0
		ivarni   = 0
		totalri  = 0
		totalrni = 0
		totsiva  = 0
		totcpra  = 0
		
		LOCAL lnImpo1, lnImpo2, lnCondCodi, lnImpIva1, lnImpIva2, lnDtoPorc, lnTotalItem
		
		IF USED("cur_arcom")
		    cantreg = RECCOUNT("cur_arcom")
		ENDIF
		
		IF USED("cur_arcom") AND RECCOUNT("cur_arcom") > 0
		    *-- Leer alícuotas y condición del proveedor desde la cabecera
		    lnCondCodi = 0
		    lnImpIva1  = 21.00
		    lnImpIva2  = 10.50
		    lnDtoPorc  = 0
		
		    IF USED("cur_datvar") AND RECCOUNT("cur_datvar") > 0
		        SELECT cur_datvar
		        GO TOP
		        lnCondCodi = NVL(cur_datvar.cond_codi, 0)
		        lnImpIva1  = NVL(cur_datvar.iva_1, 21.00)
		        lnImpIva2  = NVL(cur_datvar.iva_2, 10.50)
		        lnDtoPorc  = NVL(cur_datvar.orden_dto, 0)
		    ENDIF
		
		    lnImpo1 = 0
		    lnImpo2 = 0
		
		    SELECT cur_arcom
		    GO TOP
		    SCAN
		        IF TYPE("cur_arcom.artord_precio") # "U" AND TYPE("cur_arcom.artord_cant") # "U"
		            lnTotalItem = ROUND(NVL(cur_arcom.artord_precio, 0) * NVL(cur_arcom.artord_cant, 0), 2)
		            
		            * Descuento de orden
		            IF lnDtoPorc > 0
		                lnTotalItem = lnTotalItem - ROUND((lnTotalItem * lnDtoPorc) / 100, 2)
		            ENDIF
		
		            totsiva = totsiva + lnTotalItem
		
		            * Separar bases si el Proveedor es Responsable Inscripto (Condición 2)
		            IF lnCondCodi = 2
		                IF TYPE("cur_arcom.art_alicuota") # "U" AND cur_arcom.art_alicuota = 2
		                    lnImpo2 = lnImpo2 + lnTotalItem
		                ELSE
		                    lnImpo1 = lnImpo1 + lnTotalItem
		                ENDIF
		            ENDIF
		        ENDIF
		    ENDSCAN
		
		    totsiva = ROUND(totsiva, 2)
		
		    * Calcular IVA final
		    IF lnCondCodi = 2
		        ivari  = ROUND((lnImpo1 * lnImpIva1) / 100, 2)
		        ivarni = ROUND((lnImpo2 * lnImpIva2) / 100, 2)
		    ENDIF
		
		    totalri  = totsiva + ivari
		    totalrni = totsiva + ivari + ivarni
		    totcpra  = totalrni
		ENDIF
		*---------------------------------------------------------
		* 4. Resolver FoxyPreviewer.app
		*---------------------------------------------------------
		lcAppPath = ""
		
		IF PEMSTATUS(THISFORMSET, "ResolverRutaFoxyPreviewer", 5)
		    lcAppPath = THISFORMSET.ResolverRutaFoxyPreviewer(.T.)
		ENDIF
		
		IF EMPTY(lcAppPath) OR !FILE(lcAppPath)
		    MESSAGEBOX("No se encontró FoxyPreviewer.app." + CHR(13) + ;
		               "No se puede generar el PDF.", ;
		               16, "Error")
		    RETURN .F.
		ENDIF
		
		*!*	MESSAGEBOX("FoxyPreviewer encontrado en:" + CHR(13) + lcAppPath, 64, "Ruta FoxyPreviewer")
		
		*---------------------------------------------------------
		* 5. Cargar FoxyPreviewer
		*---------------------------------------------------------
		TRY
		    DO (lcAppPath)
		    llFoxyOk = .T.
		CATCH TO loEx
		    llFoxyOk = .F.
		    MESSAGEBOX("No se pudo cargar FoxyPreviewer." + CHR(13) + ;
		               "Detalle: " + TRANSFORM(loEx.Message), 16, "Error")
		ENDTRY
		
		IF !llFoxyOk
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 5.1 Configurar FoxyPreviewer
		*---------------------------------------------------------
		IF TYPE("_Screen.oFoxyPreviewer") = "O"
		    IF PEMSTATUS(_Screen.oFoxyPreviewer, "lExpandFields", 5)
		        _Screen.oFoxyPreviewer.lExpandFields = .T.
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* 6. Exportar PDF directo
		*---------------------------------------------------------
		lcOldPoint     = SET("POINT")
		lcOldSeparator = SET("SEPARATOR")
		lcOldDecimals  = SET("DECIMALS")
		
		SET DECIMALS TO 4
		SET DATABASE TO
		SET POINT TO ","
		SET SEPARATOR TO "."
		
		* ====================================================================
		* Re-creamos el cursor localmente con el tamaño exacto.
		* Esto ayuda a evitar los asteriscos sin modificar el FRX.
		* ====================================================================
		IF USED("cur_arcom") AND RECCOUNT("cur_arcom") > 0
		
		    SELECT ;
		        artord_codi, ;
		        orden_codi, ;
		        art_codi, ;
		        CAST(NVL(artord_precio, 0) AS N(15,4)) AS artord_precio, ;
		        CAST(NVL(artord_cant, 0) AS N(15,3)) AS artord_cant, ;
		        artord_ent, ;
		        artord_dasc, ;
		        artpro_codi, ;
		        dap_codi, ;
		        alter_iva, ;
		        art_desc, ;
		        art_med, ;
		        art_alicuota, ;
		        dap_desc ;
		    FROM cur_arcom ;
		    INTO CURSOR cur_arcom_limpio READWRITE
		
		    USE IN cur_arcom
		
		    SELECT * ;
		    FROM cur_arcom_limpio ;
		    INTO CURSOR cur_arcom READWRITE
		
		    USE IN cur_arcom_limpio
		
		    SELECT cur_arcom
		    GO TOP
		ENDIF
		
		* ====================================================================
		
		* Asegurarnos de que el cursor del detalle sea el activo para el reporte
		IF USED("cur_cpra")
		    SELECT cur_cpra
		    GO TOP
		ENDIF
		
		IF USED("cur_arcom")
		    SELECT cur_arcom
		    GO TOP
		ENDIF
		
		IF FILE(lcRutaFinal)
		    DELETE FILE (lcRutaFinal)
		ENDIF
		
		SET CONSOLE OFF
		llOk = .F.
		
		TRY
		    * Volvemos a usar el reporte original, ya que los datos ya están arreglados
		    REPORT FORM ordendecompra ;
		        FOR cur_cpra.orden_codi = tnOrdenCodi ;
		        OBJECT TYPE 10 ;
		        TO FILE (lcRutaFinal) ;
		        NOCONSOLE
		
		    llOk = .T.
		
		CATCH TO loEx
		    llOk = .F.
		    MESSAGEBOX("Error al exportar PDF de la OC N° " + ALLTRIM(TRANSFORM(tnOrdenCodi)) + "." + CHR(13) + "Detalle: " + TRANSFORM(loEx.Message), 16, "Error")
		ENDTRY
		
		SET CONSOLE ON
		
		*-- Restaurar entorno
		SET POINT TO (lcOldPoint)
		SET SEPARATOR TO (lcOldSeparator)
		SET DECIMALS TO &lcOldDecimals
		
		IF !llOk
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 7. Validar PDF generado
		*---------------------------------------------------------
		lnWaitPdf = 0
		DO WHILE !FILE(lcRutaFinal) AND lnWaitPdf < 50
		    DOEVENTS
		    INKEY(0.2)
		    lnWaitPdf = lnWaitPdf + 1
		ENDDO
		
		IF FILE(lcRutaFinal)
		    llOk = .T.
		ELSE
		    MESSAGEBOX("No se pudo crear el PDF automáticamente." + CHR(13) + ;
		               "Ruta esperada:" + CHR(13) + lcRutaFinal, 16, "Error PDF")
		    llOk = .F.
		ENDIF
		
		RETURN llOk
		
		
	ENDPROC

	PROCEDURE habilitaredicionobservacion
		*=========================================================
		* FormSet.HabilitarEdicionObservacion
		*=========================================================
		LOCAL loSec, lnSoliCodi
		LOCAL lnConn, lnRet, lcEstado
		
		loSec      = .NULL.
		lnSoliCodi = 0
		lnConn     = 0
		lnRet      = 0
		lcEstado   = ""
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN .F.
		ENDIF
		
		loSec = THISFORMSET.secundario
		IF VARTYPE(loSec) <> "O"
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loSec, "xSoliCodiActual", 5)
		    RETURN .F.
		ENDIF
		
		lnSoliCodi = NVL(loSec.xSoliCodiActual, 0)
		
		IF VARTYPE(lnSoliCodi) <> "N"
		    lnSoliCodi = VAL(TRANSFORM(lnSoliCodi))
		ENDIF
		
		lnSoliCodi = INT(NVL(lnSoliCodi, 0))
		
		IF lnSoliCodi <= 0
		    MESSAGEBOX("Primero seleccione una solicitud.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		*-- Validar estado de la solicitud contra MySQL
		IF USED("cur_obs_chk")
		    USE IN cur_obs_chk
		ENDIF
		
		lnConn = Conectar_DB(_screen.cn)
		
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo verificar el estado de la solicitud.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		lnRet = SQLEXEC(lnConn, ;
		    "SELECT UPPER(TRIM(IFNULL(estado,''))) AS estado " + ;
		    "FROM solicitud_compra " + ;
		    "WHERE soli_codi = ?lnSoliCodi", ;
		    "cur_obs_chk")
		
		Desconectar_DB(lnConn)
		lnConn = 0
		
		IF lnRet < 0
		    IF USED("cur_obs_chk")
		        USE IN cur_obs_chk
		    ENDIF
		
		    MESSAGEBOX("No se pudo validar el estado de la solicitud.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_obs_chk") OR RECCOUNT("cur_obs_chk") <= 0
		    IF USED("cur_obs_chk")
		        USE IN cur_obs_chk
		    ENDIF
		
		    MESSAGEBOX("No se encontró la Solicitud N° " + TRANSFORM(lnSoliCodi) + ".", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		SELECT cur_obs_chk
		GO TOP
		
		IF TYPE("cur_obs_chk.estado") <> "U"
		    lcEstado = UPPER(ALLTRIM(TRANSFORM(NVL(cur_obs_chk.estado, ""))))
		ENDIF
		
		IF USED("cur_obs_chk")
		    USE IN cur_obs_chk
		ENDIF
		
		IF lcEstado == "COMPRADO"
		    IF PEMSTATUS(loSec, "edit1", 5)
		        loSec.edit1.ReadOnly  = .T.
		        loSec.edit1.Enabled   = .F.
		        loSec.edit1.BackColor = RGB(245,245,245)
		        loSec.edit1.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(loSec, "xObsEditando", 5)
		        loSec.xObsEditando = .F.
		    ENDIF
		
		    IF PEMSTATUS(loSec, "command3", 5)
		        loSec.command3.Caption = "EDITAR"
		        loSec.command3.Enabled = .F.
		        loSec.command3.Refresh()
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		
		*-- Habilitar edición
		IF !PEMSTATUS(loSec, "edit1", 5)
		    RETURN .F.
		ENDIF
		
		loSec.xObsEditando    = .T.
		loSec.xObsOriginal    = IIF(VARTYPE(loSec.edit1.Value) $ "CM", loSec.edit1.Value, "")
		loSec.edit1.ReadOnly  = .F.
		loSec.edit1.Enabled   = .T.
		loSec.edit1.BackColor = RGB(255,255,255)
		loSec.edit1.Refresh()
		
		IF PEMSTATUS(loSec, "command3", 5)
		    loSec.command3.Caption = "GUARDAR"
		    loSec.command3.Enabled = .T.
		    loSec.command3.Refresh()
		ENDIF
		
		TRY
		    loSec.edit1.SetFocus()
		CATCH
		ENDTRY
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE imprimirsolicitudcompra
		*=========================================================
		* FormSet.ImprimirSolicitudCompra
		* Imprime o reimprime una solicitud existente
		*=========================================================
		LPARAMETERS lnSoliCodi
		
		LOCAL lnConnReport, lnRetReport, lcSQLReport
		LOCAL lcAliasReport, lcAliasRawReport, lnErr, lcErrMsg
		LOCAL lnOrdenLinea, lcObsArt
		LOCAL ARRAY laError[1]
		LOCAL lnItemReporte
		
		lcAliasReport = "cur_print_solicitud"
		lcAliasRawReport = "cur_print_solicitud_raw"
		lnConnReport  = 0
		lnRetReport   = 0
		lcErrMsg      = ""
		lnItemReporte = 0
		lnOrdenLinea = 0
		lcObsArt     = ""
		
		IF VARTYPE(lnSoliCodi) <> "N" OR lnSoliCodi <= 0
		    MESSAGEBOX("El código de solicitud es inválido para imprimir.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		WAIT WINDOW "Abriendo entorno de impresión..." NOWAIT
		
		IF USED(lcAliasReport)
		    USE IN (lcAliasReport)
		ENDIF
		
		lnConnReport = Conectar_DB(_screen.cn)
		IF VARTYPE(lnConnReport) <> "N" OR lnConnReport <= 0
		    WAIT CLEAR
		    MESSAGEBOX("No se pudo conectar para el reporte.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		TEXT TO lcSQLReport NOSHOW PRETEXT 15
		    SELECT
				s.soli_codi,
				s.soli_fecha,
				s.observaciones,
				IFNULL(d.observacion, '') AS observacion_articulo,
				d.art_codi,
		        a.art_desc,
		        COALESCE(p.prov_nomb, '')           AS prov_nomb,
		        IFNULL(d.artpro_costo, 0)           AS artpro_costo,
		        IFNULL(ap.moneda, 'ARS')            AS moneda,
		        d.cant_soli                         AS cant_sug,
		        IFNULL(a.art_stock, 0)              AS art_stock,
		        IFNULL(a.pedprov, 0)                AS art_pedprov,
		        IFNULL(a.pedidos, 0)                AS art_pedidos,
		        d.posicion,
		        d.art_stmin,
		        IFNULL(m.art_pct_alerta, 30.00)     AS art_pct_alerta,
		        COALESCE(cult.cli_nomb, '')         AS ult_cliente
		    FROM solicitud_compra s
		    INNER JOIN solicitud_compra_art d
		        ON s.soli_codi = d.soli_codi
		    INNER JOIN articulos a
		        ON d.art_codi = a.art_codi
		    LEFT JOIN art_metricas m
		        ON m.art_codi = a.art_codi
		    LEFT JOIN proveedores p
		        ON p.prov_codi = d.prov_codi
		    LEFT JOIN articulos_proveedores ap
		        ON ap.art_codi  = d.art_codi
		       AND ap.prov_codi = d.prov_codi
		    LEFT JOIN (
		        SELECT pa.art_codi, MIN(c.cli_nomb) AS cli_nomb
		        FROM pedidos_articulos pa
		        INNER JOIN pedidos p2 ON p2.ped_codi = pa.ped_codi
		        INNER JOIN clientes c  ON c.cli_codi  = p2.cli_codi
		        WHERE p2.finalizado = 0
		        GROUP BY pa.art_codi
		    ) cult ON cult.art_codi = d.art_codi
		    WHERE s.soli_codi = ?lnSoliCodi
		    ORDER BY prov_nomb ASC, a.art_desc ASC
		ENDTEXT
		
		IF USED(lcAliasRawReport)
		    USE IN (lcAliasRawReport)
		ENDIF
		
		lnRetReport = SQLEXEC(lnConnReport, lcSQLReport, lcAliasRawReport)
		
		IF lnRetReport > 0 AND USED(lcAliasRawReport)
		
		    SELECT (lcAliasRawReport)
		
		    IF RECCOUNT() > 0
		
		        *-------------------------------------------------
		        * Crear cursor final del reporte con líneas extra
		        * tipo_linea = "A" artículo
		        * tipo_linea = "O" observación del artículo
		        *-------------------------------------------------
		        IF USED(lcAliasReport)
		            USE IN (lcAliasReport)
		        ENDIF
		
				CREATE CURSOR cur_print_solicitud ( ;
				    orden_linea          I, ;
				    item_reporte         C(8), ;
				    tipo_linea           C(1), ;
				    soli_codi            I, ;
				    soli_fecha           T, ;
				    observaciones        M, ;
				    observacion_articulo M, ;
				    art_codi             I, ;
				    art_desc             C(250), ;
				    prov_nomb            C(100), ;
				    artpro_costo         N(15,4), ;
				    moneda               C(10), ;
				    cant_sug             N(15,3), ;
				    art_stock            N(15,3), ;
				    art_pedprov          N(15,3), ;
				    art_pedidos          N(15,3), ;
				    posicion             N(15,3), ;
				    art_stmin            N(15,3), ;
				    art_pct_alerta       N(10,2), ;
				    ult_cliente          C(100) )
		
		        lnOrdenLinea = 0
		
		        SELECT (lcAliasRawReport)
		        GO TOP
		
		        SCAN
		
		            *---------------------------------------------
		            * Línea normal del artículo
		            *---------------------------------------------
		            lnOrdenLinea = lnOrdenLinea + 1
					lnItemReporte = lnItemReporte + 1
					
					INSERT INTO cur_print_solicitud ;
					    (orden_linea, item_reporte, tipo_linea, soli_codi, soli_fecha, observaciones, ;
					     observacion_articulo, art_codi, art_desc, prov_nomb, artpro_costo, ;
					     moneda, cant_sug, art_stock, art_pedprov, art_pedidos, posicion, ;
					     art_stmin, art_pct_alerta, ult_cliente) ;
					VALUES ;
					    (lnOrdenLinea, ;
					     TRANSFORM(lnItemReporte), ;
					     "A", ;
					     cur_print_solicitud_raw.soli_codi, ;
					     cur_print_solicitud_raw.soli_fecha, ;
					     cur_print_solicitud_raw.observaciones, ;
					     cur_print_solicitud_raw.observacion_articulo, ;
					     cur_print_solicitud_raw.art_codi, ;
					     cur_print_solicitud_raw.art_desc, ;
					     cur_print_solicitud_raw.prov_nomb, ;
					     cur_print_solicitud_raw.artpro_costo, ;
					     cur_print_solicitud_raw.moneda, ;
					     cur_print_solicitud_raw.cant_sug, ;
					     cur_print_solicitud_raw.art_stock, ;
					     cur_print_solicitud_raw.art_pedprov, ;
					     cur_print_solicitud_raw.art_pedidos, ;
					     cur_print_solicitud_raw.posicion, ;
					     cur_print_solicitud_raw.art_stmin, ;
					     cur_print_solicitud_raw.art_pct_alerta, ;
					     cur_print_solicitud_raw.ult_cliente )
					     
		            *---------------------------------------------
		            * Línea subitem de observación
		            * Solo si el artículo tiene observación
		            *---------------------------------------------
		            lcObsArt = ""
		
		            IF TYPE("cur_print_solicitud_raw.observacion_articulo") <> "U"
		                lcObsArt = ALLTRIM(NVL(cur_print_solicitud_raw.observacion_articulo, ""))
		            ENDIF
		
		            IF !EMPTY(lcObsArt)
		
		                lnOrdenLinea = lnOrdenLinea + 1
		
						INSERT INTO cur_print_solicitud ;
						    (orden_linea, item_reporte, tipo_linea, soli_codi, soli_fecha, observaciones, ;
						     observacion_articulo, art_codi, art_desc, prov_nomb, artpro_costo, ;
						     moneda, cant_sug, art_stock, art_pedprov, art_pedidos, posicion, ;
						     art_stmin, art_pct_alerta, ult_cliente) ;
						VALUES ;
						    (lnOrdenLinea, ;
						     "", ;
						     "O", ;
						     cur_print_solicitud_raw.soli_codi, ;
						     cur_print_solicitud_raw.soli_fecha, ;
						     cur_print_solicitud_raw.observaciones, ;
						     lcObsArt, ;
						     0, ;
						     "   Obs:", ;
						     "", ;
						     0, ;
						     "", ;
						     0, ;
						     0, ;
						     0, ;
						     0, ;
						     0, ;
						     0, ;
						     0, ;
						     "" )
		            ENDIF
		
		            SELECT (lcAliasRawReport)
		
		        ENDSCAN
		
		        USE IN (lcAliasRawReport)
		
		        SELECT cur_print_solicitud
		        GO TOP
		
		        WAIT CLEAR
		        REPORT FORM rpt_solicitud_compra TO PRINTER PROMPT NOCONSOLE
		
		    ELSE
		
		        WAIT CLEAR
		        MESSAGEBOX("No se encontraron registros para la Solicitud N° " + TRANSFORM(lnSoliCodi), 48, "Sin Datos")
		
		        IF VARTYPE(lnConnReport) = "N" AND lnConnReport > 0
		            Desconectar_DB(lnConnReport)
		        ENDIF
		
		        RETURN .F.
		
		    ENDIF
		
		ELSE
		    lnErr = AERROR(laError)
		    lcErrMsg = "Desconocido"
		
		    IF lnErr > 0
		        IF ALEN(laError, 1) >= 1
		            IF TYPE("laError[1,3]") <> "U"
		                lcErrMsg = TRANSFORM(laError[1,3])
		            ELSE
		                lcErrMsg = TRANSFORM(laError[1])
		            ENDIF
		        ENDIF
		    ENDIF
		
		    WAIT CLEAR
		    MESSAGEBOX("Error al generar cursor de reporte:" + CHR(13) + lcErrMsg, 16, "Error de MySQL")
		
		    IF VARTYPE(lnConnReport) = "N" AND lnConnReport > 0
		        Desconectar_DB(lnConnReport)
		    ENDIF
		    RETURN .F.
		ENDIF
		
		IF VARTYPE(lnConnReport) = "N" AND lnConnReport > 0
		    Desconectar_DB(lnConnReport)
		ENDIF
		
		WAIT CLEAR
		RETURN .T.
	ENDPROC

	PROCEDURE inicializarfechashistorialsecundario
		*=========================================================
		* FormSet.InicializarFechasHistorialSecundario
		* Inicializa fechas por defecto del historial del secundario
		*=========================================================
		LPARAMETERS tdDesde, tdHasta
		
		LOCAL loConsulta
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN .F.
		ENDIF
		
		loConsulta = THISFORMSET.secundario
		IF VARTYPE(loConsulta) <> "O"
		    RETURN .F.
		ENDIF
		
		IF VARTYPE(tdDesde) <> "D" OR EMPTY(tdDesde)
		    tdDesde = GOMONTH(DATE(), -12)
		ENDIF
		
		IF VARTYPE(tdHasta) <> "D" OR EMPTY(tdHasta)
		    tdHasta = DATE()
		ENDIF
		
		IF tdDesde > tdHasta
		    tdHasta = tdDesde
		ENDIF
		
		IF !PEMSTATUS(loConsulta, "xHistFecDes", 5)
		    loConsulta.AddProperty("xHistFecDes", tdDesde)
		ELSE
		    loConsulta.xHistFecDes = tdDesde
		ENDIF
		
		IF !PEMSTATUS(loConsulta, "xHistFecHas", 5)
		    loConsulta.AddProperty("xHistFecHas", tdHasta)
		ELSE
		    loConsulta.xHistFecHas = tdHasta
		ENDIF
		
		IF !PEMSTATUS(loConsulta, "xPermitirSalirFechaHasHist", 5)
		    loConsulta.AddProperty("xPermitirSalirFechaHasHist", .F.)
		ELSE
		    loConsulta.xPermitirSalirFechaHasHist = .F.
		ENDIF
		
		IF PEMSTATUS(loConsulta, "txt_fecdes_hist", 5)
		    WITH loConsulta.txt_fecdes_hist
		        TRY
		            .ControlSource = ""
		        CATCH
		        ENDTRY
		
		        .TabStop  = .T.
		        .Enabled  = .T.
		        .ReadOnly = .F.
		
		        TRY
		            .Value = loConsulta.xHistFecDes
		        CATCH
		        ENDTRY
		
		        .Refresh()
		    ENDWITH
		ENDIF
		
		IF PEMSTATUS(loConsulta, "txt_fechas_hist", 5)
		    WITH loConsulta.txt_fechas_hist
		        TRY
		            .ControlSource = ""
		        CATCH
		        ENDTRY
		
		        .TabStop  = .T.
		        .Enabled  = .T.
		        .ReadOnly = .F.
		
		        TRY
		            .Value = loConsulta.xHistFecHas
		        CATCH
		        ENDTRY
		
		        .Refresh()
		    ENDWITH
		ENDIF
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE iniciaredicionobservacion
		*=========================================================
		* FormSet.IniciarEdicionObservacion
		* Habilita edit1 y cambia command3 a GUARDAR
		*=========================================================
		LOCAL loSec, lnSoliCodi
		
		loSec = .NULL.
		
		IF !PEMSTATUS(THISFORMSET, "secundario", 5)
		    RETURN .F.
		ENDIF
		
		loSec = THISFORMSET.secundario
		IF VARTYPE(loSec) <> "O"
		    RETURN .F.
		ENDIF
		
		lnSoliCodi = 0
		IF PEMSTATUS(loSec, "xSoliCodiActual", 5)
		    lnSoliCodi = NVL(loSec.xSoliCodiActual, 0)
		ENDIF
		
		IF VARTYPE(lnSoliCodi) <> "N" OR lnSoliCodi <= 0
		    MESSAGEBOX("Primero debe seleccionar una solicitud válida.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		
		IF PEMSTATUS(THISFORMSET, "SolicitudEstaComprada", 5) AND ;
		   THISFORMSET.SolicitudEstaComprada(lnSoliCodi)
		
		    IF PEMSTATUS(loSec, "edit1", 5)
		        loSec.edit1.ReadOnly  = .T.
		        loSec.edit1.Enabled   = .F.
		        loSec.edit1.BackColor = RGB(245,245,245)
		        loSec.edit1.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(loSec, "xObsEditando", 5)
		        loSec.xObsEditando = .F.
		    ENDIF
		
		    IF PEMSTATUS(loSec, "command3", 5)
		        loSec.command3.Caption = "EDITAR"
		        loSec.command3.Enabled = .F.
		        loSec.command3.Refresh()
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		
		
		
		
		IF !PEMSTATUS(loSec, "edit1", 5)
		    RETURN .F.
		ENDIF
		
		loSec.xObsEditando    = .T.
		loSec.xObsOriginal    = IIF(VARTYPE(loSec.edit1.Value) $ "CM", loSec.edit1.Value, "")
		loSec.edit1.Enabled   = .T.
		loSec.edit1.ReadOnly  = .F.
		loSec.edit1.BackColor = RGB(255,255,255)
		
		IF PEMSTATUS(loSec, "command3", 5)
		    loSec.command3.Caption = "GUARDAR"
		    loSec.command3.Enabled = .T.
		    loSec.command3.Refresh()
		ENDIF
		
		TRY
		    loSec.edit1.SetFocus()
		CATCH
		ENDTRY
		
		RETURN .T.
	ENDPROC

	PROCEDURE Init
		*=========================================================
		* formset.Init
		*=========================================================
		SET CENTURY ON
		
		IF !PEMSTATUS(THIS, "xEstaInicializando", 5)
		    THIS.AddProperty("xEstaInicializando", .F.)
		ELSE
		    THIS.xEstaInicializando = .F.
		ENDIF
		
		IF !PEMSTATUS(THIS, "xMensajePendiente", 5)
		    THIS.AddProperty("xMensajePendiente", "")
		ELSE
		    THIS.xMensajePendiente = ""
		ENDIF
		
		*-- Estado de captura de observaciones con CUATERNO
		IF !PEMSTATUS(THIS, "xObsCuaternoValor", 5)
		    THIS.AddProperty("xObsCuaternoValor", "")
		ELSE
		    THIS.xObsCuaternoValor = ""
		ENDIF
		
		IF !PEMSTATUS(THIS, "xObsCuaternoCancelado", 5)
		    THIS.AddProperty("xObsCuaternoCancelado", .T.)
		ELSE
		    THIS.xObsCuaternoCancelado = .T.
		ENDIF
		
		IF !PEMSTATUS(THIS, "xObsCuaternoAbierto", 5)
		    THIS.AddProperty("xObsCuaternoAbierto", .F.)
		ELSE
		    THIS.xObsCuaternoAbierto = .F.
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE inputnumerico
		*=========================================================
		* FormSet.InputNumerico
		* Crea y muestra un diálogo de entrada numérica modal
		* en tiempo de ejecución, sin PRG externo.
		* RETURNS: número ingresado, o .NULL. si se canceló o fuera de rango
		*
		* tnMin y tnMax son opcionales. Si tnMin < 0, la máscara
		* permite el signo "-".
		*=========================================================
		LPARAMETERS tcTitle, tcPrompt, tnDefault, tnDecimals, tnMin, tnMax
		LOCAL loFrm, luReturn
		LOCAL lnTxtWidth, lnTxtLeft
		LOCAL lnBtnWidth, lnBtnGap, lnBtnsTotal, lnBtnLeft1, lnBtnLeft2
		LOCAL lcSigno, lcMask
		tcTitle    = IIF(VARTYPE(tcTitle)    = "C", tcTitle,    "Ingresar valor")
		tcPrompt   = IIF(VARTYPE(tcPrompt)   = "C", tcPrompt,   "")
		tnDefault  = IIF(VARTYPE(tnDefault)  = "N", tnDefault,  0)
		tnDecimals = IIF(VARTYPE(tnDecimals) = "N", tnDecimals, 2)
		tnMin      = IIF(VARTYPE(tnMin)      = "N", tnMin,      0)
		tnMax      = IIF(VARTYPE(tnMax)      = "N", tnMax,      9999999)
		lnTxtWidth  = 95
		lnBtnWidth  = 88
		lnBtnGap    = 12
		lnBtnsTotal = (lnBtnWidth * 2) + lnBtnGap
		*--- Crear form dinámico ---
		loFrm = CREATEOBJECT("FORM")
		WITH loFrm
		    .Caption     = tcTitle
		    .Width       = 330
		    .Height      = 155
		    .BorderStyle = 0
		    .MinButton   = .F.
		    .MaxButton   = .F.
		    .KeyPreview  = .T.
		    .AutoCenter  = .T.
		    .WindowType  = 1
		    .Visible     = .F.
		    ADDPROPERTY(loFrm, "nResult",      tnDefault)
		    ADDPROPERTY(loFrm, "lCancelled",   .T.)
		    ADDPROPERTY(loFrm, "lDidActivate", .F.)
		ENDWITH
		lnTxtLeft  = INT((loFrm.Width - lnTxtWidth) / 2)
		lnBtnLeft1 = INT((loFrm.Width - lnBtnsTotal) / 2)
		lnBtnLeft2 = lnBtnLeft1 + lnBtnWidth + lnBtnGap
		*--- Label (prompt) ---
		loFrm.AddObject("lbl1", "LABEL")
		WITH loFrm.lbl1
		    .Caption  = tcPrompt
		    .Left     = 10
		    .Top      = 10
		    .Width    = 308
		    .Height   = 40
		    .WordWrap = .T.
		    .FontSize = 9
		    .Visible  = .T.
		ENDWITH
		
		*--- Construir máscara ---
		*   Si el rango admite negativos, NO usamos InputMask:
		*   el TextBox numérico admite "-" sin máscara y sin reservar espacio.
		IF tnMin < 0
		    lcMask = ""
		ELSE
		    lcMask = IIF(tnDecimals = 0, ;
		        "9999999", ;
		        "9999999." + REPLICATE("9", tnDecimals))
		ENDIF
		
		*--- TextBox numérico ---
		loFrm.AddObject("txt1", "TEXTBOX")
		WITH loFrm.txt1
		    .Left      = lnTxtLeft
		    .Top       = 58
		    .Width     = lnTxtWidth
		    .Height    = 26
		    .Value     = tnDefault
		    .Alignment = 1
		    .FontSize  = 10
		    .InputMask = lcMask
		    .Visible   = .T.
		ENDWITH
		*--- Botón Aceptar ---
		loFrm.AddObject("cmdOK", "COMMANDBUTTON")
		WITH loFrm.cmdOK
		    .Caption  = "\<Aceptar"
		    .Left     = lnBtnLeft1
		    .Top      = 98
		    .Width    = lnBtnWidth
		    .Height   = 27
		    .Default  = .T.
		    .FontSize = 9
		    .Visible  = .T.
		ENDWITH
		*--- Botón Cancelar ---
		loFrm.AddObject("cmdCan", "COMMANDBUTTON")
		WITH loFrm.cmdCan
		    .Caption  = "\<Cancelar"
		    .Left     = lnBtnLeft2
		    .Top      = 98
		    .Width    = lnBtnWidth
		    .Height   = 27
		    .Cancel   = .T.
		    .FontSize = 9
		    .Visible  = .T.
		ENDWITH
		*--- Guardar referencia temporal en el FormSet ---
		IF !PEMSTATUS(THISFORMSET, "xTmpInputFrm", 5)
		    ADDPROPERTY(THISFORMSET, "xTmpInputFrm", loFrm)
		ELSE
		    THISFORMSET.xTmpInputFrm = loFrm
		ENDIF
		*--- Bindear eventos ---
		BINDEVENT(loFrm.cmdOK,  "Click",       THISFORMSET, "xInputOKClick")
		BINDEVENT(loFrm.cmdCan, "Click",       THISFORMSET, "xInputCancelClick")
		BINDEVENT(loFrm,        "QueryUnload", THISFORMSET, "xInputQueryUnload")
		BINDEVENT(loFrm,        "Activate",    THISFORMSET, "xInputActivate")
		*--- Mostrar modal ---
		loFrm.Show()
		*--- Leer resultado post-modal + validar rango ---
		IF loFrm.lCancelled
		    luReturn = .NULL.
		ELSE
		    IF loFrm.nResult < tnMin OR loFrm.nResult > tnMax
		        MESSAGEBOX("El valor debe estar entre " + TRANSFORM(tnMin) + ;
		                   " y " + TRANSFORM(tnMax) + ".", 48, "Valor fuera de rango")
		        luReturn = .NULL.
		    ELSE
		        luReturn = loFrm.nResult
		    ENDIF
		ENDIF
		*--- Limpiar ---
		UNBINDEVENTS(loFrm)
		THISFORMSET.xTmpInputFrm = .NULL.
		loFrm = .NULL.
		RETURN luReturn
	ENDPROC

	PROCEDURE limpiardetallesolicitud
		*=========================================================
		* FormSet.LimpiarDetalleSolicitud
		*=========================================================
		LOCAL loFrm, loConsulta
		LOCAL lnC2, lcSafety
		
		loFrm      = THISFORMSET.principal
		loConsulta = .NULL.
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		*-- Validar estructura completa del cursor detalle
		IF USED("cur_soli_det")
		    IF TYPE("cur_soli_det.ui_item")      = "U" OR ;
		       TYPE("cur_soli_det.art_codi")     = "U" OR ;
		       TYPE("cur_soli_det.art_desc")     = "U" OR ;
		       TYPE("cur_soli_det.prov_codi")    = "U" OR ;
		       TYPE("cur_soli_det.det_prov")     = "U" OR ;
		       TYPE("cur_soli_det.det_moneda")   = "U" OR ;
		       TYPE("cur_soli_det.artpro_costo") = "U" OR ;
		       TYPE("cur_soli_det.artpro_codi")  = "U" OR ;
		       TYPE("cur_soli_det.cant_soli")    = "U" OR ;
		       TYPE("cur_soli_det.observacion")  = "U" OR ;
		       TYPE("cur_soli_det.tran_codi")    = "U" OR ;
		       TYPE("cur_soli_det.tran_nomb")    = "U"
		
		        USE IN cur_soli_det
		    ELSE
		        lcSafety = SET("SAFETY")
		        SET SAFETY OFF
		        SELECT cur_soli_det
		        ZAP
		
		        IF UPPER(ALLTRIM(lcSafety)) == "ON"
		            SET SAFETY ON
		        ELSE
		            SET SAFETY OFF
		        ENDIF
		    ENDIF
		ENDIF
		
		*-- Recrear cursor si no existe
		IF !USED("cur_soli_det")
		    CREATE CURSOR cur_soli_det ( ;
		        ui_item      C(8),    ;
		        art_codi     I,       ;
		        art_desc     C(80),   ;
		        prov_codi    I,       ;
		        det_prov     C(80),   ;
		        det_moneda   C(3),    ;
		        artpro_costo N(15,4), ;
		        artpro_codi  I,       ;
		        cant_soli    N(15,3), ;
		        observacion  M,       ;
		        tran_codi    I,       ;
		        tran_nomb    C(50) )
		ENDIF
		
		*-- Limpiar grid2
		IF VARTYPE(loConsulta) = "O" AND PEMSTATUS(loConsulta, "grid2", 5)
		
		    loConsulta.grid2.RecordSource = ""
		    loConsulta.grid2.RecordSource = "cur_soli_det"
		
		    FOR lnC2 = 1 TO loConsulta.grid2.ColumnCount
		        TRY
		            loConsulta.grid2.Columns(lnC2).DynamicBackColor = ""
		            loConsulta.grid2.Columns(lnC2).DynamicForeColor = ""
		            loConsulta.grid2.Columns(lnC2).DynamicFontBold  = ""
		            loConsulta.grid2.Columns(lnC2).DynamicFontSize  = ""
		        CATCH
		        ENDTRY
		    NEXT lnC2
		
		    loConsulta.grid2.Refresh()
		ENDIF
		
		*-- Limpiar observaciones y estado del editor
		IF VARTYPE(loConsulta) = "O"
		
		    IF PEMSTATUS(loConsulta, "edit1", 5)
		        loConsulta.edit1.Value     = ""
		        loConsulta.edit1.ReadOnly  = .T.
		        loConsulta.edit1.Enabled   = .F.
		        loConsulta.edit1.BackColor = RGB(245,245,245)
		        loConsulta.edit1.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(loConsulta, "command3", 5)
		        loConsulta.command3.Caption = "EDITAR"
		        loConsulta.command3.Enabled = .F.
		        loConsulta.command3.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(loConsulta, "xObsEditando", 5)
		        loConsulta.xObsEditando = .F.
		    ENDIF
		
		    IF PEMSTATUS(loConsulta, "xObsOriginal", 5)
		        loConsulta.xObsOriginal = ""
		    ENDIF
		
		    IF PEMSTATUS(loConsulta, "xSoliCodiActual", 5)
		        loConsulta.xSoliCodiActual = 0
		    ENDIF
		
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE limpiarnombrearchivowindows
		*=========================================================
		* FormSet.LimpiarNombreArchivoWindows
		* - Limpia caracteres inválidos para nombre de archivo
		*=========================================================
		LPARAMETERS tcTexto
		
		LOCAL lcOut
		
		lcOut = ALLTRIM(TRANSFORM(NVL(tcTexto, "")))
		
		lcOut = STRTRAN(lcOut, "\", "-")
		lcOut = STRTRAN(lcOut, "/", "-")
		lcOut = STRTRAN(lcOut, ":", "-")
		lcOut = STRTRAN(lcOut, "*", "")
		lcOut = STRTRAN(lcOut, "?", "")
		lcOut = STRTRAN(lcOut, CHR(34), "")
		lcOut = STRTRAN(lcOut, "<", "")
		lcOut = STRTRAN(lcOut, ">", "")
		lcOut = STRTRAN(lcOut, "|", "-")
		
		DO WHILE "  " $ lcOut
		    lcOut = STRTRAN(lcOut, "  ", " ")
		ENDDO
		
		lcOut = ALLTRIM(lcOut)
		
		IF EMPTY(lcOut)
		    lcOut = "SIN_NOMBRE"
		ENDIF
		
		RETURN lcOut
	ENDPROC

	PROCEDURE limpiarpanelarticulo
		*=========================================================
		* FormSet.LimpiarPanelArticulo
		* NO limpiar controles del layout base
		*=========================================================
		RETURN .T.
	ENDPROC

	PROCEDURE Load
		WAIT WINDOW "Inicializando Procesos..." NOWAIT
	ENDPROC

	PROCEDURE marcardesmarcartodos
		*=========================================================
		* FormSet.MarcarDesmarcarTodos
		* Botón dinámico: MARCAR / DESMARCAR TODOS
		*=========================================================
		LOCAL loFrm
		LOCAL lnArt, lnCant, lnSug, loEx
		LOCAL lnContador, lcCaptionActual, llEsMarcar
		LOCAL lnOldRec
		LOCAL lnProvCodi_, lnProvCosto_
		LOCAL llOk
		
		loFrm = THISFORMSET.principal
		
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0
		    RETURN .F.
		ENDIF
		
		IF !PEMSTATUS(loFrm, "btn_marcar_todos", 5)
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 1. Detectar acción actual
		*---------------------------------------------------------
		lcCaptionActual = UPPER(ALLTRIM(loFrm.btn_marcar_todos.Caption))
		llEsMarcar      = (lcCaptionActual == "MARCAR TODOS")
		
		WAIT WINDOW "Sincronizando con el servidor..." NOWAIT
		lnContador = 0
		lnOldRec   = 0
		
		TRY
		    loFrm.LockScreen = .T.
		
		    SELECT cur_alerts
		    IF RECCOUNT("cur_alerts") > 0
		        lnOldRec = RECNO("cur_alerts")
		    ENDIF
		
		    IF llEsMarcar
		        *-------------------------------------------------
		        * ACCIÓN: MARCAR TODO LO VISIBLE
		        *-------------------------------------------------
		        GO TOP
		        SCAN
		            lnArt = IIF(TYPE("cur_alerts.art_codi") = "N", cur_alerts.art_codi, 0)
		            lnSug = IIF(TYPE("cur_alerts.sugerido_comprar") = "N", NVL(cur_alerts.sugerido_comprar, 0), 0)
		
		            IF lnSug > 0
		                lnCant = ROUND(lnSug, 3)
		            ELSE
		                lnCant = 1
		            ENDIF
		
		            lnProvCodi_  = IIF(TYPE("cur_alerts.prov_codi_sel") = "N", cur_alerts.prov_codi_sel, 0)
		            lnProvCosto_ = IIF(TYPE("cur_alerts.artpro_costo")  = "N", cur_alerts.artpro_costo,  0)
		
		            llOk = THISFORMSET.CRUDTempSolicitudCompra("SAVE", lnArt, lnCant, lnProvCodi_, lnProvCosto_, "")
		
		            IF llOk
		                IF TYPE("cur_alerts.ui_sel") = "L"
		                    REPLACE ui_sel WITH .T.
		                ENDIF
		
		                IF TYPE("cur_alerts.cant_soli") = "N"
		                    REPLACE cant_soli WITH ROUND(lnCant, 3)
		                ENDIF
		
		                lnContador = lnContador + 1
		            ENDIF
		        ENDSCAN
		
		        loFrm.btn_marcar_todos.Caption = "DESMARCAR TODOS"
		
		    ELSE
		        *-------------------------------------------------
		        * ACCIÓN: DESMARCAR TODO LO VISIBLE
		        *-------------------------------------------------
		        GO TOP
		        SCAN
		            lnArt = IIF(TYPE("cur_alerts.art_codi") = "N", cur_alerts.art_codi, 0)
		
		            llOk = THISFORMSET.CRUDTempSolicitudCompra("DELETE", lnArt, 0, 0, 0, "")
		
		            IF llOk
		                IF TYPE("cur_alerts.ui_sel") = "L"
		                    REPLACE ui_sel WITH .F.
		                ENDIF
		
		                IF TYPE("cur_alerts.cant_soli") = "N"
		                    REPLACE cant_soli WITH 0
		                ENDIF
		
		                lnContador = lnContador + 1
		            ENDIF
		        ENDSCAN
		
		        loFrm.btn_marcar_todos.Caption = "MARCAR TODOS"
		    ENDIF
		
		    * Restaurar posición
		    IF lnOldRec > 0 AND lnOldRec <= RECCOUNT("cur_alerts")
		        GO lnOldRec
		    ENDIF
		
		CATCH TO loEx
		    MESSAGEBOX("Error en proceso: " + TRANSFORM(loEx.Message), 16, "Error")
		
		FINALLY
		    loFrm.LockScreen = .F.
		ENDTRY
		
		*---------------------------------------------------------
		* 3. Sincronización final de interfaz
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "SincronizarPedido", 5)
		    THISFORMSET.SincronizarPedido()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "SincronizarBotonMasivo", 5)
		    THISFORMSET.SincronizarBotonMasivo()
		ENDIF
		
		*---------------------------------------------------------
		* Si estaba filtrado por SELECCIONADOS y se presionó
		* DESMARCAR TODOS, hay que reconstruir el filtro.
		* Si no, el grid queda mostrando registros viejos.
		*---------------------------------------------------------
		IF !llEsMarcar ;
		    AND PEMSTATUS(loFrm, "xFiltroActual", 5) ;
		    AND UPPER(ALLTRIM(NVL(loFrm.xFiltroActual, ""))) == "SELECCIONADOS"
		
		    IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		        THISFORMSET.AplicarFiltroLocal("SELECCIONADOS", 0)
		    ENDIF
		
		ELSE
		    IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		        THISFORMSET.RefrescarGrid()
		    ELSE
		        IF PEMSTATUS(loFrm, "grd_alerts", 5)
		            loFrm.grd_alerts.Refresh()
		        ENDIF
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarEfectoGrid", 5)
		    THISFORMSET.ActualizarEfectoGrid(0)
		ENDIF
		
		WAIT CLEAR
		
		IF lnContador > 0
		    MESSAGEBOX("Se han procesado " + TRANSFORM(lnContador) + " registros.", 64, "Proceso Exitoso")
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE modificarsolicitud
		*=========================================================
		* FormSet.ModificarSolicitud
		* Carga una solicitud existente en cur_alerts (ui_sel=.T.)
		* y vuelca su detalle en temp_solicitud_compra para edición
		*
		* IMPORTANTE:
		* - No pasa lnConn a CRUDTempSolicitudCompra.
		* - Limpia temp con SQLEXEC directo usando la misma conexión.
		* - Cierra lnConn una sola vez y lo deja en 0.
		* - Fuerza combo1 a SELECCIONADOS.
		*=========================================================
		LPARAMETERS tnSoliCodi
		
		LOCAL loFrm, loConsulta
		LOCAL lnConn, lnRet, lcSQL, lcObs, lcEstado
		LOCAL lnResp
		LOCAL lnI, lcItem
		
		loFrm      = THISFORMSET.principal
		loConsulta = .NULL.
		lnConn     = 0
		lnRet      = 0
		lcSQL      = ""
		lcObs      = ""
		lcEstado   = ""
		lnResp     = 0
		
		
		IF PEMSTATUS(THISFORMSET, "secundario", 5)
		    loConsulta = THISFORMSET.secundario
		ENDIF
		
		*---------------------------------------------------------
		* Validar solicitud
		*---------------------------------------------------------
		IF VARTYPE(tnSoliCodi) <> "N" OR tnSoliCodi <= 0
		    MESSAGEBOX("Solicitud inválida.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		lnResp = MESSAGEBOX( ;
		    "¿Desea cargar la Solicitud N° " + TRANSFORM(tnSoliCodi) + " para modificarla?" + CHR(13) + ;
		    "Esto reemplazará la lista actual de seleccionados.", ;
		    36, ;
		    "Confirmar")
		
		IF lnResp <> 6
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Abrir conexión
		*---------------------------------------------------------
		lnConn = Conectar_DB(_screen.cn)
		
		IF VARTYPE(lnConn) <> "N" OR lnConn <= 0
		    MESSAGEBOX("No se pudo conectar a MySQL.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Leer estado y observaciones actuales de la solicitud
		* Validación:
		* - Si estado = COMPRADO, NO se permite modificar.
		*---------------------------------------------------------
		lcObs    = ""
		lcEstado = ""
		
		lnRet = SQLEXEC(lnConn, ;
		    "SELECT " + ;
		    "UPPER(TRIM(IFNULL(estado,''))) AS estado, " + ;
		    "IFNULL(observaciones,'') AS observaciones " + ;
		    "FROM solicitud_compra " + ;
		    "WHERE soli_codi = ?tnSoliCodi", ;
		    "cur_obs_tmp")
		
		IF lnRet < 0
		    IF VARTYPE(lnConn) = "N" AND lnConn > 0
		        Desconectar_DB(lnConn)
		        lnConn = 0
		    ENDIF
		
		    MESSAGEBOX("No se pudo validar el estado de la solicitud.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		IF !USED("cur_obs_tmp") OR RECCOUNT("cur_obs_tmp") <= 0
		    IF VARTYPE(lnConn) = "N" AND lnConn > 0
		        Desconectar_DB(lnConn)
		        lnConn = 0
		    ENDIF
		
		    MESSAGEBOX("No se encontró la Solicitud N° " + TRANSFORM(tnSoliCodi) + ".", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		SELECT cur_obs_tmp
		GO TOP
		
		IF TYPE("cur_obs_tmp.estado") <> "U"
		    lcEstado = UPPER(ALLTRIM(NVL(cur_obs_tmp.estado, "")))
		ENDIF
		
		IF TYPE("cur_obs_tmp.observaciones") <> "U"
		    lcObs = ALLTRIM(NVL(cur_obs_tmp.observaciones, ""))
		ENDIF
		
		IF USED("cur_obs_tmp")
		    USE IN cur_obs_tmp
		ENDIF
		
		*---------------------------------------------------------
		* Bloqueo de modificación para solicitudes ya compradas
		*---------------------------------------------------------
		IF lcEstado == "COMPRADO"
		
		    IF VARTYPE(lnConn) = "N" AND lnConn > 0
		        Desconectar_DB(lnConn)
		        lnConn = 0
		    ENDIF
		
		    IF VARTYPE(loConsulta) = "O"
		
		        IF PEMSTATUS(loConsulta, "edit1", 5)
		            loConsulta.edit1.ReadOnly  = .T.
		            loConsulta.edit1.Enabled   = .F.
		            loConsulta.edit1.BackColor = RGB(245,245,245)
		            loConsulta.edit1.Refresh()
		        ENDIF
		
		        IF PEMSTATUS(loConsulta, "xObsEditando", 5)
		            loConsulta.xObsEditando = .F.
		        ENDIF
		
		        IF PEMSTATUS(loConsulta, "command3", 5)
		            loConsulta.command3.Caption = "EDITAR"
		            loConsulta.command3.Enabled = .F.
		            loConsulta.command3.Refresh()
		        ENDIF
		
		        IF PEMSTATUS(loConsulta, "xSoliCodiActual", 5)
		            loConsulta.xSoliCodiActual = tnSoliCodi
		        ELSE
		            loConsulta.AddProperty("xSoliCodiActual", tnSoliCodi)
		        ENDIF
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "ActualizarLabelEstadoOC", 5)
		        THISFORMSET.ActualizarLabelEstadoOC(tnSoliCodi)
		    ENDIF
		
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Limpiar temp usando la MISMA conexión local
		* IMPORTANTE:
		* No usar CRUDTempSolicitudCompra("CLEAR", ..., lnConn)
		* porque puede cerrar/invalidar el handle.
		*---------------------------------------------------------
		lnRet = SQLEXEC(lnConn, "DELETE FROM temp_solicitud_compra")
		
		IF lnRet < 0
		    IF VARTYPE(lnConn) = "N" AND lnConn > 0
		        Desconectar_DB(lnConn)
		        lnConn = 0
		    ENDIF
		
		    MESSAGEBOX("No se pudo limpiar la tabla temporal.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Volcar detalle actual a temp para edición
		* Incluye tran_codi para no perder el transporte al modificar
		*---------------------------------------------------------
		TEXT TO lcSQL NOSHOW PRETEXT 15
		    INSERT INTO temp_solicitud_compra
		        (
		            art_codi,
		            prov_codi,
		            tran_codi,
		            artpro_costo,
		            cant_soli,
		            fecha_agregado,
		            observacion
		        )
		    SELECT
		        d.art_codi,
		        d.prov_codi,
		        d.tran_codi,
		        IFNULL(d.artpro_costo, 0),
		        IFNULL(d.cant_soli, 0),
		        NOW(),
		        IFNULL(d.observacion, '')
		    FROM solicitud_compra_art d
		    WHERE d.soli_codi = ?tnSoliCodi
		ENDTEXT
		
		lnRet = SQLEXEC(lnConn, lcSQL)
		
		IF lnRet < 0
		    IF VARTYPE(lnConn) = "N" AND lnConn > 0
		        Desconectar_DB(lnConn)
		        lnConn = 0
		    ENDIF
		
		    MESSAGEBOX("No se pudo cargar el detalle en la tabla temporal.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Cerrar conexión correctamente
		*---------------------------------------------------------
		IF VARTYPE(lnConn) = "N" AND lnConn > 0
		    Desconectar_DB(lnConn)
		    lnConn = 0
		ENDIF
		
		*---------------------------------------------------------
		* Marcar modo edición en FormSet
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "xSoliEditando", 5)
		    THISFORMSET.AddProperty("xSoliEditando", 0)
		ENDIF
		
		THISFORMSET.xSoliEditando = tnSoliCodi
		
		IF !PEMSTATUS(THISFORMSET, "xObsEditando", 5)
		    THISFORMSET.AddProperty("xObsEditando", "")
		ENDIF
		
		THISFORMSET.xObsEditando = lcObs
		
		*---------------------------------------------------------
		* Reflejar también en secundario
		*---------------------------------------------------------
		IF VARTYPE(loConsulta) = "O"
		    IF !PEMSTATUS(loConsulta, "xSoliCodiActual", 5)
		        loConsulta.AddProperty("xSoliCodiActual", 0)
		    ENDIF
		
		    loConsulta.xSoliCodiActual = tnSoliCodi
		ENDIF
		
		*---------------------------------------------------------
		* Cargar dataset principal
		* - Recupera artículos de la solicitud a cur_alerts
		* - Marca ui_sel = .T.
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "CargarSolicitudesHistoricas", 5)
		    IF !THISFORMSET.CargarSolicitudesHistoricas(tnSoliCodi)
		        MESSAGEBOX("No se pudo cargar la solicitud histórica en la grilla principal.", 16, "Error")
		        RETURN .F.
		    ENDIF
		ELSE
		    MESSAGEBOX("No existe el método CargarSolicitudesHistoricas.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Forzar filtro SELECCIONADOS
		* IMPORTANTE:
		* DisplayValue solo no alcanza. Hay que forzar Value/ListIndex.
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ForzarComboSeleccionados", 5)
		    THISFORMSET.ForzarComboSeleccionados()
		ELSE
		    IF PEMSTATUS(loFrm, "xFiltroActual", 5)
		        loFrm.xFiltroActual = "SELECCIONADOS"
		    ELSE
		        loFrm.AddProperty("xFiltroActual", "SELECCIONADOS")
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "combo1", 5)
		
		        TRY
		            loFrm.combo1.Value = "SELECCIONADOS"
		        CATCH
		        ENDTRY
		
		        TRY
		            loFrm.combo1.DisplayValue = "SELECCIONADOS"
		        CATCH
		        ENDTRY
		
		        TRY
		            FOR lnI = 1 TO loFrm.combo1.ListCount
		                lcItem = UPPER(ALLTRIM(TRANSFORM(loFrm.combo1.List(lnI))))
		
		                IF lcItem == "SELECCIONADOS"
		                    loFrm.combo1.ListIndex = lnI
		                    EXIT
		                ENDIF
		            ENDFOR
		        CATCH
		        ENDTRY
		
		        loFrm.combo1.Refresh()
		    ENDIF
		ENDIF
		
		
		
		*---------------------------------------------------------
		* Aplicar filtro local después de cargar artículos
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		    THISFORMSET.AplicarFiltroLocal("SELECCIONADOS", 0)
		ENDIF
		
		*---------------------------------------------------------
		* Al volver a principal en SELECCIONADOS,
		* ocultar controles auxiliares de otros filtros
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "OcultarControlesFiltrosAuxiliares", 5)
		    THISFORMSET.OcultarControlesFiltrosAuxiliares()
		ENDIF
		
		*---------------------------------------------------------
		* Reforzar combo después del filtro
		* Algunos métodos refrescan/rebindean y pueden pisarlo.
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ForzarComboSeleccionados", 5)
		    THISFORMSET.ForzarComboSeleccionados()
		ELSE
		    IF PEMSTATUS(loFrm, "combo1", 5)
		        TRY
		            loFrm.combo1.Value = "SELECCIONADOS"
		        CATCH
		        ENDTRY
		
		        TRY
		            loFrm.combo1.DisplayValue = "SELECCIONADOS"
		        CATCH
		        ENDTRY
		
		        loFrm.combo1.Refresh()
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* Actualizaciones visuales
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ActualizarVisibilidadColumnaObservacion", 5)
		    THISFORMSET.ActualizarVisibilidadColumnaObservacion()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		    THISFORMSET.RefrescarGrid()
		ELSE
		    IF VARTYPE(loFrm) = "O" AND PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.Refresh()
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* Último refuerzo visual después del refresh final
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ForzarComboSeleccionados", 5)
		    THISFORMSET.ForzarComboSeleccionados()
		ELSE
		    IF PEMSTATUS(loFrm, "combo1", 5)
		        TRY
		            loFrm.combo1.Value = "SELECCIONADOS"
		        CATCH
		        ENDTRY
		
		        TRY
		            loFrm.combo1.DisplayValue = "SELECCIONADOS"
		        CATCH
		        ENDTRY
		
		        loFrm.combo1.Refresh()
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* Señal visual de edición
		*---------------------------------------------------------
		IF VARTYPE(loFrm) = "O"
		
		    IF PEMSTATUS(loFrm, "cmd_confirmar", 5)
		        loFrm.cmd_confirmar.Caption = "Guardar cambios"
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "lbl_modo_edicion", 5)
		        loFrm.lbl_modo_edicion.Caption = "Editando Solicitud N° " + TRANSFORM(tnSoliCodi)
		        loFrm.lbl_modo_edicion.Visible = .T.
		    ENDIF
		
		    loFrm.Refresh()
		ENDIF
		
		*---------------------------------------------------------
		* Cerrar secundario y devolver control total al principal
		*---------------------------------------------------------
		IF VARTYPE(loConsulta) = "O"
		
		    TRY
		        loConsulta.LockScreen = .F.
		    CATCH
		    ENDTRY
		
		    TRY
		        loConsulta.Hide()
		    CATCH
		    ENDTRY
		
		ENDIF
		
		*---------------------------------------------------------
		* Reactivar principal
		* Esto evita que quede visible pero sin interacción.
		*---------------------------------------------------------
		IF VARTYPE(loFrm) = "O"
		
		    TRY
		        loFrm.LockScreen = .F.
		    CATCH
		    ENDTRY
		
		    TRY
		        loFrm.Enabled = .T.
		    CATCH
		    ENDTRY
		
		    TRY
		        loFrm.Visible = .T.
		    CATCH
		    ENDTRY
		
		    TRY
		        loFrm.WindowState = 0
		    CATCH
		    ENDTRY
		
		ENDIF
		
		*---------------------------------------------------------
		* Forzar nuevamente combo/filtro SELECCIONADOS
		* después de cerrar secundario.
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "ForzarComboSeleccionados", 5)
		    THISFORMSET.ForzarComboSeleccionados()
		ELSE
		    IF VARTYPE(loFrm) = "O"
		
		        IF !PEMSTATUS(loFrm, "xFiltroActual", 5)
		            loFrm.AddProperty("xFiltroActual", "SELECCIONADOS")
		        ELSE
		            loFrm.xFiltroActual = "SELECCIONADOS"
		        ENDIF
		
		        IF PEMSTATUS(loFrm, "combo1", 5)
		
		            TRY
		                loFrm.combo1.Value = "SELECCIONADOS"
		            CATCH
		            ENDTRY
		
		            TRY
		                loFrm.combo1.DisplayValue = "SELECCIONADOS"
		            CATCH
		            ENDTRY
		
		            TRY
		                FOR lnI = 1 TO loFrm.combo1.ListCount
		                    lcItem = UPPER(ALLTRIM(TRANSFORM(loFrm.combo1.List(lnI))))
		
		                    IF lcItem == "SELECCIONADOS"
		                        loFrm.combo1.ListIndex = lnI
		                        EXIT
		                    ENDIF
		                ENDFOR
		            CATCH
		            ENDTRY
		
		            loFrm.combo1.Refresh()
		        ENDIF
		    ENDIF
		ENDIF
		
		*---------------------------------------------------------
		* Reaplicar filtro local y refrescar principal
		*---------------------------------------------------------
		IF PEMSTATUS(THISFORMSET, "AplicarFiltroLocal", 5)
		    THISFORMSET.AplicarFiltroLocal("SELECCIONADOS", 0)
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "OcultarControlesFiltrosAuxiliares", 5)
		    THISFORMSET.OcultarControlesFiltrosAuxiliares()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ActualizarVisibilidadColumnaObservacion", 5)
		    THISFORMSET.ActualizarVisibilidadColumnaObservacion()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "RefrescarGrid", 5)
		    THISFORMSET.RefrescarGrid()
		ELSE
		    IF VARTYPE(loFrm) = "O" AND PEMSTATUS(loFrm, "grd_alerts", 5)
		        loFrm.grd_alerts.Refresh()
		    ENDIF
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "OcultarControlesFiltrosAuxiliares", 5)
		    THISFORMSET.OcultarControlesFiltrosAuxiliares()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ForzarComboSeleccionados", 5)
		    THISFORMSET.ForzarComboSeleccionados()
		ENDIF
		
		*---------------------------------------------------------
		* Foco real al grid principal
		*---------------------------------------------------------
		IF VARTYPE(loFrm) = "O"
		
		    TRY
		        loFrm.Show()
		    CATCH
		    ENDTRY
		
		    TRY
		        loFrm.Activate()
		    CATCH
		    ENDTRY
		
		    IF PEMSTATUS(loFrm, "grd_alerts", 5)
		        TRY
		            loFrm.grd_alerts.SetFocus()
		        CATCH
		        ENDTRY
		
		        TRY
		            loFrm.grd_alerts.Refresh()
		        CATCH
		        ENDTRY
		    ENDIF
		
		    TRY
		        loFrm.Refresh()
		    CATCH
		    ENDTRY
		
		ENDIF
		
		CLEAR TYPEAHEAD
		DOEVENTS FORCE
		
		MESSAGEBOX( ;
		    "Solicitud N° " + TRANSFORM(tnSoliCodi) + " cargada para modificación.", ;
		    64, ;
		    "Modo edición")
		
		RETURN .T.
	ENDPROC

	PROCEDURE mostrarcuaternomodal
		*=========================================================
		* FormSet.MostrarCuaternoModal
		* - Centraliza la apertura modal del cuaterno
		* - Devuelve .T. si el usuario guarda / confirma
		* - Devuelve .F. si cancela / cierra
		* - NO usa Visible=.T. antes de Show(1)
		* - NO usa DO WHILE después de Show(1)
		*=========================================================
		LPARAMETERS tcTitulo, tcLabel, tcValorInicial, tlReadOnly
		
		LOCAL loCuaterno
		LOCAL llOk
		LOCAL lcTitulo, lcLabel, lcValor
		
		loCuaterno = .NULL.
		llOk       = .F.
		lcTitulo   = ""
		lcLabel    = ""
		lcValor    = ""
		
		*---------------------------------------------------------
		* 1. Normalizar parámetros
		*---------------------------------------------------------
		IF VARTYPE(tcTitulo) = "C" AND !EMPTY(ALLTRIM(tcTitulo))
		    lcTitulo = ALLTRIM(tcTitulo)
		ELSE
		    lcTitulo = "Observación"
		ENDIF
		
		IF VARTYPE(tcLabel) = "C"
		    lcLabel = ALLTRIM(tcLabel)
		ELSE
		    lcLabel = ""
		ENDIF
		
		DO CASE
		CASE VARTYPE(tcValorInicial) = "C"
		    lcValor = ALLTRIM(tcValorInicial)
		
		CASE VARTYPE(tcValorInicial) = "M"
		    lcValor = ALLTRIM(tcValorInicial)
		
		OTHERWISE
		    lcValor = ""
		ENDCASE
		
		IF VARTYPE(tlReadOnly) <> "L"
		    tlReadOnly = .F.
		ENDIF
		
		*---------------------------------------------------------
		* 2. Validar cuaterno
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "cuaterno", 5)
		    MESSAGEBOX("No existe el formulario cuaterno en el FormSet.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		loCuaterno = THISFORMSET.cuaterno
		
		IF VARTYPE(loCuaterno) <> "O"
		    MESSAGEBOX("El formulario cuaterno no está disponible.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* 3. Asegurar propiedades del FormSet
		*---------------------------------------------------------
		IF !PEMSTATUS(THISFORMSET, "xObsCuaternoValor", 5)
		    THISFORMSET.AddProperty("xObsCuaternoValor", "")
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xObsCuaternoCancelado", 5)
		    THISFORMSET.AddProperty("xObsCuaternoCancelado", .T.)
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xObsCuaternoAbierto", 5)
		    THISFORMSET.AddProperty("xObsCuaternoAbierto", .F.)
		ENDIF
		
		IF !PEMSTATUS(THISFORMSET, "xModoCuaterno", 5)
		    THISFORMSET.AddProperty("xModoCuaterno", "")
		ENDIF
		
		*---------------------------------------------------------
		* 4. Asegurar propiedades internas del cuaterno
		*---------------------------------------------------------
		IF !PEMSTATUS(loCuaterno, "xValor", 5)
		    loCuaterno.AddProperty("xValor", "")
		ENDIF
		
		IF !PEMSTATUS(loCuaterno, "xCancelado", 5)
		    loCuaterno.AddProperty("xCancelado", .T.)
		ENDIF
		
		IF !PEMSTATUS(loCuaterno, "xOpenSeconds", 5)
		    loCuaterno.AddProperty("xOpenSeconds", 0)
		ENDIF
		
		*---------------------------------------------------------
		* 5. Reset de estado
		*---------------------------------------------------------
		THISFORMSET.xObsCuaternoValor     = lcValor
		THISFORMSET.xObsCuaternoCancelado = .T.
		THISFORMSET.xObsCuaternoAbierto   = .T.
		
		loCuaterno.xValor       = lcValor
		loCuaterno.xCancelado   = .T.
		loCuaterno.xOpenSeconds = SECONDS()
		
		*---------------------------------------------------------
		* 6. Preparar interfaz
		*---------------------------------------------------------
		WITH loCuaterno
		
		    .Caption = lcTitulo
		
		    IF PEMSTATUS(loCuaterno, "label1", 5)
		        .label1.Caption = lcLabel
		    ENDIF
		
		    IF PEMSTATUS(loCuaterno, "edit1", 5)
		        .edit1.Enabled   = .T.
		        .edit1.ReadOnly  = tlReadOnly
		        .edit1.Value     = lcValor
		        .edit1.BackColor = RGB(255,255,255)
		        .edit1.ForeColor = RGB(0,0,0)
		        .edit1.Refresh()
		    ENDIF
		
		    IF PEMSTATUS(loCuaterno, "command1", 5)
		        .command1.Visible = !tlReadOnly
		        .command1.Enabled = !tlReadOnly
		        .command1.Default = .F.
		        .command1.Cancel  = .F.
		    ENDIF
		
		    IF PEMSTATUS(loCuaterno, "command2", 5)
		        .command2.Visible = .T.
		        .command2.Enabled = .T.
		        .command2.Caption = IIF(tlReadOnly, "Cerrar", "Cancelar")
		        .command2.Default = .F.
		        .command2.Cancel  = .F.
		    ENDIF
		
		ENDWITH
		
		*---------------------------------------------------------
		* 7. Apertura modal correcta
		* IMPORTANTE:
		* Nunca Visible=.T. antes de Show(1)
		*---------------------------------------------------------
		IF loCuaterno.Visible
		    loCuaterno.Hide()
		ENDIF
		
		loCuaterno.Visible     = .F.
		loCuaterno.AlwaysOnTop = .T.
		loCuaterno.AutoCenter  = .T.
		
		CLEAR TYPEAHEAD
		
		loCuaterno.Show(1)
		
		CLEAR TYPEAHEAD
		
		*---------------------------------------------------------
		* 8. Recuperar resultado
		*---------------------------------------------------------
		IF PEMSTATUS(loCuaterno, "xCancelado", 5) AND loCuaterno.xCancelado
		    THISFORMSET.xObsCuaternoValor     = ""
		    THISFORMSET.xObsCuaternoCancelado = .T.
		    llOk = .F.
		ELSE
		    IF PEMSTATUS(loCuaterno, "xValor", 5)
		        THISFORMSET.xObsCuaternoValor = ALLTRIM(NVL(loCuaterno.xValor, ""))
		    ELSE
		        THISFORMSET.xObsCuaternoValor = ""
		    ENDIF
		
		    THISFORMSET.xObsCuaternoCancelado = .F.
		    llOk = .T.
		ENDIF
		
		*---------------------------------------------------------
		* 9. Cierre seguro
		*---------------------------------------------------------
		THISFORMSET.xObsCuaternoAbierto = .F.
		
		TRY
		    loCuaterno.AlwaysOnTop = .F.
		
		    IF loCuaterno.Visible
		        loCuaterno.Hide()
		    ENDIF
		CATCH
		ENDTRY
		
		RETURN llOk
	ENDPROC

	PROCEDURE mostrarfiltropedidos
		*=========================================================
		* FormSet.MostrarFiltroPedidos
		*=========================================================
		LPARAMETERS tlMostrar
		
		LOCAL llMostrar, loFrm
		
		llMostrar = IIF(VARTYPE(tlMostrar) = "L", tlMostrar, .F.)
		
		IF TYPE("THISFORMSET.principal.Name") = "U"
		    RETURN .F.
		ENDIF
		
		loFrm = THISFORMSET.principal
		
		IF VARTYPE(loFrm) # "O"
		    RETURN .F.
		ENDIF
		
		IF PEMSTATUS(loFrm, "etq_fecdes", 5)
		    loFrm.etq_fecdes.Visible = llMostrar
		ENDIF
		
		IF PEMSTATUS(loFrm, "txt_fecdes", 5)
		    loFrm.txt_fecdes.Visible = llMostrar
		ENDIF
		
		IF PEMSTATUS(loFrm, "cmdcal1", 5)
		    loFrm.cmdcal1.Visible = llMostrar
		ENDIF
		
		IF PEMSTATUS(loFrm, "etq_fechas", 5)
		    loFrm.etq_fechas.Visible = llMostrar
		ENDIF
		
		IF PEMSTATUS(loFrm, "txt_fechas", 5)
		    loFrm.txt_fechas.Visible = llMostrar
		ENDIF
		
		IF PEMSTATUS(loFrm, "cmdcal2", 5)
		    loFrm.cmdcal2.Visible = llMostrar
		ENDIF
		
		*---------------------------------------------------------
		* Combo5: visible solo para filtro PEDIDOS
		*---------------------------------------------------------
		IF PEMSTATUS(loFrm, "combo5", 5)
		    loFrm.combo5.Visible = llMostrar
		ENDIF
		
		IF llMostrar
		    IF PEMSTATUS(loFrm, "combo5", 5)
		        loFrm.combo5.Value = "TODOS"
		    ENDIF
		    IF PEMSTATUS(loFrm, "xPedidosModoFiltro", 5)
		        loFrm.xPedidosModoFiltro = "TODOS"
		    ENDIF
		    IF PEMSTATUS(loFrm, "xCombo5ValorActual", 5)
		        loFrm.xCombo5ValorActual = "TODOS"
		    ENDIF
		ELSE
		    IF PEMSTATUS(loFrm, "xPedidosModoFiltro", 5)
		        loFrm.xPedidosModoFiltro = ""
		    ENDIF
		
		    IF PEMSTATUS(loFrm, "xCombo5ValorActual", 5)
		        loFrm.xCombo5ValorActual = ""
		    ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE mostrarmenucontextogrid
		*=========================================================
		* FormSet.MostrarMenuContextoGrid
		* Menú contextual unificado para grd_alerts
		* - Siempre: Ajustar Pos.Min. / Ajustar % Alerta / Estado
		* - Solo SELECCIONADOS: + Editar Cantidad / Observación
		* - Limpia TYPEAHEAD antes de abrir cuaterno
		*=========================================================
		LOCAL loFrm, lcFiltro, lcPromptObs, lcObsActual
		LOCAL lnArtCodi, lnPosMin, lnPctAlerta, lnEstado
		LOCAL lnConn, lnRet, luEst
		LOCAL lnBarEditar, lnBarObs, lnBarPosMin, lnBarPctAlerta, lnBarEstado
		LOCAL lnBar
		PRIVATE pnCtxSel
		
		loFrm   = THISFORMSET.principal
		lcFiltro = ""
		
		IF PEMSTATUS(loFrm, "xFiltroActual", 5)
		    lcFiltro = UPPER(ALLTRIM(NVL(loFrm.xFiltroActual, "")))
		ENDIF
		
		*---------------------------------------------------------
		* Validar cursor principal
		*---------------------------------------------------------
		IF !USED("cur_alerts") OR RECCOUNT("cur_alerts") = 0 OR EOF("cur_alerts")
		    RETURN .F.
		ENDIF
		
		SELECT cur_alerts
		
		lnArtCodi   = IIF(TYPE("cur_alerts.art_codi") = "N", NVL(cur_alerts.art_codi, 0), 0)
		lnPosMin    = IIF(TYPE("cur_alerts.art_stmin") = "N", NVL(cur_alerts.art_stmin, 0), 0)
		lnPctAlerta = IIF(TYPE("cur_alerts.art_pct_alerta") = "N", NVL(cur_alerts.art_pct_alerta, 0), 0)
		
		IF lnArtCodi <= 0
		    RETURN .F.
		ENDIF
		
		*---------------------------------------------------------
		* Observación actual
		*---------------------------------------------------------
		lcObsActual = ""
		
		IF TYPE("cur_alerts.observacion") <> "U"
		    lcObsActual = ALLTRIM(NVL(cur_alerts.observacion, ""))
		ENDIF
		
		lcPromptObs = "Agregar Observación"
		
		IF !EMPTY(lcObsActual)
		    lcPromptObs = "Editar Observación"
		ENDIF
		
		*---------------------------------------------------------
		* Obtener estado actual del item mostrado en cur_alerts
		*---------------------------------------------------------
		lnEstado = 1
		
		IF TYPE("cur_alerts.estado") <> "U"
		    luEst = cur_alerts.estado
		
		    DO CASE
		    CASE ISNULL(luEst)
		        lnEstado = 1
		
		    CASE VARTYPE(luEst) = "L"
		        lnEstado = IIF(luEst, 1, 0)
		
		    CASE VARTYPE(luEst) = "N" OR VARTYPE(luEst) = "I"
		        lnEstado = INT(luEst)
		
		    CASE VARTYPE(luEst) = "C"
		        lnEstado = VAL(ALLTRIM(luEst))
		
		    OTHERWISE
		        lnEstado = 1
		    ENDCASE
		ENDIF
		
		
		*---------------------------------------------------------
		* Construir popup
		*---------------------------------------------------------
		pnCtxSel = 0
		
		TRY
		    RELEASE POPUPS _mnu_grd_ctx
		CATCH
		ENDTRY
		
		DEFINE POPUP _mnu_grd_ctx SHORTCUT RELATIVE FROM MROW(), MCOL()
		ON SELECTION POPUP _mnu_grd_ctx pnCtxSel = BAR()
		
		lnBar = 1
		
		lnBarEditar    = 0
		lnBarObs       = 0
		lnBarPosMin    = 0
		lnBarPctAlerta = 0
		lnBarEstado    = 0
		
		*---------------------------------------------------------
		* Opciones exclusivas de SELECCIONADOS
		*---------------------------------------------------------
		IF lcFiltro == "SELECCIONADOS"
		
		    lnBarEditar = lnBar
		    DEFINE BAR lnBar OF _mnu_grd_ctx PROMPT "\<Editar Cantidad"
		    lnBar = lnBar + 1
		
		    lnBarObs = lnBar
		    DEFINE BAR lnBar OF _mnu_grd_ctx PROMPT lcPromptObs
		    lnBar = lnBar + 1
		
		    DEFINE BAR lnBar OF _mnu_grd_ctx PROMPT "\-"
		    lnBar = lnBar + 1
		
		ENDIF
		
		*---------------------------------------------------------
		* Opciones siempre visibles
		*---------------------------------------------------------
		lnBarPosMin = lnBar
		DEFINE BAR lnBar OF _mnu_grd_ctx PROMPT ;
		    "Ajustar Pos.Min.  [" + ALLTRIM(STR(lnPosMin, 10, 3)) + "]"
		lnBar = lnBar + 1
		
		lnBarPctAlerta = lnBar
		DEFINE BAR lnBar OF _mnu_grd_ctx PROMPT ;
		    "Ajustar % Alerta  [" + ALLTRIM(STR(lnPctAlerta, 5, 0)) + "%]"
		lnBar = lnBar + 1
		
		lnBarEstado = lnBar
		DEFINE BAR lnBar OF _mnu_grd_ctx PROMPT ;
			"Estado [" + IIF(lnEstado = 1, "ACTIVO", "INACTIVO") + "]"
		
		*---------------------------------------------------------
		* Activar menú
		*---------------------------------------------------------
		ACTIVATE POPUP _mnu_grd_ctx
		
		TRY
		    RELEASE POPUPS _mnu_grd_ctx
		CATCH
		ENDTRY
		
		*---------------------------------------------------------
		* Restaurar alias principal antes de despachar
		*---------------------------------------------------------
		IF USED("cur_alerts")
		    SELECT cur_alerts
		ENDIF
		
		*---------------------------------------------------------
		* Despachar acción seleccionada
		*---------------------------------------------------------
		DO CASE
		
		CASE pnCtxSel = 0
		    * ESC / sin selección
		    CLEAR TYPEAHEAD
		    RETURN .F.
		
		CASE pnCtxSel = lnBarEditar AND lnBarEditar > 0
		    CLEAR TYPEAHEAD
		
		    IF PEMSTATUS(THISFORMSET, "EditarCantidadAlerta", 5)
		        THISFORMSET.EditarCantidadAlerta()
		    ENDIF
		
		CASE pnCtxSel = lnBarObs AND lnBarObs > 0
		    CLEAR TYPEAHEAD
		
		    *-----------------------------------------------------
		    * Reset defensivo del estado cuaterno
		    *-----------------------------------------------------
		    IF PEMSTATUS(THISFORMSET, "xObsCuaternoAbierto", 5)
		        THISFORMSET.xObsCuaternoAbierto = .F.
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "xObsCuaternoCancelado", 5)
		        THISFORMSET.xObsCuaternoCancelado = .T.
		    ENDIF
		
		    IF PEMSTATUS(THISFORMSET, "xObsCuaternoValor", 5)
		        THISFORMSET.xObsCuaternoValor = ""
		    ENDIF
		
		    *-----------------------------------------------------
		    * Abrir edición de observación del artículo actual
		    * desde cur_alerts
		    *-----------------------------------------------------
		    IF PEMSTATUS(THISFORMSET, "EditarObservacionArticulo", 5)
		        THISFORMSET.EditarObservacionArticulo(.F., "cur_alerts")
		    ELSE
		        MESSAGEBOX("No existe el método EditarObservacionArticulo en el FormSet.", 16, "Error")
		    ENDIF
		
		CASE pnCtxSel = lnBarPosMin
		    CLEAR TYPEAHEAD
		
		    IF PEMSTATUS(THISFORMSET, "EditarPosMin", 5)
		        THISFORMSET.EditarPosMin(lnArtCodi, lnPosMin)
		    ENDIF
		
		CASE pnCtxSel = lnBarPctAlerta
		    CLEAR TYPEAHEAD
		
		    IF PEMSTATUS(THISFORMSET, "EditarPctAlerta", 5)
		        THISFORMSET.EditarPctAlerta(lnArtCodi, lnPctAlerta)
		    ENDIF
		
		CASE pnCtxSel = lnBarEstado
		    CLEAR TYPEAHEAD
		
		    IF PEMSTATUS(THISFORMSET, "EditarEstado", 5)
		        THISFORMSET.EditarEstado(lnArtCodi, lnEstado)
		    ENDIF
		
		ENDCASE
		
		CLEAR TYPEAHEAD
		
		RETURN .T.
	ENDPROC


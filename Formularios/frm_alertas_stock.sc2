		* principal.grd_venta_compra.DblClick
		*=========================================================
		IF PEMSTATUS(THISFORMSET, "AbrirRemitoDesdeTerVentas", 5)
			pasrem = 1
		    THISFORMSET.AbrirRemitoDesdeTerVentas()
		ENDIF
		*!*	NODEFAULT
		RETURN
	ENDPROC

	PROCEDURE terciario.Init
		*=========================================================
		* terciario.Init
		*=========================================================
		THIS.Caption     = "Movimientos del artículo por período"
		THIS.AutoCenter  = .T.
		THIS.BorderStyle = 0
		THIS.Movable     = .T.
		THIS.Themes      = .F.
		THIS.MaxButton   = .F.
		THIS.MinButton   = .F.
		THIS.Visible     = .F.
		
		*---------------------------------------------------------
		* Orden de compra asociada: oculta por defecto
		*---------------------------------------------------------
		IF PEMSTATUS(THIS, "label7", 5)
		    THIS.label7.Visible = .F.
		ENDIF
		
		IF PEMSTATUS(THIS, "text1", 5)
		    THIS.text1.Value    = ""
		    THIS.text1.Visible  = .F.
		    THIS.text1.Enabled  = .F.
		    THIS.text1.ReadOnly = .T.
		ENDIF
		
		
		IF USED("cur_ter_compras")
		    IF TYPE("cur_ter_compras.prov_codi") = "U" OR ;
		       TYPE("cur_ter_compras.cond_codi") = "U" OR ;
		       TYPE("cur_ter_compras.recep_codi") = "U" OR ;
		       TYPE("cur_ter_compras.orden_codi") = "U"
		        USE IN cur_ter_compras
		    ENDIF
		ENDIF
		
		IF !USED("cur_ter_compras")
		    CREATE CURSOR cur_ter_compras ( ;
		        nro_item    I, ;
		        fecha       D, ;
		        comprobante C(30), ;
		        cantidad    N(15,3), ;
		        prov_nomb   C(50), ;
		        prov_codi   I, ;
		        cond_codi   I, ;
		        recep_codi  I, ;
		        orden_codi  I )
		ENDIF
		
		IF USED("cur_ter_ventas")
		    IF TYPE("cur_ter_ventas.rem_pto") = "U" OR ;
		       TYPE("cur_ter_ventas.rem_nro") = "U" OR ;
		       TYPE("cur_ter_ventas.rem_codi") = "U" OR ;
		       TYPE("cur_ter_ventas.cond_codi") = "U"
		        USE IN cur_ter_ventas
		    ENDIF
		ENDIF
		
		IF !USED("cur_ter_ventas")
		    CREATE CURSOR cur_ter_ventas ( ;
		        nro_item    I, ;
		        fecha       D, ;
		        comprobante C(30), ;
		        cantidad    N(15,3), ;
		        cli_nomb    C(50), ;
		        rem_pto     I, ;
		        rem_nro     I, ;
		        rem_codi    I, ;
		        cond_codi   I )
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ConfigurarGridTerCompras", 5)
		    THISFORMSET.ConfigurarGridTerCompras()
		ENDIF
		
		IF PEMSTATUS(THISFORMSET, "ConfigurarGridTerVentas", 5)
		    THISFORMSET.ConfigurarGridTerVentas()
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE terciario.QueryUnload
		*=========================================================
		* terciario.QueryUnload
		*=========================================================
		LPARAMETERS nUnloadMode
		RETURN .T.
	ENDPROC

ENDDEFINE

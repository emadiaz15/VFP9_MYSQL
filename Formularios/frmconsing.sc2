	PROCEDURE Init
		LPARAMETERS xcodalta
		
		frmcons =conectar_db(_screen.cn)
			SQLEXEC(frmcons,"call usp_consfab(1,?xcodalta);","cur_ingreso")
		desconectar_db(frmcons)
		
		IF RECCOUNT("cur_ingreso")>0
			thisform.txt_numpro.Value = cur_ingreso.prov_codi
			thisform.txt_prov.Value   = cur_ingreso.prov_nomb
			thisform.txt_loca.Value   = cur_ingreso.loca_nomb
			thisform.txt_provi.Value  = cur_ingreso.provi_nomb
			thisform.txt_tel.Value    = "0"+ALLTRIM(cur_ingreso.prov_cartel)+"-"+ALLTRIM(cur_ingreso.prov_tel1)
			thisform.txt_fecfab.Value = cur_ingreso.fab_fech
			thisform.txt_pto.Value    = cur_ingreso.rem_pto
			thisform.txt_nrem.Value   = cur_ingreso.rem_nro
			thisform.txt_fecrem.Value = cur_ingreso.rem_fech
			thisform.txt_ncbte.Value  = cur_ingreso.fab_codi
			thisform.edt_obse.Value   = ALLTRIM(cur_ingreso.fab_obse)
		ENDIF
		
		frmcons =conectar_db(_screen.cn)
			SQLEXEC(frmcons,"call usp_consfab(2,?xcodalta);","cur_detalle")
		desconectar_db(frmcons)
		
		IF RECCOUNT("cur_detalle")>0
			LOCATE
			thisform.grd_detalle.RecordSource="cur_detalle"
			thisform.grd_detalle.SetAll("DynamicBackcolor","thisform.obtener_color(RECNO())","Column")
		ENDIF 
		
		thisform.btn_print.Enabled= .T.
		
	ENDPROC

	PROCEDURE obtener_color
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(215,215,215)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE btn_exit.Click
		thisform.Release
		
		
	ENDPROC

	PROCEDURE btn_exit.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .F.
		this.FontSize= 9
		
	ENDPROC

	PROCEDURE btn_exit.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .T.
		this.FontSize= 10
	ENDPROC

	PROCEDURE btn_print.Click
		SELECT cur_detalle
		LOCATE
		
		LOCAL xnrorem,xncbte,xnprov,xloca,xprovi
		xnrorem = REPLICATE("0",4-LEN(ALLTRIM(STR(thisform.txt_pto.value))))+ALLTRIM(STR(thisform.txt_pto.value)+'-'+ ;
				  REPLICATE("0",8-LEN(ALLTRIM(STR(thisform.txt_nrem.value))))+ALLTRIM(STR(thisform.txt_nrem.value)))
		xncbte  = thisform.txt_ncbte.value
		xnprov  = ALLTRIM(thisform.txt_prov.value)
		xloca   = ALLTRIM(thisform.txt_loca.value)
		xprovi  = ALLTRIM(thisform.txt_provi.value)
		xtel    = ALLTRIM(thisform.txt_tel.value)
		xfecrem = thisform.txt_fecrem.Value
		xffec   = thisform.txt_fecfab.Value
		xobse   = ALLTRIM(thisform.edt_obse.Value)
				
		LOCAL xcomp,pagcon
		xcomp = ""
		pagcon = 0
		FOR pagcon = 1 TO 2
			IF pagcon = 1
				xcomp = "ORIGINAL"
			ELSE
				xcomp = "DUPLICADO"
			ENDIF
			REPORT FORM registrofab TO PRINTER PROMPT noconsole
		NEXT pagcon
		
	ENDPROC

	PROCEDURE btn_print.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .F.
		this.FontSize= 9
		
	ENDPROC

	PROCEDURE btn_print.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .T.
		this.FontSize= 10
		
	ENDPROC

	PROCEDURE grd_detalle.Column1.Text1.KeyPress

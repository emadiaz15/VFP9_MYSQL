	ENDPROC

	PROCEDURE grd_detalle.Column2.Text1.LostFocus
		thisform.grd_detalle.column2.text1.Style= 1
		
	ENDPROC

	PROCEDURE grd_detalle.Column4.Text1.Click
		this.SetFocus
		
	ENDPROC


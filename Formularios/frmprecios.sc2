	PROCEDURE Destroy
		clear events
	ENDPROC

	PROCEDURE Init
		public coeficiente,preg,dolar
		create cursor tempcosto1(art_codi N(8),artpro_costo N(10,3),moneda C(1))
		create cursor tempcosto2(art_codi N(8),artpro_costo N(10,3),moneda C(1))
		create cursor temprecio(art_codi N(8),art_desc C(45),anterior N(10,3),actual N(10,3))
		this.text3.value=0
		this.text1.value=0
		coeficiente=0
		preg=6
		dolar=0
	ENDPROC

	PROCEDURE Command3.Click
		coeficiente = thisform.text3.value
		dolar = thisform.text1.value
		SELECT art_codi, IIF(moneda = "D", artpro_costo * dolar, artpro_costo) AS "artpro_costo" FROM articulos_proveedores WHERE art_codi > 4 AND prov_codi <> 46 AND prov_codi > 0 AND artpro_costo > 0 AND  NOT DELETED() INTO CURSOR tempcosto1
		SELECT art_codi, artpro_costo FROM tempcosto1 ORDER BY art_codi, artpro_costo INTO CURSOR tempcosto2
		SET SAFETY OFF
		INDEX ON art_codi TO codigo
		SET SAFETY ON
		SELECT tempcosto2
		SET ORDER TO codigo
		SELECT articulos
		SET ORDER TO art_codi
		SET RELATION TO art_codi INTO tempcosto2
		GOTO TOP
		SCAN
		     IF articulos.art_codi = 4
		          SKIP
		          LOOP
		     ENDIF
		     INSERT INTO temprecio (art_codi, art_desc, anterior, actual) VALUES (articulos.art_codi, articulos.art_desc, articulos.art_precio, tempcosto2.artpro_costo * thisform.text3.value)
		ENDSCAN
		thisform.grid1.recordsource = "select * from temprecio into cursor grid1"
		thisform.command4.enabled = .T.
		thisform.grid1.forecolor = 0
		
	ENDPROC

	PROCEDURE Command4.Click
		pregunta=messagebox("¿Confirma la modificación a efectuar?",4+48+256,"Costos")
		if pregunta=6
			sele articulos
			set order to art_codi
			sele temprecio
			go top
			set safety off
			index on art_codi to articulo
			set safety on
			set rela to art_codi into articulos addi
			scan
				repla articulos.art_precio with actual
			endscan
			=messagebox("Los precios fueron actualizados satisfactoriamente",0+64,"Precios de Venta")
		*	preg=messagebox("¿Desea imprimir listado de Precios?",4+32+256,"Precios de Venta")
		*	if preg=6
		*		do listaprecios
		*	endif
		endif
		thisform.release
	ENDPROC

	PROCEDURE Command5.Click
		thisform.release
	ENDPROC

	PROCEDURE Text3.LostFocus
		if this.value>0
			thisform.command3.enabled=.T.
		endif
	ENDPROC

ENDDEFINE

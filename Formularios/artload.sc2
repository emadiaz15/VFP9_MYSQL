		*< END OBJECT: BaseClass="listbox" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackColor = 167,167,84, ;
		BackStyle = 1, ;
		Height = 270, ;
		Left = 21, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;
		Top = 22, ;
		Width = 479
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'txtartload' AS textbox WITH ;
		BackColor = 220,220,220, ;
		FontBold = .T., ;
		Height = 23, ;
		Left = 47, ;
		Name = "txtartload", ;
		SelectOnEntry = .T., ;
		TabIndex = 1, ;
		Top = 40, ;
		Width = 418
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		public d
		d=1
		if prompt()="Presupuestos de Clientes" or prompt()="Por Presupuesto" or prompt()="Artículos"
			this.command1.visible=.F.
		endif
	ENDPROC

	PROCEDURE Destroy
		if subst(allt(thisform.txtartload.value),1,1)="?"
			SET FILTER TO
		ENDIF
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE GotFocus
		this.lstart.setfocus
		this.txtartload.setfocus
	ENDPROC

	PROCEDURE Init
		parameter codigo,nombre
		public cade
		*!*	thisform.SetAll("Backcolor",RGB(0,0,255),"Textbox")
		*!*	thisform.SetAll("ItemBackcolor",RGB(0,0,255),"Listbox")
		*!*	thisform.SetAll("Forecolor",RGB(0,255,0),"Textbox")
		*!*	thisform.SetAll("ItemForecolor",RGB(0,255,0),"Listbox")
		*!*	thisform.SetAll("Fontbold",.t.,"Textbox")
		*!*	thisform.SetAll("Fontbold",.t.,"Listbox")
		
		cade=""
		frmartlo= conectar_db(_screen.cn)
			SQLEXEC(frmartlo,"select art_codi,art_desc,art_med,art_precio,art_alicuota from articulos order by art_desc;","cur_art")
		desconectar_db(frmartlo)
		
		this.lstart.RowSource="cur_art"
		
	ENDPROC

	PROCEDURE LostFocus
		set skip of bar 4 of Altas .T.
	ENDPROC

	PROCEDURE Unload
		return codigo
		return nombre
	ENDPROC

	PROCEDURE Command1.Click
		do form altasart with codigo,nombre
		
		
	ENDPROC

	PROCEDURE Command1.GotFocus
		if last()=24 or last()=5
			thisform.txtartload.setfocus
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE lstart.Click
		codigo=cur_art.art_codi
		nombre=ALLTRIM(cur_art.art_desc)
		if last()!=24 AND last()!=5
			thisform.release
		ENDIF
	ENDPROC

	PROCEDURE lstart.GotFocus
		if last()=24 or last()=5
			thisform.txtartload.setfocus
		endif
	ENDPROC

	PROCEDURE lstart.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		ENDIF
		IF nkeycode=13
			codigo=cur_art.art_codi
			nombre=ALLTRIM(cur_art.art_desc)
			thisform.release
		ENDIF
	ENDPROC

	PROCEDURE txtartload.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE txtartload.InteractiveChange
		if subst(allt(this.value),1,1)="?"
			SELECT cur_art
			SET FILTER TO
		endif
		if subst(allt(this.value),1,1)!="?"
			local lc
			lc = allt(This.Value)
			if last()<>127 and last()<>7
				do while !eof()
					if lc=subst(ALLTRIM(cur_art.art_desc),1,len(lc))
						exit
					else
						skip
						d=d+1
						if eof()
							go top
							d=1
							exit
						endif
					endif
				enddo
			else
				do while lc=subst(ALLTRIM(cur_art.art_desc),1,len(lc)) and d>1
					if bof()
						exit
					endif
					skip-1
					if d>1
						d=d-1
					endif
					if lc<>subst(ALLTRIM(cur_art.art_desc),1,len(lc))
						skip
						d=d+1
						exit
					endif
				enddo				
			endif
			thisform.lstart.selected(d)=.T.
		endif
		return
		
	ENDPROC

	PROCEDURE txtartload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
				if subst(allt(this.value),1,1)="?"
					cade=ALLTRIM(subst(allt(this.value),2,len(allt(this.value))))
					set filter to atcline(cade,ALLTRIM(cur_art.art_desc))!=0
				else
					codigo=cur_art.art_codi
					nombre=ALLTRIM(cur_art.art_desc)
					thisform.release
				endif
			case last()=5
				if d>1
					d=d-1
				endif
				thisform.lstart.selected(d)=d
				this.value=thisform.lstart.value
			case last()=24
				if d<thisform.lstart.listcount
					d=d+1
				endif
				thisform.lstart.selected(d)=d
				this.value=thisform.lstart.value
			case last()=27
				thisform.release
		endcase
	ENDPROC

	PROCEDURE txtartload.LostFocus
		capslock(.F.)
	ENDPROC

ENDDEFINE


DEFINE CLASS artload AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblartload" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtartload" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblartload1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblartload2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lstart" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 167,167,84
		BorderStyle = 0
		Caption = "Localización de Artículos"
		DoCreate = .T.
		Height = 347
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "ARTLOAD"

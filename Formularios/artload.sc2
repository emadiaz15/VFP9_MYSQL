		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lstart' AS listbox WITH ;
		BoundColumn = 2, ;
		ColorScheme = 1, ;
		ColumnCount = 2, ;
		ColumnWidths = "102,300", ;
		FontBold = .T., ;
		Height = 183, ;

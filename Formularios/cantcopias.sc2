DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Spinner1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BorderStyle = 0
		Caption = "Orden de Pago"
		DoCreate = .T.
		Height = 105
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "Form1"
		Width = 283
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Aceptar", ;
		DisabledBackColor = 33,146,214, ;
		ForeColor = 255,255,255, ;
		Height = 25, ;
		Left = 95, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 69, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		Caption = "Cantidad de Copias: ", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 44, ;
		Name = "Label1", ;
		TabIndex = 2, ;
		Top = 34, ;
		Width = 117
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Spinner1' AS spinner WITH ;
		Format = "K", ;
		Height = 22, ;
		Left = 164, ;
		Name = "Spinner1", ;
		TabIndex = 1, ;
		Top = 31, ;
		Value = 1, ;
		Width = 47
		*< END OBJECT: BaseClass="spinner" />
	
	PROCEDURE Init
		parameter can
	ENDPROC

	PROCEDURE Unload
		return can
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			if .spinner1.value=0
				=messagebox("Ud. ha indicado 0 copias",0+48,"Advertencia")
				.spinner1.setfocus
			else
				can=.spinner1.value
				.release
			endif
		endwith
	ENDPROC

	PROCEDURE Spinner1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			thisform.command1.click()
		endif
	ENDPROC

ENDDEFINE

	PROCEDURE estado_mayu
		LPARAMETERS lesta
		
		IF lesta = .T.
			CAPSLOCK(.T.)
		ELSE
			CAPSLOCK(.F.)
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE Edit1.GotFocus
		thisform.estado_mayu(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		thisform.estado_mayu(.F.)
	ENDPROC


	PROCEDURE Activate
		i=1
		item=1
		
		SELECT cur_itemsped
		LOCATE
		
		thisform.grd_itpres.RecordSource=''
		thisform.grd_itpres.Refresh
		thisform.grd_itpres.RecordSource="cur_itemsped"
		thisform.grd_itpres.coluMN5.ControlSource="(art_desc)"
		thisform.grd_itpres.SetAll("DynamicBackColor","Thisform.Colorfila(cur_itemsped.selpres)","Column")
		thisform.grd_itpres.SetAll("DynamicForeColor","Thisform.Colorletra(cur_itemsped.selpres,cur_itemsped.art_med)","Column")
		thisform.grd_itpres.COLUMN7.DynamicBackColor='RGB(144,238,144)'
		
		
		*!*	scan
		*!*		do case
		*!*			case cur_carpres.artpres_precio=0
		*!*				if cur_carpres.alternativa="s"
		*!*					this.lstpresup.addlistitem("ALT", i,3)
		*!*				else
		*!*					this.lstpresup.addlistitem(str(item,5), i,1)
		*!*					this.lstpresup.addlistitem(str(cur_carpres.artpres_cant,10,2), i,2)
		*!*					this.lstpresup.addlistitem("  "+cur_carpres.art_med, i,3)
		*!*					item=item+1
		*!*				endif
		*!*				cadena="   "+repl("0",8-len(allt(str(cur_carpres.art_codi))))+allt(str(cur_carpres.art_codi))
		*!*				this.lstpresup.addlistitem(cadena, i,4)
		*!*				this.lstpresup.addlistitem("NO COTIZADO", i,5)
		*!*				this.lstpresup.addlistitem(rtrim(str(cur_carpres.artpres_precio,10,3)), i,6)
		*!*			case cur_carpres.alternativa="S"
		*!*				this.lstpresup.addlistitem("ALT", i,3)
		*!*				cadena="   "+repl("0",8-len(allt(str(cur_carpres.art_codi))))+allt(str(cur_carpres.art_codi))
		*!*				this.lstpresup.addlistitem(cadena, i,4)
		*!*				if cur_carpres.art_codi=4 OR cur_carpres.art_codi=5
		*!*					this.lstpresup.addlistitem(cur_carpres.artpres_dasc, i,5)
		*!*				else
		*!*					this.lstpresup.addlistitem(cur_carpres.art_desc, i,5)
		*!*				endif
		*!*				this.lstpresup.addlistitem(rtrim(str(cur_carpres.artpres_precio,10,3)), i,6)
		*!*			other case
		*!*				if alternativa="S"
		*!*					this.lstpresup.addlistitem("ALT", i,3)
		*!*				else
		*!*					this.lstpresup.addlistitem(str(item,5), i,1)
		*!*					this.lstpresup.addlistitem(str(cur_carpres.artpres_cant,10,2), i,2)
		*!*					this.lstpresup.addlistitem(cur_carpres.art_med, i,3)
		*!*					item=item+1
		*!*				endif
		*!*				cadena="   "+repl("0",8-len(allt(str(cur_carpres.art_codi))))+allt(str(cur_carpres.art_codi))
		*!*				this.lstpresup.addlistitem(cadena, i,4)
		*!*				if cur_carpres.art_codi=4 OR cur_carpres.art_codi=5
		*!*					this.lstpresup.addlistitem(cur_carpres.artpres_dasc, i,5)
		*!*				else
		*!*					do case
		*!*						case cur_carpres.dac_codi>0
		*!*							this.lstpresup.addlistitem(cur_carpres.dac_desc, i,5)
		*!*					other case
		*!*							this.lstpresup.addlistitem(cur_carpres.art_desc, i,5)
		*!*					endcase
		*!*				endif
		*!*				this.lstpresup.addlistitem(rtrim(str(cur_carpres.artpres_precio,10,3)), i,6)
		*!*		endcase
		*!*		i=i+1
		*!*	ENDSCAN
	ENDPROC

	PROCEDURE colorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = .T.
					lnColor = RGB(0,120,215)
				CASE tnsel = .F.
					lnColor = RGB(255,255,255)
			ENDCASE
		Return(lnColor)
		
		
	ENDPROC

	PROCEDURE colorletra
		LParameters tnsel,tnalt
		
		Local ltColor
		
			DO case
				CASE tnsel = .T. AND tnalt <> 'ALT'
					ltColor = RGB(255,255,255)
				CASE tnsel = .T. AND tnalt = 'ALT'
					ltColor = RGB(0,255,0)
				CASE tnsel = .F. AND tnalt <> 'ALT'
					ltColor = RGB(0,0,0)
				CASE tnsel = .F. AND tnalt = 'ALT'
					ltColor = RGB(255,0,0)
			ENDCASE
		Return(ltColor)
	ENDPROC

	PROCEDURE Init
		parameter ncodp,cond,codicli
		CREATE CURSOR cur_itemsped(selpres L,nro_it N(5),artpres_cant N(10,3),art_med C(3),art_codi N(8),art_desc M,artpres_precio N(15,3),dac_codi N(8),art_alicuota N(1),presup_codi N(8),nro_regis N(5))
		i=0
		y=0
		SET DECIMALS TO 3
		frmselit= conectar_db(_screen.cn)
			SQLEXEC(frmselit,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dac_desc from presupuestos_articulos a INNER JOIN articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.presup_codi=?ncodp ORDER BY a.nro_regis;","cur_carpres")
		desconectar_db(frmselit)
		SET DECIMALS TO
		
		SELECT .F. as selpres,nro_it,artpres_cant,padr(left(IIF(alternativa='S','ALT',art_med),len(IIF(alternativa='S','ALT',art_med))),3," ") as art_med, ;
			   art_codi,ALLTRIM(PADR(IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artpres_dasc),254," ")) as art_desc, ;
			   artpres_precio,dac_codi,art_alicuota,presup_codi,nro_regis FROM cur_carpres INTO CURSOR cur_itemsped readwrite
		
		** IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artpres_dasc)
		** padr(left(IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artpres_dasc),len(IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artpres_dasc))),254," ")
		cerrar_cursor("cur_carpres")
		
		thisform.npres=ncodp
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL xcodp
		xcodp = thisform.npres
		do form pediclixpresup with xcodp,cond,codicli
		thisform.hide
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		DO case
			CASE thisform.estadosel=0
				UPDATE cur_itemsped SET selpres=.T.
				this.Caption="\<Deseleccionar Todos"
				thisform.command1.enabled=.T.
				thisform.estadosel=1
			CASE thisform.estadosel=1
				UPDATE cur_itemsped SET selpres=.F.
				this.Caption="\<Seleccionar Todos"
				thisform.command1.enabled=.F.
				thisform.estadosel=0
		ENDCASE
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE grd_itpres.AfterRowColChange
		LPARAMETERS nColIndex
		
	ENDPROC

	PROCEDURE grd_itpres.Column5.Text1.Click
		IF cur_itemsped.art_codi<=5 OR cur_itemsped.dac_codi>0
			MESSAGEBOX(ALLTRIM(cur_itemsped.art_desc),64,"Descripciones adicionales")
		ENDIF
	ENDPROC

	PROCEDURE grd_itpres.Column7.Check1.Click
		LOCAL cantsel,ubireg
		cantsel=0
		ubireg=0
		
		SELECT cur_itemsped
		ubireg=RECNO()
		LOCATE
		COUNT ALL FOR selpres=.T. TO cantsel
		GO ubireg
		
		IF cantsel>0
			thisform.command2.Caption="\<Deseleccionar Todos"
			thisform.command1.enabled=.T.
			thisform.estadosel=1
		ELSE
			thisform.command2.Caption="\<Seleccionar Todos"
			thisform.command1.enabled=.F.
			thisform.estadosel=0
		ENDIF
	ENDPROC

	PROCEDURE grd_itpres.Column7.Check1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		
	ENDPROC

	PROCEDURE grd_itpres.Column7.Check1.MouseUp
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
	ENDPROC


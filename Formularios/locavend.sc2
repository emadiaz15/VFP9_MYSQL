DEFINE CLASS locavend AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="List1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 200,211,192
		BorderStyle = 0
		Caption = "Localización de Vendedores"
		DoCreate = .T.
		Height = 228
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "LOCAVEND"
		Width = 252
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Nuevo Vendedor", ;
		DisabledBackColor = 33,146,214, ;
		ForeColor = 255,255,255, ;
		Height = 25, ;
		Left = 70, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 193, ;
		Width = 111
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'List1' AS listbox WITH ;
		BoundColumn = 2, ;
		ColumnCount = 2, ;
		ColumnWidths = "45,173", ;
		FontBold = .T., ;
		Height = 159, ;
		Left = 14, ;
		Name = "List1", ;
		RowSource = "''", ;
		RowSourceType = 2, ;
		Top = 25, ;
		Width = 224
		*< END OBJECT: BaseClass="listbox" />
	
	PROCEDURE Init
		parameter vcodi
		
		frmlocaven= conectar_db(_screen.cn)
			SQLEXEC(frmlocaven,"select ven_codi,ven_nomb from vendedores;","cur_vendedor")
		desconectar_db(frmlocaven)
		
		thisform.list1.RowSource="cur_vendedor"
	ENDPROC

	PROCEDURE Unload
		return vcodi
	ENDPROC

	PROCEDURE Command1.Click
		do form altavend with vcodi
		if vcodi>0
			frmlocaven= conectar_db(_screen.cn)
				SQLEXEC(frmlocaven,"select ven_codi,ven_nomb from vendedores;","cur_vendedor")
			desconectar_db(frmlocaven)
			thisform.list1.requery
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE List1.Click
		vcodi=cur_vendedor.ven_codi
		thisform.release
		
	ENDPROC

	PROCEDURE List1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			vcodi=cur_vendedor.ven_codi
			thisform.release
		endif
	ENDPROC

ENDDEFINE

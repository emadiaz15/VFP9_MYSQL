		Width = 120
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmd_salir' AS commandbutton WITH ;
		BackColor = 227,68,34, ;
		Caption = "\<Salir", ;
		DisabledBackColor = 227,68,34, ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 263, ;
		Name = "cmd_salir", ;
		TabIndex = 3, ;
		Themes = .F., ;
		Top = 294, ;
		Width = 120
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackStyle = 0, ;
		Caption = "FECHA ACUTAL:", ;
		FontBold = .T., ;
		ForeColor = 255,255,255, ;

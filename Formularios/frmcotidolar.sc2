		SpecialEffect = 0, ;
		Top = 61, ;
		Width = 489
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Text1' AS textbox WITH ;
		Alignment = 2, ;
		DateFormat = 3, ;
		FontBold = .T., ;
		Height = 23, ;
		Left = 388, ;
		Name = "Text1", ;
		Style = 1, ;
		TabIndex = 6, ;
		Top = 20, ;
		Width = 94
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txt_coti' AS textbox WITH ;
		FontSize = 12, ;
		Format = "K", ;
		Height = 27, ;
		InputMask = "$ 9,999.999", ;
		Left = 321, ;
		Name = "txt_coti", ;
		TabIndex = 1, ;
		Top = 173, ;
		Width = 104
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		thisform.text1.Value=DATE()
		frmcoti= conectar_db(_screen.cn)
			SQLEXEC(frmcoti,"select * from parametros where param_codi=14;","cur_coti")
		desconectar_db(frmcoti)
		
		IF RECCOUNT("cur_coti")>0
			thisform.lbl_coti.Caption=thisform.lbl_coti.caption+" "+ALLTRIM(TTOC(cur_coti.param_fechora))+" - (1 U$S = $ "+ALLTRIM(STR(param_impo,14,2))+")"
			thisform.txt_coti.Value=cur_coti.param_impo
			thisform.txt_coti.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_guardar.Click
		precot=MESSAGEBOX("¿Confirma la nueva cotización de Moneda Dolar ingresada?",4+32+256,"Aviso del Sistema")
		
		IF precot=6
			LOCAL xfechor,xcodhis
			xcodhis=0
			xfechor=DATETIME()
			frmcoti= conectar_db(_screen.cn)
				SQLEXEC(frmcoti,"select param_impo from parametros where param_codi = 15;","cur_aju")
				xaju = ROUND((100 - cur_aju.param_impo)/100,3)
				SQLEXEC(frmcoti,"update parametros set param_impo=?thisform.txt_coti.value,param_fechora=?xfechor where param_codi=14;")
				SQLEXEC(frmcoti,"update parametros set param_impo=?thisform.txt_coti.value * ?xaju ,param_fechora=?xfechor where param_codi=9;")
		*!*			SQLEXEC(frmcoti,"select * from histocoti order by hiscot_codi desc limit 1;","cur_nvohis")
		*!*			IF RECCOUNT("cur_nvohis")>0
		*!*				xcodhis=cur_nvohis.hiscot_codi+1
		*!*				SQLEXEC(frmcoti,"insert into histocoti values(?xcodhis,?xfechor,?thisform.txt_coti.value);")
		*!*			ELSE
		*!*				SQLEXEC(frmcoti,"insert into histocoti values(null,?xfechor,?thisform.txt_coti.value);")
		*!*			ENDIF
			desconectar_db(frmcoti)
			thisform.Release
		ELSE
			thisform.txt_coti.SetFocus
			this.Enabled= .F.
		ENDIF
	ENDPROC

	PROCEDURE cmd_guardar.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_guardar.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_salir.Click
		thisform.Release
		
	ENDPROC

	PROCEDURE cmd_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE txt_coti.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE txt_coti.GotFocus
		SET POINT TO "."
		SET SEPARATOR TO ","
		
	ENDPROC

	PROCEDURE txt_coti.LostFocus
		SET POINT TO ","
		SET SEPARATOR TO "."
		
		IF this.Value<>cur_coti.param_impo
			thisform.cmd_guardar.Enabled= .T.
		ELSE
			thisform.cmd_salir.SetFocus
		endif
	ENDPROC

ENDDEFINE

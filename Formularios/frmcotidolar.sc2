		Height = 348
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "FRMCOTIDOLAR"
		Width = 500
	*</PropValue>

	ADD OBJECT 'cmd_guardar' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Guardar", ;
		DisabledBackColor = 33,146,214, ;
		Enabled = .F., ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 116, ;
		Name = "cmd_guardar", ;

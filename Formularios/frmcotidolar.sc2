	*< OBJECTDATA: ObjPath="cmd_guardar" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmd_salir" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.

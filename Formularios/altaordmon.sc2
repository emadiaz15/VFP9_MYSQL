	PROCEDURE Init
		PARAMETERS xmoneda
		
		THISFORM.AddProperty("oRet")
		THISFORM.oRet = CREATEOBJECT("Empty")
		
		thisform.txt_fecha.Value=DATE()
		
		thisform.cmb_moneda.additem("DÓLARES",1)
		thisform.cmb_moneda.additem("PESOS",2)
		thisform.cmb_moneda.value="DÓLARES"
	ENDPROC

	PROCEDURE Unload
		RETURN thisform.oRet
	ENDPROC

	PROCEDURE btn_cancel.Click
		ADDPROPERTY(THISFORM.oRet, "xmoneda", "")
		thisform.Release
		
	ENDPROC

	PROCEDURE btn_cancel.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.

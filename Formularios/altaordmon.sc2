		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE btn_cont.Click
		
		ADDPROPERTY(THISFORM.oRet, "xmoneda", ALLTRIM(SUBSTR(thisform.cmb_moneda.Value,1,1)))
		
		thisform.Release
		
	ENDPROC

	PROCEDURE btn_cont.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord

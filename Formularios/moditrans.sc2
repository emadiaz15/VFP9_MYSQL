	PROCEDURE Destroy
		set skip of bar 3 of Modificaci .F.
	ENDPROC

	PROCEDURE Init
		public localiz,postal,locali,provi,op,codloca,cp,coditran,transporte
		localiz=0
		postal=0
		locali=""
		provi=""
		codloca=0
		op=0
		coditran=0
		
		frmmodit= conectar_db(_screen.cn)
			SQLEXEC(frmmodit,"select provi_nomb,provi_codi from provincias order by provi_nomb;","curprovi")
		desconectar_db(frmmodit)
		this.combo1.RowSourcetype= 2
		this.combo1.RowSource="curprovi"
	ENDPROC

	PROCEDURE Load
		set skip of bar 3 of Modificaci .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if prompt()<>"Datos de Transportes"
		*!*		set skip of bar 3 of Modificaci .F.
		*!*		thisform.hide
		*!*	endif
	ENDPROC

	PROCEDURE Btn_detalle1.img_deta.Click
		IF thisform.Height= 584
			thisform.height= 456
			thisform.label13.Visible= .F.
			thisform.edit1.Visible= .F.
			thisform.shape2.Visible= .F.
			thisform.command1.Top=413
			thisform.command2.Top=413
			thisform.command3.Top=413
		ELSE
			thisform.height= 584
			thisform.label13.Visible= .T.
			thisform.edit1.Visible= .T.
			thisform.shape2.Visible= .T.
			thisform.command1.Top=541
			thisform.command2.Top=541
			thisform.command3.Top=541
			thisform.edit1.SetFocus
		ENDIF
		thisform.AutoCenter= .T.
		
	ENDPROC

	PROCEDURE Combo1.Click
		IF LEN(ALLTRIM(this.Value))>0
			KEYBOARD '{TAB}'
		ENDIF
		
	ENDPROC

	PROCEDURE Combo1.GotFocus
		keyboard "{F4}"
	ENDPROC

	PROCEDURE Combo1.LostFocus
		if LEN(ALLTRIM(this.text))>0
			xnompro=ALLTRIM(this.text)
			frmmodit= conectar_db(_screen.cn)
				SQLEXEC(frmmodit,"select * from provincias where TRIM(provi_nomb)=?xnompro;","cur_nuepro")
			desconectar_db(frmmodit)
			if RECCOUNT("cur_nuepro")=0
				frmmodit= conectar_db(_screen.cn)
					SQLEXEC(frmmodit,"select MAX(provi_codi) as provi_codi from provincias order by provi_codi;","cur_codp")
					pro=cur_codp.provi_codi+1
					nomnue=ALLTRIM(this.text)
					SQLEXEC(frmmodit,"insert into provincias values(?pro,?nomnue);")
					SQLEXEC(frmmodit,"select provi_nomb,provi_codi from provincias order by provi_nomb;","curprovi")
				desconectar_db(frmmodit)
				this.RowSource = "curprovi"
				this.requery
				this.value=allt(this.text)
				frmmodit= conectar_db(_screen.cn)
					SQLEXEC(frmmodit,"update localidades set provi_codi=?pro where loca_codi=?codloca;")
				desconectar_db(frmmodit)
			else
				pro=cur_nuepro.provi_codi
				frmmodit= conectar_db(_screen.cn)
					SQLEXEC(frmmodit,"update localidades set provi_codi=?pro where loca_codi=?codloca;")
				desconectar_db(frmmodit)		
			endif
		endif
		thisform.command2.enabled=.T.
	ENDPROC

	PROCEDURE Combo1.Valid
		*!*	if type("this.text")="C"
		*!*		if this.text=" "
		*!*			messagebox("Recuerde que debe ingresar una Provincia",0+48,"Advertencia!!!")
		*!*		endif
		*!*	endif
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		con=messagebox("¿Confirma los datos ingresados?",4+32+256,"Modificación de Transportes")
		if con=6
			with thisform
				do case
					CASE TYPE("codloca") # "N" OR codloca <= 0
					    =MESSAGEBOX("La localidad no quedó correctamente asociada. Verifique Código Postal, Localidad y Provincia.",0+48,"Advertencia")
					    .text6.SetFocus			
					case len(allt(.text1.value))=0
						=messagebox("No ha ingresado el nombre o denominación del Transporte,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.text1.setfocus
					case len(allt(.text6.value))=0
						=messagebox("No ha ingresado el Código Postal,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.text6.setfocus
					case len(allt(.text3.value))=0
						=messagebox("No ha ingresado la Localidad,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.text3.setfocus
					case len(allt(.combo1.text))=0
						=messagebox("No ha ingresado la Provincia,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.combo1.setfocus
					other case
						LOCAL xopcion, ;
							  xcodigo, ;
		                      xnombre, ;
		                      xdomi, ;
							  xcartel, ;
		                      xtel1, ;
		                      xtel2, ;
		                      xcel, ;
		                      xcuit, ;
		                      xemail, ;
		                      xcond, ;
		                      xdeta
		    			xopcion = 2
						xcodigo = thisform.text13.Value
						xnombre = ALLTRIM(.text1.value)
						xdomi   = ALLTRIM(.text2.value)
						xcartel = VAL(.text11.value)
						xtel1   = VAL(.text7.value)
						xtel2   = VAL(.text10.value)
						xcel    = ALLTRIM(.text8.value)
						xcuit   = .text5.value
						xemail  = ALLTRIM(.text9.value)
						xcond   = .optiongroup1.value
						xdeta   = ALLTRIM(.edit1.value)
						frmaltat= conectar_db(_screen.cn)
							SQLEXEC(frmaltat,"call usp_guardar_tpte(?xopcion,?xcodigo,?xnombre,?xdomi,?codloca,?xcartel,?xtel1,?xtel2,?xcel,?xcuit,?xemail,?xcond,?xdeta);")
						desconectar_db(frmaltat)
						.SetAll("value", "", "Textbox")
						.combo1.value=""
						thisform.height= 456
						thisform.label13.Visible= .F.
						thisform.edit1.Value=''
						thisform.edit1.Visible= .F.
						thisform.shape2.Visible= .F.
						thisform.command1.Top=413
						thisform.command2.Top=413
						thisform.command3.Top=413
						thisform.AutoCenter= .T.
						this.enabled=.F.
						.text1.setfocus
						.text5.value=""
				endcase
			endwith
		endif
			
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		if thisform.label9.visible=.T. and thisform.text5.visible=.T.
			thisform.label9.visible=.F.
			thisform.text5.visible=.F.
		endif
		do form tranload with coditran
		if coditran>0
			with thisform
				.text13.value=coditran
				.text1.value=cur_tran.tran_nomb
				.text2.value=cur_tran.tran_domi
				.text6.value=allt(str(cur_tran.cp_nro))
				codp=cur_tran.cp_codi
				codloca=cur_tran.loca_codi
				.text3.value=cur_tran.loca_nomb
				.combo1.value=cur_tran.provi_nomb
				.text11.value="0"+allt(cur_tran.tran_cartel)
				.text7.value=allt(cur_tran.tran_tel1)
				.text10.value=allt(cur_tran.tran_tel2)
				.text8.value=cur_tran.tran_cel
				.text9.value=cur_tran.tran_email
				do case
					case cond_codi=1
						.optiongroup1.value=1
					case cond_codi=2
						.optiongroup1.value=2
					case cond_codi=3
						.optiongroup1.value=3
					case cond_codi=4
						.optiongroup1.value=4
				endcase
				.label9.visible=.T.
				.text5.visible=.T.
				.text5.value=VAL(cur_tran.tran_cuit)
				IF LEN(ALLTRIM(cur_tran.tran_deta))>0
					.edit1.value=cur_tran.tran_deta
					thisform.height= 584
					thisform.label13.Visible= .T.
					thisform.edit1.Visible= .T.
					thisform.shape2.Visible= .T.
					thisform.command1.Top=541
					thisform.command2.Top=541
					thisform.command3.Top=541
					thisform.AutoCenter= .T.
				ENDIF
				.text1.setfocus
				.command2.enabled=.T.
			endwith
		endif
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Optiongroup1.Click
		if this.value<>1
			thisform.label9.visible=.T.
			thisform.text5.visible=.T.
			thisform.text5.setfocus
		else
			thisform.label9.visible=.F.
			thisform.text5.visible=.F.
		endif
	ENDPROC

	PROCEDURE Text3.GotFocus
		if op=7
			thisform.text6.value=""
			thisform.text6.setfocus
		endif
	ENDPROC

	PROCEDURE Text3.LostFocus
		if LEN(ALLTRIM(this.value))>0
			xnomloc=ALLTRIM(this.Value)
			frmmodit= conectar_db(_screen.cn)
				SQLEXEC(frmmodit,"select * from localidades where TRIM(loca_nomb)=?xnomloc;","cur_nueloc")
			desconectar_db(frmmodit)
			if RECCOUNT("cur_nueloc")=0
				frmmodit= conectar_db(_screen.cn)
					SQLEXEC(frmmodit,"select MAX(loca_codi) as loca_codi from localidades order by loca_codi;","cur_codl")
					loc=cur_codl.loca_codi+1
					nomnue=ALLTRIM(this.Value)
					SQLEXEC(frmmodit,"insert into localidades values(?loc,?nomnue,0,?cp,0);")
				desconectar_db(frmmodit)
				codloca=loc
			else
				if cur_nueloc.cp_codi<>codp
					frmmodit= conectar_db(_screen.cn)
						SQLEXEC(frmmodit,"select MAX(loca_codi) as loca_codi from localidades order by loca_codi;","cur_codl")
						loc=cur_codl.loca_codi+1
						nomnue=ALLTRIM(this.Value)
						SQLEXEC(frmmodit,"insert into localidades values(?loc,?nomnue,0,?codp,0);")
					desconectar_db(frmmodit)		
					codloca=loc
				ELSE
					codloca = cur_nueloc.loca_codi			
				endif
			endif
		endif
		
	ENDPROC

	PROCEDURE Text3.Valid
		*!*	if this.value=" " and last()<>-4
		*!*		messagebox("Debe ingresar la Localidad",0+48,"Advertencia!!!")
		*!*		return 0
		*!*	endif
	ENDPROC

	PROCEDURE Text5.LostFocus
		thisform.command2.setfocus
	ENDPROC

	PROCEDURE Text6.GotFocus
		thisform.lbl_aviso.Visible=.T.
	ENDPROC

	PROCEDURE Text6.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = -4
			do form locaload with postal,locali,provi,codloca
			if postal>0
				with thisform
					this.value=postal
					.text3.value=locali
					.combo1.value=provi
					thisform.command2.enabled=.T.
					thisform.lbl_aviso.Visible=.F.
					.text11.setfocus
				ENDWITH
			ELSE
				this.setfocus
			ENDIF
		endif
	ENDPROC

	PROCEDURE Text6.LostFocus
		if type("this.value")="C"
		if LEN(ALLTRIM(this.value))>0
			frmmodit= conectar_db(_screen.cn)
				SQLEXEC(frmmodit,"select * from codipostales where cp_nro=?VAL(this.value);","cur_cpn")
			desconectar_db(frmmodit)
			if RECCOUNT()>0
				codp=cur_cpn.cp_codi
				cp=codp
				frmmodit= conectar_db(_screen.cn)
					SQLEXEC(frmmodit,"select a.*,b.provi_nomb from localidades a inner join provincias b on a.provi_codi=b.provi_codi where a.cp_codi=?codp;","cur_lcp")
				desconectar_db(frmmodit)
				IF RECCOUNT()>0
					if RECCOUNT()>1
						do form locamismocp with codp,codloca,locali,provi
						if codloca>0
							thisform.text3.value=locali
							thisform.combo1.value=provi
							thisform.text11.setfocus
							thisform.command2.enabled=.T.
						ELSE
							thisform.combo1.value=provi
							thisform.command2.enabled=.T.
						endif
					else
						con=messagebox("Solo existe en archivo la Localidad "+allt(cur_lcp.loca_nomb)+chr(13)+ ;
									   "de la Provincia de "+allt(cur_lcp.provi_nomb)+" con éste Código Postal "+chr(13)+;
									   "¿Ingresa otra Localidad con el mismo Código? ",4+32+256,"Localidades")
						do case
							case con=6
								thisform.combo1.value=cur_lcp.provi_nomb
								this.value=ALLT(str(cur_cpn.cp_nro))
								thisform.text3.setfocus
							case con=7
								thisform.text3.value=cur_lcp.loca_nomb
								thisform.combo1.value=cur_lcp.provi_nomb
								codloca=cur_lcp.loca_codi
								thisform.command2.enabled=.T.
								thisform.text11.setfocus
						endcase
					ENDIF
					thisform.lbl_aviso.Visible= .F.
				endif
			else
				op=messagebox("Ud. ha ingresado un nuevo Código Postal"+chr(13)+ ;
							  "¿Confirma el código ingresado?",4+32+256,"Códigos Postales")
				if op=6
					frmaltap= conectar_db(_screen.cn)
						SQLEXEC(frmaltap,"select MAX(cp_codi) as cp_codi from codipostales order by cp_codi;","cur_maxc")
						cp=cur_maxc.cp_codi+1
						codp=cp
						SQLEXEC(frmaltap,"insert into codipostales values(?codp,?val(this.value));")
					desconectar_db(frmaltap)
					thisform.lbl_aviso.Visible= .F.
				endif
			endif
		endif
		endif
		
		
	ENDPROC

ENDDEFINE

	PROCEDURE Init
		public preg
		preg=0
		create cursor temprecio(art_codi N(8),art_desc C(45),art_precio N(10,3),rub_codi N(8))
		this.text1.value=0
		this.text2.value=99999999
		this.text3.value=0
		this.text4.value=99999999
		
	ENDPROC

	PROCEDURE Command1.Click
		local con,rubroc,cadenarub,cadenart,artdes,arthas,rubdes,rubhas
		store 0 to con,rubric,artdes,arthas,rubdes,rubhas
		store "" to cadenarub,cadenart
		with thisform
			.grid1.rows=1
			artdes=thisform.text1.Value
			arthas=thisform.text2.Value
			rubdes=thisform.text3.Value
			rubhas=thisform.text4.Value
			SET DECIMALS TO 3
			frmlstprecios= conectar_db(_screen.cn)
				SQLEXEC(frmlstprecios,"select a.*,b.rub_desc from articulos a inner join rubros b on a.rub_codi=b.rub_codi where a.art_codi between ?artdes and ?arthas and a.rub_codi between ?rubdes and ?rubhas and a.art_codi>5 order by a.art_codi,a.rub_codi;","temprecio")
			desconectar_db(frmlstprecios)
			SET DECIMALS TO
			sele temprecio
			go top
			BROWSE
		*!*		scan
		*!*			wait "PROCESANDO LISTADO AGUARDE POR FAVOR..." wind nowait
		*!*			rubroc=rub_codi
		*!*			cadenarub=repl("0",8-len(allt(str(rub_codi))))+allt(str(rub_codi))
		*!*			.grid1.additem(cadenarub+chr(9)+allt(rub_desc))
		*!*			con=con+1
		*!*			if rub_codi=rubroc
		*!*				.grid1.row=con
		*!*				.grid1.col=0
		*!*				.grid1.cellfontbold=.T.
		*!*				.grid1.col=1
		*!*				.grid1.cellfontbold=.T.
		*!*			endif
		*!*			do while rub_codi=rubroc
		*!*				cadenart=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
		*!*				.grid1.additem(cadenart+chr(9)+allt(art_desc)+chr(9)+str(art_precio,10,3))
		*!*				con=con+1
		*!*				skip
		*!*				if rub_codi<>rubroc and !eof()
		*!*					.grid1.additem(""+chr(9)+""+chr(9)+"")
		*!*					con=con+1
		*!*				endif
		*!*			enddo
		*!*			skip-1
		*!*		endscan
			wait "FIN DEL LISTADO..." wind nowait
		endwith
	ENDPROC


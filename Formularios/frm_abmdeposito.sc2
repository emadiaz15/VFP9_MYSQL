	PROCEDURE crearcursores
		CREATE CURSOR cheq(recpag_codi N(8)) 
		CREATE CURSOR eliminados(recpag_codi N(8)) 
		CREATE CURSOR cur_valores(chequenro C(14),movtippag_fvto D,fechapago D,ban_desc C(45),movtippag_pza C(50),movtippag_imp N(15,2),recpag_codi N(8))
		
		RETURN
		
	ENDPROC

	PROCEDURE Destroy
		SET POINT TO thisform.punto
		SET SEPARATOR TO thisform.separador
	ENDPROC

	PROCEDURE Init
		PARAMETERS xdepo
		
		thisform.xcodidep=xdepo
		
		SET DELETED ON
		
		thisform.punto=SET("POINT")
		thisform.separador=SET("SEPARATOR")
		
		SET POINT TO ","
		SET SEPARATOR TO "."
		
		PUBLIC numero,banco,plaza,fechavto,valor,cuit,valorcheq,rpgcodi,xtipo
		
		thisform.crearcursores()
		
		frmabmdep= conectar_db(_screen.cn)
			SQLEXEC(frmabmdep,"select * from depositos where dep_codi = ?xdepo;","cur_depabm")
		desconectar_db(frmabmdep)
		
		IF RECCOUNT("cur_depabm") > 0
			DO case
				CASE cur_depabm.dep_tipo = 1
					thisform.lbl_tipo.Caption=thisform.lbl_tipo.Caption+" CHEQUES FÍSICOS"
				CASE cur_depabm.dep_tipo = 2
					thisform.lbl_tipo.Caption=thisform.lbl_tipo.Caption+" ECHEQS"
			ENDCASE
			
			frmabmdep= conectar_db(_screen.cn)
				SQLEXEC(frmabmdep,"select banc_desc,banc_codi,banc_ncta from bancos_caja order by banc_desc;","cur_bank")
			desconectar_db(frmabmdep)
		
			IF RECCOUNT("cur_bank")>0
				thisform.cmb_bancabm.rowsource="select banc_desc,banc_codi,banc_ncta from cur_bank INTO CURSOR cmb_bancabm"
				SELECT cmb_bancabm
				LOCATE FOR banc_codi = cur_depabm.banc_codi
				thisform.cmb_bancabm.Value=cmb_bancabm.banc_desc
				thisform.codibank=cmb_bancabm.banc_codi
				thisform.cmb_bancabm.Refresh
				thisform.cmb_bancabm.SetFocus
				cerrar_cursor("cur_bank")
			ENDIF
			thisform.txt_nbol.Value     = cur_depabm.dep_bolnro
			thisform.xnbol              = cur_depabm.dep_bolnro
			thisform.txt_fechadep.Value = cur_depabm.dep_fech
			thisform.xfecdep            = cur_depabm.dep_fech
			
			
			frmabmdep= conectar_db(_screen.cn)
				SQLEXEC(frmabmdep,"select a.chequenro,a.movtippag_fvto,DATE_ADD(a.movtippag_fvto, INTERVAL 30 DAY) fechapago,b.ban_desc,a.movtippag_pza,a.movtippag_imp,a.recpag_codi from recibos_pagos a inner join bancos b on a.ban_codi=b.ban_codi where a.dep_codi=?xdepo;","cur_val")
			desconectar_db(frmabmdep)
			
			IF RECCOUNT("cur_val")>0
				LOCATE
				SELECT * FROM cur_val INTO CURSOR cur_valores readwrite
				GO TOP IN cur_valores
				thisform.grd_cheques.RecordSource="cur_valores"
				thisform.grd_cheques.Refresh
				
				SELECT SUM(movtippag_imp) FROM cur_val INTO ARRAY ar_total
		
				thisform.totaldep=ar_total[1,1]
		
				LOCAL lcletra,xrpg,textipo
				
				SELECT cur_val
				GO top
				SCAN
					xrpg=cur_val.recpag_codi
					INSERT INTO cheq values(xrpg)	
					SELECT cur_val
				ENDSCAN
			
				do monto2letra with thisform.txt_total.value,lcletra in ntoletra
		
				SELECT COUNT(*) cant FROM cur_valores WHERE NOT DELETED() INTO ARRAY ar_cntc
				
				textipo=ICASE(cur_depabm.dep_tipo=1,"' Cheques Físicos '",cur_depabm.dep_tipo=2,"' Echeqs '")
				thisform.lbl_cancheq.Caption=IIF(ar_cntc[1,1]>0,"Cantidad de"+&textipo+"Agregados "+ALLTRIM(STR(ar_cntc[1,1])),"")
				thisform.lbl_totletra.Caption=IIF(thisform.totaldep>0,PROPER(LOWER("SON EN TOTAL: "+ALLTRIM(lcletra))),"")		
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Boten_del1.img_del.Click
		
		IF RECCOUNT("cur_valores")>0
			LOCAL xrpg,xval
			xrpg=cur_valores.recpag_codi
			xval=cur_valores.movtippag_imp
			DELETE FROM cheq WHERE recpag_codi = xrpg
			DELETE FROM cur_valores WHERE recpag_codi = xrpg
			INSERT INTO eliminados values(xrpg)
			thisform.totaldep=thisform.totaldep-xval
		ENDIF
		
		thisform.grd_cheques.RecordSource="cur_valores"
		GO TOP IN cur_valores
		thisform.grd_cheques.Refresh()
		GO BOTTOM IN cur_valores
		thisform.txt_total.Refresh()
		thisform.grd_cheques.SetFocus
		
		LOCAL lcletra,textipo
		do monto2letra with thisform.txt_total.value,lcletra in ntoletra
		SELECT COUNT(*) cant FROM cur_valores WHERE NOT DELETED() INTO ARRAY ar_cntc
		
		textipo=ICASE(cur_depabm.dep_tipo=1,"' Cheques Físicos '",cur_depabm.dep_tipo=2,"' Echeqs '")
		thisform.lbl_cancheq.Caption=IIF(ar_cntc[1,1]>0,"Cantidad de"+&textipo+"Agregados "+ALLTRIM(STR(ar_cntc[1,1])),"")
		thisform.lbl_totletra.Caption=IIF(thisform.totaldep>0,PROPER(LOWER("SON EN TOTAL: "+ALLTRIM(lcletra))),"")
		
		IF ar_cntc[1,1]>0
			thisform.cmd_guardar.Enabled= .T.
		ELSE
			thisform.cmd_guardar.Enabled= .F.
		ENDIF
		
	ENDPROC

	PROCEDURE Boton_add1.img_add.Click
		_screen.deposito=.T.
		numero=""
		banco=""
		plaza=""
		fechavto=ctod("  /  /    ")
		valor=0
		cuit=0
		valorcheq=thisform.totaldep
		rgpcodi=0
		xtipo=cur_depabm.dep_tipo
		
		do form chequesdisp with numero,banco,plaza,fechavto,valor,cuit,valorcheq,rpgcodi,xtipo
		
		IF rpgcodi>0
			insert into cheq(recpag_codi) values(rpgcodi)
			INSERT INTO cur_valores values(numero,fechavto,fechavto+30,banco,plaza,valor,rpgcodi)
			thisform.totaldep=thisform.totaldep+valor
		ENDIF
		
		thisform.grd_cheques.RecordSource="cur_valores"
		GO TOP IN cur_valores
		thisform.grd_cheques.Refresh()
		GO BOTTOM IN cur_valores
		thisform.txt_total.Refresh()
		thisform.grd_cheques.SetFocus
		
		LOCAL lcletra,textipo
		do monto2letra with thisform.txt_total.value,lcletra in ntoletra
		
		SELECT COUNT(*) cant FROM cur_valores WHERE NOT DELETED() INTO ARRAY ar_cntc
		
		textipo=ICASE(cur_depabm.dep_tipo=1,"' Cheques Físicos '",cur_depabm.dep_tipo=2,"' Echeqs '")
		thisform.lbl_cancheq.Caption=IIF(ar_cntc[1,1]>0,"Cantidad de"+&textipo+"Agregados "+ALLTRIM(STR(ar_cntc[1,1])),"")
		thisform.lbl_totletra.Caption=IIF(thisform.totaldep>0,PROPER(LOWER("SON EN TOTAL: "+ALLTRIM(lcletra))),"")
		
		IF ar_cntc[1,1]>0
			thisform.cmd_guardar.Enabled= .T.
		ELSE
			thisform.cmd_guardar.Enabled= .F.
		ENDIF
	ENDPROC

	PROCEDURE cmb_bancabm.Click
		*!*	thisform.etq_seleccion.Visible= .F.
		IF cmb_bancabm.banc_codi <> thisform.codibank
			thisform.cmd_guardar.Enabled= .T.
		ENDIF
		thisform.codibank=cmb_bancabm.banc_codi
		STORE "" TO thisform.etq_cuenta.Caption
		IF LEN(ALLTRIM(cmb_bancabm.banc_ncta))>0
			thisform.etq_cuenta.Caption="Número de Cuenta: "+ALLTRIM(cmb_bancabm.banc_ncta)
		ENDIF
		KEYBOARD '{TAB}'
	ENDPROC

	PROCEDURE cmd_guardar.Click
		LOCAL xboleta,xfechdep,xtotal,xobser,xrpg
		
		*!*	xboleta   = ALLTRIM(thisform.txt_nbol.Value)
		xfechdep  = thisform.txt_fechadep.Value
		xtotal    = thisform.totaldep
		xobser    = ALLTRIM(thisform.edt_obser.Value)
		
		frmabmdep= conectar_db(_screen.cn)
			SQLEXEC(frmabmdep,"update depositos set dep_fech=?xfechdep,dep_importe=?xtotal,banc_codi=?thisform.codibank,dep_obser=?xobser where dep_codi = ?thisform.xcodidep;")
		desconectar_db(frmabmdep)
		
		IF USED("eliminados")
			IF RECCOUNT("eliminados")>0
				LOCAL xdepel
				SELECT eliminados
				GO to
				SCAN
					xdepel=recpag_codi
					frmabmdep= conectar_db(_screen.cn)
						SQLEXEC(frmabmdep,"update recibos_pagos set dep_codi = 0 where recpag_codi = ?xdepel;")
					desconectar_db(frmabmdep)
					SELECT eliminados 
				ENDSCAN
				cerrar_cusor("eliminados")
			ENDIF
		ENDIF
		
		SELECT cur_valores
		GO top
		SCAN
			xrpg=cur_valores.recpag_codi
			frmabmdep= conectar_db(_screen.cn)
				SQLEXEC(frmabmdep,"select * from recibos_pagos where recpag_codi = ?xrpg;","cur_exis")
				IF cur_exis.dep_codi=0
					SQLEXEC(frmabmdep,"update recibos_pagos set dep_codi = ?thisform.xcodidep where recpag_codi = ?xrpg;")
				ENDIF
			desconectar_db(frmabmdep)
			SELECT cur_valores
		ENDSCAN
		
		IF _screen.callplanidep=1
			_screen.estamodidep=1
		ENDIF
		
		MESSAGEBOX("El depósito se modificó con éxito.-",64,"Aviso del Sistema")
		
		cerrar_cursor("cheq")
		cerrar_cursor("cur_valores")
		
		thisform.Release
	ENDPROC

	PROCEDURE cmd_guardar.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE cmd_guardar.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE cmd_salir.Click
		thisform.Release
		
	ENDPROC

	PROCEDURE cmd_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE cmd_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Ctn_banner.Init
		this.Height=130
		this.left=0
		this.Width=this.Parent.Width
	ENDPROC

	PROCEDURE edt_obser.Click
		this.SetFocus
	ENDPROC

	PROCEDURE edt_obser.GotFocus
		CAPSLOCK(.T.)
	ENDPROC

	PROCEDURE edt_obser.LostFocus
		CAPSLOCK(.F.)
	ENDPROC

	PROCEDURE txt_fechadep.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_fechadep.LostFocus
		IF this.Value <> thisform.xfecdep
			thisform.cmd_guardar.Enabled= .T.
		ENDIF
	ENDPROC

	PROCEDURE txt_nbol.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_nbol.LostFocus
		IF this.Value<> thisform.xnbol
			thisform.cmd_guardar.Enabled= .T.
		ENDIF
	ENDPROC

ENDDEFINE

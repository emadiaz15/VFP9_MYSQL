		capslock(.T.)
	ENDPROC

	PROCEDURE Edit3.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Edit4.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit4.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Text13.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.Click
		this.setfocus
	ENDPROC


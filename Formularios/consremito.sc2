	PROCEDURE buscar_compasoc
		LPARAMETERS _xCodr
		LOCAL xpto,xfac,xtip,xcade,xtex
		***************************************BUSCA PEDIDOS*******************************************
		IF thisform.xcodp>0
			frmconsfac= conectar_db(_screen.cn)
				SQLEXEC(frmconsfac,"select * from pedidos where ped_codi= ?thisform.xcodp;","cur_ped")
			desconectar_db(frmconsfac)
			IF RECCOUNT("cur_ped") > 0
				xnump  = IIF(cur_ped.notaped_nro>0 , cur_ped.notaped_nro, cur_ped.ped_codi)
				xpedtex= IIF(cur_ped.notaped_nro>0 , 'NPED_', 'PED_')
				xcade  = REPLICATE("0",8-LEN(ALLTRIM(STR(xnump ))))+ALLTRIM(STR(xnump ))
				INSERT INTO (thisform.xcurcomp) values(ALLTRIM(xpedtex+'0000'+'-'+xcade),'PED',cur_ped.ped_codi)
			ENDIF
		ENDIF
		
		cerrar_cursor("cur_ped")
		
		************************************************************************************************
		******************************BUSCA CPBTE ASOC POR FAC / NC / ND********************************
		frmconsfac= conectar_db(_screen.cn)
			SQLEXEC(frmconsfac,"call usp_loadfac(?_xCodr);","cur_factu")
		desconectar_db(frmconsfac)
		
		*!*	IF RECCOUNT("cur_factu") > 0
		*!*		LOCATE
			IF RECCOUNT("cur_factu") > 0
				LOCATE
				SCAN
					xcade1 = REPLICATE("0",4-LEN(ALLTRIM(STR(cur_factu.fac_pto))))+ALLTRIM(STR(cur_factu.fac_pto))
					xcade2 = REPLICATE("0",8-LEN(ALLTRIM(STR(cur_factu.fac_nro))))+ALLTRIM(STR(cur_factu.fac_nro))
					xtex = ICASE(cur_factu.fac_conc='F','FAC',cur_factu.fac_conc='N','NC',cur_factu.fac_conc='D','ND')
					INSERT INTO (thisform.xcurcomp) values(ALLTRIM(xtex+'_'+xcade1+'-'+xcade2),xtex,cur_factu.fac_codi)
				ENDSCAN
			ENDIF
		*!*	ENDIF
		
		*!*	cerrar_cursor("cur_lcomp")
		cerrar_cursor("cur_factu")
		************************************************************************************************
		
		SELECT (thisform.xcurcomp)
		LOCATE
		
		thisform.comp_asoc.cmb_comp.RowSource = (thisform.xcurcomp)
		thisform.comp_asoc.cmb_comp.value = cpbte
	ENDPROC

	PROCEDURE datos_click
		thisform.RemoveObject("shp_datos")
		thisform.RemoveObject("edt_datos")
		thisform.RemoveObject("cmd_datos")
	ENDPROC

	PROCEDURE datos_mleave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.F.
		thisform.cmd_datos.FontSize=9
	ENDPROC

	PROCEDURE datos_mmove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.T.
		thisform.cmd_datos.FontSize=10
	ENDPROC

	PROCEDURE Destroy
		do case
			case prompt()="Por Cliente"
				set skip of bar 2 of Remitos .F.
			case prompt()="Por Proveedor"
				set skip of bar 3 of Remitos .F.
		endcase
		nitem=0
		pasrem=0
	ENDPROC

	PROCEDURE grid_rightclick
		LOCAL lcShortcut, loRef
		m.loRef = this
		m.lcShortcut = SYS(2015)
		
		DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Ver Descripción Completa] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
		
		ON SELECTION BAR 1 OF (m.lcShortcut) m.loRef.Grid_ShowDesc()
		*!*	SET MARK OF BAR 1 OF (m.lcShortcut) TO m.loRef.lExpanded
		
		ACTIVATE POPUP (m.lcShortcut)
		RELEASE POPUP (m.lcShortcut)
		
	ENDPROC

	PROCEDURE grid_showdesc
		IF USED("cur_grid")
			IF VARTYPE(thisform.shp_datos)="U"
				thisform.AddObject("shp_datos","shape")
				WITH thisform.shp_datos
					.left    = 105
					.top     = 218
					.width   = 574
					.height  = 173
					.backcolor = RGB(140, 165, 176)
					.SpecialEffect = 0
					.Visible = .T.
				ENDWITH
					
				THISFORM. ADDOBJECT("edt_datos","EDITBOX")
				WITH THISform.edt_datos
					.left    = 117
					.top     = 231
					.width   = 550
					.height  = 125
					.disabledbackcolor = RGB(40,44,52)
					.forecolor = RGB(244,210,50)
					.fontsize  = 10
					.fontbold  = .T.
					.readonly  = .T.
					.value     = ALLTRIM(cur_grid.descri)
					.themes    = .F.
					.Visible   = .T.
				ENDWITH
				
				thisform.AddObject("cmd_datos","Commandbutton")
				WITH thisform.cmd_datos
					.left      = 333
					.top       = 359
					.width     = 108
					.height    = 27
					.themes    = .F.
					.forecolor = RGB(255,255,255)
					.backcolor = RGB(227,68,34)
					.alignment = 2
					.caption   = "\<Cerrar Ventana"
					.Visible   = .T.
					=BINDEVENT(ThisForm.cmd_datos, "Click", ThisForm, "datos_click")
					=BINDEVENT(ThisForm.cmd_datos, "MouseMove", ThisForm, "datos_mmove")
					=BINDEVENT(ThisForm.cmd_datos, "MouseLeave", ThisForm, "datos_mleave")
				ENDWITH
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		parameter lcodirem,cond
		thisform.xcodirem=lcodirem
		public descrip,postal,locali,provi,coditran1,coditran2,flete1,flete2,nrofac
		set date british
		set cent on
		coditran1=0
		coditran2=0
		flete1=0
		flete2=0
		nrofac=0
		
		CREATE CURSOR cur_grid(nit N(4), cant N(15,3), med C(2),codi C(10),descri C(254),st C(2))
		
		thisform.xcurcomp = SYS(2015)
		CREATE CURSOR (thisform.xcurcomp)(cpbte C(20),tipcbte C(3),codbus N(10))
		
		frmconsrem= conectar_db(_screen.cn)
			SQLEXEC(frmconsrem,"select * from remitos where rem_codi=?thisform.xcodirem;","cur_rem")
		desconectar_db(frmconsrem)
		codifac=cur_rem.fac_codi
		IF cur_rem.anulado="S"
			this.label4.Visible=.T.
		ELSE
			this.label4.Visible=.F.
		ENDIF
		this.text13.value=cur_rem.rem_fech
		this.text7.value=repl("0",4-len(allt(str(cur_rem.rem_pto))))+allt(str(cur_rem.rem_pto))+" - "+repl("0",8-len(allt(str(cur_rem.rem_nro))))+allt(str(cur_rem.rem_nro))
		thisform.text8.value=cur_rem.flete_valor
		thisform.text9.value=cur_rem.flete_peso
		thisform.edit2.value=cur_rem.rem_observ
		thisform.xcodp      =cur_rem.ped_codi
		if pasrem=1
			this.command1.visible=.F.
		ENDIF
		IF INLIST(UPPER(substr(sys(0),ATC("#",sys(0))+2)),'DEPÓSITO','TALLER')
			this.command3.Visible=.F.
		ENDIF
		with thisform
			do case
				case cur_rem.cli_codi>0
					codicli=cur_rem.cli_codi
					codiprov=0
					this.caption="Consulta de Remitos por Cliente"
					frmconsrem= conectar_db(_screen.cn)
						SQLEXEC(frmconsrem,"call usp_buscarcli(?codicli);","cur_clir")
					desconectar_db(frmconsrem)
					.text1.value=cur_clir.cli_nomb
					.text2.value=cur_clir.cli_domi
				case cur_rem.prov_codi>0
					codiprov=cur_rem.prov_codi
					codicli=0
					this.caption="Consulta de Remitos por Proveedor"
					frmconsrem= conectar_db(_screen.cn)
						SQLEXEC(frmconsrem,"call usp_buscarprov(?codiprov);","cur_pror")
					desconectar_db(frmconsrem)
					.text1.value=cur_pror.prov_nomb
					.text2.value=cur_pror.prov_domi
					.label1.caption="    Datos del Proveedor     "
					.label2.caption="Proveedor:"
			endcase		
			.text3.value=IIF(codicli>0,cur_clir.cp_nro,cur_pror.cp_nro)
			.text4.value=IIF(codicli>0,cur_clir.loca_nomb,cur_pror.loca_nomb)
			.text5.value=IIF(codicli>0,cur_clir.provi_nomb,cur_pror.provi_nomb)
			frmconsrem= conectar_db(_screen.cn)
				DO case
					CASE codicli>0
						SQLEXEC(frmconsrem,"select a.*,b.art_desc,b.art_med,c.dac_desc from remitos_articulos as a inner join articulos as b on a.art_codi=b.art_codi left outer join desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.rem_codi=?thisform.xcodirem;","cur_remart")
					CASE codiprov>0
						SQLEXEC(frmconsrem,"select a.*,b.art_desc,b.art_med,c.dap_desc from remitos_articulos as a inner join articulos as b on a.art_codi=b.art_codi left outer join desc_articulos_proveedores c on c.dap_codi=a.dap_codi where a.rem_codi=?thisform.xcodirem;","cur_remart")
				ENDCASE
			desconectar_db(frmconsrem)
			nitem=1
			con=0
			SCAN
				if cur_remart.art_codi=4 OR cur_remart.art_codi=5
					if len(cur_remart.artrem_dasc)>0
						cadena=allt(repl("0",8-len(allt(str(cur_remart.art_codi))))+allt(str(cur_remart.art_codi)))
						cantidad=cur_remart.artrem_cant
						INSERT INTO cur_grid values(nitem, cur_remart.artrem_cant, cur_remart.art_med, cadena, cur_remart.artrem_dasc,cur_remart.artrem_sstock)
						nitem=nitem+1
					endif
				ELSE
					frmconsrem= conectar_db(_screen.cn)
						SQLEXEC(frmconsrem,"select dac_desc from desc_articulos_clientes where dac_codi=?cur_remart.dac_codi;","cur_dac")
						SQLEXEC(frmconsrem,"select dap_desc from desc_articulos_proveedores where dap_codi=?cur_remart.dap_codi;","cur_dap")
					desconectar_db(frmconsrem)
					cadena=allt(repl("0",8-len(allt(str(cur_remart.art_codi))))+allt(str(cur_remart.art_codi)))
					DO case
						CASE RECCOUNT("cur_dac")>0
							INSERT INTO cur_grid values(nitem, cur_remart.artrem_cant, cur_remart.art_med, cadena, cur_remart.dac_desc,cur_remart.artrem_sstock)
						CASE RECCOUNT("cur_dap")>0
							INSERT INTO cur_grid values(nitem, cur_remart.artrem_cant, cur_remart.art_med, cadena, cur_remart.dap_desc,cur_remart.artrem_sstock)
					OTHERWISE
						INSERT INTO cur_grid values(nitem, cur_remart.artrem_cant, cur_remart.art_med, cadena, cur_remart.art_desc,cur_remart.artrem_sstock)
					ENDCASE		
					nitem=nitem+1
				ENDIF
			ENDSCAN
			frmconsrem= conectar_db(_screen.cn)
				SQLEXEC(frmconsrem,"select a.*,b.tran_nomb,b.tran_domi,b.tran_cartel,b.tran_tel1 from remitos_transportes as a inner join transportes as b on a.tran_codi=b.tran_codi where a.rem_codi=?thisform.xcodirem;","cur_remtra")
			desconectar_db(frmconsrem)
			if RECCOUNT()>0
				GO top
				coditran1=cur_remtra.tran_codi
				.text6.value=cur_remtra.tran_nomb
				do case
					case cur_remtra.flete_cargo="C"
						.opcionflete1.value=1
					case cur_remtra.flete_cargo="P"
						.opcionflete1.value=2
				endcase
				.edit3.value=cur_remtra.flete_lugent
				if RECCOUNT()=2
					skip
					coditran2=cur_remtra.tran_codi
				    .text24.value=cur_remtra.tran_nomb
					do case
						case cur_remtra.flete_cargo="C"
							.opcionflete2.value=1
						case cur_remtra.flete_cargo="P"
							.opcionflete2.value=2
					endcase
					.edit4.value=cur_remtra.flete_lugent
				ENDif
			ENDIF
			SELECT cur_grid
			LOCATE
			thisform.grd_detalle.RecordSource='cur_grid'
			thisform.buscar_compasoc(cur_rem.rem_codi)
		ENDWITH
		
		=BINDEVENT(ThisForm.grd_detalle, "RightClick", ThisForm, "Grid_RightClick")
	ENDPROC

	PROCEDURE Load
		do case
			case prompt()="Por Cliente"
				set skip of bar 2 of Remitos .T.
			case prompt()="Por Proveedor"
				set skip of bar 3 of Remitos .T.
		endcase
	ENDPROC

	PROCEDURE LostFocus
		do case
			case prompt()="Por Cliente"
				set skip of bar 2 of Remitos .F.
			case prompt()="Por Proveedor"
				set skip of bar 3 of Remitos .F.
		endcase
		
	ENDPROC

	PROCEDURE Command1.Click
		DO case
			CASE codicli>0
				do form remload with codicli
			CASE codiprov>0
				proveedor=cur_pror.prov_nomb
				do form remloadp with proveedor,codiprov
		endcase	
		thisform.release
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command3.Click
		remi=messagebox("¿Imprime Remito?",1+48,"Advertencia")
		if remi=1
			prremi=messagebox("Asegurese que los formularios correspondientes al Remito Nº: "+ALLTRIM(thisform.text7.Value)+" estén en la impresora y luego haga clic en Aceptar",1+48,"Advertencia")
			if prremi=1	
				DIMENSION tra[2,5]
				store "" to tra[1,1],tra[1,2],tra[1,5],tra[2,1],tra[2,2],tra[2,5],tra[1,3],tra[1,4],tra[2,3],tra[2,4]
				do case
					case thisform.opcionflete1.value=1
						flete1=1
					case thisform.opcionflete1.value=2
						flete1=2
				endcase
				do case
					case thisform.opcionflete2.value=1
						flete2=1
					case thisform.opcionflete2.value=2
						flete2=2
				endcase
				SELECT cur_remtra
				IF RECCOUNT()>0
					GO top
					tra[1,1]=allt(tran_nomb)
					tra[1,2]=allt(tran_domi)
					tra[1,3]=tran_cartel
					tra[1,4]=tran_tel1
					tra[1,5]=allt(thisform.edit3.value)
					IF RECCOUNT()=2
						skip
						tra[2,1]=allt(tran_nomb)
						tra[2,2]=allt(tran_domi)
						tra[2,3]=tran_cartel
						tra[2,4]=tran_tel1
						tra[2,5]=allt(thisform.edit4.value)
					endif
				ENDIF
				SELECT cur_remart
				GO TOP
				for n=1 to 3
					do case
						case n=1
							comprobante="ORIGINAL"
						case n=2
							comprobante="DUPLICADO"
						case n=3
							comprobante="TRIPLICADO"
					endcase
					do case
						case codicli>0
							set point to ","
							report form remito for cur_remart.rem_codi=thisform.xcodirem TO PRINTER PROMPT noconsole
							set point to
						case codiprov>0
							set point to ","
							report form remitoprov for cur_remart.rem_codi=thisform.xcodirem TO PRINTER prompt noconsole
							set point to
					endcase
				next n
			endif
		endif
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Comp_asoc.btn_buscar.img_buscar.Click
		SELECT (thisform.xcurcomp)
		
		DO CASE
			CASE tipcbte = "FAC" OR tipcbte = "NC" OR tipcbte = "ND"
				pasfac=1
				Ej_Consfac(codbus, cond)
			CASE tipcbte = "PED"
				DO FORM conspedicli WITH codbus,cond
		ENDCASE
		
	ENDPROC


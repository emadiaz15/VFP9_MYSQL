	ENDPROC

	PROCEDURE ctn_moneda.chk_dolares.Click
		IF this.Value=1 AND this.Parent.chk_pesos.Value=1
			LOCAL dbcant
			SELECT COUNT(*) FROM cur_arpres INTO ARRAY ccantit
			IF TYPE("ccantit") = "N"
				IF ccantit[1] > 0
					prmon= MESSAGEBOX("¿Dolariza el total de los ítems del presupuesto?",4+64+256,"Aviso del Sistema")
					IF prmon=6
						thisform.pesifica_dolariza(1)
					ELSE
						MESSAGEBOX("Debe modificar manualmente cada ítem cotizado.",48,"Aviso del Sistema")
					ENDIF
				ENDIF
			ENDIF
			this.Parent.chk_pesos.Value=0
			thisform.lbl_cotiz.Visible= .F.
			thisform.txt_cotiz.Visible= .F.
			this.Parent.top= 24
			_screen.monepres='D'
			_screen.dolarpres=thisform.txt_cotiz.Value
		ENDIF
	ENDPROC

	PROCEDURE ctn_moneda.chk_pesos.Click
		IF this.Value=1
			LOCAL dbcant
			SELECT COUNT(*) FROM cur_arpres INTO ARRAY ccantit
			IF TYPE("ccantit") = "N"
				IF ccantit[1] > 0
					prmon= MESSAGEBOX("¿Pesifica todos de los ítems del presupuesto?",4+32+256,"Aviso del Sistema")
					IF prmon=6
						thisform.estapesif=.T.
					ELSE
						MESSAGEBOX("Debe modificar manualmente cada ítem cotizado.",48,"Aviso del Sistema")
					ENDIF
				ENDIF
				prdol= MESSAGEBOX("¿Conserva la cotización del dolar del día "+ ;
							      IIF(ISNULL(cur_conpres.presup_ultact),ALLTRIM(DTOC(thisform.text13.Value)), ;
							      ALLTRIM(DTOC(cur_conpres.presup_ultact)))+"?",4+32+256,"Aviso del Sistema")
				IF prdol=6
					thisform.txt_cotiz.Value = thisform.xdolar
				ELSE
					thisform.txt_cotiz.Value = thisform.xdolaract
				ENDIF		
			ENDIF
			_screen.monepres='P'
			this.Parent.chk_dolares.Value=0
			this.Parent.chk_dolares.Value=0
			thisform.ctn_moneda.Top=5
			thisform.lbl_cotiz.Visible= .T.
			thisform.txt_cotiz.Visible= .T.
			thisform.txt_cotiz.SetFocus
		ELSE
			thisform.ctn_moneda.Top=24
			thisform.lbl_cotiz.Visible= .F.
			thisform.txt_cotiz.Visible= .F.
		ENDIF
	ENDPROC

	PROCEDURE ctn_utilact.cmd_util.Click
		LOCAL xreaj,xutilsf,prum,xutiact
		frmmodipres= conectar_db(_screen.cn)
			SQLEXEC(frmmodipres,"select param_impo from parametros where param_codi=11;","cur_rjdolar")
		desconectar_db(frmmodipres)
		xreaj =(100-cur_rjdolar.param_impo)/100
		xutilsf = ROUND(((((thisform.txt_utipro.Value/100)+1) * xreaj)-1)*100,3)
		
		IF this.Parent.txt_utilact.Value<>xutilsf
			prut = MESSAGEBOX("¿Actualiza la misma utilidad del día "+ALLTRIM(DTOC(IIF(ISNULL(cur_conpres.presup_ultact),thisform.text13.Value,cur_conpres.presup_ultact)))+ ;
							  " al día de hoy?",4+48+256,"Aviso del Sistema")
			IF prut = 6
				IF RECCOUNT((thisform.xcurmpres)) > 0
					prum = MESSAGEBOX("¿Actualiza esta utilidad en todos los ítem cotizados en este presupuesto.?",4+32+256,"Aviso del Sistema")
					IF prum = 6
						LOCAL xutipro,utmasfor
						xutipro = ROUND(((thisform.txt_utipro.Value)/100)+1,5)
						UPDATE (thisform.xcurmpres) SET artpres_precio=ROUND(xutipro*IIF(cond_codi =2,costoact,costoact*((iva/100)+1)),3), ;
							prtotal= (ROUND(xutipro*IIF(cond_codi =2,costoact,costoact*((iva/100)+1)),3))*ConverNro(artpres_cant), ;
							utilact= ROUND(((xutipro*xreaj)-1)*100,3)
						thisform.calcutilidad(2)
						thisform.calc_totales()
						xutiact=ROUND(((thisform.xdolbajac*thisform.xtotv/thisform.xtotc/thisform.xdolaract)-1)*100,3)
						this.parent.txt_utilact.Value=IIF(ISNULL(xutiact),0,xutiact)
					ENDIF
				ENDIF		
				_screen.utilidad = thisform.txt_utiproact.Value
			ELSE
				this.Parent.txt_utilact.Style= 0
				this.Parent.txt_utilact.SetFocus
			ENDIF
		ELSE
			this.Parent.txt_utilact.Style= 0
			this.Parent.txt_utilact.SetFocus	
		ENDIF
		
		
	ENDPROC

	PROCEDURE ctn_utilact.txt_utilact.Click
		this.SetFocus
	ENDPROC

	PROCEDURE ctn_utilact.txt_utilact.GotFocus
		thisform.utilitem=this.Value
	ENDPROC

	PROCEDURE ctn_utilact.txt_utilact.LostFocus
		this.Style= 1
	ENDPROC

	PROCEDURE ctn_utilact.txt_utilact.Valid
		IF LASTKEY()=13
			IF this.Value <= 0
				MESSAGEBOX("La utilidad debe ser mayor a cero.",48,"Aviso del Sistema")
				RETURN .F.
			ELSE
				IF this.Value<>thisform.utilitem
					LOCAL xutipro,utmasfor,xreaj
					frmmodipres= conectar_db(_screen.cn)
						SQLEXEC(frmmodipres,"select param_impo from parametros where param_codi=11;","cur_rjdolar")
					desconectar_db(frmmodipres)	
					xreaj =(100-cur_rjdolar.param_impo)/100
					utmasfor= ROUND(((this.value/100)+1)/xreaj,5)
					xutipro = ROUND(((this.Value/100)+1),5)
					UPDATE (thisform.xcurmpres) SET artpres_precio=ROUND(utmasfor*IIF(cond_codi =2,costoact,costoact*((iva/100)+1)),3), ;
						prtotal= (ROUND(utmasfor*IIF(cond_codi =2,costoact,costoact*((iva/100)+1)),3))*ConverNro(artpres_cant), ;
						utilact= ROUND((xutipro-1)*100,3)
					thisform.calcutilidad(2)
					thisform.calc_totales()
					_screen.utilidad=ROUND((utmasfor-1)*100,3)
					KEYBOARD '{TAB}'+'{TAB}'+'{TAB}'
				ENDIF
			ENDIF
		ELSE
			RETURN .F.
			this.SetFocus
		ENDIF
	ENDPROC

	PROCEDURE grd_detalle.Column10.Text1.Click
		this.SetFocus
	ENDPROC

	PROCEDURE grd_detalle.Column10.Text1.GotFocus
		*!*	KEYBOARD "*"
		SELECT (thisform.xcurmpres)
		thisform.utilitem=utilact
	ENDPROC

	PROCEDURE grd_detalle.Column10.Text1.Valid
		IF LASTKEY()=13
			IF this.Value<>thisform.utilitem
				LOCAL xreg, xreaj
				frmmodipres= conectar_db(_screen.cn)
					SQLEXEC(frmmodipres,"select param_impo from parametros where param_codi=11;","cur_rjdolar")
				desconectar_db(frmmodipres)
				xreaj =(100-cur_rjdolar.param_impo)/100
				SELECT (thisform.xcurmpres)
				xreg= nro_regis
				UPDATE (thisform.xcurmpres) SET artpres_precio = IIF(cond=2,1,((iva/100)+1)) * ((((this.value/100)+1)/xreaj)*costoact) ;
					WHERE nro_regis = xreg
				UPDATE (thisform.xcurmpres) SET prtotal = artpres_precio*ConverNro(artpres_cant) ;
					WHERE nro_regis = xreg
				thisform.grd_detalle.Refresh
				thisform.calcutilidad(2)
				thisform.calc_totales()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Optiongroup1.Option1.Click
		thisform.label15.caption="*"
		thisform.label15.top=504
		thisform.label15.visible= .T.
		thisform.text14.setfocus
	ENDPROC

	PROCEDURE Optiongroup1.Option2.Click
		thisform.label15.caption=":"
		thisform.label15.top=501
		thisform.label15.visible= .T.
		thisform.text14.setfocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		codigo=0
		opcion=0
		valorcadena=thisform.valorcadena
		on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		if localiz=1
		*!*		if elimi=0
		*!*			thisform.grid1.toprow=nitemmp
		*!*		else
				elimi=0
		*!*		endif
		endif
	ENDPROC

	PROCEDURE Text13.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text19.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text19.GotFocus
		public valdto
		valdto=this.value
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			if this.value<>valdto
				do case
					case this.value=0
						.text17.value=""
						.text18.value=.text8.value
						thisform.impo1=thisform.impo1/((100-valdto)/100)
						thisform.impo2=thisform.impo2/((100-valdto)/100)
						thisform.acun1=thisform.acun1/((100-valdto)/100)
						thisform.acun2=thisform.acun2/((100-valdto)/100)
						thisform.acu1=thisform.acu1/((100-valdto)/100)
						thisform.acu2=thisform.acu2/((100-valdto)/100)
						if cond=2
							.text9.value=.text9.value/((100-valdto)/100)
							.text11.value=.text11.value/((100-valdto)/100)
						endif
					otherwise
						.text17.value=.text8.value*this.value/100
						.text18.value=.text8.value-.text17.value
						if cond=2
							if valdto>0
								.text9.value=.text9.value/((100-valdto)/100)
								.text11.value=.text11.value/((100-valdto)/100)
							endif
							.text9.value=.text9.value*((100-this.value)/100)
							.text11.value=.text11.value*((100-this.value)/100)
						endif
						if valdto>0
							thisform.impo1=thisform.impo1/((100-valdto)/100)
							thisform.impo2=thisform.impo2/((100-valdto)/100)
							thisform.acun1=thisform.acun1/((100-valdto)/100)
							thisform.acun2=thisform.acun2/((100-valdto)/100)
							thisform.acu1=thisform.acu1/((100-valdto)/100)
							thisform.acu2=thisform.acu2/((100-valdto)/100)
						endif
						thisform.impo1=thisform.impo1*((100-this.value)/100)
						thisform.impo2=thisform.impo2*((100-this.value)/100)
						thisform.acun1=thisform.acun1*((100-this.value)/100)
						thisform.acun2=thisform.acun2*((100-this.value)/100)
						thisform.acu1=thisform.acu1*((100-this.value)/100)
						thisform.acu2=thisform.acu2*((100-this.value)/100)
				endcase 
				.text10.value=.text18.value+.text9.value+.text11.value
			endif
		endwith
	ENDPROC

	PROCEDURE Text20.GotFocus
		codigo=0
		opcion=0
		valorcadena=thisform.valorcadena
		on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		
	ENDPROC

	PROCEDURE txt_cotiz.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE txt_cotiz.Valid
		IF LASTKEY()=13
			IF thisform.estapesif=.T.
				IF this.Value<>_screen.dolarpres
					_screen.dolarpres=this.Value
				ENDIF
				thisform.pesifica_dolariza(2)
		*!*			thisform.estapesif=.F.
			ENDIF
		ENDIF
		
	ENDPROC

ENDDEFINE

	PROCEDURE gridart_config_colores_seguro
		IF !PEMSTATUS(thisform, "xGridArtFixedColumns", 5)
		    thisform.AddProperty("xGridArtFixedColumns", "10")
		ELSE
		    thisform.xGridArtFixedColumns = "10"
		ENDIF
		=GridArt_ConfigurarColores(thisform)
		RETURN
	ENDPROC

	PROCEDURE gridart_refresh
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    thisform.gridart_setup()
		ELSE
		    =GridArt_RefrescarStockVisual(thisform)
		    thisform.gridart_config_colores_seguro()
		ENDIF
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockFormNative(thisform)
		ENDIF
		RETURN
	ENDPROC

	PROCEDURE gridart_setup
		SET PROCEDURE TO grid_articulos_ui ADDITIVE
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    =GridArt_BindNative(thisform, "grd_detalle", thisform.xcurmpres, "art_codi", "art_desc")
		    =GridArt_BindTooltipEvents(thisform)
		ENDIF
		=GridArt_RefrescarStockVisual(thisform)
		thisform.gridart_config_colores_seguro()
		thisform.gridart_sync_active_color()
		ON KEY LABEL ESC DO GridArt_OnEsc IN grid_articulos_ui
		RETURN
	ENDPROC

	PROCEDURE gridart_sync_active_color
		LPARAMETERS nColIndex
		LOCAL lnCol, loCol, lnBack, lnFore
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    RETURN
		ENDIF
		lnBack = GridArt_GetDynBack(thisform)
		lnFore = GridArt_GetDynFore(thisform)
		WITH thisform.grd_detalle
		    .HighlightStyle = 0
		    .Highlight      = .F.
		    FOR lnCol = 1 TO 9
		        loCol = .Columns(lnCol)
		        IF PEMSTATUS(loCol, "Text1", 5)
		            loCol.Text1.BackColor  = lnBack
		            loCol.Text1.ForeColor  = lnFore
		            loCol.Text1.BorderStyle = 0
		        ENDIF
		    ENDFOR
		    .Refresh()
		ENDWITH
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockFormNative(thisform)
		ENDIF
		RETURN
	ENDPROC

	PROCEDURE grid_dblclick
		local x,y,dtopie,ivaencol,xmone,opcion2,xutilact,xcostoact,xregini,xitini
		STORE 0 TO xutilact,xcostoact,xregini,xitini
		xmone= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
		
		ivaencol=0
		if RECCOUNT((thisform.xcurmpres))>0
			aux= ALLTRIM(item)
			dato1= art_codi
			dato2= ALLTRIM(artpres_cant)
			dato3= ALLTRIM(art_desc)
			dato4= ALLTRIM(STR(artpres_precio,15,3))
			prtot= ALLTRIM(STR(prtotal,15,3))
			dato5= ALLTRIM(art_med)
			_screen.altermodi=dato5
			auxiva=0
			auximpo=0
			frmaltapr= conectar_db(_screen.cn)
			SQLEXEC(frmaltapr,"select * from articulos where art_codi=?dato1;","cur_arti")
			desconectar_db(frmaltapr)
			impiva1=thisform.impiva1
			impiva2=thisform.impiva2
			opcion2=0
			do form modippreg with cond,opcion,opcion2,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		if borra=6
		*!*		thisform.estadodel=.T.
			SET POINT TO ","
			with thisform
				SELECT (thisform.xcurmpres)
				xregis = nro_regis
				do case
					case iva=thisform.impiva1
						ivaencol=1
					case iva=thisform.impiva2
						ivaencol=2
				endcase
				thisform.acu=thisform.acu-prtotal
		
				DELETE FROM (thisform.xcurmpres) WHERE nro_regis =  xregis
		
				SELECT (thisform.xcurmpres)
				LOCATE
				xit=1
				xreg=1
				SCAN
					REPLACE nro_regis WITH xreg
					IF alternativa<>"S"
						REPLACE item with ALLTRIM(STR(xit))
						xit = xit + 1
					ENDIF
					xreg=xreg+1
				ENDSCAN
				LOCATE FOR nro_regis = xregis
				thisform.text8.value=thisform.acu
				if thisform.text19.value>0
					dtopie=round((100-thisform.text19.value)/100,2)
					thisform.text17.value=thisform.acu*dtopie
					thisform.text18.value=thisform.acu-thisform.text17.value
					do case
						case ivaencol=1
							thisform.impo1=thisform.impo1-(ConverNro(prtot)*dtopie)
							if cond=2
								thisform.text9.value=thisform.text9.value-round((ConverNro(prtot)*dtopie)*thisform.impiva1/100,2)
							else
								auxacuneto=thisform.acun1
								thisform.acun1=thisform.acun1-((ConverNro(prtot)*dtopie)/(1+(thisform.impiva1/100)))
								thisform.acu1=thisform.acu1-(auxacuneto-thisform.acun1)*thisform.impiva1/100
							endif
						case ivaencol=2
							thisform.impo2=thisform.impo2-(ConverNro(prtot)*dtopie)
							if cond=2
								thisform.text11.value=thisform.text11.value-round((ConverNro(prtot)*dtopie)*thisform.impiva2/100,2)
							else
								auxacuneto=thisform.acun2
								thisform.acun2=thisform.acun2-((ConverNro(prtot)*dtopie)/(1+(thisform.impiva2/100)))
								thisform.acu2=thisform.acu2-(auxacuneto-thisform.acun2)*thisform.impiva2/100
							endif
					endcase
				else
					thisform.text18.value=thisform.acu
					do case
						case ivaencol=1
							thisform.impo1=thisform.impo1-ConverNro(prtot)
							if cond=2				
								thisform.text9.value=thisform.text9.value-round(ConverNro(prtot)*thisform.impiva1/100,2)
							else
								auxacuneto=thisform.acun1
								thisform.acun1=thisform.acun1-(ConverNro(prtot)/(1+(thisform.impiva1/100)))
								thisform.acu1=thisform.acu1-(auxacuneto-thisform.acun1)*thisform.impiva1/100
							endif
						case ivaencol=2
							thisform.impo2=thisform.impo2-ConverNro(prtot)
							if cond=2
								thisform.text11.value=thisform.text11.value-round(ConverNro(prtot)*thisform.impiva2/100,2)
							else
								auxacuneto=thisform.acun2
								thisform.acun2=thisform.acun2-(ConverNro(prtot)/(1+(thisform.impiva2/100)))
								thisform.acu2=thisform.acu2-(auxacuneto-thisform.acun2)*thisform.impiva2/100
							endif
					endcase
				endif
				thisform.text10.value=thisform.text18.value+thisform.text9.value+thisform.text11.value
				
				thisform.grd_detalle.Refresh	
				thisform.calcutilidad(2)
			endwith
			borra=0
			insertar=0
			preg=0
			SET POINT TO
		endif
		if insertar=1 and codigo>0
			SET POINT TO ","
			SET DECIMALS TO 3
			with thisform
				SELECT (thisform.xcurmpres)
				xregis= nro_regis
				frmaltapr= conectar_db(_screen.cn)
					SQLEXEC(frmaltapr,"select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmaltapr)
				**************************** COMIENZA CALCULO UTILIDAD Y COSTO ACTUAL ***********************************
				IF codigo>5
					xprbajo= ROUND((ConverNro(pruni)*thisform.xdolbajac)/thisform.xdolaract,3)
					frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr, "call usp_calcutil(?codigo,?xprbajo,?xmone,?thisform.xdolaract,?cond,?impiva1,?impiva2,?cur_arti.art_alicuota);","cur_utiln")
						SQLEXEC(frmaltapr, "call usp_ctoutil(?codigo,?xmone,?DATE(),?thisform.xdolaract);","cur_cton")
					desconectar_db(frmaltapr)
					IF RECCOUNT("cur_utiln") > 0
						SELECT IIF(ISNULL(util),0,util) FROM cur_utiln INTO ARRAY ar_utiln
						cerrar_cursor("cur_utiln")
					ENDIF
					xutilact=IIF(TYPE("ar_utiln")="N",ar_utiln[1],0)
					IF RECCOUNT("cur_cton") > 0
						SELECT IIF(ISNULL(costo),0,costo) FROM cur_cton INTO ARRAY ar_cton
						cerrar_cursor("cur_cton")
					ENDIF
					xcostoact=IIF(TYPE("ar_cton")="N",ar_cton[1],0)
				ELSE
					STORE 0 TO xutilact,xcostoact
				ENDIF		
				***************************** FIN CALCULO UTILIDAD Y COSTO ACTUAL **************************************
				do case
					case opcion=1
						SELECT (thisform.xcurmpres)
		*!*					GO IIF(thisform.estadodel=.T.,xregis+1,xregis)
						LOCATE FOR nro_regis = xregis
						INSERT before blank
						REPLACE item           WITH '0'
						REPLACE artpres_cant   WITH ALLTRIM(cant)
						REPLACE art_med        WITH cur_arti.art_med
						REPLACE art_codi       WITH cur_arti.art_codi
						REPLACE art_desc       WITH IIF(codigo<=5,ALLTRIM(descrip),ALLTRIM(descri))
						REPLACE artpres_precio WITH ConverNro(pruni)
						REPLACE prtotal        WITH ConverNro(prtot)
						REPLACE iva            WITH IIF(cur_arti.art_alicuota=1,impiva1,impiva2)
						REPLACE util           WITH 0
						REPLACE utilact        WITH xutilact
						REPLACE costo          WITH 0
						REPLACE costoact       WITH xcostoact
						REPLACE alicuo         WITH cur_arti.art_alicuota
						REPLACE presup_codi    WITH thisform.npresup
						REPLACE alternativa    WITH ''
						REPLACE cond_codi      WITH cond
						REPLACE presup_dto     WITH thisform.text19.Value
						REPLACE nro_regis      WITH 0
						thisform.acu=thisform.acu+ConverNro(prtot)
						STORE 0 TO muestro,opcion
						localiz=1
					case opcion=2
						SELECT (thisform.xcurmpres)
		*!*					GO IIF(thisform.estadodel=.T.,xregis+1,xregis)
						LOCATE FOR nro_regis = xregis
						INSERT after blank
						REPLACE item           WITH ''
						REPLACE artpres_cant   WITH ''
						REPLACE art_med        WITH 'ALT'
						REPLACE art_codi       WITH cur_arti.art_codi
						REPLACE art_desc       WITH IIF(codigo<=5,ALLTRIM(descrip),ALLTRIM(descri))
						REPLACE artpres_precio WITH ConverNro(pruni)
						REPLACE prtotal        WITH 0
						REPLACE iva            WITH 0
						REPLACE util           WITH 0
						REPLACE utilact        WITH xutilact
						REPLACE costo          WITH 0
						REPLACE costoact       WITH xcostoact
						REPLACE alicuo         WITH cur_arti.art_alicuota
						REPLACE presup_codi    WITH thisform.npresup
						REPLACE alternativa    WITH 'S'
						REPLACE cond_codi      WITH cond
						REPLACE presup_dto     WITH thisform.text19.Value
						REPLACE nro_regis      WITH 0				
						alternati="N"
						STORE 0 TO muestro,localiz,opcion
						xregis = xregis + 1
				ENDCASE
				SELECT (thisform.xcurmpres)
				xregini=1
				xitini =1
				SCAN
					REPLACE nro_regis WITH xregini
					xregini = xregini + 1
					IF alternativa<>"S"
						REPLACE item WITH ALLTRIM(STR(xitini))
						xitini = xitini + 1
					ENDIF
				ENDSCAN
				
				thisform.calcutilidad(2)
				LOCATE FOR nro_regis = xregis
				thisform.grd_detalle.Refresh
				insertar=0
				thisform.estadodel=.F.
			ENDWITH
			SET POINT TO
			SET DECIMALS TO
		endif
	ENDPROC

	PROCEDURE grid_rightclick
		LOCAL lcShortcut, loRef
		m.loRef = THISFORM
		m.lcShortcut = SYS(2015)
		
		DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Ver Descripción Completa] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
		DEFINE BAR 2 OF (m.lcShortcut) PROMPT [\-]
		DEFINE BAR 3 OF (m.lcShortcut) PROMPT [Últimas Cotizaciones] PICTURE "C:\VFP9_MYSQL\imagen\img_buscar_01.png"
		=GridArt_AddStockMenuSeparator(m.lcShortcut, 4)
		=GridArt_AddStockMenuOption(m.lcShortcut, 5, m.loRef)
		=GridArt_AddListaComprasMenuOption(m.lcShortcut, 6)
		
		ON SELECTION BAR 1 OF (m.lcShortcut) m.loRef.Grid_ShowDesc()
		ON SELECTION BAR 3 OF (m.lcShortcut) m.loRef.Grid_ShowLastQuotes()
		
		ACTIVATE POPUP (m.lcShortcut)
		RELEASE POPUP (m.lcShortcut)
	ENDPROC

	PROCEDURE grid_showdesc
		
		IF USED((thisform.xcurmpres))
			IF VARTYPE(thisform.shp_datos)="U"
				SELECT (thisform.xcurmpres)
				thisform.AddObject("shp_datos","shape")
				WITH thisform.shp_datos
					.left    = 105
					.top     = 275
					.width   = 574
					.height  = 173
					.backcolor = RGB(140, 165, 176)
					.SpecialEffect = 0
					.Visible = .T.
				ENDWITH
					
				THISFORM. ADDOBJECT("edt_datos","EDITBOX")
				WITH THISform.edt_datos
					.left    = 117
					.top     = 288
					.width   = 550
					.height  = 125
					.disabledbackcolor = RGB(40,44,52)
					.forecolor = RGB(244,210,50)
					.fontsize  = 10
					.fontbold  = .T.
					.readonly  = .T.
					.value     = ALLTRIM(art_desc)
					.themes    = .F.
					.Visible   = .T.
				ENDWITH
				
				thisform.AddObject("cmd_datos","Commandbutton")
				WITH thisform.cmd_datos
					.left      = 333
					.top       = 416
					.width     = 108
					.height    = 27
					.themes    = .F.
					.forecolor = RGB(255,255,255)
					.backcolor = RGB(227,68,34)
					.alignment = 2
					.caption   = "\<Cerrar Ventana"
					.Visible   = .T.
					=BINDEVENT(ThisForm.cmd_datos, "Click", ThisForm, "datos_click")
					=BINDEVENT(ThisForm.cmd_datos, "MouseMove", ThisForm, "datos_mmove")
					=BINDEVENT(ThisForm.cmd_datos, "MouseLeave", ThisForm, "datos_mleave")
				ENDWITH
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE grid_showlastquotes
		THISFORM.AddProperty("oWait")
		
		IF TYPE("THISFORM.oWait") <> "O" OR ISNULL(THISFORM.oWait)   
			THISFORM.oWait = CREATEOBJECT("frmWait", "Procesando información...Espere...")
			THISFORM.oWait.Show()
			DOEVENTS
			INKEY(0.15) && 150 milisegundos para que pinte el label antes de ejecutar la query
			DOEVENTS
		ELSE
			THISFORM.oWait.SetMessage("Procesando información...Espere...")
		ENDIF
		
		LOCAL xarticulo, xcliente, xdescart
		LOCAL xresult, xcQuery
		LOCAL lcTmp, lcDbf
		LOCAL frmaltapr, xreaj, xdolar
		LOCAL xpunto, xsepar
		
		IF !USED(THISFORM.xcurmpres) OR RECCOUNT(THISFORM.xcurmpres) = 0
		    RETURN
		ENDIF
		
		SELECT (THISFORM.xcurmpres)
		xarticulo = art_codi
		xdescart  = LEFT(ALLTRIM(art_desc), 60)
		
		IF xarticulo <= 5
		    MESSAGEBOX("Este ítem no tiene historial de cotización." + CHR(13) + ;
		               "No es un artículo codificado.", 48, "Aviso del Sistema")
		    RETURN
		ENDIF
		
		xcliente = thisform.codicli
		IF xcliente = 0
		    MESSAGEBOX("No hay cliente seleccionado para el presupuesto.", 48, "Aviso del Sistema")
		    RETURN
		ENDIF
		
		** Limpiar cursores anteriores
		IF USED("cur_ultcotiz")
		    USE IN cur_ultcotiz
		ENDIF
		
		** Obtener parámetro de reajuste
		frmaltapr = conectar_db(_screen.cn)
		SQLEXEC(frmaltapr, "SELECT param_impo FROM parametros WHERE param_codi = 11;", "cur_rjdolar")
		desconectar_db(frmaltapr)
		
		xreaj = (100 - cur_rjdolar.param_impo) / 100
		
		** Query con cálculo de utilidad igual que usp_conspres, Ver si se puede reutilizar!
		xpunto=SET("POINT")
		xsepar=SET("SEPARATOR")
		SET POINT TO "."
		SET SEPARATOR TO ","
		TEXT TO xcQuery NOSHOW TEXTMERGE
		SELECT 
		    d.presup_fech, 
		    d.presup_codi, 
		    a.artpres_cant, 
		    ROUND(a.artpres_precio, 3) AS artpres_precio,
		    ROUND(a.artpres_cant * a.artpres_precio, 2) AS total, 
		    d.moneda, 
		    d.cotiz_dolar,
		    IFNULL(ROUND(
		        CASE
		            WHEN (d.moneda = 'D' AND a.artpres_precio > 0) THEN
		                (SELECT ((((IF(f.cond_codi<>2, IF(b.art_alicuota=1, a.artpres_precio/((e.iva_1/100)+1), a.artpres_precio/((e.iva_2/100)+1)), a.artpres_precio) * 
		                    (d.cotiz_dolar * <<xreaj>>) / IF(his.moneda='P', his.histo_costo/d.cotiz_dolar, his.histo_costo)) / d.cotiz_dolar)-1)*100)
		                FROM histocosto his
		                INNER JOIN articulos_proveedores ap ON ap.artpro_codi = his.artpro_codi
		                WHERE ap.art_codi = a.art_codi AND ap.cotiz = 1
		                AND his.histo_costo > 0 
		                AND DATE(his.histo_fech) <= COALESCE(
		                    (SELECT MAX(DATE(h2.histo_fech)) 
		                     FROM histocosto h2 
		                     INNER JOIN articulos_proveedores ap2 ON ap2.artpro_codi = h2.artpro_codi
		                     WHERE ap2.art_codi = a.art_codi AND ap2.cotiz = 1 
		                     AND DATE(h2.histo_fech) <= IFNULL(d.presup_ultact, d.presup_fech)
		                     AND h2.histo_costo > 0),
		                    (SELECT MAX(DATE(h3.histo_fech)) 
		                     FROM histocosto h3 
		                     INNER JOIN articulos_proveedores ap3 ON ap3.artpro_codi = h3.artpro_codi
		                     WHERE ap3.art_codi = a.art_codi AND ap3.cotiz = 1
		                     AND h3.histo_costo > 0)
		                )
		                ORDER BY his.histo_fech DESC LIMIT 1)
		            WHEN (d.moneda = 'P' AND a.artpres_precio > 0) THEN
		                (SELECT ((((IF(his.moneda='D', IF(f.cond_codi<>2, IF(b.art_alicuota=1, a.artpres_precio/((e.iva_1/100)+1), a.artpres_precio/((e.iva_2/100)+1)), a.artpres_precio)
		                    / d.cotiz_dolar, IF(f.cond_codi<>2, IF(b.art_alicuota=1, a.artpres_precio/((e.iva_1/100)+1), a.artpres_precio/((e.iva_2/100)+1)), a.artpres_precio)) * <<xreaj>>) / his.histo_costo)-1)*100)
		                FROM histocosto his
		                INNER JOIN articulos_proveedores ap ON ap.artpro_codi = his.artpro_codi
		                WHERE ap.art_codi = a.art_codi AND ap.cotiz = 1
		                AND his.histo_costo > 0 
		                AND DATE(his.histo_fech) <= COALESCE(
		                    (SELECT MAX(DATE(h2.histo_fech)) 
		                     FROM histocosto h2 
		                     INNER JOIN articulos_proveedores ap2 ON ap2.artpro_codi = h2.artpro_codi
		                     WHERE ap2.art_codi = a.art_codi AND ap2.cotiz = 1 
		                     AND DATE(h2.histo_fech) <= IFNULL(d.presup_ultact, d.presup_fech)
		                     AND h2.histo_costo > 0),
		                    (SELECT MAX(DATE(h3.histo_fech)) 
		                     FROM histocosto h3 
		                     INNER JOIN articulos_proveedores ap3 ON ap3.artpro_codi = h3.artpro_codi
		                     WHERE ap3.art_codi = a.art_codi AND ap3.cotiz = 1
		                     AND h3.histo_costo > 0)
		                )
		                ORDER BY his.histo_fech DESC LIMIT 1)
		            ELSE 0
		        END, 3), 0) AS utilidad,
		        f.cond_codi
		FROM presupuestos_articulos a 
		INNER JOIN articulos b ON a.art_codi = b.art_codi 
		INNER JOIN presupuestos d ON a.presup_codi = d.presup_codi
		INNER JOIN iva e ON d.iva_codi = e.iva_codi
		INNER JOIN clientes f ON d.cli_codi = f.cli_codi
		WHERE d.cli_codi = <<xcliente>> 
		  AND a.art_codi = <<xarticulo>>
		ORDER BY d.presup_fech DESC, d.presup_codi DESC;
		ENDTEXT
		SET POINT TO &xpunto
		SET SEPARATOR TO &xsepar 
		  &&AND a.alternativa <> 'S'
		
		SET DECIMALS TO 3
		frmaltapr = conectar_db(_screen.cn)
			xresult = SQLEXEC(frmaltapr, xcQuery, "cur_ultcotiz")
		desconectar_db(frmaltapr)
		SET DECIMALS TO
		
		IF TYPE("THISFORM.oWait") <> "O" OR ISNULL(THISFORM.oWait)   
			THISFORM.oWait = CREATEOBJECT("frmWait", "Procesando información...Espere...")
			THISFORM.oWait.Show()
			DOEVENTS
		ELSE
			THISFORM.oWait.SetMessage("Procesando información...Espere...")
		ENDIF
		
		IF xresult < 0 OR !USED("cur_ultcotiz") OR RECCOUNT("cur_ultcotiz") = 0
		    MESSAGEBOX("No hay cotizaciones anteriores para este cliente" + CHR(13) + ;
		               "y este artículo (Cód: " + ALLTRIM(STR(xarticulo)) + ").", 64, "Historial de Cotizaciones")
		    IF USED("cur_ultcotiz")
		        USE IN cur_ultcotiz
		    ENDIF
			IF TYPE("THISFORM.oWait") = "O"
				thisform.oWait.Release
			ENDIF    
		    RETURN
		ENDIF
		
		** Guardar en DBF temporal
		lcTmp = SYS(2023)
		lcDbf = FORCEEXT(ADDBS(lcTmp) + "histo_" + SYS(2015), "dbf")
		
		SELECT cur_ultcotiz
		COPY TO (lcDbf)
		
		** Abrir formulario
		PUBLIC goHistoCotiz
		
		IF TYPE("goHistoCotiz") = "O" AND !ISNULL(goHistoCotiz)
		    goHistoCotiz.Release()
		ENDIF
		goHistoCotiz = .NULL.
		
		DO FORM frm_histocotiz NAME goHistoCotiz WITH cond LINKED
		
		IF TYPE("goHistoCotiz") <> "O" OR ISNULL(goHistoCotiz)
		    MESSAGEBOX("No se pudo abrir el formulario de historial.", 16, "Error")
			IF TYPE("THISFORM.oWait") = "O"
				thisform.oWait.Release
			ENDIF    
		    RETURN
		ENDIF
		
		=goHistoCotiz.ShowWithCursor(lcDbf, xarticulo, xdescart)
		
		IF TYPE("THISFORM.oWait") = "O"
			thisform.oWait.Release
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE Init
		parameter xcodp,cond
		public elimi,aux,descrip,muestro,insertar,validez,plazo,condpag,lugent,observ, ;
			   codigo,cant,descri,pruni,prtot,alternati,borra,impiva1,impiva2,nro,dato1, ;
			   dato2,dato3,dato4,cant,descri,codiva,impiva,opcion,localiz,acu,dife,nitemmp, ;
			   auxiva,auximpo,auxali
		
		STORE 0 TO auxiva,auximpo,auxali,paso,thisform.acu,elimi,localiz,aux,muestro,insertar,borra,nitemmp,opcion,codigo
		STORE '' TO validez,plazo,condpag,lugent,observ,descrip,prtot,pruni
		set deleted on
		set date british
		set cent on
		
		SET TALK OFF
		SET STATUS BAR OFF
		SET NOTIFY OFF
		SET CONSOLE OFF
		
		_screen.xopvta="PR"
		
		thisform.npresup=xcodp
		
		thisform.xcurmpres = SYS(2015)
		
		alternati="N"
		
		STORE 0 TO this.text8.Value, ;
				   this.text17.Value, ;
				   this.text18.Value, ;
				   this.text9.Value, ;
				   this.text11.Value, ;
		           this.text10.Value, ;
		           this.txt_cotiz.Value
		LOCAL xreaj
		thisform.valorcadena=valorcadena
		frmmodipres= conectar_db(_screen.cn)
			SQLEXEC(frmmodipres,"select * from iva order by iva_codi desc limit 1;","cur_ivaact")
			codiva=cur_ivaact.iva_codi
			impiva=cur_ivaact.iva_1
			SQLEXEC(frmmodipres,"select a.*,b.*,c.*,d.cond_desc from presupuestos a inner join clientes b on a.cli_codi=b.cli_codi inner join iva c on c.iva_codi=a.iva_codi inner join condiva d on b.cond_codi=d.cond_codi where presup_codi=?xcodp;","cur_conpres")
			SQLEXEC(frmmodipres,"select a.loca_nomb,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on a.provi_codi=c.provi_codi where a.loca_codi=?cur_conpres.loca_codi;","cur_ubicli")
			SQLEXEC(frmmodipres,"select param_impo from parametros where param_codi = 14;","cur_dolar")
			SQLEXEC(frmmodipres,"select param_impo from parametros where param_codi=11;","cur_rjdolar")
		desconectar_db(frmmodipres)
		IF RECCOUNT("cur_conpres")>0
			with thisform
				thisform.lbl_actualizado.Caption=IIF(ISNULL(cur_conpres.presup_ultact),'','ÚLTIMA ACTUALIZACIÓN: '+ALLTRIM(DTOC(cur_conpres.presup_ultact))+'.-')
				thisform.codicli=cur_conpres.cli_codi
				_screen.clientepres=cur_conpres.cli_codi
				xreaj =(100-cur_rjdolar.param_impo)/100
				thisform.xdolar =cur_conpres.cotiz_dolar
				thisform.xdolbaj= thisform.xdolar*xreaj
				thisform.xdolaract= cur_dolar.param_impo
				thisform.xdolbajac= thisform.xdolaract*xreaj
				_screen.dolarpres=thisform.xdolaract
				.text1.value=cur_conpres.cli_nomb
		*!*			.text14.value="0"+allt(cur_conpres.cli_cartel)+"-"+allt(cur_conpres.cli_tel1)
				.text7.value=cur_conpres.presup_codi
				.text13.value=cur_conpres.presup_fech
				.text20.value=cur_conpres.presup_ref
				.text19.value=cur_conpres.presup_dto
				validez=cur_conpres.presup_ofer
				plazo=cur_conpres.presup_plent
				condpag=cur_conpres.presup_cond
				lugent=cur_conpres.presup_lugent
				observ=cur_conpres.presup_obser
				if codiva<>cur_conpres.iva_codi and impiva<>cur_conpres.iva_1
					preg=messagebox("Los artículos de este presupuesto fueron cotizados con un IVA del "+chr(13)+ ;
									allt(str(cur_conpres.iva_1,10,2))+"% y un IVA RNI del "+allt(str(cur_conpres.iva_2,10,2))+"%."+chr(13)+ ;
									"¿Conserva estos importes de IVA?",4+32+256,"IVA Presupuestado")
					if preg=6
						thisform.impiva1=cur_conpres.iva_1
						thisform.impiva2=cur_conpres.iva_2
					else
						thisform.impiva1=cur_ivaact.iva_1
						thisform.impiva2=cuv_ivaact.iva_2
					endif
					.label12.caption=allt(str(thisform.impiva1,10,2))+"%"
					.label13.caption=allt(str(thisform.impiva2,10,2))+"%"
				else
					thisform.impiva1=cur_conpres.iva_1
					thisform.impiva2=cur_conpres.iva_2
					.label12.caption=allt(str(thisform.impiva1,10,2))+"%"
					.label13.caption=allt(str(thisform.impiva2,10,2))+"%"
				endif
			ENDWITH
			DO case
				CASE cur_conpres.moneda='D'
					_screen.monepres='D'
					thisform.ctn_moneda.chk_dolares.Value=1
				CASE cur_conpres.moneda='P'
					_screen.monepres='P'
					thisform.ctn_moneda.chk_pesos.Value=1
					thisform.ctn_moneda.Top=5
					thisform.lbl_cotiz.Visible= .T.
					thisform.txt_cotiz.Visible= .T.
					MESSAGEBOX("Verifique bien si conserva la cotización de dolar indicada al confeccionar el presupuesto, de lo contario puede modificarla.-",48,"Aviso del Sistema")
					thisform.txt_cotiz.Value=cur_conpres.cotiz_dolar
			ENDCASE
			SET DECIMALS TO 3
		*!*		MESSAGEBOX("dolar_presupuesto: "+ALLTRIM(STR(cur_conpres.cotiz_dolar,15,3))+CHR(13)+ ;
		*!*				   "dolar actual     : "+ALLTRIM(STR(thisform.xdolaract,15,3)),64,"Cotizaciones")
			frmmodipres= conectar_db(_screen.cn)
					SQLEXEC(frmmodipres,"call usp_consprmod(?thisform.npresup,?cur_conpres.cotiz_dolar,?thisform.xdolbaj,?thisform.xdolaract,?thisform.xdolbajac,?cur_conpres.moneda,?xreaj);","cur_arpres")
			desconectar_db(frmmodipres)
			SET DECIMALS TO
			IF RECCOUNT("cur_arpres") > 0
				SELECT * FROM cur_arpres INTO CURSOR (thisform.xcurmpres) READWRITE
				GO TOP IN (thisform.xcurmpres)
				thisform.grd_detalle.RecordSource=(thisform.xcurmpres)
				thisform.grd_detalle.column5.ControlSource="(art_desc)"
				thisform.grd_detalle.COLUMN10.DynamicBackColor='RGB(85,88,106)'
				thisform.grd_detalle.COLUMN10.DynamicForeColor='RGB(242,243,249)'
				thisform.calcutilidad(1)
			ENDIF
			thisform.calc_totales()
			
		*!*		FOR ncol=1 TO 10
		*!*			xsource="Thisform.grd_detalle.column"+ALLTRIM(STR(ncol))+".text1"
		*!*			BINDEVENT(&xsource,"DblClick",Thisform,"Grid_DblClick")
		*!*			BINDEVENT(&xsource,"RightClick",Thisform,"Grid_RightClick")
		*!*		NEXT ncol
		
			FOR ncol=1 TO 10
				xsource="Thisform.grd_detalle.column"+ALLTRIM(STR(ncol))+".text1"
				BINDEVENT(&xsource,"DblClick",Thisform,"Grid_DblClick")
				BINDEVENT(&xsource,"RightClick",Thisform,"Grid_RightClick")
			NEXT ncol
					
			thisform.gridart_setup()
			BINDEVENT(Thisform.grd_detalle, "AfterRowColChange", Thisform, "gridart_sync_active_color")	
					
			thisform.grd_detalle.SetFocus
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		set skip of bar 9 of Modificaci .T.
	ENDPROC

	PROCEDURE LostFocus
		*if prompt()<>"Presupuestos Clientes"
		*	set skip of bar 9 of Modificaci .F.
		*	thisform.hide
		*	localiz=0
		*	item=0
		*endif
	ENDPROC

	PROCEDURE pesifica_dolariza
		LPARAMETERS xopcmon
		
		SET POINT TO ","
		with thisform
			LOCAL ivaencol,xmone,xcotiz
			STORE 0 TO thisform.acu,auxiva,auximpo,auxali
			STORE 0 TO thisform.impo1, ;
					   thisform.impo2, ;
					   thisform.acu1, ;
					   thisform.acu2, ;
					   thisform.acun1, ;
					   thisform.acun2
			STORE 0 TO .text8.value, ;
				       .text9.value, ;
			           .text10.value, ;
			           .text11.value, ;
			           .text17.value, ;
			           .text18.value
		
			xcotiz= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,thisform.xdolaract,thisform.ctn_moneda.chk_pesos.Value=1,thisform.txt_cotiz.Value)
			SELECT (thisform.xcurmpres)
			LOCATE
			SCAN
				valor1=ConverNro(artpres_cant)
				valor2=ROUND(ICASE(xopcmon=1,artpres_precio/xcotiz,xopcmon=2,artpres_precio*xcotiz),3)
				REPLACE artpres_precio WITH valor2
				xtotal = (valor1*valor2)
				REPLACE prtotal WITH xtotal
				**************************** COMIENZA CALCULO UTILIDAD Y COSTO ACTUAL ***********************************
				xmone = ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
				xarti = art_codi
				IF xarti>5
					xprbajo= ROUND((valor2*thisform.xdolbajac)/thisform.xdolaract,3)
					xalicuo= alicuo
					frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr, "call usp_calcutil(?xarti,?xprbajo,?xmone,?xcotiz,?cond,?impiva1,?impiva2,?xalicuo);","cur_utiln")
						SQLEXEC(frmaltapr, "call usp_ctoutil(?xarti,?xmone,?DATE(),?xcotiz);","cur_cton")
					desconectar_db(frmaltapr)
					IF RECCOUNT("cur_utiln") > 0
						SELECT IIF(ISNULL(util),0,util) FROM cur_utiln INTO ARRAY ar_utiln
						cerrar_cursor("cur_utiln")
					ENDIF
					IF RECCOUNT("cur_cton") > 0
						SELECT IIF(ISNULL(costo),0,costo) FROM cur_cton INTO ARRAY ar_cton
						cerrar_cursor("cur_cton")
					ENDIF
				ENDIF
				***************************** FIN CALCULO UTILIDAD Y COSTO ACTUAL **************************************
				SELECT (thisform.xcurmpres)
				REPLACE utilact WITH ar_utiln[1]
				REPLACE costoact WITH ar_cton[1]
				thisform.acu=thisform.acu+xtotal
				********************COMIENZA CALCULO DE IVA*********************
				IF ALLTRIM(art_med)<>"ALT"
					.text8.value=thisform.acu
					.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
					.text18.value=.text8.value-.text17.value
					do case
						case iva=thisform.impiva1
							ivaencol=1
						case iva=thisform.impiva2
							ivaencol=2
					ENDCASE
					if .text19.value>0
						do case
							case ivaencol=1
								if cond=2
									thisform.impo1=thisform.impo1+(xtotal*((100-.text19.value)/100))
									if auxali=2
										.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
									endif
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								else
									thisform.acun1=thisform.acun1+round(((xtotal*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
									if auxali=2
										thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
									endif
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
							case ivaencol=2
								if cond=2
									thisform.impo2=thisform.impo2+(xtotal*((100-.text19.value)/100))
									if auxali=1
										.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
									endif
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								else
									thisform.acun2=thisform.acun2+round(((xtotal*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
									if auxali=1
										thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
									endif
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
						endcase
					else
						do case
							case ivaencol=1
								if cond=2
									thisform.impo1=thisform.impo1+xtotal
									if auxali=2
										.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
									endif
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								else
									thisform.acun1=thisform.acun1+round((xtotal/(1+(thisform.impiva1/100))),3)
									if auxali=2
										thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
									endif
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
							case ivaencol=2
								if cond=2
									thisform.impo2=thisform.impo2+xtotal
									if auxali=1
										.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
									endif
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								else
									thisform.acun2=thisform.acun2+round((xtotal/(1+(thisform.impiva2/100))),3)
									if auxali=1
										thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
									endif
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
						endcase
					endif
					.text10.value=.text18.value+.text9.value+.text11.value
				ENDIF
			ENDSCAN
			LOCATE
			thisform.grd_detalle.Refresh
			thisform.calcutilidad(2)
			if paso>0
				paso=0
			endif
		ENDWITH
		SET POINT TO
		
	ENDPROC

	PROCEDURE cmd_modicli.Click
		prem=MESSAGEBOX("¿MODIFICA CLIENTE PARA ESTE PRESUPUESTO?",4+48+256,"Aviso del Sistema")
		IF prem=6
			codicli=thisform.codicli
			DO FORM cliload WITH codicli
			IF codicli>0
				thisform.codicli=codicli
				auxcond=cur_conpres.cond_codi
				UPDATE cur_conpres SET cli_codi   =cur_clie.cli_codi, ;
									   cli_nomb   =cur_clie.cli_nomb, ;
									   cli_domi   =cur_clie.cli_domi, ;
									   cli_cuit   =cur_clie.cli_cuit, ;
									   cli_cartel =cur_clie.cli_cartel, ;
									   cli_tel1   =cur_clie.cli_tel1, ;
									   cli_tel2   =cur_clie.cli_tel2, ;
									   cli_cel    =cur_clie.cli_cel, ;
									   cli_email  =cur_clie.cli_email, ;
									   loca_codi  =cur_clie.loca_codi, ;
									   cond_codi  =cur_clie.cond_codi, ;
									   cli_saldo  =cur_clie.cli_saldo, ;
									   zona_codi  =cur_clie.zona_codi, ;
									   cli_favor  =cur_clie.cli_favor, ;
									   cond_desc  =cur_clie.cond_desc
				frmmodipres= conectar_db(_screen.cn)
					SQLEXEC(frmmodipres,"select a.loca_nomb,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on a.provi_codi=c.provi_codi where a.loca_codi=?cur_conpres.loca_codi;","cur_ubicli")
				desconectar_db(frmmodipres)
				WITH thisform
					cond=cur_conpres.cond_codi
					.text1.value=cur_conpres.cli_nomb
		*!*				.text2.value=cur_conpres.cli_domi
		*!*				.text6.value=cur_conpres.cond_desc
		*!*				.text12.value=VAL(cur_conpres.cli_cuit)
					.text14.value="0"+allt(cur_conpres.cli_cartel)+"-"+allt(cur_conpres.cli_tel1)
		*!*				.text3.value=cur_ubicli.cp_nro
		*!*				.text4.value=cur_ubicli.loca_nomb
		*!*				.text5.value=cur_ubicli.provi_nomb			
					LOCAL ivgrilla,cangrilla,pru,xarti &&itgrid,
		*!*				itgrid=thisform.grid1.rows-1
					ivgrilla=0
					pru=0
					IF auxcond<>cond
						STORE 0 TO thisform.acu,auxiva,auximpo,auxali
						STORE 0 TO thisform.impo1, ;
								   thisform.impo2, ;
								   thisform.acu1, ;
								   thisform.acu2, ;
								   thisform.acun1, ;
								   thisform.acun2
						STORE 0 TO thisform.text8.value, ;
							       thisform.text9.value, ;
						           thisform.text10.value, ;
						           thisform.text11.value, ;
						           thisform.text17.value, ;
				 		           thisform.text18.value
				 		thisform.text8.ForeColor=RGB(255,255,255)
				 		thisform.text9.ForeColor=RGB(255,255,255)
				 		thisform.text10.ForeColor=RGB(255,255,255)
				 		thisform.text11.ForeColor=RGB(255,255,255)
				 		thisform.text17.ForeColor=RGB(255,255,255)
				 		thisform.text18.ForeColor=RGB(255,255,255)
				 		SET POINT TO ","
				 		SET DECIMALS TO 3
						IF cond=2
							thisform.acu=0
							SELECT (thisform.xcurmpres)
							LOCATE
							SCAN
								xarti=art_codi
								frmmodipres= conectar_db(_screen.cn)
									SQLEXEC(frmmodipres,"select art_alicuota from articulos where art_codi=?xarti;","cur_ali")
								desconectar_db(frmmodipres)
								SELECT (thisform.xcurmpres)
								cangrilla=ConverNro(artpres_cant)
								ivgrilla=iva
								REPLACE artpres_precio WITH ROUND(artpres_precio/(1+(ivgrilla/100)),3)
								pru=ROUND(cangrilla*artpres_precio,2)
								REPLACE prtotal WITH pru
								thisform.acu=thisform.acu+pru
								.text8.value=thisform.acu
								.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
								.text18.value=.text8.value-.text17.value
								if .text19.value>0
									do case
										case cur_ali.art_alicuota=1
											if cond=2
												thisform.impo1=thisform.impo1+(pru*((100-.text19.value)/100))
												.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
											else
												thisform.acun1=thisform.acun1+round(((pru*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
												thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
											endif
										case cur_ali.art_alicuota=2
											if cond=2
												thisform.impo2=thisform.impo2+(pru*((100-.text19.value)/100))
												.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
											else
												thisform.acun2=thisform.acun2+round(((pru*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
												thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
											endif
									endcase
								else
									do case
										case cur_ali.art_alicuota=1
											if cond=2
												thisform.impo1=thisform.impo1+pru
												.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
											else
												thisform.acun1=thisform.acun1+round((pru/(1+(thisform.impiva1/100))),3)
												thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
											endif
										case cur_ali.art_alicuota=2
											if cond=2
												thisform.impo2=thisform.impo2+pru
												.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
											else
												thisform.acun2=thisform.acun2+round((pru/(1+(thisform.impiva2/100))),3)
												thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
											endif
									endcase
								endif
								.text10.value=.text18.value+.text9.value+.text11.value
							ENDSCAN
						ELSE
							thisform.acu=0
							SELECT (thisform.xcurmpres)
							LOCATE
							SCAN
								xarti=art_codi
								frmmodipres= conectar_db(_screen.cn)
									SQLEXEC(frmmodipres,"select art_alicuota from articulos where art_codi=?xarti;","cur_ali")
								desconectar_db(frmmodipres)
								SELECT (thisform.xcurmpres)
								cangrilla=ConverNro(artpres_cant)
								ivgrilla=iva
								REPLACE artpres_precio WITH ROUND(artpres_precio*(1+(ivgrilla/100)),3)
								pru=ROUND(cangrilla*artpres_precio,2)
								REPLACE prtotal WITH pru
								thisform.acu=thisform.acu+pru
								.text8.value=thisform.acu
								.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
								.text18.value=.text8.value-.text17.value
								if .text19.value>0
									do case
										case cur_ali.art_alicuota=1
											if cond=2
												thisform.impo1=thisform.impo1+(pru*((100-.text19.value)/100))
												.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
											else
												thisform.acun1=thisform.acun1+round(((pru*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
												thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
											endif
										case cur_ali.art_alicuota=2
											if cond=2
												thisform.impo2=thisform.impo2+(pru*((100-.text19.value)/100))
												.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
											else
												thisform.acun2=thisform.acun2+round(((pru*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
												thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
											endif
									endcase
								else
									do case
										case cur_ali.art_alicuota=1
											if cond=2
												thisform.impo1=thisform.impo1+pru
												.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
											else
												thisform.acun1=thisform.acun1+round((pru/(1+(thisform.impiva1/100))),3)
												thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
											endif
										case cur_ali.art_alicuota=2
											if cond=2
												thisform.impo2=thisform.impo2+pru
												.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
											else
												thisform.acun2=thisform.acun2+round((pru/(1+(thisform.impiva2/100))),3)
												thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
											endif
									endcase
								endif
								.text10.value=.text18.value+.text9.value+.text11.value				
							ENDSCAN
						ENDIF
					ENDIF
					thisform.grd_detalle.Refresh
					thisform.calcutilidad(2)
					SET POINT TO
					SET DECIMALS TO
				ENDWITH
			ENDIF
		 	thisform.text8.ForeColor=RGB(0,0,0)
		 	thisform.text9.ForeColor=RGB(0,0,0)
		 	thisform.text10.ForeColor=RGB(0,0,0)
		 	thisform.text11.ForeColor=RGB(0,0,0)
		 	thisform.text17.ForeColor=RGB(0,0,0)
		 	thisform.text18.ForeColor=RGB(0,0,0)
		ENDIF
		
	ENDPROC

	PROCEDURE Command1.Click
		salir=messagebox("¿Seguro que desea Salir?",4+32+256,"Verifique!!!")
		if salir=6
			thisform.release
		endif
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command2.Click
		if RECCOUNT((thisform.xcurmpres))=0
			messagebox("Aún no ha ingresado ningún artículo al Presupuesto, imposible Terminar"+chr(13)+ ;
					   "Ingrese algún artículo presionando la tecla INSERT. Si desea salir de la"+chr(13)+ ; 
					   "rutina utilize el botón Salir o presione la tecla ESC",48,"Advertencia")
		else
			preg=messagebox("¿Confirma los datos del Presupuesto?",4+32+256,"Alta de Presupuestos")
			if preg=6
				with thisform
					LOCAL xcodip,xfecha,xref,xdto,xdasc,xarti,xdac,xcant,xprec,xalt,xit,xreg,xmone,fechact,opcodi,xdd1,xdd2
					STORE "" TO xdd1,xdd2
					xmone= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
					xfecha=.text13.value
					xref= ALLTRIM(.text20.value)
					xdto=.text19.value
					xcodip=thisform.npresup
					xutilact =thisform.ctn_utilact.txt_utilact.Value
					fechact = IIF(thisform.text13.Value<>DATE(),DATE(),NULL)
					frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr,"select COUNT(*) cant from presupuestos_articulos where presup_codi=?xcodip;","cur_canit")
						SQLEXEC(frmaltapr,"update presupuestos set presup_fech=?xfecha,cli_codi=?thisform.codicli,presup_ref=?xref,presup_ofer=?validez,presup_plent=?plazo,presup_lugent=?lugent,presup_cond=?condpag,presup_dto=?xdto,presup_obser=?observ,iva_codi=?codiva where presup_codi=?xcodip;")
						SQLEXEC(frmaltapr,"update presupuestos set moneda=?xmone,cotiz_dolar=?thisform.xdolaract,presup_util=?xutilact,presup_ultact=?fechact where presup_codi=?xcodip;")
					desconectar_db(frmaltapr)
					LOCAL dbcant
					SELECT COUNT(*) FROM (thisform.xcurmpres) INTO ARRAY ccantit
					dbcant =VAL(ALLTRIM(cur_canit.cant))
					IF dbcant>ccantit
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"delete from presupuestos_articulos where presup_codi = ?xcodip and nro_regis > ?ccantit;")
						desconectar_db(frmaltapr)
						cerrar_cursor("cur_canit")
					ENDIF
					RELEASE ccantit, dbcant
					SELECT (thisform.xcurmpres)
					LOCATE
					SCAN
						if art_codi<=5
							xdasc=ALLTRIM(art_desc)
						else
							xdasc=""
						endif
						xarti=art_codi
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
						desconectar_db(frmaltapr)
						SELECT (thisform.xcurmpres)
						xdd1=allt(art_desc)
						xdd2=allt(cur_desc.art_desc)				
						if xarti>5 AND xdd1<>xdd2 &&allt(art_desc)<>allt(cur_desc.art_desc)
							xdac = 0
							frmaltapr= conectar_db(_screen.cn)
								SQLEXEC(frmaltapr,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
							desconectar_db(frmaltapr)
							IF RECCOUNT("cur_artcli")>0
								LOCAL xcadena
								SELECT (thisform.xcurmpres)
								xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+xdd1
		*!*							xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(art_desc)
								frmaltapr= conectar_db(_screen.cn)
									SQLEXEC(frmaltapr,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
								desconectar_db(frmaltapr)
								IF RECCOUNT("cur_ddes")>0
									xdac=cur_ddes.dac_codi
								endif
							endif
						else
							xdac=0
						ENDIF
						SELECT (thisform.xcurmpres)
						SET POINT TO ","
						SET DECIMALS TO 4
						xcant=ConverNro(artpres_cant)			
						xprec=artpres_precio
						SET POINT TO
						SET DECIMALS TO
						if allt(art_med)="ALT"
							xalt="S"
							xit=0							
						else
							xalt=""
							xit=val(item)
						ENDIF
						xreg=nro_regis
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"select * from presupuestos_articulos where presup_codi=?xcodip and nro_regis=?xreg;","cur_registro")
							IF RECCOUNT("cur_registro")>0
								SQLEXEC(frmaltapr,"update presupuestos_articulos set art_codi=?xarti,artpres_precio=?xprec,artpres_cant=?xcant,artpres_dasc=?xdasc,alternativa=?xalt,nro_it=?xit,nro_regis=?xreg,alter_iva=0,dac_codi=?xdac where presup_codi=?xcodip and nro_regis=?xreg;")
							ELSE
								SQLEXEC(frmaltapr,"insert into presupuestos_articulos values(?xcodip,?xarti,?xprec,?xcant,?xdasc,?xalt,?xit,?xreg,0,?xdac);")
							ENDIF
						desconectar_db(frmaltapr)
						IF !ISNULL(fechact)
							thisform.lbl_actualizado.Caption='ÚLTIMA ACTUALIZACIÓN: '+ALLTRIM(DTOC(DATE()))+'.-'
						ENDIF
					ENDSCAN		
					cantreg=RECCOUNT((thisform.xcurmpres))
					ivari=.text9.value
					ivarni=.text11.value
					totalri=.text18.value+.text9.value
					totalrni=.text18.value+.text9.value+.text11.value
					totsiva=.text18.value
				ENDWITH
				SET DECIMALS TO 3
				frmaltapr= conectar_db(_screen.cn)
					SQLEXEC(frmaltapr,"select a.*,b.*,c.*,d.cond_desc from presupuestos a inner join clientes b on a.cli_codi=b.cli_codi inner join iva c on c.iva_codi=a.iva_codi inner join condiva d on b.cond_codi=d.cond_codi where presup_codi=?xcodip;","cur_conpres")
					SQLEXEC(frmaltapr,"select a.loca_nomb,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on a.provi_codi=c.provi_codi where a.loca_codi=?cur_conpres.loca_codi;","cur_ubicli")
					SQLEXEC(frmaltapr,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dac_desc from presupuestos_articulos a INNER JOIN articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.presup_codi=?xcodip ORDER BY a.nro_regis;","cur_carpres")
				desconectar_db(frmaltapr)
				SET DECIMALS TO
				GO top
				_screen.numepres = thisform.npresup
				opcodi=''
				do form frm_imprimir with opcodi TO xopcodi		
				DO case
					CASE xopcodi.prop01='I'
						set point to ","
						report form presupuesto for cur_carpres.presup_codi=thisform.npresup TO PRINTER prompt noconsole
						SET POINT TO
					CASE xopcodi.prop01='E'
						thisform.excelautomatiz()
				ENDCASE
				IF _screen.callplanipre=1
					_screen.estamodipres=1
				ENDIF
				thisform.release
			endif
		ENDIF
	ENDPROC


	PROCEDURE Activate
		frmvalpend= conectar_db(_screen.cn)
			SQLEXEC(frmvalpend,"select * from parametros where param_codi=14;","cur_cotiz")
		desconectar_db(frmvalpend)
		
		IF RECCOUNT("cur_cotiz")>0
			thisform.lbl_actcoti.Caption="ACT.: "+ALLTRIM(TTOC(cur_cotiz.param_fechora))+"."
			thisform.text3.Value=cur_cotiz.param_impo
		ENDIF
		
		Cerrar_Cursor("cur_cotiz")
		
		
		
	ENDPROC

	PROCEDURE excelencabezado
		Xlsheet.cells(1,5)=ALLTRIM(thisform.empresa)
		XLSheet.Cells(1,5).font.bold=.T.
		XLSheet.Cells(1,5).font.size="12"
		XLSheet.Cells(1,5).font.name="Courier New"
		XLSheet.Cells(1,5).HorizontalAlignment=-4152
		
		Xlsheet.cells(3,5)='Fecha Actual: '+ALLTRIM(DTOC(DATE()))
		XLSheet.Cells(3,5).font.bold=.T.
		XLSheet.Cells(3,5).font.size="11"
		XLSheet.Cells(3,5).font.name="Courier New"
		XLSheet.Cells(3,5).HorizontalAlignment=-4152
		
		Xlsheet.range("B4:D4").merge
		Xlsheet.cells(4,2)="LISTADO VALORIZADO DE ARTÍCULOS"
		XLSheet.Cells(4,2).font.bold=.T.
		XLSheet.Cells(4,2).font.underline=.T.
		XLSheet.Cells(4,2).font.size="11"
		XLSheet.Cells(4,2).font.name="Cooper Black"
		XLSheet.range("B4:D4").HorizontalAlignment=7
		
		XLSheet.Cells(6,1)="CODIGO"
		XLSheet.Cells(6,1).font.bold=.T.
		XLSheet.Cells(6,1).font.size="11"
		XLSheet.Cells(6,1).font.name="Courier New"
		XLSheet.range("A6:A6").HorizontalAlignment=-4108
		XLSheet.Cells(6,2)="DESCRIPCION"
		XLSheet.Cells(6,2).font.bold=.T.
		XLSheet.Cells(6,2).font.size="11"
		XLSheet.Cells(6,2).font.name="Courier New"
		XLSheet.range("B6:B6").HorizontalAlignment=-4108
		XLSheet.Cells(6,3)="STOCK"
		XLSheet.Cells(6,3).font.bold=.T.
		XLSheet.Cells(6,3).font.size="11"
		XLSheet.Cells(6,3).font.name="Courier New"
		XLSheet.range("C6:C6").HorizontalAlignment=-4108
		XLSheet.Cells(6,4)="COSTO"
		XLSheet.Cells(6,4).font.bold=.T.
		XLSheet.Cells(6,4).font.size="11"
		XLSheet.Cells(6,4).font.name="Courier New"
		XLSheet.range("D6:D6").HorizontalAlignment=-4108
		XLSheet.Cells(6,5)="TOTAL"
		XLSheet.Cells(6,5).font.bold=.T.
		XLSheet.Cells(6,5).font.size="11"
		XLSheet.Cells(6,5).font.name="Courier New"
		XLSheet.range("E6:E6").HorizontalAlignment=-4108
		XLSheet.Range(XLSheet.Cells(6,1),XLSheet.Cells(6,5)).Borders.LineStyle=1
		XLSheet.Range(XLSheet.Cells(6,1),XLSheet.Cells(6,5)).Borders.Weight=2
		XLSheet.Range(XLSheet.Cells(6,1),XLSheet.Cells(6,5)).Interior.Color= RGB(192,192,192)
		XLSheet.Range(XLSheet.Cells(6,1),XLSheet.Cells(6,5)).AutoFilter
		
		return
	ENDPROC

	PROCEDURE excelfooter
		LPARAMETERS xInifil
		
		LOCAL fotfil,xini,xfin,rango
		
		fotfil = xInifil
		
		xini = "A"+ALLTRIM(STR(fotfil))
		xfin = "E"+ALLTRIM(STR(fotfil))
		rango= '"'+xini+':'+xfin+'"'
		XLSheet.range(&rango).Font.Size = "10"
		
		WITH XLSheet.RANGE(&rango)
		    .Borders(4).LineStyle = 1
		    .Borders(4).Weight = 1
		    .Borders(4).Color = RGB(0,0,0)
		ENDWITH
		
		XLSheet.Range(XLSheet.Cells(fotfil,1),XLSheet.Cells(fotfil,5)).Borders(4).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,1),XLSheet.Cells(fotfil,5)).Borders(4).Weight=3
		
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,3)='TOTAL VALORIZADO'
		WITH Xlsheet.range(XLSheet.Cells(fotfil,3),XLSheet.Cells(fotfil,3))
			.font.bold=.T.
			.Font.Size = "13"
			.HorizontalAlignment=-4152
		ENDWITH
		
		xini = "D"+ALLTRIM(STR(fotfil))
		xfin = "E"+ALLTRIM(STR(fotfil))
		rango= '"'+xini+':'+xfin+'"'
		XLSheet.range(&rango).Font.Size = "10"
		XLSheet.RANGE(&rango).merge
		XLSheet.Cells(fotfil,4).Font.Size = "13"
		XLSheet.Cells(fotfil,4).Font.bold=.T.
		XLSheet.Cells(fotfil,4) = thisform.text4.Value
		XLSheet.Cells(fotfil,4).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		
		RETURN
	ENDPROC

	PROCEDURE Init
		*!*	close all
		this.text1.value=0
		this.text2.value=99999999
		this.text3.value=0
		create cursor cantdolar(cantidad N(8))
		create cursor tempopesos(articulo N(8),descripcion C(45),stock N(15,3),costo N(15,3))
		create cursor tempodolar(articulo N(8),descripcion C(45),stock N(15,3),costo N(15,3))
		create cursor tempo(articulo N(8),descripcion C(45),stock N(15,3),costo N(15,3))
		create cursor tmpcosto(articulo N(8),descripcion C(45),stock N(15,3),costo N(15,3),costot N(15,2))
		create cursor total(valor N(15,2))
		
		frmlisval= conectar_db(_screen.cn)
			SQLEXEC(frmlisval,"select param_desc from parametros where param_codi = 13;","cur_emp")
		desconectar_db(frmlisval)
		
		IF USED("cur_emp")
			IF RECCOUNT("cur_emp") > 0
				thisform.empresa=cur_emp.param_desc
			ENDIF
			USE IN cur_emp
		ENDIF
		
		
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(215,215,215)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Command1.Click
		set dele on
		local codigo,cantdolar,dolar,xartdes,xarthas,xcaso
		codigo=0
		xcaso=0
		xartdes=thisform.text1.Value
		xarthas=thisform.text2.Value
		dolar=thisform.text3.value
		thisform.grid1.RecordSource=''
		thisform.grid1.Refresh()
		sele tmpcosto
		if reccount()>0
			set safety off
			zap
			set safety on
		ENDIF
		frmlisval= conectar_db(_screen.cn)
			SQLEXEC(frmlisval,"call usp_listvalart(1,?xartdes,?xarthas,?dolar);","tempopesos")
			SQLEXEC(frmlisval,"call usp_listvalart(2,?xartdes,?xarthas,?dolar);","tempodolar")
		desconectar_db(frmlisval)
		if reccount()>0 and thisform.text3.value=0
			=messagebox("Existen costos de artículos que están en Dólares"+chr(13)+ ;
						"Debe ingresar la cotización del Dolar al día de la Fecha",0+48,"Advertencia!!!")
			thisform.text3.setfocus
		else
			select * from tempopesos union select * from tempodolar into cursor tempo
			go top
			scan
				codigo=articulo
				insert into tmpcosto(articulo,descripcion,stock,costo,costot) ;
					values(tempo.articulo,tempo.descripcion,tempo.stock,tempo.costo,tempo.stock*tempo.costo)
				skip
				if articulo=codigo
					do while articulo=codigo
						skip
					enddo
					skip-1
				else
					skip-1
				endif
			endscan
			select ROUND(sum(stock*costo),2)valor from tmpcosto into cursor total
			thisform.text4.value=total.valor
			sele tmpcosto
			go top
			thisform.grid1.recordsource="tmpcosto"
			thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
			thisform.command2.Enabled=.T.
		endif
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		set point to ","
		set separator to "."
		sele tmpcosto
		go top
		IF thisform.chk_pant.Value=0
			report form listaval to printer prompt noconsole
		ELSE
			report form listaval preview noconsole
		ENDIF
		
		set point to
		set separator to
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		IF USED("tmpcosto")
			IF RECCOUNT("tmpcosto") > 0
				SELECT tmpcosto
				LOCATE
				local Fila,fpag,pagina,empresa,lnCantidadDatos,lnI,lnPorcentaje
		
				wait'Espere Un Momento Exportando Datos' window nowait
				_screen.mousepointer=11
				TmpSheet=GetObject('','Excel.Sheet')
				XLApp=TmpSheet.Application
				XLApp.workbooks.add()
				XLSheet=XLApp.ActiveSheet
				with XLSheet.PageSetup
					.Orientation = 1
					.LeftMargin = XLApp.InchesToPoints(0)
					.RightMargin = XLApp.InchesToPoints(0)
				    .TopMargin = XLApp.InchesToPoints(0)
				    .BottomMargin = XLApp.InchesToPoints(0)
				    .HeaderMargin = XLApp.InchesToPoints(0)
				    .FooterMargin = XLApp.InchesToPoints(0)
				    .Zoom=85
				ENDWITH
				XLSheet.Columns("A:A").ColumnWidth = 12.00
				XLSheet.Columns("B:B").ColumnWidth = 46.43
				XLSheet.Columns("C:C").ColumnWidth = 15.00
				XLSheet.Columns("D:D").ColumnWidth = 16.43
				XLSheet.Columns("E:E").ColumnWidth = 16.43
		
				thisform.excelencabezado()
		
				sele tmpcosto
				go top
				lnCantidadDatos=RECCOUNT("tmpcosto")
				Fila=7
				thisform.progreso.Visible= .T.
				FOR lnI = 1 TO lnCantidadDatos
				   	xini = "A"+ALLTRIM(STR(Fila))
				   	xfin = "E"+ALLTRIM(STR(Fila))
				   	rango= '"'+xini+':'+xfin+'"'
				   	XLSheet.range(&rango).Font.Size = "10"
				   	WITH XLSheet.RANGE(&rango)
					    .Borders(1).LineStyle = 1
					    .Borders(1).Weight = 1
					    .Borders(1).Color = RGB(185,185,185)
					    .Borders(2).LineStyle = 1
					    .Borders(2).Weight = 1
					    .Borders(2).Color = RGB(185,185,185)
					    .Borders(3).LineStyle = 1
					    .Borders(3).Weight = 1
					    .Borders(3).Color = RGB(185,185,185)
					    .Borders(4).LineStyle = 1
					    .Borders(4).Weight = 1
					    .Borders(4).Color = RGB(185,185,185)
					ENDWITH
					XLSheet.Cells(Fila,1)=tmpcosto.articulo
					XLSheet.Cells(Fila,1).NUMBERFORMAT="00000000"
				   	XLSheet.Cells(Fila,1).HorizontalAlignment=-4108
				   	XLSheet.Cells(Fila,2)=tmpcosto.descripcion
				   	XLSheet.Cells(Fila,3)=tmpcosto.stock
				   	XLSheet.Cells(Fila,3).NUMBERFORMAT="0.000"
				   	XLSheet.Cells(Fila,4)=tmpcosto.costo
				   	XLSheet.Cells(Fila,5)=tmpcosto.costot
		  			XLSheet.Cells(Fila,4).NUMBERFORMAT="_-[$$-es-AR] * #,###0.000"
		  			XLSheet.Cells(Fila,5).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
				   	Fila=Fila+1
				   	
					lnPorcentaje            = lnI * 100 / lnCantidadDatos
				    ThisForm.Progreso.Value = lnPorcentaje
				    skip		   	
				ENDFOR
				Fila=Fila-1
				thisform.excelfooter(Fila)
				thisform.progreso.Visible= .F.
				XLApp.visible=.T.
				XLApp.WindowState = -4137
				DECLARE LONG BringWindowToTop IN "user32" LONG HWND
				BringWindowToTop(XLApp.HWND)
				_screen.mousepointer=0
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text3.Click
		this.setfocus
	ENDPROC

ENDDEFINE

	PROCEDURE grd_cbtes.Column9.Check1.Click
		LOCAL cantsel,ubireg
		cantsel=0
		ubireg=0
		
		SELECT cur_compp
		ubireg=RECNO()
		LOCATE
		COUNT ALL FOR comp_sel=.T. TO cantsel
		GO ubireg
		
		IF cantsel>0
			thisform.command2.Enabled= .T.
		*!*		thisform.estadosel=1
		ELSE
			thisform.command2.Enabled= .F.
		*!*		thisform.estadosel=0
		ENDIF
	ENDPROC

	PROCEDURE Olecontrol1.Click
		*** ActiveX Control Event ***
		*!*	thisform.command4.enabled=.F.
		*!*	if this.rows>1
		*!*		this.col=0
		*!*		sele tipospago
		*!*		set order to tippag_des
		*!*		seek allt(this.text)
		*!*		coditipag=tippag_codi	
		*!*		this.col=1
		*!*		numero=allt(this.text)
		*!*		this.col=2
		*!*		cuit=val(substr(allt(this.text),1,2)+substr(allt(this.text),4,8)+substr(allt(this.text),13,1))
		*!*		this.col=3
		*!*		banco=allt(this.text)
		*!*		this.col=4
		*!*		plaza=allt(this.text)
		*!*		this.col=5
		*!*		fechavto=ctod(this.text)
		*!*		this.col=6
		*!*		valor=val(this.text)
		*!*		totval=totval-valor
		*!*		do form pagopreg with coditipag,numero,banco,plaza,fechavto,valor,totval,impotot,cuit
		*!*	endif
		*!*	if paso=1
		*!*		this.col=0
		*!*		sele tipospago
		*!*		set order to tippag_cod
		*!*		seek coditipag
		*!*		this.text=allt(subst(tippag_desc,1,13))
		*!*		this.col=1
		*!*		this.text=allt(numero)
		*!*		this.col=2
		*!*		if coditipag=3
		*!*			cadenacuit=subst(str(cuit,11),1,2)+"-"+subst(str(cuit,11),3,8)+"-"+right(str(cuit,11),1)
		*!*		else
		*!*			cadenacuit=""
		*!*		endif
		*!*		this.text=cadenacuit
		*!*		this.col=3
		*!*		this.text=allt(banco)
		*!*		this.col=4
		*!*		this.text=allt(plaza)
		*!*		this.col=5
		*!*		this.text=dtoc(fechavto)
		*!*		this.col=6
		*!*		this.text=allt(str(valor,10,2))
		*!*	endif
		*!*	if borra=6
		*!*		this.col=5
		*!*		totval=totval-val(this.text)
		*!*		this.removeitem(this.row)
		*!*		thisform.command3.click()
		*!*	endif
		*!*	if paso=1 or borra=6
		*!*		paso=0
		*!*		borra=0
		*!*		do while totval<thisform.text7.value
		*!*			do form datospago with coditipag,numero,banco,plaza,fechavto,valor,totval,impotot
		*!*			if coditipag=0
		*!*				thisform.command1.click()
		*!*				exit
		*!*			endif
		*!*			sele tipospago
		*!*			set order to tippag_cod
		*!*			seek coditipag
		*!*			if coditipag=3
		*!*				cadenacuit=subst(str(cuit,11),1,2)+"-"+subst(str(cuit,11),3,8)+"-"+right(str(cuit,11),1)
		*!*			else
		*!*				cadenacuit=""
		*!*			endif
		*!*			thisform.olecontrol1.additem(allt(subst(tippag_desc,1,13))+chr(9)+allt(numero)+chr(9)+allt(cadenacuit)+chr(9)+allt(banco)+chr(9)+allt(plaza)+chr(9)+dtoc(fechavto)+chr(9)+allt(str(valor,10,2))+chr(9)+iif(nalo=.T.,"N",""))
		*!*		enddo
		*!*		if totval=thisform.text7.value
		*!*			thisform.command4.enabled=.T.
		*!*		endif
		*!*	endif
		
	ENDPROC

	PROCEDURE Text22.Click
		if this.value=0
			this.value=thisform.text21.value
		endif
		this.setfocus
	ENDPROC

	PROCEDURE Text22.GotFocus
		set point to
		
	ENDPROC

	PROCEDURE Text22.LostFocus
		do case
			case this.value>cur_per.per_afvor
				=messagebox("No puede ingresar un valor mayor al saldo a favor",0+48,"Cobranzas")
				nodefault
			case this.value=0
				pp=messagebox("Quedará el total del saldo a favor. ¿Continúa igualmente?",4+48+256,"Cobranzas")
				if pp=7
					this.value=thisform.text21.value
					nodefault
				else
					thisform.text16.value=-this.value
					thisform.text14.value=thisform.text7.value+thisform.text16.value
					thisform.command9.enabled=.F.
				endif
			case this.value<thisform.text21.value and this.value>0
				pp=messagebox("Quedará aún saldo a favor. ¿Continúa igualmente?",4+48+256,"Cobranzas")
				if pp=7
					this.value=cur_per.per_afvor
					nodefault
				else
					thisform.text16.value=-this.value
					thisform.text14.value=thisform.text7.value+thisform.text16.value
					thisform.command9.enabled=.F.
				endif
			case this.value<0
				=messagebox("Imposible ingresar un valor negativo",0+48,"Cobranzas")
				this.value=thisform.text21.value
				nodefault
			otherwise
				thisform.text16.value=-this.value
				thisform.text14.value=thisform.text7.value+thisform.text16.value
				thisform.command9.enabled=.F.
		endcase
		set point to ","
		
	ENDPROC

ENDDEFINE

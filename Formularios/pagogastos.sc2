	ENDPROC

	PROCEDURE Destroy
		SET POINT TO thisform.xpoint
		SET SEPARATOR TO thisform.xsepar
		
		_screen.tipopago = ""
	ENDPROC

	PROCEDURE GotFocus
		set point to ","
		set separator to "."
	ENDPROC

	PROCEDURE grid_dblclick
		LOCAL codif
		codif=0
		
		IF cur_compp.comp_codi>0
			DO CASE
				CASE ALLTRIM(cur_compp.comp_cbte)="DIC"
					pasdic=1
					debintpro=cur_compp.comp_codi
					DO FORM consdebintgas with debintpro
				CASE ALLTRIM(cur_compp.comp_cbte)="CIC"
					pasdic=1
					creintpro=cur_compp.comp_codi
					DO FORM conscreintgas with creintpro
			OTHERWISE
				codif=cur_compp.comp_codi
				do form consgastos with codif
			ENDCASE
		ENDIF
	ENDPROC

	PROCEDURE grid_rightclick
		local par,nregis,xsalant,xreco
		par=7
		do case
			case ALLTRIM(cur_compp.comp_cbte)="NCA" or ALLTRIM(cur_compp.comp_cbte)="NCB" or ALLTRIM(cur_compp.comp_cbte)="CIC"
				par=messagebox("¿Descuento parcial de este comprobante?",4+32+256,"Pagos")
		otherwise
			par=messagebox("¿Pago parcial de este comprobante?",4+32+256,"Pagos")
		endcase
		if par=6
			nregis=cur_compp.comp_regis
			impcbte=comp_deu
			thisform.xpoint = SYS(2001,"point")
			thisform.xsepar = SYS(2001,"separator")
			do form parcob with impcbte
			SET POINT TO thisform.xpoint
			SET SEPARATOR TO thisform.xsepar
			SELECT cur_compp
			do case
				case impcbte=comp_deu
					thisform.insercbte(impcbte)
					DELETE FROM cur_compp WHERE comp_regis = nregis
				case impcbte<comp_deu
					thisform.insercbte(impcbte)
					REPLACE comp_pag WITH comp_pag+impcbte
					REPLACE comp_deu WITH comp_deu-impcbte
					SELECT cur_compp
					GO top
					xreco=1
					SCAN
						IF xreco=1
							REPLACE comp_sal WITH comp_deu
						ELSE
							SKIP -1
							xsalant=comp_sal
							SKIP
							REPLACE comp_sal WITH xsalant+comp_deu
						ENDIF
						xreco=xreco+1
					ENDSCAN
					GO nregis
				case impcbte<0 and impcbte>comp_deu
					thisform.insercbte(impcbte)
					REPLACE comp_pag WITH comp_pag+impcbte
					REPLACE comp_deu WITH comp_deu-impcbte
					this.selected(n)=.F.
					SELECT cur_compp
					GO top
					xreco=1
					SCAN
						IF xreco=1
							REPLACE comp_sal WITH comp_deu
						ELSE
							SKIP -1
							xsalant=comp_sal
							SKIP
							REPLACE comp_sal WITH xsalant+comp_deu
						ENDIF
						xreco=xreco+1
					ENDSCAN
					GO nregis
			endcase
			parcial=.F.
			thisform.grd_cbtes.Refresh
		endif
		sele totalcbtes
		go top
		if reccount()>0 and thisform.text7.value=0
			thisform.command4.enabled=.T.
		endif
	ENDPROC

	PROCEDURE Init
		public codiper,coditipag,numero,banco,plaza,fechavto,valor,totval,cond, ;
		       valoriva,borra,impotot,contador,codrec,paso,importe,vuelto,totalfac,confirma, ;
		       totcred,totdeb,totsiv,pregsaldo,cuit,codrecpag,auxiliar,coef,coefc,paso,reini,obser,hayfac,parcial,s,cancelado,difesaf, ;
		       dxp,dxpo,dtotot,porcdesc,matcom,auxmatcom,p,impiva1,impiva2,pasop,idcheq
		set dele on
		thisform.xpoint = SYS(2001,"point")
		thisform.xsepar = SYS(2001,"separator")
		set point to ","
		set separator to "."
		set exact off
		set date british
		set cent on
		CREATE CURSOR cur_compp(comp_fec D,comp_cbte C(3),comp_pv N(3),comp_nro N(8),comp_tot N(15,2),comp_pag N(15,2),comp_deu N(15,2),comp_sal N(15,2),comp_sel L,comp_codi N(8),comp_regis N(5))
		create cursor fac(gas_fech D,gas_codi N(8),gas_tipo C(2),gas_pto N(4),gas_fac N(8),imp_pag N(15,2),gas_conc C(1),total N(15,2))
		create cursor sic(sini_fech D,sini_cod N(8),per_sal N(15,2),sini_pag N(15,2))
		create cursor dig(debg_fech D,debg_codi N(8),debg_tot N(15,2),debg_impag N(15,2))
		create cursor cig(creg_fech D,creg_codi N(8),creg_tot N(15,2),creg_impag N(15,2))
		create cursor facsig(gas_codi N(8),sini_cod N(8),debg_codi N(8),creg_codi N(8),facsig_fec D)
		
		create cursor totalcbtes(conc C(3),punto N(4),numero N(8),impabona N(15,2),parcial L,gas_codi N(8))
		create cursor totregis(instancia N(2),pagg_codi N(8),gas_codi N(8),sini_cod N(8),debg_codi N(8),creg_codi N(8),sa C(1),paggas_impo N(15,2),pagg_fech D, ;
		                       per_codi N(8),pagg_dtosaf N(15,2),pagg_antic N(15,2),pagg_restsaf N(15,2),pagsini_cod N(8),paggcrei_cod N(8), ;
		                       gas_conc C(2),gas_tipfac C(1),gas_pto N(4),gas_fac N(8),gas_fech D,sini_fech D,debg_fech D,creg_fech D,paggas_parci N(1), ;
		                       pagsini_parci N(1),pagdebi_parci N(1),paggcrei_parci N(1),pagpag_codi N(8),paggas_codi N(8),tippag_codi N(8), ;
		                       tippag_desc C(25),movtippag_nro C(14),ban_codi N(8),ban_desc C(45),ban_cuit N(11),movtippag_pza C(25), ;
		                       movtippag_fvto D,movtippag_imp N(15,2),cuit_lib N(11),parcial N(1))
		
		
		index on instancia to SYS(2015)
		create cursor cheq(recpag_codi N(8)) 
		dimension matcom(1,4)
		dimension auxmatcom(1,4)
		
		STORE 0 TO pasop,matcom,auxmatcom,coef,vuelto,codiper,coditipag,valor,totval,borra,importe,totalfac,totcred,totdeb,totsiv,pregsaldo,cuit,codrecpag, ;
				   auxiliar,paso,contador,difesaf,dxp,dxpo,dtotot,porcdesc,rpgcodi,rpgcodig
		STORE "" TO idcheq,numero,banco,plaza,obser
		
		s=1                   
		reini=.F.                       
		fechavto=ctod("  /  /    ")
		hayfac="S"
		parcial=.F.
		confirma="N"
		cancelado="N"
		frmpagpro= conectar_db(_screen.cn)
			SQLEXEC(frmpagpro,"select * from iva order by iva_codi desc limit 1;","cur_iva")
		desconectar_db(frmpagpro)
		IF RECCOUNT("cur_iva")>0
			codiva=cur_iva.iva_codi
			impiva1=cur_iva.iva_1
			impiva2=cur_iva.iva_2
		ENDIF
		with this
			.text2.value=0
			.text3.value=0
			.text4.value=0
			.text5.value=0
			.text7.value=0
			.text14.value=0
			.text16.value=0
		ENDWITH
		do form perload with codiper
		IF codiper>0
			pasop=1
		*!*		declare matcli[1]
			declare matfac[1]
		*!*		store 0 to matcli
			store 0 to matfac
			frmpagpro= conectar_db(_screen.cn)
				SQLEXEC(frmpagpro,"select cli_codi from clientes where cli_cuit=?VAL(cur_per.per_cuit);","cur_cuit")
				IF RECCOUNT("cur_cuit")>0
					SQLEXEC(frmpagpro,"select fac_codi,(fac_ng+neto_1+neto_2+fac_ivari+fac_ivarni)-imp_pag from facturas where cli_codi=?cur_cuit.cli_codi and anulado<>'S' and pagado<>'S' order by fac_fec;","cur_mfac")
					IF RECCOUNT("cur_mfac")>0
					   GO top
					   SELECT * FROM cur_mfac into array matfac
						if matfac>0
							=messagebox("ESTE PROVEEDOR ADEUDA FACTURAS EN CALIDAD DE CLIENTE.",0+48,"ATENCIÓN!!!")
						ENDIF
					ENDIF
				ENDIF
			desconectar_db(frmpagpro)
		
			with thisform
				.text13.value=date()
				.text7.value=0
				.text14.value=0
				.text1.value=cur_per.per_desc
		
				cuit=VAL(cur_per.per_cuit)
				cond=cur_per.cond_codi
				frmpagpro= conectar_db(_screen.cn)
					SQLEXEC(frmpagpro,"call usp_pgfacimp(?codiper);","fac")
					index on gas_codi to SYS(2015)
		
					SQLEXEC(frmpagpro,"SELECT sini_fech,sini_cod,per_sal,sini_pag FROM saldosiniper WHERE pagado<>'S' AND anulado<>'S' AND per_codi=?codiper order by sini_cod;","sic")
					index on sini_cod to SYS(2015)
		
					SQLEXEC(frmpagpro,"SELECT debg_fech,debg_codi,debg_tot,debg_impag FROM debintg WHERE pagado<>'S' AND per_codi=?codiper order by debg_codi;","dig")
					index on debg_codi to SYS(2015)
		
					SQLEXEC(frmpagpro,"SELECT creg_fech,creg_codi,creg_tot,creg_impag FROM creintg WHERE pagado<>'S' AND per_codi=?codiper order by creg_codi;","cig")
					index on creg_codi to SYS(2015)			
				desconectar_db(frmpagpro)
		
				sele fac
				go top
				scan
					insert into facsig(gas_codi,sini_cod,debg_codi,creg_codi,facsig_fec) ;
								values(fac.gas_codi,0,0,0,fac.gas_fech)
				endscan
				sele sic
				go top
				scan
					insert into facsig(gas_codi,sini_cod,debg_codi,creg_codi,facsig_fec) ;
								values(0,sic.sini_cod,0,0,sic.sini_fech)
				endscan
				sele dig
				go top
				scan
					insert into facsig(gas_codi,sini_cod,debg_codi,creg_codi,facsig_fec) ;
								values(0,0,dig.debg_codi,0,dig.debg_fech)
				ENDSCAN
				sele cig
				go top
				scan
					insert into facsig(gas_codi,sini_cod,debg_codi,creg_codi,facsig_fec) ;
								values(0,0,0,cig.creg_codi,cig.creg_fech)
				endscan		
				sele facsig
				index on facsig_fec to SYS(2015)
				set rela to gas_codi into fac addi
				set rela to sini_cod into sic addi
				set rela to debg_codi into dig addi
				set rela to creg_codi into cig addi
		
				sele fac
				go top
				sele sic
				go top
				sele dig
				go top
				sele cig
				go top		
				sele facsig
				go top
				i=1
				LOCAL xfec,xcbte,xpv,xnro,xtot,xpag,xdeu,xsal,xcodc,xregis
				xregis=1		
				scan
					xfec=facsig_fec
					if gas_codi>0
						do case
							case fac.gas_conc="F"
								do case
									case fac.gas_tipo="A"
										xcbte="FA"
									case fac.gas_tipo="B"
										xcbte="FB"
									case fac.gas_tipo="C"
										xcbte="FC"
								endcase
							case fac.gas_conc="N"
								do case
									case fac.gas_tipo="A"
										xcbte="NCA"
									case fac.gas_tipo="B"
										xcbte="NCB"
									case fac.gas_tipo="C"
										xcbte="NCC"
								endcase
							case fac.gas_conc="D"
								do case
									case fac.gas_tipo="A"
										xcbte="NDA"
									case fac.gas_tipo="B"
										xcbte="NDB"
									case fac.gas_tipo="C"
										xcbte="NDC"
								endcase
						endcase
					else
						DO CASE
							CASE sini_cod>0
								xcbte="SIC"
							CASE debg_codi>0
								xcbte="DIC"
							CASE creg_codi>0
								xcbte="CIC"
						ENDCASE
					endif
					xpv=iif(gas_codi>0,fac.gas_pto,0)
					xnro=iif(gas_codi>0,fac.gas_fac,IIF(sini_cod>0,sic.sini_cod,IIF(dig.debg_codi>0,dig.debg_codi,cig.creg_codi)))
					xtot=iif(gas_codi>0,fac.total,IIF(sini_cod>0,sic.per_sal,IIF(dig.debg_codi>0,dig.debg_tot,cig.creg_tot)))
					xpag=iif(gas_codi>0,fac.imp_pag,IIF(sini_cod>0,sic.sini_pag,IIF(dig.debg_codi>0,dig.debg_impag,cig.creg_impag)))
					xdeu=iif(gas_codi>0,fac.total-fac.imp_pag,IIF(sini_cod>0,sic.per_sal-sic.sini_pag,IIF(dig.debg_codi>0,dig.debg_tot-dig.debg_impag,cig.creg_tot-cig.creg_impag)))
		
					if fac.gas_conc="N" OR facsig.creg_codi>0
						xtot=xtot*(-1)
						xpag=xpag*(-1)
						xdeu=xdeu*(-1)
					endif
					if i=1
						xsal=xdeu
					else
						xsal=xsal+xdeu
					ENDIF
					xcodc=IIF(gas_codi>0,gas_codi,IIF(debg_codi>0,debg_codi,creg_codi))
					INSERT INTO cur_compp values(xfec,xcbte,xpv,xnro,xtot,xpag,xdeu,xsal,.F.,xcodc,xregis)
					xregis=xregis+1			
					i=i+1
				ENDSCAN
				GO TOP IN cur_compp
				thisform.grd_cbtes.RecordSource="cur_compp"
				thisform.grd_cbtes.SetAll("DynamicForeColor", ;
						                  "iif(cur_compp.comp_deu<0,iif(cur_compp.comp_sel=.T.,RGB(0,255,0),RGB(255,0,0)),iif(cur_compp.comp_sel=.T.,RGB(255,255,255),RGB(0,0,0)))", ;
						                  "Column")
				thisform.grd_cbtes.SetAll("DynamicBackColor","iif(cur_compp.comp_sel=.T.,RGB(0,120,215),RGB(255,255,255))","Column")
				thisform.grd_cbtes.COLUMN9.DynamicBackColor='RGB(118,157,173)'
				GO BOTTOM in cur_compp
				.text18.value= cur_compp.comp_sal &&ConverNro(.list1.list(.list1.listcount,8))
				GO TOP IN cur_compp
				.text19.value=cur_per.per_afvor
				.text20.value=.text18.value-.text19.value
				.text21.value=cur_per.per_afvor
				.text22.value=cur_per.per_afvor
				if cur_per.per_afvor=0
					.text22.enabled=.F.
				else
					.command9.enabled=.T.
				endif
				if RECCOUNT("cur_compp")>0
					thisform.command5.enabled=.T.
				endif
			ENDWITH
		
			FOR ncol=1 TO 8
				xsource="Thisform.grd_cbtes.column"+ALLTRIM(STR(ncol))+".text1"
				BINDEVENT(&xsource,"DblClick",Thisform,"Grid_DblClick")
				BINDEVENT(&xsource,"RightClick",Thisform,"Grid_RightClick")
			NEXT ncol	
		endif
	ENDPROC

	PROCEDURE insercbte
		LPARAMETERS nvalcob
		
		LOCAL regact
		
		sele totalcbtes
		locate for ALLTRIM(conc)+ALLTRIM(STR(numero))=ALLTRIM(cur_compp.comp_cbte)+ALLTRIM(STR(cur_compp.comp_nro))
		if found()
			regact=RECNO("totalcbtes")
			update totalcbtes set impabona=impabona+nvalcob WHERE ;
					ALLTRIM(cur_compp.comp_cbte)+ALLTRIM(STR(cur_compp.comp_nro))=ALLTRIM(conc)+ALLTRIM(STR(numero))
			GO regact
		else
			insert into totalcbtes(conc,punto,numero,impabona,gas_codi) ;
			  values(allt(cur_compp.comp_cbte),cur_compp.comp_pv,cur_compp.comp_nro, ;
			  		 nvalcob,cur_compp.comp_codi)
		ENDIF
		
		if nvalcob=cur_compp.comp_deu
			update totalcbtes set parcial=.F. where ;
					ALLTRIM(cur_compp.comp_cbte)+ALLTRIM(STR(cur_compp.comp_nro))=ALLTRIM(conc)+ALLTRIM(STR(numero))
		ELSE
			update totalcbtes set parcial=.T. where ;
					ALLTRIM(cur_compp.comp_cbte)+ALLTRIM(STR(cur_compp.comp_nro))=ALLTRIM(conc)+ALLTRIM(STR(numero))
		endif
		
		thisform.text7.value=thisform.text7.value+nvalcob
		thisform.text14.value=thisform.text7.value+thisform.text16.value
		
		SELECT cur_compp
		
		RETURN
	ENDPROC

	PROCEDURE LostFocus
		set point to
		set separator to
	ENDPROC

	PROCEDURE Command1.Click
		pregunta=messagebox("¿Seguro que desea salir?",4+48+256,"Advertencia")
		do case
			case pregunta=6
				thisform.release
			case pregunta=7
				if totval<thisform.text14.value
					thisform.command3.click()
				endif
		endcase
	ENDPROC


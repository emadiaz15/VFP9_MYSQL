		do form observpago with obser
	ENDPROC

	PROCEDURE Command10.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.fontsize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command10.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.fontsize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		LOCAL regact,xreco
		thisform.grd_cbtes.RecordSource=''
		thisform.grd_cbtes.Refresh
		with thisform
			SELECT cur_compp
			GO top
			SCAN
				IF comp_sel = .T.
					thisform.insercbte(comp_deu)
				ENDIF
			ENDSCAN
			DELETE FROM cur_compp WHERE comp_sel=.T.
			GO top
			xreco=1
			SCAN
				IF xreco=1
					REPLACE comp_sal WITH comp_deu
				ELSE
					SKIP -1
					xsalant=comp_sal
					SKIP
					REPLACE comp_sal WITH xsalant+comp_deu
				ENDIF
				xreco=xreco+1
			ENDSCAN
			GO TOP IN cur_compp
			thisform.grd_cbtes.RecordSource="cur_compp"
			thisform.grd_cbtes.Refresh
			this.Enabled=.F.
			sele totalcbtes
			go top
			if reccount()>0 and .text7.value=0
				.command4.enabled=.T.
			ENDIF
		endwith
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.fontsize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.fontsize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		with thisform
			LOCAL hayefvo,contfil
			contfil=1
			hayefvo=0
			thisform.grd_cbtes.Enabled= .F.
			.command2.enabled=.F.
			.command5.enabled=.F.
			valor=.text14.value
			impotot=valor
			do while confirma="N"
				set point to "."
				do form datospagogas with coditipag,numero,banco,plaza,fechavto,valor,totval,impotot,cuit,dxp,dxpo,dtotot,porcdesc,rpgcodi,rpgcodig
				if confirma="S"
					if cancelado="S"
						.height=336
		               if .olecontrol1.rows>1
							x=1
							do while .olecontrol1.rows>2
								.olecontrol1.removeitem(x)
							enddo
							.olecontrol1.col=0
							.olecontrol1.text=" "
							.olecontrol1.col=1
							.olecontrol1.text=" "
							.olecontrol1.col=2
							.olecontrol1.text=" "
							.olecontrol1.col=3
							.olecontrol1.text=" "
							.olecontrol1.col=4
							.olecontrol1.text=" "
							.olecontrol1.col=5
							.olecontrol1.text=" "
							.olecontrol1.col=6
							.olecontrol1.text=" "
							confirma="N"
							cancelado="N"
							totval=0
							paso=1
						endif
					else
						.text2.value=totval
						.text3.value=impotot-totval
						.text4.value=dtotot
						.text5.value=.text14.value
						.shape4.visible=.T.
						.label3.visible=.T.
						.label4.visible=.T.
						.label10.visible=.T.
						.label13.visible=.T.
						.text2.visible=.T.
						.text3.visible=.T.
						.text4.visible=.T.
						.text5.visible=.T.
						.autocenter=.T.
						.command4.enabled=.T.
						IF .text3.value<0
							MESSAGEBOX("El detalle de pagos ingresados es mayor al total de los comprobantes, ésto generará un saldo a nuestro favor en el Proveedor, verfique si ésta información es correcta",0+64,"Aviso del Sistema")
						ENDIF
					endif
					exit
				endif
				set point to ","
				frmpagpro= conectar_db(_screen.cn)
					SQLEXEC(frmpagpro,"select * from tipospago where tippag_codi=?coditipag;","cur_tpp")
				desconectar_db(frmpagpro)
				if coditipag=3 OR coditipag=20
					cadenacuit=subst(str(cuit,11),1,2)+"-"+subst(str(cuit,11),3,8)+"-"+right(str(cuit,11),1)
				else
					cadenacuit=""
				ENDIF
				IF coditipag=1
					FOR contfil=1 TO .olecontrol1.rows-1
						.olecontrol1.row=contfil
						.olecontrol1.col=0
						IF ALLTRIM(.olecontrol1.text)="EFECTIVO"
							hayefvo=1
							exit
						ENDIF
					NEXT contfil
				ENDIF
				if coditipag=3 OR coditipag=20
					insert into cheq(recpag_codi) values(rpgcodig)
				endif
				if coditipag=13
					if matcom>0
						for fff=1 to alen(matcom,1)
							.olecontrol1.additem(allt("FACTURA"+chr(9)+allt(matcom[fff,2])+chr(9)+""+chr(9)+""+chr(9)+""+chr(9)+dtoc(matcom[fff,3])+chr(9)+allt(str(matcom[fff,4],15,2))+chr(9)+"P"+CHR(9)+""))
							thisform.alineagrid()
						next fff
						DIMENSION matcom(1,4)
						matcom=0
					endif
				ELSE
					IF hayefvo=1
						.olecontrol1.row=contfil
						.olecontrol1.col=6
						.olecontrol1.text=ALLTRIM(STR(ConverNro(.olecontrol1.text)+valor,15,2))
						hayefvo=0
					ELSE
						.olecontrol1.additem(allt(tippag_desc)+chr(9)+allt(numero)+chr(9)+allt(cadenacuit)+chr(9)+allt(banco)+chr(9)+allt(plaza)+chr(9)+ ;
											 dtoc(fechavto)+chr(9)+allt(str(valor,15,2))+chr(9)+""+CHR(9)+IIF(coditipag=3 OR coditipag=20,ALLTRIM(STR(rpgcodig)),""))
						** idcheq
					ENDIF
				ENDIF
				thisform.grd_cbtes.ReadOnly= .T.
				.olecontrol1.col=7
				.olecontrol1.row=.olecontrol1.rows-1
				if coditipag=3 OR coditipag=20
					if p=6
						.olecontrol1.text="T"
					else
						.olecontrol1.text="P"
					endif
				else
					.olecontrol1.text="P"
				ENDIF
				thisform.alineagrid()
		ENDDO
		thisform.lbl_totval.Caption='Total de Valores Ingresados: $ '+ALLTRIM(STR(totval,15,2))
		.height=550
		.autocenter=.T.
		endwith
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.fontsize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.fontsize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		local cr,cs,lcletra,letra,rfcc,acung,acuneto1,acuneto2,acuivari,acuivarni,totales,codpag
		local texban,texsuc,sicdeuda,sicneto,siciva,xrpc
		
		store 0 to acung,acuneto1,acuneto2,acuivari,acuivarni,totales,xrpc
		
		pregunta=messagebox("¿Confirma el pago ingresado?",4+32+256,"Pagos a Proveedores")
		if pregunta=6
			LOCAL xfec,xpimpo,xdtopag,xtsaf,xpant,xdtosaf,xrstsaf,ximporte, ;
				  ximprec,xparec,xsuc,xnro,xcheq,xcuitl,xpza,xfvto,xmimp,xbdesc,xcuitb,xcheqid
			STORE 0 TO xpimpo,xdtopag,xtsaf,xpant,xpantxrstsaf,ximporte,ximprec,xsuc,xcuitl,xmimp,xcuitb
			STORE '' TO xnro,xcheq,xpza,xbdesc,xcheqid
		
			with thisform
				frmpagpro= conectar_db(_screen.cn)
					SQLEXEC(frmpagpro,"select MAX(pagg_codi) as pagg_codi from pagosgas order by pagg_codi;","cur_npag")
				desconectar_db(frmpagpro)
				IF ISNULL(cur_npag.pagg_codi)
					codpag=1
				ELSE
					codpag=cur_npag.pagg_codi+1
				ENDIF
				xfec=.text13.value
				if .text3.value<0 and .text7.value=0
					xpimpo=0
				else
					xpimpo=.text14.value
					if dtotot>0
						xdtopag=dtotot
					endif
				endif
				if .text3.value<0
					if .text21.value>0
						xtsaf=(.text21.value+abs(.text3.value))-abs(.text16.value)
					endif
					xpant=abs(.text3.value)
				endif	
				if .text16.value<0
					xdtosaf=abs(.text16.value)
					xrstsaf=.text21.value+.text16.value
				endif
				frmpagpro= conectar_db(_screen.cn)
					SQLEXEC(frmpagpro,"insert into pagosgas values(?codpag,?xfec,?xpimpo,0,?codiper,?ALLTRIM(obser),?xpant,?xdtosaf,?xdtopag,?xrstsaf,0);")
				desconectar_db(frmpagpro)
				insert into totregis(instancia,pagg_codi,pagg_fech,per_codi);
					values(1,codpag,.text13.value,codiper)
				acu=0
				sele totalcbtes
				go top
				scan
					do case
						case allt(conc)="SIC"
							frmpagpro= conectar_db(_screen.cn)
								SQLEXEC(frmpagpro,"select MAX(pagsini_cod) as pagsini_cod from pagos_saldosiniper order by pagsini_cod;","cur_nps")
								IF ISNULL(cur_nps.pagsini_cod)
									cs=1
								ELSE
									cs=cur_nps.pagsini_cod+1
								ENDIF
								SQLEXEC(frmpagpro,"update saldosiniper set sini_pag=sini_pag+?totalcbtes.impabona where sini_cod=?totalcbtes.numero;")
								SQLEXEC(frmpagpro,"select * from saldosiniper where sini_cod=?totalcbtes.numero;","cur_sini")
								do case
									case cur_sini.per_sal>0
										if cur_sini.sini_pag>=cur_sini.per_sal
											SQLEXEC(frmpagpro,"update saldosiniper set pagado='S' where sini_cod=?totalcbtes.numero;")
										endif
									case cur_sini.per_sal<0
										if abs(cur_sini.sini_pag)>=abs(cur_sini.per_sal)
											SQLEXEC(frmpagpro,"update saldosiniper set pagado='S' where sini_cod=?totalcbtes.numero;")
										endif
								ENDCASE
								ximprec=totalcbtes.impabona
		*!*							if hayfac="S"
								if totalcbtes.parcial=.T.
									xparec=1
		*!*									sele totregis
		*!*									repla pagsini_cod with cs
								ELSE
									xparec=0
								ENDIF
								SQLEXEC(frmpagpro,"insert into pagos_saldosiniper values(?cs,?codpag,?cur_sini.sini_cod,?ximprec,?xparec);")
								insert into totregis(instancia,sini_cod,sini_fech,pagsini_cod,paggas_impo,pagsini_parci) ;
										values(1,cur_sini.sini_cod,cur_sini.sini_fech,cs,ximprec,xparec)
		*!*							ENDIF
							desconectar_db(frmpagpro)
						case allt(conc)="DIC"
							STORE 0 TO xcod,ximp,xparci
							frmpagpro= conectar_db(_screen.cn)
								SQLEXEC(frmpagpro,"select MAX(pagdebi_cod) as pagdebi_cod from pagosgas_debintg order by pagdebi_cod;","cur_rd")
								IF ISNULL(cur_rd.pagdebi_cod)
									cs=1
								else
									cs=cur_rd.pagdebi_cod+1
								ENDIF
								xcod=totalcbtes.numero
								ximp=totalcbtes.impabona
								SQLEXEC(frmpagpro,"update debintg set debg_impag=debg_impag+?ximp where debg_codi=?xcod;")
								SQLEXEC(frmpagpro,"select * from debintg where debg_codi=?xcod;","cur_debc")
								if hayfac="S"
									if totalcbtes.parcial=.T.
										xparci=1
										sele totregis
										repla pagdebi_cod with cs
									ENDIF
									SQLEXEC(frmpagpro,"insert into pagosgas_debintg values(?cs,?codpag,?xcod,?ximp,?xparci);")
									insert into totregis(instancia,debg_codi,debg_fech,pagdebi_cod,paggas_impo,pagdebi_parci) ;
											values(1,xcod,cur_debc.debg_fech,cs,totalcbtes.impabona,IIF(totalcbtes.parcial=.T.,1,0))
								ENDIF
				
								IF RECCOUNT("cur_debc")>0
									if cur_debc.debg_impag>=cur_debc.debg_tot
										SQLEXEC(frmpagpro,"update debintg set pagado='S' where debg_codi=?xcod;")
									endif
								ENDIF
							desconectar_db(frmpagpro)
						case allt(conc)="CIC"
							STORE 0 TO xcod,ximp,xparci
							frmpagpro= conectar_db(_screen.cn)
								SQLEXEC(frmpagpro,"select MAX(paggcrei_cod) as paggcrei_cod from pagosgas_creintg order by paggcrei_cod;","cur_rd")
								IF ISNULL(cur_rd.paggcrei_cod)
									cs=1
								else
									cs=cur_rd.paggcrei_cod+1
								ENDIF
								xcod=totalcbtes.numero
								ximp=totalcbtes.impabona
								ximpabs=ABS(totalcbtes.impabona)
								SQLEXEC(frmpagpro,"update creintg set creg_impag=creg_impag+?ximpabs where creg_codi=?xcod;")
								SQLEXEC(frmpagpro,"select * from creintg where creg_codi=?xcod;","cur_crec")
								if hayfac="S"
									if totalcbtes.parcial=.T.
										xparci=1
										sele totregis
										repla paggcrei_cod with cs
									ENDIF
									SQLEXEC(frmpagpro,"insert into pagosgas_creintg values(?cs,?codpag,?xcod,?ximp,?xparci);")
									insert into totregis(instancia,creg_codi,creg_fech,paggcrei_cod,paggas_impo,paggcrei_parci) ;
											values(1,xcod,cur_crec.creg_fech,cs,totalcbtes.impabona,IIF(totalcbtes.parcial=.T.,1,0))
								ENDIF
				
								IF RECCOUNT("cur_crec")>0
									if cur_crec.creg_impag>=cur_crec.creg_tot
										SQLEXEC(frmpagpro,"update creintg set pagado='S' where creg_codi=?xcod;")
									endif
								ENDIF
							desconectar_db(frmpagpro)					
					otherwise
						do case
							case subst(allt(totalcbtes.conc),1,1)="F"
								letra="F"
							case subst(allt(totalcbtes.conc),1,2)="NC"
								letra="N"
							case subst(allt(totalcbtes.conc),1,2)="ND"
								letra="D"
						ENDCASE
						frmpagpro= conectar_db(_screen.cn)
							SQLEXEC(frmpagpro,"select MAX(paggas_codi) as paggas_codi from pagosgas_gastos order by paggas_codi;","cur_npr")
							IF ISNULL(cur_npr.paggas_codi)
								cr=1
							ELSE
								cr=cur_npr.paggas_codi+1
							ENDIF
							ximporte=iif(subst(allt(totalcbtes.conc),1,2)="NC",abs(totalcbtes.impabona),totalcbtes.impabona)					
							SQLEXEC(frmpagpro,"update gastos set imp_pag=imp_pag+?ximporte where gas_codi=?totalcbtes.gas_codi;")
							SQLEXEC(frmpagpro,"select * from gastos where gas_codi=?totalcbtes.gas_codi;","cur_gas")
							if cur_recep.imp_pag>=ROUND(cur_gas.gas_piva + cur_gas.gas_btos + cur_gas.gas_impng + cur_gas.gas_impo + ;
														cur_gas.gas_impo2 + cur_gas.gas_impo3 + cur_gas.gas_iva + cur_gas.gas_iva2 + cur_gas.gas_iva3,2)
								SQLEXEC(frmpagpro,"update gastos set pagado='S' where gas_codi=?totalcbtes.gas_codi;")
							endif
							ximprec=totalcbtes.impabona
							if totalcbtes.parcial=.T.
								xparec=1
		*!*							sele totregis
		*!*							repla recfac_codi with cr
							ELSE
								xparec=0
							ENDIF
							SQLEXEC(frmpagpro,"insert into pagosgas_gastos values(?cr,?codpag,?totalcbtes.gas_codi,?ximprec,?xparec);")
							insert into totregis(instancia,gas_codi,gas_fech,gas_tipfac,gas_pto,gas_fac,gas_conc,paggas_impo,paggas_parci) ;
									values(1,cur_gas.gas_codi,cur_gas.gas_fech,cur_gas.gas_tipcbte,cur_gas.gas_pto,cur_gas.gas_cbte, ;
										   cur_gas.gas_conc,ximprec,xparec)
						desconectar_db(frmpagpro)
					endcase
					sele totalcbtes
				endscan
				frmpagpro= conectar_db(_screen.cn)
					SQLEXEC(frmpagpro,"update personas set per_saldo=per_saldo-?.text7.value where per_codi=?codiper;")
					if .text3.value<0
						SQLEXEC(frmpagpro,"update personas set per_afvor=per_afvor+?abs(.text3.value) where per_codi=?codiper;")
					endif
					if .text16.value<0
						SQLEXEC(frmpagpro,"update personas set per_afvor=per_afvor-?abs(.text16.value) where per_codi=?codiper;")
					ENDIF
				
					for i=1 to .olecontrol1.rows-1
						STORE 0 TO xsuc,xcuitl,xmimp,ban,xcuitb
						STORE '' TO xnro,xcheq,xpza,xbdesc,xcheqid
						xfvto=null
						.olecontrol1.row=i
						.olecontrol1.col=8
						xcheqid=ALLTRIM(.olecontrol1.text)
						.olecontrol1.col=7
						if allt(.olecontrol1.text)="P"
							.olecontrol1.col=0
							SQLEXEC(frmpagpro,"select * from tipospago where TRIM(tippag_desc)=?allt(.olecontrol1.text);","cur_tpp")
							if cur_tpp.tippag_codi=3 OR cur_tpp.tippag_codi=20
								.olecontrol1.col=3
								SQLEXEC(frmpagpro,"select * from bancos where TRIM(ban_desc)=?allt(.olecontrol1.text);","cur_banc")
								IF RECCOUNT("cur_banc")>0
									ban=cur_banc.ban_codi
									xbdesc=cur_banc.ban_desc
									xcuitb=VAL(cur_banc.ban_cuit)
								endif
							endif
							SQLEXEC(frmpagpro,"select MAX(pagpag_codi) as pagpag_codi from pagosgas_pagos order by pagpag_codi;","cur_nppp")
							IF ISNULL(cur_nppp.pagpag_codi)
								codpagpag=1
							ELSE
								codpagpag=cur_nppp.pagpag_codi+1
							ENDIF
							.olecontrol1.col=1
							if cur_tpp.tippag_codi=3 OR cur_tpp.tippag_codi=20
								xsuc=ICASE(cur_tpp.tippag_codi=3,val(subst(allt(.olecontrol1.text),4,3)),cur_tpp.tippag_codi=20,0)
								xnro=allt(.olecontrol1.text)
		*!*							xnro=subs(allt(.olecontrol1.text),7,8)
								xcheq=allt(.olecontrol1.text)
							else
								xnro=allt(.olecontrol1.text)
							endif
							.olecontrol1.col=2
							if cur_tpp.tippag_codi=3 OR cur_tpp.tippag_codi=20
								if len(allt(.olecontrol1.text))>0
									xcuitl=val(subst(allt(.olecontrol1.text),1,2)+subst(allt(.olecontrol1.text),4,8)+right(allt(.olecontrol1.text),1))
								endif
							endif
							.olecontrol1.col=4
							xpza=allt(.olecontrol1.text)
							.olecontrol1.col=5
							xfvto=IIF(LEN(ALLTRIM(.olecontrol1.text))>4,ctod(.olecontrol1.text),null)
							.olecontrol1.col=6
							set point to ","
							xmimp=ConverNro(.olecontrol1.text)
							set point to
							SQLEXEC(frmpagpro,"insert into pagosgas_pagos values(?codpagpag,?codpag,?cur_tpp.tippag_codi,?ban,?xsuc,?xcheq,?xcheqid,?xnro,?xpza,?xfvto,?xmimp,?xcuitl,0);")
		
							insert into totregis(instancia,tippag_codi,tippag_desc,movtippag_nro,ban_codi,ban_desc,ban_cuit, ;
			                                     movtippag_pza,movtippag_fvto,movtippag_imp,cuit_lib) ;
			                             values(2,cur_tpp.tippag_codi,cur_tpp.tippag_desc,xnro,ban,xbdesc,xcuitb,xpza, ;
			                             		IIF(ISNULL(xfvto),{  /  /    },xfvto),xmimp,xcuitl)
						ELSE
							LOCAL xcadeid,xcadtp,xctp,xband,xcb
							xctp=0
							.olecontrol1.col=0
							xcadtp=ALLTRIM(.olecontrol1.text)
							SQLEXEC(frmpagpro,"select * from tipospago where TRIM(tippag_desc) = ?xcadtp;","cur_tpp")
							xctp=cur_tpp.tippag_codi
							cerrar_cursor("cur_tpp")
							IF xctp=20
								.olecontrol1.col=3
								xband = ALLTRIM(.olecontrol1.text)
								SQLEXEC(frmpagpro,"select * from bancos where TRIM(ban_desc) = ?xband;","cur_bantpp")
								xcb = cur_bantpp.ban_codi
							ENDIF
							.olecontrol1.col=5
							xfvto=IIF(LEN(ALLTRIM(.olecontrol1.text))>4,ctod(.olecontrol1.text),null)
						    .olecontrol1.col=1					
							xcadeid=allt(.olecontrol1.text)
							.olecontrol1.col=8
							xrpc=VAL(.olecontrol1.text)
		*!*						xcadeid=IIF(xctp=20,ALLTRIM(STR(xcb))+xcadeid,xcadeid+ALLTRIM(.olecontrol1.text))
							.olecontrol1.col=1
						
							SQLEXEC(frmpagpro,"select a.*,b.*,c.* from recibos_pagos a inner join bancos b on a.ban_codi=b.ban_codi inner join tipospago c on c.tippag_codi=a.tippag_codi where a.recpag_codi=?xrpc;","cur_checar")
							
							if RECCOUNT("cur_checar")>0
								SQLEXEC(frmpagpro,"update recibos_pagos set pagg_codi=?codpag where recpag_codi=?cur_checar.recpag_codi;")
								SQLEXEC(frmpagpro,"select MAX(pagpag_codi) as pagpag_codi from pagosgas_pagos order by pagpag_codi;","cur_nppp")
								IF ISNULL(cur_nppp.pagpag_codi)
									orden2=1
								ELSE
									orden2=cur_nppp.pagpag_codi+1
								ENDIF
								
								SQLEXEC(frmpagpro,"insert into pagosgas_pagos values(?orden2,?codpag,?xctp,?ban,?xsuc,?xcheq,?xcheqid,?xnro,?xpza,?xfvto,?xmimp,?xcuitl,?xrpc);")
							    **cur_checar.tippag_codi
								insert into totregis(instancia,tippag_codi,tippag_desc,movtippag_nro,ban_codi,ban_desc,ban_cuit, ;
				                                     movtippag_pza,movtippag_fvto,movtippag_imp,cuit_lib) ;
				                             values(2,cur_checar.tippag_codi,cur_checar.tippag_desc,ICASE(xctp=3,cur_checar.chequenro,xctp=20,cur_checar.movtippag_nro),;
				                             		cur_checar.ban_codi,cur_checar.ban_desc,VAL(cur_checar.ban_cuit),cur_checar.movtippag_pza, ;
				                             		IIF(ISNULL(xfvto),{  /  /    },xfvto),cur_checar.movtippag_imp, ;
				                             		VAL(cur_checar.cuit_lib))
							endif
						endif
					next i
					SQLEXEC(frmpagpro,"select * from pagosgas where pagg_codi=?codpag;","cur_pago")
				desconectar_db(frmpagpro)
			endwith
		
			LOCAL xfecha
			sele totregis
			go top
			xfecha="Río Cuarto, "+Dia_nombre(dow(totregis.pagg_fech)) +" "+ allt(str(DAY(totregis.pagg_fech)))+ ' de ' +Mes_nombre(month(totregis.pagg_fech))+ ' de '+allt(str(year(totregis.pagg_fech)))
			do monto2letra with thisform.text2.value-dtotot,lcletra in ntoletra
			report form ordendepagas TO PRINTER PROMPT NOCONSOLE
			thisform.release
		endif
	ENDPROC


		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.fontsize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.fontsize=10
		this.FontBold= .T.
	ENDPROC


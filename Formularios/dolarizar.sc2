DEFINE CLASS dolarizar AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txt_dolar" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmd_cancel" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmd_aceptar" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 40,44,52
		BorderStyle = 0
		Caption = "Cotización de Dolar"
		Closable = .F.
		DoCreate = .T.
		Height = 136
		Icon = ..\imagen\avast_145.ico
		MaxButton = .F.
		MinButton = .F.
		Name = "dolarizar"
		Width = 378
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmd_aceptar' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Aceptar", ;
		DisabledBackColor = 33,146,214, ;
		Enabled = .F., ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 206, ;
		Name = "cmd_aceptar", ;
		TabIndex = 2, ;
		Themes = .F., ;
		Top = 93, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmd_cancel' AS commandbutton WITH ;
		BackColor = 227,68,34, ;
		Caption = "\<Cancelar", ;
		DisabledBackColor = 227,68,34, ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 87, ;
		Name = "cmd_cancel", ;
		TabIndex = 3, ;
		Themes = .F., ;
		Top = 93, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackStyle = 0, ;
		Caption = "Ingrese Cotización de Dolar:", ;
		FontBold = .T., ;
		ForeColor = 0,255,0, ;
		Height = 17, ;
		Left = 62, ;
		Name = "Label1", ;
		TabIndex = 4, ;
		Top = 44, ;
		Width = 160
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'txt_dolar' AS textbox WITH ;
		Format = "K", ;
		Height = 23, ;
		InputMask = "99999.99", ;
		Left = 230, ;
		Name = "txt_dolar", ;
		TabIndex = 1, ;
		Top = 40, ;
		Width = 105
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETERS xdolar
		
		THISFORM.AddProperty("oRet")
		THISFORM.oRet = CREATEOBJECT("Empty")
		
		thisform.txt_dolar.Value=xdolar
		
		IF xdolar>0
			thisform.cmd_aceptar.Enabled= .T.
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		RETURN THISFORM.oRet
	ENDPROC

	PROCEDURE cmd_aceptar.Click
		IF thisform.txt_dolar.Value>0
			ADDPROPERTY(thisform.oRet, "Prop01", thisform.txt_dolar.value)
			thisform.release
		ELSE
			MESSAGEBOX("No puede ingresar un valor 0 o negativo para la conversión de los precios",48,"Aviso del Sistema")
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_aceptar.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_aceptar.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_cancel.Click
		ADDPROPERTY(thisform.oRet, "Prop01", 0)
		thisform.release
	ENDPROC

	PROCEDURE cmd_cancel.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_cancel.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE txt_dolar.Click
		this.SetFocus
		
	ENDPROC

ENDDEFINE

		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'txtprovload' AS textbox WITH ;
		BackColor = 215,215,215, ;
		FontBold = .T., ;
		Format = "!", ;
		Height = 23, ;
		Left = 45, ;
		Name = "txtprovload", ;
		TabIndex = 1, ;
		Top = 47, ;
		Width = 674
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		public f
		f=1
		
	ENDPROC

	PROCEDURE Init
		parameter proveedor,codiprov,postal,provi,locali
		
		public cade
		cade=""
		
		*!*	THISFORM.AddProperty("oRet")
		*!*	THISFORM.oRet = CREATEOBJECT("Empty")
		
		codiprov=0
		
		frmprovlo= conectar_db(_screen.cn)
			SQLEXEC(frmprovlo,"call usp_buscarprov(?codiprov);","cur_prov")
		desconectar_db(frmprovlo)
		
		thisform.lstprov.RowSource="cur_prov"
	ENDPROC

	PROCEDURE LostFocus
		set skip of bar 4 of Altas .T.
	ENDPROC

	PROCEDURE Unload
		return proveedor
		return codiprov
		return postal
		return provi
		return locali
		
		*!*	RETURN ThisForm.oRet
	ENDPROC

	PROCEDURE Command1.Click
		do form altaprov
	ENDPROC

	PROCEDURE Command1.GotFocus
		if last()=5 or last()=24
			thisform.txtprovload.setfocus
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE lstprov.Click
		SELECT cur_prov
		codiprov=prov_codi
		cond=cond_codi
		locali=cur_prov.loca_nomb
		provi=cur_prov.provi_nomb
		postal=cur_prov.cp_nro
		if last()!=24 AND last()!=5
			thisform.release
		ENDIF
	ENDPROC

	PROCEDURE lstprov.GotFocus
		if last()=24 or last()=5
			thisform.txtprovload.setfocus
		endif
	ENDPROC

	PROCEDURE lstprov.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nkeycode=13
			SELECT cur_prov
			codiprov=prov_codi
			cond=cond_codi
			locali=cur_prov.loca_nomb
			provi=cur_prov.provi_nomb
			postal=cur_prov.cp_nro
			thisform.release
		ENDIF
		
	ENDPROC

	PROCEDURE txtprovload.InteractiveChange
		if subst(allt(this.value),1,1)="?"
			SELECT cur_prov
			SET FILTER TO
		endif
		if subst(allt(this.value),1,1)!="?"
				sele cur_prov
				local lc
				lc = allt(This.Value)
				if last()<>127 and last()<>7
					do while !eof()
						if lc=subst(prov_nomb,1,len(lc))
							exit
						else
							skip
							f=f+1
							if eof()
								go top
								f=1
								exit
							endif
						endif
					enddo
				else
					do while lc=subst(prov_nomb,1,len(lc)) and f>1
						if bof()
							exit
						endif
						skip-1
						if f>1
							f=f-1
						endif
						if lc<>subst(prov_nomb,1,len(lc))
							skip
							f=f+1
							exit
						endif
					enddo
				endif
			thisform.lstprov.selected(f)=.T.
			return
		endif
		
	ENDPROC

	PROCEDURE txtprovload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
				if subst(allt(this.value),1,1)="?"
					cade=subst(allt(this.value),2,len(allt(this.value)))
					sele cur_prov
					set filter to atcline(cade,prov_nomb)!=0
				else
					sele cur_prov
					locali=loca_nomb
					provi=provi_nomb
					postal=cp_nro
					codiprov=prov_codi
					thisform.release
				endif
			case last()=5
				if f>1
					f=f-1
					skip-1
				endif
				thisform.lstprov.selected(f)=f
				this.value=thisform.lstprov.value
			case last()=24
				if f<thisform.lstprov.listcount
					f=f+1
					skip
				endif
				thisform.lstprov.selected(f)=f
				this.value=thisform.lstprov.value
			case last()=27
				thisform.release
		endcase
	ENDPROC

ENDDEFINE

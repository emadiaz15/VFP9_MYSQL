	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
		
	ENDPROC

	PROCEDURE grid1.DblClick
		*** ActiveX Control Event ***
		local x,y
		if nitem>0
			this.col=0
			aux=val(this.text)
			this.col=3
			dato1=val(this.text)
			this.col=1
			dato2=this.text
			this.col=4
			dato3=this.text
			this.col=5
			if this.text="SS"
				opcion=3
			else
				opcion=0
			ENDIF
			do form modiremi with opcion,dato1,dato2,dato3,codigo,cant,descri
		endif
		if borra=6
			with thisform
				if this.rows=2
					nitem=nitem-1
					this.rows=1
				else
					nitem=nitem-1
					this.removeitem(this.row)
					this.col=2
					x=1
					y=0
					do while x<=this.rows-1
						this.row=x
						y=y+1
						this.col=0
						this.text=allt(str(y))
						x=x+1
					enddo
				endif			
			endwith
			borra=0
			insertar=0
		endif
		if insertar=1 and codigo<>0
			frmaltarem= conectar_db(_screen.cn)
				SQLEXEC(frmaltarem,"select * from articulos where art_codi=?codigo;","cur_arti")
			desconectar_db(frmaltarem)
			with thisform
				this.col=0
				nro=this.row
				if opcion=1
					cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
					this.additem(" "+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+cadena+chr(9)+descri,.grid1.row)
					if .check1.value=1
						.grid1.col=5
						.grid1.text="SS"
					endif
					nitem=nitem+1
					muestro=0
					opcion=0
				endif
				x=1
				y=0
				filaux=this.row
				do while x<=this.rows-1
					this.row=x
					y=y+1
					this.col=0
					this.text=allt(str(y))
					x=x+1
				enddo
				this.row=filaux
			endwith
		endif
		do case
			case opcion=3
				this.col=5
				this.text="SS"
				opcion=0
			case opcion=4
				this.col=5
				this.text=""
			case opcion=5
				this.col=4
				texto=allt(this.text)
				do form difedesc with texto
				this.text=allt(texto)
				LOCAL xcadedes,xartc
				IF thisform.valorcadena="A Proveedores"
					xcadedes=ALLTRIM(STR(codiprov))+ALLTRIM(STR(dato1))
					frmaltarem= conectar_db(_screen.cn)
						SQLEXEC(frmaltarem,"select * from articulos_proveedores where concat(trim(cast(prov_codi as char)),trim(cast(art_codi as char)))=?xcadedes;","cur_ddsn")
						IF RECCOUNT("cur_ddsn")>0
							xartc=cur_ddsn.artpro_codi
							SQLEXEC(frmaltarem,"update articulos_proveedores set artpro_desc=?texto where artpro_codi=?xartc;")
						ELSE
							SQLEXEC(frmaltarem,"select CAST(artpro_codi+1 as decimal(8,0)) as artpro_codi from articulos_proveedores order by artpro_codi desc limit 1;","cur_nvoarc")
							xartc=cur_nvoarc.artpro_codi
							SQLEXEC(frmaltarem,"insert into articulos_proveedores values(?xartc,?dato1,?codiprov,0,0,?texto,'',0,0,0);")
						ENDIF
						SQLEXEC(frmaltarem,"select CAST(dap_codi+1 as decimal(8,0)) as dap_codi from desc_articulos_proveedores order by dap_codi desc limit 1;","cur_nvoda")
						SQLEXEC(frmaltarem,"insert into desc_articulos_proveedores values(?cur_nvoda.dap_codi,?xartc,?texto);")
					desconectar_db(frmaltarem)
					this.col=6
					this.text=ALLTRIM(STR(cur_nvoda.dap_codi))
				ELSE
					xcadedes=ALLTRIM(STR(codicli))+ALLTRIM(STR(dato1))
					frmaltarem= conectar_db(_screen.cn)
						SQLEXEC(frmaltarem,"select * from articulos_clientes where concat(trim(cast(cli_codi as char)),trim(cast(art_codi as char)))=?xcadedes;","cur_ddsn")
						IF RECCOUNT("cur_ddsn")>0
							xartc=cur_ddsn.artcli_codi
							SQLEXEC(frmaltarem,"update articulos_clientes set artcli_desc=?texto where artcli_codi=?xartc;")
						ELSE
							SQLEXEC(frmaltarem,"select CAST(artcli_codi+1 as decimal(8,0)) as artcli_codi from articulos_clientes order by artcli_codi desc limit 1;","cur_nvoarc")
							xartc=cur_nvoarc.artcli_codi
							SQLEXEC(frmaltarem,"insert into articulos_clientes values(?xartc,?dato1,?codicli,?texto);")
						ENDIF
						SQLEXEC(frmaltarem,"select CAST(dac_codi+1 as decimal(8,0)) as dac_codi from desc_articulos_clientes order by dac_codi desc limit 1;","cur_nvoda")
						SQLEXEC(frmaltarem,"insert into desc_articulos_clientes values(?cur_nvoda.dac_codi,?xartc,?texto);")
					desconectar_db(frmaltarem)
					this.col=6
					this.text=ALLTRIM(STR(cur_nvoda.dac_codi))
				ENDIF
		endcase
		do case
			case thisform.valorcadena="Por Artículo" or thisform.valorcadena="Por Factura"
				if nitem<27
					valorcadena=thisform.valorcadena
					on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
				else
					on key label INS messagebox("No puede ingresar más Items al remito"+chr(13)+ ;
					                            "Haga click en Terminar para imprimir y luego"+chr(13)+ ;
					                            "registre un nuevo remito",0+48,"Advertencia")
				endif
			case thisform.valorcadena="Por Pedido"
				if nitem<27
					valorcadena=thisform.valorcadena
					on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
				ELSE
					on key label INS messagebox("No puede ingresar más Items al remito"+chr(13)+ ;
					                            "Haga click en Terminar para imprimir y luego"+chr(13)+ ;
					                            "registre un nuevo remito",0+48,"Advertencia")
				endif
		endcase
	ENDPROC

	PROCEDURE grid1.GotFocus
		*!*	if localiz=1
		*!*		if elimi=0 and nitem>0
		*!*			thisform.grid1.toprow=nitem
		*!*		else
		*!*			elimi=0
		*!*		endif
		*!*	endif
	ENDPROC

	PROCEDURE Text1.GotFocus
		*!*	if localiz=1
		*!*		thisform.grid1.toprow=nitem
		*!*	endif
	ENDPROC

	PROCEDURE Text13.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text8.Click
		this.setfocus
	ENDPROC


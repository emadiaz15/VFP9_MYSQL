	PROCEDURE Activate
		set exact on
		if codigo=0
			muestro=0
		endif
		if muestro=1
			with thisform
				frmaltarem= conectar_db(_screen.cn)
					SQLEXEC(frmaltarem,"select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmaltarem)
				if ConverNro(cant)>cur_arti.art_stock and .check1.value=0 and codigo>5
					set point to ","
					preg=messagebox("No hay stock disponible de: "+allt(cur_arti.art_desc)+chr(13)+ ;
						            "Cantidad a Enviar: "+allt(str(ConverNro(cant),10,2))+" "+allt(cur_arti.art_med)+chr(13)+ ;
						            "Stock Actual:        "+allt(str(cur_arti.art_stock,10,2))+" "+allt(cur_arti.art_med),4+48+256,"Advertencia!!!")
				else
					preg=6
				endif
				if preg=6
					set point to
					localiz=1
					if paso=1
						.grid1.col=0
						.grid1.text=allt(str(aux))
						.grid1.col=2
						.grid1.text=cur_arti.art_med
						.grid1.col=3
						articulo=val(.grid1.text)
						.grid1.col=3
						cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
						.grid1.text=cadena
						.grid1.col=1			
						.grid1.text=allt(cant)
						.grid1.col=4
						if codigo=4 OR codigo=5
							.grid1.text=allt(descrip)
						else
							.grid1.text=allt(descri)
						endif
						if .check1.value=1
							.grid1.col=5
							.grid1.text="SS"
						endif
						paso=0
					else
						if insertar=0
							nitem=nitem+1
							cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
							.grid1.additem(alltrim(str(nitem))+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+cadena+chr(9)+allt(descri))
							if .check1.value=1
								.grid1.row=.grid1.rows-1
								.grid1.col=5
								.grid1.text="SS"
							endif
							do case
								case thisform.valorcadena="Por Artículo" or thisform.valorcadena="Por Factura"
									if nitem<27
										valorcadena=thisform.valorcadena
										on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
									else
										on key label INS messagebox("No puede ingresar más Items al remito"+chr(13)+ ;
										                            "Haga click en Terminar para imprimir y luego"+chr(13)+ ;
										                            "registre un nuevo remito",0+48,"Advertencia")
									endif
								case thisform.valorcadena="Por Pedido"
									valorcadena=thisform.valorcadena
									if nitem<27
										on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
									ELSE
										on key label INS messagebox("No puede ingresar más Items al remito"+chr(13)+ ;
										                            "Haga click en Terminar para imprimir y luego"+chr(13)+ ;
										                            "registre un nuevo remito",0+48,"Advertencia")
									endif
							endcase
						ENDIF
					ENDIF
				ELSE
					SET POINT TO
				endif
			endwith
		endif
		store 0 to muestro
		
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 3 of Altas .F.
		_screen.xopvta=""
		on key label INS
		localiz=0
		nitem=0
		if thisform.valorcadena="Por Pedido de Cliente"
			itemsfac.release
		endif
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE facturados
		LPARAMETERS lcodrem
		
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select COUNT(*) can1 from remitos_articulos where rem_codi=?lcodrem;","cur_canrr")
			SQLEXEC(frmaltafac,"select COUNT(*) can2 from remitos_articulos where rem_codi=?lcodrem and facturado=1;","cur_canrf")
		desconectar_db(frmaltafac)
		
		IF cur_canrf.can2=cur_canrr.can1
			frmaltafac= conectar_db(_screen.cn)
				SQLEXEC(frmaltafac,"update remitos set facturado=1 where rem_codi=?lcodrem;")
			desconectar_db(frmaltafac)
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE Init
		parameter codifac,codp,codicli,codiprov
		public elimi,descrip,muestro,opcion,nrofac,ptorem,nrorem,codirem, ;
			   dato1,dato2,dato3,codigo,cant,descri,insertar, ;
			   borra,codiva,transporte,coditran1,coditran2,auxcond, ;
			   texto,rta,articulo,lugent1,lugent2,flete1,flete2,observ,comprobante,localiz,nitem, ;
			   buscar
		LOCAL rengrem,longdes,lnLock
		set date british
		set cent on	   
		set deleted on
		STORE 0 TO coditran1,coditran2,flete1,flete2,paso,elimi,localiz,muestro, ;
				   opcion,insertar,borra,codigo,auxregis,nrofac,ptorem,nrorem,rta,nitem,articulo,codirem,lnLock
		
		STORE "" TO transporte,lugent1,lugent2,observ,descrip,texto
		
		DO case
			CASE codicli>0
				_screen.xopvta="RC"
			CASE codiprov>0
				_screen.xopvta="RP"
		ENDCASE
		
		buscar=1
		thisform.valorcadena=valorcadena
		this.text13.value=date()
		this.text8.value=0
		do case
			case thisform.valorcadena="Por Factura"
				if codicli>0
		*!*				LOCAL countss
		*!*				countss=0
					thisform.xcodifac=codifac
					with thisform
						frmaltarem= conectar_db(_screen.cn)
							SQLEXEC(frmaltarem,"call usp_buscarcli(?codicli);","cur_clir")
						desconectar_db(frmaltarem)
						.text1.value=cur_clir.cli_nomb
						.text2.value=cur_clir.cli_domi
						.text3.value=cur_clir.cp_nro
						.text4.value=cur_clir.loca_nomb
						.text5.value=cur_clir.provi_nomb
						.text6.value=cur_clir.cond_desc
						.text12.value=VAL(cur_clir.cli_cuit)
						cond=cur_clir.cond_codi
		*!*					frmaltarem= conectar_db(_screen.cn)
		*!*						SQLEXEC(frmaltarem,"select a.*,b.*,c.dac_desc from facturas_articulos a inner join articulos b on a.art_codi=b.art_codi left outer join desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.fac_codi=?codifac;","cur_facarti")
		*!*					desconectar_db(frmaltarem)
		&&cur_itemsped(selart L,nro_it N(5),artped_cant N(10,3),art_med C(3),art_codi N(8),art_desc M,dac_codi N(8),artped_codi N(8),artfac_sstock C(1))
						SELECT cur_itemsped
						LOCATE
						SCAN FOR selart=.T.
							cadena=repl("0",8-len(allt(str(cur_itemsped.art_codi))))+allt(str(cur_itemsped.art_codi))
							nitem=nitem+1
							.grid1.additem(allt(str(nitem))+chr(9)+str(cur_itemsped.artped_cant,10,3)+chr(9)+cur_itemsped.art_med+chr(9)+cadena+chr(9)+ ;
										   ALLTRIM(cur_itemsped.art_desc)+CHR(9)+ ;
										   IIF(ALLTRIM(cur_itemsped.artfac_sstock)='S','','SS')+CHR(9)+ ;
										   STR(cur_itemsped.dac_codi)+CHR(9)+IIF(ISNULL(cur_itemsped.artped_codi),'',STR(cur_itemsped.artped_codi))+ ;
										   CHR(9)+ALLTRIM(STR(cur_itemsped.far_codi)))
		
		*!*						if cur_facarti.art_codi=4 OR cur_facarti.art_codi=5
		*!*							.grid1.col=4
		*!*							.grid1.row=nitem
		*!*							.grid1.text=allt(cur_facarti.artfac_dasc)
		*!*						ENDIF
							.grid1.row=.grid1.rows-1
							.grid1.col=4
							.grid1.CellAlignment=0					
						ENDSCAN
						.check1.Enabled= .F.
						LOCATE
						frmaltarem= conectar_db(_screen.cn)
							SQLEXEC(frmaltarem,"select ped_codi from pedidos_articulos where artped_codi=?cur_itemsped.artped_codi;","cur_codp")
							codp=cur_codp.ped_codi
							cerrar_cursor("cur_codp")
							SQLEXEC(frmaltarem,"select fac_pto,fac_nro,ped_codi from facturas where fac_codi=?codifac;","cur_numfac")
						desconectar_db(frmaltarem)
						.text8.value=repl("0",4-len(allt(str(cur_numfac.fac_pto))))+allt(str(cur_numfac.fac_pto))+" - "+repl("0",8-len(allt(str(cur_numfac.fac_nro))))+allt(str(cur_numfac.fac_nro))
					endwith
				endif
			case thisform.valorcadena="Por Artículo"
				with thisform
					codicli=0
					DO FORM cliload WITH codicli
					frmaltarem= conectar_db(_screen.cn)
						SQLEXEC(frmaltarem,"call usp_buscarcli(?codicli);","cur_clir")
					desconectar_db(frmaltarem)
					.text1.value=cur_clir.cli_nomb
					.text2.value=cur_clir.cli_domi
					.text3.value=cur_clir.cp_nro
					.text4.value=cur_clir.loca_nomb
					.text5.value=cur_clir.provi_nomb
					.text6.value=cur_clir.cond_desc
					.text12.value=VAL(cur_clir.cli_cuit)
					cond=cur_clir.cond_codi
				endwith
			case thisform.valorcadena="A Proveedores"
				with thisform
					codiprov=0
					DO FORM provload WITH proveedor,codiprov
					frmaltarem= conectar_db(_screen.cn)
						SQLEXEC(frmaltarem,"call usp_buscarprov(?codiprov);","cur_pror")
					desconectar_db(frmaltarem)		
					.text1.value=cur_pror.prov_nomb
					.text2.value=cur_pror.prov_domi
					.text3.value=cur_pror.cp_nro
					.text4.value=cur_pror.loca_nomb
					.text5.value=cur_pror.provi_nomb
					.text6.value=cur_pror.cond_desc
					.text12.value=VAL(cur_pror.prov_cuit)
					cond=cur_pror.cond_codi
					thisform.lbl_clipro.Caption=" Datos del Proveedor "
					thisform.lbl_nomb.Caption  ="Proveedor:"
				endwith
			case thisform.valorcadena="Por Pedido"
				if codicli>0
					with thisform
						frmaltarem= conectar_db(_screen.cn)
							SQLEXEC(frmaltarem,"call usp_buscarcli(?codicli);","cur_clir")
						desconectar_db(frmaltarem)
						.text1.value=cur_clir.cli_nomb
						.text2.value=cur_clir.cli_domi
						.text3.value=cur_clir.cp_nro
						.text4.value=cur_clir.loca_nomb
						.text5.value=cur_clir.provi_nomb
						.text6.value=cur_clir.cond_desc
						.text12.value=VAL(cur_clir.cli_cuit)
						cond=cur_clir.cond_codi
						SELECT cur_itemsped
						GO top
						nitem=1
						rengrem=1
						SCAN FOR selart=.T.
							.grid1.additem(allt(str(nitem))+chr(9)+allt(STR(cur_itemsped.artped_cant,10,3))+chr(9)+allt(cur_itemsped.art_med)+chr(9)+ ;
										   allt(STR(cur_itemsped.art_codi))+chr(9)+allt(cur_itemsped.art_desc)+CHR(9)+''+CHR(9)+ ;
										   allt(STR(cur_itemsped.dac_codi))+CHR(9)+allt(STR(cur_itemsped.artped_codi)))
							.grid1.row=.grid1.rows-1
							.grid1.col=0
							.grid1.CellAlignment=3
							.grid1.col=1
							.grid1.CellAlignment=3
							.grid1.col=2
							.grid1.CellAlignment=3
							.grid1.col=3
							.grid1.CellAlignment=3
							.grid1.col=4
							.grid1.CellAlignment=0					
							if len(allt(cur_itemsped.art_desc))>44
								div=len(allt(cur_itemsped.art_desc))/44
								if div>int(div)
									longdes=int(div)+1
								else
									longdes=div
								endif
								rengrem=rengrem+longdes
								longdes=longdes*250
								this.grid1.rowheight(nitem)=longdes
							ELSE
								rengrem=rengrem+1
								this.grid1.rowheight(nitem)=-1
							ENDIF
							nitem=nitem+1
							if rengrem>27
								=messagebox("La cantidad de ítems seleccionados supera la cantidad permitida"+chr(13)+ ;
											"por comprobante, solo se tomaron algunos ítems del pedido."+chr(13)+chr(13)+ ;
											"Para remitar el resto deberá efectuar otra vez la operación.",0+64,"Remitos por Pedidos")
								this.grid1.removeitem(nitem)
								nitem=nitem-1
								exit
							endif
						ENDSCAN
						nitem=nitem-1
					endwith
				ENDIF
		ENDCASE
		frmaltarem= conectar_db(_screen.cn)
			lnLock = MySQL_LockTables("LOCK", "remitos WRITE", frmaltarem)
			SQLEXEC(frmaltarem,"select rem_codi, rem_pto, rem_nro from remitos order by rem_codi desc limit 1;","cur_nvorem")
			lnLock = MySQL_LockTables("UNLOCK", "", frmaltarem)
		desconectar_db(frmaltarem)
		IF RECCOUNT("cur_nvorem")=0
			do form inirem with nrorem, ptorem
			codirem = 1
		ELSE
			codirem=cur_nvorem.rem_codi+1
			ptorem=cur_nvorem.rem_pto
			nrorem=cur_nvorem.rem_nro+1
			this.text9.value=cur_nvorem.rem_pto
		ENDIF
		this.text9.value=ptorem
		this.text7.value=nrorem
		localiz=1
		valorcadena=thisform.valorcadena
		on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Load
		set skip of bar 3 of Altas .T.
	ENDPROC

	PROCEDURE LostFocus
		if thisform.valorcadena="Por Presupuesto"
			set skip of bar 3 of Altas .F.
			localiz=0
		*	item=0
		endif
	ENDPROC

	PROCEDURE remitados
		LPARAMETERS lcodfac
		
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select COUNT(*) can1 from facturas_articulos where fac_codi=?lcodfac;","cur_canrr")
			SQLEXEC(frmaltafac,"select COUNT(*) can2 from facturas_articulos where fac_codi=?lcodfac and remitado=1;","cur_canrf")
		desconectar_db(frmaltafac)
		
		IF cur_canrf.can2=cur_canrr.can1
			frmaltafac= conectar_db(_screen.cn)
				SQLEXEC(frmaltafac,"update facturas set remitado=1 where fac_codi=?lcodfac;")
			desconectar_db(frmaltafac)
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE btn_deta.Click
		IF LEN(ALLTRIM(cur_clie.cli_deta)) > 0
			MESSAGEBOX(ALLTRIM(cur_clie.cli_deta),64,"Detalles Adicionales del Cliente")
		ELSE
			MESSAGEBOX("No hay detalles ingresados para este cliente",48,"Detalles Adicionales del Cliente")
		ENDIF
		
	ENDPROC

	PROCEDURE Check1.Click
		do case
			case this.value=1
				preg=messagebox("¿Confirma que envía todo sin mover Stock?",4+48+256,"Advertencia")
				if preg=6
					if thisform.grid1.rows>1
						thisform.grid1.col=5
						for i=1 to thisform.grid1.rows-1
							thisform.grid1.row=i
							thisform.grid1.text="SS"
						next i
						thisform.grid1.row=1
					endif
				else
					this.value=0
				endif
			case this.value=0
				preg=messagebox("¿Confirma que envía todo moviendo Stock?",4+48+256,"Advertencia")
				if preg=6
					if thisform.grid1.rows>1
						thisform.grid1.col=5
						for i=1 to thisform.grid1.rows-1
							thisform.grid1.row=i
							thisform.grid1.text=""
						next i
						thisform.grid1.row=1
					endif
				else
					this.value=1
				endif
		endcase
	ENDPROC

	PROCEDURE cmd_terminar.Click
		local primerem,primefac,primecodirem,pedido
		STORE 0 TO primecodirem,primerem,primefac,pedido
		
		DIMENSION tra[2,5]
		if nitem=0
			messagebox("Aún no ha ingresado ningún Item al Remito. Imposible Terminar",0+48,"Advertencia")
		else	
			preg=messagebox("¿Confirma los datos del Remito?",4+32+256,"Alta de Remitos")
		endif
		if preg=6
			messagebox("Verifique si están en la impresora los formularios de remito y haga click en Aceptar",0+48,"Advertencia")
			acu=0
			if nitem>27
				div=nitem/27
				if div>int(div)
					cantrem=int(div)+1
				else
					cantrem=nitem/27
				endif
			else
				cantrem=1
			endif
			c=1
			LOCAL xpto,xfech,xcant,xdasc,xdac,xdap,xddesc,xsst,xartpcod,xnrer,xnotaped,xtipped,xfar
			STORE 0 TO xpto,xcant,xdac,xdap,xartpcod,xnrer,xnotaped,xfar
			STORE '' TO xdasc,xddesc,xsst,xtipped
			for x=1 to cantrem
				with thisform
					if thisform.valorcadena="Por Pedido" OR thisform.valorcadena="Por Factura"
						frmaltarem= conectar_db(_screen.cn)
							SQLEXEC(frmaltarem,"select * from pedidos_transportes where ped_codi=?codp;","cur_tran")
						desconectar_db(frmaltarem)
						IF RECCOUNT("cur_tran")>0
							GO top
							if cur_tran.ped_codi=codp
								coditran1=cur_tran.tran_codi
								lugent1=cur_tran.flete_lugent
								do case
									case cur_tran.flete_cargo="P"
										flete1=1
									case cur_tran.flete_cargo="C"
										flete1=2
								ENDCASE
								IF RECCOUNT("cur_tran")>1
									skip
									if cur_tran.ped_codi=codp
										coditran2=cur_tran.tran_codi
										lugent2=cur_tran.flete_lugent
										do case
											case cur_tran.flete_cargo="P"
												flete2=1
											case cur_tran.flete_cargo="C"
												flete2=2
										endcase
									ENDIF
								ENDIF
							ENDIF
						endif
					ENDIF
					if thisform.valorcadena="Por Factura"
						nrofac=cur_numfac.fac_nro
						primefac=nrofac
					endif
		*!*				if RECCOUNT("cur_nvorem")=0
		*!*					codirem=1
		*!*				else
		*!*					codirem=cur_nvorem.rem_codi
		*!*	*!*					if x>1
		*!*	*!*						nrorem=nrorem+1
		*!*	*!*					endif
		*!*				endif
					if x=1
						primecodirem=codirem
						primerem=nrorem
					endif
					xpto=.text9.value
					xfech=.text13.value
					if thisform.valorcadena<>"Por Factura"
						codifac=0
					endif
					do case
						case thisform.valorcadena="Por Artículo" or thisform.valorcadena="Por Factura" or thisform.valorcadena="Por Pedido"
							codiprov=0
						case thisform.valorcadena="A Proveedores"
							codicli=0
					ENDCASE
					frmaltarem= conectar_db(_screen.cn)
						SQLEXEC(frmaltarem,"insert into remitos values(?codirem,?nrorem,?xpto,?xfech,?codifac,0,?codicli,?codp,?codiprov,'',0,0,'','','',0);")
					desconectar_db(frmaltarem)
					contador=1
					for fila=c to .grid1.rows-1
						if contador<=27
							STORE 0 TO xcant,xdac,xdap,xartpcod
							STORE '' TO xdasc,xddesc,xsst				
							.grid1.row=fila
							.grid1.col=3
							articulo=val(.grid1.text)
							.grid1.col=1
							SET DECIMALS TO 3
							xcant=ConverNro(.grid1.text)
							SET DECIMALS TO
							.grid1.col=4
							if articulo=4 OR articulo=5
								xdasc=.grid1.text
							ENDIF
							.grid1.col=6
							xdac=0
							xdap=0
							if thisform.valorcadena="A Proveedores"
								xdap=VAL(.grid1.text)
							ELSE
								xdac=VAL(.grid1.text)
							ENDIF
							if articulo>5 and xdac>0 OR xdap>0
								.grid1.col=4
								xddesc=allt(.grid1.text)
							endif
							.grid1.col=5
							if allt(.grid1.text)<>"SS"
								LOCAL stact,saldst,xptohis,xnro,xcadecom,xnclipro,xcodiclipro &&,xdiahis,xhorahis
								xnclipro=ALLTRIM(thisform.text1.Value)
								IF thisform.valorcadena="A Proveedores"
									xcodiclipro=codiprov
								ELSE
									xcodiclipro=codicli
								ENDIF
								.grid1.col=1
								if articulo>5
									frmaltarem= conectar_db(_screen.cn)
										SET DECIMALS TO 3
										SQLEXEC(frmaltarem,"select art_stock from articulos where art_codi=?articulo;","cur_stac")
										stact=cur_stac.art_stock
										saldst=stact-xcant
										xptohis  =REPLICATE("0",4-LEN(ALLTRIM(STR(xpto))))+ALLTRIM(STR(xpto))
										xnro     =REPLICATE("0",8-LEN(ALLTRIM(STR(nrorem))))+ALLTRIM(STR(nrorem))
										xcadecom =ALLTRIM("REM"+"_"+ALLTRIM(xptohis)+"-"+ALLTRIM(xnro)+" -- "+xnclipro)
										SQLEXEC(frmaltarem,"update articulos set art_stock=art_stock-?xcant where art_codi=?articulo;")
										SQLEXEC(frmaltarem,"insert into histostock values(null,?articulo,current_date(),current_time(),'S',?stact,-?xcant,?saldst,?xcadecom,'',0,0,0,?codirem,0,?cond,?xcodiclipro);")
										SET DECIMALS TO
										cerrar_cursor("cur_stac")
									desconectar_db(frmaltarem)
									******************* SE CONECTA AL SERVIDOR HP Y CHEQUEA SI EXISTE ARTÍCULO Y MODIFICA STOCK E HISTORICO TAMBIEN ****************
									conexterna= conectar_db(_screen.xconext)
									IF VARTYPE(conexterna) = "N" AND conexterna> 0
										SQLEXEC(conexterna,"select * from articulos where art_codi = ?articulo;","cur_artext")
										IF USED("cur_artext")
											IF RECCOUNT("cur_artext") > 0
												xcadecom =ALLTRIM("REM ILUMET"+"_"+ALLTRIM(xptohis)+"-"+ALLTRIM(xnro)+" -- "+xnclipro)
												SQLEXEC(conexterna,"update articulos set art_stock=art_stock-?xcant where art_codi=?articulo;")
												SQLEXEC(conexterna,"insert into histostock values(null,?articulo,current_date(),current_time(),'S',?stact,-?xcant,?saldst,?xcadecom,'',0,0,0,?codirem,0,?cond,?xcodiclipro);")
											ENDIF
											cerrar_cursor("cur_artext")
										ENDIF
										desconectar_db(conexterna)
									ENDIF
									********************** FIN PROCESO SERVIDOR HP *******************************							
								endif
								.grid1.col=7
								xartpcod=VAL(.grid1.text)
								IF xartpcod > 0
									frmaltarem= conectar_db(_screen.cn)								
										SQLEXEC(frmaltarem,"select * from pedidos_articulos where artped_codi=?xartpcod;","cur_pa")
										codp=cur_pa.ped_codi
										.grid1.col=1
										xcntped=IIF(cur_pa.artped_ent>0,cur_pa.artped_cant-cur_pa.artped_ent,cur_pa.artped_cant)
										if xcant>(cur_pa.artped_cant-cur_pa.artped_ent)
											SQLEXEC(frmaltarem,"update pedidos_articulos set artped_ent=artped_ent+?xcntped where artped_codi=?xartpcod;")
		*!*										SQLEXEC(frmaltarem,"update articulos set pedidos=pedidos-?xcntped where art_codi=?cur_pa.art_codi;")
										ELSE
											SQLEXEC(frmaltarem,"update pedidos_articulos set artped_ent=artped_ent+?xcant where artped_codi=?xartpcod;")
		*!*										SQLEXEC(frmaltarem,"update articulos set pedidos=pedidos-?xcant where art_codi=?cur_pa.art_codi;")
										ENDIF
									desconectar_db(frmaltarem)
									IF cur_pa.art_codi > 5
										Campo_ped(cur_pa.art_codi)
									ENDIF
								ENDIF
								if thisform.valorcadena="Por Factura"
									.grid1.col=8
									xfar=VAL(.grid1.text)
								endif
							ELSE
								.grid1.col=7
								xartpcod=VAL(.grid1.text)
								xsst="S"
							ENDIF
							frmaltarem= conectar_db(_screen.cn)
								SQLEXEC(frmaltarem,"select cast(rer_codi+1 as DECIMAL(8,0)) as rer_codi from remitos_articulos order by rer_codi desc limit 1;","cur_rernvo")
								IF RECCOUNT("cur_rernvo")>0
									xnrer=cur_rernvo.rer_codi
								ELSE
									xnrer=1
								ENDIF
								SQLEXEC(frmaltarem,"insert into remitos_articulos values(?xnrer,?codirem,?articulo,?nrorem,?xcant,?xdasc,?xdac,?xdap,?xddesc,?xsst,?xartpcod,0);")
								IF thisform.valorcadena="Por Factura" AND xnrer>0
									SQLEXEC(frmaltarem,"insert into facar_remar values(?xfar,?xnrer,?xcant);")
									LOCAL xcrfac
									SQLEXEC(frmaltarem,"select ROUND(SUM(farrer_cant),3) farrer_cant from facar_remar where far_codi=?xfar;","cur_canrer")
									xcrfac = IIF(ISNULL(cur_canrer.farrer_cant),0,cur_canrer.farrer_cant)
									SQLEXEC(frmaltarem,"update facturas_articulos set remitado=if(?xcrfac>=artfac_cant,1,0) where far_codi=?xfar;")
									SQLEXEC(frmaltarem,"update remitos_articulos set facturado=if(?xcrfac>=artrem_cant,1,0) where rer_codi=?xnrer;")
								ENDIF
							desconectar_db(frmaltarem)
						endif
						contador=contador+1
					next fila
				endwith
				if cantrem>1
					nrorem=nrorem+1
				endif
				c=fila
			next x
			if thisform.valorcadena="Por Pedido" or thisform.valorcadena="Por Factura"
				do cumplido with codp
			ENDIF
			IF thisform.valorcadena="Por Factura"
				thisform.facturados(codirem)
				thisform.remitados(thisform.xcodifac)
			ENDIF
		*!*		codirem=primecodirem
		*!*		nrorem=primerem
		*!*		nrofac=primefac
		*!*		coditran1=0
		*!*		coditran2=0
			frmaltarem= conectar_db(_screen.cn)
				SQLEXEC(frmaltarem,"select if(notaped_nro>0,notaped_nro,ped_codi) pednro,if(notaped_nro>0,'NOTA DE PEDIDO Nº: ','PEDIDO Nº: ') xtexto from pedidos where ped_codi=?codp;","cur_nped")
			desconectar_db(frmaltarem)
			for x=1 to cantrem
				do form datosremito with codirem,nrorem,nrofac,lugent1,lugent2,observ,flete1,flete2,coditran1,coditran2
				store "" to tra[1,1],tra[1,2],tra[1,5],tra[2,1],tra[2,2],tra[2,5],tra[1,3],tra[1,4],tra[2,3],tra[2,4]
				IF coditran1>0
					frmaltarem= conectar_db(_screen.cn)
						SQLEXEC(frmaltarem,"select * from transportes where tran_codi=?coditran1;","cur_tran1")
						tra[1,1]=allt(cur_tran1.tran_nomb)
						tra[1,2]=allt(cur_tran1.tran_domi)
						tra[1,3]=cur_tran1.tran_cartel
						tra[1,4]=cur_tran1.tran_tel1
						tra[1,5]=allt(lugent1)
						IF coditran2>0
							SQLEXEC(frmaltarem,"select * from transportes where tran_codi=?coditran2;","cur_tran2")
							tra[2,1]=allt(cur_tran2.tran_nomb)
							tra[2,2]=allt(cur_tran2.tran_domi)
							tra[2,3]=cur_tran2.tran_cartel
							tra[2,4]=cur_tran2.tran_tel1
							tra[2,5]=allt(lugent2)
						ENDIF
					desconectar_db(frmaltarem)
				ENDIF
				SET DECIMALS TO 3
				frmaltarem= conectar_db(_screen.cn)
					SQLEXEC(frmaltarem,"select * from remitos where rem_codi=?codirem;","cur_rem")
					DO case
						CASE codicli>0
							SQLEXEC(frmaltarem,"select a.*,b.art_desc,b.art_med,c.dac_desc from remitos_articulos as a inner join articulos as b on a.art_codi=b.art_codi left outer join desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.rem_codi=?codirem;","cur_remart")
						CASE codiprov>0
							SQLEXEC(frmaltarem,"select a.*,b.art_desc,b.art_med,c.dap_desc from remitos_articulos as a inner join articulos as b on a.art_codi=b.art_codi left outer join desc_articulos_proveedores c on c.dap_codi=a.dap_codi where a.rem_codi=?codirem;","cur_remart")
					ENDCASE
				desconectar_db(frmaltarem)
				SET DECIMALS TO
				SELECT cur_remart
				GO top
				for n=1 to 3
					do case
						case n=1
							comprobante="ORIGINAL"
						case n=2
							comprobante="DUPLICADO"
					    case n=3
							comprobante="TRIPLICADO"
					endcase
					do case
						case thisform.valorcadena="Por Artículo" or thisform.valorcadena="Por Factura" or thisform.valorcadena="Por Pedido"
							set point to ","
							SET DECIMALS TO 3
							report form remito for cur_remart.rem_codi=codirem TO PRINTER PROMPT NOCONSOLE
							set point to
							SET DECIMALS TO 
						case thisform.valorcadena="A Proveedores"
							set point to ","
							SET DECIMALS TO 3
							report form remitoprov for cur_remart.rem_codi=codirem TO PRINTER PROMPT NOCONSOLE
							set point to
							SET DECIMALS TO
					endcase
				next n
				codirem=codirem+1
				nrorem=nrorem+1
				nrofac=nrofac+1
			next x
			thisform.release
		endif
		
	ENDPROC


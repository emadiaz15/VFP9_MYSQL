		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text2' AS textbox WITH ;
		Format = "!", ;
		Height = 23, ;
		Left = 170, ;
		Name = "Text2", ;
		TabIndex = 2, ;
		Top = 90, ;
		Width = 298
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		LOCAL xoprub,cr,cantesp,xcantot
		xoprub='I'
		STORE 0 TO rubroc,cantesp,xcantot
		rubrod=""
		
		thisform.text1.Value=0
		
		thisform.grd_rubros.RecordSource=''
		thisform.grd_rubros.Refresh
		
		frmprub= conectar_db(_screen.cn)
			SQLEXEC(frmprub,"select * from rubros order by rub_codi;","cur_locrub")
			IF RECCOUNT("cur_locrub")>0
				GO TOP IN cur_locrub
				thisform.grd_rubros.RecordSource="cur_locrub"
			ENDIF
		desconectar_db(frmprub)
		
		do form altarubpreg WITH xoprub TO opcirub
		
		DO case
			CASE opcirub.Prop01='I'
				thisform.text1.SetFocus
			CASE opcirub.Prop01='G'
				frmprub= conectar_db(_screen.cn)
					SQLEXEC(frmprub,"select rub_codi,rub_desc from rubros order by rub_codi desc limit 1;","cur_nuer")
				desconectar_db(frmprub)
		
				IF ISNULL(cur_nuer.rub_codi)
					cr=1
				ELSE
					frmaltarub= conectar_db(_screen.cn)
						SQLEXEC(frmaltarub,"select COUNT(art_codi) as cant from articulos where rub_codi=?cur_nuer.rub_codi;","cur_cantar")
						SQLEXEC(frmaltarub,"select art_codi,art_desc from articulos where rub_codi=?cur_nuer.rub_codi order by art_codi desc limit 1;","cur_ultar")
					desconectar_db(frmaltarub)
					IF cur_ultar.art_codi<99999999
						IF RECCOUNT("cur_cantar")>0
							pregnr=MESSAGEBOX("El último rubro que se encuentra en archivo "+ALLTRIM(cur_nuer.rub_desc)+" tiene incorporados "+ALLTRIM(cur_cantar.cant)+ ;
									  		  " artículos. ¿Desea dejar mas espacios libres para preveer la incorporación de nuevos artículos a ese rubro?",4+48+256,"Aviso del Sistema")
							IF pregnr=6
								MESSAGEBOX("El último código de artículo ingresado en este rubro es el "+ALLTRIM(STR(cur_ultar.art_codi))+" - "+ALLTRIM(cur_ultar.art_desc)+"."+CHR(13)+CHR(13)+ ;
										   "Se agregarán espacios a partir del código siguiente a este último indicado.",64,"Aviso del Sistema")
								xcantot=cur_ultar.art_codi+1
								DO FORM frmcantesp WITH cantesp,xcantot TO mvrespa
								IF mvrespa.Cantr>0
									cr=cur_ultar.art_codi+1+mvrespa.Cantr
								ENDIF
							ELSE
								cr=cur_ultar.art_codi+1
							ENDIF
						ENDIF
						thisform.text1.Value=cr
						thisform.text2.SetFocus
					ELSE
						MESSAGEBOX("El último rubro que se encuentra en archivo "+ALLTRIM(STR(cur_nuer.rub_codi))+" - "+ALLTRIM(cur_nuer.rub_desc)+ ;
								   " tiene como último artículo ingresado el código "+ALLTRIM(STR(cur_ultar.art_codi))+" - "+ALLTRIM(cur_ultar.art_desc)+"."+CHR(13)+CHR(13)+ ;
								   "No quedan mas códigos disponibles, consulte con el administrador del sistema.",48,"Aviso del Sistema")
						thisform.estadorub=0
						RETURN 0
					ENDIF
				ENDIF
		ENDCASE
	ENDPROC

	PROCEDURE Command1.Click
		DO case
			CASE thisform.text1.Value=0
				MESSAGEBOX("Aún no ha ingresado ningún código de rubro...",48,"Aviso del Sistema")
			CASE thisform.text1.Value>0 AND LEN(ALLTRIM(thisform.text2.value))=0
				MESSAGEBOX("Debe ingresar una descripción para el código de rubro ingresado...",48,"Aviso del Sistema")
		OTHERWISE
			frmaltar= conectar_db(_screen.cn)
				SQLEXEC(frmaltar,"insert into rubros values(?thisform.text1.value,TRIM(?thisform.text2.value));")
			desconectar_db(frmaltar)
			****************SE CONECTA AL SERVIDOR ILUMET E INGRESA E NUEVO RUBRO*******************
			frmaltar= conectar_db(_screen.xconext)
				SQLEXEC(frmaltar,"insert into rubros values(?thisform.text1.value,TRIM(?thisform.text2.value));")
			desconectar_db(frmaltar)
			****************************************************************************************
			THISFORM.release
		ENDCASE
		
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Text1.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE Text1.GotFocus
		IF thisform.estadorub=0
			thisform.Release
		ENDIF
		
	ENDPROC

	PROCEDURE Text1.Valid
		IF RECCOUNT("cur_locrub")>0
			GO TOP IN cur_locrub
			LOCATE FOR cur_locrub.rub_codi=this.value
			IF FOUND()
					MESSAGEBOX("Código de Rubro ya está en archivo como "+ALLTRIM(cur_locrub.rub_desc)+CHR(13)+ ;
					   "Intente con otro código de rubro",48,"Aviso del Sistema")
				this.Value=0
				RETURN 0
			ENDIF
		ENDIF
		
	ENDPROC

ENDDEFINE


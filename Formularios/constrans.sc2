	PROCEDURE Destroy
		set skip of bar 10 of Consultas .F.
	ENDPROC

	PROCEDURE Init
		public localiz,postal,locali,provi,op,codloca,cp,coditran
		localiz=0
		postal=0
		locali=""
		provi=""
		codloca=0
		op=0
		coditran=0
	ENDPROC

	PROCEDURE Load
		set skip of bar 10 of Consultas .T.
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command2.Click
		IF thisform.Height=445
			thisform.autocenter=.F.
			thisform.Height=570
			this.Caption="\<Ocultar Detalles"
			thisform.autocenter=.T.
		ELSE
			thisform.autocenter=.F.
			thisform.Height=445
			this.Caption="\<Ver Detalles"
			thisform.autocenter=.T.
		ENDIF
			
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command3.Click
		if thisform.label9.visible=.T. and thisform.text5.visible=.T.
			thisform.label9.visible=.F.
			thisform.text5.visible=.F.
		endif
		transporte=""
		do form tranload with transporte,coditran
		if coditran>0
			with thisform
				.text13.value=coditran
				.text1.value=cur_tran.tran_nomb
				.text2.value=cur_tran.tran_domi
				.text6.value=cur_tran.cp_nro
				codp=cur_tran.cp_codi
				codloca=cur_tran.loca_codi
				.text3.value=cur_tran.loca_nomb
				.text4.value=cur_tran.provi_nomb
				.text11.value="0"+allt(cur_tran.tran_cartel)
				.text7.value=allt(cur_tran.tran_tel1)
				.text10.value=allt(cur_tran.tran_tel2)
				.text8.value=cur_tran.tran_cel
				.text9.value=cur_tran.tran_email
				.edit1.value=cur_tran.tran_deta
				do case
					case cond_codi=1
						.optiongroup1.value=1
					case cond_codi=2
						.optiongroup1.value=2
						.label9.visible=.T.
						.text5.visible=.T.
						.text5.value=cur_tran.tran_cuit
					case cond_codi=3
						.optiongroup1.value=3
					case cond_codi=4
						.optiongroup1.value=4
					case cond_codi=5
						.optiongroup1.value=5
				ENDCASE
				.text1.setfocus
			endwith
		endif
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Text4.LostFocus
		if this.value<>" "
			sele provincias
			set order to provi_nomb
			seek allt(this.value)
			if !found()
				set order to provi_codi
				go bott
				pro=provi_codi+1
				appe blank
				repla provi_codi with pro
				repla provi_nomb with allt(this.value)
				sele localidades
				repla provi_codi with pro
			else
				sele localidades
				repla provi_codi with provincias.provi_codi
				sele provincias
				set order to provi_codi
			endif
		endif
	ENDPROC

	PROCEDURE Text4.Valid
		if this.value=" " and last()<>-4
			messagebox("Debe ingresar la Provincia",0+48,"Advertencia!!!")
			return 0
		endif
	ENDPROC

ENDDEFINE


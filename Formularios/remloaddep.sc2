	PROCEDURE Activate
		if codicli=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE Init
		parameter codicli
		public cond,i,nrorem,postal,provi,locali
		postal=0
		provi=""
		locali=""
		set date british
		set cent on
		if codicli=0
			sele clientes
			go top
			do form cliload with codicli,postal,provi,locali
			cond=cond_codi
		else
			sele clientes
			set order to cli_codi
			seek codicli
			with thisform
				.text1.value=cli_nomb
				.text2.value=cli_domi
				.text6.value=condiva.cond_desc
				.text12.value=cli_cuit
				.text3.value=codipostales.cp_nro
				.text4.value=localidades.loca_nomb
				.text5.value=provincias.provi_nomb
				.list1.rowsourcetype=3
				.list1.rowsource="select rem_nro,rem_fech from remitos where cli_codi=codicli order by rem_nro desc INTO CURSOR list1"
			endwith
		endif
		
	ENDPROC

	PROCEDURE Command1.Click
		local paso
		paso=0
		if thisform.grid1.rows>1
			paso=1
			x=1
			do while thisform.grid1.rows>2
				thisform.grid1.removeitem(x)
			enddo
			with thisform
				.grid1.col=0
				.grid1.text=" "
				.grid1.col=1
				.grid1.text=" "
			endwith
		endif
		for i=1 to thisform.list1.listcount
			if thisform.list1.selected(i)
				thisform.list1.selected(i)=.F.
			endif
		next i
		sele clientes
		set order to cli_nomb
		do form cliload with codicli
		cond=cond_codi
		set order to cli_codi
		with thisform
			.text1.value=cli_nomb
			.text2.value=cli_domi
			.text6.value=condiva.cond_desc
			.text12.value=cli_cuit
			.text3.value=codipostales.cp_nro
			.text4.value=localidades.loca_nomb
			.text5.value=provincias.provi_nomb
			.list1.rowsourcetype=3
			.list1.rowsource="select rem_nro,rem_fech from remitos where cli_codi=codicli order by rem_nro desc INTO CURSOR list1"
			.command2.enabled=.F.
		endwith
	ENDPROC

	PROCEDURE Command2.Click
		nrorem=val(thisform.list1.value)
		do form consremitodep with nrorem
		thisform.release
		
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE List1.Click
		local paso
		paso=0
		if thisform.grid1.rows>1
			paso=1
			x=1
			do while thisform.grid1.rows>2
				thisform.grid1.removeitem(x)
			enddo
			with thisform
				.grid1.col=0
				.grid1.text=" "
				.grid1.col=1
				.grid1.text=" "
			endwith
		endif
		sele remitos_articulos
		set order to rem_nro
		seek this.value
		if found()
			do while rem_nro=val(this.value) and !eof()
				if thisform.grid1.rows=2 and paso=1
					with thisform
						.grid1.col=0
						cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
						.grid1.text=cadena
						.grid1.col=1
						if art_codi=4
							.grid1.text=artrem_dasc
						else
							if artrem_ddesc<>""
								.grid1.text=artrem_ddesc
							else
								.grid1.text=articulos.art_desc
							endif
						endif
					endwith
					paso=0
				else
					cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
					if art_codi=4
						thisform.grid1.additem(cadena+chr(9)+artrem_dasc)
					else
						thisform.grid1.additem(cadena+chr(9)+articulos.art_desc)
						if artrem_ddesc<>""
							thisform.grid1.col=1
							thisform.grid1.text=artrem_ddesc
						endif
					endif
				endif
				skip
			enddo
		endif
		thisform.command2.enabled=.T.
	ENDPROC

	PROCEDURE Text1.GotFocus
		if codicli<>0
			with thisform
				.text1.value=cli_nomb
				.text2.value=cli_domi
				.text6.value=condiva.cond_desc
				.text12.value=cli_cuit
				.text3.value=codipostales.cp_nro
				.text4.value=localidades.loca_nomb
				.text5.value=provincias.provi_nomb
				.list1.rowsourcetype=3
				.list1.rowsource="select rem_nro,rem_fech from remitos where cli_codi=codicli order by rem_nro desc INTO CURSOR list1"
			endwith
		endif
		
	ENDPROC

ENDDEFINE

	PROCEDURE Activate
		if codiprov=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE buscarordenesporarticulo
		LPARAMETERS tnArtCodi
		LOCAL frmordlo
		
		IF EMPTY(tnArtCodi) OR tnArtCodi=0
			RETURN .F.
		ENDIF
		
		thisform.grid1.Rows=1
		thisform.command2.Enabled=.F.
		
		IF USED("cur_ol")
			USE IN cur_ol
		ENDIF
		
		frmordlo = conectar_db(_screen.cn)
		
		SQLEXEC(frmordlo, ;
			"select distinct c.orden_codi,c.orden_fech,c.moneda " + ;
			"from compras c " + ;
			"inner join compras_articulos ca on c.orden_codi=ca.orden_codi " + ;
			"where c.prov_codi=?codiprov and c.anulado<>'S' and ca.art_codi=?tnArtCodi " + ;
			"order by c.orden_fech desc;", ;
			"cur_ol")
		
		desconectar_db(frmordlo)
		
		IF USED("cur_ol") AND RECCOUNT("cur_ol")>0
			thisform.lst_compras.RowSource="cur_ol"
			thisform.lst_compras.Requery()
			thisform.lst_compras.Selected(1)=.T.
			thisform.CargarDetalleOrden()
			thisform.command2.Enabled=.T.
		ELSE
			thisform.lst_compras.RowSource=""
			thisform.grid1.Rows=1
			thisform.command2.Enabled=.F.
			MESSAGEBOX("No existen órdenes de compra del proveedor con ese artículo.",48,"Aviso")
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargardetalleorden
		LOCAL contador, frmordlo, cadena, div, longdes, lnRowMatch
		LOCAL lcDescri, lcMask
		
		contador = 1
		lnRowMatch = 0
		
		thisform.grid1.Rows = 1
		
		IF !USED("cur_ol")
			RETURN
		ENDIF
		
		IF EOF("cur_ol")
			RETURN
		ENDIF
		
		SET DECIMALS TO 4
		
		frmordlo = conectar_db(_screen.cn)
		SQLEXEC(frmordlo, ;
			"select a.art_codi,b.art_desc,a.artord_dasc,a.artord_precio,a.dap_codi,c.* " + ;
			"from compras_articulos a " + ;
			"inner join articulos b on a.art_codi=b.art_codi " + ;
			"left outer join desc_articulos_proveedores c on c.dap_codi=a.dap_codi " + ;
			"where a.orden_codi=?cur_ol.orden_codi;", ;
			"cur_ordalo")
		desconectar_db(frmordlo)
		
		SET DECIMALS TO
		
		IF RECCOUNT("cur_ordalo")>0
			SELECT cur_ordalo
			GO TOP
		
			SCAN
				cadena = REPL("0",8-LEN(ALLT(STR(cur_ordalo.art_codi)))) + ALLT(STR(cur_ordalo.art_codi))
		
				IF cur_ordalo.art_codi=4 OR cur_ordalo.art_codi=5
					lcDescri = cur_ordalo.artord_dasc
				ELSE
					lcDescri = IIF(cur_ordalo.dap_codi>0,cur_ordalo.dap_desc,cur_ordalo.art_desc)
				ENDIF
				
				lcMask = ICASE(cur_ol.moneda="D","USD 999,999,999.99",cur_ol.moneda="P","$ 999,999,999.99")
		
				thisform.grid1.AddItem(ALLT(STR(contador))+CHR(9)+cadena+CHR(9)+lcDescri+CHR(9)+TRANSFORM(cur_ordalo.artord_precio, lcMask))
		
				WITH thisform
					.grid1.Row = .grid1.Rows-1
		
					.grid1.Col = 0
					.grid1.CellAlignment = 3
		
					.grid1.Col = 1
					.grid1.CellAlignment = 3
		
					.grid1.Col = 2
					.grid1.CellAlignment = 0
		
					IF LEN(ALLT(lcDescri))>47
						div = LEN(ALLT(lcDescri))/47
						IF div>INT(div)
							longdes = INT(div)+1
						ELSE
							longdes = div
						ENDIF
						longdes = longdes*250
						.grid1.RowHeight(.grid1.Row)=longdes
					ELSE
						.grid1.RowHeight(.grid1.Row)=270
					ENDIF
		
					.grid1.Col = 3
					.grid1.CellAlignment = 8
				ENDWITH
		
				IF PEMSTATUS(thisform,"xArtFiltro",5) AND thisform.xArtFiltro>0
					IF cur_ordalo.art_codi = thisform.xArtFiltro
						lnRowMatch = thisform.grid1.Rows-1
					ENDIF
				ENDIF
		
				contador = contador + 1
			ENDSCAN
		
			thisform.command2.Enabled = .T.
		
			IF lnRowMatch > 0
				WITH thisform
					.grid1.Row = lnRowMatch
		
					.grid1.Col = 0
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					.grid1.Col = 1
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					.grid1.Col = 2
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					.grid1.Col = 3
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					.grid1.Row = lnRowMatch
				ENDWITH
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER codiprov
		PUBLIC cond,i,codc,valorcadena
		
		IF !PEMSTATUS(thisform,"xArtFiltro",5)
			thisform.AddProperty("xArtFiltro",0)
		ENDIF
		
		SET DATE BRITISH
		SET CENT ON
		SET DELE ON
		pascpra=0
		
		WITH thisform
			IF codiprov=0
				DO FORM provload WITH proveedor,codiprov
				cond=cond_codi
				.text1.Value=cur_prov.prov_nomb
				.text2.Value=cur_prov.prov_domi
				.text6.Value=cur_prov.cond_desc
				.text12.Value=cur_prov.prov_cuit
				.text3.Value=cur_prov.cp_nro
				.text4.Value=cur_prov.loca_nomb
				.text5.Value=cur_prov.provi_nomb
			ELSE
				frmordlo=conectar_db(_screen.cn)
				SQLEXEC(frmordlo,"call usp_buscarprov(?codiprov);","cur_prov")
				desconectar_db(frmordlo)
		
				.text1.Value=cur_prov.prov_nomb
				.text2.Value=cur_prov.prov_domi
				.text6.Value=cur_prov.cond_desc
				.text12.Value=cur_prov.prov_cuit
				.text3.Value=cur_prov.cp_nro
				.text4.Value=cur_prov.loca_nomb
				.text5.Value=cur_prov.provi_nomb
			ENDIF
			this.text7.Value=0
			frmordlo=conectar_db(_screen.cn)
			SQLEXEC(frmordlo,"select orden_codi,orden_fech, moneda from compras where prov_codi=?codiprov and anulado<>'S' ORDER BY orden_fech DESC;","cur_ol")
			desconectar_db(frmordlo)
		
			IF RECCOUNT("cur_ol")>0
				.lst_compras.RowSource="cur_ol"
				.lst_compras.Selected(1)=.T.
				.command2.Enabled=.T.
				.lst_compras.setfocus
				thisform.CargarDetalleOrden()
			ENDIF
		ENDWITH
	ENDPROC

	PROCEDURE modificacom
		LOCAL xcomcod
		
		xcomcod = cur_ol.orcodi
		
		DO FORM modiocpra WITH cur_ol.orden_codi,cur_prov.cond_codi
		
		LOCATE FOR cur_ol.orden_codi = xcomcod
		
		RETURN
		
	ENDPROC

	PROCEDURE recargarordenesproveedor
		thisform.grid1.Rows = 1
		thisform.xArtFiltro = 0
		thisform.label11.Caption = ""
		thisform.text7.Value = 0
		
		frmordlo = conectar_db(_screen.cn)
		SQLEXEC(frmordlo,"select orden_codi,orden_fech,moneda from compras where prov_codi=?codiprov and anulado<>'S' ORDER BY orden_fech DESC;","cur_ol")
		desconectar_db(frmordlo)
		
		IF RECCOUNT("cur_ol")>0
			thisform.lst_compras.RowSource = "cur_ol"
			thisform.lst_compras.Selected(1)=.T.
			thisform.command2.Enabled=.T.
			thisform.lst_compras.SetFocus
			thisform.CargarDetalleOrden()
		ELSE
			thisform.lst_compras.RowSource = ""
			thisform.command2.Enabled=.F.
		ENDIF
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL paso
		paso=0
		proveedor=""
		thisform.grid1.Rows=1
		
		WITH thisform
			.xArtFiltro = 0
			.text7.Value = 0
			.label11.Caption = ""
		
			DO FORM provload WITH proveedor,codiprov
			cond=cond_codi
		
			.text1.Value=cur_prov.prov_nomb
			.text2.Value=cur_prov.prov_domi
			.text6.Value=cur_prov.cond_desc
			.text12.Value=cur_prov.prov_cuit
			.text3.Value=cur_prov.cp_nro
			.text4.Value=cur_prov.loca_nomb
			.text5.Value=cur_prov.provi_nomb
		
			frmordlo=conectar_db(_screen.cn)
			SQLEXEC(frmordlo,"select orden_codi,orden_fech, moneda from compras where prov_codi=?codiprov and anulado<>'S' ORDER BY orden_fech DESC;","cur_ol")
			desconectar_db(frmordlo)
		
			IF RECCOUNT("cur_ol")>0
				.lst_compras.RowSource="cur_ol"
				.lst_compras.Selected(1)=.T.
				.command2.Enabled=.T.
				.lst_compras.setfocus
				thisform.CargarDetalleOrden()
			ELSE
				.lst_compras.RowSource=""
				.command2.Enabled=.F.
			ENDIF
		ENDWITH
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		&& ordenload.command2.click
		
		do case
			case valorcadena="Por Orden de Compra"
				codc=cur_ol.orden_codi
				cond=cur_prov.cond_codi
				do form itemsrec with codc,cond,codiprov
				thisform.release
			case valorcadena="Ordenes Compra"
				codc=cur_ol.orden_codi
				cond=cur_prov.cond_codi
				do form modiocpra with codc,cond
				thisform.release
			case valorcadena="Compras"
				codc=cur_ol.orden_codi
				cond=cur_prov.cond_codi
				do form consocpra with codc,cond
				thisform.release
			case valorcadena="Anulación de Ordenes de Compra"
				codc=cur_ol.orden_codi
				cond=cur_prov.cond_codi
				do form anulaocpra with codc,cond
				thisform.release
		endcase
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		LOCAL frmord
		
		codigo = 0
		
		DO FORM artload WITH codigo
		
		IF codigo>0
			thisform.xArtFiltro = codigo
			thisform.text8.Value = codigo
		
			frmord = conectar_db(_screen.cn)
			SQLEXEC(frmord,"select art_desc from articulos where art_codi=?codigo;","cur_artbus")
			desconectar_db(frmord)
		
			IF USED("cur_artbus") AND RECCOUNT("cur_artbus")>0
				thisform.label8.Caption = ALLTRIM(cur_artbus.art_desc)
			ELSE
				thisform.label8.Caption = ""
			ENDIF
		
			thisform.BuscarOrdenesPorArticulo(codigo)
		ENDIF
	ENDPROC

	PROCEDURE Command4.GotFocus
		RETURN
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE lst_compras.Click
		thisform.CargarDetalleOrden()
	ENDPROC

	PROCEDURE lst_compras.KeyPress
		&& ordenload.lst_compras.keypress
		
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		* Enter sobre la lista = mismo comportamiento que botón Aceptar
		IF nKeyCode = 13
		
			* Evita que VFP siga procesando el Enter
			NODEFAULT
		
			* Validaciones defensivas
			IF !USED("cur_ol") OR RECCOUNT("cur_ol") = 0
				RETURN
			ENDIF
		
			IF EOF("cur_ol") OR BOF("cur_ol")
				RETURN
			ENDIF
		
			IF PEMSTATUS(THISFORM, "Command2", 5)
				IF THISFORM.Command2.Enabled
					THISFORM.Command2.Click()
				ENDIF
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE lst_compras.RightClick
		IF USED("cur_ol")
			LOCAL lcShortcut, loRef
			m.loRef = thisform
			m.lcShortcut = SYS(2015)
		
			DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
			DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Consultar Orden de Compra] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
			DEFINE BAR 2 OF (m.lcShortcut) PROMPT [Modificar Orden de Compra] PICTURE "C:\VFP9_MYSQL\imagen\misc_1_911.ico"
			
			ON SELECTION BAR 1 OF (m.lcShortcut) DO FORM consocpra WITH cur_ol.orden_codi,cur_prov.cond_codi
			ON SELECTION BAR 2 OF (m.lcShortcut) m.loRef.modificacom()
				
			ACTIVATE POPUP (m.lcShortcut)
			RELEASE POPUP (m.lcShortcut)
		ENDIF
	ENDPROC

	PROCEDURE Text7.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text7.InteractiveChange
		LOCAL lccadena
		lccadena = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lccadena) OR lccadena="0"
			thisform.RecargarOrdenesProveedor()
		ENDIF
	ENDPROC

	PROCEDURE Text7.LostFocus
		RETURN
	ENDPROC

	PROCEDURE Text7.Valid
		LOCAL lncodigoart, lccadena, frmordlo
		
		lccadena = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lccadena) OR lccadena="0"
			thisform.RecargarOrdenesProveedor()
			RETURN .T.
		ENDIF
		
		lncodigoart = VAL(lccadena)
		
		IF lncodigoart<=0
			thisform.xArtFiltro = 0
			thisform.label8.Caption = ""
			RETURN .T.
		ENDIF
		
		frmordlo = conectar_db(_screen.cn)
		SQLEXEC(frmordlo,"select art_desc from articulos where art_codi=?lncodigoart;","cur_artbus")
		desconectar_db(frmordlo)
		
		IF USED("cur_artbus") AND RECCOUNT("cur_artbus")>0
			thisform.xArtFiltro = lncodigoart
			thisform.label8.Caption = ALLTRIM(cur_artbus.art_desc)
			thisform.BuscarOrdenesPorArticulo(lncodigoart)
		ELSE
			thisform.xArtFiltro = 0
			thisform.label8.Caption = ""
			MESSAGEBOX("No existe un artículo con ese código.",48,"Aviso")
		ENDIF
		
		RETURN .T.
	ENDPROC

ENDDEFINE

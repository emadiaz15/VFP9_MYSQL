DEFINE CLASS gasload AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblartload" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtgasload" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lstgasto" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 202,213,209
		BorderStyle = 0
		Caption = "Tipos de Gastos"
		DoCreate = .T.
		Height = 295
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "GASLOAD"
		Width = 297
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'lblartload' AS label WITH ;
		Alignment = 2, ;
		AutoSize = .F., ;
		BackColor = 202,213,209, ;
		Caption = "Gastos", ;
		FontBold = .T., ;
		FontSize = 10, ;
		ForeColor = 0,0,0, ;
		Height = 18, ;
		Left = 24, ;
		Name = "lblartload", ;
		TabIndex = 3, ;
		Top = 14, ;
		Width = 108
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lstgasto' AS listbox WITH ;
		BoundColumn = 2, ;
		ColumnCount = 2, ;
		ColumnWidths = "35,250", ;
		FontBold = .T., ;
		Height = 183, ;
		ItemBackColor = 255,255,255, ;
		ItemTips = .T., ;
		Left = 23, ;
		Name = "lstgasto", ;
		RowSource = "''", ;
		RowSourceType = 2, ;
		TabIndex = 2, ;
		Top = 65, ;
		Width = 250
		*< END OBJECT: BaseClass="listbox" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackColor = 194,198,176, ;
		BackStyle = 0, ;
		Height = 245, ;
		Left = 11, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;
		Top = 22, ;
		Width = 277
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'txtgasload' AS textbox WITH ;
		BackColor = 255,255,255, ;
		FontBold = .T., ;
		Format = "!", ;
		Height = 23, ;
		Left = 23, ;
		Name = "txtgasload", ;
		SelectOnEntry = .T., ;
		TabIndex = 1, ;
		Top = 38, ;
		Width = 248
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		parameter codigo,nombre
		public d
		d=1
		
		frmtipgas= conectar_db(_screen.cn)
			SQLEXEC(frmtipgas,"select CAST(TRIM(CAST(tipgas_codi as char)) as DECIMAL(8,0)) as tipgas_codi,tipgas_desc from tiposgastos order by tipgas_desc;","cur_tipg")
		desconectar_db(frmtipgas)
		
		IF RECCOUNT("cur_tipg")>0
			GO top
			thisform.lstgasto.RowSource="cur_tipg"
		ENDIF
		
		
	ENDPROC

	PROCEDURE Unload
		return codigo
		return nombre
	ENDPROC

	PROCEDURE lstgasto.Click
		codigo=cur_tipg.tipgas_codi
		nombre=cur_tipg.tipgas_desc
		regigastos.text2.value=codigo
		regigastos.label2.caption=allt(nombre)
		thisform.release
	ENDPROC

	PROCEDURE lstgasto.GotFocus
		if last()=24 or last()=5
			thisform.txtgasload.setfocus
		endif
	ENDPROC

	PROCEDURE lstgasto.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE txtgasload.InteractiveChange
		local lc
		lc = allt(This.Value)
		if last()<>127 and last()<>7
			do while !eof()
				if lc=subst(cur_tipg.tipgas_desc,1,len(lc))
					exit
				else
					skip
					d=d+1
					if eof()
						go top
						d=1
						exit
					endif
				endif
			enddo
		else
			do while lc=subst(cur_tipg.tipgas_desc,1,len(lc)) and d>1
				if bof()
					exit
				endif
				skip-1
				if d>1
					d=d-1
				endif
				if lc<>subst(cur_tipg.tipgas_desc,1,len(lc))
					skip
					d=d+1
					exit
				endif
			enddo				
		endif
		thisform.lstgasto.selected(d)=.T.
		return
		
	ENDPROC

	PROCEDURE txtgasload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
					codigo=cur_tipg.tipgas_codi
					nombre=cur_tipg.tipgas_desc
					regigastos.text2.value=codigo
					regigastos.label2.caption=allt(nombre)
					thisform.release
			case last()=5
				if d>1
					d=d-1
				endif
				thisform.lstgasto.selected(d)=d
				this.value=thisform.lstgasto.value
			case last()=24
				if d<thisform.lstgasto.listcount
					d=d+1
				endif
				thisform.lstgasto.selected(d)=d
				this.value=thisform.lstgasto.value
			case last()=27
				thisform.release
		endcase
	ENDPROC

ENDDEFINE

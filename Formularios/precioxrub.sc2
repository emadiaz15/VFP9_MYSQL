		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE btn_imprimir.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE btn_imprimir.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE Command1.Click
		sele temprecio
		SET SAFETY OFF
		ZAP
		SET SAFETY ON
		rubroc=0
		rubrod=''
		do form rubload with rubroc,rubrod TO lorub
		if lorub.xcodrub>0
			frmprerub= conectar_db(_screen.cn)
				SQLEXEC(frmprerub,"select * from rubros where rub_codi=?lorub.xcodrub;","cur_rubr")
			desconectar_db(frmprerub)
			IF RECCOUNT("cur_rubr")>0
				thisform.rubroc=cur_rubr.rub_codi
				thisform.text2.value=cur_rubr.rub_desc
			ENDIF
			thisform.text3.setfocus
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		thisform.grid1.RecordSource=''
		thisform.grid1.Refresh()
		thisform.shp_imprimir.Visible= .F.
		thisform.btn_imprimir.Visible= .F.
		thisform.btn_exportar.Visible= .F.
		SELECT temprecio
		SET SAFETY off
		ZAP
		SET safety ON
		coeficiente=thisform.text3.value
		thisform.dolar=thisform.text1.value
		frmprerub= conectar_db(_screen.cn)
			SQLEXEC(frmprerub,"select * from articulos;","cur_artis")
			INDEX on art_codi TO SYS(2015)
			SQLEXEC(frmprerub,"call usp_precioxrub(?thisform.rubroc,?thisform.dolar);","tempcosto1")
			SET RELATION TO art_codi INTO cur_artis addi
		desconectar_db(frmprerub)
		GO top
		scan
			insert into temprecio(art_codi,art_desc,anterior,actual) ;
				values(cur_artis.art_codi,cur_artis.art_desc,cur_artis.art_precio, ;
		        		tempcosto1.artpro_ctovta*coeficiente)
		   	IF readolar>0
				UPDATE temprecio SET actual=actual/readolar WHERE art_codi=cur_artis.art_codi
		   	ENDIF
			SELECT tempcosto1
		endscan
		SELECT temprecio
		GO top
		thisform.grid1.recordsource="temprecio"
		thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
		thisform.command4.enabled=.T.
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		pregunta=messagebox("¿Confirma la modificación a efectuar?",4+48+256,"Costos")
		if pregunta=6
			Local lnCantidadDatos, lnI, lnJ, lnPorcentaje, xarti, conexterna
		
			SELECT COUNT(art_codi) as cantidad FROM temprecio INTO CURSOR cur_cant
					
			SELECT temprecio
			LOCATE
			thisform.shape2.Visible= .T.
			thisform.Progreso1.Visible=.T.
			lnCantidadDatos=cur_cant.cantidad
			FOR lnI = 1 TO lnCantidadDatos
				xarti = temprecio.art_codi
				frmprevta= conectar_db(_screen.cn)
					SQLEXEC(frmprevta,"update articulos set art_precio=?temprecio.actual where art_codi=?xarti;")
				desconectar_db(frmprevta)
				******************** SE CONECTA AL SERVIDOR ILUMET Y MODIFICA PRECIO DE VENTA ********************
				conexterna = conectar_db(_screen.xconext)
				IF VARTYPE(conexterna)="N" AND conexterna>0
					SQLEXEC(conexterna,"update articulos set art_precio=?temprecio.actual where art_codi=?xarti;")
					desconectar_db(conexterna)
				ENDIF
				***************** FIN PROCESO SERVIDOR ILUMET *****************************				
				lnPorcentaje             = lnI * 100 / lnCantidadDatos
			    ThisForm.Progreso1.Value = lnPorcentaje
			    skip
			ENDFOR
		
			=messagebox("Los precios fueron actualizados satisfactoriamente",0+64,"Precios de Venta")
			thisform.Progreso1.visible=.F.
			thisform.shape2.Visible= .F.	
			thisform.shp_imprimir.Visible= .T.
			thisform.btn_imprimir.Visible= .T.
			thisform.btn_exportar.Visible= .T.
		endif
		
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command5.Click
		thisform.release
	ENDPROC

	PROCEDURE Command5.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command5.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Optiongroup1.Click
		IF this.Value=1
			thisform.lbl_dolariza.Visible= .T.
			thisform.txt_dolariza.Visible= .T.
			frmprevta= conectar_db(_screen.cn)
				SQLEXEC(frmprevta,"select * from parametros where param_codi=11;","cur_read")
			desconectar_db(frmprevta)
			thisform.txt_dolariza.Value=IIF(cur_read.param_impo>0,thisform.text1.value*((100-cur_read.param_impo)/100),thisform.text1.value)
			readolar=thisform.txt_dolariza.Value
			thisform.txt_dolariza.SetFocus
		ELSE
			thisform.lbl_dolariza.Visible= .F.
			thisform.txt_dolariza.Visible= .F.
			thisform.txt_dolariza.Value=0
			readolar=0
			thisform.command3.SetFocus
		endif	
	ENDPROC

	PROCEDURE Text3.LostFocus
		if this.value>0
			thisform.command3.enabled=.T.
		endif
	ENDPROC

	PROCEDURE txt_dolariza.LostFocus
		readolar=this.Value
		
	ENDPROC

ENDDEFINE

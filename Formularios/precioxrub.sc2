	PROCEDURE Destroy
		set point to
	ENDPROC

	PROCEDURE GotFocus
		set point to "."
	ENDPROC

	PROCEDURE Init
		public coeficiente,rubroc,preg,readolar
		readolar=0
		
		create cursor tempcosto1(art_codi N(8),artpro_costo N(10,3),artpro_ctovta N(10,3),moneda C(1))
		create cursor temprecio(art_codi N(8),art_desc C(45),anterior N(10,3),actual N(10,3))
		create cursor temparticulo(art_codi N(8),art_desc C(45),art_precio N(10,3))
		this.text3.value=0
		frmprerub= conectar_db(_screen.cn)
			SQLEXEC(frmprerub,"select param_impo from parametros where param_codi=9;","cur_cotiz")
		desconectar_db(frmprerub)
		IF RECCOUNT("cur_cotiz")>0
			this.text1.value=cur_cotiz.param_impo
			thisform.dolar=cur_cotiz.param_impo
		ENDIF
		
		Cerrar_Cursor("cur_cotiz")
		coeficiente=0
		rubroc=0
		preg=0
		set point to "."
	ENDPROC

	PROCEDURE LostFocus
		set point to
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(200,200,200)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE btn_exportar.btn.Click
		do form exportarxls
	ENDPROC

	PROCEDURE btn_exportar.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE btn_exportar.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE btn_exportar.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE btn_imprimir.btn.Click
		do listaprecios
	ENDPROC

	PROCEDURE btn_imprimir.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord

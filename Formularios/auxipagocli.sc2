	PROCEDURE Init
		public codicli,coditipag,numero,banco,plaza,fechavto,valor,totval,cond, ;
		       valoriva,borra,impotot,contador,codrec,paso,importe,vuelto,totalfac, ;
		       totcred,pregsaldo,cuit,codrecpag,auxiliar,coef,coefc,paso
		set dele on
		create cursor fac(fac_codi N(8),fac_pto N(4),fac_nro N(8),imp_pag N(10,2),fac_conc C(1),altiva N(10,2),ivand N(10,2),ivanc N(10,2))
		create cursor totalcbtes(conc C(3),punto N(4),numero N(8),impabona N(10,2))
		coef=0
		vuelto=0
		codicli=0
		coditipag=0
		numero=""
		banco=""
		plaza=""
		fechavto=ctod("  /  /    ")
		valor=0
		totval=0
		borra=0
		importe=0
		totalfac=0
		totcred=0
		pregsaldo=0
		cuit=0
		codrecpag=0
		auxiliar=0
		paso=0
		with this
			.text7.value=0
			.text8.value=0
			.text9.value=0
		endwith
		sele clientes
		go top
		do form cliload with codicli
		with thisform
			.text13.value=date()
			.text10.value=0
			.text7.value=0
			.text8.value=0
			.text9.value=0
			.text1.value=cli_nomb
			.text2.value=cli_domi
			.text6.value=condiva.cond_desc
			.text12.value=cli_cuit
			.text3.value=codipostales.cp_nro
			.text4.value=localidades.loca_nomb
			.text5.value=provincias.provi_nomb
			cuit=cli_cuit
			cond=cond_codi
			SELECT a.fac_codi,a.fac_tipo,a.fac_pto,a.fac_nro,a.fac_tot,a.imp_pag,a.fac_conc, ;
				(b.iva_1/100)+1 as "valoriva",a.altiva_1 as "altiva",ivand,ivanc FROM facturas as a ;
				inner join iva as b on a.iva_codi=b.iva_codi WHERE a.pagado<>"S" ;
				AND a.anulado<>"S" AND a.cli_codi=codicli order by a.fac_codi INTO CURSOR fac
		*a.fac_conc desc,		
			go top
			i=1
			scan
				do case
					case fac_conc="F"
						.list1.list(i,1)="FAC"
					case fac_conc="N"
						.list1.list(i,1)="NC"
					case fac_conc="D"
						.list1.list(i,1)="ND"
				endcase
				.list1.list(i,2)=allt(str(fac_pto))
				.list1.list(i,3)=str(fac_nro)
				if fac_conc="D"
					coef=round((ivand/fac_tot)+1,5)
				endif
				if fac_conc="N"
					coefc=round((ivanc/fac_tot)+1,5)
				endif
				.list1.list(i,4)=str(iif(fac_tipo='A',iif(altiva=0,iif(fac_conc="D",round(fac_tot*iif(ivand=0,1,coef),2);
					,iif(fac_conc="N",round(fac_tot*iif(ivanc=0,1,coefc),2),fac_tot*valoriva))-iif(fac_conc="D",round(imp_pag*iif(ivand=0,1,coef),2),iif(fac_conc="N",round(imp_pag*iif(ivanc=0,1,coefc),2),imp_pag*valoriva)),fac_tot* ;
					(altiva/100+1)-imp_pag*(altiva/100+1)),fac_tot-imp_pag),10,2)
				if fac_conc="N"
					.list1.list(i,4)="-"+allt(.list1.list(i,4))
				endif
				if i=1
					.list1.list(i,5)=str(val(.list1.list(i,5))+val(.list1.list(i,4)),10,2)
				else
					.list1.list(i,5)=str(val(.list1.list(i-1,5))+val(.list1.list(i,4)),10,2)
				endif
				i=i+1
			endscan		
		endwith
		
	ENDPROC

	PROCEDURE Command1.Click
		pregunta=messagebox("¿Seguro que desea salir?",4+48+256,"Advertencia")
		do case
			case pregunta=6
				thisform.release
			case pregunta=7
				if totval<thisform.text7.value
					thisform.command3.click()
				endif
		endcase
	ENDPROC

	PROCEDURE Command2.Click
		contador=0
		totalfac=0
		totcred=0
		with thisform
			.list1.boundcolumn=3
			for i=1 to .list1.listcount
				if .list1.selected(i)
					if .list1.list(i,1)="NC"
						.text8.value=.text8.value+abs(val(.list1.list(i,4)))
						totcred=totcred+abs(val(.list1.list(i,4)))
					else
						.text9.value=.text9.value+val(.list1.list(i,4))
						totalfac=totalfac+val(.list1.list(i,4))
					endif
					contador=contador+1
				endif
			next i
			.text7.value=totalfac-totcred
			.command3.enabled=.T.
		*	if contador>10
		*		sigue=messagebox("Ud. ha seleccionado mas de 2 facturas, no puede detallar mas de 2 comprobantes por recibo. "+;
		*		                 "¿Continúa con todas las facturas seleccionadas?"+chr(13)+ ;
		*		                 chr(13)+ ;
		*		                 "Si Ud elije continuar el sistema interpreta que no va a imprimir el Recibo",4+48+256,"Advertencia!!!")
		*		if sigue=7
		*			i=.list1.listcount
		*			do while i>10
		*				if .list1.selected(i)
		*					.text9.value=.text9.value-val(.list1.list(i,3))
		*					.list1.selected(i)=.F.
		*					contador=contador-1
		*				endif
		*				i=i-1
		*			enddo
		*		 endif
		*	endif
		endwith
		
	ENDPROC

	PROCEDURE Command3.Click
		with thisform
			paso=0
			.MDIForm=.T.
			.WindowState=2
			.list1.enabled=.F.
			.command2.enabled=.F.
			valor=.text7.value
			impotot=valor
			do while totval<.text7.value
				do form datospago with coditipag,numero,banco,plaza,fechavto,valor,totval,impotot,cuit
				if last()=27
					thisform.command1.click()
					exit
				endif
				sele tipospago
				set order to tippag_cod
				seek coditipag
				if coditipag=3
					cadenacuit=subst(str(cuit,11),1,2)+"-"+subst(str(cuit,11),3,8)+"-"+right(str(cuit,11),1)
				else
					cadenacuit=""
				endif
				if paso=1
					.olecontrol1.col=0
					.olecontrol1.text=allt(subst(tippag_desc,1,13))
					.olecontrol1.col=1
					.olecontrol1.text=allt(numero)
					.olecontrol1.col=2
					.olecontrol1.text=allt(cadenacuit)
					.olecontrol1.col=3
					.olecontrol1.text=allt(banco)
					.olecontrol1.col=4
					.olecontrol1.text=allt(plaza)
					.olecontrol1.col=5
					.olecontrol1.text=dtoc(fechavto)
					.olecontrol1.col=6
					.olecontrol1.text=allt(str(valor,10,2))
					paso=0
				else
					.olecontrol1.additem(allt(subst(tippag_desc,1,13))+chr(9)+allt(numero)+chr(9)+allt(cadenacuit)+chr(9)+allt(banco)+chr(9)+allt(plaza)+chr(9)+dtoc(fechavto)+chr(9)+allt(str(valor,10,2)))
				endif
			enddo
			if totval>=.text7.value
				.command4.enabled=.T.
				this.enabled=.F.
			endif
		endwith
	ENDPROC

	PROCEDURE Command4.Click
		pregunta=messagebox("¿Confirma los datos ingresados?",4+32+256,"Pagos de Clientes")
		if pregunta=6
			with thisform
				sele recibos
				set reprocess to automatic
				if flock()
					set order to rec_codi
					go bott
					codrec=rec_codi+1
					appe blank
					repla rec_codi with codrec
					repla rec_nro with .text10.value
					repla rec_fec with .text13.value
					repla rec_impo with .text7.value
					repla cli_codi with codicli
					if .list1.listcount>0
					if totalfac>0
						sele recibos_facturas
						for i=1 to .list1.listcount
							if .list1.selected(i)
								appe blank
								repla rec_codi with codrec
								.list1.boundcolumn=1
								sele facturas
								set order to factipo
								if cond=2
									seek allt(.list1.list(i,2))+ALLTRIM(.list1.list(i,3))+"A"
									codifac=fac_codi
									if fac_conc<>"D"
										if fac_conc="N"
											coefc=round((ivanc/fac_tot)+1,5)
										endif
										repla imp_pag with imp_pag+iif(fac_conc="N",round(abs((val(.list1.list(i,4))/iif(ivanc=0,1,coefc))),2),round((val(.list1.list(i,4))/((iif(altiva_1>0,altiva_1,iva.iva_1)/100)+1)),2))
									else
										coef=round((ivand/fac_tot)+1,5)
										repla imp_pag with imp_pag+round(val(.list1.list(i,4))/iif(ivand=0,1,coef),2)
									endif
								else
									seek allt(.list1.list(i,2))+allt(.list1.list(i,3))+"B"
									codifac=fac_codi
									repla imp_pag with imp_pag+iif(fac_conc="N",abs(val(.list1.list(i,4))),val(.list1.list(i,4)))
								endif
								select round(sum(artfac_cant*artfac_impo),2) from facturas_articulos where fac_codi=codifac into array tot
								if val(str(tot[1,1],10,2))=facturas.imp_pag
									repla pagado with "S"
								endif
								set order to fac_codi
								sele recibos_facturas
								repla fac_codi with facturas.fac_codi
								.list1.boundcolumn=3
								repla recfac_impo with val(.list1.list(i,4))
							endif
						next i
					else
						acu=0
						if .list1.listcount>0
							sele totalcbtes
							go top
							scan			
								sele recibos_facturas
								appe blank
								repla rec_codi with codrec
								sele facturas
								set order to factipo
								if cond=2
									seek allt(str(totalcbtes.punto))+allt(str(totalcbtes.numero))+"A"
									codifac=fac_codi
									if fac_conc<>"D"
										if totalcbtes.conc="NC"
											coefc=round((ivanc/totalcbtes.impabona)+1,5)
										endif
										repla imp_pag with imp_pag+iif(totalcbtes.conc="NC",round(abs((totalcbtes.impabona/iif(ivanc=0,1,coefc))),2),round(totalcbtes.impabona/((iif(altiva_1>0,altiva_1,iva.iva_1)/100)+1),2))
									else
										coef=round((ivand/totalcbtes.impabona)+1,5)
										repla imp_pag with imp_pag+round(totalcbtes.impabona/iif(ivand=0,1,coef),2)
									endif
								else
									seek allt(str(totalcbtes.punto))+allt(str(totalcbtes.numero))+"B"
									codifac=fac_codi
									repla imp_pag with imp_pag+iif(totalcbtes.conc="NC",abs(totalcbtes.impabona),totalcbtes.impabona)
								endif
								select round(sum(artfac_cant*artfac_impo),2) from facturas_articulos where fac_codi=codifac into array tot
								if val(str(tot[1,1],10,2))=facturas.imp_pag
									repla pagado with "S"
								endif
								set order to fac_codi
								sele recibos_facturas
								repla fac_codi with facturas.fac_codi
								repla recfac_impo with totalcbtes.impabona
								sele totalcbtes
							endscan
						endif
					endif
					endif
					sele clientes
					set order to cli_codi
					seek codicli
					repla cli_saldo with cli_saldo-.text7.value
			*		if importe<.text7.value
			*			sele saldosiniciales
			*			set order to cli_codi
			*			seek codicli
			*			if found()
			*				dife=.text7.value-importe
			*				if cli_sal>0
			*					if dife<=cli_sal
			*						repla cli_sal with cli_sal-dife
			*					else
			*						repla cli_sal with 0
			*					endif
			*				endif
			*			endif
			*		endif
					sele recibos_pagos
					for i=1 to .olecontrol1.rows-1
						.olecontrol1.row=i
						.olecontrol1.col=0
						sele tipospago
						set order to tippag_des
						seek allt(.olecontrol1.text)
						if tippag_codi=3
							.olecontrol1.col=3
							sele bancos
							set order to ban_desc
							seek allt(.olecontrol1.text)
							if found()
								ban=ban_codi
							endif
						endif
						sele recibos_pagos
						set order to recpag_cod
						go bott
						codrecpag=recpag_codi+1
						appe blank
						repla recpag_codi with codrecpag
						repla rec_codi with codrec
						repla tippag_codi with tipospago.tippag_codi
						.olecontrol1.col=1
						repla movtippag_nro with allt(.olecontrol1.text)
						.olecontrol1.col=2
						if tippag_codi=3
							repla ban_codi with ban
							if len(allt(.olecontrol1.text))>0
								repla cuit_lib with val(subst(allt(.olecontrol1.text),1,2)+subst(allt(.olecontrol1.text),4,8)+right(allt(.olecontrol1.text),1))
							else
								repla cuit_lib with 0
							endif
						else
							repla ban_codi with 0
						endif
						.olecontrol1.col=4
						repla movtippag_pza with allt(.olecontrol1.text)
						.olecontrol1.col=5
						repla movtippag_fvto with ctod(.olecontrol1.text)
						.olecontrol1.col=6
						repla movtippag_imp with val(.olecontrol1.text)
					next i
				endif
				unlock
			endwith
			if pregsaldo=6
				if thisform.text7.value>=saldosiniciales.cli_sal-saldosiniciales.pagado
					repla saldosiniciales.pagado with saldosiniciales.cli_sal
				else
					repla saldosiniciales.pagado with saldosiniciales.pagado+((saldosiniciales.cli_sal-saldosiniciales.pagado)+thisform.text7.value)
				endif
			endif
			thisform.release
		endif
	ENDPROC

	PROCEDURE List1.Click
		with thisform
		*	.text7.value=0
			.text7.fontbold=.F.
			.text7.backcolor=rgb(255,255,255)
			.text7.forecolor=rgb(0,0,0)
			for f=1 to this.listcount
				if this.selected(f)
					.command2.enabled=.T.
					exit
				else
					.command2.enabled=.F.
				endif
			next x
		endwith
	ENDPROC

	PROCEDURE List1.MouseDown
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		with thisform
			.command2.enabled=.T.
		*	.text7.value=0
			.text7.fontbold=.F.
			.text7.backcolor=rgb(255,255,255)
			.text7.forecolor=rgb(0,0,0)
		endwith
		
	ENDPROC

	PROCEDURE Olecontrol1.Click
		*** ActiveX Control Event ***
		thisform.command4.enabled=.F.
		if this.rows>1
			this.col=0
			sele tipospago
			set order to tippag_des
			seek allt(this.text)
			coditipag=tippag_codi	
			this.col=1
			numero=allt(this.text)
			this.col=2
			cuit=val(substr(allt(this.text),1,2)+substr(allt(this.text),4,8)+substr(allt(this.text),13,1))
			this.col=3
			banco=allt(this.text)
			this.col=4
			plaza=allt(this.text)
			this.col=5
			fechavto=ctod(this.text)
			this.col=6
			valor=val(this.text)
			totval=totval-valor
			do form pagopreg with coditipag,numero,banco,plaza,fechavto,valor,totval,impotot,cuit
		endif
		if paso=1
			this.col=0
			sele tipospago
			set order to tippag_cod
			seek coditipag
			this.text=allt(subst(tippag_desc,1,13))
			this.col=1
			this.text=allt(numero)
			this.col=2
			if coditipag=3
				cadenacuit=subst(str(cuit,11),1,2)+"-"+subst(str(cuit,11),3,8)+"-"+right(str(cuit,11),1)
			else
				cadenacuit=""
			endif
			this.text=cadenacuit
			this.col=3
			this.text=allt(banco)
			this.col=4
			this.text=allt(plaza)
			this.col=5
			this.text=dtoc(fechavto)
			this.col=6
			this.text=allt(str(valor,10,2))
		endif
		if borra=6
			this.col=5
			totval=totval-val(this.text)
			this.removeitem(this.row)
			thisform.command3.click()
		endif
		if paso=1 or borra=6
			paso=0
			borra=0
			do while totval<thisform.text7.value
				do form datospago with coditipag,numero,banco,plaza,fechavto,valor,totval,impotot
				if coditipag=0
					thisform.command1.click()
					exit
				endif
				sele tipospago
				set order to tippag_cod
				seek coditipag
				if coditipag=3
					cadenacuit=subst(str(cuit,11),1,2)+"-"+subst(str(cuit,11),3,8)+"-"+right(str(cuit,11),1)
				else
					cadenacuit=""
				endif
				thisform.olecontrol1.additem(allt(subst(tippag_desc,1,13))+chr(9)+allt(numero)+chr(9)+allt(cadenacuit)+chr(9)+allt(banco)+chr(9)+allt(plaza)+chr(9)+dtoc(fechavto)+chr(9)+allt(str(valor,10,2)))
			enddo
			if totval=thisform.text7.value
				thisform.command4.enabled=.T.
			endif
		endif
		
	ENDPROC

	PROCEDURE Text10.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text10.LostFocus
		with thisform
			.shape2.visible=.T.
			.label5.visible=.T.
			.label6.visible=.T.
			.label7.visible=.T.
			.label8.visible=.T.
			.label12.visible=.T.
			.list1.visible=.T.
			.command2.visible=.T.
			.shape4.visible=.T.
			.text7.visible=.T.
			.text8.visible=.T.
			.text9.visible=.T.
			.label9.visible=.T.
			.label13.visible=.T.
			.label14.visible=.T.
			if saldosiniciales.pagado<saldosiniciales.cli_sal
				pregsaldo=messagebox("El cliente posee un Saldo anterior de $ "+allt(str(saldosiniciales.cli_sal-saldosiniciales.pagado,10,2))+"."+chr(13)+ ;
				                     chr(13)+ ;
				                     "¿Ingresa al pago éste saldo total o parcialmente?",4+48+256,"Saldos")
				if pregsaldo=6
					thisform.text9.value=saldosiniciales.cli_sal-saldosiniciales.pagado
					messagebox("Si no desea ingresar el total del saldo anterior, puede modificar el importe en el cuadro Total Facturas",0+48,"Advertencia")
				endif
			endif	
		endwith
	ENDPROC

	PROCEDURE Text10.Valid
		if this.value>0
			sele recibos
			set order to rec_nro
			seek this.value
			if found()
				=messagebox("Recibo ya existe en archivo.",0+48,"Advertencia")
				return 0
			endif
		endif
	ENDPROC

	PROCEDURE Text7.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.LostFocus
		fact=0
		totcred=0
		sele totalcbtes
		if reccount()>0
			dele all
		endif
		go top
		with thisform
			if .list1.listcount>0
				.list1.boundcolumn=3
				for i=1 to .list1.listcount
					if .list1.list(i,1)="NC"
						.text8.value=.text8.value+abs(val(.list1.list(i,4)))
						totcred=totcred+abs(val(.list1.list(i,4)))
					else
						.text9.value=.text9.value+val(.list1.list(i,4))
						fact=fact+val(.list1.list(i,4))
					endif
					auxiliar=fact-totcred
					do case
						case auxiliar<this.value
							inser into totalcbtes(conc,punto,numero,impabona) ;
								  values(allt(.list1.list(i,1)),val(.list1.list(i,2)),val(.list1.list(i,3)),val(.list1.list(i,4)))
						case auxiliar=this.value
							inser into totalcbtes(conc,punto,numero,impabona) ;
								  values(allt(.list1.list(i,1)),val(.list1.list(i,2)),val(.list1.list(i,3)),val(.list1.list(i,4)))
							exit
						case auxiliar>this.value
							diferencia=auxiliar-this.value
							fact=fact-diferencia
							abona=val(.list1.list(i,4))-(val(.list1.list(i,5))-(this.value))
							insert into totalcbtes(conc,punto,numero,impabona) ;
								values(allt(.list1.list(i,1)),val(.list1.list(i,2)),val(.list1.list(i,3)),abona)
							exit
					endcase
				next i
				.text9.value=fact
				.text8.value=totcred
			endif
			if this.value>0
				.command3.enabled=.T.
				.command3.setfocus
			endif
		endwith
	ENDPROC

ENDDEFINE

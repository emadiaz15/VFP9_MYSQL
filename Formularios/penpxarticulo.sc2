	PROCEDURE Init
		public codigo,valorcadena
		set dele on
		valorcadena=prompt()
		codigo=0
		CREATE CURSOR codaux(art_codi N(8))
		create cursor pro(ocpra N(8),fecha D,nombre C(45),rec N(10,2),pend N(10,2))
		dimension tot[1,1]
		this.text1.value=0
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			codigo=0
			.text1.value=0
			do form artload with codigo
			if codigo>0
				frmpendxar= conectar_db(_screen.cn)
					SQLEXEC(frmpendxar,"select * from articulos where art_codi=?codigo;","cur_art")
				desconectar_db(frmpendxar)
				if RECCOUNT("cur_art")>0
					.text1.value=cur_art.art_codi
					.text2.value=cur_art.art_desc		
					frmpendxart= conectar_db(_screen.cn)
						SQLEXEC(frmpendxart,"call usp_penprorap(?codigo);","pro")
					desconectar_db(frmpendxart)			
				endif
				.list1.rowsourcetype=3
				.list1.rowsource="select distinct nombre from pro into cursor list1"
			endif
			.text1.setfocus
		endwith
		
	ENDPROC

	PROCEDURE Command1.GotFocus
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Command2.GotFocus
		if last()=24 or last()=19 or last()=4 or last()=5
			thisform.text1.setfocus
		endif
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Grid1.DblClick
		LOCAL xcodc,xcond
		xcodc=ordepend.ocpra
		xcond=ordepend.cond_codi
		DO FORM consocpra WITH xcodc,xcond
	ENDPROC

	PROCEDURE List1.Click
		with thisform
			for x=1 to this.listcount
				if this.selected(x)
					thisform.grid1.RecordSource=''
					thisform.grid1.Refresh
					select ocpra,fecha,ent,pend,cond_codi;
						   from pro where nombre=allt(this.list(x,1)) into CURSOR ordepend
					.grid1.recordsource="ordepend"
					.grid1.forecolor=0
					select sum(pend) from pro where nombre=allt(this.list(x,1)) into array tot
					.text3.value=tot[1,1]
					.label4.caption=allt(cur_art.art_med)
				endif
			next x
		endwith
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		with thisform
			.grid1.forecolor=16777215
			.text3.value=""
			.label4.caption=""
		endwith
		
	ENDPROC

	PROCEDURE Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		with thisform
		do case
			case nkeycode=19 or nkeycode=24
				for x=1 to .list1.listcount
					if .list1.selected(x)
						.list1.selected(x)=.F.
					endif
				next x
				.grid1.recordsource=''
				.grid1.refresh		
				if this.value>0
					frmpendxar= conectar_db(_screen.cn)
						SQLEXEC(frmpendxar,"select art_codi from articulos where art_codi<?this.value and art_codi<>4 and art_codi<>5 order by art_codi desc limit 1;","cur_inter")
						IF RECCOUNT()>0
							INSERT INTO codaux values(cur_inter.art_codi)
						ENDIF
					desconectar_db(frmpendxar)
					SELECT codaux
					IF RECCOUNT()>0
						frmpendxar= conectar_db(_screen.cn)
							SQLEXEC(frmpendxar,"select * from articulos where art_codi=?codaux.art_codi;","cur_art")
						desconectar_db(frmpendxar)
						if this.value<>4 AND this.Value<>5
							this.value=cur_art.art_codi
							.text2.value=cur_art.art_desc
							frmpendxar= conectar_db(_screen.cn)
								SQLEXEC(frmpendxar,"call usp_penprorap(?cur_art.art_codi);","pro")
							desconectar_db(frmpendxar)
							.list1.rowsourcetype=3
							.list1.rowsource="select distinct nombre from pro into cursor list1"
						ENDIF
					ENDIF
				endif
			case nkeycode=4 or nkeycode=5
				for x=1 to .list1.listcount
					if .list1.selected(x)
						.list1.selected(x)=.F.
					endif
				next x
				.grid1.recordsource=''
				.grid1.refresh		
				if this.value>0
					frmpendxar= conectar_db(_screen.cn)
						SQLEXEC(frmpendxar,"select art_codi from articulos where art_codi>?this.value and art_codi<>4 and art_codi<>5 order by art_codi limit 1;","cur_inter")
						IF RECCOUNT()>0
							INSERT INTO codaux values(cur_inter.art_codi)
						ENDIF
					desconectar_db(frmpendxar)
					SELECT codaux
					IF RECCOUNT()>0
						frmpendxar= conectar_db(_screen.cn)
							SQLEXEC(frmpendxar,"select * from articulos where art_codi=?codaux.art_codi;","cur_art")
						desconectar_db(frmpendxar)
						if this.value<>4 AND this.Value<>5
							this.value=cur_art.art_codi
							.text2.value=cur_art.art_desc
							frmpendxar= conectar_db(_screen.cn)
								SQLEXEC(frmpendxar,"call usp_penprorap(?cur_art.art_codi);","pro")
							desconectar_db(frmpendxar)
							.list1.rowsourcetype=3
							.list1.rowsource="select distinct nombre from pro into cursor list1"
						ENDIF
					ENDIF
				ENDIF
		endcase
		endwith
		
	ENDPROC

	PROCEDURE Text1.Valid
		with thisform
			.grid1.recordsource=''
			.grid1.refresh
			for x=1 to .list1.listcount
				if .list1.selected(x)
					.list1.selected(x)=.F.
				endif
			next x
			if this.value>0
				frmpendxar= conectar_db(_screen.cn)
					SQLEXEC(frmpendxar,"select * from articulos where art_codi=?this.value;","cur_art")
				desconectar_db(frmpendxar)
				if RECCOUNT("cur_art")>0
					.text2.value=cur_art.art_desc
					frmpendxart= conectar_db(_screen.cn)
						SQLEXEC(frmpendxart,"call usp_penprorap(?this.value);","pro")
					desconectar_db(frmpendxart)
					.list1.rowsourcetype=3
					.list1.rowsource="select distinct nombre from pro into cursor list1"
				else
					=messagebox("Artículo no está en archivo",0+48,"Advertencia")
					this.value=0
					return 0
				endif
			endif
		endwith
		
	ENDPROC

ENDDEFINE

	PROCEDURE Activate
		IF _screen.estamodidep=1
			STORE .F. TO thisform.fecdes,thisform.fechas,thisform.cheqdes,thisform.cheqhas
		
			thisform.btn_actualizar.btn.Click()
			_screen.estamodidep=0
		ENDIF
		
	ENDPROC

	PROCEDURE calculartotales
		IF USED("cur_plandep")
			DIMENSION ar_montot[1,1], ar_moncheq[1,1], ar_moneche[1,1]
			STORE 0 TO ar_montot[1,1],ar_moncheq[1,1],ar_moneche[1,1]
			LOCATE
			DO case
				CASE thisform.chk_echeqs.value=1 AND thisform.chk_fisicos.Value=1
					SELECT SUM(dep_importe) FROM cur_plandep WHERE dep_tipo = 1 INTO ARRAY ar_moncheq
					SELECT SUM(dep_importe) FROM cur_plandep WHERE dep_tipo = 2 INTO ARRAY ar_moneche
		*!*				SELECT SUM(dep_importe) FROM cur_plandep INTO ARRAY ar_montot
				CASE thisform.chk_echeqs.value=1 AND thisform.chk_fisicos.Value=0
					SELECT SUM(dep_importe) FROM cur_plandep WHERE dep_tipo = 2 INTO ARRAY ar_moneche
				CASE thisform.chk_echeqs.value=0 AND thisform.chk_fisicos.Value=1
					SELECT SUM(dep_importe) FROM cur_plandep WHERE dep_tipo = 1 INTO ARRAY ar_moncheq
			ENDCASE
			ar_montot=IIF(ISNULL(ar_moncheq),0,ar_moncheq)+IIF(ISNULL(ar_moneche),0,ar_moneche)
			thisform.pgf_resum.page1.etq_mon.Visible= .T.
			thisform.pgf_resum.page1.etq_cheqtot.Caption = ALLTRIM(STR(IIF(ISNULL(ar_moncheq),0,ar_moncheq),15,2))
			thisform.pgf_resum.page1.etq_mon2.Visible= .T.
			thisform.pgf_resum.page1.etq_echetot.Caption = ALLTRIM(STR(IIF(ISNULL(ar_moneche),0,ar_moneche),15,2))
			thisform.pgf_resum.page1.etq_montot.Visible= .T.
			thisform.pgf_resum.page1.etq_totusd.Caption = ALLTRIM(STR(IIF(ISNULL(ar_montot),0,ar_montot),15,2))
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE cuentadeposito
		IF USED("cur_plandep")
			LOCATE
			SELECT SUM(cantval) cantval FROM cur_plandep WHERE dep_tipo = 1 INTO ARRAY ar_cantcheq
			SELECT SUM(cantval) cantval FROM cur_plandep WHERE dep_tipo = 2 INTO ARRAY ar_cantecheq
			thisform.pgf_resum.page1.etq_cantcheq.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_cantcheq),0,ar_cantcheq)))
			thisform.pgf_resum.page1.etq_cantecheq.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_cantecheq),0,ar_cantecheq)))
			thisform.pgf_resum.page1.etq_totcan.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_cantcheq),0,ar_cantcheq) + ;
																	   IIF(ISNULL(ar_cantecheq),0,ar_cantecheq)))
		ENDIF
	ENDPROC

	PROCEDURE Destroy
		SET POINT TO
		SET SEPARATOR TO
	ENDPROC

	PROCEDURE excelcuadrofooter
		LPARAMETERS nFila
		
		fotfil = nFila
		
		XLSheet.Range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,7)).Borders(1).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,7)).Borders(1).Weight=3
		XLSheet.Range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,7)).Borders(2).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,7)).Borders(2).Weight=3
		XLSheet.Range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,7)).Borders(3).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,7)).Borders(3).Weight=3
		XLSheet.Range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,7)).Borders(4).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,7)).Borders(4).Weight=3
		
		RETURN
		
		
	ENDPROC

	PROCEDURE excelencabezado
		Xlsheet.cells(1,8)=ALLTRIM(thisform.empresa)
		XLSheet.Cells(1,8).font.bold=.T.
		XLSheet.Cells(1,8).font.size="12"
		XLSheet.Cells(1,8).font.name="Courier New"
		XLSheet.Cells(1,8).HorizontalAlignment=-4152
		
		Xlsheet.cells(3,8)='Fecha Actual: '+ALLTRIM(DTOC(DATE()))
		XLSheet.Cells(3,8).font.bold=.T.
		XLSheet.Cells(3,8).font.size="11"
		XLSheet.Cells(3,8).font.name="Courier New"
		XLSheet.Cells(3,8).HorizontalAlignment=-4152
		
		Xlsheet.range("D4:F4").merge
		Xlsheet.cells(4,4)="PLANILLA DE DEPÓSITOS"
		XLSheet.Cells(4,4).font.bold=.T.
		XLSheet.Cells(4,4).font.underline=.T.
		XLSheet.Cells(4,4).font.size="13"
		XLSheet.Cells(4,4).font.name="Cooper Black"
		XLSheet.range("D4:F4").HorizontalAlignment=7
		
		XLSheet.Cells(6,5)="Fecha desde:"
		XLSheet.Cells(6,5).font.bold=.T.
		XLSheet.Cells(6,5).font.size="11"
		XLSheet.Cells(6,5).font.name="Courier New"
		XLSheet.Cells(6,5).HorizontalAlignment=-4152
		XLSheet.Cells(6,7)="hasta"
		XLSheet.Cells(6,7).font.bold=.T.
		XLSheet.Cells(6,7).font.size="11"
		XLSheet.Cells(6,7).font.name="Courier New"
		XLSheet.Cells(6,7).HorizontalAlignment=-4108
		XLSheet.Cells(7,5)="Nº Valor desde:"
		XLSheet.Cells(7,5).font.bold=.T.
		XLSheet.Cells(7,5).font.size="11"
		XLSheet.Cells(7,5).font.name="Courier New"
		XLSheet.Cells(7,5).HorizontalAlignment=-4152
		XLSheet.Cells(7,7)="hasta"
		XLSheet.Cells(7,7).font.bold=.T.
		XLSheet.Cells(7,7).font.size="11"
		XLSheet.Cells(7,7).font.name="Courier New"
		XLSheet.Cells(7,7).HorizontalAlignment=-4108
		XLSheet.Cells(8,5)="Depositado en Bco:"
		XLSheet.Cells(8,5).font.bold=.T.
		XLSheet.Cells(8,5).font.size="11"
		XLSheet.Cells(8,5).font.name="Courier New"
		XLSheet.Cells(8,5).HorizontalAlignment=-4152
		XLSheet.Cells(10,5)="Tipo de Depósito:"
		XLSheet.Cells(10,5).font.bold=.T.
		XLSheet.Cells(10,5).font.size="11"
		XLSheet.Cells(10,5).font.name="Courier New"
		XLSheet.Cells(10,5).HorizontalAlignment=-4152
		
		XLSheet.Cells(6,6)=thisform.txt_fecdes.Value
		XLSheet.Cells(6,6).HorizontalAlignment=-4152
		XLSheet.Cells(6,8)=thisform.txt_fechas.Value
		XLSheet.Cells(6,8).HorizontalAlignment=2
		XLSheet.Cells(7,6).NUMBERFORMAT="0"
		XLSheet.Cells(7,6)=thisform.txt_cheqdes.Value
		XLSheet.Cells(7,6).HorizontalAlignment=-4108
		XLSheet.Cells(7,8).NUMBERFORMAT="0"
		XLSheet.Cells(7,8)=thisform.txt_cheqhas.Value
		XLSheet.Cells(7,8).HorizontalAlignment=-4108
		XLSheet.Cells(8,6)=IIF(thisform.chk_bank.Value=1,"TODOS",ALLTRIM(thisform.cmb_banco.Value))
		XLSheet.Cells(8,6).HorizontalAlignment=2
		LOCAL xEst
		xEst = ''
		IF thisform.chk_fisicos.Value=1
			xEst = xEst + "CHEQUES FÍSICOS"
		ENDIF
		IF thisform.chk_echeqs.Value=1
			xEst = xEst + IIF(thisform.chk_fisicos.Value=1," / ECHEQS","ECHEQS")
		ENDIF
		
		XLSheet.Cells(10,6)=ALLTRIM(xEst)
		XLSheet.Cells(10,6).HorizontalAlignment=2
		
		XLSheet.Cells(12,2)="FECHA"
		XLSheet.Cells(12,2).font.bold=.T.
		XLSheet.Cells(12,2).font.size="11"
		XLSheet.Cells(12,2).font.name="Courier New"
		XLSheet.range("B12:B12").HorizontalAlignment=-4108
		XLSheet.Cells(12,3)="TIPO"
		XLSheet.Cells(12,3).font.bold=.T.
		XLSheet.Cells(12,3).font.size="11"
		XLSheet.Cells(12,3).font.name="Courier New"
		XLSheet.range("C12:C12").HorizontalAlignment=-4108
		XLSheet.Cells(12,4)="DEPOSIT. EN BANCO"
		XLSheet.Cells(12,4).font.bold=.T.
		XLSheet.Cells(12,4).font.size="11"
		XLSheet.Cells(12,4).font.name="Courier New"
		XLSheet.range("D12:D12").HorizontalAlignment=-4108
		XLSheet.Cells(12,5)="BOLETA Nº"
		XLSheet.Cells(12,5).font.bold=.T.
		XLSheet.Cells(12,5).font.size="11"
		XLSheet.Cells(12,5).font.name="Courier New"
		XLSheet.range("E12:E12").HorizontalAlignment=-4108
		XLSheet.Cells(12,6)="CAN.VAL."
		XLSheet.Cells(12,6).font.bold=.T.
		XLSheet.Cells(12,6).font.size="11"
		XLSheet.Cells(12,6).font.name="Courier New"
		XLSheet.range("F12:F12").HorizontalAlignment=-4108
		XLSheet.Cells(12,7)="MONTO DEPOS."
		XLSheet.Cells(12,7).font.bold=.T.
		XLSheet.Cells(12,7).font.size="11"
		XLSheet.Cells(12,7).font.name="Courier New"
		XLSheet.range("G12:G12").HorizontalAlignment=-4108
		XLSheet.Range(XLSheet.Cells(12,2),XLSheet.Cells(12,7)).Borders.LineStyle=1
		XLSheet.Range(XLSheet.Cells(12,2),XLSheet.Cells(12,7)).Borders.Weight=2
		XLSheet.Range(XLSheet.Cells(12,2),XLSheet.Cells(12,7)).Interior.Color= RGB(192,192,192)
		XLSheet.Range(XLSheet.Cells(12,2),XLSheet.Cells(12,7)).AutoFilter
		
		return
	ENDPROC

	PROCEDURE excelfooter
		LPARAMETERS xInifil
		
		LOCAL fotfil
		
		fotfil = xInifil
		
		XLSheet.Range(XLSheet.Cells(fotfil,2),XLSheet.Cells(fotfil,7)).Borders(3).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,2),XLSheet.Cells(fotfil,7)).Borders(3).Weight=3
		
		XLSheet.Rows(fotfil).RowHeight = 10
		fotfil = fotfil + 1
		XLSheet.Range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,6)).Merge
		Xlsheet.cells(fotfil,5).HorizontalAlignment=-4152
		Xlsheet.cells(fotfil,5)='TOTAL CHEQUES FÍSICOS'
		XLSheet.Cells(fotfil,7)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_cheqtot.caption))
		XLSheet.Cells(fotfil,7).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		WITH Xlsheet.range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,7))
			.font.bold=.T.
			.HorizontalAlignment=-4108
		ENDWITH
		
		thisform.excelcuadrofooter(fotfil)
		
		fotfil = fotfil + 1
		XLSheet.Range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,6)).Merge
		Xlsheet.cells(fotfil,5).HorizontalAlignment=-4152
		Xlsheet.cells(fotfil,5)='TOTAL ECHEQS'
		XLSheet.Cells(fotfil,7)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_echetot.caption))
		XLSheet.Cells(fotfil,7).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		WITH Xlsheet.range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,7))
			.font.bold=.T.
			.HorizontalAlignment=-4108
		ENDWITH
		
		thisform.excelcuadrofooter(fotfil)
		
		fotfil = fotfil + 1
		XLSheet.Range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,6)).Merge
		Xlsheet.cells(fotfil,5).HorizontalAlignment=-4152
		Xlsheet.cells(fotfil,5)='MONTO TOTAL DEPOSITADO'
		XLSheet.Cells(fotfil,7)=ConverNro(thisform.pgf_resum.page1.etq_totusd.caption)
		XLSheet.Cells(fotfil,7).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		WITH Xlsheet.range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,7))
			.font.bold=.T.
			.HorizontalAlignment=-4108
		ENDWITH
		
		thisform.excelcuadrofooter(fotfil)
		
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,7)='Cheques Físicos:  '+ALLTRIM(thisform.pgf_resum.page1.etq_cantcheq.Caption)
		Xlsheet.cells(fotfil,7).HorizontalAlignment=-4152
		fotfil = fotfil + 1
		XLSheet.Rows(fotfil).RowHeight = 10
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,7)='Echeqs:  '+ALLTRIM(thisform.pgf_resum.page1.etq_cantecheq.Caption)
		Xlsheet.cells(fotfil,7).HorizontalAlignment=-4152
		
		fotfil = fotfil + 1
		XLSheet.Rows(fotfil).RowHeight = 10
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,7)='Total Ch/Ech Depositados:  '+ALLTRIM(thisform.pgf_resum.page1.etq_totcan.Caption)
		Xlsheet.cells(fotfil,7).HorizontalAlignment=-4152
		
		fotfil = fotfil - 1
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil+1,7)).font.bold= .T.
		fotfil = xInifil + 1
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil+11,5)).font.bold= .T.
		
		RETURN
		
		
		
		
		
		
	ENDPROC

	PROCEDURE grid_rightclick
		IF USED("cur_plandep")
			_screen.callplanidep=1
			LOCAL lcShortcut, loRef
			
			m.loRef = this
			m.lcShortcut = SYS(2015)
		
			DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
			DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Consultar Depósito] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
			DEFINE BAR 2 OF (m.lcShortcut) PROMPT [Modificar Depósito] PICTURE "C:\VFP9_MYSQL\imagen\iIcons Icon 09.ico"
		
			ON SELECTION BAR 1 OF (m.lcShortcut) do form consdeposito with cur_plandep.dep_codi
			ON SELECTION BAR 2 OF (m.lcShortcut) do form frm_abmdeposito with cur_plandep.dep_codi
			
			ACTIVATE POPUP (m.lcShortcut)
			RELEASE POPUP (m.lcShortcut)
		ENDIF
	ENDPROC

	PROCEDURE Init
		SET POINT TO ","
		SET SEPARATOR TO "."
		
		IF USED("cur_plandep")
			USE IN cur_plandep
		ENDIF
		IF USED("cur_detadep")
			USE IN cur_detadep
		ENDIF
		
		this.txt_fecdes.Value= ctod("01/"+allt(str(month(date())))+"/"+allt(str(year(date()))))
		&& DATE()-(DOW(DATE())-2)
		this.txt_fechas.Value= DATE()
		
		frmpland = conectar_db(_screen.cn)
			SQLEXEC(frmpland,"select param_fec from parametros where param_codi = 4;","cur_primfec")
		desconectar_db(frmpland)
		
		IF RECCOUNT("cur_primfec") > 0
			thisform.xprimefec = cur_primfec.param_fec
			cerrar_cursor("cur_primfec")
		ENDIF
		
		frmpland= conectar_db(_screen.cn)
			SQLEXEC(frmpland,"select param_desc from parametros where param_codi = 13;","cur_emp")
		desconectar_db(frmpland)
		
		IF RECCOUNT("cur_emp") > 0
			thisform.empresa=ALLTRIM(cur_emp.param_desc)
			cerrar_cursor("cur_emp")
		ENDIF
		
		frmaltadep= conectar_db(_screen.cn)
			SQLEXEC(frmaltadep,"select banc_desc,banc_codi,banc_ncta from bancos_caja order by banc_desc;","cur_bank")
		desconectar_db(frmaltadep)
		
		IF RECCOUNT("cur_bank")>0
			GO top
			thisform.cmb_banco.rowsource="select banc_desc,banc_codi,banc_ncta from cur_bank INTO CURSOR cmb_banco"
			cerrar_cursor("cur_bank")
		ENDIF
		
		FOR ncol=1 TO 6
			xsource="Thisform.grd_plandepo.column"+ALLTRIM(STR(ncol))+".text1"
			BINDEVENT(&xsource,"RightClick",Thisform,"Grid_RightClick")
		*!*		BINDEVENT(&xsource,"DblClick",Thisform,"Grid_DobleClick")
		NEXT ncol
		
		thisform.fecdes={  /  /    }
		thisform.fechas={  /  /    }
		thisform.cheqdes=''
		thisform.cheqhas=''
		thisform.codibank=0
		
		this.btn_actualizar.SetFocus
	ENDPROC

	PROCEDURE limpiartotales
		LPARAMETERS xopcion
		
		IF xopcion = .T.
			thisform.pgf_resum.page1.etq_cantecheq.Caption  = ''
			thisform.pgf_resum.page1.etq_cantcheq.Caption  = ''
			thisform.pgf_resum.page1.etq_totcan.Caption  = ''
			thisform.pgf_resum.page1.etq_cheqtot.Caption = ''
			thisform.pgf_resum.page1.etq_echetot.Caption = ''
			thisform.pgf_resum.page1.etq_totusd.Caption = ''
			thisform.pgf_resum.page1.etq_mon.Visible= .F.
			thisform.pgf_resum.page1.etq_mon2.Visible= .F.
			thisform.pgf_resum.page1.etq_montot.Visible= .F.
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS nEstado
		
		LOCAL lnColor
		
		DO case
			CASE nEstado = 1
				lnColor = RGB(190, 220, 240)
				** lnColor = RGB(247,201,168)
			CASE nEstado = 2
				lnColor = RGB(180,180,180)
				** lnColor = RGB(144,238,144)
		    CASE nEstado = 3
		    	lnColor = RGB(255,140,140)
		    	** lnColor = RGB(173,216,230)
		*!*		CASE nEstado = 4
		*!*			lnColor = RGB(0,255,255)
		ENDCASE
		
		return(lnColor)
	ENDPROC

	PROCEDURE recorrer
		LPARAMETERS xkeycode
		
		IF xkeycode = 5 OR xkeycode = 24
			frmpland= conectar_db(_screen.cn)
				SQLEXEC(frmpland,"select presup_obser from presupuestos where presup_codi = ?cur_plandep.prescodi","cur_obser")
			desconectar_db(frmpland)
			
			IF RECCOUNT("cur_obser") > 0
				IF LEN(ALLTRIM(cur_obser.presup_obser)) > 0
					thisform.pgf_resum.page2.edt_obser.Value = ALLTRIM(cur_obser.presup_obser)
				ELSE
					thisform.pgf_resum.page2.edt_obser.Value = ''
				ENDIF
				cerrar_cursor("cur_obser")
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE totalizadores
		
		LOCAL descmax,descmin
		
		SELECT art_codi,COUNT(*) cantidad FROM cur_detapres WHERE art_codi > 5 GROUP BY art_codi ORDER BY cantidad DESC INTO ARRAY ar_mayor
		SELECT art_codi,COUNT(*) cantidad FROM cur_detapres WHERE art_codi > 5 GROUP BY art_codi ORDER BY cantidad INTO ARRAY ar_menor
		
		frmpland = conectar_db(_screen.cn)
			SQLEXEC(frmpland,"select TRIM(art_desc) art_desc from articulos where art_codi = ?ar_mayor[1,1];","cur_armax")
			SQLEXEC(frmpland,"select TRIM(art_desc) art_desc from articulos where art_codi = ?ar_menor[1,1];","cur_armin")
		desconectar_db(frmpland)
		
		thisform.pgf_resum.page1.lbl_max.Caption="Artículo mas cotizado: "+ALLTRIM(cur_armax.art_desc)+" con "+ALLTRIM(STR(ar_mayor[1,2]))+IIF(ar_mayor[1,2]>1," veces."," vez.")
		
		thisform.pgf_resum.page1.lbl_min.Caption="Artículo menos cotizado: "+ALLTRIM(cur_armin.art_desc)+" con "+ALLTRIM(STR(ar_menor[1,2]))+IIF(ar_menor[1,2]>1," veces."," vez.")
		
		cerrar_cursor("cur_armax")
		cerrar_cursor("cur_armin")
		
		SELECT cur_plandep
		
		RETURN
		
	ENDPROC

	PROCEDURE bnt_impirmir.Click
		IF USED("cur_plandep")
			IF RECCOUNT("cur_plandep") > 0
				IF thisform.chk_deta.Value=1 then
					SELECT cur_detadep
					LOCATE
					INDEX on dep_codi TO SYS(2015)
					SELECT cur_plandep
					LOCATE
					INDEX on dep_codi TO SYS(2015)
					SET RELATION TO
					SET RELATION TO dep_codi INTO cur_detadep addi
		
					SELECT cur_detadep
					LOCATE
					SELECT cur_plandep
					LOCATE
		
					IF thisform.chk_pant.Value=1
						REPORT FORM planidep_2 PREVIEW NOCONSOLE
					ELSE
						REPORT FORM planidep_2 TO PRINTER PROMPT NOCONSOLE
					ENDIF
				ELSE
					SELECT cur_plandep
					LOCATE
					IF thisform.chk_pant.Value=1
						REPORT FORM planidep_1 PREVIEW NOCONSOLE
					ELSE
						REPORT FORM planidep_1 TO PRINTER PROMPT NOCONSOLE
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE bnt_impirmir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE bnt_impirmir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Btn_actualizar.btn.Click
		LOCAL fecdes,fechas,cheqdes,cheqhas
		
		thisform.limpiartotales(.T.)
		thisform.grd_plandepo.RecordSource = ''
		thisform.grd_plandepo.Refresh
		
		fecdes  = thisform.txt_fecdes.Value
		thisform.fecdes=fecdes
		fechas  = thisform.txt_fechas.Value
		thisform.fechas=fechas
		cheqdes = ALLTRIM(STR(thisform.txt_cheqdes.Value,14))
		thisform.cheqdes=cheqdes
		cheqhas = ALLTRIM(STR(thisform.txt_cheqhas.Value,14))
		thisform.cheqhas=cheqhas
		
		SET DECIMALS TO 3
		frmpland = conectar_db(_screen.cn)
			SQLEXEC(frmpland, "call usp_planidepo(?fecdes, ?fechas, ?cheqdes, ?cheqhas, ?thisform.codibank);","cur_detadep")
		desconectar_db(frmpland)
		SET DECIMALS TO
		
		IF RECCOUNT("cur_detadep") > 0	
			GO top
			
			SELECT DISTINCT dep_fech,tipo,banc_desc,dep_bolnro, ;
							CAST(STRTRAN(cantval,",",".") as numeric(15,0)) cantval, ;
							dep_importe,dep_tipo,dep_codi ;
							FROM cur_detadep INTO CURSOR cur_plandep
							
			IF !(thisform.chk_fisicos.Value = 1 AND thisform.chk_echeqs.Value = 1)
				DO case
					CASE thisform.chk_fisicos.Value = 1 AND thisform.chk_echeqs.Value = 0 &&(Cheques Físicos)
						SELECT * FROM cur_plandep WHERE dep_tipo = 1 INTO CURSOR cur_plandep 
					CASE thisform.chk_fisicos.Value = 0 AND thisform.chk_echeqs.Value = 1 &&(Echeqs)
						SELECT * FROM cur_plandep WHERE dep_tipo = 2 INTO CURSOR cur_plandep
				ENDCASE
			ENDIF
			LOCATE
				
			IF thisform.chk_fisicos.Value = 0 AND thisform.chk_echeqs.Value = 0
				thisform.estafiltros=0
				IF USED("cur_plandep")
					SELECT cur_plandep
					USE
				ENDIF
				IF USED("cur_detadep")
					SELECT cur_detadep
					USE
				ENDIF
				thisform.grd_plandepo.RecordSource = ''
				thisform.grd_plandepo.Refresh
				thisform.limpiartotales(.T.)
			ELSE
				thisform.estafiltros=1
				thisform.limpiartotales(.T.)
				thisform.grd_plandepo.RecordSource = "cur_plandep"
				Thisform.grd_plandepo.column6.DynamicInputMask = [('$999,999,999.99')]
				thisform.cuentadeposito()
				thisform.calculartotales()
				frmpland= conectar_db(_screen.cn)
					SQLEXEC(frmpland,"select TRIM(dep_obser) dep_obser from depositos where dep_codi = ?cur_plandep.dep_codi;","cur_obser")
				desconectar_db(frmpland)
				IF RECCOUNT("cur_obser") > 0
					IF LEN(ALLTRIM(cur_obser.dep_obser)) > 0
						thisform.pgf_resum.page2.edt_obser.Value = ALLTRIM(cur_obser.dep_obser)
					ELSE
						thisform.pgf_resum.page2.edt_obser.Value = ""
					ENDIF
					cerrar_cursor("cur_obser")
				ENDIF
				thisform.grd_plandepo.SetFocus
			ENDIF
			_screen.callplanidep=0
		ELSE
			thisform.limpiartotales(.T.)
		ENDIF
	ENDPROC


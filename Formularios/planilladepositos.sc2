	PROCEDURE grd_plandepo.Column5.Text1.DblClick
		*!*	LOCAL xcodpres, xcond
		
		*!*	xcodpres = cur_plandep.prescodi
		*!*	xcond    = cur_plandep.cond_codi
		*!*	valorcadena = ''
		
		*!*	DO FORM conspresup WITH xcodpres,xcond
	ENDPROC

	PROCEDURE grd_plandepo.Column5.Text1.When
		thisform.recorrer(LASTKEY())
	ENDPROC

	PROCEDURE grd_plandepo.Column6.Text1.Click
		frmpland= conectar_db(_screen.cn)
			SQLEXEC(frmpland,"select TRIM(dep_obser) dep_obser from depositos where dep_codi = ?cur_plandep.dep_codi;","cur_obser")
		desconectar_db(frmpland)
		IF RECCOUNT("cur_obser") > 0
			IF LEN(ALLTRIM(cur_obser.dep_obser)) > 0
				thisform.pgf_resum.page2.edt_obser.Value = ALLTRIM(cur_obser.dep_obser)
			ELSE
				thisform.pgf_resum.page2.edt_obser.Value = ""
			ENDIF
			cerrar_cursor("cur_obser")
		ENDIF
	ENDPROC

	PROCEDURE grd_plandepo.Column6.Text1.DblClick
		*!*	LOCAL xcodpres, xcond
		
		*!*	xcodpres = cur_plandep.prescodi
		*!*	xcond    = cur_plandep.cond_codi
		*!*	valorcadena = ''
		*!*	_screen.estapres=1
		*!*	DO FORM conspresup WITH xcodpres,xcond
	ENDPROC

	PROCEDURE grd_plandepo.Column6.Text1.When
		thisform.recorrer(LASTKEY())
	ENDPROC

	PROCEDURE txt_cheqdes.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_cheqdes.LostFocus
		IF this.Value > 0
			thisform.txt_cheqhas.Value=this.Value
			thisform.chk_cheqnum.Value = 0
		ENDIF
		
	ENDPROC

	PROCEDURE txt_cheqhas.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_cheqhas.LostFocus
		IF this.Value < 99999999
			thisform.chk_cheqnum.Value = 0
		ENDIF
		
	ENDPROC

	PROCEDURE txt_fecdes.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_fecdes.GotFocus
		IF this.Value > thisform.xprimefec AND thisform.chk_fechas.Value = 1
			thisform.chk_fechas.Value = 0
		ENDIF
		
	ENDPROC

	PROCEDURE txt_fecdes.LostFocus
		IF this.Value > thisform.xprimefec AND thisform.chk_fechas.Value = 1
			thisform.chk_fechas.Value = 0
		ENDIF
		
	ENDPROC

	PROCEDURE txt_fechas.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_fechas.GotFocus
		IF this.Value < DATE() AND thisform.chk_fechas.Value = 1
			thisform.chk_fechas.Value = 0
		ENDIF
		
	ENDPROC

	PROCEDURE txt_fechas.LostFocus
		IF this.Value < DATE() AND thisform.chk_fechas.Value = 1
			thisform.chk_fechas.Value = 0
		ENDIF
	ENDPROC

ENDDEFINE

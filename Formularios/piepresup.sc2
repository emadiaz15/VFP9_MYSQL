	PROCEDURE Activate
		*!*	if valorcadena="Por Cliente" OR valorcadena="Por Número"
		*!*		this.caption=this.caption+" Nº "+allt(str(codp))+" de "+allt(cur_clie.cli_nomb)
		*!*	endif
	ENDPROC

	PROCEDURE Init
		parameters validez,plazo,condpag,lugent,observ
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Unload
		return validez
		return plazo
		return condpag
		return lugent
		return observ
	ENDPROC

	PROCEDURE Command1.Click
		if valorcadena="Presupuestos de Clientes" or valorcadena="Presupuestos Clientes"
			porlasdudas=messagebox("¿Confirma los datos ingresados?",4+32+256,"Datos Pie de Página")
			if porlasdudas=6
				validez=allt(thisform.text1.value)
				plazo=allt(thisform.text2.value)
				condpag=allt(thisform.text3.value)
				lugent=allt(thisform.text4.value)
				observ=allt(thisform.edit1.value)
				thisform.release
			else
				thisform.text1.setfocus
			endif
		else
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command2.Click
		with thisform
			.shape1.visible=.T.
			.label6.visible=.T.
			.text5.visible=.T.
			.text5.value=0
			.text5.setfocus
		endwith
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Text5.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text5.Valid
		with thisform
			if this.value<>0
				frmpiepres= conectar_db(_screen.cn)
					SQLEXEC(frmpiepres,"select * from condipresup where condp_cod=?this.value;","cur_piep")
				desconectar_db(frmpiepres)
				if RECCOUNT("cur_piep")>0
					.text1.value=cur_piep.condp_val
					.text2.value=cur_piep.condp_pla
					.text3.value=cur_piep.condp_pag
					.text4.value=cur_piep.condp_lug
					.edit1.value=cur_piep.condp_obs
				else
					messagebox("Código de Condiciones no está en archivo",0+48,"Advertencia")
					this.value=0
					return 0
				endif
			endif
		endwith
	ENDPROC

ENDDEFINE

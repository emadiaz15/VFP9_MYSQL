	PROCEDURE lst_prov.Click
		with thisform
			.grid1.rows=1
			.grd_compras.recordsource=''
			.grd_compras.refresh
			frmpendpro= conectar_db(_screen.cn)
				SQLEXEC(frmpendpro,"select orden_codi,orden_fech from compras where prov_codi=?val(this.value) and cumplido<>'S' and anulado<>'S';","cur_pendp")
			desconectar_db(frmpendpro)
			IF RECCOUNT("cur_pendp")>0
				.grd_compras.recordsource="cur_pendp"
			ENDIF
			this.boundcolumn=1
			.label5.caption="Ordenes Pendientes de: "+allt(this.value)
			.label5.visible=.T.
			this.boundcolumn=2
		endwith
		
	ENDPROC

	PROCEDURE lst_prov.GotFocus
		thisform.command1.visible=.F.
	ENDPROC

	PROCEDURE lst_prov.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nkeycode = 13 then
			with thisform
				.grid1.rows=1
				.grd_compras.recordsource=''
				.grd_compras.refresh
				frmpendpro= conectar_db(_screen.cn)
					SQLEXEC(frmpendpro,"select orden_codi,orden_fech from compras where prov_codi=?val(this.value) and cumplido<>'S' and anulado<>'S';","cur_pendp")
				desconectar_db(frmpendpro)
				IF RECCOUNT("cur_pendp")>0
					.grd_compras.recordsource="cur_pendp"
				ENDIF
				this.boundcolumn=1
				.label5.caption="Ordenes Pendientes de: "+allt(this.value)
				.label5.visible=.T.
				this.boundcolumn=2
			ENDWITH
		ENDIF
		
	ENDPROC

	PROCEDURE txtproload.InteractiveChange
		if subst(allt(this.value),1,1)="?"
			SELECT prov_nomb
			SET FILTER TO
		endif
		if subst(allt(this.value),1,1)!="?"
				sele cur_prov
				local lc
				lc = allt(This.Value)
				if last()<>127 and last()<>7
					do while !eof()
						if lc=subst(prov_nomb,1,len(lc))
							exit
						else
							skip
							thisform.d=thisform.d+1
							if eof()
								go top
								thisform.d=1
								exit
							endif
						endif
					enddo
				else
					do while lc=subst(prov_nomb,1,len(lc)) and thisform.d>1
						if bof()
							exit
						endif
						skip-1
						if thisform.d>1
							thisform.d=thisform.d-1
						endif
						if lc<>subst(prov_nomb,1,len(lc))
							skip
							thisform.d=thisform.d+1
							exit
						endif
					enddo
				endif
			thisform.lst_prov.selected(thisform.d)=.T.
			return
		endif
		
	ENDPROC

	PROCEDURE txtproload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
				if subst(allt(this.value),1,1)="?"
					cade=subst(allt(this.value),2,len(allt(this.value)))
					sele cur_prov
					set filter to atcline(cade,prov_nomb)!=0
				else
				with thisform
					.grid1.rows=1
					.grd_compras.recordsource=''
					.grd_compras.refresh
					frmpendpro= conectar_db(_screen.cn)
						SQLEXEC(frmpendpro,"select orden_codi,orden_fech from compras where prov_codi=?val(.lst_prov.value) and cumplido<>'S' and anulado<>'S';","cur_pendp")
					desconectar_db(frmpendpro)
					IF RECCOUNT("cur_pendp")>0
						.grd_compras.recordsource="cur_pendp"
					ENDIF
					.lst_prov.boundcolumn=1
					.label5.caption="Ordenes Pendientes de: "+allt(.lst_prov.value)
					.label5.visible=.T.
					.lst_prov.boundcolumn=2
				ENDWITH
				endif
			case last()=5
				if thisform.d>1
					thisform.d=thisform.d-1
					skip-1
				endif
				thisform.lst_prov.selected(thisform.d)=thisform.d
				this.value=thisform.lst_prov.value
			case last()=24
				if thisform.d<thisform.lst_prov.listcount
					thisform.d=thisform.d+1
					skip
				endif
				thisform.lst_prov.selected(thisform.d)=thisform.d
				this.value=thisform.lst_prov.value
			case last()=27
				thisform.release
		endcase
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="1" />

	*<PropValue>
		AutoCloseTables = .F.
		DataSource = .NULL.
		Height = 901
		Left = 1
		Name = "Dataenvironment"
		Top = 220
		Width = 1869
	*</PropValue>

ENDDEFINE

	PROCEDURE Init
		public articulo,can,preg,consul,codiprov,codc
		preg=0
		articulo=0
		can=0
		consul=0
		codicli=0
		codc=0
		set date british
		set cent on
		set deleted on
		with thisform
			.text1.value=date()
			frmpendpro= conectar_db(_screen.cn)
				SQLEXEC(frmpendpro,"select distinct b.prov_nomb,b.prov_codi from compras a inner join proveedores b on a.prov_codi=b.prov_codi where a.cumplido<>'S' and a.anulado<>'S' order by b.prov_nomb;","cur_prov")
			desconectar_db(frmpendpro)
			.lst_prov.rowsource="cur_prov"
		endwith
	ENDPROC

	PROCEDURE Command1.Click
		local filap,filau,vendn,xarti
		with thisform
			if .grid1.rowsel>.grid1.row
				preg=messagebox("¿Confirma la anulación de todos los Pendientes seleccionados?",4+48+256,"Anulación de Pendientes")
				if preg=6
					filap=.grid1.row
					filau=.grid1.rowsel
					codc=cur_pendp.orden_codi
					.lst_prov.boundcolumn=2
					codiprov=val(.lst_prov.value)
					for i=filap to filau
						.grid1.row=i
						.grid1.col=0
						xarti=VAL(.grid1.text)
						.grid1.col=2
						can=ConverNro(.grid1.text)
						.grid1.col=3
						articulo=val(.grid1.text)
						frmpendpro= conectar_db(_screen.cn)
							SQLEXEC(frmpendpro,"update compras_articulos set artord_ent=artord_cant where artord_codi=?articulo;")
		*!*						SQLEXEC(frmpendpro,"update articulos set pedprov = pedprov - ?can where art_codi = ?xarti;")
						desconectar_db(frmpendpro)
						IF xarti > 5
							Campo_ppr(xarti)
						ENDIF
					next
				endif
			else
				.grid1.col=0
				xarti=VAL(.grid1.text)
				.grid1.col=2
				can=ConverNro(.grid1.text)
				.grid1.col=3
				articulo=val(.grid1.text)
				frmpendpro= conectar_db(_screen.cn)
					SQLEXEC(frmpendpro,"select a.*,b.art_med from compras_articulos a inner join articulos b on a.art_codi=b.art_codi where a.artord_codi=?articulo;","cur_artilo")
				desconectar_db(frmpendpro)
				if RECCOUNT("cur_artilo")>0
					.lst_prov.boundcolumn=2
					codiprov=val(.lst_prov.value)
					codc=cur_pendp.orden_codi
					.grid1.col=1
					consul=messagebox("Cantidad pendiente de "+allt(.grid1.text)+" "+iif(can>int(can),allt(str(can,10,2)),allt(str(can)))+" "+allt(cur_artilo.art_med)+chr(13)+chr(13)+ ;
									  "¿Anula el total de los pendientes?",4+48+256,"Anulación de Pendientes")
					if consul=6
						.lst_prov.boundcolumn=1
						preg=messagebox("¿Confirma la anulación de los pendientes de "+allt(.grid1.text)+" de la orden Nº: "+allt(STR(cur_pendp.orden_codi))+" de "+allt(.lst_prov.value)+"?",4+48+256,"Advertencia!!!")
						if preg=6
							frmpendpro= conectar_db(_screen.cn)
								SQLEXEC(frmpendpro,"update compras_articulos set artord_ent=artord_cant where artord_codi=?articulo;")
		*!*							SQLEXEC(frmpendpro,"update articulos set pedprov = pedprov - ?can where art_codi = ?xarti;")
							desconectar_db(frmpendpro)
							IF xarti > 5
								Campo_ppr(xarti)
							ENDIF
						endif
					else
						.grid1.col=2
						can=ConverNro(.grid1.text)
						do form cantanupend with can TO ncant
						.grid1.col=1
						.lst_prov.boundcolumn=1
						preg=messagebox("¿Confirma la anulación de "+iif(ncant.xcant>int(ncant.xcant),allt(str(ncant.xcant,10,2)),allt(str(ncant.xcant)))+" pendientes de "+allt(.grid1.text)+" de la orden Nº: "+allt(STR(cur_pendp.orden_codi))+" de "+allt(.lst_prov.value)+"?",4+48+256,"Advertencia!!!")
						if preg=6
							frmpendpro= conectar_db(_screen.cn)
								SQLEXEC(frmpendpro,"update compras_articulos set artord_ent=artord_ent+?ncant.xcant where artord_codi=?articulo;")
		*!*							SQLEXEC(frmpendpro,"update articulos set pedprov = pedprov - ?ncant.xcant where art_codi = ?xarti;")
							desconectar_db(frmpendpro)
							IF xarti > 5
								Campo_ppr(xarti)
							ENDIF
						endif			
					endif
				endif
			endif
			if preg=6
				do cumplicom with cur_pendp.orden_codi
				for i=1 to .lst_prov.listcount
					if .lst_prov.selected(i)=.T.
						.lst_prov.selected(i)=.F.
					ENDIF
				NEXT
				frmpendpro= conectar_db(_screen.cn)
					SQLEXEC(frmpendpro,"select distinct b.prov_nomb,b.prov_codi from compras a inner join proveedores b on a.prov_codi=b.prov_codi where a.cumplido<>'S' and a.anulado<>'S' order by b.prov_nomb;","cur_prov")
				desconectar_db(frmpendpro)
				.lst_prov.refresh
				IF RECCOUNT("cur_prov")>0
					.lst_prov.rowsource="cur_prov"
				ENDIF
				.lst_prov.boundcolumn=2
				for i=1 to .lst_prov.listcount
					if val(.lst_prov.list(i,2))=codiprov
						.lst_prov.selected(i)=.T.
						exit
					endif
				next
				if codiprov=val(.lst_prov.value)
					.grid1.rows=1
					.grd_compras.recordsource=''
					.grd_compras.refresh
					frmpendpro= conectar_db(_screen.cn)
						SQLEXEC(frmpendpro,"select orden_codi,orden_fech from compras where prov_codi=?val(.lst_prov.value) and cumplido<>'S' and anulado<>'S';","cur_pendp")
					desconectar_db(frmpendpro)
					IF RECCOUNT("cur_pendp")>0
						LOCATE FOR cur_pendp.orden_codi=codc
						IF !found()
							GO top
						endif
						.grd_compras.recordsource="cur_pendp"
					ENDIF
					.lst_prov.boundcolumn=1
					.label5.caption="Ordenes Pendientes de: "+allt(.lst_prov.value)
					.label5.visible=.T.
					if codc=cur_pendp.orden_codi
						frmpendpro= conectar_db(_screen.cn)
							SQLEXEC(frmpendpro,"select a.*,b.art_desc from compras_articulos a inner join articulos b on a.art_codi=b.art_codi where orden_codi=?cur_pendp.orden_codi and a.artord_ent<a.artord_cant;","cur_detap")
						desconectar_db(frmpendpro)
						if RECCOUNT("cur_detap")>0
							GO top
							scan
								cadena=repl("0",8-len(allt(str(cur_detap.art_codi))))+allt(str(cur_detap.art_codi))
								calculo=cur_detap.artord_cant-cur_detap.artord_ent
								if cur_detap.art_codi=4 OR cur_detap.art_codi=5
									thisform.grid1.additem(cadena+chr(9)+cur_detap.artord_dasc+chr(9)+str(calculo,10,2)+CHR(9)+STR(cur_detap.artord_codi))
								else
									thisform.grid1.additem(cadena+chr(9)+cur_detap.art_desc+chr(9)+str(calculo,10,2)+CHR(9)+STR(cur_detap.artord_codi))
								ENDIF
								.grid1.row=thisform.grid1.rows-1
								.grid1.col=2
								if len(allt(thisform.grid1.text))>44
									div=len(allt(thisform.grid1.text))/44
									if div>int(div)
										longdes=int(div)+1
									else
										longdes=div
									endif
									longdes=longdes*240
									thisform.grid1.rowheight(thisform.grid1.row)=longdes
								else
									thisform.grid1.rowheight(thisform.grid1.row)=270
								endif
							ENDSCAN
						endif
					endif
				else
					thisform.grd_compras.RecordSource=''
					thisform.grd_compras.refresh
					.grid1.rows=1
				endif
			endif
		endwith
		this.visible=.F.
	ENDPROC


	PROCEDURE grd_compras.Click
		thisform.grid1.rows=1
		frmpendpro= conectar_db(_screen.cn)
			SQLEXEC(frmpendpro,"select a.*,b.art_desc from compras_articulos a inner join articulos b on a.art_codi=b.art_codi where a.orden_codi=?cur_pendp.orden_codi and a.artord_ent<a.artord_cant;","cur_detap")
		desconectar_db(frmpendpro)
		if RECCOUNT("cur_detap")>0
			GO top
			scan
				cadena=repl("0",8-len(allt(str(cur_detap.art_codi))))+allt(str(cur_detap.art_codi))
				calculo=cur_detap.artord_cant-cur_detap.artord_ent
				if cur_detap.art_codi=4 OR cur_detap.art_codi=5
					thisform.grid1.additem(cadena+chr(9)+cur_detap.artord_dasc+chr(9)+str(calculo,10,2)+CHR(9)+STR(cur_detap.artord_codi))
				else
					thisform.grid1.additem(cadena+chr(9)+cur_detap.art_desc+chr(9)+str(calculo,10,2)+CHR(9)+STR(cur_detap.artord_codi))
				ENDIF
				thisform.grid1.row=thisform.grid1.rows-1
				thisform.grid1.col=2
				if len(allt(thisform.grid1.text))>44
					div=len(allt(thisform7.grid1.text))/44
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					thisform.grid1.rowheight(thisform.grid1.row)=longdes
				else
					thisform.grid1.rowheight(thisform.grid1.row)=270
				endif
			ENDSCAN
		endif
	ENDPROC

	PROCEDURE grid1.Click
		with thisform
			if prompt()="Todos los Pendientes" OR valorcadena="Todos los Pendientes"
				if this.rowsel>this.row
					.command1.caption="\<Anular Pendientes"
				else
					.command1.caption="\<Anular Pendiente"
				endif
				.command1.visible=.T.
			endif
		endwith
	ENDPROC

	PROCEDURE grid1.GotFocus
		if prompt()="Todos los Pendientes" OR valorcadena="Todos los Pendientes"
			this.selectionmode=1
		endif
	ENDPROC


	PROCEDURE Destroy
		set point to
		set separator to
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		public rpgc,sucbcc
		rpgc=0
		*!*	this.text1.value=0
		set point to ","
		set separator to "."
		IF USED("cur_deposito")
			USE IN cur_deposito
		ENDIF
		
		this.cmb_tipo.additem("CHEQUE",1)
		this.cmb_tipo.additem("ECHEQ",2)
	ENDPROC

	PROCEDURE Btn_buscar1.img_buscar.Click
		IF LEN(ALLTRIM(thisform.text6.Value))>0
			frmconch= conectar_db(_screen.cn)
				codicli=recicli.cli_codi
				SQLEXEC(frmconch,"call usp_buscarcli(?codicli);","cur_clie")
			desconectar_db(frmconch)
			pasrec=1
			DO form consrecibo WITH cur_cheq.rec_codi,recicli.cond_codi
		ENDIF
		
		
	ENDPROC

	PROCEDURE Btn_buscar2.img_buscar.Click
		IF LEN(ALLTRIM(thisform.text8.Value))>0
			DO CASE
				CASE cur_cheq.pag_codi>0
					frmconch= conectar_db(_screen.cn)
						SQLEXEC(frmconch,"select a.prov_codi,b.cond_codi from pagosprov a inner join proveedores b on a.prov_codi=b.prov_codi where a.pag_codi=?cur_cheq.pag_codi;","condiprov")
						codiprov=condiprov.prov_codi
						SQLEXEC(frmconch,"call usp_buscarprov(?codiprov);","cur_prov")
					desconectar_db(frmconch)
					paspago=1
					codipag=cur_cheq.pag_codi
					cond=condiprov.cond_codi
					DO form conspago WITH codipag,cond
				CASE cur_cheq.pagg_codi>0
					frmconch= conectar_db(_screen.cn)
						SQLEXEC(frmconch,"select a.per_codi,b.cond_codi from pagosgas a inner join personas b on a.per_codi=b.per_codi where a.pagg_codi=?cur_cheq.pagg_codi;","condiprov")
						codiper=condiprov.per_codi
						SQLEXEC(frmconch,"call usp_buscarper(?codiper);","cur_per")
					desconectar_db(frmconch)
					paspago=1
					codipag=cur_cheq.pagg_codi
					cond=condiprov.cond_codi
					DO form conspagogas WITH codipag,cond
				CASE cur_cheq.dep_codi>0
					DO FORM consdeposito WITH cur_cheq.dep_codi
			ENDCASE
		ENDIF
		
	ENDPROC

	PROCEDURE btn_cons.Click
		LOCAL xcadecheq,chnro,xcheqid,xcadeid,xrpc
		xrpc=0
		xcheqid='0001'
		
		if len(ALLTRIM(thisform.text1.value))>0
			LOCAL xtip
			xtip = IIF(thisform.xtipo=1,3,20)
			chnro=ALLTRIM(thisform.text1.value)
			xcadecheq=allt(subst(chnro,1,3))+allt(subst(chnro,4,3))
			frmconch= conectar_db(_screen.cn)
				DO case
					CASE xtip = 3
						SQLEXEC(frmconch,"select a.*,b.ban_desc,b.ban_cuit from recibos_pagos a inner join bancos b on a.ban_codi=b.ban_codi where TRIM(a.chequenro)=?ALLTRIM(chnro) and tippag_codi = 3;","cur_cheq")
					CASE xtip = 20
						SQLEXEC(frmconch,"select a.*,b.ban_desc,b.ban_cuit from recibos_pagos a inner join bancos b on a.ban_codi=b.ban_codi where TRIM(a.movtippag_nro)=?ALLTRIM(chnro) and tippag_codi = 20;","cur_cheq")
				ENDCASE
			desconectar_db(frmconch)
			if RECCOUNT("cur_cheq")>0
				IF RECCOUNT("cur_cheq")>1
					DO form consmascheq WITH chnro,xcheqid,xtip to varret
					xcheqid=IIF(thisform.xtipo=1,varret.prop2,'0001')
					xcadeid=chnro+xcheqid
					xrpc=varret.Prop3
					frmconch= conectar_db(_screen.cn)
						SQLEXEC(frmconch,"select a.*,b.ban_desc,b.ban_cuit from recibos_pagos a inner join bancos b on a.ban_codi=b.ban_codi where a.recpag_codi=?xrpc;","cur_cheq")
						**concat(TRIM(a.chequenro),TRIM(a.cheqid))
					desconectar_db(frmconch)
				ENDIF
				IF LEN(ALLTRIM(xcheqid))=0
					thisform.SetAll("Value",'',"Textbox")
					thisform.text1.SetFocus
				ELSE
					frmconch= conectar_db(_screen.cn)
						SQLEXEC(frmconch,"select a.rec_tipo,a.rec_nro,a.rec_fec,b.cli_nomb,b.cond_codi,a.cli_codi from recibos a inner join clientes b on a.cli_codi=b.cli_codi where rec_codi=?cur_cheq.rec_codi;","recicli")
						DO CASE
							CASE cur_cheq.pag_codi>0
								SQLEXEC(frmconch,"select a.pag_fech,b.prov_nomb from pagosprov a inner join proveedores b on a.prov_codi=b.prov_codi where pag_codi=?cur_cheq.pag_codi;","cur_pagocheq")
							CASE cur_cheq.pagg_codi>0
								SQLEXEC(frmconch,"select a.pagg_fech,b.per_desc from pagosgas a inner join personas b on a.per_codi=b.per_codi where pagg_codi=?cur_cheq.pagg_codi;","cur_pagocheq")
						ENDCASE
						SQLEXEC(frmconch,"select suc_nomb from sucbancos where TRIM(suc_bansuc)=?xcadecheq;","sucu")
					desconectar_db(frmconch)
					with thisform
						rpgc=cur_cheq.recpag_codi
						.text1.value=chnro
						.text2.value=allt(cur_cheq.ban_desc)
						.text3.value=cur_cheq.movtippag_imp
						.text4.value=cur_cheq.movtippag_fvto
						.text5.value=recicli.cli_nomb
						.text6.value=allt(str(recicli.rec_tipo)+"-"+allt(str(recicli.rec_nro)))
						.text7.value=recicli.rec_fec
						.label7.Caption='Entregado a:'
						.label9.Caption='Orden de Pago Nº:'
						.label10.Caption='Fecha O.P.:'
						.text8.Value=''
						.text9.Value=''
						.text10.Value=''
						STORE RGB(0,0,0) TO .label7.ForeColor,.label9.ForeColor,.label10.ForeColor
						DO case
							CASE cur_cheq.pag_codi>0
								.text8.value=cur_pagocheq.prov_nomb
								.text10.value=cur_pagocheq.pag_fech
								.text9.value=cur_cheq.pag_codi
								thisform.label9.Caption="Orden de Pago Nº:"
								thisform.xbanco  = ''
								thisform.xboleta = ''
								thisform.xfecdep = CTOD("  /  /    ")
							CASE cur_cheq.pagg_codi>0
								.text8.value=cur_pagocheq.per_desc
								.text10.value=cur_pagocheq.pagg_fech
								.text9.value=cur_cheq.pagg_codi
								thisform.label9.Caption="Orden de Pago Nº: GS"
								thisform.xbanco  = ''
								thisform.xboleta = ''
								thisform.xfecdep = CTOD("  /  /    ")
							CASE cur_cheq.dep_codi>0
								frmconch= conectar_db(_screen.cn)
									SQLEXEC(frmconch,"select b.banc_desc,a.dep_bolnro,a.dep_fech from depositos a inner join bancos_caja b on a.banc_codi = b.banc_codi;","cur_deposito")
								desconectar_db(frmconch)
								.text8.value=cur_deposito.banc_desc
								.text10.value=cur_deposito.dep_fech 
								.text9.value=cur_deposito.dep_bolnro		
								.label7.Caption="Depositado en Banco:"
								.label9.Caption="Boleta Nº:"
								.label10.Caption="Fecha Depósito:"
								STORE RGB(255,0,0) TO .label7.ForeColor,.label9.ForeColor,.label10.ForeColor										
								thisform.xbanco  = cur_deposito.banc_desc
								thisform.xboleta = cur_deposito.dep_bolnro
								thisform.xfecdep = cur_deposito.dep_fech
						OTHERWISE
							thisform.xbanco  = ''
							thisform.xboleta = ''
							thisform.xfecdep = CTOD("  /  /    ")
						ENDCASE
						.text12.value=VAL(cur_cheq.cuit_lib)
						.text11.value=sucu.suc_nomb
						sucbcc=IIF(thisform.xtipo=1,sucu.suc_nomb,'')
						.command2.enabled=.T.
					ENDWITH
				ENDIF
			else
				=messagebox("Cheque no se encuentra en archivo",0+48,"Advertencia!!!")
				thisform.SetAll("Value",'',"Textbox")
				thisform.text1.SetFocus
			endif
		endif
	ENDPROC

	PROCEDURE btn_cons.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE btn_cons.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE cmb_tipo.Click
		DO case
			CASE this.ListIndex = 1
				thisform.text1.Format = "R"
				thisform.text1.Value=""
				thisform.text1.InputMask = "999-999-99999999"
				thisform.xtipo = 1
				thisform.text1.Enabled= .T.
				thisform.text1.SetFocus
			CASE this.ListIndex = 2
				thisform.text1.Value=""
				thisform.text1.Format = ""
				thisform.text1.InputMask = ""
				thisform.xtipo = 2
				thisform.text11.Enabled= .F.
				thisform.text1.Enabled= .T.
				thisform.text1.SetFocus		
		ENDCASE
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.GotFocus
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command2.Click
		SELECT cur_cheq
		LOCATE
		report form chequenum for cur_cheq.recpag_codi=rpgc TO PRINTER PROMPT noconsole
		
	ENDPROC

	PROCEDURE Command2.GotFocus
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Text1.Click
		this.SetFocus
		
	ENDPROC

ENDDEFINE

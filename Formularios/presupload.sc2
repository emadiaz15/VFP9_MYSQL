	PROCEDURE Activate
		if codicli=0
			thisform.release
		ENDIF
	ENDPROC

	PROCEDURE buscarpresupuestosporarticulo
		LPARAMETERS tnArtCodi
		LOCAL frmpresulo
		
		IF EMPTY(tnArtCodi) OR tnArtCodi=0
			RETURN .F.
		ENDIF
		
		THISFORM.grid1.Rows = 1
		THISFORM.command2.Enabled = .F.
		
		IF USED("cur_prlo")
			USE IN cur_prlo
		ENDIF
		
		frmpresulo = conectar_db(_screen.cn)
			SQLEXEC(frmpresulo, ;
				"select distinct p.presup_codi, p.presup_fech, p.moneda,p.cli_codi " + ;
				"from presupuestos p " + ;
				"inner join presupuestos_articulos pa on p.presup_codi=pa.presup_codi " + ;
				"where p.cli_codi=?codicli and pa.art_codi=?tnArtCodi " + ;
				"order by p.presup_fech desc;", ;
				"cur_prlo")
		desconectar_db(frmpresulo)
		
		IF USED("cur_prlo") AND RECCOUNT("cur_prlo")>0
			THISFORM.lst_preslo.RowSource = "cur_prlo"
			THISFORM.lst_preslo.Selected(1)=.T.
			THISFORM.command2.Enabled=.T.
			THISFORM.CargarDetallePresupuesto()
		ELSE
			THISFORM.lst_preslo.RowSource = ""
			THISFORM.grid1.Rows = 1
			THISFORM.command2.Enabled = .F.
			MESSAGEBOX("No existen presupuestos del cliente con ese artículo.",48,"Aviso")
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargardetallepresupuesto
		LOCAL contador, frmpresulo, lnRowMatch
		LOCAL cadena, div, longdes, lcDescri, lcMask
		
		contador = 1
		lnRowMatch = 0
		
		THISFORM.grid1.Rows = 1
		
		IF !USED("cur_prlo")
			RETURN .F.
		ENDIF
		
		IF EOF("cur_prlo")
			RETURN .F.
		ENDIF
		
		IF USED("cur_parelo")
			USE IN cur_parelo
		ENDIF
		
		frmpresulo = conectar_db(_screen.cn)
			SQLEXEC(frmpresulo, ;
				"select a.art_codi,b.art_desc,a.artpres_dasc,a.artpres_precio " + ;
				"from presupuestos_articulos a " + ;
				"inner join articulos b on a.art_codi=b.art_codi " + ;
				"where a.presup_codi=?cur_prlo.presup_codi;", ;
				"cur_parelo")
		desconectar_db(frmpresulo)
		
		WITH THISFORM
			IF RECCOUNT("cur_parelo") > 0
				SELECT cur_parelo
				GO TOP
				SCAN
					cadena = REPL("0",8-LEN(ALLT(STR(cur_parelo.art_codi)))) + ALLT(STR(cur_parelo.art_codi))
		
					IF cur_parelo.art_codi=4 OR cur_parelo.art_codi=5
						lcDescri = cur_parelo.artpres_dasc
					ELSE
						lcDescri = cur_parelo.art_desc
					ENDIF
					
					lcMask= ICASE(cur_prlo.moneda="D","USD 999,999,999.99",cur_prlo.moneda="P","$ 999,999,999.99")
					
					.grid1.AddItem(STR(contador)+CHR(9)+cadena+CHR(9)+lcDescri+CHR(9)+TRANSFORM(cur_parelo.artpres_precio, lcMask))
		
					.grid1.Row = .grid1.Rows-1
					.grid1.Col = 1
		
					IF LEN(ALLT(.grid1.Text))>47
						div = LEN(ALLT(.grid1.Text))/47
						IF div>INT(div)
							longdes = INT(div)+1
						ELSE
							longdes = div
						ENDIF
						longdes = longdes*250
						.grid1.RowHeight(.grid1.Row)=longdes
					ELSE
						.grid1.RowHeight(.grid1.Row)=270
					ENDIF
		
					.grid1.Col=0
					.grid1.CellAlignment=3
					.grid1.Col=1
					.grid1.CellAlignment=3
					.grid1.Col=2
					.grid1.CellAlignment=0
					.grid1.Col=3
					.grid1.CellAlignment=8
		
					IF PEMSTATUS(THISFORM,"xArtFiltro",5) AND THISFORM.xArtFiltro>0
						IF cur_parelo.art_codi = THISFORM.xArtFiltro
							lnRowMatch = .grid1.Rows-1
						ENDIF
					ENDIF
		
					contador = contador+1
				ENDSCAN
				
				*-----------------------------------------
				* Resaltar fila encontrada al final
				*-----------------------------------------
				IF lnRowMatch > 0
					.grid1.Row = lnRowMatch
					.grid1.Col = 0
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
					.grid1.Col = 1
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
					.grid1.Col = 2
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
					.grid1.Col = 3
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
					* Dejar posicionada la fila encontrada
					.grid1.Row = lnRowMatch
				ENDIF
		
				.command2.Enabled = .T.
			ENDIF
		ENDWITH
		
		RETURN .T.
	ENDPROC

	PROCEDURE copiapresup
		LPARAMETERS ncodp
		
		LOCAL xcodp,xcond,xmoneda,xcodicli
		
		xcodp    = ncodp
		xcond    = cond
		xmoneda  = cur_prlo.moneda
		xcodicli = cur_prlo.cli_codi
		
		DO FORM presxpres WITH xcodp,xcond,xmoneda,xcodicli
		
		RETURN
	ENDPROC

	PROCEDURE Init
		parameter codicli
		SET DELETED ON
		public cond,i,valorcadena &&,codp
		
		IF !PEMSTATUS(THISFORM,"xArtFiltro",5)
			THISFORM.AddProperty("xArtFiltro",0)
		ENDIF
		
		set date british
		set cent on
		
		with thisform
			if codicli=0
				do form cliload with codicli
				cond=cond_codi
				.text1.value=cur_clie.cli_nomb
				.text2.value=cur_clie.cli_domi
				.text6.value=cur_clie.cond_desc
				.text12.value=cur_clie.cli_cuit
				.text3.value=cur_clie.cp_nro
				.text4.value=cur_clie.loca_nomb
				.text5.value=cur_clie.provi_nomb
			else
				frmprelo= conectar_db(_screen.cn)
					SQLEXEC(frmprelo,"call usp_buscarcli(?codicli);","cur_clie")
				desconectar_db(frmprelo)
				.text1.value=cur_clie.cli_nomb
				.text2.value=cur_clie.cli_domi
				.text6.value=cur_clie.cond_desc
				.text12.value=cur_clie.cli_cuit
				.text3.value=cur_clie.cp_nro
				.text4.value=cur_clie.loca_nomb
				.text5.value=cur_clie.provi_nomb
			ENDIF
			IF PEMSTATUS(.grid1,"Rows",5)
				.grid1.Rows = 1
			ENDIF
		
			.label8.Caption = ""
			.text7.Value = 0
			.xArtFiltro = 0
		
			IF USED("cur_prlo")
				USE IN cur_prlo
			ENDIF
		
			frmprelo= conectar_db(_screen.cn)
				SQLEXEC(frmprelo,"select presup_codi,presup_fech,moneda,cli_codi from presupuestos where cli_codi=?codicli order by presup_fech desc;","cur_prlo")
			desconectar_db(frmprelo)
			
			IF RECCOUNT("cur_prlo")>0
				.lst_preslo.RowSource="cur_prlo"
				.lst_preslo.Selected(1)=.T.
				.command2.enabled=.T.
				THISFORM.CargarDetallePresupuesto()
			ELSE
				.lst_preslo.RowSource=""
				.command2.enabled=.F.
			ENDIF
		endwith
	ENDPROC

	PROCEDURE recargarpresupuestoscliente
		LOCAL frmpresulo
		
		THISFORM.grid1.Rows = 1
		THISFORM.xArtFiltro = 0
		THISFORM.label8.Caption = ""
		THISFORM.text7.Value = 0
		
		IF USED("cur_prlo")
			USE IN cur_prlo
		ENDIF
		
		frmpresulo = conectar_db(_screen.cn)
			SQLEXEC(frmpresulo, ;
				"select presup_codi, presup_fech, moneda, cli_codi " + ;
				"from presupuestos " + ;
				"where cli_codi=?codicli " + ;
				"order by presup_fech desc;", ;
				"cur_prlo")
		desconectar_db(frmpresulo)
		
		IF RECCOUNT("cur_prlo") > 0
			THISFORM.lst_preslo.RowSource="cur_prlo"
			THISFORM.lst_preslo.Selected(1)=.T.
			THISFORM.command2.Enabled=.T.
			THISFORM.CargarDetallePresupuesto()
		ELSE
			THISFORM.lst_preslo.RowSource=""
			THISFORM.command2.Enabled=.F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE tomarpedido
		LPARAMETERS xpres
		
		frmplanp= conectar_db(_screen.cn)
			SQLEXEC(frmplanp,"select * from pedidos where presup_codi=?xpres;","cur_yaesta")
		desconectar_db(frmplanp)
		IF RECCOUNT("cur_yaesta")>0
			pregn=MESSAGEBOX("Este presupuesto ya fue confirmado por el Cliente total o parcialmente con el número "+ALLTRIM(STR(cur_yaesta.ped_codi))+" el día "+ALLTRIM(DTOC(cur_yaesta.ped_fech))+"."+CHR(13)+chr(13)+;
							 "¿Continúa Igualente?",4+48+256,"Aviso del Sistema")
			IF pregn=6
				do form selecitem with xpres,cond,codicli
				cerrar_cursor("cur_yaesta")
			ELSE
				cerrar_cursor("cur_yaesta")
			ENDIF
		ELSE
			codicli=cur_prlo.cli_codi
			do form selecitem with xpres,cur_prlo.cond_codi,codicli
			cerrar_cursor("cur_yaesta")
		ENDIF
	ENDPROC

	PROCEDURE Command1.Click
		local paso
		paso=0
		thisform.grid1.rows=1
		do form cliload with codicli
		cond=cond_codi
		with thisform
			.text1.value=cur_clie.cli_nomb
			.text2.value=cur_clie.cli_domi
			.text6.value=cur_clie.cond_desc
			.text12.value=cur_clie.cli_cuit
			.text3.value=cur_clie.cp_nro
			.text4.value=cur_clie.loca_nomb
			.text5.value=cur_clie.provi_nomb
			frmprelo= conectar_db(_screen.cn)
				SQLEXEC(frmprelo,"select presup_codi,presup_fech,moneda from presupuestos where cli_codi=?codicli order by presup_fech desc;","cur_prlo")
			desconectar_db(frmprelo)
			IF RECCOUNT("cur_prl")>0
				thisform.lst_preslo.RowSource="cur_prlo"
				thisform.lst_preslo.Selected(1)=.T.		
				thisform.command2.enabled=.T.
				thisform.lst_preslo.SetFocus
				thisform.cargardetallepresupuesto()
			ENDIF	
		endwith
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command2.Click
		LOCAL xcodp
		
		do case
			case valorcadena="Por Cliente"
				xcodp=cur_prlo.presup_codi
				frmnpres= conectar_db(_screen.cn)
					SQLEXEC(frmnpres,"select * from pedidos where presup_codi=?xcodp;","cur_yaesta")
				desconectar_db(frmnpres)
				IF RECCOUNT("cur_yaesta")>0
					pregn=MESSAGEBOX("Este presupuesto ya fue confirmado por el Cliente total o parcialmente con el número "+ALLTRIM(STR(cur_yaesta.ped_codi))+" el día "+ALLTRIM(DTOC(cur_yaesta.ped_fech))+"."+CHR(13)+chr(13)+;
									 "¿Continúa Igualente?",4+48+256,"Aviso del Sistema")
					IF pregn=6
						do form selecitem with xcodp,cond,codicli
						cerrar_cursor("cur_yaesta")
						thisform.release
					ENDIF
				ELSE
					do form selecitem with xcodp,cond,codicli
					cerrar_cursor("cur_yaesta")
					thisform.release
				ENDIF
			case valorcadena="Por Nota de Pedido"
				xcodp=cur_prlo.presup_codi
				do form pedicli with xcodp,cond
				thisform.release
			case valorcadena="Por Nombre de Cliente"
				xcodp=cur_prlo.presup_codi
				do form modipresup with xcodp,cond
				thisform.release
			case valorcadena="Presupuestos por Cliente"
				xcodp=cur_prlo.presup_codi
				do form conspresup with xcodp,cond
				thisform.release
		endcase
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command4.Click
		LOCAL frmpresulo
		
		codigo=0
		DO FORM artload WITH codigo
		
		IF codigo>0
			THISFORM.xArtFiltro = codigo
			THISFORM.text7.Value = codigo
		
			IF USED("cur_artbus")
				USE IN cur_artbus
			ENDIF
		
			frmpresulo = conectar_db(_screen.cn)
				SQLEXEC(frmpresulo,"select art_desc from articulos where art_codi=?codigo;","cur_artbus")
			desconectar_db(frmpresulo)
		
			IF USED("cur_artbus") AND RECCOUNT("cur_artbus")>0
				THISFORM.label8.Caption = ALLTRIM(cur_artbus.art_desc)
			ELSE
				THISFORM.label8.Caption = ""
			ENDIF
		
			THISFORM.BuscarPresupuestosPorArticulo(codigo)
		ENDIF
	ENDPROC

	PROCEDURE Command4.GotFocus
		RETURN
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
	ENDPROC

	PROCEDURE grid1.GotFocus
		cond=cur_clie.cond_codi
		on key label INS do form cualart with cond
		if localiz=1
			if elimi=0
				this.toprow=item	
			else
				elimi=0
			endif
		endif
	ENDPROC

	PROCEDURE lst_preslo.Click
		THISFORM.CargarDetallePresupuesto()
	ENDPROC

	PROCEDURE lst_preslo.KeyPress
		&& presupload.lst_preslo.keypress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = 13
			THISFORM.CargarDetallePresupuesto()
		
			IF THISFORM.Command2.Enabled
				THISFORM.Command2.Click()
			ENDIF
		
			NODEFAULT
		ENDIF
	ENDPROC

	PROCEDURE lst_preslo.RightClick
		IF USED("cur_prlo")
			LOCAL lcShortcut, loRef, xcodpres, xcond
			_screen.callplanipre=1
			xcodpres = cur_prlo.presup_codi
			xcond    = cond
			valorcadena = ''
			_screen.estapres=1
			
			m.loRef = thisform
			m.lcShortcut = SYS(2015)
			thisform.nMenupop = m.lcShortcut
		
			DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
			DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Consultar Presupuesto] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
			DEFINE BAR 2 OF (m.lcShortcut) PROMPT [Modificar Presupuesto] PICTURE "C:\VFP9_MYSQL\imagen\misc_1_911.ico"
			DEFINE BAR 3 OF (m.lcShortcut) PROMPT [Copiar Presupuesto] PICTURE "C:\VFP9_MYSQL\imagen\facxped.png"
			DEFINE BAR 4 OF (m.lcShortcut) PROMPT [Tomar Pedido] PICTURE "C:\VFP9_MYSQL\imagen\VBE7_1251.ico"
				
			ON SELECTION BAR 1 OF (m.lcShortcut) DO FORM conspresup WITH xcodpres,xcond
			ON SELECTION BAR 2 OF (m.lcShortcut) DO FORM modipresup WITH xcodpres,xcond
			ON SELECTION BAR 3 OF (m.lcShortcut) m.loRef.copiapresup(xcodpres)
			ON SELECTION BAR 4 OF (m.lcShortcut) m.loRef.tomarpedido(xcodpres)
		
			ACTIVATE POPUP (m.lcShortcut)
			RELEASE POPUP (m.lcShortcut)
		ENDIF
	ENDPROC

	PROCEDURE Text1.GotFocus
		*!*	if codicli<>0
		*!*		with thisform
		*!*			.text1.value=cli_nomb
		*!*			.text2.value=cli_domi
		*!*			.text6.value=condiva.cond_desc
		*!*			.text12.value=cli_cuit
		*!*			.text3.value=codipostales.cp_nro
		*!*			.text4.value=localidades.loca_nomb
		*!*			.text5.value=provincias.provi_nomb
		*!*			.list1.rowsourcetype=3

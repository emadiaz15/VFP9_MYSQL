		*!*		endwith
		*!*	endif
		
	ENDPROC

	PROCEDURE Text7.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text7.InteractiveChange
		LOCAL lccadena
		lccadena = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lccadena) OR lccadena="0"
			THISFORM.RecargarPresupuestosCliente()
		ENDIF
	ENDPROC

	PROCEDURE Text7.LostFocus
		RETURN
	ENDPROC

	PROCEDURE Text7.Valid
		LOCAL lncodigoart, lccadena, frmpresulo
		
		lccadena = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lccadena) OR lccadena="0"
			THISFORM.RecargarPresupuestosCliente()
			RETURN .T.
		ENDIF
		
		lncodigoart = VAL(lccadena)
		
		IF lncodigoart<=0
			THISFORM.xArtFiltro = 0
			THISFORM.label8.Caption = ""
			RETURN .T.
		ENDIF
		
		IF USED("cur_artbus")
			USE IN cur_artbus
		ENDIF
		
		frmpresulo = conectar_db(_screen.cn)
			SQLEXEC(frmpresulo,"select art_desc from articulos where art_codi=?lncodigoart;","cur_artbus")
		desconectar_db(frmpresulo)
		
		IF USED("cur_artbus") AND RECCOUNT("cur_artbus")>0
			THISFORM.xArtFiltro = lncodigoart
			THISFORM.label8.Caption = ALLTRIM(cur_artbus.art_desc)
			THISFORM.BuscarPresupuestosPorArticulo(lncodigoart)
		ELSE
			THISFORM.xArtFiltro = 0
			THISFORM.label8.Caption = ""
			MESSAGEBOX("No existe un artículo con ese código.",48,"Aviso")
		ENDIF
		
		RETURN .T.
	ENDPROC

ENDDEFINE

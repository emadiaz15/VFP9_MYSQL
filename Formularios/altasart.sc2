	PROCEDURE Activate
		LOCAL opcodi,auxrub
		d=1
		valor=0
		precio=0
		aviso=0
		opcodi=''
		auxrub=0
		if buscar=1
			buscar=0
			thisform.grd_artrub.RecordSource=''
			thisform.grd_artrub.Refresh
			
			do form rubload with rubroc,rubrod TO xparrub
			rubroc=xparrub.xcodrub
			rubrod=xparrub.xdesrub
		
			IF rubroc>0
				frmaltart= conectar_db(_screen.cn)
					SQLEXEC(frmaltart,"select * from articulos where rub_codi=?rubroc;","cur_art")
				desconectar_db(frmaltart)
				do form altartpreg with opcodi TO xopcodi
				
				DO case
					CASE xopcodi.prop01='I'
						thisform.shape1.visible=.T.
						thisform.label6.visible=.T.
						thisform.text5.visible=.T.
						cadena="  "+repl("0",8-len(allt(str(rubroc))))+allt(str(rubroc))
						thisform.text5.value=cadena+"  |  "+rubrod
						GO top IN cur_art
						thisform.grd_artrub.RecordSource="cur_art"
						thisform.grd_artrub.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
						thisform.grd_artrub.Visible= .T.
						thisform.text1.ReadOnly= .F.
					CASE xopcodi.prop01='G'
						GO BOTTOM in cur_art
						if cur_art.rub_codi=rubroc
							frmaltart= conectar_db(_screen.cn)
								SQLEXEC(frmaltart,"select * from rubros order by rub_codi;","cur_rubix")
							desconectar_db(frmaltart)
							LOCATE FOR rub_codi=rubroc
							skip
							if !eof()
								auxrub=cur_rubix.rub_codi
							else
								auxrub=100000000
							endif
							if cur_art.art_codi+1>=auxrub
								messagebox("El rubro seleccionado no tiene mas códigos disponibles para generar, seleccione otro rubro haciendo clic en el botón Buscar otro Rubro,"+ ;
								           "o intente seleccionar la opción <<Ingresar Código>> para verificar si existen códigos intermedios disponbibles.",0+48,"Error al generar código")
								this.value=0
								cerrar_cursor("cur_rubix")
								return 0
							ELSE
								thisform.text1.value=cur_art.art_codi+1
								cerrar_cursor("cur_rubix")
								thisform.text2.setfocus
							ENDIF
						else
							thisform.text1.value=rubroc+1
							thisform.text2.setfocus
						endif		
				ENDCASE
			ENDIF
		endif
		if prompt()="Presupuestos de Clientes" or prompt()="Presupuestos Clientes" or prompt()="Por Presupuesto" or prompt()="Por Artículo" or prompt()="Alta de Stock"
			thisform.command2.visible=.F.
			thisform.command4.visible=.F.
		endif
		
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 5 of Altas .F.
		buscar=1
		RELEASE rubroc,rubrod
		
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		parameters codigo,nombre
		SET POINT TO
		SET SEPARATOR TO 
		public rubroc,rubrod
		rubroc=0
		rubrod=''
		thisform.text1.value=0
		thisform.lbl_carn.Caption=""
		frmaltart= conectar_db(_screen.cn)
			SQLEXEC(frmaltart,"select * from iva order by iva_codi desc;","cur_iva")
		desconectar_db(frmaltart)
		this.combo1.additem(allt(str(cur_iva.iva_1,10,2))+"%",1)
		this.combo1.additem(allt(str(cur_iva.iva_2,10,2))+"%",2)
		this.combo1.value=allt(str(cur_iva.iva_1,10,2))+"%"
	ENDPROC

	PROCEDURE Load
		set skip of bar 5 of Altas .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	set skip of bar 5 of Altas .F.
		*!*	if prompt()<>"Artículos"
		*!*		this.hide
		*!*	endif
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(215,215,215)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Unload
		return codigo
		return nombre
	ENDPROC

	PROCEDURE Combo1.Click
		KEYBOARD '{TAB}'
	ENDPROC

	PROCEDURE Command1.Click
		set skip of bar 6 of Altas .F.
		thisform.release
	ENDPROC

	PROCEDURE Command1.GotFocus
		thisform.command3.setfocus
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		LOCAL opcodi
		opcodi=''
		rubroc=0
		rubrod=''
		thisform.lbl_carn.Caption=""
		thisform.text5.visible=.F.
		thisform.label6.visible=.F.
		thisform.shape1.visible=.F.
		thisform.command3.enabled=.F.
		thisform.text1.value=0
		thisform.text2.value=""
		thisform.text4.value=""
		thisform.grd_artrub.RecordSource=''
		thisform.grd_artrub.Refresh
		
		do form rubload with rubroc,rubrod TO xparrub
		rubroc=xparrub.xcodrub
		rubrod=xparrub.xdesrub
		
		IF rubroc>0
			frmaltart= conectar_db(_screen.cn)
				SQLEXEC(frmaltart,"select * from articulos where rub_codi=?rubroc;","cur_art")
			desconectar_db(frmaltart)
		
			do form altartpreg with opcodi TO xopcodi
		
			DO case
				CASE xopcodi.prop01='I'
					thisform.shape1.visible=.T.
					thisform.label6.visible=.T.
					thisform.text5.visible=.T.
					cadena="  "+repl("0",8-len(allt(str(rubroc))))+allt(str(rubroc))
					thisform.text5.value=cadena+"  |  "+rubrod
					GO top IN cur_art
					thisform.grd_artrub.RecordSource="cur_art"
					thisform.grd_artrub.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
					thisform.grd_artrub.Visible= .T.
					thisform.text1.ReadOnly= .F.
					thisform.text1.SetFocus
				CASE xopcodi.prop01='G'
					GO BOTTOM in cur_art
					if cur_art.rub_codi=rubroc
						frmaltart= conectar_db(_screen.cn)
							SQLEXEC(frmaltart,"select * from rubros order by rub_codi;","cur_rubix")
						desconectar_db(frmaltart)
						LOCATE FOR rub_codi=rubroc
						skip
						if !eof()
							auxrub=cur_rubix.rub_codi
						else
							auxrub=100000000
						endif
						if cur_art.art_codi+1>=auxrub
							messagebox("El rubro seleccionado no tiene mas códigos disponibles para generar, seleccione otro rubro haciendo clic en el botón Buscar otro Rubro.",0+48,"Error al generar código")
							this.value=0
							cerrar_cursor("cur_rubix")
							return 0
						ELSE
							thisform.text1.value=cur_art.art_codi+1
							cerrar_cursor("cur_rubix")
							thisform.text2.setfocus
						ENDIF
					else
						thisform.text1.value=rubroc+1
						thisform.text2.setfocus
					endif		
			ENDCASE
		ENDIF
		
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		guar=messagebox("¿Confirma los datos Ingresados?",4+32+256,"Artículos")
		if guar=6
			frmaltart= conectar_db(_screen.cn)
				with thisform
					LOCAL xcodi,xdesc,xprec,xmed,xali
					xcodi=.text1.value
					xdesc=ALLTRIM(.text2.value)
					xprec=.text4.value
					do case
						case .optiongroup1.value=1
							xmed="UN"
						case .optiongroup1.value=2
							xmed="MT"
						case .optiongroup1.value=3
							xmed="KG"
					endcase
					sele cur_iva
					do case
						case ConverNro(.combo1.value)=cur_iva.iva_1
							xali=1
						case ConverNro(.combo1.value)=cur_iva.iva_2
							xali=2
					endcase
					.text1.value=0
					.text2.value=" "
					.text4.value=val(" ")
					.command4.enabled=.T.
				ENDWITH
				SQLEXEC(frmaltart,"insert into articulos values(?xcodi,?xdesc,0,?xprec,0,?rubroc,?xmed,0,0,0,'','',?xali);")
				SQLEXEC(frmaltart,"insert into histostock values(null,?xcodi,current_date(),current_time(),'E',0,0,0,'STOCK INICIAL','',0,0,0,0,0,0,0);")
				************************** SE CONECTA AL SERVIDOR ILUMET Y AGREGA TAMBIÉN EL NUEVO ARTÍCULO ********************
				conexterna= conectar_db(_screen.xconext)
				IF VARTYPE(conexterna) = "N" AND conexterna > 0
					SQLEXEC(conexterna,"select * from articulos where art_codi = ?xcodi;","cur_artext")
					IF USED("cur_artext")
						IF RECCOUNT("cur_artext") = 0
							SQLEXEC(conexterna,"insert into articulos values(?xcodi,?xdesc,0,?xprec,0,?rubroc,?xmed,0,0,0,'','',?xali);")
							SQLEXEC(conexterna,"insert into histostock values(null,?xcodi,current_date(),current_time(),'E',0,0,0,'STOCK INICIAL','',0,0,0,0,0,0,0);")
						ENDIF
						cerrar_cursor="cur_artext"
					ENDIF
					desconectar_db(conexterna)
				ENDIF
				************************** FIN PROCESO SERVIDOR ILUMET **************************		
				codigo=xcodi
				nombre=xdesc
			desconectar_db(frmaltart)
		else
			thisform.text2.setfocus
		endif
		this.enabled=.F.
		do case
			case prompt()="Presupuestos de Clientes" or prompt()="Presupuestos Clientes"
				with cualart
					paso=0
					.text1.value=codigo
					.text3.value=nombre
					.text4.value=str(xprec,10,3)
					.text2.setfocus
				endwith
				thisform.release
			case prompt()="Alta de Stock"
				if codigo>0
					altastock.text1.value=codigo
					altastock.text2.value=nombre
					altastock.text3.setfocus
				endif
		endcase
		if muestro=1
			thisform.release
		endif
		
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		LOCAL opcodi
		opcodi=''
		thisform.lbl_carn.Caption=""
		thisform.shape1.visible=.T.
		thisform.label6.visible=.T.
		thisform.text5.visible=.T.
		cadena="  "+repl("0",8-len(allt(str(rubroc))))+allt(str(rubroc))
		thisform.text5.value=cadena+"  |  "+rubrod
		
		thisform.grd_artrub.RecordSource=''
		thisform.grd_artrub.Refresh
		
		frmaltart= conectar_db(_screen.cn)
			SQLEXEC(frmaltart,"select * from articulos where rub_codi=?rubroc;","cur_art")
		desconectar_db(frmaltart)
		do form altartpreg with opcodi TO xopcodi
		
		DO case
			CASE xopcodi.prop01='I'
				thisform.shape1.visible=.T.
				thisform.label6.visible=.T.
				thisform.text5.visible=.T.
				cadena="  "+repl("0",8-len(allt(str(rubroc))))+allt(str(rubroc))
				thisform.text5.value=cadena+"  |  "+rubrod
				GO top IN cur_art
				thisform.grd_artrub.RecordSource="cur_art"
				thisform.grd_artrub.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
				thisform.grd_artrub.Visible= .T.
				thisform.text1.ReadOnly= .F.
				thisform.text1.SetFocus
			CASE xopcodi.prop01='G'
				GO BOTTOM in cur_art
				if cur_art.rub_codi=rubroc
					frmaltart= conectar_db(_screen.cn)
						SQLEXEC(frmaltart,"select * from rubros order by rub_codi;","cur_rubix")
					desconectar_db(frmaltart)
					LOCATE FOR rub_codi=rubroc
					skip
					if !eof()
						auxrub=cur_rubix.rub_codi
					else
						auxrub=100000000
					endif
					if cur_art.art_codi+1>=auxrub
						messagebox("El rubro seleccionado no tiene mas códigos disponibles para generar, seleccione otro rubro haciendo clic en el botón Buscar otro Rubro.",0+48,"Error al generar código")
						this.value=0
						cerrar_cursor("cur_rubix")
						return 0
					ELSE
						thisform.text1.value=cur_art.art_codi+1
						cerrar_cursor("cur_rubix")
						thisform.text2.setfocus
					ENDIF
				else
					thisform.text1.value=rubroc+1
					thisform.text2.setfocus
				endif		
		ENDCASE
		
		this.enabled=.F.
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Optiongroup1.Click
		thisform.command3.setfocus
	ENDPROC

	PROCEDURE Optiongroup1.Option1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Optiongroup1.Option2.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Optiongroup1.Option3.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Text1.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE Text1.LostFocus
		*!*	thisform.grd_artrub.visible=.F.
		*!*	thisform.label7.visible=.T.
		*!*	thisform.label4.visible=.T.
		*!*	thisform.combo1.visible=.T.
		*!*	this.ReadOnly=.T.
	ENDPROC

	PROCEDURE Text1.Valid
		LOCAL auxrub
		if last()<>27 and this.value>0
			frmaltart= conectar_db(_screen.cn)
				SQLEXEC(frmaltart,"select * from articulos where art_codi=?this.value;","cur_artnue")
			desconectar_db(frmaltart)
			if RECCOUNT("cur_artnue")>0
				messagebox("Artículo ya está en archivo",0+48,"Error al ingresar código")
				this.value=0
				return 0
			ENDIF
			frmaltart= conectar_db(_screen.cn)
				SQLEXEC(frmaltart,"select * from rubros order by rub_codi;","cur_rubros")
			desconectar_db(frmaltart)
			LOCATE FOR rub_codi=rubroc
			SKIP
			if !eof()
				auxrub=cur_rubros.rub_codi
			else
				auxrub=100000000
			endif
			do case
				case this.value>=auxrub
					messagebox("El código de artículo ingresado no pertenece al"+chr(13)+ ;
								"rubro seleccionado. Debe respetar el intérvalo "+chr(13)+ ;
								"de códigos."+chr(13)+"El intérvalo es: "+str(rubroc+1)+ ;
								" al "+str(auxrub-1),0+48,"Error al ingresar código")
					this.value=0
					return 0
				case this.value<rubroc
					messagebox("El código de artículo ingresado no pertenece al"+chr(13)+ ;
								"rubro seleccionado. Debe respetar el intérvalo "+chr(13)+ ;
								"de códigos."+chr(13)+"El intérvalo es: "+str(rubroc+1)+ ;
								" al "+str(auxrub-1),0+48,"Error al ingresar código")
					this.value=0
					return 0
				case this.value=rubroc
					messagebox("El código de artículo ingresado es idéntico al"+chr(13)+ ;
								"código del rubro seleccionado. Debe respetar "+chr(13)+ ;
								"el intérvalo de códigos."+chr(13)+"El intérvalo es: "+str(rubroc+1)+ ;
								" al "+str(auxrub-1),0+48,"Error al ingresar código")
					this.value=0
					return 0
			OTHERWISE
				thisform.grd_artrub.visible=.F.
				thisform.label7.visible=.T.
				thisform.label4.visible=.T.
				thisform.combo1.visible=.T.
				this.ReadOnly=.T.
			ENDCASE
		endif
	ENDPROC

	PROCEDURE Text2.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Text2.InteractiveChange
		thisform.lbl_carn.Caption=ALLTRIM(STR(LEN(ALLTRIM(this.Value))))
		IF LEN(ALLTRIM(this.Value))=45
			thisform.lbl_carn.ForeColor= RGB(255,0,0)
		ELSE
			thisform.lbl_carn.ForeColor= RGB(0,0,0)
		ENDIF
	ENDPROC

	PROCEDURE Text2.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Text4.GotFocus
		set point to "."
		set separator to ","
		
	ENDPROC

	PROCEDURE Text4.LostFocus
		thisform.command3.enabled=.T.
		thisform.text5.visible=.F.
		thisform.label6.visible=.F.
		thisform.shape1.visible=.F.
		
	ENDPROC


	PROCEDURE Activate
		if codiprov=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE Init
		parameter codiprov
		public cond,i,codipag,postal,provi,locali
		
		LOCAL xtcomp,xncomp
		STORE '' TO xtcomp,xncomp
		
		create cursor fac(recep_conc C(1),prov_tipfac C(1),prov_pto N(4),prov_fac N(8),recep_fec D,pagrecep_impo N(15,2))
		create cursor sic(sini_cod N(8),sini_fech D,pagsini_imp N(15,2))
		create cursor dic(debc_codi N(8),debc_fech D,pagdebi_imp N(15,2))
		create cursor cic(crec_codi N(8),crec_fech D,pagcrei_imp N(15,2))
		create cursor facsic(tcomp C(3),ncomp C(13),facsic_fec D,facsic_imp N(15,2))
		
		postal=0
		provi=""
		locali=""
		set date british
		set cent on
		set dele on
		with thisform
			if codiprov=0
				do form provload with proveedor,codiprov
				cond=cond_codi
				.text1.value=cur_prov.prov_nomb
				.text2.value=cur_prov.prov_domi
				.text6.value=cur_prov.cond_desc
				.text12.value=cur_prov.prov_cuit
				.text3.value=cur_prov.cp_nro
				.text4.value=cur_prov.loca_nomb
				.text5.value=cur_prov.provi_nomb
			ELSE
				frmordlo= conectar_db(_screen.cn)
					SQLEXEC(frmordlo,"call usp_buscarprov(?codiprov);","cur_prov")
				desconectar_db(frmordlo)
				.text1.value=cur_prov.prov_nomb
				.text2.value=cur_prov.prov_domi
				.text6.value=cur_prov.cond_desc
				.text12.value=cur_prov.prov_cuit
				.text3.value=cur_prov.cp_nro
				.text4.value=cur_prov.loca_nomb
				.text5.value=cur_prov.provi_nomb
			ENDIF
			frmpaglo= conectar_db(_screen.cn)
				SQLEXEC(frmpaglo,"select pag_codi,pag_fech from pagosprov where prov_codi=?codiprov ORDER BY pag_fech DESC;","cur_ol")
			desconectar_db(frmpaglo)
			IF RECCOUNT("cur_ol")>0
				thisform.lst_pagos.RowSource="cur_ol"
				codipag=cur_ol.pag_codi
				thisform.grid1.rows=1
				SET DECIMALS TO 3
				frmpaglo= conectar_db(_screen.cn)
					SQLEXEC(frmpaglo,"select b.recep_conc,b.prov_tipfac,b.prov_pto,b.prov_fac,b.recep_fec,a.pagrecep_impo from pagosprov_recepciones a inner join recepciones b on a.recep_codi=b.recep_codi where a.pag_codi=?codipag;","fac")
					SQLEXEC(frmpaglo,"select b.sini_cod,b.sini_fech,a.pagsini_imp from pagos_saldosiniprov a inner join saldosiniprov b on a.sini_cod=b.sini_cod where a.pag_codi=?codipag;","sic")
					SQLEXEC(frmpaglo,"select b.debc_codi,b.debc_fech,a.pagdebi_imp from pagosprov_debintc a inner join debintc b on a.debc_codi=b.debc_codi where a.pag_codi=?codipag;","dic")
					SQLEXEC(frmpaglo,"select b.crec_codi,b.crec_fech,a.pagcrei_imp from pagosprov_creintc a inner join creintc b on a.crec_codi=b.crec_codi where a.pag_codi=?codipag;","cic")
				desconectar_db(frmpaglo)
				SET DECIMALS TO
				GO top
				IF RECCOUNT("fac")+RECCOUNT("sic")+RECCOUNT("dic")>0+RECCOUNT("cic")>0
					sele fac
					go top
					SCAN
						xtcomp= ICASE(fac.recep_conc="N","NC"+ALLTRIM(fac.prov_tipfac), ;
									  fac.recep_conc="D","ND"+ALLTRIM(fac.prov_tipfac), ;
									  "F"+ALLTRIM(fac.prov_tipfac))
						xncomp= ALLTRIM(REPLICATE("0",4-LEN(ALLTRIM(STR(fac.prov_pto))))+ALLTRIM(STR(fac.prov_pto))+"-"+;
										REPLICATE("0",8-LEN(ALLTRIM(STR(fac.prov_fac))))+ALLTRIM(STR(fac.prov_fac)))
						insert into facsic(tcomp,ncomp,facsic_fec,facsic_imp) ;
									values(xtcomp,xncomp,fac.recep_fec,fac.pagrecep_impo)
					endscan
					sele sic
					go top
					SCAN
						xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(sic.sini_cod))))+ALLTRIM(STR(sic.sini_cod)))
						insert into facsic(tcomp,ncomp,facsic_fec,facsic_imp) ;
									values("SIC",xncomp,sic.sini_fech,sic.pagsini_imp)
					ENDSCAN
					sele dic
					go top
					SCAN
						xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(dic.debc_codi))))+ALLTRIM(STR(dic.debc_codi)))
						insert into facsic(tcomp,ncomp,facsic_fec,facsic_imp) ;
									values("DIC",xncomp,dic.debc_fech,dic.pagdebi_imp)
					ENDSCAN
					sele cic
					go top
					SCAN
						xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(cic.crec_codi))))+ALLTRIM(STR(cic.crec_codi)))
						insert into facsic(tcomp,ncomp,facsic_fec,facsic_imp) ;
									values("CIC",xncomp,cic.crec_fech,cic.pagcrei_imp)
					endscan
					
					sele facsic
					index on facsic_fec to SYS(2015)
					LOCATE
					
					SCAN
						.grid1.additem(tcomp+chr(9)+ncomp+chr(9)+dtoc(facsic_fec)+CHR(9)+TRANSFORM(facsic_imp, "$ 999,999,999.99"))
					ENDSCAN
				ENDIF
				thisform.lst_pagos.Selected(1)=.T.
				thisform.command2.enabled=.T.
			ENDIF
		ENDWITH
	ENDPROC

	PROCEDURE Command1.Click
		thisform.grid1.rows=1
		SET SAFETY off
		SELECT fac
		ZAP
		SELECT sic
		ZAP
		SELECT dic
		ZAP
		SELECT facsic
		ZAP
		SET SAFETY on
		do form provload with codiprov
		cond=cond_codi
		with thisform
			.text1.value=cur_prov.prov_nomb
			.text2.value=cur_prov.prov_domi
			.text6.value=cur_prov.cond_desc
			.text12.value=cur_prov.prov_cuit
			.text3.value=cur_prov.cp_nro
			.text4.value=cur_prov.loca_nomb
			.text5.value=cur_prov.provi_nomb
			frmpaglo= conectar_db(_screen.cn)
				SQLEXEC(frmpaglo,"select pag_codi,pag_fech from pagosprov where prov_codi=?codiprov ORDER BY pag_fech DESC;","cur_ol")
			desconectar_db(frmpaglo)
			IF RECCOUNT("cur_ol")>0
				thisform.lst_pagos.RowSource="cur_ol"
				codipag=cur_ol.pag_codi
				thisform.grid1.rows=1
				SET DECIMALS TO 3
				frmpaglo= conectar_db(_screen.cn)
					SQLEXEC(frmpaglo,"select b.recep_conc,b.prov_tipfac,b.prov_pto,b.prov_fac,b.recep_fec,a.pagrecep_impo from pagosprov_recepciones a inner join recepciones b on a.recep_codi=b.recep_codi where a.pag_codi=?codipag;","fac")
					SQLEXEC(frmpaglo,"select b.sini_cod,b.sini_fech,a.pagsini_imp from pagos_saldosiniprov a inner join saldosiniprov b on a.sini_cod=b.sini_cod where a.pag_codi=?codipag;","sic")
					SQLEXEC(frmpaglo,"select b.debc_codi,b.debc_fech,a.pagdebi_imp from pagosprov_debintc a inner join debintc b on a.debc_codi=b.debc_codi where a.pag_codi=?codipag;","dic")
					SQLEXEC(frmpaglo,"select b.crec_codi,b.crec_fech,a.pagcrei_imp from pagosprov_creintc a inner join creintc b on a.crec_codi=b.crec_codi where a.pag_codi=?codipag;","cic")
				desconectar_db(frmpaglo)
				SET DECIMALS TO
				GO top
				IF RECCOUNT("fac")+RECCOUNT("sic")+RECCOUNT("dic")>0+RECCOUNT("cic")>0
					sele fac
					go top
					SCAN
						xtcomp= ICASE(fac.recep_conc="N","NC"+ALLTRIM(fac.prov_tipfac), ;
									  fac.recep_conc="D","ND"+ALLTRIM(fac.prov_tipfac), ;
									  "F"+ALLTRIM(fac.prov_tipfac))
						xncomp= ALLTRIM(REPLICATE("0",4-LEN(ALLTRIM(STR(fac.prov_pto))))+ALLTRIM(STR(fac.prov_pto))+"-"+;
										REPLICATE("0",8-LEN(ALLTRIM(STR(fac.prov_fac))))+ALLTRIM(STR(fac.prov_fac)))
						insert into facsic(tcomp,ncomp,facsic_fec,facsic_imp) ;
									values(xtcomp,xncomp,fac.recep_fec,fac.pagrecep_impo)
					endscan
					sele sic
					go top
					SCAN
						xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(sic.sini_cod))))+ALLTRIM(STR(sic.sini_cod)))
						insert into facsic(tcomp,ncomp,facsic_fec,facsic_imp) ;
									values("SIC",xncomp,sic.sini_fech,sic.pagsini_imp)
					ENDSCAN
					sele dic
					go top
					SCAN
						xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(dic.debc_codi))))+ALLTRIM(STR(dic.debc_codi)))
						insert into facsic(tcomp,ncomp,facsic_fec,facsic_imp) ;
									values("DIC",xncomp,dic.debc_fech,dic.pagdebi_imp)
					ENDSCAN
					sele cic
					go top
					SCAN
						xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(cic.crec_codi))))+ALLTRIM(STR(cic.crec_codi)))
						insert into facsic(tcomp,ncomp,facsic_fec,facsic_imp) ;
									values("CIC",xncomp,cic.crec_fech,cic.pagcrei_imp)
					endscan
					
					sele facsic
					index on facsic_fec to SYS(2015)
					LOCATE
					
					SCAN
						.grid1.additem(tcomp+chr(9)+ncomp+chr(9)+dtoc(facsic_fec)+CHR(9)+TRANSFORM(facsic_imp, "$ 999,999,999.99"))
					ENDSCAN
				ENDIF
				thisform.lst_pagos.Selected(1)=.T.
				thisform.command2.enabled=.T.
				thisform.lst_pagos.SetFocus
			ENDIF
		endwith
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command2.Click
		codipag=cur_ol.pag_codi
		cond=cur_prov.cond_codi
		do form conspago with codipag,cond
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE lst_pagos.Click
		thisform.grid1.rows=1
		SET SAFETY off
		SELECT fac
		ZAP
		SELECT sic
		ZAP
		SELECT dic
		ZAP
		SELECT facsic
		ZAP
		SET SAFETY on
		codipag=cur_ol.pag_codi
		WITH thisform
			SET DECIMALS TO 3
			frmpaglo= conectar_db(_screen.cn)
				SQLEXEC(frmpaglo,"select b.recep_conc,b.prov_tipfac,b.prov_pto,b.prov_fac,b.recep_fec,a.pagrecep_impo from pagosprov_recepciones a inner join recepciones b on a.recep_codi=b.recep_codi where a.pag_codi=?codipag;","fac")
				SQLEXEC(frmpaglo,"select b.sini_cod,b.sini_fech,a.pagsini_imp from pagos_saldosiniprov a inner join saldosiniprov b on a.sini_cod=b.sini_cod where a.pag_codi=?codipag;","sic")
				SQLEXEC(frmpaglo,"select b.debc_codi,b.debc_fech,a.pagdebi_imp from pagosprov_debintc a inner join debintc b on a.debc_codi=b.debc_codi where a.pag_codi=?codipag;","dic")
				SQLEXEC(frmpaglo,"select b.crec_codi,b.crec_fech,a.pagcrei_imp from pagosprov_creintc a inner join creintc b on a.crec_codi=b.crec_codi where a.pag_codi=?codipag;","cic")
			desconectar_db(frmpaglo)
			SET DECIMALS TO
			GO top
			IF RECCOUNT("fac")+RECCOUNT("sic")+RECCOUNT("dic")>0+RECCOUNT("cic")>0
				sele fac
				go top
				SCAN
					xtcomp= ICASE(fac.recep_conc="N","NC"+ALLTRIM(fac.prov_tipfac), ;
								  fac.recep_conc="D","ND"+ALLTRIM(fac.prov_tipfac), ;
								  "F"+ALLTRIM(fac.prov_tipfac))
					xncomp= ALLTRIM(REPLICATE("0",4-LEN(ALLTRIM(STR(fac.prov_pto))))+ALLTRIM(STR(fac.prov_pto))+"-"+;
									REPLICATE("0",8-LEN(ALLTRIM(STR(fac.prov_fac))))+ALLTRIM(STR(fac.prov_fac)))
					insert into facsic(tcomp,ncomp,facsic_fec,facsic_imp) ;
								values(xtcomp,xncomp,fac.recep_fec,fac.pagrecep_impo)
				endscan
				sele sic
				go top
				SCAN
					xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(sic.sini_cod))))+ALLTRIM(STR(sic.sini_cod)))
					insert into facsic(tcomp,ncomp,facsic_fec,facsic_imp) ;
								values("SIC",xncomp,sic.sini_fech,sic.pagsini_imp)
				ENDSCAN
				sele dic
				go top
				SCAN
					xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(dic.debc_codi))))+ALLTRIM(STR(dic.debc_codi)))
					insert into facsic(tcomp,ncomp,facsic_fec,facsic_imp) ;
								values("DIC",xncomp,dic.debc_fech,dic.pagdebi_imp)
				ENDSCAN
				sele cic
				go top
				SCAN
					xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(cic.crec_codi))))+ALLTRIM(STR(cic.crec_codi)))
					insert into facsic(tcomp,ncomp,facsic_fec,facsic_imp) ;
								values("CIC",xncomp,cic.crec_fech,cic.pagcrei_imp)
				endscan
				
				sele facsic
				index on facsic_fec to SYS(2015)
				LOCATE
				
				SCAN
					.grid1.additem(tcomp+chr(9)+ncomp+chr(9)+dtoc(facsic_fec)+CHR(9)+TRANSFORM(facsic_imp, "$ 999,999,999.99"))
				ENDSCAN
			ENDIF
			thisform.command2.enabled=.T.
		endwith
		thisform.command2.enabled=.T.
	ENDPROC

ENDDEFINE

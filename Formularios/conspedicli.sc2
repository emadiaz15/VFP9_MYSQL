	PROCEDURE Comp_asoc.btn_buscar.img_buscar.Click
		SELECT (thisform.xcurcomp)
		
		DO CASE
			CASE tipcbte = "PRE"
				_screen.estapres=1
				DO FORM conspresup WITH codbus,thisform.xcondcli
			CASE tipcbte = "FAC"
				pasfac=1
				DO FORM consfactura WITH codbus,thisform.xcondcli
			CASE tipcbte = "REM"
				pasrem=1
				DO FORM consremito WITH codbus,thisform.xcondcli
		ENDCASE
		
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Edit2.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit2.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE grd_detalle.AfterRowColChange
		LPARAMETERS nColIndex
		thisform.gridart_sync_active_color()
	ENDPROC

	PROCEDURE Text1.GotFocus
		if localiz=1
			thisform.grid1.toprow=nitemcpe
		endif
	ENDPROC

	PROCEDURE Text16.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text16.Valid
		if this.value>0
			sele vendedores
			set order to ven_codi
			seek this.value
			if found()
				thisform.text16.value=allt(ven_nomb)
			else
				=messagebox("Vendedor no está en archivo",0+48,"Advertencia!!!")
				this.value=0
				return 0
			endif
		else
			thisform.text16.value=""
		endif
	ENDPROC

	PROCEDURE Text21.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text21.Valid
		if this.value<>""
			sele porcencomi
			set order to porc_desc
			seek allt(this.value)
			if found()
				porcodi=porc_codi
				thisform.text21.value=porc_impo
			else
				=messagebox("Porcentaje de Comisión no está en archivo",0+48,"Advertencia!!!")
				this.value=""
				return 0
			endif
		else
			thisform.text21.value=0
			porodi=0
		endif
	ENDPROC

	PROCEDURE Text22.Click
		this.setfocus
	ENDPROC


	PROCEDURE buscar_compasoc
		LPARAMETERS _xCodp
		*****************************BUSCA PRESUPUESTO******************************************
		IF thisform.xcodp > 0
			xcade = REPLICATE("0",8-LEN(ALLTRIM(STR(thisform.xcodp))))+ALLTRIM(STR(thisform.xcodp))
			INSERT INTO (thisform.xcurcomp) values(ALLTRIM('PRE_0000-'+xcade),'PRE',thisform.xcodp)
		ENDIF
		****************************************************************************************
		*****************************BUSCA FACTURAS*********************************************
		frmconsped= conectar_db(_screen.cn)
			SQLEXEC(frmconsped,"select * from facturas where ped_codi = ?_xCodp;","cur_factu")
		desconectar_db(frmconsped)
		
		IF RECCOUNT("cur_factu") > 0
			LOCATE
			SCAN
				xcade1 = REPLICATE("0",4-LEN(ALLTRIM(STR(cur_factu.fac_pto))))+ALLTRIM(STR(cur_factu.fac_pto))
				xcade2 = REPLICATE("0",8-LEN(ALLTRIM(STR(cur_factu.fac_nro))))+ALLTRIM(STR(cur_factu.fac_nro))
				xcadti = ICASE(cur_factu.fac_conc='F','FAC',cur_factu.fac_conc='N','NC',cur_factu.fac_conc='D','ND')
				INSERT INTO (thisform.xcurcomp) values(ALLTRIM(xcadti+'_'+xcade1+'-'+xcade2),xcadti,cur_factu.fac_codi)		
			ENDSCAN
		ENDIF
		
		cerrar_cursor("cur_factu")
		****************************************************************************************
		******************************BUSCA REMITOS*********************************************
		frmconsped= conectar_db(_screen.cn)
			SQLEXEC(frmconsped,"select * from remitos where ped_codi = ?_xCodp;","cur_remi")
		desconectar_db(frmconsped)
		
		IF RECCOUNT("cur_remi") > 0
			LOCATE
			SCAN
				xcade1 = REPLICATE("0",4-LEN(ALLTRIM(STR(cur_remi.rem_pto))))+ALLTRIM(STR(cur_remi.rem_pto))
				xcade2 = REPLICATE("0",8-LEN(ALLTRIM(STR(cur_remi.rem_nro))))+ALLTRIM(STR(cur_remi.rem_nro))
				INSERT INTO (thisform.xcurcomp) values(ALLTRIM('REM_'+xcade1+'-'+xcade2),'REM',cur_remi.rem_codi)		
			ENDSCAN
		ENDIF
		
		cerrar_cursor("cur_remi")
		******************************************************************************************
		SELECT (thisform.xcurcomp)
		LOCATE
		
		thisform.comp_asoc.cmb_comp.RowSource = (thisform.xcurcomp)
		thisform.comp_asoc.cmb_comp.value = cpbte
	ENDPROC

	PROCEDURE datos_click
		
		thisform.RemoveObject("shp_datos")
		thisform.RemoveObject("edt_datos")
		thisform.RemoveObject("cmd_datos")
	ENDPROC

	PROCEDURE datos_mleave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.F.
		thisform.cmd_datos.FontSize=9
	ENDPROC

	PROCEDURE datos_mmove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.T.
		thisform.cmd_datos.FontSize=10
	ENDPROC

	PROCEDURE Destroy
		IF PEMSTATUS(thisform, "xGridArtBound", 5)
		    =GridArt_Unbind(thisform)
		ENDIF
		
		ON KEY LABEL ESC
		
		set skip of bar 5 of Consultas .F.
		on key label INS
		localiz=0
		nitemcpe=0
		
		IF USED("auxdac")
			cerrar_cursor("auxdac")
		ENDIF
		
		
	ENDPROC

	PROCEDURE gridart_config_colores_seguro
		=GridArt_ConfigurarColores(thisform)
		RETURN
	ENDPROC

	PROCEDURE gridart_refresh
		SET PROCEDURE TO grid_articulos_ui ADDITIVE
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    thisform.gridart_setup()
		ELSE
		    =GridArt_RefrescarStockVisual(thisform)
		    thisform.gridart_config_colores_seguro()
		ENDIF
		thisform.gridart_sync_active_color()
		RETURN
	ENDPROC

	PROCEDURE gridart_setup
		SET PROCEDURE TO grid_articulos_ui ADDITIVE
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    =GridArt_BindNative(thisform, "grd_detalle", thisform.xcurdeta, "art_codi", "art_desc")
		    =GridArt_BindTooltipEvents(thisform)
		ENDIF
		=GridArt_RefrescarStockVisual(thisform)
		thisform.gridart_config_colores_seguro()
		thisform.gridart_sync_active_color()
		ON KEY LABEL ESC DO GridArt_OnEsc IN grid_articulos_ui
		RETURN
	ENDPROC

	PROCEDURE gridart_sync_active_color
		LPARAMETERS nColIndex
		LOCAL lnCol, loCol, lnBack, lnFore
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    RETURN
		ENDIF
		lnBack = GridArt_GetDynBack(thisform)
		lnFore = GridArt_GetDynFore(thisform)
		WITH thisform.grd_detalle
		    .HighlightStyle     = 0
		    .Highlight          = .F.
		    .HighlightBackColor = lnBack
		    .HighlightForeColor = lnFore
		    FOR lnCol = 1 TO 9
		        loCol = .Columns(lnCol)
		        IF PEMSTATUS(loCol, "Text1", 5)
		            loCol.Text1.BackColor  = lnBack
		            loCol.Text1.ForeColor  = lnFore
		            loCol.Text1.BorderStyle = 0
		        ENDIF
		    ENDFOR
		    .Refresh()
		ENDWITH
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockFormNative(thisform)
		ENDIF
		RETURN
	ENDPROC

	PROCEDURE grid_init
		*!*	WITH this
		*!*		.AddProperty([lExpanded], .T.)
		*!*	ENDWITH
		
	ENDPROC

	PROCEDURE grid_rightclick
		SET PROCEDURE TO grid_articulos_ui ADDITIVE
		
		LOCAL lcShortcut, loRef
		m.loRef = this
		m.lcShortcut = SYS(2015)
		
		DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		
		DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Ver Descripción Completa] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
		ON SELECTION BAR 1 OF (m.lcShortcut) m.loRef.Grid_ShowDesc()
		
		DEFINE BAR 2 OF (m.lcShortcut) PROMPT [\-]
		=GridArt_AddStockMenuOption(m.lcShortcut, 3, thisform)
		=GridArt_AddStockMenuSeparator(m.lcShortcut, 4)
		=GridArt_AddListaComprasMenuOption(m.lcShortcut, 5)
		
		ACTIVATE POPUP (m.lcShortcut)
		RELEASE POPUP (m.lcShortcut)
		
		RETURN
	ENDPROC

	PROCEDURE grid_showdesc
		
		** IF USED("cur_arped")
		xcadcur=(thisform.xcurdeta)
		IF USED("&xcadcur")
			IF VARTYPE(thisform.shp_datos)="U"
				thisform.AddObject("shp_datos","shape")
				WITH thisform.shp_datos
					.left    = 105
					.top     = 275
					.width   = 574
					.height  = 173
					.backcolor = RGB(140, 165, 176)
					.SpecialEffect = 0
					.Visible = .T.
				ENDWITH
					
				THISFORM. ADDOBJECT("edt_datos","EDITBOX")
				WITH THISform.edt_datos
					.left    = 117
					.top     = 288
					.width   = 550
					.height  = 125
					.disabledbackcolor = RGB(40,44,52)
					.forecolor = RGB(244,210,50)
					.fontsize  = 10
					.fontbold  = .T.
					.readonly  = .T.
					SELECT (thisform.xcurdeta)
					xcadec=ALIAS()+"."+"art_desc"
					.value     = ALLTRIM(&xcadec)
					** .value     = ALLTRIM(cur_arped.art_desc)
					.themes    = .F.
					.Visible   = .T.
				ENDWITH
				
				thisform.AddObject("cmd_datos","Commandbutton")
				WITH thisform.cmd_datos
					.left      = 333
					.top       = 416
					.width     = 108
					.height    = 27
					.themes    = .F.
					.forecolor = RGB(255,255,255)
					.backcolor = RGB(227,68,34)
					.alignment = 2
					.caption   = "\<Cerrar Ventana"
					.Visible   = .T.
					=BINDEVENT(ThisForm.cmd_datos, "Click", ThisForm, "datos_click")
					=BINDEVENT(ThisForm.cmd_datos, "MouseMove", ThisForm, "datos_mmove")
					=BINDEVENT(ThisForm.cmd_datos, "MouseLeave", ThisForm, "datos_mleave")
				ENDWITH
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		parameter codped,cond
		public elimi,descrip,muestro,opcion,transporte,dato1,dato2,dato3, ;
		       dato4,codigo,cant,descri,pruni,prtot,insertar,impiva1,impiva2, ;
		       borra,codiva,coditran1,coditran2,auxcond,localiz,porcodi,xdolar
		set deleted on
		
		thisform.xcurcomp = SYS(2015)
		thisform.xcurdeta = SYS(2015)
		
		CREATE CURSOR (thisform.xcurcomp)(cpbte C(20),tipcbte C(3),codbus N(10))
		
		this.xcondcli=cond
		this.xcodped=codped
		transporte=" "
		STORE 0 TO coditran1,coditran2,paso,acu,elimi,localiz,muestro,opcion,insertar,borra,porcodi,xdolar
		descrip=""
		STORE 0 TO this.text8.Value, ;
				   this.text17.Value, ;
				   this.text18.Value, ;
				   this.text9.Value, ;
				   this.text11.Value, ;
		           this.text10.Value, ;   
				   this.text19.value
				   
		frmconsped= conectar_db(_screen.cn)
			SQLEXEC(frmconsped,"select b.*,c.*,d.cond_desc from pedidos a inner join iva b on a.iva_codi=b.iva_codi inner join clientes c on c.cli_codi=a.cli_codi inner join condiva d on c.cond_codi=d.cond_codi where a.ped_codi=?thisform.xcodped;","cur_datvar")
			SQLEXEC(frmconsped,"select a.*,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on c.provi_codi=a.provi_codi where a.loca_codi=?cur_datvar.loca_codi;","cur_ubic")
		desconectar_db(frmconsped)
		impiva1=cur_datvar.iva_1
		impiva2=cur_datvar.iva_2
		codiva=cur_datvar.iva_codi
		thisform.label12.caption=allt(str(impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(impiva2,10,2))+"%"
		
		SET DECIMALS TO 3
		frmconsped= conectar_db(_screen.cn)
			SQLEXEC(frmconsped,"select * from pedidos where ped_codi=?thisform.xcodped;","cur_pedido")
		desconectar_db(frmconsped)
		thisform.xcodp = cur_pedido.presup_codi
		frmconsped= conectar_db(_screen.cn)
			thisform.xdolar = cur_pedido.cotiz_dolar
			SQLEXEC(frmconsped,"call usp_consped(?thisform.xcodped,?thisform.xdolar,?cur_pedido.moneda,1);","cur_arped")
		desconectar_db(frmconsped)
		SET DECIMALS TO
		&&SELECT cur_arped
		SELECT * FROM cur_arped INTO CURSOR (thisform.xcurdeta)
		SELECT (thisform.xcurdeta)
		LOCATE
		
		thisform.grd_detalle.RecordSource="(thisform.xcurdeta)"
		thisform.grd_detalle.column5.ControlSource="(art_desc)"
		thisform.grd_detalle.SetFocus
		
		*-------------------------------------------------*
		thisform.gridart_setup()
		*-------------------------------------------------*
		
		IF cond = 2
			SELECT SUM(artped_precio*artped_cant) FROM (thisform.xcurdeta) WHERE util <> 0 into array ar_totvcpe
			** SELECT SUM(artped_precio*artped_cant) FROM cur_arped WHERE util <> 0 into array ar_totvcpe
		ELSE
			SELECT SUM((artped_precio/((iva/100)+1))*artped_cant) FROM (thisform.xcurdeta) WHERE util <> 0 into array ar_totvcpe
			** SELECT SUM((artped_precio/((iva/100)+1))*artped_cant) FROM cur_arped WHERE util <> 0 into array ar_totvcpe
		ENDIF
		SELECT SUM(costo*artped_cant) FROM (thisform.xcurdeta) WHERE util <> 0 into array ar_totccpe
		** SELECT SUM(costo*artped_cant) FROM cur_arped WHERE util <> 0 into array ar_totccpe
		
		thisform.txt_util.Value=ROUND(((ar_totvcpe[1]/ar_totccpe[1])-1)*100,3)
		
		with thisform
			IF LEN(ALLTRIM(cur_pedido.cumplido))=0
				thisform.chk_pend.Enabled=.T.
			ELSE
				thisform.chk_pend.Enabled=.F.	
			ENDIF
			if valorcadena<>"Pedidos por Cliente"
				.command3.visible=.f.
			endif
			.text1.value=cur_datvar.cli_nomb
			.text2.value=cur_datvar.cli_domi
			auxcond=cur_datvar.cond_codi
			.text3.value=cur_ubic.cp_nro
			.text4.value=cur_ubic.loca_nomb
			.text5.value=cur_ubic.provi_nomb
			.text6.value=cur_datvar.cond_desc
			.text12.value=cur_datvar.cli_cuit
			.text23.value="0"+allt(cur_datvar.cli_cartel)+"-"+allt(cur_datvar.cli_tel1)
			.text13.value=cur_pedido.ped_fech
			.txt_hora.value=TTOC(cur_pedido.ped_hora,2)
			.text19.value=cur_pedido.ped_dto
			.edit3.value=allt(cur_pedido.ped_obser)
			IF cur_pedido.moneda = 'P'
				thisform.txt_cotiz.Value=cur_pedido.cotiz_dolar
				thisform.lbl_cotiz.Visible= .T.
				thisform.txt_cotiz.Visible= .T.
			ENDIF
		*!*		.label15.left=675
			.text15.value=thisform.xcodped
			.text7.value=cur_pedido.notaped_nro
			.text15.value=cur_pedido.ped_codi
			frmconsped= conectar_db(_screen.cn)
				SQLEXEC(frmconsped,"select a.*,b.tran_nomb from pedidos_transportes a inner join transportes b on a.tran_codi=b.tran_codi where a.ped_codi=?thisform.xcodped;","cur_tra")
			desconectar_db(frmconsped)
			if RECCOUNT("cur_tra")>0
				coditran1=cur_tra.tran_codi
				.text14.value=cur_tra.tran_nomb
				do case
					case cur_tra.flete_cargo="C"
						.opcionflete1.value=1
					case cur_tra.flete_cargo="P"
						.opcionflete1.value=2
				endcase
				.edit1.value=ALLTRIM(cur_tra.flete_lugent)
				IF RECCOUNT("cur_tra")=2
					skip
					coditran2=cur_tra.tran_codi
					.text24.value=cur_tra.tran_nomb
					do case
						case cur_tra.flete_cargo="C"
							.opcionflete2.value=1
						case cur_tra.flete_cargo="P"
							.opcionflete2.value=2
					endcase
					.edit2.value=ALLTRIM(cur_tra.flete_lugent)
				ENDIF
			endif
			
			frmconsped= conectar_db(_screen.cn)
				SQLEXEC(frmconsped,"select * from vendedores where ven_codi=?cur_pedido.ven_codi;","cur_vendedor")			
			desconectar_db(frmconsped)
			IF cur_pedido.ven_codi>0
				.text16.value=cur_vendedor.ven_codi
				.text20.value=cur_vendedor.ven_nomb
			endif
			frmconsped= conectar_db(_screen.cn)
				SQLEXEC(frmconsped,"select * from porcencomi where porc_codi=?cur_pedido.porc_codi;","cur_porc")
			desconectar_db(frmconsped)
			if cur_pedido.porc_codi>0
				porcodi=cur_porc.porc_codi
				.text21.value=cur_porc.porc_desc
				.text22.value=cur_porc.porc_impo
			else
				.text22.value=cur_pedido.otra_comi
			ENDIF
			
			SELECT sum(prtotal) FROM (thisform.xcurdeta) INTO ARRAY ar_acu
			** SELECT sum(prtotal) FROM cur_arped INTO ARRAY ar_acu
			acu = IIF(ISNULL(ar_acu[1]),0,ar_acu[1])
			.text8.value=acu
			.text17.value=iif(.text19.value>0,round((acu*.text19.value)/100,2),0)
			.text18.value=.text8.value-.text17.value
			if .text19.value>0
				LOCAL coefdes
				coefdes= (100-this.text19.value)/100
				if thisform.xcondcli=2
					SELECT SUM((prtotal * coefdes)*iva/100) FROM (thisform.xcurdeta) WHERE alicuo = 1 into array ar_iva1
					** SELECT SUM((prtotal * coefdes)*iva/100) FROM cur_arped WHERE alicuo = 1 into array ar_iva1
					.text9.value= ROUND(IIF(ISNULL(ar_iva1[1]),0,ar_iva1[1]),2)
					SELECT SUM((prtotal * coefdes)*iva/100) FROM (thisform.xcurdeta) WHERE alicuo = 2 into array ar_iva2
					** SELECT SUM((prtotal * coefdes)*iva/100) FROM cur_arped WHERE alicuo = 2 into array ar_iva2
					.text11.value= ROUND(IIF(ISNULL(ar_iva2[1]),0,ar_iva2[1]),2)
				endif
			else
				if thisform.xcondcli=2
					SELECT SUM((prtotal*iva/100)) FROM (thisform.xcurdeta) WHERE alicuo = 1 into array ar_iva1
					** SELECT SUM((prtotal*iva/100)) FROM cur_arped WHERE alicuo = 1 into array ar_iva1
					.text9.value= ROUND(IIF(ISNULL(ar_iva1[1]),0,ar_iva1[1]),2)
					SELECT SUM((prtotal*iva/100)) FROM (thisform.xcurdeta) WHERE alicuo = 2 into array ar_iva2
					** SELECT SUM((prtotal*iva/100)) FROM cur_arped WHERE alicuo = 2 into array ar_iva2
					.text11.value= ROUND(IIF(ISNULL(ar_iva2[1]),0,ar_iva2[1]),2)
				ENDIF
			endif
			this.text10.value=this.text18.value+this.text9.value+this.text11.value				
		endwith
		
		*!*	thisform.Grid_Init()
		=BINDEVENT(ThisForm.grd_detalle, "RightClick", ThisForm, "Grid_RightClick")
		localiz=1
		
		thisform.buscar_compasoc(thisform.xcodped)
	ENDPROC

	PROCEDURE Load
		set skip of bar 5 of Consultas .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if valorcadena<>"Pedidos por Cliente"
		*!*		set skip of bar 5 of Consultas .F.
		*!*		thisform.hide
		*!*		localiz=0
		*!*		nitemcpe=0
		*!*	endif
	ENDPROC

	PROCEDURE Btn_money1.Image1.Click
		frmconsped= conectar_db(_screen.cn)
			SQLEXEC(frmconsped,"select * from histocoti where hiscot_fecha=?thisform.text13.value order by hiscot_fecha desc limit 1;","cur_cotdia")
			IF RECCOUNT("cur_cotdia")>0
				MESSAGEBOX("           DOLAR VIGENTE AL DÍA DEL PEDIDO"+CHR(13)+CHR(13)+ ;
						   "U$S 1 = $ "+ALLTRIM(STR(cur_cotdia.hiscot_impo,14,2))+" - ACTUALIZ: "+ALLTRIM(TTOC(hiscot_fecha)),0+64,"COTIZACIONES MONEDA DOLAR")
			ELSE
				SQLEXEC(frmconsped,"select * from histocoti where hiscot_fecha<?thisform.text13.value order by hiscot_fecha desc limit 1;","cur_cotant")
				IF RECCOUNT("cur_cotant")>0
					MESSAGEBOX("           DOLAR VIGENTE AL DÍA DEL PEDIDO"+CHR(13)+CHR(13)+ ;
							   "U$S 1 = $ "+ALLTRIM(STR(cur_cotant.hiscot_impo,14,2))+" - ACTUALIZ: "+ALLTRIM(TTOC(hiscot_fecha)),0+64,"COTIZACIONES MONEDA DOLAR")
				ENDIF
			ENDIF
		desconectar_db(frmconsped)
	ENDPROC

	PROCEDURE chk_pend.Click
		LOCAL opcionpend,canpend
		STORE 0 TO acuaux, ;
				   auxiva, ;
			       ivadif, ;
			       ivaitem, ;
			       acu
		STORE 0 TO thisform.impo1, ;
				   thisform.impo2, ;
				   thisform.acu1, ;
				   thisform.acu2, ;
				   thisform.acun1, ;
				   thisform.acun2
		thisform.grd_detalle.RecordSource=""
		thisform.grd_detalle.Refresh
		
		SET DECIMALS TO 3
		DO case
			CASE this.Value=1
				opcionpend=1
				frmconsped= conectar_db(_screen.cn)
					SQLEXEC(frmconsped,"call usp_consped(?thisform.xcodped,?thisform.xdolar,?cur_pedido.moneda,2);","cur_arped")
				desconectar_db(frmconsped)
				** SELECT cur_arped
				** SET FILTER TO artped_cant > 0
				SELECT * FROM cur_arped INTO CURSOR (thisform.xcurdeta)
				SELECT (thisform.xcurdeta)
				SET FILTER TO artped_cant > 0
			CASE this.Value=0
				opcionpend=2
				frmconsped= conectar_db(_screen.cn)
					SQLEXEC(frmconsped,"call usp_consped(?thisform.xcodped,?thisform.xdolar,?cur_pedido.moneda,1);","cur_arped")
				desconectar_db(frmconsped)
				SELECT * FROM cur_arped INTO CURSOR (thisform.xcurdeta)
		ENDCASE
		SET DECIMALS TO
		
		thisform.grd_detalle.RecordSource="(thisform.xcurdeta)"
		thisform.grd_detalle.column5.ControlSource="(art_desc)"
		thisform.grd_detalle.Refresh
		
		*----------------------------------------------------------*
		thisform.gridart_refresh()
		*----------------------------------------------------------*
		
		SELECT sum(prtotal) FROM (thisform.xcurdeta) INTO ARRAY ar_acu
		** SELECT sum(prtotal) FROM cur_arped INTO ARRAY ar_acu
		acu = IIF(ISNULL(ar_acu[1]),0,ar_acu[1])
		
		WITH thisform
			.text8.value=acu
			.text17.value=iif(.text19.value>0,round((acu*.text19.value)/100,2),0)
			.text18.value=.text8.value-.text17.value
			if .text19.value>0
				LOCAL coefdes
				coefdes= (100-this.text19.value)/100
				if thisform.xcondcli=2
					SELECT SUM((prtotal * coefdes)*iva/100) FROM (thisform.xcurdeta) WHERE alicuo = 1 into array ar_iva1
					** SELECT SUM((prtotal * coefdes)*iva/100) FROM cur_arped WHERE alicuo = 1 into array ar_iva1
					.text9.value= ROUND(IIF(ISNULL(ar_iva1[1]),0,ar_iva1[1]),2)
					SELECT SUM((prtotal * coefdes)*iva/100) FROM (thisform.xcurdeta) WHERE alicuo = 2 into array ar_iva2
					** SELECT SUM((prtotal * coefdes)*iva/100) FROM cur_arped WHERE alicuo = 2 into array ar_iva2
					.text11.value= ROUND(IIF(ISNULL(ar_iva2[1]),0,ar_iva2[1]),2)
				endif
			else
				if thisform.xcondcli=2
					SELECT SUM((prtotal*iva/100)) FROM (thisform.xcurdeta) WHERE alicuo = 1 into array ar_iva1
					** SELECT SUM((prtotal*iva/100)) FROM cur_arped WHERE alicuo = 1 into array ar_iva1
					.text9.value= ROUND(IIF(ISNULL(ar_iva1[1]),0,ar_iva1[1]),2)
					SELECT SUM((prtotal*iva/100)) FROM (thisform.xcurdeta) WHERE alicuo = 2 into array ar_iva2
					** SELECT SUM((prtotal*iva/100)) FROM cur_arped WHERE alicuo = 2 into array ar_iva2
					.text11.value= ROUND(IIF(ISNULL(ar_iva2[1]),0,ar_iva2[1]),2)
				ENDIF
			endif
			.text10.value=.text18.value+.text9.value+.text11.value				
		endwith
		*!*	WITH thisform
		*!*		thisform.grid1.rows=1
		*!*		GO top
		*!*		nitemcpe=1
		*!*		SCAN
		*!*			cadena=repl("0",8-len(allt(str(cur_arped.art_codi))))+allt(str(cur_arped.art_codi))
		*!*			canpend=cur_arped.artped_cant-IIF(opcionpend=1,cur_arped.artped_ent,0)
		*!*			if cur_arped.art_codi=4 or cur_arped.art_codi=5
		*!*				.grid1.additem(allt(str(nitemcpe))+chr(9)+allt(str(canpend,10,3))+chr(9)+allt(cur_arped.art_med)+chr(9)+cadena+chr(9)+allt(cur_arped.artped_dasc)+chr(9)+allt(str(cur_arped.artped_precio,10,3))+chr(9)+allt(str((canpend)*cur_arped.artped_precio,10,2)))
		*!*			else
		*!*				.grid1.additem(allt(str(nitemcpe))+chr(9)+allt(str(canpend,10,3))+chr(9)+allt(cur_arped.art_med)+chr(9)+cadena+chr(9)+allt(cur_arped.art_desc)+chr(9)+allt(str(cur_arped.artped_precio,10,3))+chr(9)+allt(str((canpend)*cur_arped.artped_precio,10,2)))
		*!*				if cur_arped.dac_codi>0
		*!*					.grid1.col=4
		*!*					.grid1.row=nitemcpe
		*!*					.grid1.text=cur_arped.dac_desc
		*!*				endif
		*!*			endif
		*!*			.grid1.row=.grid1.rows-1
		*!*			thisform.grid1.col=7
		*!*			do case
		*!*				case cur_arped.art_alicuota=1
		*!*					thisform.grid1.text=allt(str(impiva1,10,2))
		*!*				case cur_arped.art_alicuota=2
		*!*					thisform.grid1.text=allt(str(impiva2,10,2))
		*!*			ENDCASE
		*!*			.grid1.row=.grid1.rows-1
		*!*			.grid1.col=4
		*!*			if len(allt(.grid1.text))>47
		*!*				div=len(allt(.grid1.text))/47
		*!*				if div>int(div)
		*!*					longdes=int(div)+1
		*!*				else
		*!*					longdes=div
		*!*				endif
		*!*				longdes=longdes*240
		*!*				.grid1.rowheight(.grid1.row)=longdes
		*!*			else
		*!*				.grid1.rowheight(.grid1.row)=270
		*!*			endif
		*!*			.grid1.col=0
		*!*			.grid1.cellalignment=3
		*!*			.grid1.col=1
		*!*			.grid1.cellalignment=3
		*!*			.grid1.col=2
		*!*			.grid1.cellalignment=3
		*!*			.grid1.col=3
		*!*			.grid1.cellalignment=3
		*!*			.grid1.col=4
		*!*			.grid1.cellalignment=0
		*!*			.grid1.col=5
		*!*			.grid1.cellalignment=8
		*!*			.grid1.col=6
		*!*			.grid1.cellalignment=8
		*!*			.grid1.col=7
		*!*			.grid1.cellalignment=8			
		*!*			acu=acu+((canpend)*cur_arped.artped_precio)
		*!*			nitemcpe=nitemcpe+1			
		*!*			.text8.value=acu
		*!*			.text17.value=iif(.text19.value>0,round((acu*.text19.value)/100,2),0)
		*!*			.text18.value=.text8.value-.text17.value
		*!*			if .text19.value>0
		*!*				do case
		*!*					case cur_arped.art_alicuota=1
		*!*						if thisform.xcondcli=2
		*!*							thisform.impo1=thisform.impo1+((cur_arped.artped_cant*cur_arped.artped_precio)*((100-.text19.value)/100))
		*!*							.text9.value=round((thisform.impo1*impiva1)/100,2)
		*!*						else
		*!*							thisform.acun1=thisform.acun1+round((((cur_arped.artped_cant*cur_arped.artped_precio)*((100-.text19.value)/100))/(1+(impiva1/100))),3)
		*!*							thisform.acu1=round((thisform.acun1*impiva1)/100,2)
		*!*						endif
		*!*					case cur_arped.art_alicuota=2
		*!*						if thisform.xcondcli=2
		*!*							thisform.impo2=thisform.impo2+((cur_arped.artped_cant*cur_arped.artped_precio)*((100-.text19.value)/100))
		*!*							.text11.value=round((thisform.impo2*impiva2)/100,2)
		*!*						else
		*!*							thisform.acun2=thisform.acun2+round((((cur_arped.artped_cant*cur_arped.artped_precio)*((100-.text19.value)/100))/(1+(impiva2/100))),3)
		*!*							thisform.acu2=round((thisform.acun2*impiva2)/100,2)
		*!*						endif
		*!*				endcase
		*!*			else
		*!*				do case
		*!*					case cur_arped.art_alicuota=1
		*!*						if thisform.xcondcli=2
		*!*							thisform.impo1=thisform.impo1+(cur_arped.artped_cant*cur_arped.artped_precio)
		*!*							.text9.value=round((thisform.impo1*impiva1)/100,2)
		*!*						else
		*!*							thisform.acun1=thisform.acun1+round(((cur_arped.artped_cant*cur_arped.artped_precio)/(1+(impiva1/100))),3)
		*!*							thisform.acu1=round((thisform.acun1*impiva1)/100,2)
		*!*						endif
		*!*					case cur_arped.art_alicuota=2
		*!*						if thisform.xcondcli=2
		*!*							thisform.impo2=thisform.impo2+(cur_arped.artped_cant*cur_arped.artped_precio)
		*!*							.text11.value=round((thisform.impo2*impiva2)/100,2)
		*!*						else
		*!*							thisform.acun2=thisform.acun2+round(((cur_arped.artped_cant*cur_arped.artped_precio)/(1+(impiva2/100))),3)
		*!*							thisform.acu2=round((thisform.acun2*impiva2)/100,2)
		*!*						endif
		*!*				endcase
		*!*			endif
		*!*			.text10.value=.text18.value+.text9.value+.text11.value
		*!*		ENDSCAN
		*!*	ENDWITH
		
	ENDPROC

	PROCEDURE Command1.Click
		DIMENSION tra[2,3]
		store "" to tra
		IF coditran1>0
			frmconsped= conectar_db(_screen.cn)
				SQLEXEC(frmconsped,"select * from transportes where tran_codi=?coditran1;","cur_tra")
			desconectar_db(frmconsped)
			if RECCOUNT("cur_tra")>0
				tra[1,1]=allt(cur_tra.tran_nomb)
			endif
			with thisform
				tra[1,2]=allt(.edit1.value)
				tra[1,3]=iif(.opcionflete1.value=1,"C",iif(.opcionflete1.value=2,"P",""))
				if coditran2>0
					frmconsped= conectar_db(_screen.cn)
						SQLEXEC(frmconsped,"select * from transportes where tran_codi=?coditran2;","cur_tra2")
					desconectar_db(frmconsped)
					if RECCOUNT("cur_tra2")>0
						tra[2,1]=allt(cur_tra2.tran_nomb)
					endif
					tra[2,2]=allt(.edit2.value)
					tra[2,3]=iif(.opcionflete2.value=1,"C",iif(.opcionflete2.value=2,"P",""))
				endif
			ENDWITH
		endif
		
		SET POINT TO ","
		SET SEPARATOR TO "."
		SELECT cur_arped
		go top
		if cur_pedido.notaped_nro>0
			preg=messagebox("Este pedido fue dado de alta por Nota de Pedido."+chr(13)+ ;
							"¿Imprime igualmente?",4+48+256,"Advertencia")
			if preg=6
				with thisform
					ivari=.text9.value
					ivarni=.text11.value
					totalri=.text18.value+.text9.value
					totalrni=.text18.value+.text9.value+.text11.value
					totsiva=.text18.value
				endwith
				report form conspedi for cur_pedido.ped_codi=thisform.xcodped TO PRINTER prompt noconsole
			endif
		else
			with thisform
				ivari=.text9.value
				ivarni=.text11.value
				totalri=.text18.value+.text9.value
				totalrni=.text18.value+.text9.value+.text11.value
				totsiva=.text18.value
			endwith
			report form conspedi for cur_pedido.ped_codi=thisform.xcodped TO PRINTER PROMPT noconsole
		endif
		SET POINT TO
		SET SEPARATOR TO
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC


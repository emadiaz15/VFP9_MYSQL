		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Init
		public desde,hasta
		LOCAL vendn
		vendn=''
		create cursor curpendcli(ped_codi N(8),ped_fech D,art_codi N(8), ;
			descripcion C(45),artped_cant N(8,2),artped_ent N(8,2),cli_codi N(8),cli_nomb C(45),zona N(8))
		vendn=UPPER(substr(sys(0),ATC("#",sys(0))+2))
		frmpxzon= conectar_db(_screen.cn)
			SQLEXEC(frmpxzon,"select * from vendedores where TRIM(ven_nomb)=?vendn;","cur_vendz")
		desconectar_db(frmpxzon)
		if RECCOUNT("cur_vendz")>0
			ven=cur_vendz.ven_codi
		else
			ven=0
		endif
		if ven>0
			this.combo1.rowsourcetype=2
			this.combo2.rowsourcetype=2
			frmpxzon= conectar_db(_screen.cn)
				SQLEXEC(frmpxzon,"select zona_desc,zona_codi from zonas where ven_codi=?ven order by zona_codi;","zondes")
				SQLEXEC(frmpxzon,"select zona_desc,zona_codi from zonas where ven_codi=?ven order by zona_codi;","zonhas")
			desconectar_db(frmpxzon)
			this.combo1.rowsource="zondes"
			this.combo2.rowsource="zonhas"
		else
			this.combo1.rowsourcetype=2
			this.combo2.rowsourcetype=2
			frmpxzon= conectar_db(_screen.cn)
				SQLEXEC(frmpxzon,"select zona_desc,zona_codi from zonas order by zona_codi;","zondes")
				SQLEXEC(frmpxzon,"select zona_desc,zona_codi from zonas order by zona_codi;","zonhas")
			desconectar_db(frmpxzon)
			this.combo1.rowsource="zondes"
			this.combo2.rowsource="zonhas"
		endif
		this.combo1.value=1
		this.combo2.value=1
		
	ENDPROC

	PROCEDURE Combo1.Click
		thisform.combo2.Value=zondes.zona_desc
	ENDPROC

	PROCEDURE Command3.Click
		desde=zondes.zona_codi
		hasta=zonhas.zona_codi
		if hasta<desde
			=messagebox("La Zona hasta no puede ser menor a la Zona desde. "+chr(13)+ ;
						"Verifique por favor.",0+48,"Advertencia")
		else
			frmpxzon= conectar_db(_screen.cn)
				SQLEXEC(frmpxzon,"call usp_pendxzon(?desde,?hasta,0);","curpendcli")
			desconectar_db(frmpxzon)
			go top
			IF RECCOUNT("curpendcli")>0
				index on str(zona)+str(cli_codi)+dtos(ped_fech)+str(ped_codi) to SYS(2015)
				report form pendtotcli to printer prompt noconsole
			ELSE
				MESSAGEBOX("No hay pedidos pendientes para esta zona.",64,"Aviso del Sistema")
			ENDIF
		endif
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		desde=zondes.zona_codi

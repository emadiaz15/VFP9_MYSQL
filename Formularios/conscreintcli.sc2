	PROCEDURE Activate
		set exact on
	ENDPROC

	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		PARAMETERS creintcli
		
		thisform.codigo_cre=creintcli
		
		thisform.text10.value=0
		
		this.text13.value=date()
		with thisform
			.text1.value=cur_clie.cli_nomb
			.text2.value=cur_clie.cli_domi
			.text3.value=cur_clie.cp_nro
			.text4.value=cur_clie.loca_nomb
			.text5.value=cur_clie.provi_nomb
			.text6.value=cur_clie.cond_desc
			.text12.value=VAL(cur_clie.cli_cuit)
		ENDWITH
		if pasdiv=1
			thisform.cmd_otro.visible=.F.
		ENDIF
		
		frmdebin= conectar_db(_screen.cn)
			SQLEXEC(frmdebin,"select * from creintv where crev_codi=?thisform.codigo_cre;","cur_credito")
			SQLEXEC(frmdebin,"select RPAD(LEFT(crevin_desc,LENGTH(crevin_desc)),254,' ') as crevin_desc,crevin_impo,crev_codi from creintv_items where crev_codi=?thisform.codigo_cre;","cur_detacre")
		desconectar_db(frmdebin)
		
		thisform.text7.Value =cur_credito.crev_codi
		thisform.text13.Value=cur_credito.crev_fech
		thisform.edit1.Value =cur_credito.crev_obs
		CALCULATE SUM(cur_detacre.crevin_impo) TO thisform.text10.value
		
		GO TOP IN cur_detacre
		thisform.grd_cre.RecordSource="cur_detacre"
		
		thisform.cmd_imprimir.Enabled= .T.
		
	ENDPROC

	PROCEDURE cmd_imprimir.Click
		frmdebin= conectar_db(_screen.cn)
			SQLEXEC(frmdebin,"select param_desc as emp_desc from parametros where param_codi=13;","cur_empresa")
		desconectar_db(frmdebin)
		
		SELECT cur_detacre
		GO TOP
		
		REPORT FORM creint_cliente FOR cur_detacre.crev_codi=thisform.codigo_cre TO PRINTER PROMPT noconsole
		
		
		
		
		
	ENDPROC

	PROCEDURE cmd_imprimir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_imprimir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_otro.Click
		codicli=cur_clie.cli_codi
		do form creintvload with codicli
		thisform.release
	ENDPROC

	PROCEDURE cmd_otro.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_otro.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_salir.Click
		thisform.release
	ENDPROC

	PROCEDURE cmd_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE grd_cre.Column1.Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode=22
		    thisform.insertar_item(nKeyCode, thisform.grd_cre)
		ENDIF
	ENDPROC

	PROCEDURE grd_cre.Column2.Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode=22
		    thisform.insertar_item(nKeyCode, thisform.grd_cre)
		ENDIF
	ENDPROC

	PROCEDURE grd_cre.Column2.Text1.LostFocus
		IF this.Value>0
			CALCULATE SUM(detalle.importe) TO thisform.text10.Value
			thisform.cmd_teminar.Enabled= .T.
		ENDIF
		
		
	ENDPROC

	PROCEDURE Text13.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.Click
		this.setfocus
	ENDPROC

ENDDEFINE


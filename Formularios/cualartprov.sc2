	PROCEDURE Activate
		on key label INS
		
		
		
	ENDPROC

	PROCEDURE calc_meses
		LPARAMETERS ndias
		
		LOCAL nmeses
		
		nmeses = ndias / 30
		
		thisform.lbl_diascosto.ToolTipText='Cantidad de días equivale a '+ALLTRIM(STR(nmeses,6,1))+' meses'
		
		RETURN
	ENDPROC

	PROCEDURE Destroy
		on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		if last()=27 or codigo=0
			localiz=0
			muestro=0
			paso=0
		endif
		if nitem=0
			localiz=0
		endif
	ENDPROC

	PROCEDURE dias_actcosto
		LPARAMETERS tnArtCodi
		
		LOCAL lnConn
		
		thisform.lbl_diascosto.Caption = ""
		
		IF VARTYPE(tnArtCodi) <> "N" OR tnArtCodi <= 0
			RETURN
		ENDIF
		
		lnConn = conectar_db(_screen.cn)
		
		SQLEXEC(lnConn, ;
		"SELECT " + ;
		"  DATEDIFF(CURDATE(), DATE(hc.histo_fech)) AS dias, " + ;
		"  p.prov_nomb " + ;
		"FROM histocosto hc " + ;
		"INNER JOIN articulos_proveedores ap ON ap.artpro_codi = hc.artpro_codi " + ;
		"INNER JOIN proveedores p ON p.prov_codi = ap.prov_codi " + ;
		"WHERE ap.art_codi = ?tnArtCodi " + ;
		"ORDER BY hc.histo_fech DESC, hc.histo_codi DESC " + ;
		"LIMIT 1;", ;
		"cur_ultcosto")
		
		desconectar_db(lnConn)
		
		IF RECCOUNT("cur_ultcosto") > 0
			thisform.lbl_diascosto.Caption = ;
				ALLTRIM(ALLTRIM(STR(cur_ultcosto.dias)) + " días - Últ. actualización de costo" + CHR(13) + ;
				ALLTRIM(cur_ultcosto.prov_nomb))
			thisform.ndiascosto=cur_ultcosto.dias
		ELSE
			thisform.lbl_diascosto.Caption = "Sin historial de costos"
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE Init
		parameter codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		public codicli,cdd
		store 1 to localiz,muestro
		cdd=0
		SET EXACT ON
		set dele on
		SET POINT TO "."
		codigo=0
		if opcion=2
			insertar=1
		endif
		if codigo=0
			this.text1.value=0
		ENDIF
		thisform.text12.value=0
		this.text4.value=0
		this.text5.value=0
		if paso=1
			with this
				.text1.value=dato1
				.text2.value=dato2
				.text3.value=dato3
				.text4.value=ConverNro(dato4)
				if dato1<=5
					.edit1.value=dato3
				endif
				do case
					case cur_arti.art_alicuota=1
						thisform.text12.value=allt(str(impiva1,10,2))
					case cur_arti.art_alicuota=2
						thisform.text12.value=allt(str(impiva2,10,2))
				endcase
				.SetAll("Format", "K", "Textbox")
			endwith
		endif
		*!*	sele vendedores
		*!*	set order to ven_nomb
		*!*	seek UPPER(substr(sys(0),ATC("#",sys(0))+2))
		*!*	if found()
		*!*		with this
		*!*			.label19.visible=.F.
		*!*			.label16.visible=.F.
		*!*			.label13.visible=.F.
		*!*			.label20.visible=.F.
		*!*			.lstcosto.visible=.F.
		*!*			.text13.visible=.F.
		*!*			.command2.visible=.F.
		*!*			.shape2.width=422
		*!*			.autocenter=.T.
		*!*		endwith
		*!*	endif
		*!*	sele articulos
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE nboldfila
		LParameters tnsel
		
		Local lnBold
		
			DO case
				CASE tnsel = 1
					lnBold = .T.
				CASE tnsel = 0
					lnBold = .F.
			ENDCASE
		Return(lnBold)
	ENDPROC

	PROCEDURE ncolorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = 1
					lnColor = RGB(255,0,0)
				CASE tnsel = 0
					lnColor = RGB(0,0,0)
			ENDCASE
		Return(lnColor)
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnlp,tncz
		
		LOCAL lnColor
		
		DO CASE 
			CASE tnlp=1 AND tncz=0
				lnColor = RGB(144,238,144)
			CASE tnlp=0 AND tncz=1
				lnColor = RGB(230,240,20)
			CASE tnlp=1 AND tncz=1
				lnColor = RGB(255,211,168)
		OTHERWISE
			lnColor = RGB(255,255,255)
		ENDCASE
		
		return(lnColor)
	ENDPROC

	PROCEDURE Unload
		return cond
		return codigo
		return cant
		return descri
		return pruni
		return prtot
		return opcion
	ENDPROC

	PROCEDURE validamon
		LPARAMETERS xmoncos
		
		LOCAL moncpra,continua
		
		seguir=0
		
		moncpra = _screen.moneocpra
		
		mens = ICASE(moncpra='D' and xmoncos='P',"El costo para este articulo esta en pesos, se convertirá a dólares. ¿Continúa igualmente?", ;
				     moncpra='P' and xmoncos='D',"El costo para este articulo esta en dólares, se convertirá a pesos. ¿Continúa igualmente?")
		
		
		seguir = MESSAGEBOX(mens,1+48,"Aviso del Sistema")
		
		IF seguir = 1
			thisform.confmone=1
			RETURN
		ELSE
			STORE 0 TO thisform.text1.Value, ;
				       thisform.text12.Value, ;
				       thisform.text4.Value, ;
				       thisform.text5.Value, ;
					   thisform.text6.Value, ;
					   thisform.text7.Value, ;
					   thisform.text8.Value, ;
					   thisform.text9.Value, ;
					   thisform.text10.Value, ;
					   thisform.text14.Value, ;
					   thisform.text13.Value, ;
					   thisform.optiongroup1.Value
			STORE "" TO thisform.text2.Value, ;
						thisform.text3.Value, ;
				        thisform.edit1.Value, ;
				        thisform.edit2.Value, ;
				        thisform.edit3.Value
			thisform.lbl_prov.BackStyle= 0
			thisform.lbl_prov.Caption=''
			thisform.grd_costos.RecordSource=''
			thisform.grd_costos.Refresh
			thisform.confmone=2
			RETURN
		ENDIF
		
		
	ENDPROC

	PROCEDURE btn_paleta.btn.Click
		IF thisform.paleta_01.Visible= .F.
			thisform.paleta_01.Visible= .T.
		ELSE
			thisform.paleta_01.Visible= .F.
		ENDIF
		
	ENDPROC

	PROCEDURE btn_paleta.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE btn_paleta.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE btn_paleta.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE cmd_masdes.img_add.Click
		codiprov=0
		descri=""
		do form diferentesdesc with codicli,codiprov,descri,thisform.text1.value
		if not isblank(descri)
			thisform.text3.value=allt(descri)
		ENDIF
		thisform.text2.SetFocus
		
	ENDPROC

	PROCEDURE Command1.Click
		codigo=0
		do form artload with codigo
		if codigo>0
			xcc=codigo
			thisform.lbl_prov.Caption=''
			thisform.lbl_prov.BackStyle= 0
			thisform.grd_costos.RecordSource=''
			thisform.grd_costos.Refresh()
			frmcualarp= conectar_db(_screen.cn)
				SQLEXEC(frmcualarp, "select a.*,b.* from articulos a inner join rubros b on a.rub_codi=b.rub_codi where a.art_codi=?codigo;","cur_arti")
			desconectar_db(frmcualarp)
			thisform.text1.value=cur_arti.art_codi
			frmcualarp= conectar_db(_screen.cn)
				SQLEXEC(frmcualarp,"select * from desc_articulos_proveedores where artpro_codi = any (select artpro_codi from articulos_proveedores where art_codi=?codigo and prov_codi=?codiprov);","cur_difdes")
			desconectar_db(frmcualarp)
			IF RECCOUNT("cur_difdes")>0
				frmcualarp= conectar_db(_screen.cn)
					SQLEXEC(frmcualarp,"call usp_ultdescpra(?cur_arti.art_codi,?codiprov,?_screen.xopcpra);","cur_udd")
				desconectar_db(frmcualarp)
				IF RECCOUNT("cur_udd") > 0
					thisform.text3.value=cur_udd.dap_desc
					cerrar_cursor("cur_udd")
				ELSE
					thisform.text3.value=cur_arti.art_desc			
				ENDIF
				thisform.cmd_masdes.Visible= .T.	
		*!*			IF !INLIST(valorcadena,'Por Artículo','Por Orden de Compra')
		*!*				codicli=0
		*!*				descri=""
		*!*				do form diferentesdesc with codicli,codiprov,descri,xcc
		*!*				if not isblank(descri)
		*!*					thisform.text3.value=allt(descri)
		*!*				else
		*!*					thisform.text3.value=cur_arti.art_desc
		*!*				ENDIF
		*!*			ELSE
		*!*				thisform.text3.value=cur_arti.art_desc
		*!*			ENDIF
			else
				thisform.text3.value=cur_arti.art_desc
			endif
			thisform.text6.value=cur_arti.art_stock
			thisform.text7.value=cur_arti.pedidos
			thisform.text8.value=cur_arti.pedprov
			cerrar_cursor("cur_tped")
			cerrar_cursor("cur_tcom")
			do case
				case cur_arti.art_med="UN"
					thisform.optiongroup1.value=1
				case cur_arti.art_med="MT"
					thisform.optiongroup1.value=2
				case cur_arti.art_med="KG"
					thisform.optiongroup1.value=3
			endcase
			thisform.text9.value=cur_arti.art_stock+thisform.text8.value-thisform.text7.value
			thisform.text10.value=cur_arti.art_precio
			thisform.text13.value=cur_arti.costo_ultcpra
			thisform.text14.Value=cur_arti.art_stmin
			thisform.text11.value=cur_arti.rub_desc
			thisform.edit2.value=cur_arti.art_deta
			thisform.edit3.value=cur_arti.art_detaofi
			thisform.dias_actcosto(codigo)
			WITH thisform
				if LEN(ALLTRIM(.edit3.Value))>0
					.shape5.visible=.T.
					.label20.visible=.T.
					.label25.visible=.T.
					.edit3.visible=.T.
					.edit2.visible=.T.
					thisform.command5.caption="\<Ocultar Detalles"
					IF thisform.text1.Value>0
						.edit3.enabled=.T.
					ENDIF
				else
					.shape5.visible=.F.
					.label20.visible=.F.
					.label25.visible=.F.
					.edit3.visible=.F.
					.edit2.visible=.F.
					thisform.command5.caption="\<Ver Detalles"
					.edit3.enabled=.F.
				ENDIF
			ENDWITH		
			thisform.grd_costos.RecordSource=''
			thisform.grd_costos.Refresh()
			SET DECIMALS TO 3
			frmcualarp= conectar_db(_screen.cn)
				SQLEXEC(frmcualarp,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
				IF RECCOUNT("provc")>0
					thisform.lbl_prov.BackStyle= 1
					thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
				ENDIF			
				SQLEXEC(frmcualarp,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.otro,a.prov_codi from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?xcc order by a.artpro_costo;","cur_costos")
				IF RECCOUNT("cur_costos")>0
					GO top
					thisform.grd_costos.RecordSource="cur_costos"
					thisform.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(cur_costos.lista,cur_costos.cotiz)","Column")
					thisform.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(cur_costos.otro)","Column")
					thisform.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(cur_costos.otro)","Column")
					GO top
					IF WEXIST("modiocpra") OR WEXIST("altaocpra")
						SQLEXEC(frmcualarp,"select param_impo from parametros where param_codi=14;","cur_dolarofi")
						
						LOCAL xdolarofi,costmin
						
						xdolarofi= cur_dolarofi.param_impo
						IF _screen.moneocpra='D'
							SELECT IIF(moneda="D",artpro_costo,ROUND(artpro_costo/xdolarofi,3)) as costo, moneda ;
									FROM cur_costos WHERE prov_codi = codiprov INTO CURSOR calc_costos
							IF RECCOUNT("calc_costos") > 0
								IF ALLTRIM(calc_costos.moneda)<>ALLTRIM(_screen.moneocpra)
									thisform.validamon(calc_costos.moneda)
									IF thisform.confmone=2
										thisform.confmone=0
										thisform.text1.SetFocus
										RETURN
									ENDIF
								ENDIF
							ENDIF
						ELSE
							SELECT IIF(moneda="P",artpro_costo,ROUND(artpro_costo*xdolarofi,3)) as costo, moneda ;
									FROM cur_costos WHERE prov_codi = codiprov INTO CURSOR calc_costos
							IF RECCOUNT("calc_costos") > 0
								IF ALLTRIM(calc_costos.moneda)<>ALLTRIM(_screen.moneocpra)
									thisform.validamon(calc_costos.moneda)
									IF thisform.confmone=2
										thisform.confmone=0
										thisform.text1.SetFocus
										RETURN
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					ELSE
						SELECT artpro_costo as costo, moneda ;
								FROM cur_costos WHERE prov_codi = codiprov INTO CURSOR calc_costos
					ENDIF
					cerrar_cursor("cur_dolarofi")
					
					costmin= IIF(RECCOUNT("calc_costos")>0,calc_costos.costo,0)
					if paso=0
						if cond=2
							thisform.text4.value=ROUND(costmin,3)
						ELSE
							thisform.text4.value=ROUND((costmin+costmin*iif(cur_arti.art_alicuota=1,impiva1,impiva2)/100),3)
						ENDIF
					ELSE
						IF codigo <> dato1
							if cond=2
								thisform.text4.value=ROUND(costmin,3)
							ELSE
								thisform.text4.value=ROUND((costmin+costmin*iif(cur_arti.art_alicuota=1,impiva1,impiva2)/100),3)
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			desconectar_db(frmcualarp)
			SET DECIMALS TO
			do case
				case cur_arti.art_alicuota=1
					thisform.text12.value=allt(str(impiva1,10,2))
				case cur_arti.art_alicuota=2
					thisform.text12.value=allt(str(impiva2,10,2))
			endcase
			thisform.text2.setfocus
		ELSE
			thisform.cmd_masdes.Visible= .F.
			thisform.text1.setfocus
		endif
		thisform.setall("Format","K","Textbox")
		thisform.command3.enabled=.T.
		
		
	ENDPROC

	PROCEDURE Command2.Click
		thisform.setall("Enabled",.F.,"CommandButton")
		do form altasart
		
	ENDPROC

	PROCEDURE Command3.Click
		do case
			case thisform.height=162
				thisform.height=328
				this.caption="\<Ocultar Datos"
			case thisform.height=328
				thisform.height=162
				this.caption="\<Ver Datos"
		endcase	
	ENDPROC

	PROCEDURE Command4.Click
		thisform.text3.readonly=.F.
		thisform.text3.setfocus
	ENDPROC

	PROCEDURE Command5.Click
		with thisform
			if .shape5.visible=.F.
				.shape5.visible=.T.
				.label20.visible=.T.
				.label25.visible=.T.
				.edit3.visible=.T.
				.edit2.visible=.T.
				this.caption="\<Ocultar Detalles"
				.edit2.setfocus
				IF thisform.text1.Value>0
					.edit3.enabled=.T.
				ENDIF
			else
				.shape5.visible=.F.
				.label20.visible=.F.
				.label25.visible=.F.
				.edit3.visible=.F.
				.edit2.visible=.F.
				this.caption="\<Ver Detalles"
				.text2.setfocus	
				.edit3.enabled=.F.
			endif
		endwith
	ENDPROC

	PROCEDURE Command5.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command5.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Edit3.GotFocus
		PUBLIC estamayus,anot
		estamayus= CAPSLOCK()
		anot=ALLTRIM(this.Value)
		CAPSLOCK(.T.)
	ENDPROC

	PROCEDURE Edit3.LostFocus
		DO case
			CASE estamayus=.T.
				CAPSLOCK(.T.)
			CASE estamayus=.F.
				CAPSLOCK(.F.)
		ENDCASE
		frmcart= conectar_db(_screen.cn)
			SQLEXEC(frmcart,"update articulos set art_detaofi=?trim(this.value) where art_codi=?thisform.text1.value;")
		desconectar_db(frmcart)
	ENDPROC

	PROCEDURE lbl_diascosto.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		thisform.calc_meses(thisform.ndiascosto)
	ENDPROC

	PROCEDURE Optiongroup1.Option1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Optiongroup1.Option2.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Optiongroup1.Option3.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		*!*	thisform.setall("Enabled",.T.,"CommandButton")
	ENDPROC

	PROCEDURE Text1.Valid
		LOCAL xcc
		if this.value>0
			xcc=this.value
			thisform.lbl_prov.BackStyle= 0
			thisform.lbl_prov.Caption=''
			thisform.grd_costos.RecordSource=''
			thisform.grd_costos.Refresh()
			frmcualarp= conectar_db(_screen.cn)
				if this.Value<=5
					SQLEXEC(frmcualarp, "select * from articulos where art_codi=?this.value;","cur_arti")
				else
					SQLEXEC(frmcualarp, "select a.*,b.* from articulos a inner join rubros b on a.rub_codi=b.rub_codi where a.art_codi=?this.value;","cur_arti")
				endif
			desconectar_db(frmcualarp)
			IF RECCOUNT("cur_arti")>0
				if cur_arti.art_codi>5
					frmcualarp= conectar_db(_screen.cn)
						SQLEXEC(frmcualarp,"select * from desc_articulos_proveedores where artpro_codi = any (select artpro_codi from articulos_proveedores where art_codi=?this.value and prov_codi=?codiprov);","cur_difdes")
					desconectar_db(frmcualarp)
					IF RECCOUNT("cur_difdes")>0
						frmcualarp= conectar_db(_screen.cn)
							SQLEXEC(frmcualarp,"call usp_ultdescpra(?cur_arti.art_codi,?codiprov,?_screen.xopcpra);","cur_udd")
						desconectar_db(frmcualarp)
						IF RECCOUNT("cur_udd") > 0
							thisform.text3.value=cur_udd.dap_desc
							cerrar_cursor("cur_udd")
						ELSE
							thisform.text3.value=cur_arti.art_desc
						ENDIF
						thisform.cmd_masdes.Visible= .T.
		*!*					IF !INLIST(valorcadena,'Por Artículo','Por Orden de Compra')
		*!*						codicli=0
		*!*						descri=""
		*!*						do form diferentesdesc with codicli,codiprov,descri,this.value
		*!*						if not isblank(descri)
		*!*							thisform.text3.value=allt(descri)
		*!*						else
		*!*							thisform.text3.value=cur_arti.art_desc
		*!*							ENDIF
		*!*					ELSE
		*!*						thisform.text3.value=cur_arti.art_desc
		*!*					ENDIF
					else
						thisform.text3.value=cur_arti.art_desc
					endif
					thisform.text6.value=cur_arti.art_stock
					thisform.text7.value=cur_arti.pedidos
					thisform.text8.value=cur_arti.pedprov
					cerrar_cursor("cur_tped")
					cerrar_cursor("cur_tcom")
					do case
						case cur_arti.art_med="UN"
							thisform.optiongroup1.value=1
						case cur_arti.art_med="MT"
							thisform.optiongroup1.value=2
						case cur_arti.art_med="KG"
							thisform.optiongroup1.value=3
					endcase
					thisform.text9.value=cur_arti.art_stock+thisform.text8.value-thisform.text7.value
					thisform.text10.value=cur_arti.art_precio
					thisform.text13.value=cur_arti.costo_ultcpra
					thisform.text14.Value=cur_arti.art_stmin
					thisform.text11.value=cur_arti.rub_desc
					thisform.edit2.value=cur_arti.art_deta
					thisform.edit3.value=cur_arti.art_detaofi
					thisform.dias_actcosto(this.value)
					WITH thisform
						if LEN(ALLTRIM(.edit3.Value))>0
							.shape5.visible=.T.
							.label20.visible=.T.
							.label25.visible=.T.
							.edit3.visible=.T.
							.edit2.visible=.T.
							thisform.command5.caption="\<Ocultar Detalles"
							IF thisform.text1.Value>0
							.edit3.enabled=.T.
							ENDIF
						else
							.shape5.visible=.F.
							.label20.visible=.F.
							.label25.visible=.F.
							.edit3.visible=.F.
							.edit2.visible=.F.
							thisform.command5.caption="\<Ver Detalles"
							.edit3.enabled=.F.
						ENDIF
					ENDWITH
					thisform.grd_costos.RecordSource=''
					thisform.grd_costos.Refresh()
					SET DECIMALS TO 3
					frmcualarp= conectar_db(_screen.cn)
						SQLEXEC(frmcualarp,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
						IF RECCOUNT("provc")>0
							thisform.lbl_prov.BackStyle= 1
							thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
						ENDIF			
						SQLEXEC(frmcualarp,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.otro,a.prov_codi from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?this.value order by a.artpro_costo;","cur_costos")
						IF RECCOUNT("cur_costos")>0
							GO top
							thisform.grd_costos.RecordSource="cur_costos"
							thisform.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(cur_costos.lista,cur_costos.cotiz)","Column")
							thisform.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(cur_costos.otro)","Column")
							thisform.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(cur_costos.otro)","Column")
							GO top
							IF WEXIST("modiocpra") OR WEXIST("altaocpra")
								SQLEXEC(frmcualarp,"select param_impo from parametros where param_codi=14;","cur_dolarofi")
								
								LOCAL xdolarofi,costmin
								
								xdolarofi= cur_dolarofi.param_impo
								IF _screen.moneocpra='D'
									SELECT IIF(moneda="D",artpro_costo,ROUND(artpro_costo/xdolarofi,3)) as costo, moneda ;
											FROM cur_costos WHERE prov_codi = codiprov INTO CURSOR calc_costos
									IF RECCOUNT("calc_costos") > 0
										IF ALLTRIM(calc_costos.moneda)<>ALLTRIM(_screen.moneocpra)
											thisform.validamon(calc_costos.moneda)
											IF thisform.confmone=2
												thisform.confmone=0
												RETURN 0
											ENDIF
										ENDIF
									ENDIF
								ELSE
									SELECT IIF(moneda="P",artpro_costo,ROUND(artpro_costo*xdolarofi,3)) as costo, moneda ;
											FROM cur_costos WHERE prov_codi = codiprov INTO CURSOR calc_costos
									IF RECCOUNT("calc_costos") > 0
										IF ALLTRIM(calc_costos.moneda)<>ALLTRIM(_screen.moneocpra)
											thisform.validamon(calc_costos.moneda)
											IF thisform.confmone=2
												thisform.confmone=0
												RETURN 0
											ENDIF								
										ENDIF
									ENDIF
								ENDIF
							ELSE
								SELECT artpro_costo as costo, moneda ;
										FROM cur_costos WHERE prov_codi = codiprov INTO CURSOR calc_costos
							ENDIF
							cerrar_cursor("cur_dolarofi")
							
							costmin= IIF(RECCOUNT("calc_costos")>0,calc_costos.costo,0)
							if paso=0
								if cond=2
									thisform.text4.value=ROUND(costmin,3)
								ELSE
									thisform.text4.value=ROUND((costmin+costmin*iif(cur_arti.art_alicuota=1,impiva1,impiva2)/100),3)
								ENDIF
							ELSE
								IF this.Value <> dato1
									if cond=2
										thisform.text4.value=ROUND(costmin,3)
									ELSE
										thisform.text4.value=ROUND((costmin+costmin*iif(cur_arti.art_alicuota=1,impiva1,impiva2)/100),3)
									ENDIF
								ENDIF
							ENDIF					
						ELSE
							thisform.text4.value=0
							thisform.text5.value=0				
						ENDIF
					desconectar_db(frmcualarp)
					SET DECIMALS TO
				else
					thisform.text4.value=0
					thisform.text5.value=0
					thisform.cmd_masdes.Visible= .F.
				endif
				do case
					case cur_arti.art_alicuota=1
						thisform.text12.value=allt(str(impiva1,10,2))
					case cur_arti.art_alicuota=2
						thisform.text12.value=allt(str(impiva2,10,2))
				endcase
				thisform.command4.enabled=.T.
			else
				messagebox("Artículo no está en archivo",0+48,"Advertencia")
				this.value=0
				return 0
			endif
		endif
		
	ENDPROC

	PROCEDURE Text13.Click
		if this.value>0
			do form consrapcosto with thisform.text1.value
		endif
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.GotFocus
		this.Click()
	ENDPROC

	PROCEDURE Text2.LostFocus
		if cur_arti.art_codi=4 or cur_arti.art_codi=5
			do form artsincodi with descrip
			thisform.text3.visible=.F.
			thisform.text3.value=descrip
			thisform.edit1.value=descrip
			thisform.edit1.visible=.T.
			thisform.text4.setfocus
			codigo=1
		else
			thisform.text4.setfocus
		endif
		
	ENDPROC

	PROCEDURE Text3.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Text3.LostFocus
		capslock(.F.)
		this.readonly=.T.
		thisform.text4.setfocus
	ENDPROC

	PROCEDURE Text4.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text4.LostFocus
		with thisform
		*!*		.label15.caption="Dto: "+allt(str(100-(val(this.value)*100/iif(cond=2,art_precio,art_precio+art_precio*val(.text12.value)/100)),10,2))+" %"
			.text5.value=ConverNro(.text2.value)*this.value
		endwith
	ENDPROC

	PROCEDURE Text5.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			SET POINT TO "."
			SET DECIMALS TO 4
			codigo=thisform.text1.value
		
			cant=thisform.text2.value
			cant=STRTRAN(cant,",",".")
		
			descri=ALLTRIM(thisform.text3.value)
		
			pruni=allt(str(thisform.text4.value,15,4))
			pruni=STRTRAN(pruni,",",".")
			prtot=allt(str(this.value,15,2))
			prtot=STRTRAN(prtot,",",".")
		
			SET POINT TO 
			SET DECIMALS TO
			if valorcadena="Ordenes de Compra" or valorcadena="Ordenes Compra"
				if allt(thisform.text3.value)<>allt(cur_arti.art_desc) and codigo<>4 and codigo<>5
					frmcualarp= conectar_db(_screen.cn)
						SQLEXEC(frmcualarp,"select * from articulos_proveedores where prov_codi=?codiprov and art_codi=?codigo;","cur_arpro")
					desconectar_db(frmcualarp)
					IF RECCOUNT("cur_arpro")>0
						if allt(thisform.text3.value)<>allt(cur_arpro.artpro_desc)
							frmcualarp= conectar_db(_screen.cn)
								LOCAL xdes
								xdes=allt(thisform.text3.value)
								SQLEXEC(frmcualarp,"update articulos_proveedores set artpro_desc=?xdes where artpro_codi=?cur_arpro.artpro_codi;")
							desconectar_db(frmcualarp)
						endif
						LOCAL xcadena
						xcadena=ALLTRIM(STR(cur_arpro.artpro_codi))+ALLTRIM(descri)
						frmcualarp= conectar_db(_screen.cn)
							SQLEXEC(frmcualarp,"select * from desc_articulos_proveedores where concat(cast(artpro_codi as char),TRIM(dap_desc))=?xcadena;","cur_ddes")
						desconectar_db(frmcualarp)
						IF RECCOUNT("cur_ddes")=0
							frmcualarp= conectar_db(_screen.cn)
								SQLEXEC(frmcualarp,"select CAST(dap_codi+1 as decimal(8,0)) as dap_codi from desc_articulos_proveedores order by dap_codi desc limit 1;","cur_nvo")
								SQLEXEC(frmcualarp,"insert into desc_articulos_proveedores values(?cur_nvo.dap_codi,?cur_arpro.artpro_codi,?descri);")
							desconectar_db(frmcualarp)
						endif
					ELSE
						frmcualarp= conectar_db(_screen.cn)
							LOCAL xporctovta
							SQLEXEC(frmcualarp,"select param_impo from parametros where param_codi=10;","cur_xpcto")
							xporctovta= ROUND(this.value/((100-cur_xpcto.param_impo)/100),3)
							SQLEXEC(frmcualarp,"select CAST((artpro_codi+1) as decimal(8,0)) as artpro_codi from articulos_proveedores order by artpro_codi desc limit 1;","cur_nvo1")
							SQLEXEC(frmcualarp,"insert into articulos_proveedores values(?cur_nvo1.artpro_codi,?codigo,?codiprov,?this.value,?xporctovta,'','',0,0,0);" )
		
							SQLEXEC(frmcualarp,"select CAST((dap_codi+1) as decimal(8,0)) as dap_codi from desc_articulos_proveedores order by dap_codi desc limit 1;","cur_nvo2")
							SQLEXEC(frmcualarp,"insert into desc_articulos_proveedores values(?cur_nvo2.dap_codi,?cur_nvo1.artpro_codi,?descri);")
						desconectar_db(frmcualarp)
					endif
				endif
				cerrar_cursor("cur_nvo")
				cerrar_cursor("cur_arpro")
				cerrar_cursor("cur_nvo1")
				cerrar_cursor("cur_nvo2")
			endif
			thisform.release
		endif
	ENDPROC

ENDDEFINE


	PROCEDURE Destroy
		IF USED("cur_gascon")
			cerrar_cursor("cur_gascon")
		ENDIF
		IF USED("cur_gascon")
			cerrar_cursor("cur_gascon")
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS codgas
		
		set date british
		set cent on
		set deleted on
		SET POINT TO "."
		SET SEPARATOR TO ","
		SET TALK OFF
		SET NOTIFY off
		
		thisform.grd_detalle.RecordSource=""
		thisform.grd_detalle.Refresh()
		
		frmconsgas= conectar_db(_screen.cn)
			SQLEXEC(frmconsgas,"select a.*,b.per_desc,b.per_cuit,b.cond_codi,c.*,d.tipgas_desc from gastos a inner join personas b on a.per_codi=b.per_codi inner join iva c on c.iva_codi=a.iva_codi inner join tiposgastos d on d.tipgas_codi=a.tipgas_codi where a.gas_codi=?codgas;","cur_gascon")
			SQLEXEC(frmconsgas,"select * from condiva where cond_codi=?cur_gascon.cond_codi;","cur_condi")	
		desconectar_db(frmconsgas)
		
		IF RECCOUNT("cur_gascon")>0
			IF RECCOUNT("cur_condi")>0
				thisform.txt_cond.Value=cur_condi.cond_desc
			ENDIF
			SELECT cur_gascon
			GO top
			thisform.txt_nprov.Value  = cur_gascon.per_codi
			thisform.txt_prov.Value   = cur_gascon.per_desc
			thisform.txt_cuit.Value   = cur_gascon.per_cuit
			thisform.txt_ngas.Value   = cur_gascon.tipgas_codi
			thisform.txt_gas.Value    = cur_gascon.tipgas_desc
			thisform.edt_obser.Value  = ALLTRIM(cur_gascon.gas_obser)
			xtip=ALLTRIM(cur_gascon.gas_conc)
			thisform.txt_cbte.Value   = ICASE(xtip="F","FACTURA",xtip="N","N.CRÉDITO",xtip="D","N.DÉBITO")
			thisform.txt_tiipo.Value  = cur_gascon.gas_tipcbte
			thisform.txt_pto.Value    = cur_gascon.gas_pto
			thisform.txt_nfac.Value   = cur_gascon.gas_cbte
			thisform.txt_fecha.Value  = cur_gascon.gas_fech
			&& iif(cur_recep.recep_dto>0,((cur_recep.neto_1+cur_recep.neto_2)/((100-cur_recep.recep_dto)/100)),cur_recep.neto_1+cur_recep.neto_2)
			thisform.txt_subt.Value   = ROUND(IIF(cur_gascon.gas_dto>0,(cur_gascon.gas_impo+cur_gascon.gas_impo2+cur_gascon.gas_impo3)/((100-cur_gascon.gas_dto)/100), ;
									              cur_gascon.gas_impo+cur_gascon.gas_impo2+cur_gascon.gas_impo3),2)
			thisform.txt_pdto.Value   = cur_gascon.gas_dto
			thisform.txt_dto.Value    = ROUND((thisform.txt_subt.value*cur_gascon.gas_dto)/100,2)
			thisform.txt_grav.Value   = thisform.txt_subt.Value-thisform.txt_dto.Value
			thisform.txt_ng.Value     = cur_gascon.gas_impng
			thisform.txt_iva1.Value   = cur_gascon.gas_iva
			thisform.txt_iva2.Value   = cur_gascon.gas_iva2
			thisform.txt_iva3.Value   = cur_gascon.gas_iva3
			thisform.txt_piva.Value   = cur_gascon.gas_piva
			thisform.txt_pbtos.Value  = cur_gascon.gas_btos
			thisform.txt_total.Value  = thisform.txt_grav.Value+ ;
										thisform.txt_ng.Value+ ;
										thisform.txt_iva1.Value+ ;
										thisform.txt_iva2.Value+ ;
										thisform.txt_iva3.Value+ ;
										thisform.txt_piva.Value+ ;
										thisform.txt_pbtos.Value
			thisform.lbl_iva1.caption = ALLTRIM(STR(cur_gascon.iva_1,10,2))+" %"
			thisform.lbl_iva2.caption = ALLTRIM(STR(cur_gascon.iva_2,10,2))+" %"
			thisform.lbl_iva3.caption = ALLTRIM(STR(cur_gascon.iva_3,10,2))+" %"
			IF cur_gascon.cc=1
				thisform.lbl_estadocta.Visible= .T.
			ELSE
				thisform.lbl_estadocta.Visible= .F.
			ENDIF
			frmconsgas= conectar_db(_screen.cn)
				SQLEXEC(frmconsgas,"call usp_detagas(?codgas);","cur_detgas")
			desconectar_db(frmconsgas)
			IF RECCOUNT("cur_detgas")>0
				GO top
				thisform.grd_detalle.RecordSource="cur_detgas"
				thisform.grd_detalle.column1.SetFocus
			ENDIF
			thisform.cmd_salir.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		*!*	IF nKeyCode=22
		*!*	   Thisform.inseritem(nKeyCode, thisform.grd_detalle)
		*!*	ENDIF
	ENDPROC

	PROCEDURE cmd_salir.Click
		thisform.release
		
	ENDPROC

	PROCEDURE cmd_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Text23.Click
		this.setfocus
	ENDPROC

ENDDEFINE


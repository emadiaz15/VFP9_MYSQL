	PROCEDURE excelfooter
		LPARAMETERS xInifil
		
		LOCAL fotfil, xtexto
		
		fotfil = xInifil
		
		XLSheet.Rows(fotfil).RowHeight = 10
		
		*!*	thisform.excelcuadrofooter(fotfil)
		fotfil = fotfil + 1
		*!*	thisform.excelcuadrofooter(fotfil)
		
		xtexto = ICASE(thisform.opt_estado.Value=3,'ECHEQS',thisform.opt_estado.Value=2,'CHEQUES','CHEQUES/ECHEQS')
		*!*	xtexto = IIF(thisform.opt_estado.Value=3,'ECHEQS','CHEQUES')
		Xlsheet.cells(fotfil,8)='IMPORTE TOTAL DE '+ALLTRIM(xtexto)
		Xlsheet.cells(fotfil,8).HorizontalAlignment=-4152
		XLSheet.Cells(fotfil,9).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		XLSheet.Cells(fotfil,9)=thisform.txt_total.value
		fotfil = fotfil + 1
		*!*	thisform.excelcuadrofooter(fotfil)
		Xlsheet.cells(fotfil,8)='CANTIDAD TOTAL DE '+ALLTRIM(xtexto)
		Xlsheet.cells(fotfil,8).HorizontalAlignment=-4152
		XLSheet.Cells(fotfil,9)=thisform.cantcheq
		
		WITH Xlsheet.range(XLSheet.Cells(fotfil-1,8),XLSheet.Cells(fotfil,9))
			.font.bold=.T.
			.font.size=12
		ENDWITH
		
		Xlsheet.range(XLSheet.Cells(fotfil-1,5),XLSheet.Cells(fotfil-1,9)).font.color=RGB(0,0,255)
		Xlsheet.range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,9)).font.color=RGB(255,0,0)
		
		RETURN
		
		
		
		
		
	ENDPROC

	PROCEDURE GotFocus
		SET POINT TO ","
		SET SEPARATOR TO "."
	ENDPROC

	PROCEDURE grid_rightclick
		IF USED("cartera")
			IF cartera.recpag_codi>0
				LOCAL lcShortcut, loRef, xcons, xmodi, xnroval, xtipval
				m.loRef = this
				m.lcShortcut = SYS(2015)
				
				xnroval = ALLTRIM(cartera.chequenro)
				xtipval = ICASE(ALLTRIM(cartera.tipo)="CHEQUE",1,ALLTRIM(cartera.tipo)="ECHEQ",2)
				
				xcons="[Consultar "+ALLTRIM(cartera.tipo)+"]"
				xmodi="[Modificar "+ALLTRIM(cartera.tipo)+"]"
		
				DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
				DEFINE BAR 1 OF (m.lcShortcut) PROMPT &xcons PICTURE "C:\VFP9_MYSQL\imagen\cheque_01.png"
				DEFINE BAR 2 OF (m.lcShortcut) PROMPT "Consultar Depósito" PICTURE "C:\VFP9_MYSQL\imagen\iconos\archive.png"
				
				ON SELECTION BAR 1 OF (m.lcShortcut) m.loRef.muestracheq()
				ON SELECTION BAR 2 OF (m.lcShortcut) do form consdeposito with cartera.dep_codi
		
				ACTIVATE POPUP (m.lcShortcut)
				RELEASE POPUP (m.lcShortcut)
				thisform.btn_actualizar.btn.Click()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		SET POINT TO ","
		SET SEPARATOR TO "."
		LOCAL totmes,totales,concheq,contot
		STORE 0 TO totmes,totales,cadena,concheq,contot
		CREATE CURSOR cartera(tipo C(6),chequenro C(14),bcocaja C(45),bolnro C(30),fechadep D,procedencia C(50),;
							  banco C(45),plaza C(25),importe N(15,2),recpag_codi N(8),activo C(1),chid C(4),dep_codi N(8))
		
		frmconche= conectar_db(_screen.cn)
			SQLEXEC(frmconche,"select param_desc from parametros where param_codi = 13;","cur_emp")
		desconectar_db(frmconche)
		
		IF RECCOUNT("cur_emp") > 0
			thisform.empresa=ALLTRIM(cur_emp.param_desc)
			cerrar_cursor("cur_emp")
		ENDIF
		
		thisform.txt_fecdes.Value=ctod("01/01/"+allt(str(year(date()))))
		thisform.txt_fechas.Value=DATE()
		thisform.xfecdes=thisform.txt_fecdes.Value
		thisform.xfechas=thisform.txt_fechas.Value
		thisform.chk_banco.Value=1
		thisform.chk_impo.Value=1
		
		frmconsdep = conectar_db(_screen.cn)
			SQLEXEC(frmconsdep,"select param_fec from parametros where param_codi = 4;","cur_primfec")
		desconectar_db(frmconsdep)
		IF RECCOUNT("cur_primfec") > 0
			thisform.xprimefec = cur_primfec.param_fec
			cerrar_cursor("cur_primfec")
		ENDIF
		
		frmconsdep= conectar_db(_screen.cn)
			SQLEXEC(frmconsdep,"select banc_desc,banc_codi,banc_ncta from bancos_caja order by banc_desc;","cur_bank")
		desconectar_db(frmconsdep)
		IF RECCOUNT("cur_bank")>0
			GO top
			thisform.cmb_banco.rowsource="select banc_desc,banc_codi,banc_ncta from cur_bank INTO CURSOR cmb_banco"
		*!*		thisform.cmb_banco.SetFocus
		*!*		KEYBOARD '{F4}'
			cerrar_cursor("cur_bank")
		ENDIF
		
		frmconche= conectar_db(_screen.cn)
			SQLEXEC(frmconche,"call usp_cheqdep(0,?thisform.xfecdes,?thisform.xfechas);","cheqdep")
		desconectar_db(frmconche)
		thisform.txt_impdes.Value=0
		thisform.ximpdes=0
		IF RECCOUNT("cheqdep")>0
			thisform.btn_print.Enabled= .T.
			SELECT MAX(movtippag_imp) FROM cheqdep INTO ARRAY ar_maxval
			IF TYPE("ar_maxval")="N"
				thisform.txt_imphas.Value=ar_maxval[1,1]
			ELSE
				thisform.txt_imphas.Value=0
			ENDIF
			thisform.ximphas=thisform.txt_imphas.Value
			GO top
			
			SCAN
				totmes=0
				concheq=0
				cadena=ALLTRIM(STR(MONTH(cheqdep.dep_fech)))+ALLTRIM(STR(YEAR(cheqdep.dep_fech)))
				DO WHILE ALLTRIM(STR(MONTH(cheqdep.dep_fech)))+ALLTRIM(STR(YEAR(cheqdep.dep_fech)))=cadena
					INSERT INTO cartera(tipo,chequenro,bcocaja,bolnro,fechadep,procedencia,banco,plaza,importe,recpag_codi,activo,chid,dep_codi) ;
								VALUES (IIF(cheqdep.tippag_codi=3,'CHEQUE','ECHEQ'),cheqdep.chequenro,cheqdep.banc_desc, ;
										ALLTRIM(cheqdep.dep_bolnro),cheqdep.dep_fech,cheqdep.cli_nomb,cheqdep.ban_desc, ;
										cheqdep.movtippag_pza,cheqdep.movtippag_imp,cheqdep.recpag_codi,cheqdep.activo,cheqdep.cheqid,cheqdep.dep_codi)
					totmes=totmes+cheqdep.movtippag_imp
					concheq=concheq+1
					SKIP
				ENDDO
				SKIP-1
				contot=contot+concheq
				totales=totales+totmes
				cadplaza=ALLTRIM('TOT. '+UPPER(Mes_Nombre(MONTH(cheqdep.dep_fech)))+' '+ALLTRIM(STR(YEAR(cheqdep.dep_fech)))+'('+ALLTRIM(STR(concheq))+')')
				INSERT INTO cartera(plaza,importe,recpag_codi) ;
							VALUES (cadplaza,totmes,0)
			ENDSCAN
			GO TOP IN cartera
			thisform.grd_cheques.RecordSource="cartera"
			thisform.btn_print.Enabled= .T.
		
			thisform.grd_cheques.SetAll("DynamicFontName","IIF(cartera.recpag_codi=0,'Arial Black','Tahoma')","Column")
			thisform.txt_total.Value=totales
			thisform.lbl_totcheq.Caption='SE DEPOSITARON '+ALLTRIM(STR(contot))+' CHEQUES EN TOTAL'
			thisform.cantcheq= contot
		
			FOR ncol=1 TO 9
				xsource="thisform.grd_cheques.column"+ALLTRIM(STR(ncol))+".text1"
				BINDEVENT(&xsource,"DblClick",Thisform,"muestracheq")
				BINDEVENT(&xsource,"RightClick",Thisform,"grid_rightclick")
			NEXT ncol
		ELSE
			thisform.estadoinicio=.T.
			thisform.txt_imphas.Value=0
		ENDIF
		
	ENDPROC

	PROCEDURE LostFocus
		SET POINT TO
		SET SEPARATOR TO
	ENDPROC

	PROCEDURE muestracheq
		IF cartera.recpag_codi>0
			LOCAL xtipo
			xtipo= ICASE(cartera.tipo="CHEQUE",1,cartera.tipo="ECHEQ",2)
			do form conscheqrap with cartera.recpag_codi,xtipo
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnFecha,tnCodi
		
		LOCAL lnColor
		
			DO CASE
				CASE tnFecha=DATE() AND tnCodi>0
					lnColor=RGB(255,255,0)
				CASE tnFecha=DATE()+1 AND tnCodi>0
					lnColor=RGB(0,255,0)
				CASE tnFecha>DATE()+1 AND tnCodi>0
					lnColor=RGB(0,0,0)
				CASE tnFecha<DATE() AND tnCodi>0
					lnColor=RGB(128,0,0)
			ENDCASE
		
		return(lnColor)	
	ENDPROC

	PROCEDURE recuestado
		LPARAMETERS nCol
		
		XLSheet.Cells(7,nCol).Borders(1).LineStyle=1
		XLSheet.Cells(7,nCol).Borders(1).Weight=3
		XLSheet.Cells(7,nCol).Borders(2).LineStyle=1
		XLSheet.Cells(7,nCol).Borders(2).Weight=3
		XLSheet.Cells(7,nCol).Borders(3).LineStyle=1
		XLSheet.Cells(7,nCol).Borders(3).Weight=3
		XLSheet.Cells(7,nCol).Borders(4).LineStyle=1
		XLSheet.Cells(7,nCol).Borders(4).Weight=3
		
		RETURN
	ENDPROC

	PROCEDURE btn_actualizar.btn.Click
		LOCAL totmes,totales,concheq,contot
		STORE 0 TO totmes,totales,cadena,concheq,contot
		STORE 0 TO thisform.venci,thisform.hoy,thisform.man
		SELECT cartera
		SET SAFETY OFF
		ZAP
		SET SAFETY ON
		thisform.grd_cheques.RecordSource=''
		thisform.grd_cheques.Refresh()
		thisform.btn_print.Enabled= .F.
		thisform.xfecdes=thisform.txt_fecdes.Value
		thisform.xfechas=thisform.txt_fechas.Value
		frmconche= conectar_db(_screen.cn)
			DO case
				CASE thisform.opt_estado.Value=1
					SQLEXEC(frmconche,"call usp_cheqdep(0,?thisform.xfecdes,?thisform.xfechas);","cheqdep")
				CASE thisform.opt_estado.Value=2
					SQLEXEC(frmconche,"call usp_cheqdep(1,?thisform.xfecdes,?thisform.xfechas);","cheqdep")
				CASE thisform.opt_estado.Value=3
					SQLEXEC(frmconche,"call usp_cheqdep(2,?thisform.xfecdes,?thisform.xfechas);","cheqdep")
			ENDCASE
		desconectar_db(frmconche)
		totales=0
		IF RECCOUNT("cheqdep")>0
			thisform.estadoinicio=.T.
			thisform.btn_print.Enabled= .T.
			GO top
			SELECT MAX(movtippag_imp) FROM cheqdep INTO ARRAY ar_maxval
			IF TYPE("ar_maxval")="N"
				thisform.txt_imphas.Value=ar_maxval[1,1]
			ELSE
				thisform.txt_imphas.Value=0
			ENDIF
			thisform.ximphas=thisform.txt_imphas.Value	
			DO case
				CASE thisform.xcodicli<>99999999
					SELECT * FROM cheqdep WHERE cli_codi = thisform.xcodicli INTO CURSOR cheqdep
				CASE thisform.codibank<>99999999
					SELECT * FROM cheqdep WHERE banc_codi = thisform.codibank INTO CURSOR cheqdep
				CASE thisform.txt_impdes.Value<>0 OR thisform.txt_imphas.Value<>99999999
					SELECT * FROM cheqdep WHERE movtippag_imp between thisform.txt_impdes.Value AND thisform.txt_imphas.Value INTO CURSOR cheqdep
			ENDCASE
			
			GO top
			
			SCAN
				totmes=0
				concheq=0
				cadena=ALLTRIM(STR(MONTH(cheqdep.dep_fech)))+ALLTRIM(STR(YEAR(cheqdep.dep_fech)))
				DO WHILE ALLTRIM(STR(MONTH(cheqdep.dep_fech)))+ALLTRIM(STR(YEAR(cheqdep.dep_fech)))=cadena
					INSERT INTO cartera(tipo,chequenro,bcocaja,bolnro,fechadep,procedencia,banco,plaza,importe,recpag_codi,activo,chid,dep_codi) ;
								VALUES (IIF(cheqdep.tippag_codi=3,'CHEQUE','ECHEQ'),cheqdep.chequenro,cheqdep.banc_desc, ;
										ALLTRIM(cheqdep.dep_bolnro),cheqdep.dep_fech,cheqdep.cli_nomb,cheqdep.ban_desc, ;
										cheqdep.movtippag_pza,cheqdep.movtippag_imp,cheqdep.recpag_codi,cheqdep.activo,cheqdep.cheqid,cheqdep.dep_codi)
					totmes=totmes+cheqdep.movtippag_imp
					concheq=concheq+1
					SKIP
				ENDDO
				SKIP-1
				contot=contot+concheq
				totales=totales+totmes
				cadplaza=ALLTRIM('TOT. '+UPPER(Mes_Nombre(MONTH(cheqdep.dep_fech)))+' '+ALLTRIM(STR(YEAR(cheqdep.dep_fech)))+'('+ALLTRIM(STR(concheq))+')')
				INSERT INTO cartera(plaza,importe,recpag_codi) ;
							VALUES (cadplaza,totmes,0)
			ENDSCAN
			GO TOP IN cartera
			thisform.grd_cheques.RecordSource="cartera"
		
			thisform.grd_cheques.SetAll("DynamicFontName","IIF(cartera.recpag_codi=0,'Arial Black','Tahoma')","Column")
		ENDIF	
		thisform.txt_total.Value=totales
		DO CASE
			CASE thisform.opt_estado.Value=1
				thisform.lbl_impotot.Caption='IMPORTE TOTAL:'
				thisform.lbl_totcheq.Caption='SE DEPOSITARON '+ALLTRIM(STR(contot))+' CHEQUES EN TOTAL'
			CASE thisform.opt_estado.Value=2
				thisform.lbl_impotot.Caption='IMPORTE TOTAL DE CHEQUES FISICOS:'
				thisform.lbl_totcheq.Caption='SE DEPOSITARON '+ALLTRIM(STR(contot))+' CHEQUES FISICOS'
			CASE thisform.opt_estado.Value=3
				thisform.lbl_impotot.Caption='IMPORTE TOTAL DE ECHEQS:'
				thisform.lbl_totcheq.Caption='SE DEPOSITARON '+ALLTRIM(STR(contot))+' ECHEQS'	
		ENDCASE
		thisform.cantcheq= contot
		IF thisform.txt_find.Visible= .T.
			thisform.txt_find.Visible= .F.
			thisform.txt_find.Value=''
		ENDIF
		
		
	ENDPROC


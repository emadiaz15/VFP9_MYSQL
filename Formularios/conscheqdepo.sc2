		XLSheet.Cells(9,6).font.bold=.T.
		XLSheet.Cells(9,6).font.size="11"
		XLSheet.Cells(9,6).font.name="Courier New"
		XLSheet.range("F9:F9").HorizontalAlignment=-4108
		XLSheet.Cells(9,7)="BANCO"
		XLSheet.Cells(9,7).font.bold=.T.
		XLSheet.Cells(9,7).font.size="11"
		XLSheet.Cells(9,7).font.name="Courier New"

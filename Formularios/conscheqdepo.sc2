		*!*									cheqdep.movtippag_pza,cheqdep.movtippag_imp,cheqdep.recpag_codi,cheqdep.activo,cheqdep.cheqid,cheqdep.dep_codi)
		*!*				totmes=totmes+cheqdep.movtippag_imp

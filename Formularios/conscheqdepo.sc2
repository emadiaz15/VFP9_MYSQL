	PROCEDURE chk_banco.Click
		IF this.Value=1
			thisform.codibank=99999999
			thisform.cmb_banco.Listindex=0
		ELSE
			thisform.codibank=thisform.codibanant
			thisform.cmb_banco.ListIndex=thisform.indicecombo
		endif
	ENDPROC

	PROCEDURE chk_cliente.Click
		IF this.Value=1
			thisform.xcodicli = 99999999
			thisform.cmb_cliente.value=''
			thisform.cmb_cliente.RowSource=''
			thisform.btn_actualizar.SetFocus
		ELSE
			thisform.xcodicli = 99999999
			thisform.cmb_cliente.SetFocus
		endif
	ENDPROC

	PROCEDURE chk_fecha.Click
		IF this.Value=1
			thisform.txt_fecdes.value=thisform.xprimefec
			thisform.txt_fechas.value=DATE()
			thisform.btn_actualizar.setfocus
		ELSE
			thisform.txt_fecdes.value=ctod("01/01/"+allt(str(year(date()))))
			thisform.txt_fechas.value=DATE()
			thisform.btn_actualizar.SetFocus
		endif
	ENDPROC

	PROCEDURE chk_impo.Click
		thisform.txt_impdes.Value=thisform.ximpdes
		thisform.txt_imphas.Value=thisform.ximphas
		IF this.Value=0
			thisform.txt_impdes.SetFocus
		endif
	ENDPROC

	PROCEDURE cmb_banco.Click
		FOR i=1 TO this.ListCount
			IF this.Selected(i)
				thisform.codibank=cmb_banco.banc_codi
				thisform.codibanant=thisform.codibank
				thisform.indicecombo=this.ListIndex
				thisform.chk_banco.Value=0
			ENDIF
		NEXT i
	ENDPROC

	PROCEDURE cmb_cliente.Click
		this.setfocus
	ENDPROC

	PROCEDURE cmb_cliente.Destroy
		set notify on
	ENDPROC

	PROCEDURE cmb_cliente.GotFocus
		set notify off
		
		
	ENDPROC

	PROCEDURE cmb_cliente.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					frmplanp= conectar_db(_screen.cn)
						xdesc=allt(this.list(i))
						SQLEXEC(frmplanp,"select * from clientes where TRIM(cli_nomb)=?xdesc;","cur_cli")
					desconectar_db(frmplanp)
					thisform.xcodicli=cur_cli.cli_codi
					thisform.chk_cliente.Value=0
					keyboard '{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE cmb_cliente.LostFocus
		IF LEN(ALLTRIM(this.Value)) = 0
			thisform.chk_cliente.Value = 1
			thisform.xcodicli = 99999999
		ENDIF
		
	ENDPROC

	PROCEDURE cmb_cliente.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade="%"+subst(allt(this.text),2,len(allt(this.text)))+"%"
				frmplanp= conectar_db(_screen.cn)
					SQLEXEC(frmplanp,"select * from clientes where cli_nomb like ?cade order by cli_nomb;","cur_cli")
				desconectar_db(frmplanp)
				IF RECCOUNT("cur_cli")>0
					this.rowsource="select cli_nomb from cur_cli INTO CURSOR cmb_cliente"
					this.value=this.list(1)
					keyboard "{F4}"
				ELSE
					MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
					this.Value=""			
				ENDIF
				RETURN .F.
			else
				if len(allt(this.text))>0
					cade=ALLTRIM(this.text)+"%"
					frmplanp= conectar_db(_screen.cn)
						SQLEXEC(frmplanp,"select * from clientes where cli_nomb like ?cade;","cur_cli")
					desconectar_db(frmplanp)
					IF RECCOUNT("cur_cli")>0
						this.rowsource="select cli_nomb from cur_cli INTO CURSOR cmb_cliente"
						this.value=this.list(1)
						keyboard "{F4}"
					ELSE
						MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
						this.Value=""				
					ENDIF
					RETURN .F.
				ENDIF
			endif
		endif
	ENDPROC

	PROCEDURE Command4.Click
		*!*	*!*	IF thisform.opt_estado.option1.Value=0
		*!*	*!*		MESSAGEBOX("Solo podrá convertir a Excel listado de cheques ACTIVOS",0+48,"Aviso del Sistema")
		*!*	*!*	ELSE
		IF USED("cartera")
			IF RECCOUNT("cartera") > 0
				SELECT cheqdep
				LOCATE
				local Fila,fpag,pagina,empresa,lnCantidadDatos,lnI,lnPorcentaje
		
				wait'Espere Un Momento Exportando Datos' window nowait
				_screen.mousepointer=11
				TmpSheet=GetObject('','Excel.Sheet')
				XLApp=TmpSheet.Application
				XLApp.workbooks.add()
				XLSheet=XLApp.ActiveSheet
				with XLSheet.PageSetup
					.Orientation = 2
					.LeftMargin = XLApp.InchesToPoints(0)
					.RightMargin = XLApp.InchesToPoints(0)
				    .TopMargin = XLApp.InchesToPoints(0)
				    .BottomMargin = XLApp.InchesToPoints(0)
				    .HeaderMargin = XLApp.InchesToPoints(0)
				    .FooterMargin = XLApp.InchesToPoints(0)
				    .Zoom=85
				ENDWITH
				XLSheet.Columns("A:A").ColumnWidth = 6.57
				XLSheet.Columns("B:B").ColumnWidth = 13.86
				XLSheet.Columns("B:B").NUMBERFORMAT="@"
				XLSheet.Columns("C:C").ColumnWidth = 15.00
				XLSheet.Columns("D:D").ColumnWidth = 13.00
				XLSheet.Columns("E:E").ColumnWidth = 12.86
				XLSheet.Columns("F:F").ColumnWidth = 40.00
				XLSheet.Columns("G:G").ColumnWidth = 12.57
				XLSheet.Columns("H:H").ColumnWidth = 13.43
				XLSheet.Columns("I:I").ColumnWidth = 16.65
		
				thisform.excelencabezado()
		
				SELECT cartera
				LOCATE
				lnCantidadDatos=RECCOUNT("cartera")
				Fila=10
				thisform.progreso.Visible= .T.
				FOR lnI = 1 TO lnCantidadDatos
				   	xini = "A"+ALLTRIM(STR(Fila))
				   	xfin = "I"+ALLTRIM(STR(Fila))
				   	rango= '"'+xini+':'+xfin+'"'
				   	XLSheet.range(&rango).Font.Size = "10"
				   	WITH XLSheet.RANGE(&rango)
					    .Borders(1).LineStyle = 1
					    .Borders(1).Weight = 2
					    .Borders(2).LineStyle = 1
					    .Borders(2).Weight = 2
					    .Borders(3).LineStyle = 1
					    .Borders(3).Weight = 2
					    .Borders(4).LineStyle = 1
					    .Borders(4).Weight = 2
					ENDWITH
					XLSheet.Cells(Fila,1)=cartera.tipo
				   	XLSheet.Cells(Fila,1).HorizontalAlignment=-4131				
					XLSheet.Cells(Fila,2)=cartera.chequenro
				   	XLSheet.Cells(Fila,2).HorizontalAlignment=-4108
				   	IF LEN(ALLTRIM(cartera.chequenro))>0
						XLSheet.Range(XLSheet.Cells(7,7),XLSheet.Cells(7,9)).font.bold=.T.
						XLSheet.Cells(Fila,3)=cartera.bcocaja
						XLSheet.Cells(Fila,3).HorizontalAlignment=-4131
					   	XLSheet.Cells(Fila,4)=cartera.bolnro
					   	XLSheet.Cells(Fila,4).HorizontalAlignment=-4108
					   	XLSheet.Cells(Fila,5)=cartera.fechadep
					   	XLSheet.Cells(Fila,5).HorizontalAlignment=-4108
					   	XLSheet.Cells(Fila,6)=cartera.procedencia
					   	XLSheet.Cells(Fila,7)=cartera.banco
				   	ENDIF
				  	XLSheet.Cells(Fila,8)=cartera.plaza
					XLSheet.Cells(Fila,9)=cartera.importe
					IF LEN(ALLTRIM(cartera.chequenro))=0
						XLSheet.Cells(Fila,8).HorizontalAlignment=-4152
						XLSheet.Range(XLSheet.Cells(Fila,8),XLSheet.Cells(Fila,9)).font.bold=.T.
						XLSheet.Range(XLSheet.Cells(Fila,8),XLSheet.Cells(Fila,9)).font.size=11
						XLSheet.Range(XLSheet.Cells(Fila,1),XLSheet.Cells(Fila,9)).Borders(3).LineStyle = 1
						XLSheet.Range(XLSheet.Cells(Fila,1),XLSheet.Cells(Fila,9)).Borders(3).Weight = 3
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Interior.Color= RGB(198,224,180)
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Borders(1).LineStyle = 1
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Borders(1).Weight = 3
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Borders(2).LineStyle = 1
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Borders(2).Weight = 3
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Borders(4).LineStyle = 1
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Borders(4).Weight = 3
						XLSheet.Range(XLSheet.Cells(Fila,1),XLSheet.Cells(Fila,6)).Borders(1).LineStyle = 0
						XLSheet.Range(XLSheet.Cells(Fila,1),XLSheet.Cells(Fila,6)).Borders(2).LineStyle = 0
					ENDIF
					XLSheet.Cells(Fila,9).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
				   	Fila=Fila+1
					lnPorcentaje            = lnI * 100 / lnCantidadDatos
				    ThisForm.Progreso.Value = lnPorcentaje
				    skip		   	
				ENDFOR
				Fila=Fila-1
				XLSheet.Range(XLSheet.Cells(Fila,1),XLSheet.Cells(Fila,6)).Borders(4).LineStyle = 0
				Fila=Fila+1
				thisform.excelfooter(Fila)
				thisform.progreso.Visible= .F.
				XLApp.visible=.T.
				XLApp.WindowState = -4137
				DECLARE LONG BringWindowToTop IN "user32" LONG HWND
				BringWindowToTop(XLApp.HWND)
				_screen.mousepointer=0
			ENDIF
		ENDIF
		*!*	ENDIF
		
	ENDPROC


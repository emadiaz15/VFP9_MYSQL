		*!*	ENDIF
		*!*	thisform.txt_total.Value=totales
		*!*	thisform.lbl_impotot.Caption='IMPORTE TOTAL DE CHEQUES FISICOS:'
		*!*	thisform.lbl_totcheq.Caption='SE DEPOSITARON '+ALLTRIM(STR(contot))+' CHEQUES FISICOS'

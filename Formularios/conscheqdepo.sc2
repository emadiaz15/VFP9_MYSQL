		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE btn_buscar1.img_buscar.Click
		thisform.txt_find.Value=''
		thisform.xtipo=0
		IF thisform.txt_find.Visible= .F.
			
			IF thisform.opt_estado.Value=1
				lnOption = MsgboxEx(;
				   "Debe seleccionar el tipo: Cheque / Echeq." + ;
				   chr(13) + chr(13) + "Que desea consultar?", ;
				   "?", ;
				   "Consulta Numérica", ;
				   "&Cheque,&Echeq,Ca&ncelar")
				 DO case
					 CASE lnOption = 1
					 	thisform.xtipo=1
					 	thisform.txt_find.Format="R"
					 	thisform.txt_find.InputMask="999-999-99999999"
			 		    thisform.txt_find.Visible= .T.
					 	thisform.txt_find.SetFocus
					 CASE lnOption = 2
					 	thisform.xtipo=2
					 	thisform.txt_find.Format=""
					 	thisform.txt_find.InputMask=""
			 		    thisform.txt_find.Visible= .T.
					 	thisform.txt_find.SetFocus
				 ENDCASE
			ELSE
				DO case
					CASE thisform.opt_estado.Value = 2
					 	thisform.xtipo=1
					 	thisform.txt_find.Format="R"
					 	thisform.txt_find.InputMask="999-999-99999999"
			 		    thisform.txt_find.Visible= .T.
					 	thisform.txt_find.SetFocus			
					CASE thisform.opt_estado.value = 3
					 	thisform.xtipo=2
					 	thisform.txt_find.Format=""
					 	thisform.txt_find.InputMask=""
			 		    thisform.txt_find.Visible= .T.
					 	thisform.txt_find.SetFocus			
				ENDCASE
			ENDIF
			
		else	
			thisform.txt_find.Visible= .F.
			thisform.grd_cheques.SetFocus
		ENDIF
		
	ENDPROC


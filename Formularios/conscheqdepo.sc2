	PROCEDURE txt_fecdes.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_fechas.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_find.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE txt_find.LostFocus
		IF LASTKEY()=13
			LOCAL xcadecheq,chnro
			if len(allt(this.value))>0
				IF thisform.xtipo=1
					chnro="CHEQUE"+ALLTRIM(this.value)
				ELSE
					chnro="ECHEQ"+ALLTRIM(this.value)
				ENDIF
				SELECT chequenro,DTOC(fecha) as fecha,RTRIM(STR(importe,15,2)) as importe,ALLTRIM(procedencia) as procedencia,ALLTRIM(chid) as chid, ;
					ALLTRIM(STR(recpag_codi)) as recpag_codi FROM cartera WHERE ALLTRIM(tipo)+ALLTRIM(chequenro)=chnro AND LEN(ALLTRIM(chequenro))>0 INTO CURSOR mascheq
				DO case
					CASE RECCOUNT("mascheq")>1
						thisform.shp_mascheq.Visible= .T.
						thisform.shp_mascheq.ZOrder(0)
						thisform.lbl_mascheq.Visible= .T.
						thisform.lbl_mascheq.ZOrder(0)
						thisform.lst_mascheq.Visible= .T.
						thisform.lst_mascheq.ZOrder(0)
						thisform.lst_mascheq.RowSource='mascheq'
					CASE RECCOUNT("mascheq")=1
						SELECT cartera
						GO top
						IF thisform.xtipo=3
							LOCATE FOR ALLTRIM(tipo)+ALLTRIM(chequenro)=chnro
						ELSE
							LOCATE FOR ALLTRIM(tipo)+ALLTRIM(chequenro)=chnro
						ENDIF
						IF FOUND()
							thisform.grd_cheques.setfocus
						else
							=messagebox("No se encontró el cheque",0+48,"Advertencia!!!")
							GO TOP IN cartera
							this.value=''
							this.SetFocus
							NODEFAULT
						ENDIF
					CASE RECCOUNT("mascheq")=0
						=messagebox("No se encontró el cheque",0+48,"Advertencia!!!")
						GO TOP IN cartera
						this.value=''
						this.SetFocus
						NODEFAULT
				ENDCASE
			ENDIF
		ELSE
			this.SetFocus
			nodefault
		ENDIF
		
	ENDPROC

	PROCEDURE txt_impdes.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_impdes.LostFocus
		IF this.Value<>thisform.ximpdes
			thisform.chk_impo.Value=0
		ENDIF
	ENDPROC

	PROCEDURE txt_imphas.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_imphas.LostFocus
		IF this.Value<>thisform.ximphas
			thisform.chk_impo.Value=0
		ENDIF
	ENDPROC

ENDDEFINE


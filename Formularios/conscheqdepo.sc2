		*!*	ENDIF
	ENDPROC

	PROCEDURE grd_cheques.Column2.Text1.DblClick
		*!*	IF cartera.recpag_codi>0
		*!*		do form conscheqrap with ALLTRIM(cartera.chequenro),ALLTRIM(cartera.chid)
		*!*	ENDIF
	ENDPROC

	PROCEDURE lst_mascheq.Click
		SELECT cartera
		GO top
		*!*	LOCATE FOR chequenro=mascheq.chequenro AND chid=mascheq.chid
		
		LOCATE FOR recpag_codi=VAL(mascheq.recpag_codi)
		
		this.Visible= .F.
		this.ZOrder(1)
		thisform.shp_mascheq.Visible= .F.
		thisform.shp_mascheq.ZOrder(1)
		thisform.lbl_mascheq.Visible= .F.
		thisform.lbl_mascheq.ZOrder(1)
		
		thisform.grd_cheques.setfocus
	ENDPROC

	PROCEDURE opt_estado.Option1.Click
		*!*	LOCAL totmes,totales,concheq,contot
		*!*	STORE 0 TO totmes,totales,cadena,concheq,contot
		*!*	STORE 0 TO thisform.venci,thisform.hoy,thisform.man
		*!*	SELECT cartera
		*!*	SET SAFETY OFF
		*!*	ZAP
		*!*	SET SAFETY ON
		*!*	thisform.grd_cheques.RecordSource=''
		*!*	thisform.grd_cheques.Refresh()
		*!*	thisform.btn_print.Enabled= .F.
		*!*	frmconche= conectar_db(_screen.cn)
		*!*		SQLEXEC(frmconche,"call usp_cheqdep(0);","cheqdep")
		*!*	desconectar_db(frmconche)
		*!*	totmes=0
		*!*	concheq=0
		*!*	IF RECCOUNT("cheqdep")>0
		*!*		thisform.btn_print.Enabled= .T.
		*!*		GO top
		*!*		DO case
		*!*			CASE thisform.xcodicli<>99999999
		*!*				SELECT * FROM cheqdep WHERE cli_codi = thisform.xcodicli INTO CURSOR cheqdep
		*!*			CASE thisform.codibank<>99999999
		*!*				SELECT * FROM cheqdep WHERE banc_codi = thisform.codibank INTO CURSOR cheqdep
		*!*			CASE thisform.txt_impdes.Value<>0 OR thisform.txt_imphas.Value<>99999999
		*!*				SELECT * FROM cheqdep WHERE movtippag_imp between thisform.txt_impdes.Value AND thisform.txt_imphas.Value INTO CURSOR cheqdep
		*!*		ENDCASE
		*!*		GO top
		*!*		
		*!*		SCAN
		*!*			totmes=0
		*!*			concheq=0
		*!*			cadena=ALLTRIM(STR(MONTH(cheqdep.dep_fech)))+ALLTRIM(STR(YEAR(cheqdep.dep_fech)))
		*!*			DO WHILE ALLTRIM(STR(MONTH(cheqdep.dep_fech)))+ALLTRIM(STR(YEAR(cheqdep.dep_fech)))=cadena
		*!*				INSERT INTO cartera(tipo,chequenro,bcocaja,bolnro,fechadep,procedencia,banco,plaza,importe,recpag_codi,activo,chid,dep_codi) ;
		*!*							VALUES (IIF(cheqdep.tippag_codi=3,'CHEQUE','ECHEQ'),cheqdep.chequenro,cheqdep.banc_desc, ;
		*!*									ALLTRIM(cheqdep.dep_bolnro),cheqdep.dep_fech,cheqdep.cli_nomb,cheqdep.ban_desc, ;
		*!*									cheqdep.movtippag_pza,cheqdep.movtippag_imp,cheqdep.recpag_codi,cheqdep.activo,cheqdep.cheqid,cheqdep.dep_codi)
		*!*				totmes=totmes+cheqdep.movtippag_imp
		*!*				concheq=concheq+1
		*!*				SKIP
		*!*			ENDDO
		*!*			SKIP-1
		*!*			contot=contot+concheq
		*!*			totales=totales+totmes
		*!*			cadplaza=ALLTRIM('TOT. '+UPPER(Mes_Nombre(MONTH(cheqdep.dep_fech)))+' '+ALLTRIM(STR(YEAR(cheqdep.dep_fech)))+'('+ALLTRIM(STR(concheq))+')')
		*!*			INSERT INTO cartera(plaza,importe,recpag_codi) ;
		*!*						VALUES (cadplaza,totmes,0)
		*!*		ENDSCAN
		*!*		GO TOP IN cartera
		*!*		thisform.grd_cheques.RecordSource="cartera"
		*!*		thisform.grd_cheques.SetAll("DynamicFontName","IIF(cartera.recpag_codi=0,'Arial Black','Tahoma')","Column")
		*!*	ENDIF
		*!*	thisform.txt_total.Value=totales
		*!*	thisform.lbl_impotot.Caption='IMPORTE TOTAL:'  
		*!*	thisform.lbl_totcheq.Caption='SE DEPOSITARON '+ALLTRIM(STR(contot))+' CHEQUES EN TOTAL'
		*!*	thisform.cantcheq= contot
		*!*	IF thisform.txt_find.Visible= .T.
		*!*		thisform.txt_find.Visible= .F.
		*!*		thisform.txt_find.Value=''
		*!*	ENDIF
		
	ENDPROC


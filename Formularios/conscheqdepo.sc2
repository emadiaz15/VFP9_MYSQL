	PROCEDURE Activate
		IF RECCOUNT("cheqdep")=0 AND thisform.estadoinicio=.T.
			MESSAGEBOX("No se encontraron registro de Cheques/Echeqs depositados en cuentas propias.",64,"Aviso del Sistema")
			thisform.estadoinicio=.F.
		ENDIF
		
	ENDPROC

	PROCEDURE colorestado
		LPARAMETERS tnEstado
		
		LOCAL lnColor
		
			IF tnEstado='N'
				tnColor=RGB(255,0,0)
			ELSE
				tnColor=RGB(0,0,0)
			ENDIF
		
		return(lnColor)	
	ENDPROC

	PROCEDURE colorfondo
		LPARAMETERS tnFecha,tnCodi
		
		LOCAL lnColor
		
			DO CASE
				CASE tnFecha=DATE() AND tnCodi>0
					lnColor=RGB(225,0,0)
				CASE tnFecha=DATE()+1 AND tnCodi>0
					lnColor=RGB(0,0,0)
				CASE tnFecha>DATE()+1 AND tnCodi>0
					lnColor=RGB(255,255,255)
				CASE tnFecha<DATE() AND tnCodi>0
					lnColor=RGB(128,255,128)
			ENDCASE
		
		return(lnColor)	
	ENDPROC

	PROCEDURE Destroy
		SET POINT TO
		SET SEPARATOR TO
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE excelencabezado
		Xlsheet.cells(1,9)=ALLTRIM(thisform.empresa)
		XLSheet.Cells(1,9).font.bold=.T.
		XLSheet.Cells(1,9).font.size="12"
		XLSheet.Cells(1,9).font.name="Courier New"
		XLSheet.Cells(1,9).HorizontalAlignment=-4152
		
		Xlsheet.cells(3,9)='Fecha Actual: '+ALLTRIM(DTOC(DATE()))
		XLSheet.Cells(3,9).font.bold=.T.
		XLSheet.Cells(3,9).font.size="11"
		XLSheet.Cells(3,9).font.name="Courier New"
		XLSheet.Cells(3,9).HorizontalAlignment=-4152
		
		XLSheet.range("C5:H5").merge

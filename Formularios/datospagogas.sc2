	PROCEDURE Activate
		*!*	if prompt()="Pagos de Clientes"
		*!*		thisform.check1.enabled=.T.
		*!*	endif
		
		if impotot-totval<=0
			thisform.command4.setfocus
		endif
	ENDPROC

	PROCEDURE Destroy
		if coditipag=2
			set currency to
		endif
	ENDPROC

	PROCEDURE GotFocus
		
		
	ENDPROC

	PROCEDURE Init
		parameter coditipag,numero,banco,plaza,fechavto,valor,totval,impotot,cuit,dxp,dxpo,dtotot,porcdesc,rpgcodi,rpgcodig
		public codiban,valorcheq,nitem,nalo
		nalo=.F.
		nitem=0
		with thisform
			.text8.value=dxp
			.text9.value=dxpo
			.text10.value=dtotot
			.text6.value=0
			if paso=1
				.text2.value=numero
				.text3.value=banco
				.text4.value=plaza
				.text5.value=fechavto
			endif
			.text18.value=impotot
			if impotot=0
				.text8.enabled=.F.
				.text9.enabled=.F.
			endif
			.text19.value=totval
			.text20.value=.text18.value-.text19.value
			.text6.value=.text18.value-.text19.value
			IF .text20.value<=0
				.command4.enabled= .T.
			ENDIF
			frmdatpp= conectar_db(_screen.cn)
				SQLEXEC(frmdatpp,"select ban_desc,ban_codi from bancos order by ban_desc;","cur_bce")
			desconectar_db(frmdatpp)
			IF RECCOUNT("cur_bce")>0
				LOCATE
				thisform.lstincremental1.pcursor="cur_bce"
				thisform.lstincremental1.pcampo="ban_desc"
				thisform.lstincremental1.pcampo2="ban_codi"
			ENDIF
		endwith
	ENDPROC

	PROCEDURE limpiartextos
		thisform.text1.Value=''
		thisform.text2.Value=''
		thisform.text3.Value=''
		thisform.text4.Value=''
		thisform.text7.Value=''
		thisform.text5.value=ctod("  /  /    ")
	ENDPROC

	PROCEDURE Unload
		return coditipag
		return numero
		return banco
		return plaza
		return fechavto
		return valor
		return totval
		return cuit
		return dxp
		return dxpo
		return dtotot
		return porcdesc
		return rpgcodig
	ENDPROC

	PROCEDURE Clstextinput1.txtInput.InteractiveChange
		n = LEN(ALLTRIM(this.Value))
		IF n >= this.Parent.penterchar
			thisform.lstincremental1.pinput = ALLTRIM(this.Value)
			thisform.lstincremental1.listcursor()
			thisform.lstincremental1.Visible= .T.
			IF USED("crlistincremental")
				IF RECCOUNT("crlistincremental")=0
					thisform.lstincremental1.Visible= .F.
				ENDIF
			ENDIF	
		ELSE
			thisform.lstincremental1.Visible   = .F.
			thisform.lstincremental1.RowSource = ""
			IF USED("crlistincremental")
				USE IN crlistincremental
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_newbank.Click
		IF thisform.codiban=0
			thisform.clstextinput1.txtInput.Value=''
			thisform.lstincremental1.RowSource=""
			thisform.lstincremental1.Visible= .F.
		ENDIF
		
		codiban=0
		codisuc=0
		do form altabanco with codiban,codisuc,2
		
		IF codiban > 0
			frmdatpp= conectar_db(_screen.cn)
				SQLEXEC(frmdatpp,"select * from bancos where ban_codi = ?codiban;","cur_nvoban")
			desconectar_db(frmdatpp)
			IF RECCOUNT("cur_nvoban")>0
				thisform.clstextinput1.txtInput.Value=cur_nvoban.ban_desc
				thisform.codiban=cur_nvoban.ban_codi
				thisform.text7.SetFocus
			ELSE
				thisform.clstextinput1.txtInput.Value=''
				thisform.clstextinput1.txtInput.SetFocus
			ENDIF
		ELSE
			thisform.clstextinput1.txtInput.Value=''
			thisform.clstextinput1.txtInput.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			if .text6.value>0
				numero=.text2.value
				banco=IIF(coditipag=20,IIF(p=7,ALLTRIM(thisform.clstextinput1.txtInput.value),allt(.text3.value)),allt(.text3.value))
				**thisform.codiban>0
				plaza=.text4.value
				fechavto=.text5.value
				valor=.text6.value
				if coditipag=3 OR coditipag=20
					cuit=.text7.value
				else
					cuit=0
				endif
				totval=totval+valor
				iif(.check1.value=1,nalo=.T.,nalo=.F.)
				idcheq=IIF(coditipag=20,ALLTRIM(STR(thisform.codiban)),thisform.ncheqid)
				this.Enabled= .F.
				thisform.release
			endif
		endwith
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		coditipag=0
		do form tipagselec with coditipag
		if coditipag>0
			frmdatpp= conectar_db(_screen.cn)
				SQLEXEC(frmdatpp,"select * from tipospago where tippag_codi=?coditipag;","cur_tpp")
			desconectar_db(frmdatpp)
			if coditipag=1
				thisform.limpiartextos()
				thisform.text1.value=cur_tpp.tippag_desc
				thisform.text6.Style= 0
				thisform.text6.setfocus
			else
				if coditipag=2
					set currency to "u$s"
				else
					set currency to "$"
				ENDIF
				thisform.text1.value=cur_tpp.tippag_desc
				if coditipag<>3 and coditipag<>9 and coditipag<>11
					with thisform
						.text3.enabled=.F.
						.text4.enabled=.F.
						.text5.enabled=.F.
					endwith
				else
					with thisform
						.text3.enabled=.T.
						.text4.enabled=.T.
						.text5.enabled=.T.
					endwith
				endif
				if coditipag=3
					if prompt()="Pagos a Proveedores"
						p=messagebox("¿Abona con cheque de caja?",4+32+256,"Cheques")
						if p=6
							thisform.text7.enabled=.T.
							valorcheq=impotot-totval
							do form chequesdisp with numero,banco,plaza,fechavto,valor,cuit,valorcheq
							if len(allt(numero))>0
								thisform.text2.value=numero
								thisform.text3.value=banco
								thisform.text4.value=plaza
								thisform.text5.value=fechavto
								thisform.text6.value=valor
								thisform.text7.value=cuit
								thisform.text2.style=1
								thisform.text3.style=1
								thisform.text4.style=1
								thisform.text7.style=1
								thisform.text5.style=1
								thisform.text6.style=1						
								thisform.command1.setfocus
							ELSE
								thisform.command2.setfocus
								thisform.text1.value=''					
								thisform.text7.value=cuit					
							endif
						else
							frmdatpp= conectar_db(_screen.cn)
								SQLEXEC(frmdatpp,"select * from parametros where TRIM(param_desc)='CUIT';","cur_cuipro")
							desconectar_db(frmdatpp)
							cuit=cur_cuipro.param_impo
							thisform.text7.value=cuit
						endif
					else
						thisform.check1.enabled=.T.
						thisform.text7.enabled=.T.
						thisform.text7.value=cuit
					endif
				else
					thisform.text7.enabled=.F.
					if prompt()="Pagos a Proveedores"
						if coditipag=13 and matfac>0
							do form selecfac with matcli,impotot,totval,matcom
						endif
					endif
				endif
				thisform.text2.setfocus
			endif
		else
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		do case
			case prompt()="Pagos de Clientes"
				with pagocliente
					do form itemmodifpag with nitem
					do while nitem>.olecontrol1.rows-1
						messagebox("El número de item ingresado no existe.",0+48,"Advertencia")
						do form itemmodifpag with nitem
					enddo
					.olecontrol1.row=nitem
					.olecontrol1.col=0
					thisform.text1.value=allt(.olecontrol1.text)
					.olecontrol1.col=1
					thisform.text2.value=allt(.olecontrol1.text)
					.olecontrol1.col=2
					thisform.text7.value=val(subst(allt(.olecontrol1.text),1,2)+subst(allt(.olecontrol1.text),4,8)+right(allt(.olecontrol1.text),1))
					.olecontrol1.col=3
					thisform.text3.value=allt(.olecontrol1.text)
					.olecontrol1.col=4
					thisform.text4.value=allt(.olecontrol1.text)
					.olecontrol1.col=5
					thisform.text5.value=ctod(.olecontrol1.text)
					.olecontrol1.col=6
					thisform.text6.value=ConverNro(.olecontrol1.text)
					totval=totval-thisform.text6.value
					thisform.text2.setfocus
					paso=1
				endwith			
			case prompt()="Pagos a Proveedores"
		endcase
	ENDPROC

	PROCEDURE Command4.Click
		preg=messagebox("¿Confirma los medios de pago ingresados?",4+48+256,"Pagos de Clientes")
		
		if preg=6
			confirma="S"
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command5.Click
		with thisform
			LOCAL xtexab,xtipo
			xtexab=""
			xtipo=0
			coditipag=0
			thisform.codiban=0
			thisform.limpiartextos()
			.text6.value=.text18.value-.text19.value
			do form tipagselec with coditipag
			if coditipag>0
				thisform.command1.Enabled= .T.
				frmdatpp= conectar_db(_screen.cn)
					SQLEXEC(frmdatpp,"select * from tipospago where tippag_codi=?coditipag;","cur_tpp")
				desconectar_db(frmdatpp)
				if coditipag=1
					.text1.value=cur_tpp.tippag_desc
					thisform.text6.Style= 0
					thisform.ncheqid=''
					.text6.setfocus
				else
					if coditipag=2
						set currency to "u$s"
					endif
					.text1.value=cur_tpp.tippag_desc
					.text6.value=impotot-totval
					if coditipag<>3 and coditipag<>9 and coditipag<>11
						.text3.enabled=.F. 
						.text4.enabled=.F.
						.text5.enabled=.F.
					endif
					if coditipag<>3 AND coditipag<>20
						.text7.enabled=.F.
						thisform.ncheqid=''
						thisform.check1.enabled=.F.
						if coditipag=13 and matfac>0
							codicli=cur_cuit.cli_codi
							do form selecfac with codicli,impotot,totval
							if matcom>0
								thisform.release
							endif
						endif
					ELSE
						.text2.Inputmask=ICASE(coditipag=3,"999-999-99999999",coditipag=20,"")
						.text2.format=ICASE(coditipag=3,"R",coditipag=20,"")
						xtexab = ICASE(coditipag=3,"¿Abona con cheque de caja?",coditipag=20,"¿Abona con echeq disponible?")
						p=messagebox(xtexab,4+32+256,"Tipos de pago")
						if p=6
							valorcheq=impotot-totval
							xtipo=ICASE(coditipag=3,1,coditipag=20,2)
							do form chequesdisp with numero,banco,plaza,fechavto,valor,cuit,valorcheq,rpgcodi,rpgcodig,xtipo
							if len(allt(numero))>0
								.text2.value=numero
								.text3.value=banco
								.text4.value=plaza
								.text5.value=fechavto
								.text6.value=valor
								.text7.value=cuit
								.text2.style=1
								.text3.style=1
								.text4.style=1
								.text7.style=1
								.text5.style=1
								.text6.style=1
								IF coditipag=20
									thisform.codiban=VAL(idcheq)
								ELSE
									thisform.ncheqid=idcheq
								ENDIF
								.command1.setfocus
							ELSE
								.command2.setfocus
								.text1.value=''
								.text7.value=cuit
							endif
						ELSE
							frmdatpp= conectar_db(_screen.cn)
								SQLEXEC(frmdatpp,"select * from parametros where TRIM(param_desc)='CUIT';","cur_cuipro")
							desconectar_db(frmdatpp)
							cuit=cur_cuipro.param_impo
							.text7.value=cuit
							IF coditipag = 20
								.text3.visible=.F.
								.text4.enabled=.F.
								thisform.clstextinput1.Visible= .T.
								thisform.cmd_newbank.Visible= .T.
								thisform.clstextinput1.ZOrder(0)
								thisform.lstincremental1.ZOrder(0)
								thisform.ncheqid=''
								.text5.enabled=.T.
								thisform.text2.SetFocus
							ELSE
								thisform.clstextinput1.ZOrder(1)
								thisform.lstincremental1.ZOrder(1)
								thisform.clstextinput1.Visible= .F.
								thisform.cmd_newbank.Visible= .F.
								thisform.lstincremental1.Visible= .F.
								.text3.visible=.T.
								.text3.enabled=.F.
								.text4.enabled=.F.
								.text5.enabled=.F.
								thisform.text2.SetFocus
							ENDIF
						endif
					endif
					.text2.setfocus
				endif
			endif
		endwith
	ENDPROC

	PROCEDURE Command6.Click
		confirma="S"
		cancelado="S"
		dxp=0
		dxpo=0
		thisform.release
	ENDPROC

	PROCEDURE Command6.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command6.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Lstincremental1.Click
		IF this.ListCount>0
			IF USED("crlistincremental")
				SELECT crlistincremental
				thisform.clstextinput1.txtInput.Value=crlistincremental.ban_desc
				thisform.codiban = crlistincremental.ban_codi
				this.Visible = .F.
				thisform.text7.SetFocus
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.LostFocus
		LOCAL xcheque,xconf,registra
		STORE 'N' TO xconf,registra
		if last()<>13
		*!*		this.setfocus
			nodefault
		else
			if coditipag=3
				local texban,texsuc,cadesuc,busban
				if len(allt(this.value))>0
					if len(allt(this.value))<14
						messagebox("Número de cheque incorrecto. Verifique bien por favor.",0+48,"Advertencia")
						nodefault
						this.setfocus
					else
						frmdatpp= conectar_db(_screen.cn)
							SQLEXEC(frmdatpp,"select * from pagosprov_pagos where TRIM(chequenro)=?ALLTRIM(this.value);","cur_chepro")
						desconectar_db(frmdatpp)
						if RECCOUNT("cur_chepro")>0
							xcheque=ALLTRIM(this.value)
							DO FORM habiacheqpro WITH xcheque,xconf TO xvar1				
							IF xvar1.prop2='S'
								thisform.ncheqid=RIGHT('0000'+ALLTRIM(STR((RECCOUNT("cur_chepro"))+1)),4)
								registra='S'
							ELSE
								this.Value=''
								NODEFAULT												
							ENDIF
						ELSE
							thisform.ncheqid='0001'
							registra='S'				
						ENDIF
						
						IF registra='S'
							cadesuc=allt(subst(this.value,1,3))+allt(subst(this.value,4,3))
							frmdatpp= conectar_db(_screen.cn)
								SQLEXEC(frmdatpp,"select a.*,b.ban_desc from sucbancos a inner join bancos b on a.ban_codi=b.ban_codi where a.suc_bansuc=?cadesuc;","cur_sucu")
							desconectar_db(frmdatpp)
							if RECCOUNT("cur_sucu")>0
								thisform.text3.value=cur_sucu.ban_desc
								thisform.text4.value=cur_sucu.suc_nomb
							ELSE
								busban=val(subst(allt(this.value),1,3))
								frmdatpp= conectar_db(_screen.cn)
									SQLEXEC(frmdatpp,"select * from bancos where ban_codi=?busban;","cur_banlo")
								desconectar_db(frmdatpp)
								if RECCOUNT("cur_banlo")>0
									pregunta=messagebox("Sucursal Nº: "+subst(allt(this.value),4,3)+" de "+allt(cur_banlo.ban_desc)+" no está en archivo. ¿Ingresa nueva Sucursal?",4+32+256,"Cobranzas")
									if pregunta=6
										codiban=cur_banlo.ban_codi
										codisuc=0
										do form altasuc with codiban,codisuc
										thisform.text3.value=cur_banlo.ban_desc
										cadesuc=allt(str(codiban))+allt(str(codisuc))
										frmdatpp= conectar_db(_screen.cn)
											SQLEXEC(frmdatpp,"select * from sucbancos where suc_bansuc=?cadesuc;","cur_sucu")
										desconectar_db(frmdatpp)
										thisform.text4.value=allt(cur_sucu.suc_nomb)
									else
										this.value=""
										nodefault
										this.setfocus
									endif
								else
									pregunta=messagebox("Banco Nº: "+subst(allt(this.value),1,3)+" no está en archivo. ¿Ingresa nuevo Banco?",4+32+256,"Cobranzas")
									if pregunta=6
										codiban=0
										codisuc=0
										do form altabanco with codiban,codisuc
										if codiban>0
											frmdatpp= conectar_db(_screen.cn)
												SQLEXEC(frmdatpp,"select * from bancos where ban_codi=?codiban;","cur_banlo")
											desconectar_db(frmdatpp)
											if RECCOUNT("cur_banlo")>0
												cadesuc=allt(str(codiban))+allt(str(codisuc))
												frmdatpp= conectar_db(_screen.cn)
													SQLEXEC(frmdatpp,"select a.*,b.ban_desc from sucbancos a inner join bancos b on a.ban_codi=b.ban_codi where a.suc_bansuc=?cadesuc;","cur_sucu")
												desconectar_db(frmdatpp)
												if RECCOUNT("cur_sucu")>0
													thisform.text3.value=cur_sucu.ban_desc
													thisform.text4.value=allt(cur_sucu.suc_nomb)
												else
													pregunta=messagebox("Aún no ha ingresado ninguna sucursal para "+allt(cur_banlo.ban_desc)+". ¿Ingresa nueva Sucursal?",4+32+256,"Cobranzas")
													if pregunta=6
														do form altasuc with codiban,codisuc
														thisform.text3.value=cur_banlo.ban_desc
														cadesuc=allt(str(codiban))+allt(str(codisuc))
														frmdatpp= conectar_db(_screen.cn)
															SQLEXEC(frmdatpp,"select * from sucbancos where suc_bansuc=?cadesuc;","cur_sucu")
														desconectar_db(frmdatpp)
														thisform.text4.value=allt(cur_sucu.suc_nomb)
													else
														this.value=""
														nodefault
														this.setfocus
													endif
												endif
											endif
										else
											this.value=""
											nodefault
											this.setfocus
										endif
									else
										this.value=""
										nodefault
										this.setfocus
									endif				
								endif	
							endif
						endif
					endif
				ENDIF
			ELSE
				IF coditipag=20
					thisform.clstextinput1.txtInput.SetFocus
				ENDIF		
			endif
		endif
		
	ENDPROC

	PROCEDURE Text3.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text3.GotFocus
		codiban=0
		do form bancoload with codiban
		if codiban>0
			sele bancos
			set order to ban_codi
			seek codiban
			this.value=ban_desc
			thisform.text4.setfocus
		endif
	ENDPROC

	PROCEDURE Text4.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text5.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text6.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text6.Valid
		*!*	if totval+this.value>impotot
		*!*		preg=messagebox("Excede el importe. ¿Le dió vuelto al Cliente?",4+48+256,"Advertencia")
		*!*		if preg=7
		*!*			this.value=impotot-totval
		*!*			return 0
		*!*		else
		*!*			impotot=impotot-this.value
		*!*		endif
		*!*	endif
	ENDPROC

	PROCEDURE Text7.When
		IF coditipag=3 AND LEN(ALLTRIM(thisform.text2.value))=0
			KEYBOARD '{LEFTARROW}'
		ENDIF
		
	ENDPROC

	PROCEDURE Text8.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text8.GotFocus
		dxp=this.value
		this.setfocus
		
	ENDPROC

	PROCEDURE Text8.LostFocus
		with thisform
			if this.value>0
				.text19.value=0
				totval=totval-dtotot
				.text9.value=0
				.text10.value=this.value
				totval=totval+this.value
				.text19.value=totval
				.text20.value=.text18.value-.text19.value
				dxp=this.value
			else
				if dxp>0 and this.value=0
					totval=totval-dtotot
					.text10.value=0
					.text19.value=totval
					.text20.value=.text18.value-.text19.value
					dxp=0
				endif
			endif
			dtotot=.text10.value
			porcdesc=round(.text10.value/.text18.value,2)*100
			IF .text20.value<=0
				.command4.enabled= .T.
				.command4.setfocus
			ELSE
				.command5.setfocus
			ENDIF
		endwith
			
	ENDPROC

	PROCEDURE Text9.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text9.GotFocus
		dxpo=this.value
		this.setfocus
	ENDPROC

	PROCEDURE Text9.LostFocus
		with thisform
			if this.value>0 and this.value<=100
				totval=totval-dtotot
				.text19.value=0
				.text8.value=0
				.text10.value=round((impotot*this.value)/100,2)
				totval=totval+.text10.value
				.text19.value=totval
				.text20.value=.text18.value-.text19.value
				dxpo=this.value
			else
				if dxpo>0 and this.value=0
					totval=totval-dtotot
					.text10.value=0
					.text19.value=totval
					.text20.value=.text18.value-.text19.value
					dxpo=0
				endif
			endif
			dtotot=.text10.value
			porcdesc=this.value
			IF .text20.value<=0
				.command4.enabled= .T.
				.command4.setfocus
			ELSE
				.command5.setfocus
			ENDIF
		endwith
	ENDPROC

	PROCEDURE Text9.Valid
		if this.value>100
			messagebox("El porcentaje no puede ser mayor al 100%",0+48,"Advertencia")
			this.value=0
			return 0
		endif
	ENDPROC

ENDDEFINE

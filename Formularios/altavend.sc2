DEFINE CLASS altavend AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 191,196,162
		BorderStyle = 0
		Caption = "Alta de Vendedores"
		DoCreate = .T.
		Height = 153
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "altavend"
		Width = 432
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Aceptar", ;
		DisabledBackColor = 33,146,214, ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 163, ;
		Name = "Command1", ;
		TabIndex = 3, ;
		Themes = .F., ;
		Top = 108, ;
		Width = 92
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 191,196,162, ;
		Caption = "Número asignado:", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 11, ;
		Name = "Label1", ;
		TabIndex = 5, ;
		Top = 27, ;
		Width = 105
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label2' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 191,196,162, ;
		Caption = "Nombre del Vendedor:", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 12, ;
		Name = "Label2", ;
		TabIndex = 4, ;
		Top = 65, ;
		Width = 128
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Text1' AS textbox WITH ;
		Alignment = 2, ;
		BackColor = 218,218,218, ;
		Height = 23, ;
		Left = 150, ;
		Name = "Text1", ;
		Style = 1, ;
		TabIndex = 1, ;
		Top = 20, ;
		Width = 45
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text2' AS textbox WITH ;
		Format = "!K", ;
		Height = 23, ;
		Left = 150, ;
		Name = "Text2", ;
		TabIndex = 2, ;
		Top = 60, ;
		Width = 258
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		parameter vcodi
		LOCAL lnLock
		lnLock = 0
		frmaltaven= conectar_db(_screen.cn)
			lnLock = MySQL_LockTables("LOCK", "vendedores WRITE", frmaltaven)
			SQLEXEC(frmaltaven,"select ven_codi from vendedores order by ven_codi desc limit 1;","cur_nuecv")
			lnLock = MySQL_LockTables("UNLOCK", "", frmaltaven)
		desconectar_db(frmaltaven)
		vcodi=cur_nuecv.ven_codi+1
		this.text1.value=vcodi
	ENDPROC

	PROCEDURE Unload
		return vcodi
	ENDPROC

	PROCEDURE Command1.Click
		if len(allt(thisform.text2.value))>0
			preg=messagebox("¿Confirma el alta de este Vendedor?",4+48+256,"Alta de Vendedores")
			if preg=6
				LOCAL xcodiv,xnomv
				xcodiv=thisform.text1.value
				xnomv=allt(thisform.text2.value)
				frmaltaven= conectar_db(_screen.cn)
					SQLEXEC(frmaltaven,"insert into vendedores values(?xcodiv,?xnomv);")
				desconectar_db(frmaltaven)
			ELSE
				vcodi=0
			endif
			thisform.release
		else
			=messagebox("No ha ingresado el nombre del Vendedor es un dato obligatorio para finalizar el alta",0+48,"Advertendia")
			thisform.text2.setfocus
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

ENDDEFINE


		thisform.xpago=codipag
		create cursor fac(recep_fec D,recep_codi N(8),prov_tipfac C(1),prov_pto N(4),prov_fac N(8),pagrecep_impo N(15,2),recep_conc C(1),parcial N(1))
		create cursor sic(sini_fech D,sini_cod N(8),pagsini_imp N(15,2),parcial N(1))
		CREATE CURSOR dic(debc_fech D,debc_codi N(8),pagdebi_imp N(15,2),parcial N(1))
		CREATE CURSOR cic(crec_fech D,crec_codi N(8),pagcrei_imp N(15,2),parcial N(1))
		create cursor facsic(recep_codi N(8),sini_cod N(8),debc_codi N(8),crec_codi N(8),prov_tipfac C(1),prov_pto N(4), ;
						     prov_fac N(8),facsic_fec D,pagrecep_impo N(15,2),pagsini_imp N(15,2),pagdebi_imp N(15,2),pagcrei_imp N(15,2),parcial N(1))
		
		
		create cursor totregis(instancia N(2),pag_codi N(8),recep_codi N(8),sini_cod N(8),debc_codi N(8),crec_codi N(8),sa C(1),pagrecep_impo N(15,2),pag_fech D, ;
		                       prov_codi N(8),pag_dtosaf N(15,2),pag_antic N(15,2),pag_restsaf N(15,2),pagsini_cod N(8),pagdebi_cod N(8),pagcrei_cod N(8), ;
		                       recep_conc C(1),prov_tipfac C(1),prov_pto N(4),prov_fac N(8),recep_fec D,sini_fech D,debc_fech D,crec_fech D,pagrecep_parci N(1), ;
		                       pagsini_parci N(1),pagdebi_parci N(1),pagcrei_parci N(1),pagpag_codi N(8),pagrec_codi N(8), ;
		                       tippag_codi N(8),tippag_desc C(25),movtippag_nro C(14),ban_codi N(8),ban_desc C(45),ban_cuit N(11),movtippag_pza C(25), ;
		                       movtippag_fvto D,movtippag_imp N(15,2),cuit_lib N(11),parcial N(1))
		
		
		index on instancia to SYS(2015)
		importe=0
		totalfac=0
		totcred=0
		totdeb=0
		codrecpag=0
		pasrecep=0
		with this
			.text7.value=0
			.text8.value=0
			.text14.value=0
			.text15.value=0
			.text9.value=0
			.text10.value=0
			.text16.value=0
			.text17.value=0
			.text9.value=0
		ENDWITH
		if codipag>0
			frmconspag= conectar_db(_screen.cn)
				SQLEXEC(frmconspag,"select * from pagosprov where pag_codi=?codipag;","cur_pago")
				codiprov=cur_pago.prov_codi
			desconectar_db(frmconspag)
			with thisform
				if paspago=1
					.command2.visible=.F.
				else
					.command2.visible=.T.
				endif
				.command2.enabled=.T.
				.command3.enabled=.T.
				thisform.cmd_OBSER.Enabled= .T.
				.text1.value=cur_prov.prov_nomb
				.text2.value=cur_prov.prov_domi
				.text6.value=cur_prov.cond_desc
				.text12.value=cur_prov.prov_cuit
				.text3.value=cur_prov.cp_nro
				.text4.value=cur_prov.loca_nomb
				.text5.value=cur_prov.provi_nomb
				cuit=cur_prov.prov_cuit
				cond=cur_prov.cond_codi
				if RECCOUNT("cur_pago")>0
					.text9.style=1
					.text10.style=1
					.text13.style=1
					.text7.value=cur_pago.pag_impo+cur_pago.pag_dtosaf
					.text10.value=cur_pago.pag_codi
					.text13.value=cur_pago.pag_fech
					.text16.value=cur_pago.pag_antic
					.text17.value=cur_pago.pag_dtoxpag
					.text9.value=cur_pago.pag_dtosaf
					.text14.value=cur_pago.pag_impo
					.text8.value=cur_pago.pag_impo-cur_pago.pag_dtoxpag
					obser=pag_obser
					insert into totregis(instancia,pag_codi,pag_fech,prov_codi);
								values(1,cur_pago.pag_codi,cur_pago.pag_fech,codiprov)
					frmconspag= conectar_db(_screen.cn)
						SQLEXEC(frmconspag,"select b.recep_fec,b.recep_codi,b.prov_tipfac,b.prov_pto,b.prov_fac,a.pagrecep_impo,b.recep_conc,a.pagrecep_parci from pagosprov_recepciones a inner join recepciones b on a.recep_codi=b.recep_codi where a.pag_codi=?codipag order by b.recep_codi;","fac")
						index on recep_codi to SYS(2015)
		
						SQLEXEC(frmconspag,"select b.sini_fech,b.sini_cod,a.pagsini_imp,a.pagsini_parci from pagos_saldosiniprov a inner join saldosiniprov b on a.sini_cod=b.sini_cod where a.pag_codi=?codipag;","sic")
						index on sini_cod to SYS(2015)
		
						SQLEXEC(frmconspag,"SELECT b.debc_fech,a.debc_codi,a.pagdebi_imp,a.pagdebi_parci FROM pagosprov_debintc a INNER JOIN debintc b on a.debc_codi=b.debc_codi WHERE a.pag_codi=?codipag;","dic")
						index on debc_codi to SYS(2015)
		
						SQLEXEC(frmconspag,"SELECT b.crec_fech,a.crec_codi,a.pagcrei_imp,a.pagcrei_parci FROM pagosprov_creintc a INNER JOIN creintc b on a.crec_codi=b.crec_codi WHERE a.pag_codi=?codipag;","cic")
						index on debc_codi to SYS(2015)				
					desconectar_db(frmconspag)
					sele fac
					go top
					scan
						insert into facsic(recep_codi,sini_cod,debc_codi,prov_tipfac,prov_pto,prov_fac,facsic_fec,pagrecep_impo,pagsini_imp,pagdebi_imp,parcial) ;
									values(fac.recep_codi,0,0,fac.prov_tipfac,fac.prov_pto,fac.prov_fac,fac.recep_fec,fac.pagrecep_impo,0,0,fac.pagrecep_parci)
					endscan
					sele sic
					go top
					scan
						insert into facsic(recep_codi,sini_cod,debc_codi,prov_tipfac,prov_pto,prov_fac,facsic_fec,pagrecep_impo,pagsini_imp,pagdebi_imp,parcial) ;
									values(0,sic.sini_cod,0,"",0,0,sic.sini_fech,0,sic.pagsini_imp,0,sic.pagsini_parci)
					endscan
					sele dic
					go top
					scan
						insert into facsic(recep_codi,sini_cod,debc_codi,prov_tipfac,prov_pto,prov_fac,facsic_fec,pagrecep_impo,pagsini_imp,pagdebi_imp,parcial) ;
									values(0,0,dic.debc_codi,"",0,0,dic.debc_fech,0,0,dic.pagdebi_imp,dic.pagdebi_parci)
					ENDSCAN
					sele cic
					go top
					scan
						insert into facsic(recep_codi,sini_cod,debc_codi,crec_codi,prov_tipfac,prov_pto,prov_fac,facsic_fec,pagrecep_impo,pagsini_imp,pagcrei_imp,parcial) ;
									values(0,0,0,cic.crec_codi,"",0,0,cic.crec_fech,0,0,cic.pagcrei_imp,cic.pagcrei_parci)
					endscan
					
					sele facsic
					index on facsic_fec to SYS(2015)
					go top
					i=1
					SCAN
						DO case
							case recep_codi>0
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from recepciones where recep_codi=?facsic.recep_codi;","faclis")
								desconectar_db(frmconspag)						
								.list1.list(i,1)=dtoc(facsic.facsic_fec)
								do case
									case faclis.recep_conc="F"
										.list1.list(i,2)=ICASE(faclis.prov_tipfac="A","FA",faclis.prov_tipfac="B","FB",faclis.prov_tipfac="C","FC")
									case faclis.recep_conc="N"
										.list1.list(i,2)=ICASE(faclis.prov_tipfac="A","NCA",faclis.prov_tipfac="B","NCB",faclis.prov_tipfac="C","NCC")
									case faclis.recep_conc="D"
										.list1.list(i,2)=ICASE(faclis.prov_tipfac="A","NDA",faclis.prov_tipfac="B","NDB",faclis.prov_tipfac="C","NDC")
								ENDCASE
								.list1.list(i,3)=alltrim(str(faclis.prov_pto))
								.list1.list(i,4)=rtrim(str(faclis.prov_fac))
								.list1.list(i,6)=str(faclis.recep_codi)
								.list1.list(i,5)=TRANSFORM(facsic.pagrecep_impo, "$ 999,999,999.99") && rtrim(str(facsic.pagrecep_impo,15,2))
								insert into totregis(instancia,recep_codi,recep_fec,prov_tipfac,prov_pto,prov_fac,recep_conc,pagrecep_impo,pagrecep_parci) ;
										values(1,faclis.recep_codi,faclis.recep_fec,faclis.prov_tipfac,faclis.prov_pto,faclis.prov_fac,faclis.recep_conc,facsic.pagrecep_impo,facsic.parcial)
							CASE sini_cod>0
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from saldosiniprov where sini_cod=?facsic.sini_cod;","sinlis")
								desconectar_db(frmconspag)
								.list1.list(i,1)=dtoc(facsic.facsic_fec)
								.list1.list(i,2)="SIC"
								.list1.list(i,3)="0"
								.list1.list(i,4)=rtrim(str(sini_cod))
								.list1.list(i,5)= TRANSFORM(facsic.pagsini_imp, "$ 999,999,999.99")&& rtrim(str(facsic.pagsini_imp,15,2))
								.list1.list(i,6)=str(sinlis.sini_cod)
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from pagos_saldosiniprov where pag_codi=?codipag and sini_cod=?facsic.sini_cod;","reci_fac")
								desconectar_db(frmconspag)
								insert into totregis(instancia,sini_cod,sini_fech,pagsini_cod,pagrecep_impo,pagsini_parci) ;
										values(1,recfacsini.sini_cod,sinlis.sini_fech,reci_fac.recsini_cod,rec_fac.pagsini_imp,reci_fac.pagsini_parci)
								sele facsic
							case debc_codi>0
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from debintc where debc_codi=?facsic.debc_codi;","deblis")
								desconectar_db(frmconspag)
								.list1.list(i,1)=dtoc(deblis.debc_fech)
								.list1.list(i,2)="DIC"
								.list1.list(i,3)="0"
								.list1.list(i,4)=rtrim(str(deblis.debc_codi))
								.list1.list(i,5)=TRANSFORM(facsic.pagdebi_imp, "$ 999,999,999.99") && rtrim(str(facsic.pagdebi_imp,15,2))
								.list1.list(i,6)=str(deblis.debc_codi)
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from pagosprov_debintc where pag_codi=?codipag and debc_codi=?facsic.debc_codi;","reci_deb")
								desconectar_db(frmconspag)
								insert into totregis(instancia,debc_codi,debc_fech,pagdebi_cod,pagrecep_impo,pagdebi_parci) ;
										values(1,facsic.debc_codi,deblis.debc_fech,reci_deb.pagdebi_cod,facsic.pagdebi_imp,reci_deb.pagdebi_parci)
								sele facsic
							case crec_codi>0
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from creintc where crec_codi=?facsic.crec_codi;","crelis")
								desconectar_db(frmconspag)
								.list1.list(i,1)=dtoc(crelis.crec_fech)
								.list1.list(i,2)="CIC"
								.list1.list(i,3)="0"
								.list1.list(i,4)=rtrim(str(crelis.crec_codi))
								.list1.list(i,5)= TRANSFORM(facsic.pagcrei_imp, "$ 999,999,999.99") && rtrim(str(facsic.pagcrei_imp,15,2))
								.list1.list(i,6)=str(crelis.crec_codi)
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from pagosprov_creintc where pag_codi=?codipag and crec_codi=?facsic.crec_codi;","reci_cre")
								desconectar_db(frmconspag)
								insert into totregis(instancia,crec_codi,crec_fech,pagcrei_cod,pagrecep_impo,pagcrei_parci) ;
										values(1,facsic.crec_codi,crelis.crec_fech,reci_cre.pagcrei_cod,facsic.pagcrei_imp,reci_cre.pagcrei_parci)
								sele facsic						
						endcase
						i=i+1
					endscan
					frmconspag= conectar_db(_screen.cn)
						SQLEXEC(frmconspag,"select a.*,b.tippag_desc from pagosprov_pagos a inner join tipospago b on a.tippag_codi=b.tippag_codi where a.pag_codi=?codipag;","cur_pagpag")
					desconectar_db(frmconspag)
					IF RECCOUNT("cur_pagpag")>0
						GO top
						scan
							IF cur_pagpag.recpag_codi>0
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select a.*,b.* from recibos_pagos a inner join bancos b on a.ban_codi=b.ban_codi where recpag_codi=?cur_pagpag.recpag_codi;","cur_recipag")
								desconectar_db(frmconspag)
							ENDIF
							if cur_pagpag.tippag_codi=3 OR cur_pagpag.tippag_codi=20
								LOCAL xcuit
								xcuit=iif(recpag_codi>0,ALLTRIM(cur_recipag.cuit_lib),ALLTRIM(cuit_lib))
								cadenacuit=subst(xcuit,1,2)+"-"+subst(xcuit,3,8)+"-"+right(xcuit,1)
							else
								cadenacuit=""
							ENDIF
							if cur_pagpag.recpag_codi>0
								fvto=IIF(ISNULL(cur_recipag.movtippag_fvto),{  /  /    },cur_recipag.movtippag_fvto)
								.olecontrol1.additem(allt(cur_pagpag.tippag_desc)+chr(9)+IIF(cur_recipag.tippag_codi=20,allt(cur_recipag.movtippag_nro),allt(cur_recipag.chequenro))+chr(9)+ ;
												     cadenacuit+chr(9)+allt(cur_recipag.ban_desc)+chr(9)+allt(cur_recipag.movtippag_pza)+chr(9)+ ;
											   		 dtoc(fvto)+chr(9)+allt(str(cur_recipag.movtippag_imp,15,2))+CHR(9)+ALLTRIM(cur_recipag.cheqid)+CHR(9)+ALLTRIM(STR(cur_pagpag.recpag_codi)))
								.text15.value=.text15.value+cur_recipag.movtippag_imp
								insert into totregis(instancia,tippag_codi,tippag_desc,movtippag_nro,ban_codi,ban_desc,ban_cuit, ;
				                                     movtippag_pza,movtippag_fvto,movtippag_imp,cuit_lib) ;
				                             values(2,cur_pagpag.tippag_codi,cur_pagpag.tippag_desc,IIF(cur_recipag.tippag_codi=20,allt(cur_recipag.movtippag_nro),cur_recipag.chequenro), ;
				                             		cur_recipag.ban_codi,cur_recipag.ban_desc,VAL(cur_recipag.ban_cuit),cur_recipag.movtippag_pza, ;
				                             		fvto,cur_recipag.movtippag_imp, ;
				                             		VAL(cur_recipag.cuit_lib))
								SELECT cur_pagpag
							ELSE
								frmconspag= conectar_db(_screen.cn)
									SQLEXEC(frmconspag,"select * from bancos where ban_codi=?cur_pagpag.ban_codi;","cur_banpag")
								desconectar_db(frmconspag)
								fvto=IIF(ISNULL(cur_pagpag.movtippag_fvto),{  /  /    },cur_pagpag.movtippag_fvto)
								.olecontrol1.additem(allt(cur_pagpag.tippag_desc)+chr(9)+iif(cur_pagpag.tippag_codi=3,cur_pagpag.chequenro,allt(cur_pagpag.movtippag_nro))+chr(9)+ ;
												     cadenacuit+chr(9)+allt(cur_banpag.ban_desc)+chr(9)+allt(cur_pagpag.movtippag_pza)+chr(9)+ ;
											   		 dtoc(fvto)+chr(9)+allt(str(cur_pagpag.movtippag_imp,15,2))+CHR(9)+''+CHR(9)+'0')
								.text15.value=.text15.value+cur_pagpag.movtippag_imp
								insert into totregis(instancia,tippag_codi,tippag_desc,movtippag_nro,ban_codi,ban_desc,ban_cuit, ;
				                                     movtippag_pza,movtippag_fvto,movtippag_imp,cuit_lib) ;
				                             values(2,cur_pagpag.tippag_codi,cur_pagpag.tippag_desc,iif(cur_pagpag.tippag_codi=3,cur_pagpag.chequenro,allt(cur_pagpag.movtippag_nro)), ;
				                             		cur_pagpag.ban_codi,cur_banpag.ban_desc,VAL(cur_banpag.ban_cuit),cur_pagpag.movtippag_pza, ;
				                             		fvto,cur_pagpag.movtippag_imp, ;
				                             		VAL(cur_pagpag.cuit_lib))
			                endif
						ENDSCAN
					endif
				endif
		    ENDWITH
		endif
	ENDPROC

	PROCEDURE LostFocus
		set point to
		set separator to
	ENDPROC

	PROCEDURE cmd_obser.Click
		frmconspag= conectar_db(_screen.cn)
			SQLEXEC(frmconspag,"select TRIM(pag_obser) pag_obser from pagosprov where pag_codi = ?thisform.xpago;","cur_obs")
		desconectar_db(frmconspag)
		
		IF RECCOUNT("cur_obs") > 0
			IF LEN(ALLTRIM(cur_obs.pag_obser)) > 0
				=MESSAGEBOX(cur_obs.pag_obser,64,"Observaciones")
			ELSE
				=MESSAGEBOX("Esta Orden de Pago no tiene Observaciones.",48,"Aviso del Sistema")
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_obser.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_obser.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		codiprov=cur_prov.prov_codi
		do form pagoload with codiprov
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		local lcletra,xfecha
		
		SELECT totregis
		GO TOP
		
		xfecha="Río Cuarto, "+Dia_nombre(dow(totregis.pag_fech)) +" "+ allt(str(DAY(totregis.pag_fech)))+ ' de ' +Mes_nombre(month(totregis.pag_fech))+ ' de '+allt(str(year(totregis.pag_fech)))
		
		do monto2letra with thisform.text15.value,lcletra in ntoletra
		
		codpag=cur_pago.pag_codi
		
		report form ordendepago TO PRINTER PROMPT NOCONSOLE
		
		thisform.text9.setfocus
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE List1.Click
		*!*	if this.selected(this.listindex)
		*!*		this.selected(this.listindex)=.F.
		*!*	endif
	ENDPROC

	PROCEDURE List1.DblClick
		LOCAL codif
		codif=0
		with thisform
			for i=1 to this.listcount
				if this.selected(i)
					IF ALLTRIM(this.List(i,2))="DIC"
						pasdic=1
						codif=VAL(this.List(i,6))
						DO FORM consdebintpro with codif
					ELSE
						do case
							case subst(allt(.list1.list(i,2)),1,1)="F"
								valorcadena="Mercadería Recibida (Recepciones)"
						otherwise
							valorcadena="Notas de Crédito/Notas de Débito"
						endcase
						codrec=val(.list1.list(i,6))
						pasrecep=1
						do form consrecep with codrec,cond
					ENDIF
				endif
			next i
		endwith
	ENDPROC

	PROCEDURE Olecontrol1.DblClick
		*** ActiveX Control Event ***
		LOCAL xcodpag,xtipo
		this.col=8
		xcodpag=val(this.text)
		IF xcodpag>0
		this.col=0
			DO case
				CASE allt(this.text)="CHEQUE"
					do form conscheqrap with xcodpag,1
				CASE allt(this.text)="ECHEQ"
					do form conscheqrap with xcodpag,2
			ENDCASE
		ENDIF
	ENDPROC

	PROCEDURE Text10.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text10.LostFocus
		*!*	local paso
		*!*	paso=0
		*!*	sele totregis
		*!*	if reccount()>0
		*!*		dele all
		*!*	endif
		*!*	with thisform
		*!*	.text1.value=""
		*!*	.text2.value=""
		*!*	.text3.value=""
		*!*	.text4.value=""
		*!*	.text5.value=""

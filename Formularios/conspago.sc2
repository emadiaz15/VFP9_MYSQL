	PROCEDURE Text7.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.LostFocus
		fact=0
		totcred=0
		sele totalcbtes
		if reccount()>0
			dele all
		endif
		go top
		with thisform
			if .list1.listcount>0
				.list1.boundcolumn=3
				for i=1 to .list1.listcount
					if .list1.list(i,1)="NC"
						.text8.value=.text8.value+abs(ConverNro(.list1.list(i,4)))
						totcred=totcred+abs(ConverNro(.list1.list(i,4)))
					else
						.text9.value=.text9.value+ConverNro(.list1.list(i,4))
						fact=fact+ConverNro(.list1.list(i,4))
					endif
					auxiliar=fact-totcred
					do case
						case auxiliar<this.value
							inser into totalcbtes(conc,punto,numero,impabona) ;
								  values(allt(.list1.list(i,1)),val(.list1.list(i,2)),val(.list1.list(i,3)),ConverNro(.list1.list(i,4)))
						case auxiliar=this.value
							inser into totalcbtes(conc,punto,numero,impabona) ;
								  values(allt(.list1.list(i,1)),val(.list1.list(i,2)),val(.list1.list(i,3)),ConverNro(.list1.list(i,4)))
							exit
						case auxiliar>this.value
							diferencia=auxiliar-this.value
							fact=fact-diferencia
							abona=ConverNro(.list1.list(i,4))-(ConverNro(.list1.list(i,5))-(this.value))
							insert into totalcbtes(conc,punto,numero,impabona) ;
								values(allt(.list1.list(i,1)),val(.list1.list(i,2)),val(.list1.list(i,3)),abona)
							exit
					endcase
				next i
				.text9.value=fact
				.text8.value=totcred
			endif
			if this.value>0
				.command3.enabled=.T.
				.command3.setfocus
			endif
		endwith
	ENDPROC

ENDDEFINE


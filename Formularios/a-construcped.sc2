	PROCEDURE Activate
		if codicli>0
			on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		set exact on
		if codigo=0
			muestro=0
		endif
		if muestro=1
			with thisform
				sele articulos
				set order to art_codi
				seek codigo
				localiz=1
				if paso=1
					.grid1.col=0
					.grid1.text=allt(str(aux))
					.grid1.col=1
					.grid1.text=allt(cant)
					.grid1.col=2
					.grid1.text=art_med
					.grid1.col=3
					cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
					.grid1.text=cadena
					.grid1.col=4
					if codigo=4
						.grid1.text=allt(descrip)
					else
						.grid1.text=allt(descri)
					endif
					.grid1.col=5
					.grid1.text=allt(pruni)
					.grid1.col=6
					acu=acu-val(.grid1.text)
					.grid1.text=prtot
					acu=acu+val(prtot)
				else
					if insertar=0
						item=item+1
						cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
						.grid1.additem(alltrim(str(item))+chr(9)+trim(cant)+chr(9)+art_med+chr(9)+cadena+chr(9)+allt(descri)+chr(9)+allt(pruni)+chr(9)+prtot)
					endif
					acu=acu+val(prtot)
				endif
				if paso=1
					paso=0
				else
					.grid1.row=this.grid1.rows-1
				endif
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				endif
				.grid1.col=0
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellalignment=3
				.grid1.col=2
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellalignment=8		
				if .text19.value>0
					.text17.value=str(acu*.text19.value/100,10,2)
					.text18.value=str(acu-val(.text17.value),10,2)
					if cond=2
						.text9.value=str(val(.text18.value)*impiva1/100,10,2)
					endif
					.text10.value=str(val(.text18.value)+val(.text9.value)+val(.text11.value),10,2)
				endif	
				codigo=0
			endwith
		endif
		if localiz=1 and item>0
			with thisform
				acuaux=0
				auxiva=0
				ivadif=0
				ivaitem=0
				acu=0
				for i=1 to .grid1.rows-1
					.grid1.row=i
					.grid1.col=7
					if len(.grid1.text)>0
						ivaitem=val(.grid1.text)
						.grid1.col=6
						if .text19.value>0
							dto=val(.grid1.text)*.text19.value/100
							acuaux=acuaux+val(.grid1.text)-dto
							dto=val(.grid1.text)-dto
							ivaitem=dto*ivaitem/100
						else
							acuaux=acuaux+val(.grid1.text)
							ivaitem=val(.grid1.text)*ivaitem/100
						endif
						ivadif=ivadif+ivaitem
					else
						.grid1.col=6
						acu=acu+val(.grid1.text)
					endif
				next i
				.text8.value=str(acu+acuaux,10,2)
				if cond=2
					dto=0
					if .text19.value>0
						dto=(acu+acuaux)*.text19.value/100
					endif
					acutot=acu+acuaux
					dife=acutot-acuaux-dto
					auxiva=dife*impiva1/100
					.text9.value=str(auxiva+ivadif,10,2)
				endif
				.text17.value=str((acu+acuaux)*.text19.value/100,10,2)
				.text18.value=str(acu+acuaux-val(.text17.value),10,2)
				.text10.value=str(val(.text18.value)+val(.text9.value)+val(.text11.value),10,2)
				.grid1.toprow=.grid1.rows-1
			endwith
		endif
		store 0 to localiz
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 1 of Pedidos_de .F.
		on key label INS
		localiz=0
		item=0
	ENDPROC

	PROCEDURE Init
		public cond,elimi,descrip,muestro,postal,locali,provi,opcion,transporte,x, ;
			   dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot,insertar, ;
			   impiva1,impiva2,borra,codicli,codiva,codp,coditran,coditran1,coditran2,buscar,localiz,vcodi, ;
			   letrapor,porcodi,item,paso,acu
		set dele on
		item=0
		letrapor=""
		porcodi=0
		vcodi=0
		codped=0
		transporte=" "
		coditran=0
		paso=0
		acu=0
		elimi=0
		localiz=0
		muestro=0
		descrip=""
		opcion=0
		insertar=0
		borra=0
		codicli=0
		codigo=0
		codp=0
		buscar=1
		this.text13.value=date()
		this.text19.value=0
		this.text15.value=0
		this.text21.value=0
		sele iva
		go bott
		impiva1=iva_1
		impiva2=iva_2
		codiva=iva_codi
		thisform.label12.caption=allt(str(impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(impiva2,10,2))+"%"
		sele clientes
		set order to cli_nomb
		do form cliload with codicli
		with this
			sele vendedores
			set order to ven_codi
			sele zonas
			set rela off into vendedores
			set rela to ven_codi into vendedores addi
			sele clientes
			.text1.value=clientes.cli_nomb
			.text2.value=clientes.cli_domi
			.text3.value=postal
			.text4.value=locali
			.text5.value=provi
			.text6.value=condiva.cond_desc
			.text12.value=clientes.cli_cuit
			vcodi=zonas.ven_codi
			.text15.value=zonas.ven_codi
			.text16.value=vendedores.ven_nomb
			.text7.value=0
		endwith					
		cond=cond_codi
		set order to cli_codi
	ENDPROC

	PROCEDURE Load
		set skip of bar 1 of Pedidos_de .T.
	ENDPROC

	PROCEDURE LostFocus
		if valorcadena<>"Por Nota de Pedido"
			set skip of bar 1 of Pedidos_de .F.
			thisform.hide
			localiz=0
			item=0
		endif
	ENDPROC

	PROCEDURE Command1.Click
		do case
		case item=0
			messagebox("Aún no ha ingresado ningún artículo al Pedido, imposible Terminar"+chr(13)+ ;
					   "Ingrese algún artículo presionando la tecla INSERT. Si desea salir de la"+chr(13)+ ; 
					   "rutina utilize el botón Salir o presione la tecla ESC",48,"Advertencia")
		case thisform.text21.value=0 and thisform.text15.value>0
			messagebox("Debe ingresar la comisión del vendedor para guardar el Pedido",0+48,"Advertencia")
		otherwise
			preg=messagebox("¿Confirma los datos del Pedido?",4+32+256,"Alta de Pedidos de Clientes")
			if preg=6
				with thisform
					sele pedidos
					set order to ped_codi
					if codp=0
						go bott
						codp=ped_codi+1
						appe blank
						repla ped_codi with codp
					else
						seek codp
					endif
					repla ped_fech with .text13.value
					repla cli_codi with codicli
					repla ped_dto with .text19.value
					repla iva_codi with codiva
					repla notaped_nro with .text7.value
					if .text15.value>0
						repla ven_codi with .text15.value
					endif
					if allt(.text20.value)=""
						if thisform.text21.value>0
							repla otra_comi with .text21.value
						else
							repla porc_codi with 0
						endif
					else
						repla porc_codi with porcodi
					endif
					if coditran1>0
						sele pedidos_transportes
						set order to ped_codi
						seek codp
						if found()
							repla tran_codi with coditran1
							do case
								case .opcionflete1.value=1
									repla flete_cargo with "C"
								case .opcionflete1.value=2
									repla flete_cargo with "P"
							endcase
							skip
							if ped_codi=codp
								repla tran_codi with coditran2
								do case
									case .opcionflete2.value=1
										repla flete_cargo with "C"
									case .opcionflete2.value=2
										repla flete_cargo with "P"
								endcase
							endif
						else
							appe blank
							repla ped_codi with codp
							repla tran_codi with coditran1
							
							do case
								case .opcionflete1.value=1
									repla flete_cargo with "C"
								case .opcionflete1.value=2
									repla flete_cargo with "P"
							endcase
							if coditran2>0
								appe blank
								repla ped_codi with codp
								repla tran_codi with coditran2
								do case
									case .opcionflete2.value=1
										repla flete_cargo with "C"
									case .opcionflete2.value=2
										repla flete_cargo with "P"
								endcase
							endif
						endif
					endif
					sele pedidos_articulos
					set reprocess to automatic
					if flock()
						set order to ped_codi
						seek codp
						if !found()
							for fila=1 to .grid1.rows
								if fila<.grid1.rows
									.grid1.row=fila
									appe blank
									repla ped_codi with codp
									.grid1.col=3
									if val(.grid1.text)=4
										.grid1.col=4
										repla artped_dasc with .grid1.text
										.grid1.col=3
									endif
									repla art_codi with val(.grid1.text)
									articulo=val(.grid1.text)
									.grid1.col=4
									sele articulos
									set order to art_codi
									seek articulo
									if articulo<>4 and allt(.grid1.text)<>allt(art_desc)
										sele articulos_clientes
										set order to artcli
										seek str(codicli)+str(articulo)
										if found()
											sele desc_articulos_clientes
											set order to dacartcli
											seek str(articulos_clientes.artcli_codi)+allt(.grid1.text)
											if found()
												repla pedidos_articulos.dac_codi with dac_codi
											endif
										endif
									else
										if pedidos_articulos.dac_codi>0
											repla pedidos_articulos.dac_codi with 0
										endif
									endif
									sele pedidos_articulos
									.grid1.col=1
									repla artped_cant with val(.grid1.text)
									if articulo<>4
										repla articulos.pedidos with articulos.pedidos+artped_cant
									endif
									.grid1.col=3
									repla art_codi with val(.grid1.text)
									.grid1.col=5
									repla artped_precio with val(.grid1.text)
									.grid1.col=7
									if len(.grid1.text)>0
										repla alter_iva with val(.grid1.text)
									else
										repla alter_iva with 0
									endif
								endif
							next fila
						else
							for fila=1 to .grid1.rows
								if fila<.grid1.rows
									.grid1.row=fila
									if eof() or ped_codi<>codp
										appe blank
										repla ped_codi with codp
									else
										if fila>1
											skip
											if eof() or ped_codi<>codp
												appe blank
												repla ped_codi with codp
											endif
										endif
									endif
									.grid1.col=3
									if val(.grid1.text)=4
										.grid1.col=4
										repla artped_dasc with .grid1.text
										.grid1.col=3
									endif
									auxart=art_codi
									if val(.grid1.text)<>art_codi
										repla art_codi with val(.grid1.text)
									endif
									articulo=val(.grid1.text)
									.grid1.col=4
									sele articulos
									set order to art_codi
									seek articulo
									if articulo<>4 and allt(.grid1.text)<>allt(art_desc)
										sele articulos_clientes
										set order to artcli
										seek str(codicli)+str(articulo)
										if found()
											sele desc_articulos_clientes
											set order to dacartcli
											seek str(articulos_clientes.artcli_codi)+allt(.grid1.text)
											if found()
												repla pedidos_articulos.dac_codi with dac_codi
											endif
										endif
									else
										if pedidos_articulos.dac_codi>0
											repla pedidos_articulos.dac_codi with 0
										endif
									endif
									sele pedidos_articulos
									.grid1.col=1
									if articulo<>4
										do case
											case val(.grid1.text)>artped_cant
												dife=val(.grid1.text)-artped_cant
											case val(.grid1.text)<artped_cant
												dife=artped_cant-val(.grid1.text)
										endcase
										do case
											case auxart<>art_codi
												repla articulos.pedidos with articulos.pedidos+val(.grid1.text)
											case auxart=art_codi and val(.grid1.text)>artped_cant
												repla articulos.pedidos with articulos.pedidos+dife
											case auxart=art_codi and val(.grid1.text)<artped_cant
												repla articulos.pedidos with articulos.pedidos-dife
										endcase
									endif
									repla artped_cant with val(.grid1.text)
									.grid1.col=5
									repla artped_precio with val(.grid1.text)
									.grid1.col=7
									if len(.grid1.text)>0
										repla alter_iva with val(.grid1.text)
									else
										repla alter_iva with 0
									endif
								endif
							next fila
						endif
						if !eof()
							skip
						endif
						if ped_codi=codp
							do while ped_codi=codp and !eof()
								dele
								skip
							enddo
						endif
					endif
					unlock
					thisform.release
				endwith
			endif
		endcase
	ENDPROC

	PROCEDURE Command2.Click
		preg=messagebox("¿Seguro que desea Salir?",4+32+256,"Pedidos")
		if preg=6
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command3.Click
		do case
		case item=0
			messagebox("Aún no ha ingresado ningún artículo al Pedido, imposible Guardar"+chr(13)+ ;
					   "Ingrese algún artículo presionando la tecla INSERT. Si desea salir de la"+chr(13)+ ; 
					   "rutina utilize el botón Salir o presione la tecla ESC",48,"Advertencia")
		case thisform.text21.value=0 and thisform.text15.value>0
			messagebox("Debe ingresar la comisión del vendedor para guardar el Pedido.",0+48,"Advertencia")
		otherwise
			with thisform
				sele pedidos
				set order to ped_codi
				if codp=0
					go bott
					codp=ped_codi+1
					appe blank
					repla ped_codi with codp
				else
					seek codp
				endif
				repla ped_fech with .text13.value
				repla cli_codi with codicli
				repla ped_dto with .text19.value
				repla iva_codi with codiva
				repla notaped_nro with .text7.value
				if .text15.value>0
					repla ven_codi with .text15.value
				endif
				if allt(.text20.value)=""
					if thisform.text21.value>0
						repla otra_comi with .text21.value
					else
						repla porc_codi with 0
					endif
				else
					repla porc_codi with porcodi
				endif
				if coditran1>0
					sele pedidos_transportes
					set order to ped_codi
					seek codp
					if found()
						repla tran_codi with coditran1
						do case
							case .opcionflete1.value=1
								repla flete_cargo with "C"
							case .opcionflete1.value=2
								repla flete_cargo with "P"
						endcase
						skip
						if ped_codi=codp
							repla tran_codi with coditran2
							do case
								case .opcionflete2.value=1
									repla flete_cargo with "C"
								case .opcionflete2.value=2
									repla flete_cargo with "P"
							endcase
						endif
					else
						appe blank
						repla ped_codi with codp
						repla tran_codi with coditran1
						do case
							case .opcionflete1.value=1
								repla flete_cargo with "C"
							case .opcionflete1.value=2
								repla flete_cargo with "P"
						endcase
						if coditran2>0
							appe blank
							repla ped_codi with codp
							repla tran_codi with coditran2
							do case
								case .opcionflete2.value=1
									repla flete_cargo with "C"
								case .opcionflete2.value=2
									repla flete_cargo with "P"
							endcase
						endif
					endif
				endif
				sele pedidos_articulos
				set reprocess to automatic
				if flock()
					set order to ped_codi
					seek codp
					if !found()
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								appe blank
								repla ped_codi with codp
								.grid1.col=3
								if val(.grid1.text)=4
									.grid1.col=4
									repla artped_dasc with .grid1.text
									.grid1.col=3
								endif
								repla art_codi with val(.grid1.text)
								articulo=val(.grid1.text)
								.grid1.col=4
								sele articulos
								set order to art_codi
								seek articulo
								if articulo<>4 and allt(.grid1.text)<>allt(art_desc)
									sele articulos_clientes
									set order to artcli
									seek str(codicli)+str(articulo)
									if found()
										sele desc_articulos_clientes
										set order to dacartcli
										seek str(articulos_clientes.artcli_codi)+allt(.grid1.text)
										if found()
											repla pedidos_articulos.dac_codi with dac_codi
										endif
									endif
								else
									if pedidos_articulos.dac_codi>0
										repla pedidos_articulos.dac_codi with 0
									endif
								endif
								sele pedidos_articulos
								.grid1.col=1
								repla artped_cant with val(.grid1.text)
								if articulo<>4
									repla articulos.pedidos with articulos.pedidos+artped_cant
								endif
								.grid1.col=3
								repla art_codi with val(.grid1.text)
								.grid1.col=5
								repla artped_precio with val(.grid1.text)
								.grid1.col=7
								if len(.grid1.text)>0
									repla alter_iva with val(.grid1.text)
								else
									repla alter_iva with 0
								endif
							endif
						next fila
					else
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								if eof() or ped_codi<>codp
									appe blank
									repla ped_codi with codp
								else
									if fila>1
										skip
										if eof() or ped_codi<>codp
											appe blank
											repla ped_codi with codp
										endif
									endif
								endif
								.grid1.col=3
								if val(.grid1.text)=4
									.grid1.col=4
									repla artped_dasc with .grid1.text
									.grid1.col=3
								endif
								auxart=art_codi
								if val(.grid1.text)<>art_codi
									repla art_codi with val(.grid1.text)
								endif
								articulo=val(.grid1.text)
								.grid1.col=4
								sele articulos
								set order to art_codi
								seek articulo
								if articulo<>4 and allt(.grid1.text)<>allt(art_desc)
									sele articulos_clientes
									set order to artcli
									seek str(codicli)+str(articulo)
									if found()
										sele desc_articulos_clientes
										set order to dacartcli
										seek str(articulos_clientes.artcli_codi)+allt(.grid1.text)
										if found()
											repla pedidos_articulos.dac_codi with dac_codi
										endif
									endif
								else
									if pedidos_articulos.dac_codi>0
										repla pedidos_articulos.dac_codi with 0
									endif
								endif
								sele pedidos_articulos
								.grid1.col=1
								if articulo<>4
									do case
										case val(.grid1.text)>artped_cant
											dife=val(.grid1.text)-artped_cant
										case val(.grid1.text)<artped_cant
											dife=artped_cant-val(.grid1.text)
									endcase
									do case
										case auxart<>art_codi
											repla articulos.pedidos with articulos.pedidos+val(.grid1.text)
										case auxart=art_codi and val(.grid1.text)>artped_cant
											repla articulos.pedidos with articulos.pedidos+dife
										case auxart=art_codi and val(.grid1.text)<artped_cant
											repla articulos.pedidos with articulos.pedidos-dife
									endcase
								endif
								repla artped_cant with val(.grid1.text)
								.grid1.col=5
								repla artped_precio with val(.grid1.text)
								.grid1.col=7
								if len(.grid1.text)>0
									repla alter_iva with val(.grid1.text)
								else
									repla alter_iva with 0
								endif
							endif
						next fila
					endif
					if !eof()
						skip
					endif
					if ped_codi=codp
						do while ped_codi=codp and !eof()
							dele
							skip
						enddo
					endif
				endif
				unlock
			endwith
		endcase
	ENDPROC

	PROCEDURE Command4.Click
		aux=codp
		do form tranload with transporte,coditran
		coditran1=coditran
		if transporte<>" "
			thisform.text14.value=transporte
			codp=aux
			thisform.edit1.setfocus
		endif
	ENDPROC

	PROCEDURE Command5.Click
		do form locavend with vcodi
		if vcodi>0
			sele vendedores
			set order to ven_codi
			seek vcodi
			thisform.text15.value=ven_codi
			thisform.text16.value=ven_nomb
		else
			thisform.text16.value=""
		endif
	ENDPROC

	PROCEDURE Command6.Click
		do form locapcom with letrapor
		if letrapor<>""
			sele porcencomi
			set order to porc_desc
			seek letrapor
			porcodi=porc_codi
			thisform.text20.value=porc_desc
			thisform.text21.value=porc_impo
		else
			thisform.text21.value=0
			porodi=0
		endif
	ENDPROC

	PROCEDURE Command7.Click
		aux=codp
		do form tranload with transporte,coditran
		coditran2=coditran
		if transporte<>" "
			thisform.text22.value=transporte
			codp=aux
			thisform.edit2.setfocus
		endif
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Edit2.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit2.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
		local x,y
		if item>0
			this.col=0
			aux=val(this.text)
			this.col=3
			dato1=val(this.text)
			this.col=1
			dato2=this.text
			this.col=4
			dato3=this.text
			this.col=5
			dato4=this.text
			this.col=6
			prtot=this.text
			this.col=2
			dato5=this.text
			do form modippreg with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		if borra=6
			with thisform
				this.col=6
				acu=acu-val(this.text)
				sele pedidos_articulos
				set order to pedart
				seek str(codp)+str(dato1)
				if found()
					this.col=3
					repla articulos.pedidos with articulos.pedidos-val(dato2)
				endif
				if this.rows=2
					item=item-1
					this.rows=1
					acu=0
					.text8.value=""
					.text9.value=""
					.text10.value=""
					.text11.value=""
					.text17.value=""
					.text18.value=""
					.text19.value=0
				else
					item=item-1
					this.removeitem(this.row)
					this.col=2
					filaux=this.row
					x=1
					y=0
					do while x<=this.rows-1
						this.row=x
						y=y+1
						this.col=0
						this.text=allt(str(y))
						x=x+1
					enddo
					this.row=auxfila
				endif
			endwith
			borra=0
			insertar=0
		endif
		if insertar=1 and codigo<>0
			with thisform
				this.col=0
				nro=this.row
				do case
					case opcion=1
						sele articulos
						set order to art_codi
						seek codigo
						cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
						this.additem(" "+chr(9)+trim(cant)+chr(9)+articulos.art_med+chr(9)+allt(cadena)+chr(9)+descri+chr(9)+allt(pruni)+chr(9)+prtot,.grid1.row)
						acu=acu+val(prtot)
						item=item+1
						muestro=0
						opcion=0
				endcase
				.grid1.row=nro
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				endif
				.grid1.col=0
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellalignment=3
				.grid1.col=2
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellalignment=8		
				x=1
				y=0
				do while x<=this.rows-1
					this.row=x
					y=y+1
					this.col=0
					this.text=allt(str(y))
					x=x+1
				enddo
				insertar=0		
			endwith
		endif
	ENDPROC

	PROCEDURE grid1.GotFocus
		cond=clientes.cond_codi
		on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		if localiz=1
			if elimi=0 and item>0
				thisform.grid1.toprow=item
			else
				elimi=0
			endif
		endif
	ENDPROC

	PROCEDURE Text1.GotFocus
		*if localiz<>1
		*	if muestro=0
		*		sele clientes
		*		set order to cli_nomb
		*		do form cliload with codicli
		*		with pedicli
		*			.text1.value=clientes.cli_nomb
		*			.text2.value=clientes.cli_domi
		*			.text3.value=postal
		*			.text4.value=locali
		*			.text5.value=provi
		*			.text6.value=condiva.cond_desc
		*			.text12.value=clientes.cli_cuit
		*		endwith					
		*		cond=cond_codi
		*		set order to cli_codi
		*	endif
		*endif
		if localiz=1
			thisform.grid1.toprow=item
		endif
	ENDPROC

	PROCEDURE Text15.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text15.Valid
		if this.value>0
			sele vendedores
			set order to ven_codi
			seek this.value
			if found()
				thisform.text16.value=allt(ven_nomb)
			else
				=messagebox("Vendedor no está en archivo",0+48,"Advertencia!!!")
				this.value=0
				return 0
			endif
		else
			thisform.text16.value=""
		endif
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			local acuaux,auxiva,ivadif,ivaitem
			acuaux=0
			auxiva=0
			ivadif=0
			ivaitem=0
			for i=1 to .grid1.rows-1
				.grid1.row=i
				.grid1.col=7
				if len(.grid1.text)>0
					ivaitem=val(.grid1.text)
					.grid1.col=6
					dto=val(.grid1.text)*this.value/100
					acuaux=acuaux+val(.grid1.text)-dto
					dto=val(.grid1.text)-dto
					ivaitem=dto*ivaitem/100
					ivadif=ivadif+ivaitem
				endif
			next i
			dtotot=acu*this.value/100
			.text17.value=str(dtotot,10,2)
			.text18.value=str(acu-dtotot,10,2)
			if clientes.cond_codi=2
				dife=acu-dtotot-acuaux
				auxiva=dife*impiva1/100
				.text9.value=str(auxiva+ivadif,10,2)
			endif
			.text10.value=str(val(.text18.value)+val(.text9.value)+val(.text11.value),10,2)
		endwith
		
		
	ENDPROC

	PROCEDURE Text20.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text20.Valid
		if this.value<>""
			sele porcencomi
			set order to porc_desc
			seek allt(this.value)
			if found()
				porcodi=porc_codi
				thisform.text21.value=porc_impo
			else
				=messagebox("Porcentaje de Comisión no está en archivo",0+48,"Advertencia!!!")
				this.value=""
				return 0
			endif
		else
			thisform.text21.value=0
			porodi=0
		endif
	ENDPROC

	PROCEDURE Text21.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.Valid
		if this.value>0
			sele pedidos
			set order to notaped_nr
			seek this.value
			if found()
				=messagebox("Nota de Pedido ya ingresada al sistema con fecha "+dtoc(ped_fech)+chr(13)+ ;
							"a nombre de "+ALLT(clientes.cli_nomb),0+48,"Advertencia!!!")
				this.value=0
				return 0
			endif
		endif
	ENDPROC

ENDDEFINE

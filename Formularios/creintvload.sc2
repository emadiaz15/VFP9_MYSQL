	PROCEDURE Activate
		if codicli=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE Init
		parameter codicli
		public cond,i,codifac,postal,provi,locali
		postal=0
		provi=""
		locali=""
		set date british
		set cent on
		set dele on
		with thisform
			if codicli=0
				do form cliload with codicli,postal,provi,locali
				cond=cond_codi
				.text1.value=cur_clie.cli_nomb
				.text2.value=cur_clie.cli_domi
				.text6.value=cur_clie.cond_desc
				.text12.value=cur_clie.cli_cuit
				.text3.value=cur_clie.cp_nro
				.text4.value=cur_clie.loca_nomb
				.text5.value=cur_clie.provi_nomb
			ELSE
				frmdivlo= conectar_db(_screen.cn)
					SQLEXEC(frmdivlo,"call usp_buscarcli(?codicli);","cur_clie")
				desconectar_db(frmdivlo)
				.text1.value=cur_clie.cli_nomb
				.text2.value=cur_clie.cli_domi
				.text6.value=cur_clie.cond_desc
				.text12.value=cur_clie.cli_cuit
				.text3.value=cur_clie.cp_nro
				.text4.value=cur_clie.loca_nomb
				.text5.value=cur_clie.provi_nomb
			ENDIF
			frmdivlo= conectar_db(_screen.cn)
				SQLEXEC(frmdivlo,"select crev_codi,crev_fech from creintv where cli_codi=?codicli order by crev_fech,crev_codi desc;","cur_dil")
			desconectar_db(frmdivlo)
			IF RECCOUNT("cur_dil")>0
				LOCATE
				thisform.lst_dilo.RowSource="cur_dil"
				frmdivlo= conectar_db(_screen.cn)
					SQLEXEC(frmdivlo,"select crevin_desc,crevin_impo from creintv_items where crev_codi=?cur_dil.crev_codi;","cur_dialo")
				desconectar_db(frmdivlo)
				GO top
				IF RECCOUNT("cur_dialo")>0
					LOCATE
					SCAN
						thisform.grid1.additem(ALLTRIM(cur_dialo.crevin_desc)+chr(9)+TRANSFORM(cur_dialo.crevin_impo, "$ 999,999,999.99"))
						with thisform
							.grid1.row=.grid1.rows-1
							.grid1.col=0
							if len(allt(.grid1.text))>47
								div=len(allt(.grid1.text))/47
								if div>int(div)
									longdes=int(div)+1
								else
									longdes=div
								endif
								longdes=longdes*250
								.grid1.rowheight(.grid1.row)=longdes
							else
								.grid1.rowheight(.grid1.row)=270
							endif
							.grid1.col=0
							.grid1.cellalignment=0
							.grid1.col=1
							.grid1.cellalignment=8
						endwith		
					ENDSCAN
				endif
				thisform.lst_dilo.Selected(1)=.T.
				thisform.command2.enabled=.T.
			ENDIF
		endwith
		
		
	ENDPROC

	PROCEDURE Command1.Click
		local paso
		paso=0
		thisform.grid1.rows=1
		do form cliload with codicli
		WITH thisform
			.text1.value=cur_clie.cli_nomb
			.text2.value=cur_clie.cli_domi
			.text6.value=cur_clie.cond_desc
			.text12.value=cur_clie.cli_cuit
			.text3.value=cur_clie.cp_nro
			.text4.value=cur_clie.loca_nomb
			.text5.value=cur_clie.provi_nomb
			frmdivlo= conectar_db(_screen.cn)
				SQLEXEC(frmdivlo,"select crev_codi,crev_fech from creintv where cli_codi=?codicli order by crev_fech,crev_codi desc;","cur_dil")
			desconectar_db(frmdivlo)
			IF RECCOUNT("cur_dil")>0
				thisform.lst_dilo.RowSource="cur_dil"
				frmdivlo= conectar_db(_screen.cn)
					SQLEXEC(frmdivlo,"select crevin_desc,crevin_impo from creintv_items where crev_codi=?cur_dil.crev_codi;","cur_dialo")
				desconectar_db(frmdivlo)
				IF RECCOUNT("cur_dialo")>0
					LOCATE
					SCAN
						thisform.grid1.additem(ALLTRIM(cur_dialo.crevin_desc)+chr(9)+TRANSFORM(cur_dialo.crevin_impo, "$ 999,999,999.99"))
						with thisform
							.grid1.row=.grid1.rows-1
							.grid1.col=0
							if len(allt(.grid1.text))>47
								div=len(allt(.grid1.text))/47
								if div>int(div)
									longdes=int(div)+1
								else
									longdes=div
								endif
								longdes=longdes*250
								.grid1.rowheight(.grid1.row)=longdes
							else
								.grid1.rowheight(.grid1.row)=270
							endif
							.grid1.col=0
							.grid1.cellalignment=0
							.grid1.col=1
							.grid1.cellalignment=8
						endwith		
					ENDSCAN
				ENDIF
				thisform.lst_dilo.Selected(1)=.T.
				thisform.command2.enabled=.T.
			ENDIF
		ENDWITH
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord

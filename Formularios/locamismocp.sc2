DEFINE CLASS locamismocp AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grd_locali" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grd_locali.Column1.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grd_locali.Column1.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grd_locali.Column2.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grd_locali.Column2.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grd_locali.Column3.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grd_locali.Column3.Text1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 0,128,192
		BorderStyle = 0
		Caption = "Localidades con el mismo Código Postal"
		DoCreate = .T.
		Height = 268
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "LOCAMISMOCP"
		Width = 568
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		Caption = "Otra localidad con el mismo \<Código Postal", ;
		Height = 23, ;
		Left = 137, ;
		Name = "Command1", ;
		TabIndex = 2, ;
		Top = 233, ;
		Width = 294
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grd_locali' AS grid WITH ;
		ColumnCount = 3, ;
		DeleteMark = .F., ;
		FontBold = .T., ;
		GridLineColor = 185,185,185, ;
		HeaderHeight = 27, ;
		Height = 209, ;
		HighlightBackColor = 211,227,245, ;
		HighlightForeColor = 0,64,128, ;
		Left = 26, ;
		Name = "grd_locali", ;
		Panel = 1, ;
		ReadOnly = .T., ;
		RecordMark = .F., ;
		RecordSource = "''", ;
		ScrollBars = 2, ;
		TabIndex = 1, ;
		Themes = .F., ;
		Top = 16, ;
		Width = 516, ;
		Column1.ControlSource = "", ;
		Column1.FontBold = .T., ;
		Column1.Name = "Column1", ;
		Column1.ReadOnly = .T., ;
		Column1.Width = 73, ;
		Column2.ControlSource = "", ;
		Column2.FontBold = .T., ;
		Column2.Name = "Column2", ;
		Column2.ReadOnly = .T., ;
		Column2.Width = 235, ;
		Column3.ControlSource = "", ;
		Column3.FontBold = .T., ;
		Column3.Name = "Column3", ;
		Column3.ReadOnly = .T., ;
		Column3.Width = 186
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'grd_locali.Column1.Header1' AS header WITH ;
		Alignment = 2, ;
		BackColor = 0,64,128, ;
		Caption = "CP", ;
		FontBold = .T., ;
		ForeColor = 255,255,255, ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grd_locali.Column1.Text1' AS textbox WITH ;
		BackColor = 255,255,255, ;
		BorderStyle = 0, ;
		FontBold = .T., ;
		ForeColor = 0,0,0, ;
		Margin = 0, ;
		Name = "Text1", ;
		ReadOnly = .T.
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grd_locali.Column2.Header1' AS header WITH ;
		Alignment = 2, ;
		BackColor = 0,64,128, ;
		Caption = "Localidad", ;
		FontBold = .T., ;
		ForeColor = 255,255,255, ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grd_locali.Column2.Text1' AS textbox WITH ;
		BackColor = 255,255,255, ;
		BorderStyle = 0, ;
		FontBold = .T., ;
		ForeColor = 0,0,0, ;
		Margin = 0, ;
		Name = "Text1", ;
		ReadOnly = .T.
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grd_locali.Column3.Header1' AS header WITH ;
		Alignment = 2, ;
		BackColor = 0,64,128, ;
		Caption = "Provincia", ;
		FontBold = .T., ;
		ForeColor = 255,255,255, ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grd_locali.Column3.Text1' AS textbox WITH ;
		BackColor = 255,255,255, ;
		BorderStyle = 0, ;
		FontBold = .T., ;
		ForeColor = 0,0,0, ;
		Margin = 0, ;
		Name = "Text1", ;
		ReadOnly = .T.
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		parameter codp,codloca,locali,provi
		frmlocmis= conectar_db(_screen.cn)
			SQLEXEC(frmlocmis,"select b.cp_nro,a.loca_nomb,c.provi_nomb,a.loca_codi,a.cp_codi from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on a.provi_codi=c.provi_codi and a.cp_codi=?codp order by a.loca_nomb;","cur_loc")
		desconectar_db(frmlocmis)
		IF RECCOUNT("cur_loc")>0
			GO top
			thisform.grd_locali.RecordSource="cur_loc"
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		return codp
		return codloca
		return locali
		return provi
	ENDPROC

	PROCEDURE Command1.Click
		*!*	sele codipostales
		*!*	set order to cp_codi
		*!*	seek codp
		codloca=0
		provi=cur_loc.provi_nomb
		thisform.release
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE grd_locali.Column1.Text1.Click
		codp=cur_loc.cp_codi
		codloca=cur_loc.loca_codi
		locali=cur_loc.loca_nomb
		provi=cur_loc.provi_nomb
		postal=cur_loc.cp_nro
		thisform.release
	ENDPROC

	PROCEDURE grd_locali.Column2.Text1.Click
		codp=cur_loc.cp_codi
		codloca=cur_loc.loca_codi
		locali=cur_loc.loca_nomb
		provi=cur_loc.provi_nomb
		postal=cur_loc.cp_nro
		thisform.release
	ENDPROC

	PROCEDURE grd_locali.Column3.Text1.Click
		codp=cur_loc.cp_codi
		codloca=cur_loc.loca_codi
		locali=cur_loc.loca_nomb
		provi=cur_loc.provi_nomb
		postal=cur_loc.cp_nro
		thisform.release
	ENDPROC

ENDDEFINE

				if this.rowsel>this.row
					.command1.caption="\<Anular Pendientes"
				else
					.command1.caption="\<Anular Pendiente"
				endif
				.command1.visible=.T.
			endif
		endwith
	ENDPROC

	PROCEDURE lst_clientes.Click
		with thisform
			.grid1.rows=1
			.grd_pedidos.recordsource=''
			.grd_pedidos.refresh
			frmpendcli= conectar_db(_screen.cn)
				SQLEXEC(frmpendcli,"select if(notaped_nro>0,concat('NP',trim(cast(notaped_nro as char))),ped_codi) as pednro,ped_fech,ped_codi from pedidos where cli_codi=?val(this.value) and cumplido<>'S';","cur_pendp")
			desconectar_db(frmpendcli)
			IF RECCOUNT("cur_pendp")>0
				.grd_pedidos.recordsource="cur_pendp"
			ENDIF
			this.boundcolumn=1
			.label5.caption="Pedidos Pendientes de: "+allt(this.value)
			.label5.visible=.T.
			this.boundcolumn=2
		endwith
	ENDPROC

	PROCEDURE lst_clientes.GotFocus
		thisform.command1.visible=.F.
	ENDPROC

	PROCEDURE lst_clientes.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nkeycode = 13 then
			with thisform
				.grid1.rows=1
				.grd_pedidos.recordsource=''
				.grd_pedidos.refresh
				frmpendcli= conectar_db(_screen.cn)
					SQLEXEC(frmpendcli,"select if(notaped_nro>0,concat('NP',trim(cast(notaped_nro as char))),ped_codi) as pednro,ped_fech,ped_codi from pedidos where cli_codi=?val(this.value) and cumplido<>'S';","cur_pendp")
				desconectar_db(frmpendcli)
				IF RECCOUNT("cur_pendp")>0
					.grd_pedidos.recordsource="cur_pendp"
				ENDIF
				this.boundcolumn=1
				.label5.caption="Pedidos Pendientes de: "+allt(this.value)
				.label5.visible=.T.
				this.boundcolumn=2
			ENDWITH
		ENDIF
		
		
	ENDPROC

	PROCEDURE txtcliload.InteractiveChange
		if subst(allt(this.value),1,1)="?"
			SELECT cur_clie
			SET FILTER TO
		ENDIF
		if subst(allt(this.value),1,1)!="?"
				sele cur_clie
				local lc
				lc = allt(This.Value)
				if last()<>127 and last()<>7
					do while !eof()
						if lc=subst(cur_clie.cli_nomb,1,len(lc))
							exit
						else
							skip
							thisform.d=thisform.d+1
							if eof()
								go top
								thisform.d=1
								exit
							endif
						endif
					enddo
				else
					do while lc=subst(cur_clie.cli_nomb,1,len(lc)) and thisform.d>1
						if bof()
							exit
						endif
						skip-1
						if thisform.d>1
							thisform.d=thisform.d-1
						endif
						if lc<>subst(cur_clie.cli_nomb,1,len(lc))
							skip
							thisform.d=thisform.d+1
							exit
						endif
					enddo
				endif
			thisform.lst_clientes.selected(thisform.d)=.T.
			return
		endif
		
	ENDPROC

	PROCEDURE txtcliload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
				if subst(allt(this.value),1,1)="?"
					cade=subst(allt(this.value),2,len(allt(this.value)))
					sele cur_clie
					set filter to atcline(cade,cli_nomb)!=0
				else
				with thisform
					.grid1.rows=1
					.grd_pedidos.recordsource=''
					.grd_pedidos.refresh
					frmpendcli= conectar_db(_screen.cn)
						SQLEXEC(frmpendcli,"select if(notaped_nro>0,concat('NP',trim(cast(notaped_nro as char))),ped_codi) as pednro,ped_fech,ped_codi from pedidos where cli_codi=?val(.lst_clientes.value) and cumplido<>'S';","cur_pendp")
					desconectar_db(frmpendcli)
					IF RECCOUNT("cur_pendp")>0
						.grd_pedidos.recordsource="cur_pendp"
					ENDIF
					.lst_clientes.boundcolumn=1
					.label5.caption="Pedidos Pendientes de: "+allt(.lst_clientes.value)
					.label5.visible=.T.
					.lst_clientes.boundcolumn=2
				ENDWITH
				endif
			case last()=5
				if thisform.d>1
					thisform.d=thisform.d-1
					skip-1
				endif
				thisform.lst_clientes.selected(thisform.d)=thisform.d
				this.value=thisform.lst_clientes.value
			case last()=24
				if thisform.d<thisform.lst_clientes.listcount
					thisform.d=thisform.d+1
					skip
				endif
				thisform.lst_clientes.selected(thisform.d)=thisform.d
				this.value=thisform.lst_clientes.value
			case last()=27
				thisform.release
		endcase
	ENDPROC

ENDDEFINE


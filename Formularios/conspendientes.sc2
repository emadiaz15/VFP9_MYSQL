				if this.rowsel>this.row
					.command1.caption="\<Anular Pendientes"
				else
					.command1.caption="\<Anular Pendiente"
				endif
				.command1.visible=.T.
			endif
		endwith
	ENDPROC

	PROCEDURE grid1.MouseUp
		*** ActiveX Control Event ***
		LPARAMETERS button, shift, x, y

	PROCEDURE Init
		public preg,consul,codicli,codp,paso
		LOCAL vendn
		preg=0
		copnsul=0
		codicli=0
		codp=0
		set date british
		set cent on
		set deleted on
		with thisform
			.text1.value=DATE()
			vendn=UPPER(substr(sys(0),ATC("#",sys(0))+2))
			frmpendcli= conectar_db(_screen.cn)
				SQLEXEC(frmpendcli,"select * from vendedores where ven_nomb=?vendn;","cur_ven")
				if reccount("cur_ven")>0
					ven=ven_codi
				ELSE
					ven=0
				ENDIF
				IF ven>0
					SQLEXEC(frmpendcli,"select distinct b.cli_nomb,b.cli_codi from pedidos as a inner join clientes as b on a.cli_codi=b.cli_codi where a.cumplido<>'S' and b.zona_codi in (select zona_codi from zonas where ven_codi=?ven) order by b.cli_nomb;","cur_clie")
				else
					SQLEXEC(frmpendcli,"select distinct b.cli_nomb,b.cli_codi from pedidos as a inner join clientes as b on a.cli_codi=b.cli_codi where a.cumplido<>'S' order by b.cli_nomb;","cur_clie")
				endif
			desconectar_db(frmpendcli)
			IF RECCOUNT("cur_clie")>0
				.lst_clientes.rowsource="cur_clie"
			ENDIF
		endwith
	ENDPROC

	PROCEDURE Command1.Click
		local articulo,can,xcant,filap,filau,vendn,codiar
		STORE 0 TO articulo, can, codiar
		with thisform
			if .grid1.rowsel>.grid1.row
				preg=messagebox("¿Confirma la anulación de todos los Pendientes seleccionados?",4+48+256,"Anulación de Pendientes")
				if preg=6
					filap=.grid1.row
					filau=.grid1.rowsel
					codp=cur_pendp.ped_codi
					.lst_clientes.boundcolumn=2
					codicli=val(.lst_clientes.value)
					for i=filap to filau
						.grid1.row=i
						.grid1.col=2
						can=ConverNro(.grid1.text)
						.grid1.col=0
						codiar=val(.grid1.text)
						.grid1.col=3
						articulo=val(.grid1.text)
						frmpendcli= conectar_db(_screen.cn)
							SQLEXEC(frmpendcli,"update pedidos_articulos set artped_ent=artped_cant where artped_codi=?articulo;")
		*!*						IF codiar > 5
		*!*							SQLEXEC(frmpendcli,"update articulos set pedidos=pedidos-?can where art_codi=?codiar;")
		*!*						ENDIF
						desconectar_db(frmpendcli)
						IF codiar > 5
							Campo_ped(codiar)
						ENDIF				
					next
				endif
			ELSE
				.grid1.col=2
				can=ConverNro(.grid1.text)
				.grid1.col=3
				articulo=val(.grid1.text)
				frmpendcli= conectar_db(_screen.cn)
					SQLEXEC(frmpendcli,"select a.*,b.art_med from pedidos_articulos a inner join articulos b on a.art_codi=b.art_codi where a.artped_codi=?articulo;","cur_artilo")
				desconectar_db(frmpendcli)
				if RECCOUNT("cur_artilo")>0
					.lst_clientes.boundcolumn=2
					codicli=val(.lst_clientes.value)
					codp=cur_pendp.ped_codi
					.grid1.col=1
					consul=messagebox("Cantidad pendiente de "+allt(.grid1.text)+" "+iif(can>int(can),allt(str(can,10,2)),allt(str(can)))+" "+allt(cur_artilo.art_med)+chr(13)+chr(13)+ ;
									  "¿Anula el total de los pendientes?",4+48+256,"Anulación de Pendientes")
					if consul=6
						.lst_clientes.boundcolumn=1
						preg=messagebox("¿Confirma la anulación de los pendientes de "+allt(.grid1.text)+" del pedido Nº: "+allt(cur_pendp.pednro)+" de "+allt(.lst_clientes.value)+"?",4+48+256,"Advertencia!!!")
						if preg=6
							frmpendcli= conectar_db(_screen.cn)
								SQLEXEC(frmpendcli,"update pedidos_articulos set artped_ent=artped_cant where artped_codi=?articulo;")
		*!*							IF cur_artilo.art_codi > 5
		*!*								SQLEXEC(frmpendcli,"update articulos set pedidos=pedidos-?can where art_codi=?cur_artilo.art_codi;")
		*!*							ENDIF
							desconectar_db(frmpendcli)
							IF cur_artilo.art_codi > 5
								Campo_ped(cur_artilo.art_codi)
							ENDIF					
						endif
					else
						.grid1.col=2
						can=ConverNro(.grid1.text)
						do form cantanupend with can TO ncant
						.grid1.col=1
						.lst_clientes.boundcolumn=1
						preg=messagebox("¿Confirma la anulación de "+iif(ncant.xcant>int(ncant.xcant),allt(str(ncant.xcant,10,2)),allt(str(ncant.xcant)))+" pendientes de "+allt(.grid1.text)+" del pedido Nº: "+allt(cur_pendp.pednro)+" de "+allt(.lst_clientes.value)+"?",4+48+256,"Advertencia!!!")
						if preg=6
							frmpendcli= conectar_db(_screen.cn)
								SQLEXEC(frmpendcli,"update pedidos_articulos set artped_ent=artped_ent+?ncant.xcant where artped_codi=?articulo;")
		*!*							IF cur_artilo.art_codi > 0
		*!*								SQLEXEC(frmpendcli,"update articulos set pedidos=pedidos-?ncant.xcant where art_codi=?cur_artilo.art_codi;")
		*!*							ENDIF
							desconectar_db(frmpendcli)
							IF cur_artilo.art_codi > 5
								Campo_ped(cur_artilo.art_codi)
							ENDIF					
						endif			
					endif
				endif
			endif
			if preg=6
				do cumplido with cur_pendp.ped_codi
				for i=1 to .lst_clientes.listcount
					if .lst_clientes.selected(i)=.T.
						.lst_clientes.selected(i)=.F.
					ENDIF
				NEXT
				vendn=UPPER(substr(sys(0),ATC("#",sys(0))+2))
				frmpendcli= conectar_db(_screen.cn)
					SQLEXEC(frmpendcli,"select * from vendedores where ven_nomb=?vendn;","cur_ven")
					if reccount("cur_ven")>0
						ven=ven_codi
					ELSE
						ven=0
					ENDIF
					IF ven>0
						SQLEXEC(frmpendcli,"select distinct b.cli_nomb,b.cli_codi from pedidos as a inner join clientes as b on a.cli_codi=b.cli_codi where a.cumplido<>'S' and b.zona_codi in (select zona_codi from zonas where ven_codi=?ven) order by b.cli_nomb;","cur_clie")
					else
						SQLEXEC(frmpendcli,"select distinct b.cli_nomb,b.cli_codi from pedidos as a inner join clientes as b on a.cli_codi=b.cli_codi where a.cumplido<>'S' order by b.cli_nomb;","cur_clie")
					endif
				desconectar_db(frmpendcli)
				.lst_clientes.refresh
				IF RECCOUNT("cur_clie")>0
					.lst_clientes.rowsource="cur_clie"
				ENDIF
				.lst_clientes.boundcolumn=2
				for i=1 to .lst_clientes.listcount
					if val(.lst_clientes.list(i,2))=codicli
						.lst_clientes.selected(i)=.T.
						exit
					endif
				next
				if codicli=val(.lst_clientes.value)
					.grid1.rows=1
					.grd_pedidos.recordsource=''
					.grd_pedidos.refresh
					frmpendcli= conectar_db(_screen.cn)
						SQLEXEC(frmpendcli,"select if(notaped_nro>0,concat('NP',trim(cast(notaped_nro as char))),ped_codi) as pednro,ped_fech,ped_codi from pedidos where cli_codi=?val(.lst_clientes.value) and cumplido<>'S';","cur_pendp")
					desconectar_db(frmpendcli)
					IF RECCOUNT("cur_pendp")>0
						LOCATE FOR cur_pendp.ped_codi=codp
						IF !found()
							GO top
						endif
						.grd_pedidos.recordsource="cur_pendp"
					ENDIF
					.lst_clientes.boundcolumn=1
					.label5.caption="Pedidos Pendientes de: "+allt(.lst_clientes.value)
					.label5.visible=.T.
					if codp=cur_pendp.ped_codi
						frmpendcli= conectar_db(_screen.cn)
							SQLEXEC(frmpendcli,"select a.*,b.art_desc from pedidos_articulos a inner join articulos b on a.art_codi=b.art_codi where ped_codi=?cur_pendp.ped_codi and a.artped_ent<a.artped_cant;","cur_detap")
						desconectar_db(frmpendcli)
						if RECCOUNT("cur_detap")>0
							GO top
							SCAN
								cadena=repl("0",8-len(allt(str(cur_detap.art_codi))))+allt(str(cur_detap.art_codi))
								calculo=cur_detap.artped_cant-cur_detap.artped_ent
								if cur_detap.art_codi<=5
									thisform.grid1.additem(cadena+chr(9)+cur_detap.artped_dasc+chr(9)+str(calculo,10,2)+CHR(9)+STR(cur_detap.artped_codi))
								else
									thisform.grid1.additem(cadena+chr(9)+cur_detap.art_desc+chr(9)+str(calculo,10,2)+CHR(9)+STR(cur_detap.artped_codi))
								ENDIF
								.grid1.row=thisform.grid1.rows-1
								.grid1.col=2
								if len(allt(thisform.grid1.text))>44
									div=len(allt(thisform.grid1.text))/44
									if div>int(div)
										longdes=int(div)+1
									else
										longdes=div
									endif
									longdes=longdes*240
									thisform.grid1.rowheight(thisform.grid1.row)=longdes
								else
									thisform.grid1.rowheight(thisform.grid1.row)=270
								endif
							ENDSCAN
						endif
					endif
				else
					thisform.grd_pedidos.RecordSource=''
					thisform.grd_pedidos.refresh
					.grid1.rows=1
				endif
			endif
		endwith
		this.visible=.F.
	ENDPROC


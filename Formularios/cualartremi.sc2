DEFINE CLASS cualart AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label6" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Edit1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 211,216,207
		BorderStyle = 0
		Caption = "Artículo a Insertar"
		DoCreate = .T.
		Height = 157
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "cualart"
		Width = 551
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Localizar Artículo", ;
		DisabledBackColor = 33,146,214, ;
		ForeColor = 255,255,255, ;
		Height = 24, ;
		Left = 196, ;
		Name = "Command1", ;
		TabIndex = 4, ;
		Themes = .F., ;
		Top = 120, ;
		Width = 152
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Edit1' AS editbox WITH ;
		ControlSource = "descrip", ;
		Height = 72, ;
		Left = 281, ;
		Name = "Edit1", ;
		ReadOnly = .T., ;
		TabIndex = 9, ;
		Top = 34, ;
		Visible = .F., ;
		Width = 243
		*< END OBJECT: BaseClass="editbox" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 211,216,207, ;
		Caption = "CÓDIGO", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 25, ;
		Name = "Label1", ;
		TabIndex = 5, ;
		Top = 35, ;
		Width = 47
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label2' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 211,216,207, ;
		Caption = "CANTIDAD", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 126, ;
		Name = "Label2", ;
		TabIndex = 6, ;
		Top = 35, ;
		Width = 60
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label3' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 211,216,207, ;
		Caption = "DESCRIPCIÓN", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 200, ;
		Name = "Label3", ;
		TabIndex = 7, ;
		Top = 35, ;
		Width = 80
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label6' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 211,216,207, ;
		Caption = "        Detalle del Artículo        ", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 37, ;
		Name = "Label6", ;
		TabIndex = 8, ;
		Top = 5, ;
		Width = 156
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackStyle = 0, ;
		Height = 96, ;
		Left = 7, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;
		Top = 12, ;
		Width = 533
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Text1' AS textbox WITH ;
		Format = "LK", ;
		Height = 23, ;
		InputMask = "########", ;
		Left = 18, ;
		Name = "Text1", ;
		TabIndex = 1, ;
		Top = 56, ;
		Width = 96
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text2' AS textbox WITH ;
		Alignment = 1, ;
		Format = "K", ;
		Height = 23, ;
		Left = 126, ;
		Name = "Text2", ;
		TabIndex = 2, ;
		Top = 56, ;
		Width = 60
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text3' AS textbox WITH ;
		Height = 23, ;
		Left = 197, ;
		Name = "Text3", ;
		ReadOnly = .T., ;
		TabIndex = 3, ;
		Top = 56, ;
		Width = 324
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		on key label INS
		
		
	ENDPROC

	PROCEDURE Destroy
		on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
		if last()=27 or codigo=0
			muestro=0
		endif
		
	ENDPROC

	PROCEDURE Init
		parameter opcion,dato1,dato2,dato3,codigo,cant,descri
		codigo=0
		if opcion=2
			insertar=1
		endif
		if codigo=0
			this.text1.value=0
		endif
		if paso=1
			with this
				.text1.value=dato1
				.text2.value=dato2
				.text3.value=dato3
				.SetAll("Format", "K", "Textbox")
			endwith
		endif
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			muestro=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE Unload
		return codigo
		return cant
		return descri
		return opcion
	ENDPROC

	PROCEDURE Command1.Click
		codigo=0
		do form artload with codigo
		if codigo>0
			thisform.text1.value=cur_art.art_codi
			thisform.text3.value=cur_art.art_desc
			thisform.text1.setfocus
		else
			thisform.text1.setfocus
		endif
		thisform.SetAll("Format", "KL", "Textbox")
		thisform.setall("Enabled",.F.,"CommandButton")
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Text1.Click
		this.refresh
		this.setfocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		thisform.setall("Enabled",.T.,"CommandButton")
	ENDPROC

	PROCEDURE Text1.Valid
		if this.value<>0
			frmcuarem= conectar_db(_screen.cn)
				SQLEXEC(frmcuarem,"select * from articulos where art_codi=?this.value;","cur_arti")
			desconectar_db(frmcuarem)
			if RECCOUNT("cur_arti")>0
				if art_codi<>4 OR art_codi<>5
					frmcualart= conectar_db(_screen.cn)
						DO CASE
							CASE codicli>0
								SQLEXEC(frmcualart,"select * from desc_articulos_clientes where artcli_codi = any (select artcli_codi from articulos_clientes where art_codi=?this.value and cli_codi=?codicli);","cur_difdes")
							CASE codiprov>0
								SQLEXEC(frmcualart,"select * from desc_articulos_proveedores where artpro_codi = any (select artpro_codi from articulos_proveedores where art_codi=?this.value and prov_codi=?codiprov);","cur_difdes")
						ENDCASE
					desconectar_db(frmcualart)
					IF RECCOUNT("cur_difdes")>0
						count all to cdd
						if cdd>0
							IF codicli>0
								codiprov=0
							ELSE
								codicli=0
							ENDIF
							descri=""
							do form diferentesdesc with codicli,codiprov,descri,this.value
							if not isblank(descri)
								thisform.text3.value=allt(descri)
							else
								thisform.text3.value=cur_arti.art_desc
							endif
						endif
					else
						thisform.text3.value=cur_arti.art_desc
					endif
				endif
				if paso<>1
					thisform.setall("Enabled",.F.,"CommandButton")
				endif
		*		if art_codi=4
		*			do form artsincodi with descrip
		*			thisform.text3.visible=.F.
		*			thisform.text3.value=descrip
		*			thisform.edit1.value=descrip
		*			thisform.edit1.visible=.T.
		*			codigo=1
		*		endif
			else
				messagebox("Artículo no está en archivo",0+48,"Advertencia")
				this.value=0
				return 0
			endif
		endif
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			if cur_arti.art_codi=4 OR cur_arti.art_codi=5
				do form artsincodi with descrip
				thisform.text3.visible=.F.
				thisform.text3.value=descrip
				thisform.edit1.value=descrip
				thisform.edit1.visible=.T.
		*		codigo=1
			endif
			codigo=thisform.text1.value
			cant=thisform.text2.value
			descri=thisform.text3.value
			store 1 to muestro
			thisform.release
		endif
		
	ENDPROC

ENDDEFINE


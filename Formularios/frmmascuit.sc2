		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'Grid1.Column1.Text1' AS textbox WITH ;
		BackColor = 255,255,255, ;
		BorderStyle = 0, ;
		FontBold = .T., ;
		ForeColor = 0,0,0, ;
		Margin = 0, ;
		Name = "Text1"
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'lbl_clipro' AS label WITH ;
		AutoSize = .T., ;
		BackStyle = 0, ;
		Caption = "Label1", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 32, ;
		Name = "lbl_clipro", ;
		Top = 17, ;
		Width = 40
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Destroy
		RETURN sino
	ENDPROC

	PROCEDURE Init
		PARAMETERS xclipro,xcuit,sino
		
		DO case
			CASE xclipro=1
				this.caption="Clientes con el mismo CUIT"
				thisform.lbl_clipro.Caption="Se encontraron en archivo los siguientes Clientes con el mismo CUIT:"
				thisform.grid1.column1.header1.Caption="CLIENTES ENCONTRADOS"
				frmcuit= conectar_db(_screen.cn)
					SQLEXEC(frmcuit,"select cli_nomb from clientes where cli_cuit=?xcuit order by cli_nomb;","cur_clicu")
				desconectar_db(frmcuit)
				GO top
				thisform.grid1.RecordSource="cur_clicu"
			CASE xclipro=2
				this.caption="Proveedores con el mismo CUIT"
				thisform.lbl_clipro.Left=thisform.lbl_clipro.Left-13
				thisform.lbl_clipro.Caption="Se encontraron en archivo los siguientes Proveedores con el mismo CUIT:"
				thisform.grid1.column1.header1.Caption="PROVEEDORES ENCONTRADOS"
				frmcuit= conectar_db(_screen.cn)
					SQLEXEC(frmcuit,"select prov_nomb from proveedores where prov_cuit=?xcuit order by prov_nomb;","cur_procu")
				desconectar_db(frmcuit)
				GO top
				thisform.grid1.RecordSource="cur_procu"
			CASE xclipro=3
				this.caption="Proveedores de Servicios con el mismo CUIT"
				thisform.lbl_clipro.Left=thisform.lbl_clipro.Left-13
				thisform.lbl_clipro.Caption="Se encontraron en archivo los siguientes Proveedores con el mismo CUIT:"
				thisform.grid1.column1.header1.Caption="PROVEEDORES ENCONTRADOS"
				frmcuit= conectar_db(_screen.cn)
					SQLEXEC(frmcuit,"select per_desc from personas where per_cuit=?xcuit order by per_desc;","cur_procu")
				desconectar_db(frmcuit)
				GO top
				thisform.grid1.RecordSource="cur_procu"
		ENDCASE
		
	ENDPROC

	PROCEDURE Command1.Click
		sino=1
		thisform.Release
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		sino=0
		thisform.Release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

ENDDEFINE

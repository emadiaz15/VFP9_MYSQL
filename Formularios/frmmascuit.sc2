DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Grid1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Grid1.Column1.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Grid1.Column1.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lbl_clipro" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command2" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 189,221,221
		BorderStyle = 0
		Caption = ""
		Closable = .F.
		DoCreate = .T.
		Height = 350
		Icon = ..\imagen\clipro.ico
		MaxButton = .F.
		MinButton = .F.
		Name = "Form1"
		Width = 460
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "Con\<tinuar", ;
		ForeColor = 255,255,255, ;
		Height = 30, ;
		Left = 111, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 298, ;
		Width = 99
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command2' AS commandbutton WITH ;
		BackColor = 227,68,34, ;
		Caption = "\<Cancelar", ;
		ForeColor = 255,255,255, ;
		Height = 30, ;
		Left = 249, ;
		Name = "Command2", ;
		Themes = .F., ;
		Top = 298, ;
		Width = 99
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Grid1' AS grid WITH ;
		AllowCellSelection = .F., ;
		ColumnCount = 1, ;
		DeleteMark = .F., ;
		FontBold = .T., ;
		GridLineColor = 185,185,185, ;
		Height = 237, ;
		HighlightBackColor = 211,227,245, ;
		HighlightForeColor = 0,64,128, ;
		Left = 21, ;
		Name = "Grid1", ;
		Panel = 1, ;
		RecordMark = .F., ;
		RecordSource = "''", ;
		ScrollBars = 2, ;
		Themes = .F., ;
		Top = 45, ;
		Width = 415, ;
		Column1.ControlSource = "", ;
		Column1.FontBold = .T., ;
		Column1.Name = "Column1", ;
		Column1.Width = 395
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'Grid1.Column1.Header1' AS header WITH ;
		Alignment = 2, ;
		BackColor = 0,64,128, ;
		Caption = "", ;
		FontBold = .T., ;
		ForeColor = 255,255,255, ;

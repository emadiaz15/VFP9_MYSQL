	PROCEDURE Destroy
		set skip of bar 1 of Modificaci .F.
	ENDPROC

	PROCEDURE Init
		public localiz,postal,locali,provi,op,codloca,cp,codicli
		localiz=0
		postal=0
		locali=""
		provi=""
		codloca=0
		op=0
		codicli=0
		
		frmmodic= conectar_db(_screen.cn)
			SQLEXEC(frmmodic,"select provi_nomb,provi_codi from provincias order by provi_nomb;","curprovi")
			SQLEXEC(frmmodic,"select zona_desc,zona_codi from zonas order by zona_codi;","curzona")
		desconectar_db(frmmodic)
		this.combo1.RowSource="curprovi"
		this.combo2.RowSource="curzona"
		
	ENDPROC

	PROCEDURE Load
		set skip of bar 1 of Modificaci .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if prompt()<>"Datos Clientes"
		*!*		set skip of bar 1 of Modificaci .F.
		*!*		thisform.hide
		*!*	endif
		
	ENDPROC

	PROCEDURE Btn_detalle1.img_deta.Click
		IF thisform.Height= 584
			thisform.height= 456
			thisform.label15.Visible= .F.
			thisform.edt_deta.Visible= .F.
			thisform.shape2.Visible= .F.
			thisform.command1.Top=406
			thisform.command2.Top=406
			thisform.command3.Top=406
		ELSE
			thisform.height= 584
			thisform.label15.Visible= .T.
			thisform.edt_deta.Visible= .T.
			thisform.shape2.Visible= .T.
			thisform.command1.Top=541
			thisform.command2.Top=541
			thisform.command3.Top=541
			thisform.edt_deta.SetFocus
		ENDIF
		thisform.AutoCenter= .T.
		
	ENDPROC

	PROCEDURE Combo1.GotFocus
		keyboard "{F4}"
	ENDPROC

	PROCEDURE Combo1.LostFocus
		if LEN(ALLTRIM(this.text))>0
			xnompro=ALLTRIM(this.text)
			frmmodip= conectar_db(_screen.cn)
				SQLEXEC(frmmodip,"select * from provincias where TRIM(provi_nomb)=?xnompro;","cur_nuepro")
			desconectar_db(frmmodip)
			if RECCOUNT("cur_nuepro")=0
				frmmodip= conectar_db(_screen.cn)
					SQLEXEC(frmmodip,"select MAX(provi_codi) as provi_codi from provincias order by provi_codi;","cur_codp")
					pro=cur_codp.provi_codi+1
					nomnue=ALLTRIM(this.text)
					SQLEXEC(frmmodip,"insert into provincias values(?pro,?nomnue);")
					SQLEXEC(frmmodip,"select provi_nomb,provi_codi from provincias order by provi_nomb;","curprovi")
				desconectar_db(frmmodip)
				this.RowSource = "curprovi"
				this.requery
				this.value=allt(this.text)
				frmmodip= conectar_db(_screen.cn)
					SQLEXEC(frmmodip,"update localidades set provi_codi=?pro where loca_codi=?codloca;")
				desconectar_db(frmmodip)
			else
				pro=cur_nuepro.provi_codi
				frmmodip= conectar_db(_screen.cn)
					SQLEXEC(frmmodip,"update localidades set provi_codi=?pro where loca_codi=?codloca;")
				desconectar_db(frmmodip)		
			ENDIF
		*!*		thisform.combo2.setfocus
		*!*		keyboard "{F4}"
		endif
		thisform.command2.enabled=.T.
	ENDPROC

	PROCEDURE Combo1.Valid
		*!*	if type("this.text")="C"
		*!*		if this.text=" "
		*!*			messagebox("Recuerde que debe ingresar una Provincia",0+48,"Advertencia!!!")
		*!*		endif
		*!*	endif
	ENDPROC

	PROCEDURE Combo2.Click
		IF LEN(ALLTRIM(this.Value))>0
			KEYBOARD '{TAB}'
		endif
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		con=messagebox("¿Confirma los datos ingresados?",4+32+256,"Datos de Clientes")
		if con=6
			with thisform
				do case
					CASE TYPE("codloca") # "N" OR codloca <= 0
					    =MESSAGEBOX("La localidad no quedó correctamente asociada. Verifique Código Postal, Localidad y Provincia.",0+48,"Advertencia")
					    .text6.SetFocus				
					case len(allt(.text1.value))=0
						=messagebox("No ha ingresado el nombre o denominación del Cliente,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.text1.setfocus
					case len(allt(.text6.value))=0
						=messagebox("No ha ingresado el Código Postal,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.text6.setfocus
					case len(allt(.text3.value))=0
						=messagebox("No ha ingresado la Localidad,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.text3.setfocus
					case len(allt(.combo1.text))=0
						=messagebox("No ha ingresado la Provincia,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.combo1.setfocus
					other case
						LOCAL xopcion, ;
							  xcodigo, ;
		                      xnombre, ;
		                      xdomi, ;
							  xcartel, ;
		                      xtel1, ;
		                      xtel2, ;
		                      xcel, ;
		                      xcuit, ;
		                      xemail, ;
		                      xcond, ;
		                      xzona, ;
		                      xdeta
		    			xopcion = 2
						xcodigo = cur_clie.cli_codi
						xnombre = ALLTRIM(.text1.value)
						xdomi   = ALLTRIM(.text2.value)
						xcartel = VAL(.text11.value)
						xtel1   = VAL(.text7.value)
						xtel2   = VAL(.text10.value)
						xcel    = ALLTRIM(.text8.value)
						xcuit   = VAL(.text5.value)
						xemail  = ALLTRIM(.text9.value)
						xcond   = .optiongroup1.value
						xzona   = curzona.zona_codi
						xdeta   = ALLTRIM(thisform.edt_deta.Value)
						
						frmaltac= conectar_db(_screen.cn)
							SQLEXEC(frmaltac,"call usp_guardar_cliente(?xopcion,?xcodigo,?xnombre,?xdomi,?codloca,?xcartel,?xtel1,?xtel2,?xcel,?xcuit,?xemail,?xcond,?xzona,?xdeta);")
						desconectar_db(frmaltac)
						.SetAll("value", "", "Textbox")
						IF thisform.Height=584
							thisform.label15.Visible= .F.
							thisform.shape2.Visible= .F.
							thisform.edt_deta.Value=''
							thisform.edt_deta.Visible= .F.
							thisform.command1.Top=413
							thisform.command2.Top=413
							thisform.command3.Top=413
							thisform.Height=456
							thisform.AutoCenter= .T.
						ENDIF				
						.combo1.value=""
						.combo2.value=""
						thisform.edt_deta.Value = ''
						this.enabled=.F.
						.text1.setfocus
				endcase
			endwith
		endif
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		do form cliload with codicli
		if codicli>0
			thisform.SetAll("Style",0,"Textbox")
			thisform.text13.Style= 1
			thisform.combo1.Enabled= .T.
			thisform.combo2.Enabled= .T.
			thisform.optiongroup1.Enabled= .T.
			with thisform
				.text13.value=codicli
				.text1.value=cur_clie.cli_nomb
				.text2.value=cur_clie.cli_domi
				.text6.value=allt(str(cur_clie.cp_nro))
				codp=cur_clie.cp_codi
				codloca=cur_clie.loca_codi
				.text3.value=cur_clie.loca_nomb
				.combo1.value=cur_clie.provi_nomb
				.text11.value="0"+allt(cur_clie.cli_cartel)
				.text7.value=allt(cur_clie.cli_tel1)
				.text10.value=allt(cur_clie.cli_tel2)
				.text8.value=ALLTRIM(cur_clie.cli_cel)
				.text9.value=ALLTRIM(cur_clie.cli_email)
				.text5.value=ALLTRIM(cli_cuit)
				IF !ISNULL(ALLTRIM(cur_clie.cli_deta))
					thisform.edt_deta.Value=ALLTRIM(cur_clie.cli_deta)
				ELSE
					thisform.edt_deta.Value=""
				ENDIF
				do case
					case cur_clie.cond_codi=1
						.optiongroup1.value=1
					case cur_clie.cond_codi=2
						.optiongroup1.value=2
					case cur_clie.cond_codi=3
						.optiongroup1.value=3
					case cur_clie.cond_codi=4
						.optiongroup1.value=4
					case cur_clie.cond_codi=5
						.optiongroup1.value=5
				ENDCASE
				frmmodic= conectar_db(_screen.cn)
					SQLEXEC(frmmodic,"select * from zonas where zona_codi=?cur_clie.zona_codi;","cur_zonacli")
				desconectar_db(frmmodic)
				.combo2.value=cur_zonacli.zona_desc
				cerrar_cursor("cur_zonacli")
				.text1.setfocus
				.command2.enabled=.T.
			endwith
		endif
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE edt_deta.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE edt_deta.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Optiongroup1.Click
		if this.value<>1
			thisform.text5.setfocus
		endif
		
	ENDPROC

	PROCEDURE Text3.GotFocus
		if op=7
			thisform.text6.value=""
			thisform.text6.setfocus
		endif
	ENDPROC

	PROCEDURE Text3.LostFocus
		if LEN(ALLTRIM(this.value))>0
			xnomloc=ALLTRIM(this.Value)
			frmmodic= conectar_db(_screen.cn)
				SQLEXEC(frmmodic,"select * from localidades where TRIM(loca_nomb)=?xnomloc;","cur_nueloc")
			desconectar_db(frmmodic)
			if RECCOUNT("cur_nueloc")=0
				frmmodic= conectar_db(_screen.cn)
					SQLEXEC(frmmodic,"select MAX(loca_codi) as loca_codi from localidades order by loca_codi;","cur_codl")
					loc=cur_codl.loca_codi+1
					nomnue=ALLTRIM(this.Value)
					SQLEXEC(frmmodic,"insert into localidades values(?loc,?nomnue,0,?cp,0);")
				desconectar_db(frmmodic)		
				codloca=loc
			else
				if cur_nueloc.cp_codi<>codp
					frmmodic= conectar_db(_screen.cn)
						SQLEXEC(frmmodic,"select MAX(loca_codi) as loca_codi from localidades order by loca_codi;","cur_codl")
						loc=cur_codl.loca_codi+1
						nomnue=ALLTRIM(this.Value)
						SQLEXEC(frmmodic,"insert into localidades values(?loc,?nomnue,0,?codp,0);")
					desconectar_db(frmmodic)		
					codloca=loc
				ELSE
					codloca = cur_nueloc.loca_codi			
				endif
			endif
		endif
		
	ENDPROC

	PROCEDURE Text3.Valid
		*!*	if this.value=" " and last()<>-4
		*!*		messagebox("Debe ingresar la Localidad",0+48,"Advertencia!!!")
		*!*		return 0
		*!*	endif
	ENDPROC

	PROCEDURE Text5.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text5.LostFocus
		thisform.command2.setfocus
	ENDPROC

	PROCEDURE Text6.GotFocus
		thisform.lbl_aviso.Visible=.T.
	ENDPROC

	PROCEDURE Text6.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = -4
			do form locaload with postal,locali,provi,codloca
			if postal>0
				with thisform
					this.value=postal
					.text3.value=locali
					.combo1.value=provi
					thisform.command2.enabled=.T.
					.text11.setfocus
					thisform.lbl_aviso.Visible=.F.
				ENDWITH
			ELSE
				this.setfocus
			ENDIF
		endif
	ENDPROC

	PROCEDURE Text6.LostFocus
		if LEN(ALLTRIM(this.value))>0
			frmmodic= conectar_db(_screen.cn)
				SQLEXEC(frmmodic,"select * from codipostales where cp_nro=?VAL(this.value);","cur_cpn")
			desconectar_db(frmmodic)
			if RECCOUNT()>0
				codp=cur_cpn.cp_codi
				cp=codp
				frmmodic= conectar_db(_screen.cn)
					SQLEXEC(frmmodic,"select a.*,b.provi_nomb from localidades a inner join provincias b on a.provi_codi=b.provi_codi where a.cp_codi=?codp;","cur_lcp")
				desconectar_db(frmmodic)
				IF RECCOUNT()>0
					if RECCOUNT()>1
						do form locamismocp with codp,codloca,locali,provi
						if codloca>0
							thisform.text3.value=locali
							thisform.combo1.value=provi
							thisform.text11.setfocus
							thisform.command2.enabled=.T.
						ELSE
							thisform.combo1.value=provi
							thisform.command2.enabled=.T.
						endif
					else
						con=messagebox("Solo existe en archivo la Localidad "+allt(cur_lcp.loca_nomb)+chr(13)+ ;
									   "de la Provincia de "+allt(cur_lcp.provi_nomb)+" con éste Código Postal "+chr(13)+;
									   "¿Ingresa otra Localidad con el mismo Código? ",4+32+256,"Localidades")
						do case
							case con=6
								thisform.combo1.value=cur_lcp.provi_nomb
								this.value=ALLT(str(cur_cpn.cp_nro))
								thisform.text3.setfocus
							case con=7
								thisform.text3.value=cur_lcp.loca_nomb
								thisform.combo1.value=cur_lcp.provi_nomb
								codloca=cur_lcp.loca_codi
								thisform.command2.enabled=.T.
								thisform.text11.setfocus
						endcase
					ENDIF
					thisform.lbl_aviso.Visible= .F.
		*!*				thisform.combo2.setfocus
		*!*				keyboard "{F4}"
				endif
			else
				op=messagebox("Ud. ha ingresado un nuevo Código Postal"+chr(13)+ ;
							  "¿Confirma el código ingresado?",4+32+256,"Códigos Postales")
				if op=6
					frmmodic= conectar_db(_screen.cn)
						SQLEXEC(frmmodic,"select MAX(cp_codi) as cp_codi from codipostales order by cp_codi;","cur_maxc")
						cp=cur_maxc.cp_codi+1
						codp=cp
						SQLEXEC(frmmodic,"insert into codipostales values(?codp,?val(this.value));")
					desconectar_db(frmmodic)
					thisform.lbl_aviso.Visible= .F.
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Text6.Valid
		*!*	if type("this.value")="C"
		*!*		if this.value=" " and last()<>-4
		*!*			messagebox("Debe ingresar el Código Postal,"+chr(13)+ ;
		*!*					   "O presione F5 para ubicar la localidad",0+48,"Advertencia!!!")
		*!*			return 0
		*!*		endif
		*!*	endif
	ENDPROC

ENDDEFINE

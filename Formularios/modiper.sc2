	PROCEDURE Init
		public localiz,nropostal,locali,provi,op,codloca,cp,codiper,persona
		localiz=0
		nropostal=0
		locali=""
		provi=""
		codloca=0
		op=0
		codiper=0
		persona=''
		frmmodip= conectar_db(_screen.cn)
			SQLEXEC(frmmodip,"select provi_nomb,provi_codi from provincias order by provi_nomb;","curprovi")
		desconectar_db(frmmodip)
		this.combo1.RowSourcetype= 2
		this.combo1.RowSource="curprovi"
	ENDPROC

	PROCEDURE Combo1.LostFocus
		if LEN(ALLTRIM(this.text))>0
			xnompro=ALLTRIM(this.text)
			frmaltap= conectar_db(_screen.cn)
				SQLEXEC(frmaltap,"select * from provincias where TRIM(provi_nomb)=?xnompro;","cur_nuepro")
			desconectar_db(frmaltap)
			if RECCOUNT("cur_nuepro")=0
				frmaltap= conectar_db(_screen.cn)
					SQLEXEC(frmaltap,"select MAX(provi_codi) as provi_codi from provincias order by provi_codi;","cur_codp")
					pro=cur_codp.provi_codi+1
					nomnue=ALLTRIM(this.text)
					SQLEXEC(frmaltap,"insert into provincias values(?pro,?nomnue);")
					SQLEXEC(frmaltap,"select provi_nomb,provi_codi from provincias order by provi_nomb;","curprovi")
				desconectar_db(frmaltap)
				this.RowSource = "curprovi"
				this.requery
				this.value=allt(this.text)
				frmaltap= conectar_db(_screen.cn)
					SQLEXEC(frmaltap,"update localidades set provi_codi=?pro where loca_codi=?codloca;")
				desconectar_db(frmaltap)
			else
				pro=cur_nuepro.provi_codi
				frmaltap= conectar_db(_screen.cn)
					SQLEXEC(frmaltap,"update localidades set provi_codi=?pro where loca_codi=?codloca;")
				desconectar_db(frmaltap)		
			endif
		endif
		thisform.command2.enabled=.T.
	ENDPROC

	PROCEDURE Combo1.Valid
		*!*	if type("this.text")="C"
		*!*		if this.text=" "
		*!*			messagebox("Recuerde que debe ingresar una Provincia",0+48,"Advertencia!!!")
		*!*		endif
		*!*	endif
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		con=messagebox("¿Confirma los datos ingresados?",4+32+256,"Alta de Proveedores")
		if con=6
			with thisform
				do case
					CASE TYPE("codloca") # "N" OR codloca <= 0
					    =MESSAGEBOX("La localidad no quedó correctamente asociada. Verifique Código Postal, Localidad y Provincia.",0+48,"Advertencia")
					    .text6.SetFocus			
					case len(allt(.text1.value))=0
						=messagebox("No ha ingresado el nombre o denominación del Proveedor,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.text1.setfocus
		*!*				case len(allt(.text6.value))=0
		*!*					=messagebox("No ha ingresado el Código Postal,"+chr(13)+ ;
		*!*								"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
		*!*					.text6.setfocus
		*!*				case len(allt(.text3.value))=0
		*!*					=messagebox("No ha ingresado la Localidad,"+chr(13)+ ;
		*!*								"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
		*!*					.text3.setfocus
		*!*				case len(allt(.combo1.text))=0
		*!*					=messagebox("No ha ingresado la Provincia,"+chr(13)+ ;
		*!*								"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
		*!*					.combo1.setfocus
					other case
						LOCAL xopcion, ;
							  xcodigo, ;
		                      xnombre, ;
		                      xdomi, ;
							  xcartel, ;
		                      xtel1, ;
		                      xtel2, ;
		                      xcel, ;
		                      xcuit, ;
		                      xemail, ;
		                      xcond, ;
		                      xpercep, ;
		                      xdto
		    			xopcion = 2
						xcodigo = codiper
						xnombre = ALLTRIM(.text1.value)
						xdomi   = ALLTRIM(.text2.value)
						xcartel = VAL(.text11.value)
						xtel1   = VAL(.text7.value)
						xtel2   = VAL(.text10.value)
						xcel    = ALLTRIM(.text8.value)
						xcuit   = VAL(.text5.value)
						xemail  = ALLTRIM(.text9.value)
						xcond   = .optiongroup1.value
						thisform.cond= .optiongroup1.value
						if .check1.value=1
							xpercep = "S"
						else
							xpercep = "N"
						endif
						xdto    = .text12.value
						frmaltap= conectar_db(_screen.cn)
							SQLEXEC(frmaltap,"call usp_guardar_persona(?xopcion,?xcodigo,?xnombre,?xdomi,?codloca,?xcartel,?xtel1,?xtel2,?xcel,?xcuit,?xemail,?xcond,?xpercep,?xdto);")
						desconectar_db(frmaltap)
						.SetAll("value", "", "Textbox")
						.combo1.value=""
						this.enabled=.F.
						.text1.setfocus
						.text5.value=""
				endcase
			endwith
		endif
			
			
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		if thisform.label9.visible=.T. and thisform.text5.visible=.T.
			thisform.label9.visible=.F.
			thisform.text5.visible=.F.
		ENDIF
		do form perload with codiper
		if codiper>0
			thisform.SetAll("Style",0,"Textbox")
			thisform.text13.Style= 1
			thisform.combo1.Enabled= .T.
			thisform.optiongroup1.Enabled= .T.
			thisform.check1.Enabled= .T.
			frmmodip= conectar_db(_screen.cn)
				SQLEXEC(frmmodip,"call usp_buscarper(?codiper);","cur_per")
			desconectar_db(frmmodip)
			
			with thisform
				.text13.value=codiper
				.text1.value=cur_per.per_desc
				.text2.value=cur_per.per_domi
				.text6.value=IIF(ISNULL(cur_per.cp_nro),"",allt(str(cur_per.cp_nro)))
				codp=IIF(ISNULL(cur_per.cp_codi),0,cur_per.cp_codi)
				codloca=IIF(ISNULL(cur_per.loca_codi),0,cur_per.loca_codi)
				.text3.value=IIF(ISNULL(cur_per.loca_nomb),"",cur_per.loca_nomb)
				.combo1.value=IIF(ISNULL(cur_per.provi_nomb),"",cur_per.provi_nomb)
				.text11.value=IIF(ISNULL(cur_per.per_cartel),"","0"+allt(cur_per.per_cartel))
				.text7.value=ALLTRIM(cur_per.per_tel1)
				.text10.value=ALLTRIM(cur_per.per_tel2)
				.text8.value=ALLTRIM(cur_per.per_cel)
				.text9.value=ALLTRIM(cur_per.per_email)
				.text12.value=cur_per.dtoxpago
				.label9.visible=.T.
				.text5.visible=.T.
				.text5.value=ALLTRIM(cur_per.per_cuit)
				if cur_per.percepcion="S"
					.check1.value=1
				else
					.check1.value=0
				ENDIF
				do case
					case cur_per.cond_codi=1
						.optiongroup1.value=1
					case cur_per.cond_codi=2
						.optiongroup1.value=2
					case cur_per.cond_codi=3
						.optiongroup1.value=3
					case cur_per.cond_codi=4
						.optiongroup1.value=4
					case cur_per.cond_codi=5
						.optiongroup1.value=5
				otherwise
					.optiongroup1.value=0
				endcase
				.text1.setfocus
				.command2.enabled=.T.
			endwith
		endif
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Optiongroup1.Click
		if this.value<>1
			thisform.label9.visible=.T.
			thisform.text5.visible=.T.
			thisform.text5.setfocus
		else
			thisform.label9.visible=.F.
			thisform.text5.visible=.F.
		endif
		
	ENDPROC

	PROCEDURE Text3.GotFocus
		if op=7
			thisform.text6.value=""
			thisform.text6.setfocus
		endif
	ENDPROC

	PROCEDURE Text3.LostFocus
		if LEN(ALLTRIM(this.value))>0
			xnomloc=ALLTRIM(this.Value)
			frmaltap= conectar_db(_screen.cn)
				SQLEXEC(frmaltap,"select * from localidades where TRIM(loca_nomb)=?xnomloc;","cur_nueloc")
			desconectar_db(frmaltap)
			if RECCOUNT("cur_nueloc")=0
				frmaltap= conectar_db(_screen.cn)
					SQLEXEC(frmaltap,"select MAX(loca_codi) as loca_codi from localidades order by loca_codi;","cur_codl")
					loc=cur_codl.loca_codi+1
					nomnue=ALLTRIM(this.Value)
					SQLEXEC(frmaltap,"insert into localidades values(?loc,?nomnue,0,?cp,0);")
				desconectar_db(frmaltap)		
				codloca=loc
			else
				if cur_nueloc.cp_codi<>codp
					frmaltap= conectar_db(_screen.cn)
						SQLEXEC(frmaltap,"select MAX(loca_codi) as loca_codi from localidades order by loca_codi;","cur_codl")
						loc=cur_codl.loca_codi+1
						nomnue=ALLTRIM(this.Value)
						SQLEXEC(frmaltap,"insert into localidades values(?loc,?nomnue,0,?codp,0);")
					desconectar_db(frmaltap)		
					codloca=loc
				ELSE
					codloca = cur_nueloc.loca_codi			
				endif
			endif
		endif
		
	ENDPROC

	PROCEDURE Text3.Valid
		*!*	if this.value=" " and last()<>-4
		*!*		messagebox("Debe ingresar la Localidad",0+48,"Advertencia!!!")
		*!*		return 0
		*!*	endif
	ENDPROC

	PROCEDURE Text5.LostFocus
		thisform.command2.setfocus
	ENDPROC

	PROCEDURE Text6.GotFocus
		thisform.lbl_aviso.Visible=.T.
		
	ENDPROC

	PROCEDURE Text6.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = -4
			do form locaload with postal,locali,provi,codloca
			if postal>0
				with thisform
					this.value=postal
					.text3.value=locali
					.text4.value=provi
					thisform.command2.enabled=.T.
					thisform.lbl_aviso.Visible=.F.
					.text11.setfocus	
				endwith
			ELSE
				this.setfocus
			ENDIF
		ENDIF
			
	ENDPROC

	PROCEDURE Text6.LostFocus
		if type("this.value")="C"
		if LEN(ALLTRIM(this.value))>0
			frmaltap= conectar_db(_screen.cn)
				SQLEXEC(frmaltap,"select * from codipostales where cp_nro=?VAL(this.value);","cur_cpn")
			desconectar_db(frmaltap)
			if RECCOUNT()>0
				codp=cur_cpn.cp_codi
				cp=codp
				frmaltap= conectar_db(_screen.cn)
					SQLEXEC(frmaltap,"select a.*,b.provi_nomb from localidades a inner join provincias b on a.provi_codi=b.provi_codi where a.cp_codi=?codp;","cur_lcp")
				desconectar_db(frmaltap)
				IF RECCOUNT()>0
					if RECCOUNT()>1
						do form locamismocp with codp,codloca,locali,provi
						if codloca>0
							thisform.text3.value=locali
							thisform.combo1.value=provi
							thisform.text11.setfocus
							thisform.command2.enabled=.T.
						ELSE
							thisform.combo1.value=provi
							thisform.command2.enabled=.T.
						endif
					else
						con=messagebox("Solo existe en archivo la Localidad "+allt(cur_lcp.loca_nomb)+chr(13)+ ;
									   "de la Provincia de "+allt(cur_lcp.provi_nomb)+" con éste Código Postal "+chr(13)+;
									   "¿Ingresa otra Localidad con el mismo Código? ",4+32+256,"Localidades")
						do case
							case con=6
								thisform.combo1.value=cur_lcp.provi_nomb
								this.value=ALLT(str(cur_cpn.cp_nro))
								thisform.text3.setfocus
							case con=7
								thisform.text3.value=cur_lcp.loca_nomb
								thisform.combo1.value=cur_lcp.provi_nomb
								codloca=cur_lcp.loca_codi
								thisform.command2.enabled=.T.
								thisform.text11.setfocus
						endcase
					ENDIF
					thisform.lbl_aviso.Visible= .F.
				endif
			else
				op=messagebox("Ud. ha ingresado un nuevo Código Postal"+chr(13)+ ;
							  "¿Confirma el código ingresado?",4+32+256,"Códigos Postales")
				if op=6
					frmaltap= conectar_db(_screen.cn)
						SQLEXEC(frmaltap,"select MAX(cp_codi) as cp_codi from codipostales order by cp_codi;","cur_maxc")
						cp=cur_maxc.cp_codi+1
						codp=cp
						SQLEXEC(frmaltap,"insert into codipostales values(?codp,?val(this.value));")
					desconectar_db(frmaltap)
					thisform.lbl_aviso.Visible= .F.
				endif
			endif
		endif
		endif
		
		
	ENDPROC

	PROCEDURE Text6.Valid
		*!*	if type("this.value")="C"
		*!*		if this.value=" " and last()<>-4
		*!*			messagebox("Debe ingresar el Código Postal,"+chr(13)+ ;
		*!*					   "O presione F5 para ubicar la localidad",0+48,"Advertencia!!!")
		*!*			return 0
		*!*		endif
		*!*	endif
	ENDPROC

ENDDEFINE

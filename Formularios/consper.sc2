	PROCEDURE Destroy
		*!*	set skip of bar 10 of Consultas .F.
	ENDPROC

	PROCEDURE Init
		public localiz,postal,locali,provi,op,codloca,cp,codiper,proveedor
		localiz=0
		postal=0
		locali=""
		provi=""
		codloca=0
		op=0
		proveedor=""
		codiper=0
	ENDPROC

	PROCEDURE Load
		*!*	set skip of bar 10 of Consultas .T.
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command3.Click
		if thisform.label9.visible=.T. and thisform.text5.visible=.T.
			thisform.label9.visible=.F.
			thisform.text5.visible=.F.
		endif
		do form perload with codiper
		if codiprov>0
			frmconsp= conectar_db(_screen.cn)
				SQLEXEC(frmconsp,"select a.*,b.loca_nomb,c.*,d.* from personas a inner join localidades b on a.loca_codi=b.loca_codi inner join codipostales c on b.cp_codi=c.cp_codi inner join provincias d on b.provi_codi=d.provi_codi where per_codi=?codiper;","cur_per")
			desconectar_db(frmconsp)
			with thisform
				.text14.value=codiper
				.text1.value=cur_per.per_desc
				.text2.value=cur_per.per_domi
				.text6.value=allt(str(cur_per.cp_nro))
				codp=cur_per.cp_codi
				codloca=cur_per.loca_codi
				.text3.value=cur_per.loca_nomb
				.text4.value=cur_per.provi_nomb
				.text11.value="0"+allt(cur_per.per_cartel)
				.text7.value=ALLTRIM(per_tel1)
				.text10.value=ALLTRIM(per_tel2)
				.text8.value=ALLTRIM(per_cel)
				.text9.value=ALLTRIM(per_email)
				.text12.value=cur_per.dtoxpago
				.label9.visible=.T.
				.text5.visible=.T.
				.text5.value=ALLTRIM(cur_per.per_cuit)
				.text13.value=cur_per.per_saldo-cur_per.per_afvor
		*!*			IF LEN(ALLTRIM(cur_prov.prov_deta))>0		
		*!*				thisform.edt_deta.Value=cur_prov.prov_deta
		*!*				thisform.Height=584
		*!*				thisform.command1.Top = 531
		*!*				thisform.command3.Top = 531
		*!*				thisform.label16.Visible= .T.
		*!*				thisform.shape2.Visible= .T.
		*!*				thisform.edt_deta.Visible= .T.
		*!*			ELSE
		*!*				thisform.Height=456
		*!*				thisform.command1.Top = 403
		*!*				thisform.command3.Top = 403
		*!*				thisform.label16.Visible= .F.
		*!*				thisform.shape2.Visible= .F.
		*!*				thisform.edt_deta.Visible= .F.
		*!*			ENDIF			
				thisform.AutoCenter= .T.		
				if cur_per.percepcion="S"
					.check1.value=1
				else
					.check1.value=0
				endif
				do case
					case cur_per.cond_codi=1
						.optiongroup1.value=1
					case cur_per.cond_codi=2
						.optiongroup1.value=2
					case cur_per.cond_codi=3
						.optiongroup1.value=3
					case cur_per.cond_codi=4
						.optiongroup1.value=4
					case cur_per.cond_codi=5
						.optiongroup1.value=5
				ENDCASE
				.text1.setfocus
			endwith
		endif
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Text4.LostFocus
		if this.value<>" "
			sele provincias
			set order to provi_nomb
			seek allt(this.value)
			if !found()
				set order to provi_codi
				go bott
				pro=provi_codi+1
				appe blank
				repla provi_codi with pro
				repla provi_nomb with allt(this.value)
				sele localidades
				repla provi_codi with pro
			else
				sele localidades
				repla provi_codi with provincias.provi_codi
				sele provincias
				set order to provi_codi
			endif
		endif
	ENDPROC

	PROCEDURE Text4.Valid
		if this.value=" " and last()<>-4
			messagebox("Debe ingresar la Provincia",0+48,"Advertencia!!!")
			return 0
		endif
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="1" />

	*<PropValue>
		DataSource = .NULL.

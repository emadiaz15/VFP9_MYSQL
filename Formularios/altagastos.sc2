	PROCEDURE Command2.Click
		if thisform.text7.value=0
			messagebox("Debe ingresar obligatoriamente el número de factura del Proveedor",0+48,"Adevertencia")
			thisform.text7.setfocus
		else
			if RECCOUNT("reg_gas")=0
				fin=messagebox("Aún no ha ingresado ningún artículo a la "+ALLTRIM(thisform.combo2.Value)+", imposible terminar "+ ;
						   	   "¿Desea ingresar ahora?",4+32+256,"Aviso del Sistema")
				IF fin=6
					INSERT INTO reg_gas VALUES (VAL(''),'',impiva1,VAL(''),VAL(''),1,0)
					IF cur_condi.cond_codi<>5
						INSERT INTO iva_cmb VALUES (impiva1)
						INSERT INTO iva_cmb VALUES (impiva2)
						INSERT INTO iva_cmb VALUES (impiva3)
						INSERT INTO iva_cmb VALUES (0)
					ENDIF
					thisform.grid1.RecordSource="reg_gas"
					IF cur_condi.cond_codi<>5
						thisform.grid1.column3.cmb_iva.RowSource="iva_cmb"
					ENDIF
					thisform.label12.caption=allt(str(impiva1,10,2))+"%"
					thisform.label13.caption=allt(str(impiva2,10,2))+"%"
					thisform.lbl_iva3.caption=allt(str(impiva3,10,2))+"%"
					thisform.grid1.SetFocus
				ENDIF
			else
				preg=messagebox("¿Confirma los datos de la "+ALLTRIM(thisform.combo2.value)+"?",4+32+256,"Gastos")
				if preg=6
					&& --- VERIFICACION DE DUPLICADO ---
					LOCAL xcbtedup, cadebusdup
					xcbtedup=ICASE(thisform.combo2.value="FACTURA","F",thisform.combo2.value="N.CREDITO","N",thisform.combo2.value="N.DEBITO","D")
					cadebusdup=xcbtedup+ALLTRIM(thisform.text22.Value)+ALLTRIM(STR(thisform.codpers))+ALLTRIM(STR(thisform.text27.Value))+ALLTRIM(STR(thisform.text7.Value))
					frmaltagas= conectar_db(_screen.cn)
						SQLEXEC(frmaltagas,"select gas_codi from gastos where CONCAT(TRIM(gas_conc),TRIM(gas_tipcbte),TRIM(CAST(per_codi as char)),TRIM(CAST(gas_pto as char)),TRIM(CAST(gas_cbte as char)))=?cadebusdup;","cur_dupcheck")
					desconectar_db(frmaltagas)
					IF RECCOUNT("cur_dupcheck")>0
						cerrar_cursor("cur_dupcheck")
						messagebox("Esta factura ya existe para este proveedor. Imposible guardar.",0+48,"Duplicado")
						RETURN
					ENDIF
					cerrar_cursor("cur_dupcheck")
					&& --- FIN VERIFICACION ---
					with thisform
						LOCAL xfecha,xdto,xpto,xcbte,xtipc,xpiva,xpbtos,ximpag,xpag,xconc,xcotiz,ximpo,ximpo2, ;
							  ximpo3,xng,xiva,xiva2,xiva3,xcc,xnc,xngart,xgacant,xgades,xgaimpo,xgaali,xcoef,lnLock
						STORE 0 TO xpiva,xpbtos,ximpag,xng,xcc,xnc,lnLock
						STORE '' TO xpag
						xfecha=.text13.value
						xdto  =.text19.value
						xpto  =.text27.value
						xcbte =.text7.value
						xtipc =allt(.text22.value)
						xpiva=.text15.value
						xpbtos=.text20.value
						IF .check2.value=1
							ximpag=.text10.value
							xpag  ='S'
						ENDIF
						xconc=ICASE(thisform.combo2.value="FACTURA","F",thisform.combo2.value="N.CREDITO","N",thisform.combo2.value="N.DEBITO","D")
						IF xconc='N'
							xnc=1
						ENDIF
											
						if thisform.cond=2
							xiva=.text9.value
							xiva2=.text11.value
							xiva3=.text2.value
						else
							xiva=thisform.ac1
							xiva2=thisform.ac2
							xiva3=thisform.ac3
						ENDIF
						IF thisform.cond=5
							ximpo=thisform.importe1
							ximpo2=0
							ximpo3=0
						ELSE
							ximpo=iif(thisform.cond=2,thisform.importe1,thisform.acn1)
							ximpo2=iif(thisform.cond=2,thisform.importe2,thisform.acn2)
							ximpo3=iif(thisform.cond=2,thisform.importe3,thisform.acn3)
						ENDIF
						IF .text24.value>0
							xng=.text24.value
						ENDIF
						if .check3.value=1
							xcc=1
						ENDIF
						frmaltagas= conectar_db(_screen.cn)
							lnLock = MySQL_LockTables("LOCK", "gastos WRITE", frmaltagas)
							SQLEXEC(frmaltagas,"call usp_guardargas(1,0,?xfecha,?thisform.codpers,?codigas,?observ,?xdto,?xpto,?xcbte,?xtipc,?codiva,?xpiva,?xpbtos,?ximpag,?xpag,?xconc,?ximpo,?ximpo2,?ximpo3,?xng,?xcc,?xiva,?xiva2,?xiva3,?xnc);","cur_ncodi")
							lnLock = MySQL_LockTables("UNLOCK", "", frmaltagas)
		*!*						IF xcc=1
		*!*							LOCAL ximpotot
		*!*							ximpotot=.text10.value
		*!*							IF xconc='N'
		*!*								SQLEXEC(frmaltagas,"update personas set per_saldo=per_saldo-?ximpotot where per_codi=?thisform.codpers;")
		*!*							ELSE
		*!*								SQLEXEC(frmaltagas,"update personas set per_saldo=per_saldo+?ximpotot where per_codi=?thisform.codpers;")
		*!*							ENDIF
		*!*						ENDIF
							SQLEXEC(frmaltagas,"update personas set per_ultiletra=?xtipc,per_ultipto=?xpto where per_codi=?thisform.codpers;")
							IF xcc = 1
								IF xnc = 1
									xcoef = -1
								ELSE
									xcoef = 1
								ENDIF
								SQLEXEC(frmaltagas,"update personas set per_saldo=per_saldo+(?thisform.text10.value*?xcoef) where per_codi=?thisform.codpers;")
							ENDIF
							SELECT reg_gas
							GO top
							SCAN
								STORE 0 TO xgaimpo,xgaali,xgacant
								STORE '' TO xgades
								xgacant=reg_gas.rg_cant
								xgades=reg_gas.rg_desc
								xgaimpo=reg_gas.rg_prec
								xgaali=ICASE(reg_gas.rg_iva=21,1,reg_gas.rg_iva=10.50,2,reg_gas.rg_iva=27,3,reg_gas.rg_iva=0,4)
								SQLEXEC(frmaltagas,"select MAX(gasart_codi)+1 as gasart_codi from gastos_articulos order by gasart_codi;","cur_nga")
								IF ISNULL(cur_nga.gasart_codi)
									xngart=1
								ELSE
									xngart=VAL(cur_nga.gasart_codi)
								ENDIF
								cerrar_cursor("cur_nga")
								SQLEXEC(frmaltagas,"insert into gastos_articulos values(?xngart,?cur_ncodi.ncodi,?xgacant,?xgades,?xgaimpo,?xgaali);")
								SELECT reg_gas
							ENDSCAN
						desconectar_db(frmaltagas)
					endwith
					thisform.reiniciar_formulario()
				endif
			endif
		endif
	ENDPROC


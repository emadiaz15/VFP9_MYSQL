	PROCEDURE Grid1.Column3.cmb_iva.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode=22
		   Thisform.inseritem(nKeyCode, thisform.grid1)
		ENDIF
	ENDPROC

	PROCEDURE Grid1.Column3.cmb_iva.RightClick
		preg=MESSAGEBOX("¿Elimina esta línea?",4+32+256,"Alta de Gastos")
		
		IF preg=6
			LOCAL regeli
			regeli=reg_gas.rg_codi
			
			thisform.elimitem(regeli, ;
							  thisform.grid1, ;
							  thisform.text8, ;
							  thisform.text17, ;
							  thisform.text18, ;
							  thisform.text19, ;
							  thisform.text15, ;
							  thisform.text9, ;
							  thisform.text11, ;
							  thisform.text2, ;
							  thisform.text20, ;
							  thisform.text24, ;
							  thisform.text10)
		ENDIF
		
	ENDPROC

	PROCEDURE Grid1.Column3.cmb_iva.Valid
		IF thisform.estadoreg=1
		*!*		MESSAGEBOX("auxali: "+ALLTRIM(STR(thisform.auxali,5,2))+CHR(13)+ ;
		*!*				   "this  : "+ALLTRIM(STR(this.Value,5,2)),16,"Seguimiento")
			IF thisform.auxali <> this.value
				thisform.calculartotales()
				thisform.auxali = this.value
			ENDIF
			thisform.estadoreg=0
		ENDIF
	ENDPROC

	PROCEDURE Grid1.Column3.cmb_iva.When
		if cur_condi.cond_codi=5
			return .f.
		ENDIF
		
		IF reg_gas.rg_prtot>0
			thisform.estadoreg=1
		ENDIF
	ENDPROC

	PROCEDURE Grid1.Column4.Text1.Click
		IF reg_gas.rg_prtot>0
			thisform.estadoreg=1
			thisform.nregistro=RECNO()
		ENDIF
		this.SetFocus
		
	ENDPROC

	PROCEDURE Grid1.Column4.Text1.GotFocus
		IF thisform.estadoreg=1
			IF thisform.auxali=0 AND reg_gas.rg_nograv=0
				thisform.auxali=reg_gas.rg_iva
			ENDIF
			thisform.auxtot=reg_gas.rg_prtot
		ENDIF
	ENDPROC

	PROCEDURE Grid1.Column4.Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode=22
		   Thisform.inseritem(nKeyCode, thisform.grid1)
		ENDIF
	ENDPROC

	PROCEDURE Grid1.Column4.Text1.LostFocus
		WITH thisform
			REPLACE rg_prtot WITH ROUND(rg_prec*rg_cant,3)
			
			IF thisform.auxtot>0
				IF reg_gas.rg_prtot<>thisform.auxtot OR reg_gas.rg_iva<>thisform.auxali
					thisform.modifitem(thisform.auxali, thisform.auxtot, thisform.text19.Value, ;
									   thisform.text9, thisform.text11, thisform.text2, ;
									   thisform.text24, thisform.text18)
				endif
			ENDIF
			
			IF reg_gas.rg_prtot<>thisform.auxtot OR reg_gas.rg_iva<>thisform.auxali
				thisform.calculartotales()
			ENDIF
			thisform.estadoreg=0
			thisform.auxali=0
			thisform.auxtot=0
		ENDWITH
	ENDPROC

	PROCEDURE Grid1.Column4.Text1.RightClick
		preg=MESSAGEBOX("¿Elimina esta línea?",4+32+256,"Alta de Gastos")
		
		IF preg=6
			LOCAL regeli
			regeli=reg_gas.rg_codi
			
			thisform.elimitem(regeli, ;
							  thisform.grid1, ;
							  thisform.text8, ;
							  thisform.text17, ;
							  thisform.text18, ;
							  thisform.text19, ;
							  thisform.text15, ;
							  thisform.text9, ;
							  thisform.text11, ;
							  thisform.text2, ;
							  thisform.text20, ;
							  thisform.text24, ;
							  thisform.text10)
		ENDIF
		
	ENDPROC

	PROCEDURE Grid1.Column5.Text1.RightClick
		preg=MESSAGEBOX("¿Elimina esta línea?",4+32+256,"Alta de Gastos")
		
		IF preg=6
			LOCAL regeli
			regeli=reg_gas.rg_codi
			
			thisform.elimitem(regeli, ;
							  thisform.grid1, ;
							  thisform.text8, ;
							  thisform.text17, ;
							  thisform.text18, ;
							  thisform.text19, ;
							  thisform.text15, ;
							  thisform.text9, ;
							  thisform.text11, ;
							  thisform.text2, ;
							  thisform.text20, ;
							  thisform.text24, ;
							  thisform.text10)
		ENDIF
		
	ENDPROC

	PROCEDURE Text1.Click
		this.value=0
		this.setfocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		*!*	thisform.combo1.rowsourcetype=3
	ENDPROC

	PROCEDURE Text1.Valid
		if this.value>0
			frmaltagas= conectar_db(_screen.cn)
				SQLEXEC(frmaltagas,"select * from personas where per_codi=?this.value;","cur_per")
				SQLEXEC(frmaltagas,"select * from condiva where cond_codi=?cur_per.cond_codi;","cur_condi")
			desconectar_db(frmaltagas)
			if RECCOUNT("cur_per")>0
				thisform.codpers=cur_per.per_codi
				IF cur_condi.cond_codi=0
					MESSAGEBOX("Para poder continuar debe indicar la Condición de IVA para el Proveedor "+ ;
					 		   ALLTRIM(cur_per.per_desc)+" ."+CHR(13)+ ;
					 		   "Ingrese al menú Modificaciones/Proveedores de Servicios y luego intente nuevamente.",0+48,"Gastos")
					this.value=0
					return .F.
				ELSE
					thisform.cond=cur_condi.cond_codi
				ENDIF
		*!*			IF ALLTRIM(cur_per.percepcion)='S'
		*!*				thisform.text15.Style= 0
		*!*				thisform.text20.Style= 0
		*!*			ENDIF
				thisform.txt_cuit.Value=VAL(cur_per.per_cuit)
				thisform.txt_cond.Value=cur_condi.cond_desc
				thisform.text22.Value  =IIF(ISNULL(cur_per.per_ultiletra),"",cur_per.per_ultiletra)
				thisform.text27.Value  =IIF(ISNULL(cur_per.per_ultipto),0,cur_per.per_ultipto)
				thisform.combo1.rowsource="select per_desc from cur_per into cursor combo1"
				thisform.combo1.value=thisform.combo1.list(1)
		*!*			cerrar_cursor("cur_per")		
				keyboard '{TAB}'
			else
				=messagebox("Proveedor no está en archivo",0+48,"Advertencia")
				this.value=0
				return .F.
			endif
		endif
	ENDPROC

	PROCEDURE Text13.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE Text13.Valid
		frmaltagas= conectar_db(_screen.cn)
			SQLEXEC(frmaltagas,"select * from parametros where param_desc='ULTCIERCOM';","cur_par")
		desconectar_db(frmaltagas)
		if RECCOUNT("cur_par")>0
			if this.value<=cur_par.param_fec and this.value<>ctod("  /  /    ")
				=messagebox("Ultima fecha de cierre de Iva Compras "+dtoc(cur_par.param_fec)+chr(13)+;
							"Imposible ingresar la "+ALLTRIM(thisform.combo2.Value)+" con esta fecha",0+48,"Advertencia!")
				this.value=ctod("  /  /    ")
				return 0
			ELSE
				IF RECCOUNT("reg_gas")=0
					INSERT INTO reg_gas VALUES (VAL(''),'',impiva1,VAL(''),VAL(''),1,0)
					IF cur_condi.cond_codi<>5
						INSERT INTO iva_cmb VALUES (impiva1)
						INSERT INTO iva_cmb VALUES (impiva2)
						INSERT INTO iva_cmb VALUES (impiva3)
						INSERT INTO iva_cmb VALUES (0)
					ENDIF
					thisform.grid1.RecordSource="reg_gas"
					IF cur_condi.cond_codi<>5
						thisform.grid1.column3.cmb_iva.RowSource="iva_cmb"
					ENDIF
				ENDIF
				thisform.label12.caption=allt(str(impiva1,10,2))+"%"
				thisform.label13.caption=allt(str(impiva2,10,2))+"%"
				thisform.lbl_iva3.caption=allt(str(impiva3,10,2))+"%"
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Text15.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE Text15.Valid
		IF this.Value>0
			thisform.text10.value=thisform.text18.value+thisform.text24.value+ ;
								  thisform.text9.value+thisform.text11.value+ ;
								  thisform.text2.value+thisform.text15.value+ ;
								  thisform.text20.value
		ENDIF
		
	ENDPROC

	PROCEDURE Text19.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text19.GotFocus
		public valdto
		valdto=this.value
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			if this.value<>valdto
				do case
					case this.value=0
						.text17.value=0
						.text18.value=.text8.value
						thisform.importe1=thisform.importe1/((100-valdto)/100)
						thisform.importe2=thisform.importe2/((100-valdto)/100)
						thisform.importe3=thisform.importe3/((100-valdto)/100)
						thisform.acn1=thisform.acn1/((100-valdto)/100)
						thisform.acn2=thisform.acn2/((100-valdto)/100)
						thisform.acn3=thisform.acn2/((100-valdto)/100)
						thisform.ac1=thisform.ac1/((100-valdto)/100)
						thisform.ac2=thisform.ac2/((100-valdto)/100)
						thisform.ac3=thisform.ac2/((100-valdto)/100)
						if thisform.cond=2
							.text9.value=.text9.value/((100-valdto)/100)
							.text11.value=.text11.value/((100-valdto)/100)
							.text2.value=.text2.value/((100-valdto)/100)
						endif
					otherwise
						.text17.value=(.text8.value*this.value)/100
						.text18.value=.text8.value-.text17.value
		*!*					.text24.value=(.text18.value*.text25.value)/100
						if thisform.cond=2
							if valdto>0
								.text9.value=.text9.value/((100-valdto)/100)
								.text11.value=.text11.value/((100-valdto)/100)
								.text2.value=.text2.value/((100-valdto)/100)
							endif
							.text9.value=.text9.value*((100-this.value)/100)
							.text11.value=.text11.value*((100-this.value)/100)
							.text2.value=.text2.value*((100-this.value)/100)
						endif
						if valdto>0
							thisform.importe1=thisform.importe1/((100-valdto)/100)
							thisform.importe2=thisform.importe2/((100-valdto)/100)
							thisform.importe3=thisform.importe3/((100-valdto)/100)
							IF thisform.cond<>2
								thisform.acn1=thisform.acn1/((100-valdto)/100)
								thisform.acn2=thisform.acn2/((100-valdto)/100)
								thisform.acn3=thisform.acn3/((100-valdto)/100)
								thisform.ac1=thisform.ac1/((100-valdto)/100)
								thisform.ac2=thisform.ac2/((100-valdto)/100)
								thisform.ac3=thisform.ac3/((100-valdto)/100)
							ENDIF
						endif
						thisform.importe1=thisform.importe1*((100-this.value)/100)
						thisform.importe2=thisform.importe2*((100-this.value)/100)
						thisform.importe3=thisform.importe3*((100-this.value)/100)
						IF thisform.cond<>2
							thisform.acn1=thisform.acn1*((100-this.value)/100)
							thisform.acn2=thisform.acn2*((100-this.value)/100)
							thisform.acn3=thisform.acn3*((100-this.value)/100)
							thisform.ac1=thisform.ac1*((100-this.value)/100)
							thisform.ac2=thisform.ac2*((100-this.value)/100)
							thisform.ac3=thisform.ac3*((100-this.value)/100)
						ENDIF
				endcase
				.text10.value=.text18.value+.text24.value+.text9.value+.text11.value+.text2.value+.text15.value+.text20.value
			endif
		endwith
	ENDPROC

	PROCEDURE Text20.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE Text20.Valid
		IF this.Value>0
			thisform.text10.value=thisform.text18.value+thisform.text24.value+ ;
								  thisform.text9.value+thisform.text11.value+ ;
								  thisform.text2.value+thisform.text15.value+ ;
								  thisform.text20.value
		ENDIF
		
	ENDPROC

	PROCEDURE Text22.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text22.Valid
		IF LEN(ALLTRIM(this.Value))=0
			MESSAGEBOX("Debe ingresar un Tipo de Comprobante",48,"Aviso del Sistema")
			RETURN 0
		ENDIF
	ENDPROC

	PROCEDURE Text23.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text27.Valid
		IF this.Value=0
			MESSAGEBOX("Debe ingresar un Punto de Venta",48,"Aviso del Sistema")
			RETURN 0
		ENDIF
	ENDPROC

	PROCEDURE Text3.Click
		this.value=0
		this.setfocus
	ENDPROC

	PROCEDURE Text3.GotFocus
		*!*	thisform.combo3.rowsourcetype=3
	ENDPROC

	PROCEDURE Text3.Valid
		if this.value>0
			frmaltagas= conectar_db(_screen.cn)
				SQLEXEC(frmaltagas,"select * from tiposgastos where tipgas_codi=?this.value;","cur_tipg")
			desconectar_db(frmaltagas)
			if RECCOUNT("cur_tipg")>0
				codigas=cur_tipg.tipgas_codi
				thisform.combo3.rowsource="select tipgas_desc from cur_tipg INTO CURSOR combo3"
				thisform.combo3.value=thisform.combo3.list(1)
				cerrar_cursor("cur_tipg")
				keyboard '{TAB}'+'{F4}'
			else
				=messagebox("Tipo de Gasto no está en archivo",0+48,"Advertencia")
				this.value=0
				return .F.
			endif
		endif
	ENDPROC

	PROCEDURE Text7.Valid
		IF this.Value=0
			MESSAGEBOX("Debe ingresar un número de Factura",48,"Aviso del Sistema")
			RETURN 0
		ENDIF
		
		local cadebus,cbte,cadepto,cadenro
		STORE "" TO cadebus,cbte
		
		cbte=ICASE(thisform.combo2.value="FACTURA","F",thisform.combo2.value="N.CREDITO","N",thisform.combo2.value="N.DEBITO","D")
		
		cadebus=cbte+ALLTRIM(thisform.text22.Value)+ALLTRIM(STR(thisform.codpers))+ALLTRIM(STR(thisform.text27.Value))+ALLTRIM(STR(this.Value))
		
		frmaltagas= conectar_db(_screen.cn)
			SQLEXEC(frmaltagas,"select a.*,b.per_desc from gastos a inner join personas b on a.per_codi=b.per_codi where CONCAT(TRIM(a.gas_conc),TRIM(a.gas_tipcbte),TRIM(CAST(a.per_codi as char)),TRIM(CAST(a.gas_pto as char)),TRIM(CAST(a.gas_cbte as char)))=?cadebus;","cur_gaslo")
		desconectar_db(frmaltagas)
		if RECCOUNT("cur_gaslo")>0
			cadepto=repl("0",4-len(allt(str(thisform.text27.value))))+allt(str(thisform.text27.value))
			cadenro=repl("0",8-len(allt(str(this.value))))+allt(str(this.value))
			messagebox("La factura Nº: "+allt(thisform.text22.value)+" "+cadepto+"-"+cadenro+" de "+allt(cur_gaslo.per_desc)+" ya esta en archivo. Imposible ingresarla nuevamente",0+48,"Advertencia")
			cerrar_cursor("cur_gaslo")
		*	this.value=0
			return 0
		ENDIF
	ENDPROC

ENDDEFINE


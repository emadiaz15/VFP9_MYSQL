	PROCEDURE calculartotales
		WITH thisform
			LOCAL art_alicuota
			DIMENSION ar_grabado(1), ar_nograbado(1), ar_iva1(1), ar_iva2(1), ar_iva3(1), ;
				      ar_impo1(1), ar_impo2(1), ar_impo3(1), ar_acn1(1), ar_acn2(1), ;
				      ar_acn3(1),ar_ac1(1), ar_ac2(1), ar_ac3(1)
			STORE 0 TO ar_grabado[1], ar_nograbado[1],ar_iva1[1],ar_iva2[1],ar_iva3[1],ar_impo1[1],ar_impo2[1],ar_impo3[1], ;
					   ar_acn1[1], ar_acn2[1], ar_acn3[1], ar_ac1[1], ar_ac2[1], ar_ac3[1]
					   
		 	SELECT SUM(rg_prtot) FROM reg_gas WHERE rg_iva>0 AND !DELETED() INTO ARRAY ar_grabado
			.text8.value=IIF(ISNULL(ar_grabado[1]),0,ar_grabado[1])
			SELECT SUM(rg_prtot) FROM reg_gas WHERE rg_iva=0 AND !DELETED() INTO ARRAY ar_nograbado
			.text24.value=IIF(ISNULL(ar_nograbado[1]),0,ar_nograbado[1])
			.text24.value=IIF(.text19.value>0,.text24.value-(.text24.value*((100-.text19.value)/100)),.text24.value)
			.text17.value=iif(.text19.value>0,round((.text8.value*.text19.value)/100,2),0)
			.text18.value=.text8.value-.text17.value
			.text18.value=.text8.value-.text17.value
			
			SELECT SUM(((reg_gas.rg_prtot*reg_gas.rg_iva)/100)) FROM reg_gas WHERE rg_iva=impiva1 INTO ARRAY ar_iva1
			SELECT SUM(((reg_gas.rg_prtot*reg_gas.rg_iva)/100)) FROM reg_gas WHERE rg_iva=impiva2 INTO ARRAY ar_iva2
			SELECT SUM(((reg_gas.rg_prtot*reg_gas.rg_iva)/100)) FROM reg_gas WHERE rg_iva=impiva3 INTO ARRAY ar_iva3
		
			SELECT SUM(rg_prtot) FROM reg_gas WHERE rg_iva=impiva1 INTO ARRAY ar_impo1
			SELECT SUM(rg_prtot) FROM reg_gas WHERE rg_iva=impiva2 INTO ARRAY ar_impo2
			SELECT SUM(rg_prtot) FROM reg_gas WHERE rg_iva=impiva3 INTO ARRAY ar_impo3
			
			thisform.importe1=IIF(ISNULL(ar_impo1),0,ar_impo1)
			thisform.importe2=IIF(ISNULL(ar_impo2),0,ar_impo2)
			thisform.importe3=IIF(ISNULL(ar_impo3),0,ar_impo3)
			
			IF thisform.cond=2
				.text9.value =IIF(ISNULL(ar_iva1),0,ar_iva1)
				.text11.value=IIF(ISNULL(ar_iva2),0,ar_iva2)
				.text2.value =IIF(ISNULL(ar_iva3),0,ar_iva3)
			ELSE
				IF thisform.cond<>5
					SELECT ROUND(SUM((reg_gas.rg_prtot/(1+(reg_gas.rg_iva/100)))),2) FROM reg_gas WHERE rg_iva=impiva1 INTO ARRAY ar_acn1
					SELECT ROUND(SUM((reg_gas.rg_prtot/(1+(reg_gas.rg_iva/100)))),2) FROM reg_gas WHERE rg_iva=impiva2 INTO ARRAY ar_acn2
					SELECT ROUND(SUM((reg_gas.rg_prtot/(1+(reg_gas.rg_iva/100)))),2) FROM reg_gas WHERE rg_iva=impiva3 INTO ARRAY ar_acn3
					
					SELECT ROUND(SUM((reg_gas.rg_prtot/(1+(reg_gas.rg_iva/100)))*reg_gas.rg_iva/100),2) FROM reg_gas WHERE rg_iva=impiva1 INTO ARRAY ar_ac1
					SELECT ROUND(SUM((reg_gas.rg_prtot/(1+(reg_gas.rg_iva/100)))*reg_gas.rg_iva/100),2) FROM reg_gas WHERE rg_iva=impiva2 INTO ARRAY ar_ac2
					SELECT ROUND(SUM((reg_gas.rg_prtot/(1+(reg_gas.rg_iva/100)))*reg_gas.rg_iva/100),2) FROM reg_gas WHERE rg_iva=impiva3 INTO ARRAY ar_ac3
					
					thisform.acn1=IIF(ISNULL(ar_acn1[1]),0,ar_acn1[1])
					thisform.acn2=IIF(ISNULL(ar_acn2[1]),0,ar_acn2[1])
					thisform.acn3=IIF(ISNULL(ar_acn3[1]),0,ar_acn3[1])
					
					thisform.ac1 =IIF(ISNULL(ar_ac1[1]),0,ar_ac1[1])
					thisform.ac2 =IIF(ISNULL(ar_ac2[1]),0,ar_ac2[1])
					thisform.ac3 =IIF(ISNULL(ar_ac3[1]),0,ar_ac3[1])
				ENDIF
			ENDIF
		
			IF thisform.estadoreg=0
				GO bott
			ELSE
				GO thisform.nregistro IN reg_gas
			ENDIF
			
			IF reg_gas.rg_iva=0
				REPLACE rg_nograv WITH 1 IN reg_gas
			ENDIF
			.text10.value=.text18.value+.text24.value+.text9.value+.text11.value+.text2.value+.text15.value+.text20.value
		ENDWITH
		
		RETURN
		
	ENDPROC

	PROCEDURE Destroy
		IF USED("cur_par")
			USE IN cur_par
		ENDIF
		IF USED("cur_gaslo")
			USE IN cur_gaslo
		ENDIF
		IF USED("combo3")
			USE IN combo3
		ENDIF
		IF USED("combo1")
			USE IN combo1
		ENDIF
		IF USED("cur_condi")
			USE IN cur_condi
		ENDIF
		IF USED("cur_per")
			USE IN cur_per
		ENDIF
		IF USED("cur_iva")
			USE IN cur_iva
		ENDIF
		IF USED("iva_cmb")
			USE IN iva_cmb
		ENDIF
		IF USED("reg_gas")
			USE IN reg_gas
		ENDIF
	ENDPROC

	PROCEDURE elimitem
		LPARAMETERS xitem, oObject1, oObject2, oObject3, oObject4, oObject5, ;
					oObject7, oObject8, oObject9, oObject10, oObject11, oObject12, ;
					oObject14
		
		LOCAL registros
		
		IF thisform.auxali=0 AND reg_gas.rg_nograv=0
			thisform.auxali=reg_gas.rg_iva
		ENDIF
		thisform.auxtot=reg_gas.rg_prtot
		IF thisform.auxtot>0
			thisform.modifitem(thisform.auxali, thisform.auxtot, oObject5.Value, ;
							   oObject8, oObject9, oObject10, oObject12, oObject4)
		ENDIF
		DELETE FROM reg_gas WHERE rg_codi=xitem
		COUNT FOR !DELETED() TO registros
		CALCULATE SUM(reg_gas.rg_prtot) FOR reg_gas.rg_iva>0 AND !DELETED() TO oObject2.value
		oObject3.value=iif(oObject5.value>0,round((oObject2.value*oObject5.value)/100,2),0)
		oObject4.value=oObject2.value-oObject3.value
		oObject4.value=oObject2.value-oObject3.value
		oObject14.value=oObject4.value+oObject12.value+oObject8.value+oObject9.value+  ;
						oObject10.value+oObject7.value+oObject11.value
		oObject1.RecordSource=''
		oObject1.Refresh()
		GO bott
		oObject1.recordsource="reg_gas"
		FOR x=1 TO registros
			oObject1.DoScroll(0)
		NEXT x
		oObject1.Refresh()
		oObject1.setfocus
		IF registros=0
			thisform.inseritem(22, oObject1)
		ENDIF
		STORE 0 TO thisform.auxali,thisform.auxtot
	ENDPROC

	PROCEDURE Init
		PUBLIC auxiacneto,auximpo,auxacuneto,auxiva,auxalic, ;
			   observ,codiva,codigas,impiva1,impiva2,impiva3
			   
		&& ,thisform.codpers
		
		set date british
		set cent on
		set deleted on
		SET POINT TO "."
		SET SEPARATOR TO ","
		SET TALK OFF
		SET NOTIFY off
		
		thisform.reiniciar_formulario()  
		
		this.combo2.additem("FACTURA",1)
		this.combo2.additem("N.CREDITO",2)
		this.combo2.additem("N.DEBITO",3)
		this.combo2.value="FACTURA"
				   
		frmaltagas= conectar_db(_screen.cn)
			SQLEXEC(frmaltagas,"select * from iva order by iva_codi desc limit 1;","cur_iva")
		desconectar_db(frmaltagas)
		codiva=cur_iva.iva_codi
		impiva1=cur_iva.iva_1
		impiva2=cur_iva.iva_2
		impiva3=cur_iva.iva_3
		ivaant=impiva1
	ENDPROC

	PROCEDURE inseritem
		LPARAMETERS xnTecla , xoObjeto
		
		IF xnTecla=22
			LOCAL registros,contit
			registros=0
			contit=reg_gas.rg_codi+1
			GO BOTTOM in reg_gas
			INSERT INTO reg_gas VALUES (VAL(''),'',impiva1,VAL(''),VAL(''),contit,0)
			registros=RECCOUNT("reg_gas")
		
			xoObjeto.RecordSource=''
			xoObjeto.Refresh()
			GO bott
			xoObjeto.recordsource="reg_gas"
			FOR x=1 TO registros
				xoObjeto.DoScroll(0)
			NEXT x
			xoObjeto.Refresh()
			xoObjeto.setfocus
		ENDIF
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		*!*	IF nKeyCode=22
		*!*	   Thisform.inseritem(nKeyCode, thisform.grid1)
		*!*	ENDIF
	ENDPROC

	PROCEDURE modifitem
		LPARAMETERS xalicuo, xtotal, xdto, oObject1, oObject2, oObject3, oObject4, oObject5
		
		LOCAL art_alicuota
		
		art_alicuota=ICASE(xalicuo=21,1,xalicuo=10.50,2,xalicuo=27,3,xalicuo=0,4)
		
		DO case
			CASE art_alicuota=1
				IF thisform.cond=2
					IF xdto>0
						thisform.importe1=thisform.importe1-(xtotal*((100-xdto)/100))
						oObject1.value=oObject1.value-(xtotal*((100-xdto)/100)*xalicuo/100)
					ELSE
						thisform.importe1=thisform.importe1-xtotal
						oObject1.value=oObject1.value-((xtotal*xalicuo)/100)
					ENDIF
				ELSE
					IF xdto>0
						thisform.importe1=thisform.importe1-(xtotal*((100-xdto)/100))
						auxiacneto=thisform.acn1
						thisform.acn1=thisform.acn1-((xtotal*((100-xdto)/100))/(1+(xalicuo/100)))
						thisform.ac1=thisform.ac1-(((auxiacneto-thisform.acn1)*xalicuo)/100)
					ELSE
						thisform.importe1=thisform.importe1-xtotal
						auxiacneto=thisform.acn1
						thisform.acn1=thisform.acn1-(xtotal/(1+(xalicuo/100)))
						thisform.ac1=thisform.ac1-(((auxiacneto-thisform.acn1)*xalicuo)/100)
					ENDIF
				ENDIF
			CASE art_alicuota=2
				IF thisform.cond=2
					IF xdto>0
						thisform.importe2=thisform.importe2-(xtotal*((100-xdto)/100))
						oObject2.value=oObject2.value-(xtotal*((100-xdto)/100)*xalicuo/100)
					ELSE
						thisform.importe2=thisform.importe2-xtotal
						oObject2.value=oObject2.value-((xtotal*xalicuo)/100)
					ENDIF
				ELSE
					IF xdto>0
						thisform.importe2=thisform.importe2-(xtotal*((100-xdto)/100))
						auxiacneto=thisform.acn2
						thisform.acn2=thisform.acn2-((xtotal*((100-xdto)/100))/(1+(xalicuo/100)))
						thisform.ac2=thisform.ac2-(((auxiacneto-thisform.acn2)*xalicuo)/100)
					ELSE
						thisform.importe2=thisform.importe2-xtotal
						auxiacneto=thisform.acn2
						thisform.acn2=thisform.acn2-(xtotal/(1+(xalicuo/100)))
						thisform.ac2=thisform.ac2-(((auxiacneto-thisform.acn2)*xalicuo)/100)
					ENDIF
				ENDIF
			CASE art_alicuota=3
				IF thisform.cond=2
					IF xdto>0
						thisform.importe3=thisform.importe3-(xtotal*((100-xdto)/100))
						oObject3.value=oObject3.value-(xtotal*((100-xdto)/100)*xalicuo/100)
					ELSE
						thisform.importe3=thisform.importe3-xtotal
						oObject3.value=oObject3.value-((xtotal*xalicuo)/100)
					ENDIF
				ELSE
					IF xdto>0
						thisform.importe3=thisform.importe3-(xtotal*((100-xdto)/100))
						auxiacneto=thisform.acn3
						thisform.acn3=thisform.acn3-((xtotal*((100-xdto)/100))/(1+(xalicuo/100)))
						thisform.ac3=thisform.ac3-(((auxiacneto-thisform.acn3)*xalicuo)/100)
					ELSE
						thisform.importe3=thisform.importe3-xtotal
						auxiacneto=thisform.acn3
						thisform.acn3=thisform.acn3-(xtotal/(1+(xalicuo/100)))
						thisform.ac3=thisform.ac3-(((auxiacneto-thisform.acn3)*xalicuo)/100)
					ENDIF
				ENDIF
			CASE art_alicuota=4
				IF xdto>0
					oObject4.value=oObject4.value-(xtotal*((100-xdto)/100))
				ELSE	
					oObject4.value=oObject4.value-xtotal
				ENDIF
		ENDCASE	
	ENDPROC

	PROCEDURE reiniciar_formulario
		thisform.grid1.RecordSource=''
		thisform.grid1.Refresh()
		
		this.text13.value=date()
		
		STORE 0 TO thisform.text8.Value, ;
				   thisform.text17.Value, ;
				   thisform.text18.Value, ;
				   thisform.text24.Value, ;
				   thisform.text9.Value, ;
				   thisform.text11.Value, ;
				   thisform.text2.Value, ;
				   thisform.text15.Value, ;
				   thisform.text20.Value, ;
				   thisform.text10.Value, ;
				   thisform.text19.Value, ;
				   thisform.text23.Value, ;
				   thisform.text7.Value, ;
				   thisform.text27.Value, ;
				   thisform.text1.Value, ;
				   thisform.text3.Value, ;
				   thisform.ac1, ;
				   thisform.ac2, ;
				   thisform.ac3, ;
				   thisform.acn1, ;
				   thisform.acn2, ;
				   thisform.acn3, ;
				   thisform.auxali, ;
				   thisform.auxtot, ;
				   thisform.cond, ;
				   thisform.estadoreg, ;
				   thisform.importe1, ;
				   thisform.importe2, ;
				   thisform.importe3, ;
				   thisform.nregistro, ;
				   codigas, ;
				   thisform.codpers, ;
				   auxiacneto, ;
				   auxacuneto, ;
				   auxiva, ;
				   auxalic
				   	   
		STORE "" TO observ, ;
					thisform.text22.Value, ;
		     	    thisform.combo1.Value, ;
				    thisform.combo3.Value, ;
				    thisform.edit1.Value, ;
				    thisform.txt_cuit.Value, ;
				    thisform.txt_cond.Value
				    
		thisform.check2.Value=1
		thisform.check3.Value=0
		
		CREATE CURSOR reg_gas(rg_cant N(10,3),rg_desc C(45),rg_iva N(5,2),rg_prec N(10,3),rg_prtot N(10,3),rg_codi N(8),rg_nograv N(1))
		CREATE CURSOR iva_cmb(impiva N(5,2))
		
		thisform.text1.SetFocus
		
	ENDPROC

	PROCEDURE Check2.Click
		if this.value=1
			pag=messagebox("¿Confirma imputar esta Factura como Pagada?",4+48+256,"Recepciones")
			if pag=6
				this.value=1
				thisform.check3.Value=0
			else
				this.value=0
			endif
		else
			if this.value=0
				pag=messagebox("¿Confirma imputar esta Factura como NO Pagada?",4+48+256,"Recepciones")
				if pag=6
					this.value=0
					thisform.check3.Value=1
				else
					this.value=1
				endif
			endif
		endif
		
	ENDPROC

	PROCEDURE Check3.Click
		if this.value=1
			pag=messagebox("¿Confirma Asentar esta factura en la Cuenta Corriente?",4+48+256,"Recepciones")
			if pag=6
				this.value=1
				thisform.check2.Value=0
			else
				this.value=0
			endif
		else
			if this.value=0
				pag=messagebox("¿Confirma NO Asentar esta factura en la Cuenta Corriente?",4+48+256,"Recepciones")
				if pag=6
					this.value=0
					thisform.check2.Value=1
				else
					this.value=1
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Combo1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Combo1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			LOCAL xdesc
			for i=1 to this.listcount
				if this.selected(i)
					frmaltagas= conectar_db(_screen.cn)
						xdesc=allt(this.list(i))
						SQLEXEC(frmaltagas,"select * from personas where TRIM(per_desc)=?xdesc order by per_desc;","cur_per")
						SQLEXEC(frmaltagas,"select * from condiva where cond_codi=?cur_per.cond_codi;","cur_condi")
					desconectar_db(frmaltagas)
					IF RECCOUNT("cur_per")>0
						thisform.codpers=cur_per.per_codi
						IF cur_condi.cond_codi=0
							MESSAGEBOX("Para poder continuar debe indicar la Condición de IVA para el Proveedor "+ ;
							 		   ALLTRIM(cur_per.per_desc)+" ."+CHR(13)+ ;
							 		   "Ingrese al menú Modificaciones/Proveedores de Servicios y luego intente nuevamente.",0+48,"Gastos")
							this.value=''
							return .F.
						ELSE
							thisform.cond=cur_condi.cond_codi
						ENDIF
		*!*					IF ALLTRIM(cur_per.percepcion)='S'
		*!*						thisform.text15.Style= 0
		*!*						thisform.text20.Style= 0
		*!*					ENDIF				
						thisform.text1.value=cur_per.per_codi
						thisform.text22.Value  =IIF(ISNULL(cur_per.per_ultiletra),"",cur_per.per_ultiletra)
						thisform.text27.Value  =IIF(ISNULL(cur_per.per_ultipto),0,cur_per.per_ultipto)			
						thisform.txt_cuit.Value=VAL(cur_per.per_cuit)
						thisform.txt_cond.Value=cur_condi.cond_desc
					ENDIF
		*!*				cerrar_cursor("cur_per")
					KEYBOARD '{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE Combo1.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade='%'+subst(allt(this.text),2,len(allt(this.text)))+'%'
				frmaltagas= conectar_db(_screen.cn)
					SQLEXEC(frmaltagas,"select per_desc from personas where per_desc like ?cade order by per_desc;","cur_per")
				desconectar_db(frmaltagas)
				IF RECCOUNT("cur_per")>0
					this.rowsource="select per_desc from cur_per INTO CURSOR combo1"
					this.value=this.list(1)
					keyboard "{F4}"
				ELSE
					MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
					this.Value=""			
				ENDIF
				RETURN .F.
		*!*			cerrar_cursor("cur_per")
			else
				if len(allt(this.text))>0
					cade=ALLTRIM(this.text)+'%'
					frmaltagas= conectar_db(_screen.cn)
						SQLEXEC(frmaltagas,"select per_desc from personas where per_desc like ?cade order by per_desc;","cur_per")
					desconectar_db(frmaltagas)
					IF RECCOUNT("cur_per")>0
						this.rowsource="select per_desc from cur_per INTO CURSOR combo1"
						this.value=this.list(1)
							keyboard "{F4}"
					ELSE
						MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
						this.Value=""				
					ENDIF
					RETURN .F.
		*!*				cerrar_cursor("cur_per")
				endif
			endif
		endif
	ENDPROC


	PROCEDURE Init
		Parameters fecha,articulo
		SET HOURS TO 12
		local dd,xcodigo
		xcodigo=articulo
		SET DECIMALS TO 3
		frmvrhis= conectar_db(_screen.cn)
			SQLEXEC(frmvrhis, "call usp_vraphis(?xcodigo);","cos1")
		desconectar_db(frmvrhis)
		SET DECIMALS TO
		 
		SELECT TTOD(histo_fech) fechis, ;
			   TTOC(histo_fech,2) horhis, ;
			   prov_nomb, ;
			   histo_costo, ;
			   histo_ctovta, ;
			   moneda ;
		   FROM cos1 INTO CURSOR cos2
		
		sele cos2
		LOCATE
		set safety off
		index on fechis to SYS(2015)
		set safety on
		set near on
		seek fecha
		if fechis>fecha and !bof() or eof()
			skip-1
		ENDIF
		thisform.label4.Caption=repl("0",8-len(allt(str(articulo))))+allt(str(articulo))
		frmvrhis= conectar_db(_screen.cn)
			SQLEXEC(frmvrhis,"select art_desc from articulos where art_codi=?articulo;","cur_arti")
		desconectar_db(frmvrhis)
		thisform.label5.Caption=allt(substr(cur_arti.art_desc,1,38))
		thisform.grd_costos.recordsource="cos2"
		thisform.grd_costos.setfocus
		
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

ENDDEFINE

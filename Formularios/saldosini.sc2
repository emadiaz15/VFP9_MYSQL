		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		*!*	public codicli
		*!*	this.text1.value=0
		*!*	this.text2.value=0
		*!*	this.text3.value=date()
		*!*	sele saldosiniciales
		*!*	set order to sini_cod
		*!*	go bott
		*!*	this.label5.caption="0000-"+repl("0",8-len(allt(str(sini_cod+1))))+allt(str(sini_cod+1))
		
		
	ENDPROC

	PROCEDURE Load
		MESSAGEBOX("ESTA RUTINA SE ENCUENTA MOMENTÁNEAMENTE EN PROCESO DE DISEÑO Y MANTENIMIENTO."+CHR(13)+CHR(13)+;
				   "ESTARÁ DISPONIBLE EN PRÓXIMAS ACTUALIZACIONES.",64,"Aviso del Sistema")
		RETURN TO master
	ENDPROC

	PROCEDURE Combo1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Combo1.Destroy
		set notify on
	ENDPROC

	PROCEDURE Combo1.GotFocus
		set notify off
	ENDPROC

	PROCEDURE Combo1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					sele clientes
					set order to cli_nomb
					seek allt(this.list(i))
					thisform.text1.value=cli_codi
					KEYBOARD '{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE Combo1.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade=subst(allt(this.text),2,len(allt(this.text)))
				this.rowsource="select cli_nomb from clientes where cli_nomb like '%'+allt(cade)+'%' order by cli_nomb INTO CURSOR combo1"
				this.value=this.list(1)
				keyboard "{F4}"
				return .F.
			else
				if len(allt(this.text))>0
					this.rowsource="select cli_nomb from clientes where cli_nomb=allt(this.text) order by cli_nomb INTO CURSOR combo1"
					this.value=this.list(1)
					keyboard "{F4}"
					return .F.
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.Click
		local cs
		cs=0
		set point to ","
		preg=messagebox("¿Confirma el saldo inicial de $ "+allt(str(thisform.text2.value,15,2))+" ingresado?",4+32+256,"Saldos de Clientes")
		if preg=6
			set point to "."
			sele saldosiniciales
			set order to sini_cod
			go bott
			cs=sini_cod+1
			appe blan
			repla sini_cod with cs
			repla sini_fech with thisform.text3.value
			repla cli_sal with thisform.text2.value
			repla cli_codi with thisform.text1.value
			sele clientes
			set order to cli_codi
			seek thisform.text1.value
			if found()
				repla cli_saldo with cli_saldo+thisform.text2.value
			endif
			with thisform
				.text1.value=0
				.text2.value=0
				.combo1.rowsourcetype=0
				.combo1.clear
				.combo1.value=""
				this.enabled=.F.
				.text1.setfocus
			endwith
		else
			set point to "."
			thisform.text2.setfocus
		endif
	ENDPROC

	PROCEDURE Text1.Click
		this.value=0
		this.setfocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		set notify off
		thisform.combo1.rowsourcetype=3
	ENDPROC

	PROCEDURE Text1.LostFocus
		set notify on
	ENDPROC

	PROCEDURE Text1.Valid
		if this.value>0
			sele clientes
			set order to cli_codi
			seek this.value
			if found()
				codicli=cli_codi
				thisform.combo1.rowsource="SELECT cli_nomb FROM CLIENTES WHERE CLI_CODI=CODICLI INTO CURSOR combo1"
				thisform.combo1.value=thisform.combo1.list(1)
				thisform.text2.value=0
				keyboard '{TAB}'
			else
				=messagebox("Cliente no está en archivo",0+48,"Advertencia")
				this.value=0
				return .F.
			endif
		endif
	ENDPROC

	PROCEDURE Text2.LostFocus
		if this.value<>0
			thisform.command3.enabled=.T.
		endif
	ENDPROC

	PROCEDURE Text3.LostFocus
		thisform.label2.caption="SALDO INICIAL AL "+dtoc(this.value)+":"
	ENDPROC

ENDDEFINE

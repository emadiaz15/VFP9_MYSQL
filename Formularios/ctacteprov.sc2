	PROCEDURE Command5.Click
		local detallar,xopcion,xcodicli,xfecdes,xfechas,saldotot, ;
			  si,com,ncred,pag,regdebe,reghaber,di,saldo,saldoant, ;
			  auxdebe,auxhaber
		saldotot = 0
		set talk off
		SET SAFETY OFF
		sele movitot
		ZAP
		SET SAFETY ON
		detallar=1
		auxdebe=0
		auxhaber=0
		frmctaprov= conectar_db(_screen.cn)
			SQLEXEC(frmctaprov,"select * from proveedores order by prov_codi;","cur_protot")
		desconectar_db(frmctaprov)
		LOCATE
		
		SCAN
			STORE 0 TO si,com,ncred,pag,regdebe,reghaber,di,saldo,saldoant,auxdebe,auxhaber
			
			xcodiprov=cur_protot.prov_codi
			WAIT WINDOW "PROVEEDOR "+ALLTRIM(STR(cur_protot.prov_codi))+" - "+ALLTRIM(cur_protot.prov_nomb) NOWAIT
			with thisform
				xfecdes=.text1.value
				xfechas=.text2.value
				.label4.visible=.F.
				.label6.visible=.F.
				.text4.value=0
				.text8.value=0
				.text9.value=0
				.text10.value=0
				.text11.value=0
				.text12.value=0
				.text4.visible=.F.
				.text8.visible=.F.
				.text9.visible=.F.
				.text10.visible=.F.
				.text11.visible=.F.
				.text12.visible=.F.
				frmctaprov= conectar_db(_screen.cn)
					xopcion=1
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","sic")
					sum sini_imp to si
					xopcion=2
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","compras")
					sum com_imp to com
					xopcion=3
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","notascred")		
					sum cre_imp to ncred
					xopcion=4
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","pagos")
					sum pag_imp to pag
					xopcion=5
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","regul")
					sum regul.reg_imp for regul.regp_conc="D" to regdebe
					sum regul.reg_imp for regul.regp_conc="H" to reghaber
					xopcion=12
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","debint")
					sum debin_imp to di
						 
					saldo=round(si+com+di-ncred-pag+regdebe-reghaber,2)
		
					xopcion=6
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifsic")
					xopcion=7
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","veriffac")
					xopcion=8
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifcre")
					xopcion=9
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifdeb")
			 		xopcion=10
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifrec")
					xopcion=11
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifregul")
					xopcion=13
					SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifdebint")
				desconectar_db(frmctaprov)
				select * from veriffac union (select * from verifsic) union ;
					(select * from verifcre) union ;
					(select * from verifdeb) union ;
					(select * from verifrec) union ;
					(select * from verifregul) union ;
					(select * from verifdebint) into cursor detacta
				sele detacta
				index on dtos(mov_fech)+str(recep_codi) to SYS(2015)
				saldoant=saldo
				SELECT movitot
				APPEND BLANK
				REPLACE cbte WITH "SALDO ANTERIOR"
				REPLACE debe WITH si+com+di+regdebe
				REPLACE haber WITH ncred+pag+reghaber
				REPLACE salmov WITH saldo
				REPLACE movitot.codprov WITH xcodiprov
				REPLACE movitot.nomprov WITH ALLTRIM(cur_protot.prov_nomb)
				REPLACE movitot.saltot WITH saldo
		
				auxdebe=si+com+di+regdebe
				auxhaber=ncred+pag+reghaber
				if detallar=1
					.command3.enabled=.T.
					sele detacta
					cantreg=reccount()
					go top
					SCAN
						frmctaprov= conectar_db(_screen.cn)
						do case
							case tipmov_codi=1 or tipmov_codi=7 or tipmov_codi=8
								SQLEXEC(frmctaprov,"select * from recepciones where recep_codi=?detacta.recep_codi;","cur_famov")
								pto=repl("0",4-len(allt(str(cur_famov.prov_pto))))+allt(str(cur_famov.prov_pto))+"-"
								nro=repl("0",8-len(allt(str(cur_famov.prov_fac))))+allt(str(cur_famov.prov_fac))
							case tipmov_codi=3
								pto=""
								nro="0000-"+repl("0",8-len(allt(str(detacta.pag_codi))))+allt(str(detacta.pag_codi))
							case tipmov_codi=11
								SQLEXEC(frmctaprov,"select * from regulaprov where regp_codi=?detacta.regp_codi;","cur_regmov")
								pto=""
								nro="0000-"+repl("0",8-len(allt(str(cur_regmov.regp_codi))))+allt(str(cur_regmov.regp_codi))
							case tipmov_codi=13
								pto=""
								nro="0000-"+repl("0",8-len(allt(str(detacta.sini_cod))))+allt(str(detacta.sini_cod))
							case tipmov_codi=14
								SQLEXEC(frmctaprov,"select * from debintc where debc_codi=?detacta.debc_codi;","cur_dimov")
								pto=""
								nro="0000"+"-"+repl("0",8-len(allt(str(cur_dimov.debc_codi))))+allt(str(cur_dimov.debc_codi))					
						ENDCASE
						SQLEXEC(frmctaprov,"select tipmov_desc from tiposmovimientos where tipmov_codi=?detacta.tipmov_codi;","cur_tipm")
						desconectar_db(frmctaprov)
						SELECT detacta
						APPEND blank IN movitot
						REPLACE movitot.cbte WITH cur_tipm.tipmov_desc
						REPLACE movitot.nro WITH allt(pto)+allt(nro)
						REPLACE movitot.fecha WITH mov_fech
						do case
							case tipmov_codi=1
								REPLACE movitot.debe WITH mov_impo
								REPLACE movitot.movicod WITH recep_codi
								saldo=saldo+mov_impo
								com=com+mov_impo
							case tipmov_codi=7
								REPLACE movitot.haber WITH mov_impo
								REPLACE movitot.movicod WITH recep_codi
								saldo=saldo-mov_impo
								ncred=ncred+mov_impo
							case tipmov_codi=8
								REPLACE movitot.debe WITH mov_impo
								REPLACE movitot.movicod WITH recep_codi
								saldo=saldo+mov_impo
								com=com+mov_impo
							case tipmov_codi=3
								REPLACE movitot.haber WITH mov_impo
								REPLACE movitot.movicod WITH pag_codi
								saldo=saldo-mov_impo
								pag=pag+mov_impo
							case tipmov_codi=11
								if cur_regmov.regp_conc="D"
									REPLACE movitot.debe WITH mov_impo
									REPLACE movitot.movicod WITH regp_codi
									saldo=saldo+mov_impo
									com=com+mov_impo
								else
									REPLACE movitot.haber WITH mov_impo
									REPLACE movitot.movicod WITH regp_codi
									saldo=saldo-mov_impo
									ncred=ncred+mov_impo
								endif			
							case tipmov_codi=13
								if mov_impo>0
									REPLACE movitot.debe WITH mov_impo
									REPLACE movitot.movicod WITH sini_cod
									com=com+mov_impo
								else
									REPLACE movitot.haber WITH ABS(mov_impo)
									REPLACE movitot.movicod WITH sini_cod
									ncred=ncred+ABS(mov_impo)
								endif			
								saldo=saldo+mov_impo
							case tipmov_codi=14
								REPLACE movitot.debe WITH mov_impo
								REPLACE movitot.movicod WITH debc_codi
								saldo=saldo+mov_impo
								com=com+mov_impo					
						endcase
						REPLACE movitot.salmov WITH saldo
						REPLACE movitot.codprov WITH xcodiprov
						REPLACE movitot.nomprov WITH ALLTRIM(cur_protot.prov_nomb)				
					ENDSCAN
				ENDIF
			ENDWITH
			saldotot = saldotot + saldo
			SKIP -1
			REPLACE movitot.saltot WITH saldo
			SKIP
		ENDSCAN
		WITH THISFORM
			SELECT movitot
			GO top
		*!*		COPY TO "C:\Users\Administrador\Desktop\nuestro\Cuentas_por_Pagar\Por_Pagar.xls" FOX2X
		*!*		GO top	
			.grid1.recordsourcetype=1
			.grid1.recordsource="movitot"
			thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
			.label4.visible=.T.
			.label4.caption="MOVIMIENTOS TOTALES AL "+allt(dtoc(thisform.text2.value))+":"
		*!*			.label6.caption="MOVIMIENTOS EN EL PERÍODO INDICADO: "
		*!*			.btn_movimientos.visible=.T.
			.text4.value=saldotot
		*!*		.text8.value=si+com+di+regdebe
		*!*		.text9.value=ncred+pag+reghaber
		*!*			.text11.value=.text8.value-auxdebe
		*!*			.text12.value=.text9.value-auxhaber
		*!*			.text10.value=.text11.value-.text12.value
			.text4.visible=.T.
			.text8.visible=.T.
			.text9.visible=.T.
			.command2.enabled=.T.
			thisform.Refresh()
			.text1.setfocus
		ENDWITH
		
	ENDPROC

	PROCEDURE Command7.Click
		IF USED("movitot")
			IF RECCOUNT("movitot") > 0
		
				local Fila,fpag,pagina,empresa
		
				wait'Espere Un Momento Exportando Datos' window nowait
				_screen.mousepointer=11
				TmpSheet=GetObject('','Excel.Sheet')
				XLApp=TmpSheet.Application
				XLApp.workbooks.add()
				XLSheet=XLApp.ActiveSheet
				with XLSheet.PageSetup
					.Orientation = 1
					.LeftMargin = XLApp.InchesToPoints(0)
					.RightMargin = XLApp.InchesToPoints(0)
				    .TopMargin = XLApp.InchesToPoints(0)
				    .BottomMargin = XLApp.InchesToPoints(0)
				    .HeaderMargin = XLApp.InchesToPoints(0)
				    .FooterMargin = XLApp.InchesToPoints(0)
				    .Zoom=85
				ENDWITH
				XLSheet.Columns("A:A").ColumnWidth = 8.43
				XLSheet.Columns("B:B").ColumnWidth = 16.14
				XLSheet.Columns("C:C").ColumnWidth = 13.71
				XLSheet.Columns("D:D").ColumnWidth = 10.71
				XLSheet.Columns("E:E").ColumnWidth = 18.29
				XLSheet.Columns("F:F").ColumnWidth = 18.29
				XLSheet.Columns("G:G").ColumnWidth = 18.29
		
				thisform.excelencabezado()
		
				SELECT movitot
				LOCATE
				Fila=10
				SCAN
					XLSheet.Cells(Fila,2)=movitot.cbte
				   	XLSheet.Cells(Fila,2).HorizontalAlignment=-4131				
					XLSheet.Cells(Fila,3)=movitot.nro
				   	XLSheet.Cells(Fila,3).HorizontalAlignment=-4108
					XLSheet.Cells(Fila,4)=DTOC(movitot.fecha)
					XLSheet.Cells(Fila,4).HorizontalAlignment=-4108
				   	XLSheet.Cells(Fila,5)=movitot.debe
				   	XLSheet.Cells(Fila,5).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
				   	XLSheet.Cells(Fila,6)=movitot.haber
				   	XLSheet.Cells(Fila,6).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
				   	XLSheet.Cells(Fila,7)=movitot.salmov
				   	XLSheet.Cells(Fila,7).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
				   	IF movitot.salmov < 0
				   		XLSheet.Cells(Fila,7).Font.Color=RGB(255,0,0)
				   	ENDIF
				   	Fila=Fila+1
				ENDSCAN
		
				thisform.excelfooter(Fila)
		
				XLApp.visible=.T.
				XLApp.WindowState = -4137
				DECLARE LONG BringWindowToTop IN "user32" LONG HWND
				BringWindowToTop(XLApp.HWND)
				_screen.mousepointer=0
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Grid1.DblClick
		do case
			case allt(movitot.cbte)="FACTURA" or allt(movitot.cbte)="NOTA DE CREDITO" or allt(movitot.cbte)="NOTA DE DEBITO"
				codr=movitot.movicod
				pasrecep=1
				IF allt(movitot.cbte)="FACTURA"
					valorcadena="Recepciones"
				ELSE
					valorcadena="Notas de Crédito/Notas de Débito"
				ENDIF
				do form consrecep with codr,cond
			case allt(movitot.cbte)="ORDEN DE PAGO"
				codipag=movitot.movicod
				paspago=1
				do form conspago with codipag,cond
			case allt(movitot.cbte)="DEBITO INTERNO"
				debintpro=movitot.movicod
				pasdic=1
				do form consdebintpro with debintpro
			case allt(movitot.cbte)="CREDITO INTERNO"
				creintpro=movitot.movicod
				pasdic=1
				do form conscreintpro with creintpro
		endcase
		
	ENDPROC

	PROCEDURE Grid1.RightClick
		LOCAL lcShortcut, loRef
		m.loRef = this
		m.loRefp = this.Parent
		m.lcShortcut = SYS(2015)
		
		DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Consultar Comprobante] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
		DEFINE BAR 2 OF (m.lcShortcut) PROMPT [Anular Orden de Pago] PICTURE "C:\VFP9_MYSQL\imagen\iconos\thumbsdown_2.ico"
		
		ON SELECTION BAR 1 OF (m.lcShortcut) m.loRef.DblClick()
		ON SELECTION BAR 2 OF (m.lcShortcut) m.loRefp.anularpago(movitot.movicod)
		IF ALLTRIM(movitot.cbte) = "ORDEN DE PAGO"
			SET SKIP OF BAR 2 OF (m.lcShortcut) .F.
		ELSE
			SET SKIP OF BAR 2 OF (m.lcShortcut) .T.
		ENDIF
		ACTIVATE POPUP (m.lcShortcut)
		RELEASE POPUP (m.lcShortcut)
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text11.Click
		messagebox("TOTAL FACTURAS Y DÉBITOS"+chr(13)+ ;
				   "EN EL PERÍODO INDICADO: "+allt(TRANSFORM(this.value-auxdebe,"$ 999,999,999.99")),0+64,"Movimientos")
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text12.Click
		messagebox("TOTAL PAGOS Y CRÉDITOS"+chr(13)+ ;
		           "EN EL PERÍODO INDICADO: "+allt(TRANSFORM(this.value-auxhaber,"$ 999,999,999.99")),0+64,"Movimientos")
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.LostFocus
		thisform.command1.enabled=.T.
	ENDPROC


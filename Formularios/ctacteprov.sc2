	PROCEDURE Command3.Click
		SELECT datprinp
		SET SAFETY OFF
		ZAP
		SET SAFETY ON
		
		INSERT INTO datprinp values(thisform.text1.Value,thisform.text2.Value, ;
								   thisform.text11.Value,thisform.text12.Value, ;
								   thisform.text10.Value,thisform.dispmov)
		
		sele movitot
		go top
		cantreg=RECCOUNT()
		report form resumenprov TO PRINTER prompt noconsole
		
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.

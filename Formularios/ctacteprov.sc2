		XLSheet.Range(XLSheet.Cells(9,2),XLSheet.Cells(9,7)).Borders.Weight=3
		XLSheet.Range(XLSheet.Cells(9,2),XLSheet.Cells(9,7)).Interior.Color= RGB(192,192,192)
		
		return
	ENDPROC

	PROCEDURE excelfooter
		LPARAMETERS nFila
		
		XLSheet.Rows(nFila).RowHeight = 10
		XLSheet.Range(XLSheet.Cells(nFila,2),XLSheet.Cells(nFila,7)).Borders(4).LineStyle=0
		XLSheet.Range(XLSheet.Cells(nFila,2),XLSheet.Cells(nFila,7)).Borders(4).Weight=3
		
		nFila = nFila + 1
		
		IF thisform.dispmov=1
			XLSheet.Cells(nFila,4)="MOVIMIENTOS EN EL PERÍODO INDICADO:"
			XLSheet.Cells(nFila,4).HorizontalAlignment=-4152
			XLSheet.Cells(nFila,5)=thisform.text11.value
			XLSheet.Cells(nFila,5).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
			XLSheet.Cells(nFila,6)=thisform.text12.value
			XLSheet.Cells(nFila,6).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
			XLSheet.Cells(nFila,7)=thisform.text10.value
			XLSheet.Cells(nFila,7).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
			XLSheet.Range(XLSheet.Cells(nFila,4),XLSheet.Cells(nFila,7)).Font.Color=RGB(0,0,255)
			XLSheet.Range(XLSheet.Cells(nFila,4),XLSheet.Cells(nFila,7)).Font.Bold=.T.
		ELSE
			XLSheet.Rows(nFila).RowHeight = 10
		ENDIF
		nFila = nFila + 1
		XLSheet.Cells(nFila,4)="MOVIMIENTOS TOTALES AL "+DTOC(thisform.text2.value)+":"
		XLSheet.Cells(nFila,4).HorizontalAlignment=-4152
		XLSheet.Cells(nFila,5)=thisform.text8.value
		XLSheet.Cells(nFila,5).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		XLSheet.Cells(nFila,6)=thisform.text9.value
		XLSheet.Cells(nFila,6).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		XLSheet.Cells(nFila,7)=thisform.text4.value
		XLSheet.Cells(nFila,7).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		IF thisform.text4.Value < 0
			XLSheet.Cells(nFila,7).Font.Color=RGB(255,0,0)
		ENDIF
		XLSheet.Range(XLSheet.Cells(nFila,4),XLSheet.Cells(nFila,7)).Font.Bold=.T.
		
		RETURN
		
		
	ENDPROC

	PROCEDURE GotFocus
		set point to ","
		set separator to "."
	ENDPROC

	PROCEDURE grid_rightclick
		*!*	IF USED("movitot")
		*!*		IF RECCOUNT("movitot") > 0
		*!*			LOCAL lcShortcut, loRef
		*!*			m.loRef = this
		*!*			m.lcShortcut = SYS(2015)
		
		*!*			DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		*!*			DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Consultar Comprobante]
		*!*			DEFINE BAR 2 OF (m.lcShortcut) PROMPT [Anular Orden de Pago]
		
		*!*			ON SELECTION BAR 1 OF (m.lcShortcut) do form anulapend with cur_planp.pedcodi,cur_planp.estado
		*!*			ON SELECTION BAR 2 OF (m.lcShortcut) m.loRef.Grid_ShowDesc()
		*!*			
		*!*			IF ALLTRIM(movitot.cbte) = "ORDEN DE PAGO"
		*!*				SET SKIP OF BAR 2 OF (m.lcShortcut) .T.
		*!*			ELSE
		*!*				SET SKIP OF BAR 2 OF (m.lcShortcut) .F.
		*!*			ENDIF
		*!*			ACTIVATE POPUP (m.lcShortcut)
		*!*			RELEASE POPUP (m.lcShortcut)
		*!*		ENDIF
		*!*	ENDIF
	ENDPROC

	PROCEDURE Init
		*clear memo
		this.text6.value=0
		public codiprov,saldoant,cantreg,codipag,codr,auxdebe,auxhaber,pasocurp
		set point to ","
		set separator to "."
		set dele on
		set date british
		set cent on
		codiprov=0
		saldoant=0
		cantreg=0
		pasocurp=0
		do form provload with codiprov
		if codiprov>0
			pasocurp=1
			this.text5.value=codiprov
			this.text3.value=cur_prov.prov_nomb
			this.text6.value="0"+allt(cur_prov.prov_cartel)+"-"+allt(cur_prov.prov_tel1)
			cond=cond_codi
			this.command2.Enabled= .T.
		else
			this.release
		endif
		this.text1.value=ctod("01"+"/"+"01"+"/"+allt(str(year(date()))))
		this.text2.value=date()
		
		CREATE CURSOR datprinp(fecdes D,fechas D,perdebe N(12,2),perhab N(12,2),pertot N(12,2),ocultar N(1))
		
		create cursor detacta(mov_codi N(8),mov_fech D,tipmov_codi N(8),recep_codi N(8),pag_codi N(8),regp_codi N(8),sini_cod N(8),debc_codi N(8),crec_codi N(8),mov_impo N(15,2))
		
		CREATE CURSOR movitot(cbte C(25),nro C(13),fecha D,debe N(15,2),haber N(15,2),salmov N(15,2),movicod N(8))
		
		*!*	FOR ncol=1 TO 6
		*!*		xsource="Thisform.grid1.column"+ALLTRIM(STR(ncol))+".text1"
		*!*		BINDEVENT(&xsource,"RightClick",Thisform,"grid_rightclick")
		*!*	NEXT ncol
		
		
	ENDPROC

	PROCEDURE LostFocus
		set point to
		set separator to
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(215,215,215)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE btn_movimientos.btn.Click
		DO case
			CASE thisform.dispmov=0
				thisform.dispmov=1
				this.parent.img_boton.Picture="C:\VFP9_MYSQL\imagen\iconos\database_previous.png"
				this.ToolTipText="Ocultar Movimientos en el Período Indicado"
				thisform.label6.Visible= .T.
				thisform.text10.Visible= .T.
				thisform.text11.Visible= .T.
				thisform.text12.Visible= .T.
			CASE thisform.dispmov=1
				thisform.dispmov=0
				this.parent.img_boton.Picture="C:\VFP9_MYSQL\imagen\iconos\database_together.png"
				this.ToolTipText="Mostrar Movimientos en el Período Indicado"
				thisform.label6.Visible= .F.
				thisform.text10.Visible= .F.
				thisform.text11.Visible= .F.
				thisform.text12.Visible= .F.
		ENDCASE
		
	ENDPROC

	PROCEDURE btn_movimientos.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE btn_movimientos.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE btn_movimientos.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE Command1.Click
		local detallar,xopcion,xcodicli,xfecdes,xfechas
		set talk off
		SET SAFETY OFF
		sele movitot
		ZAP
		SET SAFETY ON
		detallar=1
		auxdebe=0
		auxhaber=0
		xcodiprov=codiprov
		with thisform
			xfecdes=.text1.value
			xfechas=.text2.value
			.label4.visible=.F.
			.label6.visible=.F.
			.text4.value=0
			.text8.value=0
			.text9.value=0
			.text10.value=0
			.text11.value=0
			.text12.value=0
			.text4.visible=.F.
			.text8.visible=.F.
			.text9.visible=.F.
			.text10.visible=.F.
			.text11.visible=.F.
			.text12.visible=.F.
			frmctaprov= conectar_db(_screen.cn)
				xopcion=1
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","sic")
				sum sini_imp to si
				xopcion=2
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","compras")
				sum com_imp to com
				xopcion=3
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","notascred")		
				sum cre_imp to ncred
				xopcion=4
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","pagos")
				sum pag_imp to pag
				xopcion=5
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","regul")
				sum regul.reg_imp for regul.regp_conc="D" to regdebe
				sum regul.reg_imp for regul.regp_conc="H" to reghaber
				xopcion=12
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","debintp")
				sum debinp_imp to di
				xopcion=14
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","creintp")
				sum creinp_imp to ci			
					 
				saldo=round(si+com+di-ci-ncred-pag+regdebe-reghaber,2)
		
				xopcion=6
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifsic")
				xopcion=7
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","veriffac")
				xopcion=8
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifcre")
				xopcion=9
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifdeb")
		 		xopcion=10
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifrec")
				xopcion=11
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifregul")
				xopcion=13
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifdebint")
				xopcion=15
				SQLEXEC(frmctaprov,"call usp_ctaprov(?xopcion,?xcodiprov,?xfecdes,?xfechas);","verifcreint")
			desconectar_db(frmctaprov)
			select * from veriffac union (select * from verifsic) union ;
				(select * from verifcre) union ;
				(select * from verifdeb) union ;
				(select * from verifrec) union ;
				(select * from verifregul) union ;
				(select * from verifdebint)UNION ; 
				(select * from verifcreint) into cursor detacta
			sele detacta
			index on dtos(mov_fech)+str(recep_codi) to SYS(2015)
			saldoant=saldo
			versic=""
			verfac=""
			verdeb=""
			vercre=""
			verrec=""
			verreg=""
			verdi=""
			verci=""
			sele verifsic
			if reccount()=0
				versic="S"
			endif
			sele veriffac
			if reccount()=0
				verfac="S"
			endif
			sele verifdeb
			if reccount()=0
				verdeb="S"
			endif
			sele verifcre
			if reccount()=0
				vercre="S"
			endif
			sele verifrec
			if reccount()=0
				verrec="S"
			endif
			sele verifregul
			if reccount()=0
				verreg="S"
			ENDIF
			sele verifdebint
			if reccount()=0
				verdi="S"
			ENDIF
			sele verifcreint
			if reccount()=0
				verci="S"
			endif				
			if versic="S" and verfac="S" and verdeb="S" and vercre="S" and verrec="S" and verreg="S" and verdi="S" and verci="S"
				messagebox("Sin movimientos en el período indicado",0+64,"Cuantas Corrientes")
				detallar=0
				.command3.enabled=.F.
			endif
			SELECT movitot
			APPEND BLANK
			REPLACE cbte WITH "SALDO ANTERIOR"
			REPLACE debe WITH si+com+di+regdebe
			REPLACE haber WITH ncred+pag+reghaber
			REPLACE salmov WITH saldo
		
			auxdebe=si+com+di+regdebe
			auxhaber=ncred+ci+pag+reghaber
			if detallar=1
				.command3.enabled=.T.
				sele detacta
				cantreg=reccount()
				go top
				SCAN
					frmctaprov= conectar_db(_screen.cn)
					do case
						case tipmov_codi=1 or tipmov_codi=7 or tipmov_codi=8
							SQLEXEC(frmctaprov,"select * from recepciones where recep_codi=?detacta.recep_codi;","cur_famov")
							pto=repl("0",4-len(allt(str(cur_famov.prov_pto))))+allt(str(cur_famov.prov_pto))+"-"
							nro=repl("0",8-len(allt(str(cur_famov.prov_fac))))+allt(str(cur_famov.prov_fac))
						case tipmov_codi=3
							pto=""
							nro="0000-"+repl("0",8-len(allt(str(detacta.pag_codi))))+allt(str(detacta.pag_codi))
						case tipmov_codi=11
							SQLEXEC(frmctaprov,"select * from regulaprov where regp_codi=?detacta.regp_codi;","cur_regmov")
							pto=""
							nro="0000-"+repl("0",8-len(allt(str(cur_regmov.regp_codi))))+allt(str(cur_regmov.regp_codi))
						case tipmov_codi=13
							pto=""
							nro="0000-"+repl("0",8-len(allt(str(detacta.sini_cod))))+allt(str(detacta.sini_cod))
						case tipmov_codi=14
							SQLEXEC(frmctaprov,"select * from debintc where debc_codi=?detacta.debc_codi;","cur_dimov")
							pto=""
							nro="0000"+"-"+repl("0",8-len(allt(str(cur_dimov.debc_codi))))+allt(str(cur_dimov.debc_codi))					
						case tipmov_codi=15
							SQLEXEC(frmctaprov,"select * from creintc where crec_codi=?detacta.crec_codi;","cur_cimov")
							pto=""
							nro="0000"+"-"+repl("0",8-len(allt(str(cur_cimov.crec_codi))))+allt(str(cur_cimov.crec_codi))					
					ENDCASE
					SQLEXEC(frmctaprov,"select tipmov_desc from tiposmovimientos where tipmov_codi=?detacta.tipmov_codi;","cur_tipm")
					desconectar_db(frmctaprov)
					SELECT detacta
					APPEND blank IN movitot
					REPLACE movitot.cbte WITH cur_tipm.tipmov_desc
					REPLACE movitot.nro WITH allt(pto)+allt(nro)
					REPLACE movitot.fecha WITH mov_fech
					do case
						case tipmov_codi=1
							REPLACE movitot.debe WITH mov_impo
							REPLACE movitot.movicod WITH recep_codi
							saldo=saldo+mov_impo
							com=com+mov_impo
						case tipmov_codi=7
							REPLACE movitot.haber WITH mov_impo
							REPLACE movitot.movicod WITH recep_codi
							saldo=saldo-mov_impo
							ncred=ncred+mov_impo
						case tipmov_codi=8
							REPLACE movitot.debe WITH mov_impo
							REPLACE movitot.movicod WITH recep_codi
							saldo=saldo+mov_impo
							com=com+mov_impo
						case tipmov_codi=3
							REPLACE movitot.haber WITH mov_impo
							REPLACE movitot.movicod WITH pag_codi
							saldo=saldo-mov_impo
							pag=pag+mov_impo
						case tipmov_codi=11
							if cur_regmov.regp_conc="D"
								REPLACE movitot.debe WITH mov_impo
								REPLACE movitot.movicod WITH regp_codi
								saldo=saldo+mov_impo
								com=com+mov_impo
							else
								REPLACE movitot.haber WITH mov_impo
								REPLACE movitot.movicod WITH regp_codi
								saldo=saldo-mov_impo
								ncred=ncred+mov_impo
							endif			
						case tipmov_codi=13
							if mov_impo>0
								REPLACE movitot.debe WITH mov_impo
								REPLACE movitot.movicod WITH sini_cod
								com=com+mov_impo
							else
								REPLACE movitot.haber WITH ABS(mov_impo)
								REPLACE movitot.movicod WITH sini_cod
								ncred=ncred+ABS(mov_impo)
							endif			
							saldo=saldo+mov_impo
						case tipmov_codi=14
							REPLACE movitot.debe WITH mov_impo
							REPLACE movitot.movicod WITH debc_codi
							saldo=saldo+mov_impo
							com=com+mov_impo
						case tipmov_codi=15
							REPLACE movitot.haber WITH mov_impo
							REPLACE movitot.movicod WITH crec_codi
							saldo=saldo-mov_impo
							com=com-mov_impo										
					endcase
					REPLACE movitot.salmov WITH saldo
				ENDSCAN
			ENDIF
			SELECT movitot
			GO top
			.grid1.recordsourcetype=1
			.grid1.recordsource="movitot"
			thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
			.label4.visible=.T.
			.label4.caption="MOVIMIENTOS TOTALES AL "+allt(dtoc(thisform.text2.value))+":"
		*!*		.label6.visible=.T.
			.label6.caption="MOVIMIENTOS EN EL PERÍODO INDICADO: "
			.btn_movimientos.visible=.T.
			.text4.value=saldo
			.text8.value=si+com+di+regdebe
			.text9.value=ncred+ci+pag+reghaber
			.text11.value=.text8.value-auxdebe
			.text12.value=.text9.value-auxhaber
			.text10.value=.text11.value-.text12.value
			.text4.visible=.T.
			.text8.visible=.T.
			.text9.visible=.T.
		*!*		.text11.visible=.T.
		*!*		.text12.visible=.T.
		*!*		.text10.visible=.T.
			.command2.enabled=.T.
		*!*		this.enabled=.F.
			thisform.Refresh()
			.text1.setfocus
		endwith
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		with thisform
			.label4.visible=.F.
			.label6.visible=.F.
			.text4.value=0
			.text8.value=0
			.text9.value=0
			.text10.value=0
			.text11.value=0
			.text12.value=0
			.text4.visible=.F.
			.text8.visible=.F.
			.text9.visible=.F.
			.text10.visible=.F.
			.text11.visible=.F.
			.text12.visible=.F.
			.Grid1.RecordSource=''
			.grid1.Refresh()
			codiprov=0
			do form provload with codiprov
			if codiprov>0
				cond=cur_prov.cond_codi
				.text5.value=codiprov
				.text3.value=cur_prov.prov_nomb
				.text6.value="0"+allt(cur_prov.prov_cartel)+"-"+allt(cur_prov.prov_tel1)
				.label4.visible=.F.
				.text4.visible=.F.
				.btn_movimientos.Visible=.F.
				thisform.btn_movimientos.img_boton.Picture="c:\vfp9_mysql\imagen\iconos\database_together.png"
				thisform.dispmov=0
				.text1.setfocus
			else
				.release
			endif
		ENDWITH
	ENDPROC


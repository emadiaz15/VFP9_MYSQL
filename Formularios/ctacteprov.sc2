	PROCEDURE Activate
		IF pasocurp=1
			codiprov=cur_prov.prov_codi
			cond=cur_prov.cond_codi
		ELSE
			thisform.Release
		endif
	ENDPROC

	PROCEDURE anularpago
		LPARAMETERS xcodi
		
		do form anulapagnum with xcodi
		
		thisform.command1.Click()
		
		RETURN
		
	ENDPROC

	PROCEDURE Destroy
		set point to
		set separator to
	ENDPROC

	PROCEDURE excelencabezado
		
		XLSheet.range("C2:F2").merge
		Xlsheet.cells(2,3)="RESUMEN DE CUENTA"
		XLSheet.Cells(2,3).font.bold=.T.
		XLSheet.Cells(2,3).font.underline=.T.
		XLSheet.Cells(2,3).font.size="14"
		XLSheet.Cells(2,3).font.name="Calibri"
		XLSheet.range("C2:F2").HorizontalAlignment=7
		
		Xlsheet.cells(3,6)='FECHA:'
		XLSheet.Cells(3,6).font.bold=.T.
		XLSheet.Cells(3,6).font.size="11"
		XLSheet.Cells(3,6).font.name="Calibri"
		XLSheet.Cells(3,6).HorizontalAlignment=-4152
		Xlsheet.cells(3,7)=DATE()
		XLSheet.Cells(3,7).font.size="11"
		XLSheet.Cells(3,7).font.name="Calibri"
		XLSheet.Cells(3,7).HorizontalAlignment=-4131
		
		Xlsheet.cells(5,2)='PROVEEDOR:'
		XLSheet.Cells(5,2).font.bold=.T.
		XLSheet.Cells(5,2).font.size="11"
		XLSheet.Cells(5,2).font.name="Calibri"
		XLSheet.Cells(5,2).HorizontalAlignment=-4152
		Xlsheet.cells(5,3)="  "+ALLTRIM(STR(THISFORM.TEXT5.Value))+" - "+ALLTRIM(thisform.text3.Value)
		XLSheet.Cells(5,3).font.size="11"
		XLSheet.Cells(5,3).font.name="Calibri"
		XLSheet.Cells(5,3).HorizontalAlignment=-4131
		
		Xlsheet.cells(5,7)="TEL: "+ALLTRIM(thisform.text6.value)
		XLSheet.Cells(5,7).font.size="11"
		XLSheet.Cells(5,7).font.name="Calibri"
		XLSheet.Cells(5,7).HorizontalAlignment=7
		
		Xlsheet.cells(7,2)=SPACE(20)+"PERÍODO DESDE EL "+ALLTRIM(DTOC(thisform.text1.value))+" AL "+ALLTRIM(DTOC(thisform.text2.value))
		XLSheet.Cells(7,2).font.size="11"
		XLSheet.Cells(7,2).font.name="Calibri"
		
		XLSheet.Cells(9,2)="COMPROBANTE"
		XLSheet.Cells(9,2).font.bold=.T.
		XLSheet.Cells(9,2).font.size="11"
		XLSheet.Cells(9,2).font.name="Calibri"
		XLSheet.Cells(9,2).HorizontalAlignment=7
		XLSheet.Cells(9,3)="NÚMERO"
		XLSheet.Cells(9,3).font.bold=.T.
		XLSheet.Cells(9,3).font.size="11"
		XLSheet.Cells(9,3).font.name="Calibri"
		XLSheet.Cells(9,3).HorizontalAlignment=7
		XLSheet.Cells(9,4)="FECHA"
		XLSheet.Cells(9,4).font.bold=.T.
		XLSheet.Cells(9,4).font.size="11"
		XLSheet.Cells(9,4).font.name="Calibri"
		XLSheet.Cells(9,4).HorizontalAlignment=7
		XLSheet.Cells(9,5)="DEBE"
		XLSheet.Cells(9,5).font.bold=.T.
		XLSheet.Cells(9,5).font.size="11"
		XLSheet.Cells(9,5).font.name="Calibri"
		XLSheet.Cells(9,5).HorizontalAlignment=7
		XLSheet.Cells(9,6)="HABER"
		XLSheet.Cells(9,6).font.bold=.T.
		XLSheet.Cells(9,6).font.size="11"
		XLSheet.Cells(9,6).font.name="Calibri"
		XLSheet.Cells(9,6).HorizontalAlignment=7
		XLSheet.Cells(9,7)="SALDO"
		XLSheet.Cells(9,7).font.bold=.T.
		XLSheet.Cells(9,7).font.size="11"
		XLSheet.Cells(9,7).font.name="Calibri"

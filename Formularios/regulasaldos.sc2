	PROCEDURE Pageframe1.Page2.Text22.LostFocus
		set point to ","
		do case
			case thisform.pageframe1.page2.optiongroup1.value=2 and this.value>auxsal
				messagebox("No puede restar un valor mayor al saldo a favor que cliente posee",0+48,"Cobranzas")
				this.value=thisform.pageframe1.page2.text21.value
				nodefault
		*!*		case this.value=0
		*!*			pp=messagebox("Quedará el total del saldo a favor del cliente. ¿Continúa igualmente?",4+48+256,"Cobranzas")
		*!*			if pp=7
		*!*				this.value=thisform.pageframe1.page2.text21.value

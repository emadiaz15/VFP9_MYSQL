		*!*		case this.value<thisform.pageframe1.page2.text21.value and this.value>0
		*!*			pp=messagebox("Quedará aún saldo a favor del cliente. ¿Continúa igualmente?",4+48+256,"Cobranzas")
		*!*			if pp=7
		*!*				this.value=thisform.pageframe1.page2.text21.value
		*!*				nodefault
		*!*			else
		*!*				thisform.pageframe1.page3.command1.enabled=.T.
		*!*			endif
			case this.value<0
				=messagebox("Imposible ingresar un valor negativo",0+48,"Cobranzas")
				this.value=thisform.pageframe1.page2.text21.value
				nodefault

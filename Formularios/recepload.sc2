	PROCEDURE Activate
		if codiprov=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE buscarrecepcionesporarticulo
		LPARAMETERS tnArtCodi
		LOCAL frmreceplo
		
		IF EMPTY(tnArtCodi) OR tnArtCodi = 0
			RETURN .F.
		ENDIF
		
		THISFORM.grid1.Rows = 1
		THISFORM.command2.Enabled = .F.
		
		IF USED("cur_rlo")
			USE IN cur_rlo
		ENDIF
		
		frmreceplo = conectar_db(_screen.cn)
		
		IF valorcadena="Notas de Crédito/Notas de Débito" OR valorcadena="N. Crédito/N. Débito"
			SQLEXEC(frmreceplo, ;
				"select distinct CONCAT('  ',CAST(r.prov_pto AS CHAR)), " + ;
				"CONCAT('  ',CAST(r.prov_fac AS CHAR)), " + ;
				"r.recep_fec, r.recep_codi " + ;
				"from recepciones r " + ;
				"inner join recepciones_articulos ra on r.recep_codi=ra.recep_codi " + ;
				"where r.prov_codi=?codiprov and r.recep_conc<>'F' and ra.art_codi=?tnArtCodi " + ;
				"order by r.recep_fec desc;", ;
				"cur_rlo")
		ELSE
			SQLEXEC(frmreceplo, ;
				"select distinct CONCAT('  ',CAST(r.prov_pto AS CHAR)), " + ;
				"CONCAT('  ',CAST(r.prov_fac AS CHAR)), " + ;
				"r.recep_fec, r.recep_codi " + ;
				"from recepciones r " + ;
				"inner join recepciones_articulos ra on r.recep_codi=ra.recep_codi " + ;
				"where r.prov_codi=?codiprov and r.recep_conc='F' and ra.art_codi=?tnArtCodi " + ;
				"order by r.recep_fec desc;", ;
				"cur_rlo")
		ENDIF
		
		desconectar_db(frmreceplo)
		
		IF USED("cur_rlo") AND RECCOUNT("cur_rlo") > 0
			THISFORM.lst_receplo.RowSource = "cur_rlo"
			THISFORM.lst_receplo.Requery()
			THISFORM.lst_receplo.Selected(1) = .T.
			THISFORM.CargarDetalleRecepcion()
			THISFORM.command2.Enabled = .T.
		ELSE
			THISFORM.lst_receplo.RowSource = ""
			THISFORM.grid1.Rows = 1
			THISFORM.command2.Enabled = .F.
			MESSAGEBOX("No existen recepciones del proveedor con ese artículo.",48,"Aviso")
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargardetallerecepcion
		LOCAL contador, frmreceplo, lnRowMatch
		LOCAL cadena, div, longdes, lcDescri
		
		contador = 1
		lnRowMatch = 0
		
		THISFORM.grid1.Rows = 1
		
		IF !USED("cur_rlo")
			RETURN .F.
		ENDIF
		
		IF EOF("cur_rlo")
			RETURN .F.
		ENDIF
		
		IF USED("cur_recalo")
			USE IN cur_recalo
		ENDIF
		
		frmreceplo= conectar_db(_screen.cn)
			SQLEXEC(frmreceplo,"select a.art_codi,b.art_desc,a.artrecep_dasc,a.artrecep_prec from recepciones_articulos a inner join articulos b on a.art_codi=b.art_codi where recep_codi=?cur_rlo.recep_codi;","cur_recalo")
		desconectar_db(frmreceplo)
		
		WITH THISFORM
			IF RECCOUNT("cur_recalo") > 0
				SELECT cur_recalo
				GO TOP
				SCAN
					cadena = REPL("0",8-LEN(ALLT(STR(cur_recalo.art_codi)))) + ALLT(STR(cur_recalo.art_codi))
		
					IF cur_recalo.art_codi=4 OR cur_recalo.art_codi=5
						lcDescri = cur_recalo.artrecep_dasc
					ELSE
						lcDescri = cur_recalo.art_desc
					ENDIF
					
					.grid1.AddItem(STR(contador)+CHR(9)+cadena+CHR(9)+lcDescri+CHR(9)+TRANSFORM(cur_recalo.artrecep_prec, "$ 999,999,999.99"))
		
					.grid1.Row = .grid1.Rows-1
					.grid1.Col = 1
		
					IF LEN(ALLT(.grid1.Text))>47
						div = LEN(ALLT(.grid1.Text))/47
						IF div>INT(div)
							longdes = INT(div)+1
						ELSE
							longdes = div
						ENDIF
						longdes = longdes*250
						.grid1.RowHeight(.grid1.Row)=longdes
					ELSE
						.grid1.RowHeight(.grid1.Row)=270
					ENDIF
		
					.grid1.Col=0
					.grid1.CellAlignment=3
					.grid1.Col=1
					.grid1.CellAlignment=3
					.grid1.Col=2
					.grid1.CellAlignment=0
					.grid1.Col=3
					.grid1.CellAlignment=8
		
					IF PEMSTATUS(THISFORM,"xArtFiltro",5) AND THISFORM.xArtFiltro>0
						IF cur_recalo.art_codi = THISFORM.xArtFiltro
							lnRowMatch = .grid1.Rows-1
						ENDIF
					ENDIF
		
					contador = contador+1
				ENDSCAN
		
				IF lnRowMatch > 0
					.grid1.Row = lnRowMatch
					.grid1.Col = 0
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
					.grid1.Col = 1
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
					.grid1.Col = 2
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
					.grid1.Col = 3
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
					.grid1.Row = lnRowMatch
				ENDIF
		
				.command2.Enabled = .T.
			ENDIF
		ENDWITH
		
		RETURN .T.
	ENDPROC

	PROCEDURE Init
		parameter proveedor,codiprov
		public cond,i,codr,valorcadena,contador
		
		IF !PEMSTATUS(THISFORM,"xArtFiltro",5)
			THISFORM.AddProperty("xArtFiltro",0)
		ENDIF
		
		set date british
		set cent on
		set dele on
		WITH thisform
			if codiprov=0
				do form provload with proveedor,codiprov
				cond=cond_codi
				.text1.value=cur_prov.prov_nomb
				.text2.value=cur_prov.prov_domi
				.text6.value=cur_prov.cond_desc
				.text12.value=cur_prov.prov_cuit
				.text3.value=cur_prov.cp_nro
				.text4.value=cur_prov.loca_nomb
				.text5.value=cur_prov.provi_nomb
			ELSE
				frmreceplo= conectar_db(_screen.cn)
					SQLEXEC(frmreceplo,"call usp_buscarprov(?codiprov);","cur_prov")
				desconectar_db(frmreceplo)
				.text1.value=cur_prov.prov_nomb
				.text2.value=cur_prov.prov_domi
				.text6.value=cur_prov.cond_desc
				.text12.value=cur_prov.prov_cuit
				.text3.value=cur_prov.cp_nro
				.text4.value=cur_prov.loca_nomb
				.text5.value=cur_prov.provi_nomb
			ENDIF
			this.text7.Value=0
			if valorcadena="Notas de Crédito/Notas de Débito" or valorcadena="N. Crédito/N. Débito"
				.caption="Localización de Notas de Crédito/Notas de Débito"
				.label5.autosize=.T.
				.label5.caption="Notas de Crédito/Notas de Débito"
				frmreceplo= conectar_db(_screen.cn)
					SQLEXEC(frmreceplo,"select CONCAT('  ',CAST(prov_pto AS CHAR)),CONCAT('  ',CAST(prov_fac AS CHAR)),recep_fec,recep_codi from recepciones where prov_codi=?codiprov and recep_conc<>'F' ORDER BY recep_fec DESC;","cur_rlo")
				desconectar_db(frmreceplo)
			ELSE
				frmreceplo= conectar_db(_screen.cn)
					SQLEXEC(frmreceplo,"select CONCAT('  ',CAST(prov_pto AS CHAR)),CONCAT('  ',CAST(prov_fac AS CHAR)),recep_fec,recep_codi from recepciones where prov_codi=?codiprov and recep_conc='F' ORDER BY recep_fec DESC","cur_rlo")
				desconectar_db(frmreceplo)				
			ENDIF
			IF RECCOUNT("cur_rlo") > 0
				thisform.lst_receplo.RowSource="cur_rlo"
				thisform.lst_receplo.Selected(1)=.T.
				thisform.command2.enabled=.T.
				thisform.CargarDetalleRecepcion()
			ENDIF
		ENDWITH
	ENDPROC

	PROCEDURE recargarrecepcionesproveedor
		LOCAL frmreceplo
		
		THISFORM.grid1.Rows = 1
		THISFORM.xArtFiltro = 0
		THISFORM.label8.Caption = ""
		THISFORM.text7.Value = 0
		
		IF USED("cur_rlo")
			USE IN cur_rlo
		ENDIF
		
		frmreceplo= conectar_db(_screen.cn)
		
		IF valorcadena="Notas de Crédito/Notas de Débito" OR valorcadena="N. Crédito/N. Débito"
			SQLEXEC(frmreceplo,"select CONCAT('  ',CAST(prov_pto AS CHAR)),CONCAT('  ',CAST(prov_fac AS CHAR)),recep_fec,recep_codi from recepciones where prov_codi=?codiprov and recep_conc<>'F' ORDER BY recep_fec DESC;","cur_rlo")
		ELSE
			SQLEXEC(frmreceplo,"select CONCAT('  ',CAST(prov_pto AS CHAR)),CONCAT('  ',CAST(prov_fac AS CHAR)),recep_fec,recep_codi from recepciones where prov_codi=?codiprov and recep_conc='F' ORDER BY recep_fec DESC;","cur_rlo")
		ENDIF
		
		desconectar_db(frmreceplo)
		
		IF RECCOUNT("cur_rlo") > 0
			THISFORM.lst_receplo.RowSource="cur_rlo"
			THISFORM.lst_receplo.Selected(1)=.T.
			THISFORM.command2.Enabled=.T.
			THISFORM.CargarDetalleRecepcion()
		ELSE
			THISFORM.lst_receplo.RowSource=""
			THISFORM.command2.Enabled=.F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE Command1.Click
		local paso
		paso=0
		thisform.grid1.rows=1
		
		with thisform
			do form provload with proveedor,codiprov
			cond=cond_codi
			.text1.value=cur_prov.prov_nomb
			.text2.value=cur_prov.prov_domi
			.text6.value=cur_prov.cond_desc
			.text12.value=cur_prov.prov_cuit
			.text3.value=cur_prov.cp_nro
			.text4.value=cur_prov.loca_nomb
			.text5.value=cur_prov.provi_nomb
			if valorcadena="Notas de Crédito/Notas de Débito" or valorcadena="N. Crédito/N. Débito"
				.caption="Localización de Notas de Crédito/Notas de Débito"
				.label5.autosize=.T.
				.label5.caption="Notas de Crédito/Notas de Débito"
				frmreceplo= conectar_db(_screen.cn)
					SQLEXEC(frmreceplo,"select CONCAT('  ',CAST(prov_pto AS CHAR)),CONCAT('  ',CAST(prov_fac AS CHAR)),recep_fec,recep_codi from recepciones where prov_codi=?codiprov and recep_conc<>'F' ORDER BY recep_fec DESC;","cur_rlo")
				desconectar_db(frmreceplo)
			ELSE
				frmreceplo= conectar_db(_screen.cn)
					SQLEXEC(frmreceplo,"select CONCAT('  ',CAST(prov_pto AS CHAR)),CONCAT('  ',CAST(prov_fac AS CHAR)),recep_fec,recep_codi from recepciones where prov_codi=?codiprov and recep_conc='F' ORDER BY recep_fec DESC","cur_rlo")
				desconectar_db(frmreceplo)				
			ENDIF
			IF RECCOUNT("cur_rlo") > 0
				thisform.lst_receplo.RowSource="cur_rlo"
				thisform.lst_receplo.Selected(1)=.T.
				.command2.enabled=.F.
				thisform.lst_receplo.SetFocus
				thisform.cargardetallerecepcion()
			ENDIF
		endwith
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		do case
			case valorcadena="Recepciones" or valorcadena="N. Crédito/N. Débito"
				codr=cur_rlo.recep_codi
				cond=cur_prov.cond_codi
				do form modirecep with codr,cond
				thisform.release
			case valorcadena="Mercadería Recibida" or valorcadena="Notas de Crédito/Notas de Débito"
				codr=cur_rlo.recep_codi
				cond=cur_prov.cond_codi
				do form consrecep with codr,cond
				thisform.release
		endcase
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		LOCAL frmreceplo
		
		codigo=0
		DO FORM artload WITH codigo
		
		IF codigo>0
			THISFORM.xArtFiltro = codigo
			THISFORM.text7.Value = codigo
		
			IF USED("cur_artbus")
				USE IN cur_artbus
			ENDIF
		
			frmreceplo= conectar_db(_screen.cn)
				SQLEXEC(frmreceplo,"select art_desc from articulos where art_codi=?codigo;","cur_artbus")
			desconectar_db(frmreceplo)
		
			IF USED("cur_artbus") AND RECCOUNT("cur_artbus")>0
				THISFORM.label8.Caption = ALLTRIM(cur_artbus.art_desc)
			ELSE
				THISFORM.label8.Caption = ""
			ENDIF
		
			THISFORM.BuscarRecepcionesPorArticulo(codigo)
		ENDIF
	ENDPROC

	PROCEDURE Command4.GotFocus
		RETURN
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE lst_receplo.Click
		THISFORM.CargarDetalleRecepcion()
	ENDPROC

	PROCEDURE Text1.GotFocus
		*!*	if codiprov<>0
		*!*		with thisform
		*!*			sele proveedores
		*!*			.text1.value=prov_nomb
		*!*			.text2.value=prov_domi
		*!*			.text6.value=condiva.cond_desc
		*!*			.text12.value=prov_cuit
		*!*			.text3.value=codipostales.cp_nro
		*!*			.text4.value=localidades.loca_nomb
		*!*			.text5.value=provincias.provi_nomb
		*!*			.list1.rowsourcetype=3
		*!*			if prompt()="Notas de Crédito/Notas de Débito" or prompt()="N. Crédito/N. Débito"
		*!*				thisform.caption="Localización de Notas de Crédito/Notas de Débito"
		*!*				thisform.label5.autosize=.T.
		*!*				thisform.label5.caption="Notas de Crédito/Notas de Débito"
		*!*				.list1.rowsource="select prov_pto,prov_fac,recep_fec,recep_codi from recepciones where prov_codi=codiprov and recep_conc<>'F' ORDER BY recep_fec DESC INTO CURSOR list1"
		*!*			else
		*!*				.list1.rowsource="select prov_pto,prov_fac,recep_fec,recep_codi from recepciones where prov_codi=codiprov and recep_conc='F' ORDER BY recep_fec DESC INTO CURSOR list1"
		*!*			endif
		*!*		endwith
		*!*	endif
	ENDPROC

	PROCEDURE Text7.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text7.InteractiveChange
		LOCAL lccadena
		lccadena = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lccadena) OR lccadena="0"
			THISFORM.RecargarRecepcionesProveedor()
		ENDIF
	ENDPROC

	PROCEDURE Text7.LostFocus
		RETURN
	ENDPROC

	PROCEDURE Text7.Valid
		LOCAL lncodigoart, lccadena, frmreceplo
		
		lccadena = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lccadena) OR lccadena="0"
			THISFORM.RecargarRecepcionesProveedor()
			RETURN .T.
		ENDIF
		
		lncodigoart = VAL(lccadena)
		
		IF lncodigoart<=0
			THISFORM.xArtFiltro = 0
			THISFORM.label8.Caption = ""
			RETURN .T.
		ENDIF
		
		IF USED("cur_artbus")
			USE IN cur_artbus
		ENDIF
		
		frmreceplo= conectar_db(_screen.cn)
			SQLEXEC(frmreceplo,"select art_desc from articulos where art_codi=?lncodigoart;","cur_artbus")
		desconectar_db(frmreceplo)
		
		IF USED("cur_artbus") AND RECCOUNT("cur_artbus")>0
			THISFORM.xArtFiltro = lncodigoart
			THISFORM.label8.Caption = ALLTRIM(cur_artbus.art_desc)
			THISFORM.BuscarRecepcionesPorArticulo(lncodigoart)
		ELSE
			THISFORM.xArtFiltro = 0
			THISFORM.label8.Caption = ""
			MESSAGEBOX("No existe un artículo con ese código.",48,"Aviso")
		ENDIF
		
		RETURN .T.
	ENDPROC

ENDDEFINE

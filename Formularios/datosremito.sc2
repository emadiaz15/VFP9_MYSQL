	PROCEDURE Init
		parameter codirem,nrorem,nrofac,lugent1,lugent2,observ,flete1,flete2,coditran1,coditran2
		this.caption="Datos importantes para el remito Nº "+allt(str(nrorem))
		this.text1.value=0
		this.text2.value=0
		*!*	sele transportes
		*!*	set order to tran_codi
		*!*	seek coditran1
		frmdatrem= conectar_db(_screen.cn)
			SQLEXEC(frmdatrem,"select * from transportes where tran_codi=?coditran1;","cur_tran1")
			if RECCOUNT("cur_tran1")>0
				this.text4.value=allt(cur_tran1.tran_nomb)
			endif
		*!*		seek coditran2
			SQLEXEC(frmdatrem,"select * from transportes where tran_codi=?coditran2;","cur_tran2")
			if RECCOUNT("cur_tran2")>0
				this.text5.value=allt(cur_tran2.tran_nomb)
			ENDIF
		desconectar_db(frmdatrem)
		
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			LOCAL xlugent,xcargo
			frmdatrem= conectar_db(_screen.cn)
				SQLEXEC(frmdatrem,"update remitos set rem_observ=?observ,flete_peso=?.text1.value,flete_valor=?.text2.value where rem_codi=?codirem;")
				SQLEXEC(frmdatrem,"update histostock set hs_deta=?observ where rem_codi=?codirem;")
				if coditran1>0
					do case
						case .optiongroup1.value=1
							flete1=1
							xcargo="P"
						case .optiongroup1.value=2
							flete1=2
							xcargo="C"
					endcase
					xlugent=allt(.edit1.value)
					SQLEXEC(frmdatrem,"insert into remitos_transportes values(?codirem,?coditran1,?xlugent,?xcargo);")
				endif
				if coditran2>0
					do case
						case .optiongroup2.value=1
							flete2=1
							xcargo="P"
						case .optiongroup2.value=2
							flete2=2
							xcargo="C"
					endcase
					xlugent=allt(.edit3.value)
					SQLEXEC(frmdatrem,"insert into remitos_transportes values(?codirem,?coditran2,?xlugent,?xcargo);")
				ENDIF
			desconectar_db(frmdatrem)
			.release
		endwith
	ENDPROC

	PROCEDURE Command2.Click
		transporte=""
		coditran=0
		do form tranload with transporte,coditran
		if transporte<>" "
			coditran1=coditran
			thisform.text4.value=transporte
			thisform.edit1.setfocus
		endif
	ENDPROC

	PROCEDURE Command3.Click
		transporte=""
		coditran=0
		do form tranload with transporte,coditran
		if transporte<>" "
			coditran2=coditran
			thisform.text5.value=transporte
			thisform.edit3.setfocus
		endif
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Edit2.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit2.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Edit3.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit3.LostFocus

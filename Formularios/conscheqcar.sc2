	PROCEDURE lst_mascheq.Click
		SELECT cartera
		GO top
		*!*	LOCATE FOR chequenro=mascheq.chequenro AND chid=mascheq.chid
		
		LOCATE FOR recpag_codi=VAL(mascheq.recpag_codi)
		
		this.Visible= .F.
		this.ZOrder(1)
		thisform.shp_mascheq.Visible= .F.
		thisform.shp_mascheq.ZOrder(1)
		thisform.lbl_mascheq.Visible= .F.
		thisform.lbl_mascheq.ZOrder(1)
		
		thisform.grd_cheques.setfocus
	ENDPROC

	PROCEDURE opt_estado.Option1.Click
		*!*	LOCAL totmes,totales,concheq,contot
		*!*	STORE 0 TO totmes,totales,cadena,concheq,contot
		*!*	STORE 0 TO thisform.venci,thisform.hoy,thisform.man
		*!*	SELECT cartera
		*!*	SET SAFETY OFF
		*!*	ZAP
		*!*	SET SAFETY ON
		*!*	thisform.grd_cheques.RecordSource=''
		*!*	thisform.grd_cheques.Refresh()
		*!*	thisform.btn_print.Enabled= .F.
		*!*	frmconche= conectar_db(_screen.cn)
		*!*		SQLEXEC(frmconche,"call usp_cheqcar(0);","cheqcar")
		*!*	desconectar_db(frmconche)
		*!*	IF RECCOUNT("cheqcar")>0
		*!*		thisform.btn_print.Enabled= .T.
		*!*		COUNT ALL FOR cheqcar.vencimiento<DATE() TO thisform.venci
		*!*		COUNT ALL FOR cheqcar.vencimiento=DATE() TO thisform.hoy
		*!*		COUNT ALL FOR cheqcar.vencimiento=DATE()+1 TO thisform.man
		*!*		IF thisform.venci>0
		*!*			thisform.shp_vencido.Visible= .T.
		*!*			thisform.lbl_vencido.Visible= .T.
		*!*		ELSE
		*!*			thisform.shp_vencido.Visible= .F.
		*!*			thisform.lbl_vencido.Visible= .F.
		*!*		ENDIF
		*!*		IF thisform.hoy>0
		*!*			thisform.shp_hoy.Visible= .T.
		*!*			thisform.lbl_hoy.Visible= .T.
		*!*		ELSE
		*!*			thisform.shp_hoy.Visible= .F.
		*!*			thisform.lbl_hoy.Visible= .F.
		*!*		ENDIF
		*!*		IF thisform.man>0
		*!*			thisform.shp_manana.Visible= .T.
		*!*			thisform.lbl_manana.Visible= .T.
		*!*		ELSE
		*!*			thisform.shp_manana.Visible= .F.
		*!*			thisform.lbl_manana.Visible= .F.
		*!*		ENDIF
		*!*		GO top
		*!*		
		*!*		SCAN
		*!*			totmes=0
		*!*			concheq=0
		*!*			cadena=ALLTRIM(STR(MONTH(cheqcar.movtippag_fvto)))+ALLTRIM(STR(YEAR(cheqcar.movtippag_fvto)))
		*!*			DO WHILE ALLTRIM(STR(MONTH(cheqcar.movtippag_fvto)))+ALLTRIM(STR(YEAR(cheqcar.movtippag_fvto)))=cadena
		*!*				INSERT INTO cartera(tipo,chequenro,fecha,fecven,cuitlib,procedencia,banco,plaza,importe,recpag_codi,chid) ;
		*!*							VALUES (IIF(cheqcar.tippag_codi=3,'CHEQUE','ECHEQ'),cheqcar.chequenro,cheqcar.movtippag_fvto,cheqcar.vencimiento, ;
		*!*									cheqcar.cli_cuit,cheqcar.cli_nomb,cheqcar.ban_desc, ;
		*!*									cheqcar.movtippag_pza,cheqcar.movtippag_imp,cheqcar.recpag_codi,cheqcar.cheqid)
		*!*				totmes=totmes+cheqcar.movtippag_imp
		*!*				concheq=concheq+1
		*!*				SKIP
		*!*			ENDDO
		*!*			SKIP-1
		*!*			contot=contot+concheq
		*!*			totales=totales+totmes
		*!*			cadplaza=ALLTRIM('TOT. '+UPPER(Mes_Nombre(MONTH(cheqcar.movtippag_fvto)))+' '+ALLTRIM(STR(YEAR(cheqcar.movtippag_fvto)))+'('+ALLTRIM(STR(concheq))+')')
		*!*			INSERT INTO cartera(plaza,importe,recpag_codi) ;
		*!*						VALUES (cadplaza,totmes,0)
		*!*		ENDSCAN
		*!*		GO TOP IN cartera
		*!*		thisform.grd_cheques.RecordSource="cartera"
		
		*!*		thisform.grd_cheques.SetAll("DynamicForeColor","thisform.obtenercolor(cartera.fecven,cartera.recpag_codi)","Column")
		*!*		thisform.grd_cheques.SetAll("DynamicBackColor","thisform.colorfondo(cartera.fecven,cartera.recpag_codi)","Column")
		*!*		thisform.grd_cheques.SetAll("DynamicFontBold", "IIF(cartera.fecven=DATE(), .T. ,IIF(cartera.fecven=DATE()+1,.T.,IIF(cartera.fecven<DATE(),.T.,.F.)))", "Column")
		*!*		thisform.grd_cheques.SetAll("DynamicFontName","IIF(cartera.recpag_codi=0,'Arial Black','Tahoma')","Column")
		*!*		thisform.txt_total.Value=totales
		*!*		thisform.lbl_impotot.Caption='IMPORTE TOTAL:'  
		*!*		thisform.lbl_totcheq.Caption='HAY EN TOTAL '+ALLTRIM(STR(contot))+' CHEQUES EN CARTERA'
		*!*		thisform.cantcheq= contot
		*!*		IF thisform.txt_find.Visible= .T.
		*!*			thisform.txt_find.Visible= .F.
		*!*			thisform.txt_find.Value=''
		*!*		ENDIF
		*!*	ENDIF
	ENDPROC

	PROCEDURE opt_estado.Option2.Click
		*!*	LOCAL totmes,totales,concheq,contot
		*!*	STORE 0 TO totmes,totales,cadena,concheq,contot
		*!*	STORE 0 TO thisform.venci,thisform.hoy,thisform.man
		*!*	SELECT cartera
		*!*	SET SAFETY OFF
		*!*	ZAP
		*!*	SET SAFETY ON
		*!*	thisform.grd_cheques.RecordSource=''

	PROCEDURE cmb_cliente.Click
		this.setfocus
	ENDPROC

	PROCEDURE cmb_cliente.Destroy
		set notify on
	ENDPROC

	PROCEDURE cmb_cliente.GotFocus
		set notify off
		
		
	ENDPROC

	PROCEDURE cmb_cliente.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					frmplanp= conectar_db(_screen.cn)
						xdesc=allt(this.list(i))
						SQLEXEC(frmplanp,"select * from clientes where TRIM(cli_nomb)=?xdesc;","cur_cli")
					desconectar_db(frmplanp)
					thisform.xcodicli=cur_cli.cli_codi
					thisform.chk_cliente.Value=0
					keyboard '{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE cmb_cliente.LostFocus
		IF LEN(ALLTRIM(this.Value)) = 0
			thisform.chk_cliente.Value = 1
			thisform.xcodicli = 99999999
		ENDIF
		
	ENDPROC

	PROCEDURE cmb_cliente.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade="%"+subst(allt(this.text),2,len(allt(this.text)))+"%"
				frmplanp= conectar_db(_screen.cn)
					SQLEXEC(frmplanp,"select * from clientes where cli_nomb like ?cade order by cli_nomb;","cur_cli")
				desconectar_db(frmplanp)
				IF RECCOUNT("cur_cli")>0
					this.rowsource="select cli_nomb from cur_cli INTO CURSOR cmb_cliente"
					this.value=this.list(1)
					keyboard "{F4}"
				ELSE
					MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
					this.Value=""			
				ENDIF
				RETURN .F.
			else
				if len(allt(this.text))>0
					cade=ALLTRIM(this.text)+"%"
					frmplanp= conectar_db(_screen.cn)
						SQLEXEC(frmplanp,"select * from clientes where cli_nomb like ?cade;","cur_cli")
					desconectar_db(frmplanp)
					IF RECCOUNT("cur_cli")>0
						this.rowsource="select cli_nomb from cur_cli INTO CURSOR cmb_cliente"
						this.value=this.list(1)
						keyboard "{F4}"
					ELSE
						MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
						this.Value=""				
					ENDIF
					RETURN .F.
				ENDIF
			endif
		endif
	ENDPROC

	PROCEDURE cnt_boton1.btn.Click
		LOCAL totmes,totales,concheq,contot
		STORE 0 TO totmes,totales,cadena,concheq,contot
		STORE 0 TO thisform.venci,thisform.hoy,thisform.man
		SELECT cartera
		SET SAFETY OFF
		ZAP
		SET SAFETY ON
		thisform.grd_cheques.RecordSource=''
		thisform.grd_cheques.Refresh()
		thisform.btn_print.Enabled= .F.
		frmconche= conectar_db(_screen.cn)
			DO case
				CASE thisform.opt_estado.Value=1
					SQLEXEC(frmconche,"call usp_cheqcar(0);","cheqcar")
				CASE thisform.opt_estado.Value=2
					SQLEXEC(frmconche,"call usp_cheqcar(1);","cheqcar")
				CASE thisform.opt_estado.Value=3
					SQLEXEC(frmconche,"call usp_cheqcar(2);","cheqcar")
			ENDCASE
		desconectar_db(frmconche)
		IF RECCOUNT("cheqcar")>0
			thisform.btn_print.Enabled= .T.
			COUNT ALL FOR cheqcar.vencimiento<DATE() TO thisform.venci
			COUNT ALL FOR cheqcar.vencimiento=DATE() TO thisform.hoy
			COUNT ALL FOR cheqcar.vencimiento=DATE()+1 TO thisform.man
			IF thisform.venci>0
				thisform.shp_vencido.Visible= .T.
				thisform.lbl_vencido.Visible= .T.
			ELSE
				thisform.shp_vencido.Visible= .F.
				thisform.lbl_vencido.Visible= .F.
			ENDIF
			IF thisform.hoy>0
				thisform.shp_hoy.Visible= .T.
				thisform.lbl_hoy.Visible= .T.
			ELSE
				thisform.shp_hoy.Visible= .F.
				thisform.lbl_hoy.Visible= .F.
			ENDIF
			IF thisform.man>0
				thisform.shp_manana.Visible= .T.
				thisform.lbl_manana.Visible= .T.
			ELSE
				thisform.shp_manana.Visible= .F.
				thisform.lbl_manana.Visible= .F.
			ENDIF
			DO case
				CASE thisform.xcodicli<>99999999
					SELECT * FROM cheqcar WHERE cli_codi = thisform.xcodicli INTO CURSOR cheqcar
				CASE thisform.txt_impdes.Value<>0 OR thisform.txt_imphas.Value<>thisform.ximphas
					SELECT * FROM cheqcar WHERE movtippag_imp between thisform.txt_impdes.Value AND thisform.txt_imphas.Value INTO CURSOR cheqcar			
			ENDCASE
			IF RECCOUNT("cheqcar")>0
				SELECT MAX(movtippag_imp) FROM cheqcar INTO ARRAY ar_maxval
				IF TYPE("ar_maxval")="N"
					thisform.txt_imphas.Value=IIF(ISNULL(ar_maxval[1,1]),thisform.txt_imphas.Value,ar_maxval[1,1])
				ELSE
					thisform.txt_imphas.Value=0
				ENDIF
				thisform.ximphas=thisform.txt_imphas.Value
		
				SELECT MIN(movtippag_fvto) FROM cheqcar INTO ARRAY ar_minfec
				SELECT MAX(movtippag_fvto) FROM cheqcar INTO ARRAY ar_maxfec
				SELECT MIN(vencimiento) FROM cheqcar INTO ARRAY ar_minven
				SELECT MAX(vencimiento) FROM cheqcar INTO ARRAY ar_maxven
				thisform.txt_fecdes.Value=ar_minfec[1,1]
				thisform.xfecdes=ar_minfec[1,1]
				thisform.txt_fechas.Value=ar_maxfec[1,1]
				thisform.xfechas=ar_maxfec[1,1]
				thisform.txt_vendes.Value=ar_minven[1,1]
				thisform.xvendes=ar_minven[1,1]
				thisform.txt_venhas.Value=ar_maxven[1,1]
				thisform.xvenhas=ar_maxven[1,1]
			ENDIF
			
			GO top
			
			SCAN
				totmes=0
				concheq=0
				cadena=ALLTRIM(STR(MONTH(cheqcar.movtippag_fvto)))+ALLTRIM(STR(YEAR(cheqcar.movtippag_fvto)))
				DO WHILE ALLTRIM(STR(MONTH(cheqcar.movtippag_fvto)))+ALLTRIM(STR(YEAR(cheqcar.movtippag_fvto)))=cadena
					INSERT INTO cartera(tipo,chequenro,fecha,fecven,cuitlib,procedencia,banco,plaza,importe,recpag_codi,chid) ;
								VALUES (IIF(cheqcar.tippag_codi=3,'CHEQUE','ECHEQ'),cheqcar.chequenro,cheqcar.movtippag_fvto,cheqcar.vencimiento, ;
										cheqcar.cli_cuit,cheqcar.cli_nomb,cheqcar.ban_desc, ;
										cheqcar.movtippag_pza,cheqcar.movtippag_imp,cheqcar.recpag_codi,cheqcar.cheqid)
					totmes=totmes+cheqcar.movtippag_imp
					concheq=concheq+1
					SKIP
				ENDDO
				SKIP-1
				contot=contot+concheq
				totales=totales+totmes
				cadplaza=ALLTRIM('TOT. '+UPPER(Mes_Nombre(MONTH(cheqcar.movtippag_fvto)))+' '+ALLTRIM(STR(YEAR(cheqcar.movtippag_fvto)))+'('+ALLTRIM(STR(concheq))+')')
				INSERT INTO cartera(plaza,importe,recpag_codi) ;
							VALUES (cadplaza,totmes,0)
			ENDSCAN
			GO TOP IN cartera
			thisform.grd_cheques.RecordSource="cartera"
		
			thisform.grd_cheques.SetAll("DynamicForeColor","thisform.obtenercolor(cartera.fecven,cartera.recpag_codi)","Column")
			thisform.grd_cheques.SetAll("DynamicBackColor","thisform.colorfondo(cartera.fecven,cartera.recpag_codi)","Column")
			thisform.grd_cheques.SetAll("DynamicFontBold", "IIF(cartera.fecven=DATE(), .T. ,IIF(cartera.fecven=DATE()+1,.T.,IIF(cartera.fecven<DATE(),.T.,.F.)))", "Column")
			thisform.grd_cheques.SetAll("DynamicFontName","IIF(cartera.recpag_codi=0,'Arial Black','Tahoma')","Column")
			thisform.txt_total.Value=totales
			DO CASE
				CASE thisform.opt_estado.Value=1
					thisform.lbl_impotot.Caption='IMPORTE TOTAL:'
					thisform.lbl_totcheq.Caption='HAY EN TOTAL '+ALLTRIM(STR(contot))+' CHEQUES EN CARTERA'
				CASE thisform.opt_estado.Value=2
					thisform.lbl_impotot.Caption='IMPORTE TOTAL DE CHEQUES FISICOS:'
					thisform.lbl_totcheq.Caption='HAY EN TOTAL '+ALLTRIM(STR(contot))+' CHEQUES FISICOS'		
				CASE thisform.opt_estado.Value=3
					thisform.lbl_impotot.Caption='IMPORTE TOTAL DE ECHEQS:'
					thisform.lbl_totcheq.Caption='HAY EN TOTAL '+ALLTRIM(STR(contot))+' ECHEQS'	
			ENDCASE
			thisform.cantcheq= contot
			IF thisform.txt_find.Visible= .T.
				thisform.txt_find.Visible= .F.
				thisform.txt_find.Value=''
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cnt_boton1.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE cnt_boton1.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE cnt_boton1.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE Command4.Click
		*!*	*!*	IF thisform.opt_estado.option1.Value=0
		*!*	*!*		MESSAGEBOX("Solo podrá convertir a Excel listado de cheques ACTIVOS",0+48,"Aviso del Sistema")
		*!*	*!*	ELSE
		IF USED("cartera")
			IF RECCOUNT("cartera") > 0
				SELECT cartera
				LOCATE
				local Fila,fpag,pagina,empresa,lnCantidadDatos,lnI,lnPorcentaje
		
				wait'Espere Un Momento Exportando Datos' window nowait
				_screen.mousepointer=11
				TmpSheet=GetObject('','Excel.Sheet')
				XLApp=TmpSheet.Application
				XLApp.workbooks.add()
				XLSheet=XLApp.ActiveSheet
				with XLSheet.PageSetup
					.Orientation = 1
					.LeftMargin = XLApp.InchesToPoints(0)
					.RightMargin = XLApp.InchesToPoints(0)
				    .TopMargin = XLApp.InchesToPoints(0)
				    .BottomMargin = XLApp.InchesToPoints(0)
				    .HeaderMargin = XLApp.InchesToPoints(0)
				    .FooterMargin = XLApp.InchesToPoints(0)
				    .Zoom=85
				ENDWITH
				XLSheet.Columns("A:A").ColumnWidth = 6.57
				XLSheet.Columns("B:B").ColumnWidth = 13.86
				XLSheet.Columns("B:B").NUMBERFORMAT="@"
				XLSheet.Columns("C:C").ColumnWidth = 10.00
				XLSheet.Columns("D:D").ColumnWidth = 10.00
				XLSheet.Columns("E:E").ColumnWidth = 12.86
				XLSheet.Columns("E:E").NUMBERFORMAT="##-########-#"
				XLSheet.Columns("F:F").ColumnWidth = 18.43
				XLSheet.Columns("G:G").ColumnWidth = 12.57
				XLSheet.Columns("H:H").ColumnWidth = 13.43
				XLSheet.Columns("I:I").ColumnWidth = 16.65
		
				thisform.excelencabezado()
		
				SELECT cartera
				LOCATE
				lnCantidadDatos=RECCOUNT("cartera")
				Fila=10
				thisform.progreso.Visible= .T.
				FOR lnI = 1 TO lnCantidadDatos
				   	xini = "A"+ALLTRIM(STR(Fila))
				   	xfin = "I"+ALLTRIM(STR(Fila))
				   	rango= '"'+xini+':'+xfin+'"'
				   	XLSheet.range(&rango).Font.Size = "10"
				   	WITH XLSheet.RANGE(&rango)
					    .Borders(1).LineStyle = 1
					    .Borders(1).Weight = 2
					    .Borders(2).LineStyle = 1
					    .Borders(2).Weight = 2
					    .Borders(3).LineStyle = 1
					    .Borders(3).Weight = 2
					    .Borders(4).LineStyle = 1
					    .Borders(4).Weight = 2
					ENDWITH
					XLSheet.Cells(Fila,1)=cartera.tipo
				   	XLSheet.Cells(Fila,1).HorizontalAlignment=-4131				
					XLSheet.Cells(Fila,2)=cartera.chequenro
				   	XLSheet.Cells(Fila,2).HorizontalAlignment=-4108
				   	IF LEN(ALLTRIM(cartera.chequenro))>0
			   			XLSheet.range(&rango).Interior.Color= thisform.colorfondo(cartera.fecven,cartera.recpag_codi)
						XLSheet.range(&rango).Font.Color    = thisform.obtenercolor(cartera.fecven,cartera.recpag_codi)
						XLSheet.range(&rango).Font.bold     = IIF(cartera.fecven<=DATE()+1,.T.,.F.)
						IF cartera.fecven<=DATE()+1
							DO CASE
								CASE cartera.fecven=DATE() AND cartera.recpag_codi>0
									XLSheet.Cells(7,9)="VENCE HOY"
									XLSheet.Cells(7,9).HorizontalAlignment=-4108
									XLSheet.Cells(7,9).Interior.Color= thisform.colorfondo(cartera.fecven,cartera.recpag_codi)
									XLSheet.Cells(7,9).Font.Color    = thisform.obtenercolor(cartera.fecven,cartera.recpag_codi)
									thisform.recuestado(9)
								CASE cartera.fecven=DATE()+1 AND cartera.recpag_codi>0
									XLSheet.Cells(7,8)="VENCE MAÑANA"
									XLSheet.Cells(7,8).HorizontalAlignment=-4108
									XLSheet.Cells(7,8).Interior.Color= thisform.colorfondo(cartera.fecven,cartera.recpag_codi)
									XLSheet.Cells(7,8).Font.Color    = thisform.obtenercolor(cartera.fecven,cartera.recpag_codi)
									thisform.recuestado(8)
								CASE cartera.fecven<DATE() AND cartera.recpag_codi>0
									XLSheet.Cells(7,7)="VENCIDO"
									XLSheet.Cells(7,7).HorizontalAlignment=-4108
									XLSheet.Cells(7,7).Interior.Color= thisform.colorfondo(cartera.fecven,cartera.recpag_codi)
									XLSheet.Cells(7,7).Font.Color    = thisform.obtenercolor(cartera.fecven,cartera.recpag_codi)
									thisform.recuestado(7)
							ENDCASE	
						ENDIF
						XLSheet.Range(XLSheet.Cells(7,7),XLSheet.Cells(7,9)).font.bold=.T.
						XLSheet.Cells(Fila,3)=cartera.fecha
						XLSheet.Cells(Fila,3).HorizontalAlignment=-4108
					   	XLSheet.Cells(Fila,4)=cartera.fecven
					   	XLSheet.Cells(Fila,4).HorizontalAlignment=-4108
					   	XLSheet.Cells(Fila,5)=cartera.cuitlib
					   	XLSheet.Cells(Fila,5).HorizontalAlignment=-4108
					   	XLSheet.Cells(Fila,6)=cartera.procedencia
					   	XLSheet.Cells(Fila,7)=cartera.banco
				   	ENDIF
				  	XLSheet.Cells(Fila,8)=cartera.plaza
					XLSheet.Cells(Fila,9)=cartera.importe
					IF LEN(ALLTRIM(cartera.chequenro))=0
						XLSheet.Cells(Fila,8).HorizontalAlignment=-4152
						XLSheet.Range(XLSheet.Cells(Fila,8),XLSheet.Cells(Fila,9)).font.bold=.T.
						XLSheet.Range(XLSheet.Cells(Fila,8),XLSheet.Cells(Fila,9)).font.size=11
						XLSheet.Range(XLSheet.Cells(Fila,1),XLSheet.Cells(Fila,9)).Borders(3).LineStyle = 1
						XLSheet.Range(XLSheet.Cells(Fila,1),XLSheet.Cells(Fila,9)).Borders(3).Weight = 3
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Interior.Color= RGB(198,224,180)
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Borders(1).LineStyle = 1
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Borders(1).Weight = 3
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Borders(2).LineStyle = 1
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Borders(2).Weight = 3
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Borders(4).LineStyle = 1
						XLSheet.Range(XLSheet.Cells(Fila,7),XLSheet.Cells(Fila,9)).Borders(4).Weight = 3
						XLSheet.Range(XLSheet.Cells(Fila,1),XLSheet.Cells(Fila,6)).Borders(1).LineStyle = 0
						XLSheet.Range(XLSheet.Cells(Fila,1),XLSheet.Cells(Fila,6)).Borders(2).LineStyle = 0
					ENDIF
					XLSheet.Cells(Fila,9).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
				   	Fila=Fila+1
					lnPorcentaje            = lnI * 100 / lnCantidadDatos
				    ThisForm.Progreso.Value = lnPorcentaje
				    skip		   	
				ENDFOR
				Fila=Fila-1
				XLSheet.Range(XLSheet.Cells(Fila,1),XLSheet.Cells(Fila,6)).Borders(4).LineStyle = 0
				Fila=Fila+1
				thisform.excelfooter(Fila)
				thisform.progreso.Visible= .F.
				XLApp.visible=.T.
				XLApp.WindowState = -4137
				DECLARE LONG BringWindowToTop IN "user32" LONG HWND
				BringWindowToTop(XLApp.HWND)
				_screen.mousepointer=0
			ENDIF
		ENDIF
		*!*	ENDIF
		
	ENDPROC


	PROCEDURE Activate
		IF RECCOUNT("cheqcar")=0
			MESSAGEBOX("No se encontraron registro de Cheques/Echeqs disponibles en cartera.",64,"Aviso del Sistema")
			thisform.estadoinicio=.F.
		ENDIF
		
	ENDPROC

	PROCEDURE colorestado
		LPARAMETERS tnEstado
		
		LOCAL lnColor
		
			IF tnEstado='N'
				tnColor=RGB(255,0,0)
			ELSE
				tnColor=RGB(0,0,0)
			ENDIF
		
		return(lnColor)	
	ENDPROC

	PROCEDURE colorfondo
		LPARAMETERS tnFecha,tnCodi
		
		LOCAL lnColor
		
			DO CASE
				CASE tnFecha=DATE() AND tnCodi>0
					lnColor=RGB(225,0,0)
				CASE tnFecha=DATE()+1 AND tnCodi>0
					lnColor=RGB(0,0,0)
				CASE tnFecha>DATE()+1 AND tnCodi>0
					lnColor=RGB(255,255,255)
				CASE tnFecha<DATE() AND tnCodi>0
					lnColor=RGB(128,255,128)
			ENDCASE
		
		return(lnColor)	
	ENDPROC

	PROCEDURE Destroy
		SET POINT TO
		SET SEPARATOR TO
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE excelencabezado
		Xlsheet.cells(1,9)=ALLTRIM(thisform.empresa)
		XLSheet.Cells(1,9).font.bold=.T.
		XLSheet.Cells(1,9).font.size="12"
		XLSheet.Cells(1,9).font.name="Courier New"
		XLSheet.Cells(1,9).HorizontalAlignment=-4152
		
		Xlsheet.cells(3,9)='Fecha Actual: '+ALLTRIM(DTOC(DATE()))
		XLSheet.Cells(3,9).font.bold=.T.
		XLSheet.Cells(3,9).font.size="11"
		XLSheet.Cells(3,9).font.name="Courier New"
		XLSheet.Cells(3,9).HorizontalAlignment=-4152
		
		XLSheet.range("D5:G5").merge
		Xlsheet.cells(5,4)="PLANILLA DE CHEQUES"
		XLSheet.Cells(5,4).font.bold=.T.
		XLSheet.Cells(5,4).font.underline=.T.
		XLSheet.Cells(5,4).font.size="13"
		XLSheet.Cells(5,4).font.name="Cooper Black"
		XLSheet.range("D5:G5").HorizontalAlignment=7
		
		XLSheet.Cells(9,1)="TIPO"
		XLSheet.Cells(9,1).font.bold=.T.
		XLSheet.Cells(9,1).font.size="11"
		XLSheet.Cells(9,1).font.name="Courier New"
		XLSheet.range("A9:A9").HorizontalAlignment=-4131
		XLSheet.Cells(9,2)="NÚMERO"
		XLSheet.Cells(9,2).font.bold=.T.
		XLSheet.Cells(9,2).font.size="11"
		XLSheet.Cells(9,2).font.name="Courier New"
		XLSheet.range("B9:B9").HorizontalAlignment=-4108
		XLSheet.Cells(9,3)="FECHA"
		XLSheet.Cells(9,3).font.bold=.T.
		XLSheet.Cells(9,3).font.size="11"
		XLSheet.Cells(9,3).font.name="Courier New"
		XLSheet.range("C9:C9").HorizontalAlignment=-4108
		XLSheet.Cells(9,4)="VENCIM."
		XLSheet.Cells(9,4).font.bold=.T.
		XLSheet.Cells(9,4).font.size="11"
		XLSheet.Cells(9,4).font.name="Courier New"
		XLSheet.range("D9:D9").HorizontalAlignment=-4108
		XLSheet.Cells(9,5)="CUIT LIB."
		XLSheet.Cells(9,5).font.bold=.T.
		XLSheet.Cells(9,5).font.size="11"
		XLSheet.Cells(9,5).font.name="Courier New"
		XLSheet.range("E9:E9").HorizontalAlignment=-4108
		XLSheet.Cells(9,6)="PROCEDENCIA"
		XLSheet.Cells(9,6).font.bold=.T.
		XLSheet.Cells(9,6).font.size="11"
		XLSheet.Cells(9,6).font.name="Courier New"
		XLSheet.range("F9:F9").HorizontalAlignment=-4108
		XLSheet.Cells(9,7)="BANCO"
		XLSheet.Cells(9,7).font.bold=.T.
		XLSheet.Cells(9,7).font.size="11"
		XLSheet.Cells(9,7).font.name="Courier New"
		XLSheet.range("G9:G9").HorizontalAlignment=-4108
		XLSheet.Cells(9,8)="PLAZA"
		XLSheet.Cells(9,8).font.bold=.T.
		XLSheet.Cells(9,8).font.size="11"
		XLSheet.Cells(9,8).font.name="Courier New"
		XLSheet.range("H9:H9").HorizontalAlignment=-4108
		XLSheet.Cells(9,9)="IMPORTE"
		XLSheet.Cells(9,9).font.bold=.T.
		XLSheet.Cells(9,9).font.size="11"
		XLSheet.Cells(9,9).font.name="Courier New"
		XLSheet.range("I9:I9").HorizontalAlignment=-4108
		XLSheet.Range(XLSheet.Cells(9,1),XLSheet.Cells(9,9)).Borders.LineStyle=1
		XLSheet.Range(XLSheet.Cells(9,1),XLSheet.Cells(9,9)).Borders.Weight=3
		XLSheet.Range(XLSheet.Cells(9,1),XLSheet.Cells(9,9)).Interior.Color= RGB(192,192,192)
		
		return
	ENDPROC

	PROCEDURE excelfooter
		LPARAMETERS xInifil
		
		LOCAL fotfil, xtexto
		
		fotfil = xInifil
		
		XLSheet.Rows(fotfil).RowHeight = 10
		
		*!*	thisform.excelcuadrofooter(fotfil)
		fotfil = fotfil + 1
		*!*	thisform.excelcuadrofooter(fotfil)
		
		xtexto = IIF(thisform.opt_estado.Value=3,'ECHEQS','CHEQUES EN CARTERA')
		Xlsheet.cells(fotfil,8)='IMPORTE TOTAL DE '+ALLTRIM(xtexto)
		Xlsheet.cells(fotfil,8).HorizontalAlignment=-4152
		XLSheet.Cells(fotfil,9).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		XLSheet.Cells(fotfil,9)=thisform.txt_total.value
		fotfil = fotfil + 1
		*!*	thisform.excelcuadrofooter(fotfil)
		Xlsheet.cells(fotfil,8)='CANTIDAD TOTAL DE '+ALLTRIM(xtexto)
		Xlsheet.cells(fotfil,8).HorizontalAlignment=-4152
		XLSheet.Cells(fotfil,9)=thisform.cantcheq
		
		WITH Xlsheet.range(XLSheet.Cells(fotfil-1,8),XLSheet.Cells(fotfil,9))
			.font.bold=.T.
			.font.size=12
		ENDWITH
		
		Xlsheet.range(XLSheet.Cells(fotfil-1,5),XLSheet.Cells(fotfil-1,9)).font.color=RGB(0,0,255)
		Xlsheet.range(XLSheet.Cells(fotfil,5),XLSheet.Cells(fotfil,9)).font.color=RGB(255,0,0)
		
		RETURN
		
		
		
		
		
	ENDPROC

	PROCEDURE GotFocus
		SET POINT TO ","
		SET SEPARATOR TO "."
	ENDPROC

	PROCEDURE grid_rightclick
		IF USED("cartera")
			IF cartera.recpag_codi>0
				LOCAL lcShortcut, loRef, xcons, xmodi, xnroval, xtipval
				m.loRef = this
				m.lcShortcut = SYS(2015)
				
				xnroval = ALLTRIM(cartera.chequenro)
				xtipval = ICASE(ALLTRIM(cartera.tipo)="CHEQUE",1,ALLTRIM(cartera.tipo)="ECHEQ",2)
				
				xcons="[Consultar "+ALLTRIM(cartera.tipo)+"]"
				xmodi="[Modificar "+ALLTRIM(cartera.tipo)+"]"
		
				DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
				DEFINE BAR 1 OF (m.lcShortcut) PROMPT &xcons PICTURE "C:\VFP9_MYSQL\imagen\cheque_01.png"
				DEFINE BAR 2 OF (m.lcShortcut) PROMPT &xmodi PICTURE "C:\VFP9_MYSQL\imagen\iconos\recode_691.ico"
				
				ON SELECTION BAR 1 OF (m.lcShortcut) m.loRef.muestracheq()
				ON SELECTION BAR 2 OF (m.lcShortcut) do form modicheqnum with xnroval, xtipval
		
				ACTIVATE POPUP (m.lcShortcut)
				RELEASE POPUP (m.lcShortcut)
				thisform.cnt_boton1.btn.Click()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		SET POINT TO ","
		SET SEPARATOR TO "."
		LOCAL totmes,totales,concheq,contot
		STORE 0 TO totmes,totales,cadena,concheq,contot
		CREATE CURSOR cartera(tipo C(6),chequenro C(14),fecha D,fecven D,cuitlib C(11),procedencia C(50),;
							  banco C(45),plaza C(25),importe N(15,2),recpag_codi N(8),activo C(1),chid C(4))
		
		frmconche= conectar_db(_screen.cn)
			SQLEXEC(frmconche,"select param_desc from parametros where param_codi = 13;","cur_emp")
		desconectar_db(frmconche)
		
		IF RECCOUNT("cur_emp") > 0
			thisform.empresa=ALLTRIM(cur_emp.param_desc)
			cerrar_cursor("cur_emp")
		ENDIF
		
		frmconche= conectar_db(_screen.cn)
			SQLEXEC(frmconche,"call usp_cheqcar(0);","cheqcar")
		desconectar_db(frmconche)
		thisform.txt_impdes.Value=0
		thisform.ximpdes=0
		IF RECCOUNT("cheqcar")>0
			thisform.btn_print.Enabled= .T.
			COUNT ALL FOR cheqcar.vencimiento<DATE() TO thisform.venci
			COUNT ALL FOR cheqcar.vencimiento=DATE() TO thisform.hoy
			COUNT ALL FOR cheqcar.vencimiento=DATE()+1 TO thisform.man
			IF thisform.venci>0
				thisform.shp_vencido.Visible= .T.
				thisform.lbl_vencido.Visible= .T.
			ENDIF
			IF thisform.hoy>0
				thisform.shp_hoy.Visible= .T.
				thisform.lbl_hoy.Visible= .T.
			ENDIF
			IF thisform.man>0
				thisform.shp_manana.Visible= .T.
				thisform.lbl_manana.Visible= .T.
			ENDIF
			SELECT MAX(movtippag_imp) FROM cheqcar INTO ARRAY ar_maxval
			IF TYPE("ar_maxval")="N"
				thisform.txt_imphas.Value=ar_maxval[1,1]
			ELSE
				thisform.txt_imphas.Value=0
			ENDIF
			thisform.ximphas=thisform.txt_imphas.Value
		
			SELECT MIN(movtippag_fvto) FROM cheqcar INTO ARRAY ar_minfec
			SELECT MAX(movtippag_fvto) FROM cheqcar INTO ARRAY ar_maxfec
			SELECT MIN(vencimiento) FROM cheqcar INTO ARRAY ar_minven
			SELECT MAX(vencimiento) FROM cheqcar INTO ARRAY ar_maxven
			thisform.txt_fecdes.Value=ar_minfec[1,1]
			thisform.xfecdes=ar_minfec[1,1]
			thisform.txt_fechas.Value=ar_maxfec[1,1]
			thisform.xfechas=ar_maxfec[1,1]
			thisform.txt_vendes.Value=ar_minven[1,1]
			thisform.xvendes=ar_minven[1,1]
			thisform.txt_venhas.Value=ar_maxven[1,1]
			thisform.xvenhas=ar_maxven[1,1]
			thisform.chk_cliente.Value=1
			thisform.chk_fecha.Value=1
			thisform.chk_impo.Value=1
			thisform.chk_ven.Value=1
			
			GO top
			
			SCAN
				totmes=0
				concheq=0
				cadena=ALLTRIM(STR(MONTH(cheqcar.movtippag_fvto)))+ALLTRIM(STR(YEAR(cheqcar.movtippag_fvto)))
				DO WHILE ALLTRIM(STR(MONTH(cheqcar.movtippag_fvto)))+ALLTRIM(STR(YEAR(cheqcar.movtippag_fvto)))=cadena
					INSERT INTO cartera(tipo,chequenro,fecha,fecven,cuitlib,procedencia,banco,plaza,importe,recpag_codi,activo,chid) ;
								VALUES (IIF(cheqcar.tippag_codi=3,'CHEQUE','ECHEQ'),cheqcar.chequenro,cheqcar.movtippag_fvto,cheqcar.vencimiento, ;
										cheqcar.cli_cuit,cheqcar.cli_nomb,cheqcar.ban_desc, ;
										cheqcar.movtippag_pza,cheqcar.movtippag_imp,cheqcar.recpag_codi,cheqcar.activo,cheqcar.cheqid)
					totmes=totmes+cheqcar.movtippag_imp
					concheq=concheq+1
					SKIP
				ENDDO
				SKIP-1
				contot=contot+concheq
				totales=totales+totmes
				cadplaza=ALLTRIM('TOT. '+UPPER(Mes_Nombre(MONTH(cheqcar.movtippag_fvto)))+' '+ALLTRIM(STR(YEAR(cheqcar.movtippag_fvto)))+'('+ALLTRIM(STR(concheq))+')')
				INSERT INTO cartera(plaza,importe,recpag_codi) ;
							VALUES (cadplaza,totmes,0)
			ENDSCAN
			GO TOP IN cartera
			thisform.grd_cheques.RecordSource="cartera"
			thisform.btn_print.Enabled= .T.
			
			thisform.grd_cheques.SetAll("DynamicForeColor","thisform.obtenercolor(cartera.fecven,cartera.recpag_codi)","Column")
			thisform.grd_cheques.SetAll("DynamicBackColor","thisform.colorfondo(cartera.fecven,cartera.recpag_codi)","Column")
			thisform.grd_cheques.SetAll("DynamicFontBold", "IIF(cartera.fecven=DATE(), .T. ,IIF(cartera.fecven=DATE()+1,.T.,IIF(cartera.fecven<DATE(),.T.,.F.)))", "Column")
			thisform.grd_cheques.SetAll("DynamicFontName","IIF(cartera.recpag_codi=0,'Arial Black','Tahoma')","Column")
			thisform.txt_total.Value=totales
			thisform.lbl_totcheq.Caption='HAY EN TOTAL '+ALLTRIM(STR(contot))+' CHEQUES EN CARTERA'
			thisform.cantcheq= contot
		
			FOR ncol=1 TO 9
				xsource="thisform.grd_cheques.column"+ALLTRIM(STR(ncol))+".text1"
				BINDEVENT(&xsource,"DblClick",Thisform,"muestracheq")
				BINDEVENT(&xsource,"RightClick",Thisform,"grid_rightclick")
			NEXT ncol
		ELSE
			thisform.txt_fechas.Value=0
			thisform.estadoinicio=.T.
		ENDIF
		
	ENDPROC

	PROCEDURE LostFocus
		SET POINT TO
		SET SEPARATOR TO
	ENDPROC

	PROCEDURE muestracheq
		IF cartera.recpag_codi>0
			LOCAL xtipo
			xtipo= ICASE(cartera.tipo="CHEQUE",1,cartera.tipo="ECHEQ",2)
			do form conscheqrap with cartera.recpag_codi,xtipo
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnFecha,tnCodi
		
		LOCAL lnColor
		
			DO CASE
				CASE tnFecha=DATE() AND tnCodi>0
					lnColor=RGB(255,255,0)
				CASE tnFecha=DATE()+1 AND tnCodi>0
					lnColor=RGB(0,255,0)
				CASE tnFecha>DATE()+1 AND tnCodi>0
					lnColor=RGB(0,0,0)
				CASE tnFecha<DATE() AND tnCodi>0
					lnColor=RGB(128,0,0)
			ENDCASE
		
		return(lnColor)	
	ENDPROC

	PROCEDURE recuestado
		LPARAMETERS nCol
		
		XLSheet.Cells(7,nCol).Borders(1).LineStyle=1
		XLSheet.Cells(7,nCol).Borders(1).Weight=3
		XLSheet.Cells(7,nCol).Borders(2).LineStyle=1
		XLSheet.Cells(7,nCol).Borders(2).Weight=3
		XLSheet.Cells(7,nCol).Borders(3).LineStyle=1
		XLSheet.Cells(7,nCol).Borders(3).Weight=3
		XLSheet.Cells(7,nCol).Borders(4).LineStyle=1
		XLSheet.Cells(7,nCol).Borders(4).Weight=3
		
		RETURN
	ENDPROC

	PROCEDURE btn_buscar1.img_buscar.Click
		thisform.txt_find.Value=''
		thisform.xtipo=0
		IF thisform.txt_find.Visible= .F.
			
			IF thisform.opt_estado.Value=1
				lnOption = MsgboxEx(;
				   "Debe seleccionar el tipo: Cheque / Echeq." + ;
				   chr(13) + chr(13) + "Que desea consultar?", ;
				   "?", ;
				   "Consulta Numérica", ;
				   "&Cheque,&Echeq,Ca&ncelar")
				 DO case
					 CASE lnOption = 1
					 	thisform.xtipo=1
					 	thisform.txt_find.Format="R"
					 	thisform.txt_find.InputMask="999-999-99999999"
			 		    thisform.txt_find.Visible= .T.
					 	thisform.txt_find.SetFocus
					 CASE lnOption = 2
					 	thisform.xtipo=2
					 	thisform.txt_find.Format=""
					 	thisform.txt_find.InputMask=""
			 		    thisform.txt_find.Visible= .T.
					 	thisform.txt_find.SetFocus
				 ENDCASE
			ELSE
				DO case
					CASE thisform.opt_estado.Value = 2
					 	thisform.xtipo=1
					 	thisform.txt_find.Format="R"
					 	thisform.txt_find.InputMask="999-999-99999999"
			 		    thisform.txt_find.Visible= .T.
					 	thisform.txt_find.SetFocus			
					CASE thisform.opt_estado.value = 3
					 	thisform.xtipo=2
					 	thisform.txt_find.Format=""
					 	thisform.txt_find.InputMask=""
			 		    thisform.txt_find.Visible= .T.
					 	thisform.txt_find.SetFocus			
				ENDCASE
			ENDIF
			
		else	
			thisform.txt_find.Visible= .F.
			thisform.grd_cheques.SetFocus
		ENDIF
		
	ENDPROC


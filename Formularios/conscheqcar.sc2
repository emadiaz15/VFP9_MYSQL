		this.Height=142
		this.left=0
		this.Width=this.Parent.Width
		
	ENDPROC

	PROCEDURE grd_cheques.Column1.Header1.Click
		IF USED("cartera")
			thisform.grd_cheques.RecordSource=''
			IF thisform.hdnro_estado = 0
				SELECT * FROM cartera ORDER BY chequenro INTO CURSOR cartera
				thisform.hdnro_estado = 1
			ELSE
				DO case
					CASE thisform.hdnro_estado = 1
						SELECT * FROM cartera ORDER BY chequenro DESC INTO CURSOR cartera
						thisform.hdnro_estado = 2
					CASE thisform.hdnro_estado = 2
						SELECT * FROM cartera ORDER BY chequenro INTO CURSOR cartera
						thisform.hdnro_estado = 1
				ENDCASE
			ENDIF
			thisform.grd_cheques.RecordSource="cartera"
			thisform.grd_cheques.Refresh()
		ENDIF
		
	ENDPROC


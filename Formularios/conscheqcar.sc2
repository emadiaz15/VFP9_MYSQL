		*!*		COUNT ALL FOR cheqcar.vencimiento<DATE() TO thisform.venci
		*!*		COUNT ALL FOR cheqcar.vencimiento=DATE() TO thisform.hoy
		*!*		COUNT ALL FOR cheqcar.vencimiento=DATE()+1 TO thisform.man

	PROCEDURE chk_cliente.Click
		IF this.Value=1
			thisform.xcodicli = 99999999
			thisform.cmb_cliente.value=''
			thisform.cmb_cliente.RowSource=''
		*!*		thisform.btn_actualizar.SetFocus
		ELSE
			thisform.xcodicli = 99999999
			thisform.cmb_cliente.SetFocus
		endif
	ENDPROC

	PROCEDURE chk_fecha.Click
		IF this.Value=1
			thisform.txt_fecdes.value=thisform.xprimefec
			thisform.txt_fechas.value=DATE()
		*!*		thisform.btn_actualizar.setfocus
		ELSE
			thisform.txt_fecdes.value=ctod("01/01/"+allt(str(year(date()))))
			thisform.txt_fechas.value=DATE()
		*!*		thisform.btn_actualizar.SetFocus
		endif
	ENDPROC

	PROCEDURE chk_impo.Click
		DO case
			CASE this.Value=1
				frmconche= conectar_db(_screen.cn)
					DO case
						CASE thisform.opt_estado.Value=1
							SQLEXEC(frmconche,"call usp_cheqcar(0);","maxmin")
						CASE thisform.opt_estado.Value=2
							SQLEXEC(frmconche,"call usp_cheqcar(1);","maxmin")
						CASE thisform.opt_estado.Value=3
							SQLEXEC(frmconche,"call usp_cheqcar(2);","maxmin")
					ENDCASE
				desconectar_db(frmconche)
		*!*			DO case
		*!*				CASE thisform.xcodicli<>99999999
		*!*					SELECT * FROM maxmin WHERE cli_codi = thisform.xcodicli INTO CURSOR maxmin
		*!*				CASE thisform.txt_impdes.Value<>thisform.ximpdes OR thisform.txt_imphas.Value<>thisform.ximphas
		*!*	*!*					WAIT WINDOW "txt_impdes: "+ALLTRIM(STR(thisform.txt_impdes.Value,15,2))
		*!*	*!*					WAIT WINDOW "ximpdes: "+ALLTRIM(STR(thisform.ximpdes,15,2))
		*!*	*!*					WAIT WINDOW "txt_imphas: "+ALLTRIM(STR(thisform.txt_imphas.Value,15,2))
		*!*	*!*					WAIT WINDOW "ximphas: "+ALLTRIM(STR(thisform.ximphas,15,2))
		*!*					SELECT * FROM maxmin WHERE movtippag_imp between thisform.txt_impdes.Value AND thisform.txt_imphas.Value INTO CURSOR maxmin			
		*!*			ENDCASE
				IF thisform.xcodicli<>99999999
					SELECT * FROM maxmin WHERE cli_codi = thisform.xcodicli INTO CURSOR maxmin
				ENDIF
		
				SELECT MAX(movtippag_imp) FROM maxmin INTO ARRAY ar_maxval
				IF TYPE("ar_maxval")="N"
					thisform.txt_imphas.Value=ar_maxval[1,1]
				ELSE
					thisform.txt_imphas.Value=0
				ENDIF
				thisform.ximphas=thisform.txt_imphas.Value
				thisform.txt_impdes.Value=0
				thisform.ximpdes=0
				thisform.txt_imphas.Value=thisform.ximphas
				SELECT MIN(movtippag_fvto) FROM maxmin INTO ARRAY ar_minfec
				SELECT MAX(movtippag_fvto) FROM maxmin INTO ARRAY ar_maxfec
				SELECT MIN(vencimiento) FROM maxmin INTO ARRAY ar_minven
				SELECT MAX(vencimiento) FROM maxmin INTO ARRAY ar_maxven
				thisform.txt_fecdes.Value=ar_minfec[1,1]
				thisform.xfecdes=ar_minfec[1,1]
				thisform.txt_fechas.Value=ar_maxfec[1,1]
				thisform.xfechas=ar_maxfec[1,1]
				thisform.txt_vendes.Value=ar_minven[1,1]
				thisform.xvendes=ar_minven[1,1]
				thisform.txt_venhas.Value=ar_maxven[1,1]
				thisform.xvenhas=ar_maxven[1,1]		
				cerrar_cursor("maxmin")		
			CASE this.Value=0
				thisform.txt_impdes.SetFocus
		ENDCASE
		
	ENDPROC


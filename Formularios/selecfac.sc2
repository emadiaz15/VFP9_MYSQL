	ADD OBJECT 'Text2' AS textbox WITH ;
		Alignment = 1, ;
		Height = 23, ;
		Left = 277, ;
		Name = "Text2", ;
		Style = 1, ;
		Top = 260, ;
		Width = 100
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		parameter codicli,impotot,totval
		local sf,acufac,fcpos
		acufac=0
		sf=1
		conlist=1
		with thisform
			.text2.value=0
			.text1.value=impotot-totval
			FOR sf=1 TO alen(matfac,1)
				fcpos=ascan(auxmatcom,matfac[sf,1])
				if fcpos=0
					facadpro= conectar_db(_screen.cn)
						SQLEXEC(facadpro,"select * from facturas where fac_codi=?matfac[sf,1];","cur_fpro")
					desconectar_db(facadpro)
					IF RECCOUNT("cur_fpro")>0
						.list1.list(conlist,1)=dtoc(cur_fpro.fac_fec)
						do case
							case cur_fpro.fac_conc="F"
								.list1.list(conlist,2)=iif(cur_fpro.fac_tipo="A","FA","FB")
							case cur_fpro.fac_conc="N"
								.list1.list(conlist,2)=iif(cur_fpro.fac_tipo="A","NCA","NCB")
							case cur_fpro.fac_conc="D"
								.list1.list(conlist,2)=iif(cur_fpro.fac_tipo="A","NDA","NDB")
						endcase
						.list1.list(conlist,3)=alltrim(str(cur_fpro.fac_pto))
						.list1.list(conlist,4)=str(cur_fpro.fac_nro)
						.list1.list(conlist,5)=str(iif(cur_fpro.fac_conc="N",-matfac[sf,2],matfac[sf,2]),10,2)
						acufac=acufac+iif(cur_fpro.fac_conc="N",-matfac[sf,2],matfac[sf,2])
						.list1.list(conlist,6)=str(acufac,10,2)
						.list1.list(conlist,7)=str(cur_fpro.fac_codi)
						conlist=conlist+1
					endif
				ENDIF
			NEXT sf
		endwith
		*,matcom
		*!*	public cred,deb,fact
		*!*	store 0 to cred,deb,fact,regicomp
		*!*	create cursor cbtes(conc C(3),punto N(4),numero N(8),impabona N(10,2),parcial L,fecha D)
		*!*	if type("matcom")="C"
		*!*		append from array matcom
		*!*		regicomp=reccount()
		*!*		go top
		*!*	endif
		*!*	this.text2.value=0
		*!*	with thisform
		*!*		.text1.value=impotot-totval
		*!*		SELECT a.fac_fec,a.fac_codi,a.fac_tipo,a.fac_pto as "punto",a.fac_nro as "numero",a.fac_tot,a.imp_pag,a.fac_conc, ;
		*!*			(b.iva_1/100)+1 as "valoriva",a.altiva_1 as "altiva",ivand,ivanc FROM facturas as a ;
		*!*			inner join iva as b on a.iva_codi=b.iva_codi WHERE a.pagado<>"S" AND ; 
		*!*			a.anulado<>"S" AND a.cli_codi=codicli and a.fac_conc<>"N" order by a.fac_codi INTO CURSOR factuprov
		*!*		set rela to allt(str(punto))+allt(str(numero)) into cbtes addi
		*!*		go top
		*!*		k=1
		*!*		scan
		*!*			if type("matcom")="C"
		*!*				if punto=cbtes.punto and numero=cbtes.numero
		*!*					skip
		*!*					loop
		*!*				endif
		*!*			endif
		*!*			.list1.list(k,1)=dtoc(fac_fec)
		*!*			do case
		*!*				case fac_conc="F"
		*!*					.list1.list(k,2)="FAC"
		*!*				case fac_conc="N"
		*!*					.list1.list(k,2)="NC"
		*!*				case fac_conc="D"
		*!*					.list1.list(k,2)="ND"
		*!*			endcase
		*!*			.list1.list(k,3)=allt(str(punto))
		*!*			.list1.list(k,4)=str(numero)
		*!*			if fac_conc="D"
		*!*				coef=round((ivand/fac_tot)+1,5)
		*!*			endif
		*!*			if fac_conc="N"
		*!*				coefc=round((ivanc/fac_tot)+1,5)
		*!*			endif
		*!*			.list1.list(k,5)=str(iif(fac_tipo='A',iif(altiva=0,iif(fac_conc="D",round(fac_tot*iif(ivand=0,1,coef),2);
		*!*				,iif(fac_conc="N",round(fac_tot*iif(ivanc=0,1,coefc),2),fac_tot*valoriva))-iif(fac_conc="D",round(imp_pag*iif(ivand=0,1,coef),2),iif(fac_conc="N",round(imp_pag*iif(ivanc=0,1,coefc),2),imp_pag*valoriva)),fac_tot* ;
		*!*				(altiva/100+1)-imp_pag*(altiva/100+1)),fac_tot-imp_pag),10,2)
		*!*			if fac_conc="N"
		*!*				.list1.list(k,5)="-"+allt(.list1.list(k,5))
		*!*			endif
		*!*			if k=1
		*!*				.list1.list(k,6)=str(val(.list1.list(k,6))+val(.list1.list(k,5)),10,2)
		*!*			else
		*!*				.list1.list(k,6)=str(val(.list1.list(k-1,6))+val(.list1.list(k,5)),10,2)
		*!*			endif
		*!*			k=k+1
		*!*		endscan		
		*!*	endwith
	ENDPROC

	PROCEDURE Command2.Click
		*!*	sele cbtes
		*!*	go top
		*!*	if type("matcom")="L"
		*!*		dimension matcom[reccount(),6]
		*!*		copy to array matcom
		*!*	else
		if thisform.text2.value>0
			for i=1 to thisform.list1.listcount
				if thisform.list1.selected(i)
					facadpro= conectar_db(_screen.cn)
						SQLEXEC(facadpro,"select * from facturas where fac_codi=?val(thisform.list1.list(i,7));","cur_fpro")
					desconectar_db(facadpro)
					if i>=2 and matcom>0
						dimension matcom(alen(matcom,1)+1,4)
						dimension auxmatcom(alen(auxmatcom,1)+1,4)
					endif
					cadena=repl("0",4-len(allt(str(cur_fpro.fac_pto))))+allt(str(cur_fpro.fac_pto))+"-"+repl("0",8-len(allt(str(cur_fpro.fac_nro))))+allt(str(cur_fpro.fac_nro))
					matcom(alen(matcom,1),1)=val(thisform.list1.list(i,7))
					matcom(alen(matcom,1),2)=cadena
					matcom(alen(matcom,1),3)=cur_fpro.fac_fec
					matcom(alen(matcom,1),4)=ConverNro(thisform.list1.list(i,5))
		*!*				matcom(alen(matcom,1),5)=fac_codi
					*iif(fac_conc="N",-val(thisform.list1.list(i,5)),val(thisform.list1.list(i,5)))
				endif
			next i
		endif
		if auxmatcom=0
			ACOPY(matcom, auxmatcom)
		else
			dimension auxmatcom(alen(auxmatcom,1)+alen(matcom,1),4)
			ini=alen(auxmatcom,1)
			con2=1
			for i=ini to alen(auxmatcom,1)
				auxmatcom(i,1)=matcom(con2,1)
				auxmatcom(i,2)=matcom(con2,2)
				auxmatcom(i,3)=matcom(con2,3)
				auxmatcom(i,4)=matcom(con2,4)
				con2=con2+1
			next i
		endif
		totval=totval+thisform.text2.value
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		for i=1 to thisform.list1.listcount
			thisform.list1.selected(i)=.T.
		next i
		thisform.text2.value=ConverNro(thisform.list1.list(thisform.list1.listcount,6))
		thisform.command2.enabled=.T.
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE List1.Click
		thisform.text2.value=0
		thisform.command2.enabled=.F.
		for i=1 to this.listcount
			if this.selected(i)
				thisform.text2.value=thisform.text2.value+ConverNro(this.list(i,5))
				thisform.command2.enabled=.T.
			endif
		next i
	ENDPROC

	PROCEDURE List1.MouseDown
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
	ENDPROC

ENDDEFINE

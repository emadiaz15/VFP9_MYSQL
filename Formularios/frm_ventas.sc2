	PROCEDURE calcventas
		
		frmvtas= conectar_db(_screen.cn)
			SQLEXEC(frmvtas,"select a.*,b.loca_codi lc_codi from facturas a inner join clientes b on a.cli_codi=b.cli_codi where a.fac_fec between ?thisform.txt_fecdes.value and ?thisform.txt_fechas.value order by a.fac_fec;","cur_factu")
		desconectar_db(frmvtas)
		
		IF RECCOUNT("cur_factu") > 0
			SELECT cur_factu
			LOCATE
			SELECT round(sum(iif(fac_conc = 'N', -fac_tot, fac_tot)), 2) AS tot ;
			FROM cur_factu WHERE anulado <> 'S' AND lc_codi IN (SELECT lc_codi FROM cur_locali WHERE lc_sel = .T.) INTO ARRAY ar_total
			
			IF TYPE("ar_total")="N"
				thisform.txt_total.value=IIF(ISNULL(ar_total[1,1]),0,ar_total[1,1])
				thisform.lbl_total.Visible= .T.
				thisform.txt_total.Visible= .T.
				thisform.btn_copiar.Visible= .T.
			ENDIF
		ENDIF
		
		RETURN 
		
		
	ENDPROC

	PROCEDURE colorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = .T.
					lnColor = RGB(0,120,215)
				CASE tnsel = .F.
					lnColor = RGB(255,255,255)
			ENDCASE
		Return(lnColor)
		
		RETURN
		
		
	ENDPROC

	PROCEDURE colorletra
		LParameters tnsel,tnalt
		
		Local ltColor
		
			DO case
				CASE tnsel = .T.
					ltColor = RGB(255,255,255)
				CASE tnsel = .F.
					ltColor = RGB(0,0,0)
			ENDCASE
		Return(ltColor)
		
		RETURN
		
	ENDPROC

	PROCEDURE Init
		CREATE CURSOR cur_provin(pr_sel L,pr_nomb C(30),pr_codi N(8))
		CREATE CURSOR cur_locali(lc_sel L,lc_nomb C(50),lc_codi N(8))
		
		frmvtas= conectar_db(_screen.cn)
			SQLEXEC(frmvtas,"select provi_nomb, provi_codi from provincias order by provi_nomb;","cur_prvtas")
		desconectar_db(frmvtas)
		
		IF RECCOUNT("cur_prvtas")>0
			SELECT .F. pr_sel,provi_nomb pr_nomb,provi_codi pr_codi FROM cur_prvtas ORDER BY provi_nomb INTO CURSOR cur_provin READWRITE
			
			SELECT cur_provin
			GO top
			
			thisform.grd_provincias.RecordSource="cur_provin"
			thisform.grd_provincias.SetAll("DynamicBackColor","Thisform.colorfila(cur_provin.pr_sel)","Column")
			thisform.grd_provincias.SetAll("DynamicForeColor","Thisform.colorletra(cur_provin.pr_sel)","Column")
			thisform.grd_provincias.COLUMN1.DynamicBackColor='RGB(148,148,148)'
			**RGB(144,238,144)
		ENDIF
		
		thisform.banner.Height=84
		
		thisform.txt_fecdes.value=ctod("01/"+IIF(MONTH(DATE())=1,"12",allt(str(month(DATE())-1)))+"/"+IIF(month(DATE())=1,allt(str(year(DATE())-1)),allt(str(year(DATE())))))
		thisform.txt_fechas.value=ctod("01/"+allt(str(month(DATE())))+"/"+allt(str(year(DATE()))))-1
		
	ENDPROC

	PROCEDURE selecprovi
		IF USED("cur_provin")
			LOCAL xreg,ar_prsel
		
			SELECT cur_provin
			xreg=RECNO()
			COUNT FOR pr_sel = .T. TO ar_prsel
			GOTO xreg IN cur_provin
			IF TYPE("ar_prsel")="N"
				IF ar_prsel>0
					xreg=RECNO()
					SELECT cur_locali
					SET SAFETY off
					ZAP
					SET SAFETY on
					thisform.grd_localidades.RecordSource=''
					thisform.grd_localidades.Refresh()
					LOCAL xcodipr
					SELECT cur_provin
					LOCATE
					SCAN FOR pr_sel = .T.
						xcodipr=cur_provin.pr_codi
						frmvtas= conectar_db(_screen.cn)
							SQLEXEC(frmvtas,"select loca_nomb, loca_codi from localidades where provi_codi = ?xcodipr order by loca_nomb;","cur_lcvtas")
						desconectar_db(frmvtas)
		
						IF RECCOUNT("cur_lcvtas")>0
							LOCAL xlc,xln
							SELECT cur_lcvtas
							LOCATE
							SCAN
								xlc=cur_lcvtas.loca_codi
								xln=cur_lcvtas.loca_nomb
								INSERT INTO cur_locali values(.T.,xln,xlc)
							ENDSCAN
		
							GO TOP IN cur_locali
							thisform.grd_localidades.RecordSource="cur_locali"
							thisform.grd_localidades.SetAll("DynamicBackColor","Thisform.colorfila(cur_locali.lc_sel)","Column")
							thisform.grd_localidades.SetAll("DynamicForeColor","Thisform.colorletra(cur_locali.lc_sel)","Column")
							thisform.grd_localidades.COLUMN1.DynamicBackColor='RGB(148,148,148)'
						ENDIF
						SELECT cur_provin
					ENDSCAN
					GOTO xreg IN cur_provin
					thisform.chk_todloc.Visible= .T.
					thisform.grd_localidades.Visible= .T.
					thisform.calcventas()
				ELSE
					thisform.chk_todloc.Visible= .F.
					thisform.lbl_total.Visible= .F.
					thisform.txt_total.Visible= .F.
					thisform.btn_copiar.Visible= .F.
					thisform.grd_localidades.Visible= .F.
					thisform.grd_localidades.RecordSource=''
					thisform.grd_localidades.Refresh()
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE btn_copiar.img_edit.Click
		_cliptext=ALLTRIM(STR(thisform.txt_total.Value,20,2))
	ENDPROC

	PROCEDURE btn_salir.Click
		thisform.release
	ENDPROC

	PROCEDURE btn_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE btn_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE chk_todloc.Click
		IF this.Value=1
			UPDATE cur_locali SET lc_sel = .T.
			this.Caption="Desmarcar Todas"
			thisform.calcventas()
		ELSE
			UPDATE cur_locali SET lc_sel = .F.
			this.Caption="Marcar Todas"
			thisform.calcventas()
			thisform.lbl_total.Visible= .F.
			thisform.txt_total.Visible= .F.
			thisform.btn_copiar.Visible= .F.
		ENDIF
		
	ENDPROC

	PROCEDURE chk_todprov.Click
		IF this.Value=1
			UPDATE cur_provin SET pr_sel = .T.
			this.Caption="Desmarcar Todas"
			thisform.selecprovi()
		ELSE
			UPDATE cur_provin SET pr_sel = .F.
			this.Caption="Marcar Todas"
			IF USED("cur_locali")
				thisform.grd_localidades.RecordSource=''
				SELECT cur_locali
				SET SAFETY off
				ZAP
				SET SAFETY on
				thisform.grd_localidades.Refresh()
			ENDIF
			thisform.chk_todloc.Visible= .F.
			thisform.grd_localidades.Visible= .F.
			thisform.btn_copiar.Visible= .F.
			thisform.lbl_total.Visible= .F.
			thisform.txt_total.Visible= .F.
		ENDIF
		
	ENDPROC

	PROCEDURE grd_localidades.Column1.Check1.Click
		IF this.Value=.T.
			LOCAL xregi
			SELECT cur_locali
			xregi=RECNO()
			COUNT FOR lc_sel = .T. TO cantrul
			GOTO xregi IN cur_locali
			IF cantrul=RECCOUNT("cur_locali")
				thisform.chk_todloc.Value=1
				thisform.chk_todloc.Caption="Desmarcar Todas"
			ENDIF
			thisform.calcventas()
		ELSE
			thisform.calcventas()
			thisform.chk_todloc.Value=0
			thisform.chk_todloc.Caption="Marcar Todas"
		ENDIF
		
	ENDPROC

	PROCEDURE grd_provincias.Column1.Check1.Click
		IF this.Value=.T.
			LOCAL xregi
			SELECT cur_provin
			xregi=RECNO()
			COUNT FOR pr_sel = .T. TO cantrue
			GOTO xregi IN cur_provin
			IF cantrue=RECCOUNT("cur_provin")
				thisform.chk_todprov.Value=1
				thisform.chk_todprov.Caption="Desmarcar Todas"
			ENDIF
			thisform.selecprovi()
		ELSE
			thisform.selecprovi()
			thisform.chk_todprov.Value=0
			thisform.chk_todprov.Caption="Marcar Todas"
		ENDIF
		
	ENDPROC

	PROCEDURE txt_fecdes.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_fechas.Click
		this.SetFocus
	ENDPROC

ENDDEFINE

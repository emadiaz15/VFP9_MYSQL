		Alignment = 1, ;
		FontBold = .T., ;
		FontSize = 10, ;
		ForeColor = 2,51,219, ;
		Height = 24, ;
		InputMask = "$ ###,###,###.##", ;
		Left = 407, ;
		Name = "Text5", ;
		Style = 1, ;
		Top = 455, ;
		Width = 114
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text6' AS textbox WITH ;
		Alignment = 1, ;
		FontBold = .T., ;
		FontSize = 10, ;
		ForeColor = 2,51,219, ;
		Height = 24, ;
		InputMask = "$ ###,###,###.##", ;
		Left = 545, ;
		Name = "Text6", ;
		Style = 1, ;
		Top = 455, ;
		Width = 116
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE GotFocus
		SET POINT TO ","
	ENDPROC

	PROCEDURE Init
		public vcodi
		vcodi=0
		set point to ","
		set dele on
		create cursor com(fecha D,cbte C(5),pto N(4),nro N(8),cli C(45),fact N(15,2),porc N(15,3),impo N(15,2))
		this.text2.value=0
		this.text1.value=""
		frmconscom= conectar_db(_screen.cn)
			SQLEXEC(frmconscom,"select com_fech from comisiones order by com_codi;","cur_feccom")
		desconectar_db(frmconscom)
		this.text3.value=cur_feccom.com_fech
		this.text4.value=date()
		LOCAL xnomven
		xnomven=UPPER(substr(sys(0),ATC("#",sys(0))+2))
		frmconscom= conectar_db(_screen.cn)
			SQLEXEC(frmconscom,"select * from vendedores where ven_nomb=?xnomven","cur_vendedor")
		desconectar_db(frmconscom)
		if RECCOUNT("cur_vendedor")>0
			this.command1.enabled=.F.
			this.text2.value=cur_vendedor.ven_codi
			this.text1.value=cur_vendedor.ven_nomb
			this.text2.style=1
			this.text3.setfocus
		endif
	ENDPROC

	PROCEDURE LostFocus
		SET POINT TO
		
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(205,205,205)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Command1.Click
		vcodi=0
		do form locavend with vcodi
		if vcodi>0
			thisform.text2.value=ven_codi
			thisform.text1.value=ven_nomb
			thisform.text3.setfocus
		else
			thisform.text2.value=0
			thisform.text1.value=""
			thisform.text1.setfocus
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE grd_detalle.DblClick
		pasfac=1
		DO FORM consfactura WITH com.fac_codi,com.cond_codi
	ENDPROC

	PROCEDURE List1.Click
		dimension facturado(1,1)
		dimension totcomi(1,1)
		store 0 to facturado,totcomi
		thisform.grd_detalle.recordsource=''
		thisform.grd_detalle.Refresh
		
		with thisform
			frmconscom= conectar_db(_screen.cn)
				SQLEXEC(frmconscom,"select * from comisiones where com_codi=?this.value;","cur_coml")
			desconectar_db(frmconscom)
			if RECCOUNT("cur_coml")>0
				frmconscom= conectar_db(_screen.cn)
					SQLEXEC(frmconscom,"call usp_detacomi(?this.value);","com")				
				desconectar_db(frmconscom)
				go top
				select sum(fact) from com into array facturado
				go top
				select sum(impo) from com into array totcomi
				go top
				.text5.value=facturado[1,1]
				.text6.value=totcomi[1,1]
				thisform.grd_detalle.recordsource="com"
				thisform.grd_detalle.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
			endif
		endwith
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.Valid
		if this.value>0
			frmcomi= conectar_db(_screen.cn)
				SQLEXEC(frmcomi,"select * from vendedores where ven_codi=?this.value;","cur_vendedor")
			desconectar_db(frmcomi)
			if RECCOUNT("cur_vendedor")>0
				thisform.text1.value=cur_vendedor.ven_nomb
			else
				=messagebox("Vendedor no está en Archivo",0+48,"Advertencia")
				this.value=0
				thisform.text1.value=""
				thisform.Text2.Value=0
				return 0
			endif
		endif
	ENDPROC

	PROCEDURE Text3.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text4.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text4.LostFocus
		LOCAL xcodi,xdes,xhas
		xcodi=thisform.text2.Value
		xdes =thisform.text3.Value
		xhas =this.Value
		frmconscom= conectar_db(_screen.cn)
			SQLEXEC(frmconscom,"call usp_listcomi(?xcodi,?xdes,?xhas);","cur_comis")
		desconectar_db(frmconscom)
		thisform.grd_detalle.RecordSource=''
		thisform.grd_detalle.Refresh
		thisform.list1.RowSource=''
		thisform.list1.Refresh
		
		thisform.list1.rowsource="cur_comis"
		
		
	ENDPROC

ENDDEFINE

		return
	ENDPROC

	PROCEDURE excelfooter
		LPARAMETERS nFila
		
		XLSheet.Rows(nFila).RowHeight = 10
		XLSheet.Range(XLSheet.Cells(nFila,2),XLSheet.Cells(nFila,7)).Borders(4).LineStyle=0
		XLSheet.Range(XLSheet.Cells(nFila,2),XLSheet.Cells(nFila,7)).Borders(4).Weight=3
		
		nFila = nFila + 1
		
		IF thisform.dispmov=1
			XLSheet.Cells(nFila,4)="MOVIMIENTOS EN EL PERÍODO INDICADO:"
			XLSheet.Cells(nFila,4).HorizontalAlignment=-4152
			XLSheet.Cells(nFila,5)=thisform.text11.value
			XLSheet.Cells(nFila,5).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
			XLSheet.Cells(nFila,6)=thisform.text12.value
			XLSheet.Cells(nFila,6).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
			XLSheet.Cells(nFila,7)=thisform.text10.value
			XLSheet.Cells(nFila,7).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
			XLSheet.Range(XLSheet.Cells(nFila,4),XLSheet.Cells(nFila,7)).Font.Color=RGB(0,0,255)
			XLSheet.Range(XLSheet.Cells(nFila,4),XLSheet.Cells(nFila,7)).Font.Bold=.T.
		ELSE
			XLSheet.Rows(nFila).RowHeight = 10
		ENDIF
		nFila = nFila + 1
		XLSheet.Cells(nFila,4)="MOVIMIENTOS TOTALES AL "+DTOC(thisform.text2.value)+":"
		XLSheet.Cells(nFila,4).HorizontalAlignment=-4152
		XLSheet.Cells(nFila,5)=thisform.text8.value
		XLSheet.Cells(nFila,5).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		XLSheet.Cells(nFila,6)=thisform.text9.value
		XLSheet.Cells(nFila,6).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		XLSheet.Cells(nFila,7)=thisform.text4.value
		XLSheet.Cells(nFila,7).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		IF thisform.text4.Value < 0
			XLSheet.Cells(nFila,7).Font.Color=RGB(255,0,0)
		ENDIF
		XLSheet.Range(XLSheet.Cells(nFila,4),XLSheet.Cells(nFila,7)).Font.Bold=.T.
		
		RETURN
		
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS codicli, xopcion
		
		PUBLIC cantreg
		
		this.text6.value=0
		*!*	public codicli
		
		&&,saldoant,cantreg,auxdebe,auxhaber,pasocur
		set point to ","
		set separator to "."
		set dele on
		set date british
		set cent on
		
		*!*	saldoant=0
		cantreg=0
		*!*	pasocur=0
		IF codicli = 0
			do form cliload with codicli
		ELSE
			frmctacli= conectar_db(_screen.cn)
				SQLEXEC(frmctacli,"call usp_buscarcli(?codicli);","cur_clie")
			desconectar_db(frmctacli)
		ENDIF
		
		if codicli>0
			thisform.pasocur=1
			this.text5.value=codicli
			this.text3.value=cur_clie.cli_nomb
			this.text6.value="0"+allt(cur_clie.cli_cartel)+"-"+allt(cur_clie.cli_tel1)
			cond=cur_clie.cond_codi
			this.command2.Enabled= .T.
		else
			this.release
		endif
		this.text1.value=ctod("01"+"/"+"01"+"/"+allt(str(year(date()))))
		this.text2.value=date()
		
		CREATE CURSOR datprin(fecdes D,fechas D,perdebe N(12,2),perhab N(12,2),pertot N(12,2),ocultar N(1))
		
		create cursor detacta(mov_codi N(8),mov_fech D,tipmov_codi N(8),fac_codi N(8),rec_codi N(8),reg_codi N(8),sini_cod N(8),debv_codi N(8),crev_codi N(8),mov_impo N(15,2))
		
		CREATE CURSOR movitot(cbte C(25),nro C(13),fecha D,debe N(15,2),haber N(15,2),salmov N(15,2),movicod N(8))
		
		IF xopcion = 2
			thisform.command1.Click()
		ENDIF
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(215,215,215)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE btn_movimientos.btn.Click
		DO case
			CASE thisform.dispmov=0
				thisform.dispmov=1
				this.parent.img_boton.Picture="C:\VFP9_MYSQL\imagen\iconos\database_previous.png"
				this.ToolTipText="Ocultar Movimientos en el Período Indicado"
				thisform.label6.Visible= .T.
				thisform.text10.Visible= .T.
				thisform.text11.Visible= .T.
				thisform.text12.Visible= .T.
			CASE thisform.dispmov=1
				thisform.dispmov=0
				this.parent.img_boton.Picture="C:\VFP9_MYSQL\imagen\iconos\database_together.png"
				this.ToolTipText="Mostrar Movimientos en el Período Indicado"
				thisform.label6.Visible= .F.
				thisform.text10.Visible= .F.
				thisform.text11.Visible= .F.
				thisform.text12.Visible= .F.
		ENDCASE
		
	ENDPROC

	PROCEDURE btn_movimientos.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE btn_movimientos.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE btn_movimientos.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE Command1.Click
		local detallar,xopcion,xcodicli,xfecdes,xfechas
		set talk on
		SET SAFETY OFF
		sele movitot
		ZAP
		SET SAFETY ON
		detallar=1
		thisform.auxdebe=0
		thisform.auxhaber=0
		xcodicli=codicli
		with thisform
			xfecdes=.text1.value
			xfechas=.text2.value
			.label4.visible=.F.
			.label6.visible=.F.
			.text4.value=0
			.text8.value=0
			.text9.value=0
			.text10.value=0
			.text11.value=0
			.text12.value=0
			.text4.visible=.F.
			.text8.visible=.F.
			.text9.visible=.F.
			.text10.visible=.F.
			.text11.visible=.F.
			.text12.visible=.F.
			frmctacli= conectar_db(_screen.cn)
				xopcion=1
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","siv")
				sum sini_imp to si
				xopcion=2
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","ventas")
				sum ven_imp to vta
				xopcion=3
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","notascred")
				sum cre_imp to ncred
				xopcion=4
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","pagos")
				sum pag_imp to pag
				xopcion=5
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","regul")
				SUM regul.reg_imp FOR regul.reg_conc="D" to regdebe
				SUM regul.reg_imp FOR regul.reg_conc="H" to reghaber
				xopcion=12
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","debint")
				sum debin_imp to di
				xopcion=14
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","creint")
				sum crein_imp to ci		
					
				saldo=round(si+vta+di-ci-ncred-pag+regdebe-reghaber,2)
		
				xopcion=6
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifsiv")
				xopcion=7
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","veriffac")
				xopcion=8
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifcre")
				xopcion=9
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifdeb")
		 		xopcion=10
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifrec")
				xopcion=11
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifregul")
				xopcion=13
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifdebint")
				xopcion=15
				SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifcreint")
			desconectar_db(frmctacli)
		
			select * from veriffac union (select * from verifsiv) union ;
				(select * from verifcre) union ;
				(select * from verifdeb) union ;
				(select * from verifrec) union ;
				(select * from verifregul) union ;
				(select * from verifdebint) UNION ; 
				(select * from verifcreint) into cursor detacta
			set talk on
			sele detacta
				
			index on dtos(mov_fech)+str(fac_codi) to SYS(2015)
			
			thisform.saldoant=saldo
			versiv=""
			verfac=""
			verdeb=""
			vercre=""
			verrec=""
			verreg=""
			verdi=""
			verci=""
			sele verifsiv
			if reccount()=0
				versiv="S"
			endif
			sele veriffac
			if reccount()=0
				verfac="S"
			endif
			sele verifdeb
			if reccount()=0
				verdeb="S"
			endif
			sele verifcre
			if reccount()=0
				vercre="S"
			endif
			sele verifrec
			if reccount()=0
				verrec="S"
			endif
			sele verifregul
			if reccount()=0
				verreg="S"
			ENDIF
			sele verifdebint
			if reccount()=0
				verdi="S"
			ENDIF
			sele verifcreint
			if reccount()=0
				verci="S"
			endif
			if versiv="S" and verfac="S" and verdeb="S" and vercre="S" and verrec="S" and verreg="S" and verdi="S" and verci="S"
				messagebox("Sin movimientos en el período indicado",0+64,"Cuantas Corrientes")
				detallar=0
				.command3.enabled=.F.
			endif
			SELECT movitot
			APPEND BLANK
			REPLACE cbte WITH "SALDO ANTERIOR"
			REPLACE debe WITH si+vta+di+regdebe
			REPLACE haber WITH ncred+pag+reghaber
			REPLACE salmov WITH saldo
		
			thisform.auxdebe=si+vta+di+regdebe
			thisform.auxhaber=ncred+ci+pag+reghaber
			if detallar=1
				.command3.enabled=.T.
				sele detacta
		*!*			set order to fac
				go top
				SCAN
					frmctacli= conectar_db(_screen.cn)
					do case
						case tipmov_codi=1 or tipmov_codi=7 or tipmov_codi=8
							SQLEXEC(frmctacli,"select * from facturas where fac_codi=?detacta.fac_codi;","cur_famov")
							pto=repl("0",4-len(allt(str(cur_famov.fac_pto))))+allt(str(cur_famov.fac_pto))+"-"
							nro=repl("0",8-len(allt(str(cur_famov.fac_nro))))+allt(str(cur_famov.fac_nro))
						case tipmov_codi=2
							SQLEXEC(frmctacli,"select * from recibos where rec_codi=?detacta.rec_codi;","cur_remov")
							pto=allt(str(cur_remov.rec_tipo))+"-"
							nro=repl("0",8-len(allt(str(cur_remov.rec_nro))))+allt(str(cur_remov.rec_nro))
						case tipmov_codi=11
							SQLEXEC(frmctacli,"select * from regularizaciones where reg_codi=?detacta.reg_codi;","cur_regmov")
							pto=""
							nro="0000"+"-"+repl("0",8-len(allt(str(cur_regmov.reg_codi))))+allt(str(cur_regmov.reg_codi))
						case tipmov_codi=12
							SQLEXEC(frmctacli,"select * from saldosiniciales where sini_cod=?detacta.sini_cod;","cur_sinmov")
							pto=""
							nro="0000"+"-"+repl("0",8-len(allt(str(cur_sinmov.sini_cod))))+allt(str(cur_sinmov.sini_cod))
						case tipmov_codi=14
							SQLEXEC(frmctacli,"select * from debintv where debv_codi=?detacta.debv_codi;","cur_dimov")
							pto=""
							nro="0000"+"-"+repl("0",8-len(allt(str(cur_dimov.debv_codi))))+allt(str(cur_dimov.debv_codi))
						case tipmov_codi=15
							SQLEXEC(frmctacli,"select * from creintv where crev_codi=?detacta.crev_codi;","cur_cimov")
							pto=""
							nro="0000"+"-"+repl("0",8-len(allt(str(cur_cimov.crev_codi))))+allt(str(cur_cimov.crev_codi))					
					ENDCASE
					SQLEXEC(frmctacli,"select tipmov_desc from tiposmovimientos where tipmov_codi=?detacta.tipmov_codi;","cur_tipm")
					desconectar_db(frmctacli)
					SELECT detacta
					APPEND blank IN movitot
					REPLACE movitot.cbte WITH cur_tipm.tipmov_desc
					REPLACE movitot.nro WITH allt(pto)+allt(nro)
					REPLACE movitot.fecha WITH mov_fech
					do case
						case tipmov_codi=1
							REPLACE movitot.debe WITH mov_impo
							REPLACE movitot.movicod WITH fac_codi
							saldo=saldo+mov_impo
							vta=vta+mov_impo
						case tipmov_codi=7
							REPLACE movitot.haber WITH mov_impo
							REPLACE movitot.movicod WITH fac_codi
							saldo=saldo-mov_impo
							ncred=ncred+mov_impo
						case tipmov_codi=8
							REPLACE movitot.debe WITH mov_impo
							REPLACE movitot.movicod WITH fac_codi
							saldo=saldo+mov_impo
							vta=vta+mov_impo
						case tipmov_codi=2
							REPLACE movitot.haber WITH mov_impo
							REPLACE movitot.movicod WITH rec_codi
							saldo=saldo-mov_impo
							pag=pag+mov_impo
						case tipmov_codi=11
							if cur_regmov.reg_conc="D"
								REPLACE movitot.debe WITH mov_impo
								REPLACE movitot.movicod WITH reg_codi
								saldo=saldo+mov_impo
								vta=vta+mov_impo
							else
								REPLACE movitot.haber WITH mov_impo
								REPLACE movitot.movicod WITH reg_codi
								saldo=saldo-mov_impo
								ncred=ncred+mov_impo
							endif			
						case tipmov_codi=12
							if mov_impo>0
								REPLACE movitot.debe WITH mov_impo
								REPLACE movitot.movicod WITH sini_cod
								vta=vta+mov_impo
							else
								REPLACE movitot.haber WITH mov_impo
								REPLACE movitot.movicod WITH sini_cod
								ncred=ncred+mov_impo
							endif			
							saldo=saldo+mov_impo
						case tipmov_codi=14
							REPLACE movitot.debe WITH mov_impo
							REPLACE movitot.movicod WITH debv_codi
							saldo=saldo+mov_impo
							vta=vta+mov_impo
						case tipmov_codi=15
							REPLACE movitot.haber WITH mov_impo
							REPLACE movitot.movicod WITH crev_codi
							saldo=saldo-mov_impo
							vta=vta-mov_impo									
					endcase
					REPLACE movitot.salmov WITH saldo
				ENDSCAN
			ENDIF
			SELECT movitot
			GO top
		*!*		COPY TO "c:\pgym.xls" FOX2X
		*!*		GO top
			.grid1.recordsourcetype=1
			.grid1.recordsource="movitot"
			thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
			.label4.visible=.T.
			.label4.caption="MOVIMIENTOS TOTALES AL "+allt(dtoc(thisform.text2.value))+":"
		*!*		.label6.visible=.T.
			.label6.caption="MOVIMIENTOS EN EL PERÍODO INDICADO: "
			.btn_movimientos.Visible=.T.
			.text4.value=saldo
			.text8.value=si+vta+di+regdebe
			.text9.value=ncred+ci+pag+reghaber
			.text11.value=.text8.value-thisform.auxdebe
			.text12.value=.text9.value-thisform.auxhaber
			.text10.value=.text11.value-.text12.value
			.text4.visible=.T.
			.text8.visible=.T.
			.text9.visible=.T.
		*!*		.text11.visible=.T.
		*!*		.text12.visible=.T.
		*!*		.text10.visible=.T.
			.command2.enabled=.T.
			thisform.Refresh()
		*!*		this.enabled=.F.
			.text1.setfocus
		endwith
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		with thisform
			.label4.visible=.F.
			.label6.visible=.F.
			.text4.value=0
			.text8.value=0
			.text9.value=0
			.text10.value=0
			.text11.value=0
			.text12.value=0
			.text4.visible=.F.
			.text8.visible=.F.
			.text9.visible=.F.
			.text10.visible=.F.
			.text11.visible=.F.
			.text12.visible=.F.
			.Grid1.RecordSource=''
			.grid1.Refresh()
			codicli=0
			do form cliload with codicli
			if codicli>0
				.text5.value=codicli
				.text3.value=cur_clie.cli_nomb
				.text6.value="0"+allt(cur_clie.cli_cartel)+"-"+allt(cur_clie.cli_tel1)
				cond=cur_clie.cond_codi
				.text5.value=codicli
				.text3.value=cur_clie.cli_nomb
				.text6.value="0"+allt(cur_clie.cli_cartel)+"-"+allt(cur_clie.cli_tel1)
				.label4.visible=.F.
				.text4.visible=.F.
				.btn_movimientos.Visible=.F.
				thisform.btn_movimientos.img_boton.Picture="c:\vfp9_mysql\imagen\iconos\database_together.png"
				thisform.dispmov=0
				.text1.setfocus
			else
				.release
			endif
		endwith
	ENDPROC


	PROCEDURE Activate
		IF thisform.pasocur=1
			codicli=cur_clie.cli_codi
			cond=cur_clie.cond_codi
		ELSE
			thisform.release
		ENDIF
	ENDPROC

	PROCEDURE anularecibo
		LPARAMETERS xcodi
		
		do form anularecnum with xcodi
		
		thisform.command1.Click()
		
		RETURN
		
	ENDPROC

	PROCEDURE Destroy
		set point to
		set separator to
		&&Cerrar_cursores()
	ENDPROC


	PROCEDURE Command5.Click
		local detallar,saldo,his
		saldo=0
		his=0
		set talk off
		select * from clientes into cursor cli
		sele cli
		go top
		scan
			codicli=cli_codi
			thisform.text3.value=allt(str(cli_codi))+" "+allt(cli_nomb)
			detallar=1
			with thisform
				select sini_fech,sini_cod,cli_sal as "sini_imp" ;
				   from saldosiniciales where cli_codi=codicli and sini_fech<.text1.value and anulado<>"S" ;
				   into cursor siv
				sum sini_imp to si
				select fac_fec,fac_nro,fac_ng+neto_1+neto_2+fac_ivari+fac_ivarni as "ven_imp" ;
				   from facturas where cli_codi=codicli and fac_fec<.text1.value and anulado<>"S" ;
				   and fac_conc<>"N" into cursor ventas
				sum ven_imp to vta
				select fac_fec,fac_nro,fac_ng+neto_1+neto_2+fac_ivari+fac_ivarni ;
				   as "cre_imp" from facturas where cli_codi=codicli and fac_fec<.text1.value and ;
				   anulado<>"S" and fac_conc="N" into cursor notascred
				sum cre_imp to ncred
				select rec_impo+rec_antic as "pag_imp" from recibos where rec_fec<.text1.value and cli_codi=codicli ;
				   into cursor pagos
				sum pag_imp to pag
		
				select reg_conc,reg_impo as "reg_imp" from regularizaciones where reg_fech<.text1.value and ;
					cli_codi=codicli and ctacte="S" into cursor regul
				sum reg_imp while reg_conc="D" to regdebe
				sum reg_imp while reg_conc="H" to reghaber
			 
				saldo=round(si+vta-ncred-pag+regdebe-reghaber,2) 
		
				select sini_fech as "mov_fech",12 as "tipmov_codi",00000000 as "fac_codi",00000000 as "rec_codi",00000000 as "reg_codi", ;
					sini_cod,cli_sal as "mov_impo" from saldosiniciales ;
					where between(sini_fech,.text1.value,.text2.value) and anulado<>"S" and cli_codi=codicli ;
					into cursor verifsiv
				select fac_fec as "mov_fech",01 as "tipmov_codi",fac_codi,00000000 as "rec_codi",00000000 as "reg_codi", ;
					00000000 as "sini_cod",fac_ng+neto_1+neto_2+fac_ivari+fac_ivarni as "mov_impo" from facturas ;
					where between(fac_fec,.text1.value,.text2.value) and anulado<>"S" and cli_codi=codicli and fac_conc="F" ;
					into cursor veriffac
				select fac_fec as "mov_fech",07 as "tipmov_codi",fac_codi,00000000 as "rec_codi",00000000 as "reg_codi", ;
					00000000 as "sini_cod",fac_ng+neto_1+neto_2+fac_ivari+fac_ivarni as "mov_impo" from facturas ;
					where between(fac_fec,.text1.value,.text2.value) ;
					and anulado<>"S" and cli_codi=codicli and fac_conc="N" into cursor verifcre
				select fac_fec as "mov_fech",08 as "tipmov_codi",fac_codi,00000000 as "rec_codi",00000000 as "reg_codi", ;
					00000000 as "sini_cod",fac_ng+neto_1+neto_2+fac_ivari+fac_ivarni as "mov_impo" from facturas ;
					where between(fac_fec,.text1.value,.text2.value) and ;
					anulado<>"S" and cli_codi=codicli and fac_conc="D" into cursor verifdeb
				select rec_fec as "mov_fech",02 as "tipmov_codi",00000000 as "fac_codi",rec_codi,00000000 as "reg_codi",;
					00000000 as "sini_cod",rec_impo+rec_antic as "mov_impo" from recibos where cli_codi=codicli and ;
					between(rec_fec,.text1.value,.text2.value) into cursor verifrec
				select reg_fech as "mov_fech",11 as "tipmov_codi",00000000 as "fac_codi",00000000 as "rec_codi",reg_codi,;
					00000000 as "sini_cod",reg_impo as "mov_impo" from regularizaciones where cli_codi=codicli and ctacte="S" and;
					between(reg_fech,.text1.value,.text2.value) into cursor verifregul
		
				select * from veriffac union (select * from verifsiv) union ;
					(select * from verifcre) union ;
					(select * from verifdeb) union ;
					(select * from verifrec) union ;
					(select * from verifregul) into cursor detacta
				sele detacta
				index on dtos(mov_fech)+str(fac_codi) to SYS(2015)
				thisform.saldoant=saldo
				versiv=""
				verfac=""
				verdeb=""
				vercre=""
				verrec=""
				verreg=""
				sele verifsiv
				if reccount()=0
					versiv="S"
				endif
				sele veriffac
				if reccount()=0
					verfac="S"
				endif
				sele verifdeb
				if reccount()=0
					verdeb="S"
				endif
				sele verifcre
				if reccount()=0
					vercre="S"
				endif
				sele verifrec
				if reccount()=0
					verrec="S"
				endif
				sele verifregul
				if reccount()=0
					verreg="S"
				endif		
				if versiv="S" and verfac="S" and verdeb="S" and vercre="S" and verrec="S" and verreg="S"
		*!*				messagebox("Sin movimientos en el período indicado",0+64,"Cuantas Corrientes")
					detallar=0
		*!*				.command3.enabled=.F.
				endif
		*!*			if .grdcta.rows>1
		*!*				.grdcta.row=1
		*!*				.grdcta.col=0
		*!*				.grdcta.text="SALDO ANTERIOR"
		*!*				.grdcta.col=2
		*!*				.grdcta.text=dtoc(.text1.value)
		*!*				.grdcta.col=5
		*!*				.grdcta.text=str(saldo,10,2)
		*!*			else
		*!*				.grdcta.additem("SALDO ANTERIOR"+chr(9)+""+chr(9)+dtoc(.text1.value)+chr(9)+""+chr(9)+""+chr(9)+str(saldo,10,2))
		*!*			endif
				if detallar=1
					.command3.enabled=.T.
					sele detacta
					thisform.cantreg=reccount()
					set rela to sini_cod into saldosiniciales addi
					set rela to fac_codi into facturas addi
					set rela to rec_codi into recibos addi
					set rela to reg_codi into regularizaciones addi
					set rela to tipmov_codi into tiposmovimientos addi
					set order to fac
					go top
					do while !eof()
						do case
							case tipmov_codi=1
								saldo=saldo+mov_impo
							case tipmov_codi=7
								saldo=saldo-mov_impo
							case tipmov_codi=8
								saldo=saldo+mov_impo
							case tipmov_codi=2
								saldo=saldo-mov_impo
							case tipmov_codi=11
								if regularizaciones.reg_conc="D"
									saldo=saldo+mov_impo
								else
									saldo=saldo-mov_impo
								endif			
							case tipmov_codi=12
								saldo=saldo+mov_impo
						endcase
						skip
					enddo
				endif
			endwith
			sele clientes
			seek cli.cli_codi
			repla cli_saldo with saldo
			sele cli
		endscan
		messagebox("La actualización de saldos finalizó satisfactoriamente",0+64,"Información")
	ENDPROC

	PROCEDURE Command6.Click
		local detallar,xopcion,xcodicli,xfecdes,xfechas,saldotot, ;
			  si,vta,ncred,pag,regdebe,reghaber,di,saldo,saldoant, ;
			  auxdebe,auxhaber
		saldotot = 0
		set talk on
		SET SAFETY OFF
		sele movitot
		ZAP
		SET SAFETY ON
		detallar=1
		auxdebe=0
		auxhaber=0
		frmctacli= conectar_db(_screen.cn)
			SQLEXEC(frmctacli,"select * from clientes order by cli_codi;","cur_clitot")
		desconectar_db(frmctacli)
		LOCATE
		
		SCAN
			STORE 0 TO si,com,ncred,pag,regdebe,reghaber,di,saldo,saldoant,auxdebe,auxhaber
			
			xcodicli=cur_clitot.cli_codi
			WAIT WINDOW "CLIENTE "+ALLTRIM(STR(cur_clitot.cli_codi))+" - "+ALLTRIM(cur_clitot.cli_nomb) NOWAIT
			with thisform
				xfecdes=.text1.value
				xfechas=.text2.value
				.label4.visible=.F.
				.label6.visible=.F.
				.text4.value=0
				.text8.value=0
				.text9.value=0
				.text10.value=0
				.text11.value=0
				.text12.value=0
				.text4.visible=.F.
				.text8.visible=.F.
				.text9.visible=.F.
				.text10.visible=.F.
				.text11.visible=.F.
				.text12.visible=.F.
				frmctacli= conectar_db(_screen.cn)
					xopcion=1
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","siv")
					sum sini_imp to si
					xopcion=2
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","ventas")
					sum ven_imp to vta
					xopcion=3
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","notascred")
					sum cre_imp to ncred
					xopcion=4
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","pagos")
					sum pag_imp to pag
					xopcion=5
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","regul")
					SUM regul.reg_imp FOR regul.reg_conc="D" to regdebe
					SUM regul.reg_imp FOR regul.reg_conc="H" to reghaber
					xopcion=12
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","debint")
					sum debin_imp to di
						
					saldo=round(si+vta+di-ncred-pag+regdebe-reghaber,2)
		
					xopcion=6
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifsiv")
					xopcion=7
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","veriffac")
					xopcion=8
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifcre")
					xopcion=9
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifdeb")
			 		xopcion=10
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifrec")
					xopcion=11
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifregul")
					xopcion=13
					SQLEXEC(frmctacli,"call usp_ctacli(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifdebint")
				desconectar_db(frmctacli)
		
				select * from veriffac union (select * from verifsiv) union ;
					(select * from verifcre) union ;
					(select * from verifdeb) union ;
					(select * from verifrec) union ;
					(select * from verifregul) union ;
					(select * from verifdebint) into cursor detacta
				set talk on
				sele detacta
					
				index on dtos(mov_fech)+str(fac_codi) to SYS(2015)
				saldoant=saldo
				SELECT movitot
				APPEND BLANK
				REPLACE cbte WITH "SALDO ANTERIOR"
				REPLACE debe WITH si+vta+di+regdebe
				REPLACE haber WITH ncred+pag+reghaber
				REPLACE salmov WITH saldo
				REPLACE movitot.codcli WITH cur_clitot.cli_codi
				REPLACE movitot.nomcli WITH ALLTRIM(cur_clitot.cli_nomb)
				REPLACE movitot.saltot WITH saldo
		
				auxdebe=si+vta+di+regdebe
				auxhaber=ncred+pag+reghaber
				if detallar=1
					.command3.enabled=.T.
					sele detacta
			*!*			set order to fac
					go top
					SCAN
						frmctacli= conectar_db(_screen.cn)
						do case
							case tipmov_codi=1 or tipmov_codi=7 or tipmov_codi=8
								SQLEXEC(frmctacli,"select * from facturas where fac_codi=?detacta.fac_codi;","cur_famov")
								pto=repl("0",4-len(allt(str(cur_famov.fac_pto))))+allt(str(cur_famov.fac_pto))+"-"
								nro=repl("0",8-len(allt(str(cur_famov.fac_nro))))+allt(str(cur_famov.fac_nro))
							case tipmov_codi=2
								SQLEXEC(frmctacli,"select * from recibos where rec_codi=?detacta.rec_codi;","cur_remov")
								pto=allt(str(cur_remov.rec_tipo))+"-"
								nro=repl("0",8-len(allt(str(cur_remov.rec_nro))))+allt(str(cur_remov.rec_nro))
							case tipmov_codi=11
								SQLEXEC(frmctacli,"select * from regularizaciones where reg_codi=?detacta.reg_codi;","cur_regmov")
								pto=""
								nro="0000"+"-"+repl("0",8-len(allt(str(cur_regmov.reg_codi))))+allt(str(cur_regmov.reg_codi))
							case tipmov_codi=12
								SQLEXEC(frmctacli,"select * from saldosiniciales where sini_cod=?detacta.sini_cod;","cur_sinmov")
								pto=""
								nro="0000"+"-"+repl("0",8-len(allt(str(cur_sinmov.sini_cod))))+allt(str(cur_sinmov.sini_cod))
							case tipmov_codi=14
								SQLEXEC(frmctacli,"select * from debintv where debv_codi=?detacta.debv_codi;","cur_dimov")
								pto=""
								nro="0000"+"-"+repl("0",8-len(allt(str(cur_dimov.debv_codi))))+allt(str(cur_dimov.debv_codi))					
						ENDCASE
						SQLEXEC(frmctacli,"select tipmov_desc from tiposmovimientos where tipmov_codi=?detacta.tipmov_codi;","cur_tipm")
						desconectar_db(frmctacli)
						SELECT detacta
						APPEND blank IN movitot
						REPLACE movitot.cbte WITH cur_tipm.tipmov_desc
						REPLACE movitot.nro WITH allt(pto)+allt(nro)
						REPLACE movitot.fecha WITH mov_fech
						do case
							case tipmov_codi=1
								REPLACE movitot.debe WITH mov_impo
								REPLACE movitot.movicod WITH fac_codi
								saldo=saldo+mov_impo
								vta=vta+mov_impo
							case tipmov_codi=7
								REPLACE movitot.haber WITH mov_impo
								REPLACE movitot.movicod WITH fac_codi
								saldo=saldo-mov_impo
								ncred=ncred+mov_impo
							case tipmov_codi=8
								REPLACE movitot.debe WITH mov_impo
								REPLACE movitot.movicod WITH fac_codi
								saldo=saldo+mov_impo
								vta=vta+mov_impo
							case tipmov_codi=2
								REPLACE movitot.haber WITH mov_impo
								REPLACE movitot.movicod WITH rec_codi
								saldo=saldo-mov_impo
								pag=pag+mov_impo
							case tipmov_codi=11
								if cur_regmov.reg_conc="D"
									REPLACE movitot.debe WITH mov_impo
									REPLACE movitot.movicod WITH reg_codi
									saldo=saldo+mov_impo
									vta=vta+mov_impo
								else
									REPLACE movitot.haber WITH mov_impo
									REPLACE movitot.movicod WITH reg_codi
									saldo=saldo-mov_impo
									ncred=ncred+mov_impo
								endif			
							case tipmov_codi=12
								if mov_impo>0
									REPLACE movitot.debe WITH mov_impo
									REPLACE movitot.movicod WITH sini_cod
									vta=vta+mov_impo
								else
									REPLACE movitot.haber WITH mov_impo
									REPLACE movitot.movicod WITH sini_cod
									ncred=ncred+mov_impo
								endif			
								saldo=saldo+mov_impo
							case tipmov_codi=14
								REPLACE movitot.debe WITH mov_impo
								REPLACE movitot.movicod WITH debv_codi
								saldo=saldo+mov_impo
								vta=vta+mov_impo					
						endcase
						REPLACE movitot.salmov WITH saldo
						REPLACE movitot.codcli WITH cur_clitot.cli_codi
						REPLACE movitot.nomcli WITH ALLTRIM(cur_clitot.cli_nomb)					
					ENDSCAN
					saldotot = saldotot + saldo
					SKIP -1
					REPLACE movitot.saltot WITH saldo
					SKIP
				ENDIF
			ENDWITH
		ENDSCAN
		WITH thisform
			SELECT movitot
			GO top
		*!*		COPY TO "C:\Users\Administrador\Desktop\nuestro\Cuentas_por_Cobrar\Por_Cobrar.xls" FOX2X
		*!*		GO top
			.grid1.recordsourcetype=1
			.grid1.recordsource="movitot"
			thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
			.label4.visible=.T.
			.label4.caption="MOVIMIENTOS TOTALES AL "+allt(dtoc(thisform.text2.value))+":"
		*!*		.label6.visible=.T.
			.label6.caption="MOVIMIENTOS EN EL PERÍODO INDICADO: "
			.btn_movimientos.Visible=.T.
			.text4.value=saldotot
		*!*		.text8.value=si+vta+di+regdebe
		*!*		.text9.value=ncred+pag+reghaber
		*!*		.text11.value=.text8.value-auxdebe
		*!*		.text12.value=.text9.value-auxhaber
		*!*		.text10.value=.text11.value-.text12.value
			.text4.visible=.T.
			.text8.visible=.T.
			.text9.visible=.T.
			.command2.enabled=.T.
			thisform.Refresh()
			.text1.setfocus
		ENDWITH
		
	ENDPROC

	PROCEDURE Command7.Click
		IF USED("movitot")
			IF RECCOUNT("movitot") > 0
		
				local Fila,fpag,pagina,empresa
		
				wait'Espere Un Momento Exportando Datos' window nowait
				_screen.mousepointer=11
				TmpSheet=GetObject('','Excel.Sheet')
				XLApp=TmpSheet.Application
				XLApp.workbooks.add()
				XLSheet=XLApp.ActiveSheet
				with XLSheet.PageSetup
					.Orientation = 1
					.LeftMargin = XLApp.InchesToPoints(0)
					.RightMargin = XLApp.InchesToPoints(0)
				    .TopMargin = XLApp.InchesToPoints(0)
				    .BottomMargin = XLApp.InchesToPoints(0)
				    .HeaderMargin = XLApp.InchesToPoints(0)
				    .FooterMargin = XLApp.InchesToPoints(0)
				    .Zoom=85
				ENDWITH
				XLSheet.Columns("A:A").ColumnWidth = 8.43
				XLSheet.Columns("B:B").ColumnWidth = 16.14
				XLSheet.Columns("C:C").ColumnWidth = 13.71
				XLSheet.Columns("D:D").ColumnWidth = 10.71
				XLSheet.Columns("E:E").ColumnWidth = 18.29
				XLSheet.Columns("F:F").ColumnWidth = 18.29
				XLSheet.Columns("G:G").ColumnWidth = 18.29
		
				thisform.excelencabezado()
		
				SELECT movitot
				LOCATE
				Fila=10
				SCAN
					XLSheet.Cells(Fila,2)=movitot.cbte
				   	XLSheet.Cells(Fila,2).HorizontalAlignment=-4131				
					XLSheet.Cells(Fila,3)=movitot.nro
				   	XLSheet.Cells(Fila,3).HorizontalAlignment=-4108
					XLSheet.Cells(Fila,4)=DTOC(movitot.fecha)
					XLSheet.Cells(Fila,4).HorizontalAlignment=-4108
				   	XLSheet.Cells(Fila,5)=movitot.debe
				   	XLSheet.Cells(Fila,5).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
				   	XLSheet.Cells(Fila,6)=movitot.haber
				   	XLSheet.Cells(Fila,6).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
				   	XLSheet.Cells(Fila,7)=movitot.salmov
				   	XLSheet.Cells(Fila,7).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
				   	IF movitot.salmov < 0
				   		XLSheet.Cells(Fila,7).Font.Color=RGB(255,0,0)
				   	ENDIF
				   	Fila=Fila+1
				ENDSCAN
		
				thisform.excelfooter(Fila)
		
				XLApp.visible=.T.
				XLApp.WindowState = -4137
				DECLARE LONG BringWindowToTop IN "user32" LONG HWND
				BringWindowToTop(XLApp.HWND)
				_screen.mousepointer=0
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Grid1.DblClick
		
		do case
			case allt(movitot.cbte)="FACTURA" or allt(movitot.cbte)="NOTA DE CREDITO" or allt(movitot.cbte)="NOTA DE DEBITO"
				codifac=movitot.movicod
				pasfac=1
				do form consfactura with codifac,cond
			case allt(movitot.cbte)="RECIBO"
				codirec=movitot.movicod
				pasrec=1
				do form consrecibo with codirec,cond
			case allt(movitot.cbte)="DEBITO INTERNO"
				debintcli=movitot.movicod
				pasdiv=1
				do form consdebintcli with debintcli
			case allt(movitot.cbte)="CREDITO INTERNO"
				creintcli=movitot.movicod
				pasdiv=1
				do form conscreintcli with creintcli		
		endcase
		
	ENDPROC

	PROCEDURE Grid1.RightClick
		LOCAL lcShortcut, loRef
		m.loRef = this
		m.loRefp = this.Parent
		m.lcShortcut = SYS(2015)
		
		DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Consultar Comprobante] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
		DEFINE BAR 2 OF (m.lcShortcut) PROMPT [Anular Recibo de Cobranza] PICTURE "C:\VFP9_MYSQL\imagen\iconos\thumbsdown_2.ico"
		
		ON SELECTION BAR 1 OF (m.lcShortcut) m.loRef.DblClick()
		ON SELECTION BAR 2 OF (m.lcShortcut) m.loRefp.anularecibo(movitot.movicod)
		IF ALLTRIM(movitot.cbte) = "RECIBO"
			SET SKIP OF BAR 2 OF (m.lcShortcut) .F.
		ELSE
			SET SKIP OF BAR 2 OF (m.lcShortcut) .T.
		ENDIF
		ACTIVATE POPUP (m.lcShortcut)
		RELEASE POPUP (m.lcShortcut)
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text11.Click
		messagebox("TOTAL FACTURAS Y DÉBITOS"+chr(13)+ ;
				   "EN EL PERÍODO INDICADO: "+allt(TRANSFORM(this.value-thisform.auxdebe,"$ 999,999,999.99")),0+64,"Movimientos")
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text12.Click
		messagebox("TOTAL PAGOS Y CRÉDITOS"+chr(13)+ ;
		           "EN EL PERÍODO INDICADO: "+allt(TRANSFORM(this.value-thisform.auxhaber,"$ 999,999,999.99")),0+64,"Movimientos")
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.LostFocus
		thisform.command1.enabled=.T.
	ENDPROC

ENDDEFINE


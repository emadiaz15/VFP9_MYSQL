	PROCEDURE Command3.Click
		SELECT datprin
		SET SAFETY OFF
		ZAP
		SET SAFETY ON
		
		INSERT INTO datprin values(thisform.text1.Value,thisform.text2.Value, ;
								   thisform.text11.Value,thisform.text12.Value, ;
								   thisform.text10.Value,thisform.dispmov)
		
		sele movitot
		go top
		cantreg=reccount()
		report form resumendecta TO PRINTER PROMPT noconsole
	ENDPROC


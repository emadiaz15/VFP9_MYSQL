		XLSheet.Cells(9,3)="NÚMERO"
		XLSheet.Cells(9,3).font.bold=.T.
		XLSheet.Cells(9,3).font.size="11"
		XLSheet.Cells(9,3).font.name="Calibri"
		XLSheet.Cells(9,3).HorizontalAlignment=7
		XLSheet.Cells(9,4)="FECHA"
		XLSheet.Cells(9,4).font.bold=.T.
		XLSheet.Cells(9,4).font.size="11"
		XLSheet.Cells(9,4).font.name="Calibri"
		XLSheet.Cells(9,4).HorizontalAlignment=7
		XLSheet.Cells(9,5)="DEBE"
		XLSheet.Cells(9,5).font.bold=.T.
		XLSheet.Cells(9,5).font.size="11"
		XLSheet.Cells(9,5).font.name="Calibri"
		XLSheet.Cells(9,5).HorizontalAlignment=7
		XLSheet.Cells(9,6)="HABER"
		XLSheet.Cells(9,6).font.bold=.T.
		XLSheet.Cells(9,6).font.size="11"
		XLSheet.Cells(9,6).font.name="Calibri"
		XLSheet.Cells(9,6).HorizontalAlignment=7
		XLSheet.Cells(9,7)="SALDO"
		XLSheet.Cells(9,7).font.bold=.T.
		XLSheet.Cells(9,7).font.size="11"
		XLSheet.Cells(9,7).font.name="Calibri"
		XLSheet.Cells(9,7).HorizontalAlignment=7
		XLSheet.Range(XLSheet.Cells(9,2),XLSheet.Cells(9,7)).Borders.LineStyle=1
		XLSheet.Range(XLSheet.Cells(9,2),XLSheet.Cells(9,7)).Borders.Weight=3

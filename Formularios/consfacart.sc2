	PROCEDURE Destroy
		set point to
		
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE GotFocus
		set point to ","
	ENDPROC

	PROCEDURE Init
		public codigo,nombre,totcant,crecant,codicli
		set point to ","
		SET DATE BRITISH
		SET CENTURY on
		codigo=0
		codicli=0
		nombre=""
		
		CREATE CURSOR curmeses(mes N(2),ano N(4),cant N(10,3))
		
		*!*	dimension totcant[1,1]
		*!*	dimension crecant[1,1]
		*!*	totcant[1,1]=0
		*!*	crecant[1,1]=0
		this.text1.value=0
		this.text2.value=ctod("01/"+allt(str(month(date())))+"/"+allt(str(year(date()))))
		this.text4.value=date()
		this.text6.Value=0
		*!*	create cursor ventas(fac_fec D,fac_conc C(15),fac_tipo C(1),fac_pto N(4),fac_nro N(8),cli_nomb C(45),artfac_cant N(10,3),artfac_impo N(10,3),artfac_sstock C(2),movcodi N(8),condi N(8),codcli N(8))
		this.grid1.recordsource=''
		this.Refresh()
		
	ENDPROC

	PROCEDURE LostFocus
		set point to
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(215,215,215)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Check1.Click
		IF this.Value=1
			codicli=0
			thisform.text6.value=0
			thisform.combo1.value=''
			thisform.combo1.RowSource=''
			thisform.command2.click
			thisform.text1.setfocus
		ELSE
			codicli=0
			thisform.text6.SetFocus
		endif
	ENDPROC

	PROCEDURE cmd_graf.Click
		LOCAL xclr,xtitulo,xsubtitulo
		
		  #DEFINE CLR_1  Rgb(255, 255,   0)
		  #DEFINE CLR_2  Rgb(255,   0, 255)
		  #DEFINE CLR_3  Rgb(255, 255, 224)
		  #DEFINE CLR_4  Rgb(  0, 255, 255)
		  #DEFINE CLR_5  Rgb(227,  68,  34)
		  #DEFINE CLR_6  Rgb(  0, 255,   0)
		  #DEFINE CLR_7  Rgb( 62,  62,  62)
		  #DEFINE CLR_8  Rgb(128, 128,   0)
		  #DEFINE CLR_9  Rgb(192, 192, 192)
		  #DEFINE CLR_10 Rgb(128,   0,   0)
		  #DEFINE CLR_11 Rgb(  0, 128, 128)
		  #DEFINE CLR_12 Rgb(249, 197,  86)
		
		  CREATE CURSOR CURSOR_GRAFICO1 ;
		    (TEM_CFILL1 C(80), TEM_LFILL1 L, TEM_LFILL2 L, TEM_NFILL1 N(20, 4), TEM_NFILL2 N(20, 4))
		 
		  *---
		
		IF thisform.cmeses>12
			MESSAGEBOX("Usted a indicado un período de fechas superior a 12 meses, el gráfico estadístico se mostrará para los primeros 12 meses del período indicado",48,"Aviso del Sistema")
		ENDIF
		
		SELECT curmeses
		GO top
		FOR xcont=1 TO thisform.cmeses
			IF xcont>12
				EXIT
			ENDIF
			IF xcont=1
				IF curmeses.mes=thisform.primermes
					  INSERT INTO CURSOR_GRAFICO1 ;
					        (TEM_CFILL1, TEM_LFILL1, TEM_LFILL2, TEM_NFILL1, TEM_NFILL2) ;
					 VALUES (SUBSTR(Mes_Nombre(curmeses.mes),1,3)+" - "+ALLTRIM(STR(thisform.primerano)) , .F. , .F. , IIF(curmeses.cant<0,0,curmeses.cant) , CLR_1 )
				 	IF !EOF("curmeses")
						SKIP IN curmeses
					endif
				ELSE
					  INSERT INTO CURSOR_GRAFICO1 ;
					        (TEM_CFILL1, TEM_LFILL1, TEM_LFILL2, TEM_NFILL1, TEM_NFILL2) ;
					 VALUES (SUBSTR(Mes_Nombre(thisform.primermes),1,3)+" - "+ALLTRIM(STR(thisform.primerano)) , .F. , .F. , 0 , CLR_1 )
				ENDIF
			ELSE
				xclr=ICASE(xcont=2,CLR_2, ;
					       xcont=3,CLR_3, ;
					       xcont=4,CLR_4, ;
		  			       xcont=5,CLR_5, ;
					       xcont=6,CLR_6, ;
					       xcont=7,CLR_7, ;
					       xcont=8,CLR_8, ;
					       xcont=9,CLR_9, ;
					       xcont=10,CLR_10, ;
					       xcont=11,CLR_11, ;
					       xcont=12,CLR_12)
				IF curmeses.mes=thisform.primermes
					  INSERT INTO CURSOR_GRAFICO1 ;
					        (TEM_CFILL1, TEM_LFILL1, TEM_LFILL2, TEM_NFILL1, TEM_NFILL2) ;
					 VALUES (SUBSTR(Mes_Nombre(curmeses.mes),1,3)+" - "+ALLTRIM(STR(thisform.primerano)) , .F. , .F. , IIF(curmeses.cant<0,0,curmeses.cant) , xclr )
				 	IF !EOF("curmeses")
						SKIP IN curmeses
					endif
				ELSE
					  INSERT INTO CURSOR_GRAFICO1 ;
					        (TEM_CFILL1, TEM_LFILL1, TEM_LFILL2, TEM_NFILL1, TEM_NFILL2) ;
					 VALUES (SUBSTR(Mes_Nombre(thisform.primermes),1,3)+" - "+ALLTRIM(STR(thisform.primerano)) , .F. , .F. , 0 , xclr )
				ENDIF		
			ENDIF
			IF xcont<12
				thisform.primermes=thisform.primermes+1
				IF thisform.primermes>12
					thisform.primermes=1
					thisform.primerano=thisform.primerano+1
				ENDIF
			ENDIF
		NEXT xcont
		
		xtitulo    = ALLTRIM(cur_art.art_desc)
		xsubtitulo = "Cantidad Vendida en el Período Indicado"
		xmedida    = ALLTRIM(cur_art.art_med)
		
		DO FORM frm_grafico WITH xmedida,xtitulo,xsubtitulo
		
		cerrar_cursor("CURSOR_GRAFICO1")
		
		thisform.primermes=(thisform.primermes-thisform.cmeses)+1
		
	ENDPROC

	PROCEDURE cmd_graf.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_graf.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Combo1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Combo1.Destroy
		set notify on
	ENDPROC

	PROCEDURE Combo1.GotFocus
		set notify off
		
		
	ENDPROC

	PROCEDURE Combo1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					frmfacar= conectar_db(_screen.cn)
						xdesc=allt(this.list(i))
						SQLEXEC(frmfacar,"select * from clientes where TRIM(cli_nomb)=?xdesc;","cur_cli")
					desconectar_db(frmfacar)
					thisform.text6.value=cur_cli.cli_codi
					codicli=cur_cli.cli_codi
					thisform.check1.Value=0
					keyboard '{TAB}'+'{TAB}'+'{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE Combo1.LostFocus
		IF codicli>0
			thisform.command2.Click
		endif
	ENDPROC

	PROCEDURE Combo1.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade="%"+subst(allt(this.text),2,len(allt(this.text)))+"%"
				frmfacar= conectar_db(_screen.cn)
					SQLEXEC(frmfacar,"select * from clientes where cli_nomb like ?cade order by cli_nomb;","cur_cli")
				desconectar_db(frmfacar)
				IF RECCOUNT("cur_cli")>0
					this.rowsource="select cli_nomb from cur_cli INTO CURSOR combo1"
					this.value=this.list(1)
					keyboard "{F4}"
				ELSE
					MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
					this.Value=""			
				ENDIF
				RETURN .F.
			else
				if len(allt(this.text))>0
					cade=ALLTRIM(this.text)+"%"
					frmfacar= conectar_db(_screen.cn)
						SQLEXEC(frmfacar,"select * from clientes where cli_nomb like ?cade;","cur_cli")
					desconectar_db(frmfacar)
					IF RECCOUNT("cur_cli")>0
						this.rowsource="select cli_nomb from cur_cli INTO CURSOR combo1"
						this.value=this.list(1)
						keyboard "{F4}"
					ELSE
						MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
						this.Value=""				
					ENDIF
					RETURN .F.
				ENDIF
			endif
		endif
	ENDPROC

	PROCEDURE Command1.Click
		do form artload with codigo,nombre
		with thisform
			if codigo>0
				frmfacar= conectar_db(_screen.cn)
					SQLEXEC(frmfacar,"select * from articulos where art_codi=?codigo;","cur_art")
				desconectar_db(frmfacar)
				.text1.value=codigo
				.text3.value=nombre
				.text2.setfocus
			else
				.text1.setfocus
			endif
		endwith
	ENDPROC

	PROCEDURE Command1.GotFocus
		
		
			
	ENDPROC

	PROCEDURE Command2.Click
		LOCAL xcodigo,xfecdes,xfechas,xcodicli,auxfec1,auxfec2
		IF !USED("cur_art")
			MESSAGEBOX("Debe ingresar el artículo a consultar",0+48,"Aviso del Sistema")
			thisform.text1.SetFocus
			RETURN
		ENDIF
		
		thisform.grid1.RecordSource=''
		thisform.Refresh()
		
		xcodigo=thisform.text1.Value
		xfecdes=thisform.text2.Value
		xfechas=thisform.text4.Value
		
		IF xfechas<xfecdes
			MESSAGEBOX("La Fecha Hasta no puede ser anterior a la Fecha Desde",48,"Aviso del Sistema")
			KEYBOARD '{LEFTARROW}'
			RETURN
		ENDIF
		
		IF YEAR(xfechas)>YEAR(xfecdes)
			thisform.cmeses=((YEAR(xfechas) + MONTH(xfechas) / 12 - YEAR(xfecdes) - MONTH(xfecdes) / 12) * 12)
		ELSE
			thisform.cmeses=((YEAR(xfechas) + MONTH(xfechas) / 12 - YEAR(xfecdes) - MONTH(xfecdes) / 12) * 12)+1
		ENDIF
		
		thisform.primermes=MONTH(xfecdes)
		thisform.primerano=YEAR(xfecdes)
		xcodicli=codicli
		
		SET DECIMALS TO 3
		frmfacar= conectar_db(_screen.cn)
			SQLEXEC(frmfacar,"call usp_facart(1,?xcodigo,?xfecdes,?xfechas,?xcodicli);","ventas")
			SQLEXEC(frmfacar,"call usp_facart(2,?xcodigo,?xfecdes,?xfechas,?xcodicli);","totcant")
			SQLEXEC(frmfacar,"call usp_facart(3,?xcodigo,?xfecdes,?xfechas,?xcodicli);","crecant")
			IF YEAR(xfechas)>YEAR(xfecdes)
				auxfec2=CTOD("31/12/"+ALLTRIM(STR(YEAR(xfecdes))))
				SQLEXEC(frmfacar,"call usp_facart(4,?xcodigo,?xfecdes,?auxfec2,?xcodicli);","meses1")
				auxfec1=CTOD("01/01/"+ALLTRIM(STR(YEAR(xfechas))))
				SQLEXEC(frmfacar,"call usp_facart(4,?xcodigo,?auxfec1,?xfechas,?xcodicli);","meses2")
				SELECT * FROM meses1 UNION (select * FROM meses2) ORDER BY ano,mes INTO CURSOR curmeses
			else
				SQLEXEC(frmfacar,"call usp_facart(4,?xcodigo,?xfecdes,?xfechas,?xcodicli);","curmeses")
			ENDIF
		desconectar_db(frmfacar)
		SET DECIMALS TO
		*!*	SELECT ventas
		*!*	LOCATE 
		*!*	copy to "c:\users\administrador\desktop\consfacart.xls" type xl5
		*!*	LOCATE
		thisform.grid1.recordsourcetype=1
		thisform.grid1.recordsource="ventas"
		thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
		thisform.grid1.forecolor=0
		do case
			case allt(cur_art.art_med)="MT"
				thisform.text5.inputmask="999999.999"
				thisform.label5.caption="Metros"
			case allt(cur_art.art_med)="KG"
				thisform.text5.inputmask="999999.999"
				thisform.label5.caption="Kilogramos"
			case allt(cur_art.art_med)="UN"
				thisform.text5.inputmask="999999"
				thisform.label5.caption=iif(totcant.cant-crecant.cant=1,"Unidad","Unidades")
		ENDCASE
		thisform.text5.value=IIF(ISNULL(totcant.cant),0,totcant.cant)-IIF(ISNULL(crecant.cant),0,crecant.cant)
		
		IF thisform.text5.Value<>0
			thisform.cmd_graf.Enabled= .T.
		ELSE
			thisform.cmd_graf.Enabled= .F.
		ENDIF
		
		*!*	thisform.text1.setfocus
	ENDPROC


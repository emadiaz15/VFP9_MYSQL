	PROCEDURE Text1.Valid
		LOCAL xcodigo
		if this.value>0
			xcodigo=this.value
			frmfacar= conectar_db(_screen.cn)
				SQLEXEC(frmfacar,"select * from articulos where art_codi=?xcodigo;","cur_art")
			desconectar_db(frmfacar)
			if RECCOUNT("cur_art")>0
				thisform.text3.value=cur_art.art_desc
			else
				messagebox("Artículo no está en archivo",0+48,"Advertencia")
				return 0
			endif
		endif
	ENDPROC


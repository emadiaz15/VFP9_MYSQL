DEFINE CLASS altabanco AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text3" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: xopcion
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		BorderStyle = 0
		Caption = "Rutina de Alta de Bancos"
		DoCreate = .T.
		Height = 240
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "altabanco"
		ShowTips = .T.
		Width = 408
		WindowType = 1
		xopcion = .F.
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		Caption = "\<Guardar", ;
		Enabled = .F., ;
		Height = 25, ;
		Left = 199, ;
		Name = "Command1", ;
		TabIndex = 4, ;
		Top = 137, ;
		Width = 75
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command2' AS commandbutton WITH ;
		Cancel = .T., ;
		Caption = "\<Cancelar", ;
		Height = 25, ;
		Left = 149, ;
		Name = "Command2", ;
		TabIndex = 6, ;
		Top = 195, ;
		Width = 122
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command3' AS commandbutton WITH ;
		AutoSize = .T., ;
		Caption = "\<Agregar Sucursal", ;
		Enabled = .F., ;
		Height = 27, ;
		Left = 286, ;
		Name = "Command3", ;
		TabIndex = 5, ;
		Top = 135, ;
		Width = 113
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		Caption = "BANCO: ", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 27, ;
		Name = "Label1", ;
		TabIndex = 7, ;
		Top = 90, ;
		Width = 49
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label2' AS label WITH ;
		AutoSize = .T., ;
		Caption = "CUIT: ", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 27, ;
		Name = "Label2", ;
		TabIndex = 8, ;
		Top = 144, ;
		Width = 34
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label3' AS label WITH ;
		AutoSize = .T., ;
		Caption = "CÓDIGO:", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 27, ;
		Name = "Label3", ;
		TabIndex = 9, ;
		Top = 36, ;
		Width = 50
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Text1' AS textbox WITH ;
		Format = "!K", ;
		Height = 23, ;
		Left = 81, ;
		Name = "Text1", ;
		TabIndex = 2, ;
		Top = 85, ;
		Width = 304
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text2' AS textbox WITH ;
		Alignment = 1, ;
		Format = "RK", ;
		Height = 23, ;
		InputMask = "99-99999999-9", ;
		Left = 81, ;
		Name = "Text2", ;
		TabIndex = 3, ;
		Top = 138, ;
		Width = 105
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text3' AS textbox WITH ;
		Format = "KL", ;
		Height = 23, ;
		InputMask = "99999999", ;
		Left = 81, ;
		Name = "Text3", ;
		TabIndex = 1, ;
		Top = 32, ;
		Width = 100
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		parameter codiban,codisuc,xopcion
		
		thisform.xopcion=xopcion
		
		this.text3.value=codiban
		
		IF thisform.xopcion=2
			thisform.command3.Visible=.F.
		ENDIF
	ENDPROC

	PROCEDURE Unload
		return codiban
		return codisuc
	ENDPROC

	PROCEDURE Command1.Click
		if thisform.text3.value>0 and len(allt(thisform.text1.value))>0
			LOCAL xbann,xcuit
			codiban=thisform.text3.value
			xbann=allt(thisform.text1.value)
			xcuit=val(thisform.text2.value)
			frmaltaban= conectar_db(_screen.cn)
				SQLEXEC(frmaltaban,"insert into bancos values(?codiban,?xbann,?xcuit);")
			desconectar_db(frmaltaban)
			thisform.setall("style",1,"Textbox")
			this.enabled=.F.
			IF thisform.xopcion=2
				thisform.Release
			ENDIF
			thisform.command3.enabled=.T.
			thisform.command3.setfocus
		endif
		
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.Click
		do form altasuc with codiban,codisuc
		thisform.release
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.LostFocus
		if thisform.text3.value>0 and len(allt(this.value))>0
			thisform.command1.enabled=.T.
		endif
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.LostFocus
		thisform.command1.enabled=.T.
	ENDPROC

	PROCEDURE Text3.Valid
		if this.value>0
			frmaltaban= conectar_db(_screen.cn)
				SQLEXEC(frmaltaban,"select * from bancos where ban_codi=?this.value;","cur_ban")
			desconectar_db(frmaltaban)
			if RECCOUNT("cur_ban")>0
				messagebox("Banco ya está en archivo, se encontró "+allt(cur_ban.ban_desc)+", imposible ingresar este código de banco.",0+48,"Advertencia")
				this.Value=0
				return 0
			endif
		endif
	ENDPROC

ENDDEFINE


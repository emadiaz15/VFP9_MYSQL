	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		LOCAL xcrc,xcar
		
		thisform.txt_fecha.Value=DATE()
		SET DECIMALS TO 3
		frmcostos= conectar_db(_screen.cn)
			SQLEXEC(frmcostos,"call usp_totcostos(1);","cur_costini")
		desconectar_db(frmcostos)
		SET DATABASE TO
		LOCATE
		SELECT * FROM cur_costini INTO CURSOR cur_costos readwrite
		
		IF RECCOUNT("cur_costos")>0
			SELECT COUNT(art_codi) as cant FROM cur_costos WHERE lista=1 INTO CURSOR cur_conlis
			IF cur_conlis.cant>0 then
				thisform.shp_lista.Visible= .T.
				thisform.lbl_lista.Visible= .T.
			ENDIF
			GO TOP IN cur_costos
			SELECT COUNT(art_codi) as cantidad FROM cur_costos WHERE cotiz=1 INTO CURSOR cur_cont
			IF cur_cont.cantidad>0 then
				thisform.chk_filtro.Visible= .T.
			ENDIF
			SELECT cur_costos
			LOCATE
			
			thisform.mostrardatos()
		ENDIF
	ENDPROC

	PROCEDURE mostrardatos
		
		SELECT DISTINCT rub_codi,rub_desc FROM cur_costos ORDER BY rub_codi INTO CURSOR cur_rub
		
		if RECCOUNT("cur_rub")>0
			thisform.label3.Caption=ALLTRIM(STR(RECCOUNT("cur_rub"))+" RUBROS LISTADOS")
			locate
			thisform.lst_rubros.RowSource="cur_rub"
			xcrc = cur_rub.rub_codi
			frmcostos= conectar_db(_screen.cn)
				SQLEXEC(frmcostos,"call usp_provxrub(?xcrc);","cur_provrub")
			desconectar_db(frmcostos)
			GO TOP IN cur_provrub
			thisform.cmb_prov.RowSource="cur_provrub"
			thisform.grd_articulos.RecordSource=''
			thisform.grd_articulos.Refresh
			SELECT cur_rub
			locate
			xcrc=cur_rub.rub_codi
			SELECT DISTINCT art_codi,art_desc,.F. as estado ;
					FROM cur_costos WHERE rub_codi=xcrc ORDER BY art_codi INTO CURSOR cur_selar readwrite
			IF RECCOUNT("cur_selar")>0
				LOCATE
				xcar=cur_selar.art_codi
				thisform.grd_artrub.RecordSource="cur_selar"
				thisform.grd_artrub.SetAll("DynamicBackColor","iif(cur_selar.estado=.T.,RGB(166,255,166),RGB(255,255,255))","Column")
				thisform.grd_artrub.SetAll("DynamicFontBold","iif(cur_selar.estado=.T.,.T.,.F.)","Column")
				SELECT DISTINCT prov_nomb,artpro_costo,artpro_ctovta,moneda,cotiz,prov_codi,artpro_codi,lista ;
						FROM cur_costos WHERE art_codi=xcar ORDER BY artpro_costo READWRITE INTO CURSOR cur_arcos
				if RECCOUNT("cur_arcos")>0
					LOCATE
					thisform.grd_articulos.RecordSource="cur_arcos"
					thisform.grd_articulos.SetAll("DynamicBackColor","thisform.obtenercolor(cur_arcos.lista)","Column")
					thisform.grd_articulos.SetAll("DynamicForeColor","thisform.ncolorfila(cur_arcos.cotiz)","Column")
					thisform.grd_articulos.SetAll("DynamicFontBold","thisform.nnegrita(cur_arcos.cotiz)","Column")
					thisform.grd_articulos.COLUMN4.DynamicBackColor = 'RGB(250,190,90)'
				ENDIF
				GO TOP IN cur_selar
				thisform.lst_rubros.Selected(1)=.T.
			ENDIF
		ENDIF
		thisform.txt_buscar.SetFocus
	ENDPROC

	PROCEDURE ncolorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = 1
					lnColor = RGB(255,0,0)
				CASE tnsel = 0
					lnColor = RGB(0,0,0)
			ENDCASE
		Return(lnColor)
	ENDPROC

	PROCEDURE nnegrita
		LParameters tnsel
		
		Local lnBold
		
			DO case
				CASE tnsel = 1
					lnBold = .T.
				CASE tnsel = 0
					lnBold = .F.
			ENDCASE
		Return(lnBold)
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF tnNregis = 1
				lnColor = RGB(144,238,144)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Btn_buscar021.img_buscar.Click
		LOCAL xcrc,xcar
		
		IF RECCOUNT("cur_costos")>0
			xcadena="%"+ALLTRIM(thisform.txt_buscar.value)+"%"
			thisform.lst_rubros.RowSource=''
			thisform.lst_rubros.Refresh
		
			SELECT DISTINCT rub_codi,rub_desc FROM cur_costos ;
				WHERE ALLTRIM(STR(rub_codi))+ALLTRIM(rub_desc) like ALLTRIM(xcadena) ;
				ORDER BY rub_codi INTO CURSOR cur_rub
			if RECCOUNT("cur_rub")>0
				locate
				thisform.lst_rubros.RowSource="cur_rub"
				thisform.grd_articulos.RecordSource=''
				thisform.grd_articulos.Refresh
				thisform.grd_artrub.RecordSource=''
				thisform.grd_artrub.Refresh		
				SELECT cur_rub
				locate
				xcrc=cur_rub.rub_codi
				SELECT DISTINCT art_codi,art_desc,.F. as estado ;
						FROM cur_costos WHERE rub_codi=xcrc ORDER BY art_codi INTO CURSOR cur_selar readwrite
				IF RECCOUNT("cur_selar")>0
					thisform.grd_artrub.RecordSource=''
					thisform.grd_artrub.Refresh
					LOCATE
					xcar=cur_selar.art_codi
					thisform.grd_artrub.RecordSource="cur_selar"
					thisform.grd_artrub.SetAll("DynamicBackColor","iif(cur_selar.estado=.T.RGB(166,255,166),RGB(255,255,255))","Column")
					thisform.grd_artrub.SetAll("DynamicFontBold","iif(cur_selar.estado=.T.,.T.,.F.)","Column")
					SELECT DISTINCT prov_nomb,artpro_costo,artpro_ctovta,moneda,cotiz,prov_codi,artpro_codi,lista ;
							FROM cur_costos WHERE art_codi=xcar ORDER BY artpro_costo INTO CURSOR cur_arcos
					if RECCOUNT("cur_arcos")>0
						locate
						thisform.grd_articulos.RecordSource="cur_arcos"
						thisform.grd_articulos.SetAll("DynamicBackColor","thisform.obtenercolor(cur_arcos.lista)","Column")
						thisform.grd_articulos.SetAll("DynamicForeColor","thisform.ncolorfila(cur_arcos.cotiz)","Column")
						thisform.grd_articulos.SetAll("DynamicFontBold","thisform.nnegrita(cur_arcos.cotiz)","Column")
						thisform.grd_articulos.COLUMN4.DynamicBackColor = 'RGB(250,190,90)'				
					ENDIF
					GO TOP IN cur_selar
					thisform.lst_rubros.Selected(1)=.T.
				ENDIF
			ELSE
				thisform.grd_artrub.RecordSource=''
				thisform.grd_artrub.Refresh
				thisform.grd_articulos.RecordSource=''
				thisform.grd_articulos.Refresh
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Btn_buscar022.img_buscar.Click
		LOCAL xcrc,xcar,xaux
		
		IF RECCOUNT("cur_selar")>0
			xcadena="%"+ALLTRIM(thisform.txt_loadar.value)+"%"
			thisform.grd_artrub.RecordSource=''
			thisform.grd_artrub.Refresh
			thisform.grd_articulos.RecordSource=''
			thisform.grd_articulos.Refresh
			xcrc=cur_rub.rub_codi
			
			SELECT DISTINCT art_codi,art_desc,.F. as estado FROM cur_costos ;
				WHERE ALLTRIM(STR(art_codi))+ALLTRIM(art_desc) like ALLTRIM(xcadena) ;
				AND rub_codi=xcrc ORDER BY art_codi INTO CURSOR cur_selar readwrite
			IF RECCOUNT("cur_selar")>0
				thisform.grd_artrub.RecordSource=''
				thisform.grd_artrub.Refresh
				LOCATE
				xcar=cur_selar.art_codi
				thisform.grd_artrub.RecordSource="cur_selar"
				thisform.grd_artrub.SetAll("DynamicBackColor","iif(cur_selar.estado=.T.,RGB(166,255,166),RGB(255,255,255))","Column")
				thisform.grd_artrub.SetAll("DynamicFontBold","iif(cur_selar.estado=.T.,.T.,.F.)","Column")
				SELECT DISTINCT prov_nomb,artpro_costo,artpro_ctovta,moneda,cotiz,prov_codi,artpro_codi ;
						FROM cur_costos WHERE art_codi=xcar ORDER BY artpro_costo INTO CURSOR cur_arcos
				if RECCOUNT("cur_arcos")>0
					locate
					thisform.grd_articulos.RecordSource="cur_arcos"
					thisform.grd_articulos.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
					thisform.grd_articulos.SetAll("DynamicForeColor","thisform.ncolorfila(cur_arcos.cotiz)","Column")
					thisform.grd_articulos.SetAll("DynamicFontBold","thisform.nnegrita(cur_arcos.cotiz)","Column")
					thisform.grd_articulos.COLUMN4.DynamicBackColor = 'RGB(250,190,90)'			
				ENDIF
				GO TOP IN cur_selar
				thisform.grd_artrub.SetFocus
			ELSE
				thisform.lst_rubros.Click
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE chk_filtro.Click
		LOCAL xfilter as Boolean
		xfilter=.F.
		
		IF thisform.estadosave=1
			pregc=MESSAGEBOX("Hay cambios sin guardar para no perderlos, antes de aplicar el filtro, debe guardar las modificaciones."+CHR(13)+ ;
							 "Si elige NO perderá todas las modificaciones efectuadas hasta el momento."+CHR(13)+CHR(13)+ ;
							 "¿Desea guardar ahora?",3+48+512,"Aviso del Sistema")
			DO case
			    CASE pregc=2
			    	this.Value=0
			    	xfilter=.F.
			    CASE pregc=6
			    	thisform.estadosave=0
			    	thisform.cmd_guardar.Click()
			    	xfilter=.T.
		     	CASE pregc=7
		     		xfilter=.T.
		     ENDCASE
		ELSE
			xfilter=.T.
		ENDIF
		
		IF xfilter=.T. then
			thisform.txt_buscar.Value=''
			thisform.txt_loadar.Value=''
			IF LEN(ALLTRIM(thisform.txt_buscar.value))>0
				thisform.txt_buscar.Value=''
			ENDIF
			cerrar_cursor("cur_costos")
			IF this.Value=1 then
				SET DECIMALS TO 3
				frmcostos= conectar_db(_screen.cn)
					SQLEXEC(frmcostos,"call usp_totcostos(2);","cur_costini")
				desconectar_db(frmcostos)
				SET DATABASE TO
			ELSE
				SET DECIMALS TO 3
				frmcostos= conectar_db(_screen.cn)
					SQLEXEC(frmcostos,"call usp_totcostos(1);","cur_costini")
				desconectar_db(frmcostos)
				SET DATABASE TO
			ENDIF
			LOCATE
			SELECT * FROM cur_costini INTO CURSOR cur_costos readwrite
		
			IF RECCOUNT("cur_costos")>0
			thisform.lst_rubros.RowSource=''
			thisform.grd_articulos.RecordSource=''
			thisform.grd_artrub.RecordSource=''
			thisform.lst_rubros.Refresh
			thisform.grd_articulos.Refresh
			thisform.grd_artrub.Refresh
			cerrar_cursor("cur_rub")
			
			thisform.mostrardatos()
		
			ENDIF	
		ENDIF
		
	ENDPROC

	PROCEDURE cmb_prov.Click
		thisform.cmd_apliprov.Enabled= .T.
		
	ENDPROC

	PROCEDURE cmd_apliprov.Click
		UPDATE cur_selar SET estado=.F.
		UPDATE cur_arcos SET cotiz=0
		
		xcrc=cur_rub.rub_codi
		xpro=cur_provrub.prov_codi
		
		UPDATE cur_costos SET cotiz=0,estado=1 WHERE cotiz=1 AND rub_codi=xcrc
		
		select art_codi from cur_costos where rub_codi=xcrc and prov_codi=xpro ;
			ORDER BY art_codi INTO CURSOR cur_delpro
		
		SELECT distinct art_codi,art_desc FROM cur_costos WHERE rub_codi=xcrc AND art_codi NOT in ;
				(select * from cur_delpro) INTO CURSOR cur_noestan
		
		UPDATE cur_arcos  SET cotiz=1 WHERE prov_codi=xpro
		
		UPDATE cur_costos SET cotiz=1,estado=1 WHERE prov_codi=xpro AND rub_codi=xcrc
		
		thisform.estadosave=1
		
		UPDATE cur_selar SET estado=.T. WHERE art_codi in (select art_codi from cur_noestan)
		
		SELECT COUNT(art_codi) FROM cur_selar WHERE estado=.T. INTO ARRAY mat_art
		
		IF mat_art[1,1]>0
			MESSAGEBOX("Hay artículos de este rubro que no tienen costo de "+ALLTRIM(thisform.cmb_prov.Value)+"."+CHR(13)+CHR(13)+ ;
					   "Seleccione cada artículo resaltado en la lista de Artículos y configure el costo de otro Proveedor." ;
					   ,48,"Aviso del Sistema")
		ENDIF
		
		GO TOP IN cur_selar
		
		thisform.cmb_prov.Value=''
		thisform.cmd_guardar.Enabled= .T.
		thisform.cmd_guarsal.Enabled= .T.
		
	ENDPROC

	PROCEDURE cmd_apliprov.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_apliprov.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_guardar.Click
		LOCAL xsave,xcotiz,xartproc
		
		IF thisform.estadosave=1
			xsave= MESSAGEBOX("¿Confirma los datos modificadios?",4+32+256,"Aviso del Sistema")
		ELSE
			xsave=6
			thisform.estadosave=0	
		ENDIF
		
		IF xsave=6 then
		
			SELECT * FROM cur_costos WHERE estado=1 INTO CURSOR auxcos
			
			SELECT auxcos
			LOCATE
			SCAN
				xartproc= auxcos.artpro_codi
				xcotiz  = auxcos.cotiz
				frmcostos= conectar_db(_screen.cn)
					SQLEXEC(frmcostos,"update articulos_proveedores set cotiz=?xcotiz where artpro_codi=?xartproc;")
				desconectar_db(frmcostos)
			ENDSCAN
			MESSAGEBOX("Los datos fueron guardados exitosamente",64,"Aviso del Sistema")
			this.Enabled= .F.
			thisform.cmd_guarsal.Enabled= .F.
			thisform.estadosave=0
			cerrar_cursor("auxcos")
		
			cerrar_cursor("cur_costos")
			IF thisform.chk_filtro.Value=1 then
				SET DECIMALS TO 3
				frmcostos= conectar_db(_screen.cn)
					SQLEXEC(frmcostos,"call usp_totcostos(2);","cur_costini")
				desconectar_db(frmcostos)
				SET DATABASE TO
			ELSE
				SET DECIMALS TO 3
				frmcostos= conectar_db(_screen.cn)
					SQLEXEC(frmcostos,"call usp_totcostos(1);","cur_costini")
				desconectar_db(frmcostos)
				SET DATABASE TO
			ENDIF
			LOCATE
			SELECT * FROM cur_costini INTO CURSOR cur_costos readwrite
			
			thisform.lst_rubros.RowSource=''
			thisform.grd_articulos.RecordSource=''
			thisform.grd_artrub.RecordSource=''
			thisform.lst_rubros.Refresh
			thisform.grd_articulos.Refresh
			thisform.grd_artrub.Refresh
				
			thisform.mostrardatos()
			
			frmcostos= conectar_db(_screen.cn)
				SQLEXEC(frmcostos,"SELECT CAST(COUNT(art_codi) as decimal) as cantidad FROM articulos_proveedores WHERE cotiz=1;","cur_cont")
			desconectar_db(frmcostos)
			
			IF cur_cont.cantidad>0 then
				thisform.chk_filtro.Visible= .T.
			ELSE
				thisform.chk_filtro.Visible= .F.
				thisform.chk_filtro.Value=0
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_guardar.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE cmd_guardar.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_guarsal.Click
		LOCAL xcotiz,xartproc
		
		xsave= MESSAGEBOX("¿Confirma los datos modificadios?",4+48+256,"Aviso del Sistema")
		
		IF xsave=6 then
		
			SELECT * FROM cur_costos WHERE estado=1 INTO CURSOR auxcos
		
			SELECT auxcos
			LOCATE
			SCAN
				xartproc= auxcos.artpro_codi
				xcotiz  = auxcos.cotiz
				frmcostos= conectar_db(_screen.cn)
					SQLEXEC(frmcostos,"update articulos_proveedores set cotiz=?xcotiz where artpro_codi=?xartproc;")
				desconectar_db(frmcostos)
			ENDSCAN
			MESSAGEBOX("Los datos fueron guardados exitosamente",64,"Aviso del Sistema")
			thisform.Release
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_guarsal.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_guarsal.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_salir.Click
		IF thisform.estadosave=1
			prego=MESSAGEBOX("Hay cambios sin guardar, ¿Desea guardar antes de salir?",3+48+512,"Aviso del Sistema")
			DO case
				CASE prego=6
					thisform.cmd_guardar.Click()
					thisform.Release
				CASE prego=2
					RETURN
			OTHERWISE
				thisform.Release
			ENDCASE
		ELSE
			thisform.Release
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Ctn_banner1.Init
		this.Height=79
		this.left=0
		this.Width=this.Parent.Width
		
	ENDPROC

	PROCEDURE grd_articulos.Column4.Check1.Click
		LOCAL xantar,xpos
		xpos=RECNO("cur_arcos")
		
		SELECT artpro_codi FROM cur_arcos WHERE cotiz=1 INTO cursor cur_xantar
		IF RECCOUNT("cur_xantar")>0
			xantar=cur_xantar.artpro_codi
			UPDATE cur_costos SET cotiz=0,estado=1 WHERE artpro_codi=xantar
		ELSE
			xantar=0
		ENDIF
		cerrar_cursor("cur_xantar")
		
		IF this.Value=1
			SELECT cur_arcos
			GOTO xpos
		
			xarpro=cur_arcos.artpro_codi
			xcprov=cur_arcos.prov_codi
			
			UPDATE cur_costos SET cotiz=1,estado=1 WHERE artpro_codi=xarpro
			
			UPDATE cur_arcos SET cotiz=0 WHERE prov_codi<>xcprov
			
			GOTO xpos
			xcar=cur_selar.art_codi
			UPDATE cur_selar SET estado=.F. WHERE art_codi=xcar
		ELSE
			xcar=cur_selar.art_codi
			UPDATE cur_costos SET cotiz=0,estado=1 WHERE art_codi=cur_selar.art_codi
			thisform.grd_articulos.ForeColor=RGB(0,0,0)
		ENDIF
		thisform.estadosave=1
		thisform.cmd_guardar.Enabled= .T.
		thisform.cmd_guarsal.Enabled= .T.
		SELECT cur_selar
		LOCATE FOR art_codi=xcar
		thisform.grd_artrub.SetFocus
		
		
	ENDPROC

	PROCEDURE grd_artrub.Click
		LOCAL xcar
		
		IF RECCOUNT("cur_selar")>0
			thisform.grd_articulos.RecordSource=''
			thisform.grd_articulos.Refresh
			xcar=cur_selar.art_codi
			SELECT DISTINCT prov_nomb,artpro_costo,artpro_ctovta,moneda,cotiz,prov_codi,artpro_codi,lista ;
					FROM cur_costos WHERE art_codi=xcar ORDER BY artpro_costo READWRITE INTO CURSOR cur_arcos
			if RECCOUNT("cur_arcos")>0
				LOCATE
				thisform.grd_articulos.RecordSource="cur_arcos"
				thisform.grd_articulos.SetAll("DynamicBackColor","thisform.obtenercolor(cur_arcos.lista)","Column")
				thisform.grd_articulos.SetAll("DynamicForeColor","thisform.ncolorfila(cur_arcos.cotiz)","Column")
				thisform.grd_articulos.COLUMN4.DynamicBackColor = 'RGB(250,190,90)'
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE grd_artrub.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF INLIST(nKeyCode,5,24)
			LOCAL xcar,xcantr
			xcantr= RECCOUNT("cur_selar")
			DO case
				CASE nKeyCode=5
					SKIP -1 IN cur_selar
					**thisform.grd_artrub.DoScroll(2)
				CASE nKeyCode=24
		*			IF xcantr > 21
						*thisform.grd_artrub.DoScroll(3)
					*ENDIF
					SKIP IN cur_selar
					IF EOF()
						SKIP -1 IN cur_selar
					ENDIF
			ENDCASE
			IF RECCOUNT("cur_selar")>0
				thisform.grd_articulos.RecordSource=''
				thisform.grd_articulos.Refresh
				xcar=cur_selar.art_codi
				SELECT DISTINCT prov_nomb,artpro_costo,artpro_ctovta,moneda,cotiz,prov_codi,artpro_codi,lista ;
						FROM cur_costos WHERE art_codi=xcar ORDER BY artpro_costo READWRITE INTO CURSOR cur_arcos
				if RECCOUNT("cur_arcos")>0
					LOCATE
					thisform.grd_articulos.RecordSource="cur_arcos"
					thisform.grd_articulos.SetAll("DynamicBackColor","thisform.obtenercolor(cur_arcos.lista)","Column")
					thisform.grd_articulos.SetAll("DynamicForeColor","thisform.ncolorfila(cur_arcos.cotiz)","Column")
					thisform.grd_articulos.SetAll("DynamicFontBold","thisform.nnegrita(cur_arcos.cotiz)","Column")
					thisform.grd_articulos.COLUMN4.DynamicBackColor = 'RGB(250,190,90)'
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE lst_rubros.Click
		LOCAL xcrc,xcar
		
		IF RECCOUNT("cur_costos")>0
			thisform.cmd_apliprov.Enabled= .F.
			thisform.cmb_prov.RowSource=''
			xcrc=cur_rub.rub_codi
			frmcostos= conectar_db(_screen.cn)
				SQLEXEC(frmcostos,"call usp_provxrub(?xcrc);","cur_provrub")
			desconectar_db(frmcostos)
			GO TOP IN cur_provrub
			thisform.cmb_prov.RowSource="cur_provrub"
			thisform.grd_articulos.RecordSource=''
			thisform.grd_articulos.Refresh
			thisform.grd_artrub.RecordSource=''
			thisform.grd_artrub.Refresh	
			SELECT DISTINCT art_codi,art_desc,.F. as estado ;
				FROM cur_costos WHERE rub_codi=xcrc ORDER BY art_codi INTO CURSOR cur_selar readwrite
			IF RECCOUNT("cur_selar")>0
				LOCATE
				xcar=cur_selar.art_codi
				thisform.grd_artrub.RecordSource="cur_selar"
				thisform.grd_artrub.SetAll("DynamicBackColor","iif(cur_selar.estado=.T.,RGB(166,255,166),RGB(255,255,255))","Column")
				thisform.grd_artrub.SetAll("DynamicFontBold","iif(cur_selar.estado=.T.,.T.,.F.)","Column")
				SELECT DISTINCT prov_nomb,artpro_costo,artpro_ctovta,moneda,cotiz,prov_codi,artpro_codi,lista ;
						FROM cur_costos WHERE art_codi=xcar ORDER BY artpro_costo READWRITE INTO CURSOR cur_arcos
				if RECCOUNT("cur_arcos")>0
					LOCATE
					thisform.grd_articulos.RecordSource="cur_arcos"
					thisform.grd_articulos.SetAll("DynamicBackColor","thisform.obtenercolor(cur_arcos.lista)","Column")
					thisform.grd_articulos.SetAll("DynamicForeColor","thisform.ncolorfila(cur_arcos.cotiz)","Column")
					thisform.grd_articulos.SetAll("DynamicFontBold","thisform.nnegrita(cur_arcos.cotiz)","Column")
					thisform.grd_articulos.COLUMN4.DynamicBackColor = 'RGB(250,190,90)'
				ENDIF
				GO TOP IN cur_selar
				thisform.grd_artrub.SetFocus
				this.SetFocus
			endif
		ENDIF
	ENDPROC

	PROCEDURE txt_buscar.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE txt_buscar.GotFocus
		this.BackColor= RGB(255,238,194)
		this.ForeColor= RGB(0,0,0)
		this.BorderColor= RGB(255,149,0)
	ENDPROC

	PROCEDURE txt_buscar.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode=13 then
			thisform.btn_buscar021.img_buscar.Click
		ENDIF
		
	ENDPROC

	PROCEDURE txt_buscar.LostFocus
		this.BackColor= RGB(124,136,151)
		this.ForeColor= RGB(255,255,0)
		this.BorderColor= RGB(141,178,227)
	ENDPROC

	PROCEDURE txt_loadar.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE txt_loadar.GotFocus
		this.BackColor= RGB(255,238,194)
		this.ForeColor= RGB(0,0,0)
		this.BorderColor= RGB(255,149,0)
	ENDPROC

	PROCEDURE txt_loadar.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode=13 then
			thisform.btn_buscar022.img_buscar.Click
		ENDIF
		
	ENDPROC

	PROCEDURE txt_loadar.LostFocus
		this.BackColor= RGB(124,136,151)
		this.ForeColor= RGB(255,255,0)
		this.BorderColor= RGB(141,178,227)
	ENDPROC

ENDDEFINE


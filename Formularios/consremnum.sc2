		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command3.Click
		remi=messagebox("¿Imprime Remito?",1+48,"Advertencia")
		if remi=1
			cade=repl("0",4-len(allt(str(thisform.text10.value))))+allt(str(thisform.text10.value))+" - "+repl("0",8-len(allt(str(thisform.text7.value))))+allt(str(thisform.text7.value))
			prremi=messagebox("Asegurese que los formularios correspondientes al Remito Nº: "+cade+" estén en la impresora y luego haga clic en Aceptar",1+48,"Advertencia")
			if prremi=1	
				DIMENSION tra[2,5]
				store "" to tra[1,1],tra[1,2],tra[1,5],tra[2,1],tra[2,2],tra[2,5],tra[1,3],tra[1,4],tra[2,3],tra[2,4]
				do case
					case thisform.opcionflete1.value=1
						flete1=1
					case thisform.opcionflete1.value=2
						flete1=2
				endcase
				do case
					case thisform.opcionflete2.value=1
						flete2=1
					case thisform.opcionflete2.value=2
						flete2=2
				endcase
				SELECT cur_remtra
				IF RECCOUNT()>0
					GO top
					tra[1,1]=allt(tran_nomb)
					tra[1,2]=allt(tran_domi)
					tra[1,3]=tran_cartel
					tra[1,4]=tran_tel1
					tra[1,5]=allt(thisform.edit3.value)
					IF RECCOUNT()=2
						skip
						tra[2,1]=allt(tran_nomb)
						tra[2,2]=allt(tran_domi)
						tra[2,3]=tran_cartel
						tra[2,4]=tran_tel1
						tra[2,5]=allt(thisform.edit4.value)
					endif
				ENDIF
				SELECT cur_remart
				GO TOP
				for n=1 to 3
					do case
						case n=1
							comprobante="ORIGINAL"
						case n=2
							comprobante="DUPLICADO"
						case n=3
							comprobante="TRIPLICADO"
					endcase
					do case
						case codicli>0
							set point to ","
							report form remito for cur_remart.rem_codi=thisform.xcodirem TO PRINTER prompt noconsole
							set point to
						case codiprov>0
							set point to ","
							report form remitoprov for cur_remart.rem_codi=thisform.xcodirem to printer prompt noconsole
							set point to
					endcase
				next n
			endif
		endif
	ENDPROC


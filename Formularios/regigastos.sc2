	PROCEDURE Init
		public codigo,nombre,codicli,coditipag,numero,banco,plaza,fechavto,valor,totval,cond, ;
		       valoriva,borra,impotot,contador,codrec,codiper,valoraux,x,acu,paso,nalo,codiva
		create cursor creditos(fac_codi N(8),cre_imp N(10,2))
		create cursor fac(fac_codi N(8),fac_nro N(8),fac_fec D,imp_pag N(10,2),fac_conc C(1))
		create cursor cheq(movtippag_nro C(10))
		codicli=0
		coditipag=0
		numero=""
		banco=""
		plaza=""
		fechavto=ctod("  /  /    ")
		valor=0
		totval=0
		codigo=0
		nombre=""
		x=0
		acu=0
		paso=0
		codiper=0
		this.text1.value=date()
		this.text2.value=0
		this.text3.value=0
		this.text15.value=0
		this.text4.value=0
		this.text5.value=0
		this.text6.value=0
		this.text7.value=0
		this.text9.value=0
		this.text12.value=0
		frmgastos= conectar_db(_screen.cn)
			SQLEXEC(frmgastos,"select * from iva order by iva_codi desc limit 1;","cur_iva")
		desconectar_db(frmgastos)
		IF RECCOUNT("cur_iva")>0
			codiva=cur_iva.iva_codi
			valoriva=cur_iva.iva_1
		ENDIF
		
		
	ENDPROC

	PROCEDURE Check1.Click
		with thisform
			if .text10.value>0
				.text10.value=0
				.text6.value=0
				.text5.value=.text7.value-.text12.value-.text3.value
			endif
		endwith
	ENDPROC

	PROCEDURE Command1.Click
		thisform.text2.value=0
		thisform.label2.caption=""
		do form gasload with codigo,nombre
		thisform.text9.setfocus
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		pregunta=messagebox("¿Seguro que desea salir?",4+48+256,"Advertencia")
		if pregunta=6
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		with thisform
			.height=430
			.autocenter=.T.
			valor=.text7.value
			impotot=valor
			do while totval<.text7.value
				do form datospagogas with coditipag,numero,banco,plaza,fechavto,valor,totval,impotot
				if coditipag=0
					thisform.command2.click()
					exit
				endif
				if coditipag=3
					insert into cheq(movtippag_nro) values(allt(numero))
				endif
		*!*			sele tipospago
		*!*			set order to tippag_cod
		*!*			seek coditipag
				.olecontrol1.additem(allt(subst(cur_tipp.tippag_desc,1,13))+chr(9)+allt(numero)+chr(9)+allt(banco)+chr(9)+allt(plaza)+chr(9)+dtoc(fechavto)+chr(9)+allt(str(valor,10,2)))
			enddo
			if totval=.text7.value
				.command4.enabled=.T.
				this.enabled=.F.
			endif
		endwith
		
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		if codiper>0
			if thisform.check1.value=1
				frmgastos= conectar_db(_screen.cn)
					SQLEXEC(frmgastos,"update personas set cond_codi=5 where per_codi=?codiper;")
				desconectar_db(frmgastos)
			endif
		endif
		pregunta=messagebox("¿Confirma los datos ingresados?",4+32+256,"Registro de Gastos")
		if pregunta=6
			WITH thisform
				LOCAL xfecha,xtipgas,xobser,xpto,xcbte,xtipc, ;
					  xpiva,xbtos,ximpag,xconc, ;
					  ximpo,xng,xiva,xnc
				STORE 0 TO xtipgas,xpto,xcbte,xpiva,xpbtos, ;
						   ximpag,ximpo,xng,xiva,xnc
				STORE '' TO xobser,xtipc,xconc
		
				xfecha=.text1.value
				xpto=.text15.value
				xcbte=.text4.value
				xtipc=allt(.text11.value)
				ximpo=.text5.value
				xtipgas=.text2.value
				xpiva=.text12.value
				xiva=.text6.value
				ximpag=.text7.value
				if .check2.value=1
					xnc=1
					xconc='N'
				ELSE
					xnc=0
					xconc='F'
				endif
				if .text3.value>0
					xng=.text3.value
				ENDIF
				frmgastos= conectar_db(_screen.cn)
					SQLEXEC(frmgastos,"call usp_guardargas(?xfecha,?codiper,?xtipgas,'',0,?xpto,?xcbte,?xtipc,0,?codiva,?xpiva,?xbtos,?ximpag,'S',?xconc,0,?ximpo,?xng,?xiva,?xnc);","cur_ngas")
					
					for i=1 to .olecontrol1.rows-1
						.olecontrol1.row=i
						.olecontrol1.col=0
						SQLEXEC(frmgastos, "select MAX(gaspag_codi) as gaspag_codi from gastos_pagos order by gaspag_codi;","cur_ngp")
						IF ISNULL(cur_ngp.gaspag_codi)
							c=1
						else
							c=cur_ngp.gaspag_codi+1
						endif
						.olecontrol1.col=5
						SQLEXEC(frmgastos,"insert into gastos_pagos values(?c,?cur_ngas.ncodi,1,'',0,'',NULL,?ConverNro(.olecontrol1.text),0);")
					next i
				desconectar_db(frmgastos)
				.label16.visible=.F.
			endwith
		endif
		with thisform
			if acu=>.text9.value
				.olecontrol1.rows=1
				.text2.value=0
				.text3.value=0
				.text15.value=0
				.text4.value=0
				.text5.value=0
				.text6.value=0
				.text7.value=0
				.text9.value=0
				.text10.value=0
				.text12.value=0
				.label2.caption=""
				frmgastos= conectar_db(_screen.cn)
					SQLEXEC(frmgastos,"select * from iva order by iva_codi desc limit 1;","cur_iva")
				desconectar_db(frmgastos)
				IF RECCOUNT("cur_iva")>0
					codiva=cur_iva.iva_codi
					valoriva=cur_iva.iva_1
				ENDIF
				.text1.value=date()
				.text1.setfocus
				.height=306
				totval=0
				.check1.value=0
				.check2.value=0
				acu=0
			else
				.olecontrol1.rows=1
				x=x+1
		*		.text4.value=allt(.text4.value)
				.label16.caption="/"+allt(str(x))
				.label16.visible=.T.
				.text7.value=.text9.value-.text7.value
				.text5.value=round(.text7.value/round((valoriva/100)+1,4),2)
				.text6.value=round((.text5.value*.text10.value)/100,2)
				.text3.value=0
				.text12.value=0
				.text10.setfocus
				.height=306
				totval=0
				.text10.setfocus
			endif	
		endwith
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command5.Click
		acu=acu+thisform.text7.value
		codiper=0
		do form perselec with codiper
		if codiper>0
			thisform.text8.value=cur_per.per_desc
			thisform.text13.value=VAL(cur_per.per_cuit)
			if cur_per.cond_codi=5
				thisform.check1.value=1
				if thisform.text10.value>0
					thisform.text10.value=0
					thisform.text6.value=0
					thisform.text5.value=thisform.text7.value-thisform.text12.value-thisform.text3.value
				endif
			endif
			thisform.text11.setfocus
		else
			=messagebox("Recuerde Localizar el Proveedor del Servicio"+chr(13)+ ;
						"de lo contrario no podra finalizar el registro del gasto.",0+48,"Advertencia")
		endif
	ENDPROC

	PROCEDURE Command5.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command5.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Olecontrol1.Click
		*** ActiveX Control Event ***
		thisform.command4.enabled=.F.
		if this.rows>1
			this.col=0
			sele tipospago
			set order to tippag_des
			seek allt(this.text)
			coditipag=tippag_codi	
			this.col=1
			numero=allt(this.text)
			this.col=2
			banco=allt(this.text)
			this.col=3
			plaza=allt(this.text)
			this.col=4
			fechavto=ctod(this.text)
			this.col=5
			valor=ConverNro(this.text)
			totval=totval-valor
			do form pagopreg with coditipag,numero,banco,plaza,fechavto,valor,totval,impotot
		endif
		if paso=1
			this.col=0
			sele tipospago
			set order to tippag_cod
			seek coditipag
			this.text=allt(subst(tippag_desc,1,13))
			this.col=1
			this.text=allt(numero)
			this.col=2
			this.text=allt(banco)
			this.col=3
			this.text=allt(plaza)
			this.col=4
			this.text=dtoc(fechavto)
			this.col=5
			this.text=allt(str(valor,10,2))
		endif
		if borra=6
			this.col=5
			totval=totval-ConverNro(this.text)
			this.removeitem(this.row)
			thisform.command3.click()
		endif
		if paso=1 or borra=6
			paso=0
			borra=0
			do while totval<thisform.text7.value
				do form datospago with coditipag,numero,banco,plaza,fechavto,valor,totval,impotot
				if coditipag=0
					thisform.command1.click()
					exit
				endif
				sele tipospago
				set order to tippag_cod
				seek coditipag
				thisform.olecontrol1.additem(allt(subst(tippag_desc,1,13))+chr(9)+allt(numero)+chr(9)+allt(banco)+chr(9)+allt(plaza)+chr(9)+dtoc(fechavto)+chr(9)+allt(str(valor,10,2)))
			enddo
			if totval=thisform.text7.value
				thisform.command4.enabled=.T.
			endif
		endif
		
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.Valid
		frmgastos= conectar_db(_screen.cn)
			SQLEXEC(frmgastos,"select * from parametros where param_desc='ULTCIERCOM';","cur_param")
		desconectar_db(frmgastos)
		IF RECCOUNT("cur_param")>0
			if this.value<=cur_param.param_fec and this.value<>ctod("  /  /    ")
				=messagebox("Ultima fecha de cierre de Iva Compras "+dtoc(cur_param.param_fec)+chr(13)+;
							"Imposible ingresar el gasto con esta fecha",0+48,"Advertencia!")
				this.value=ctod("  /  /    ")
				return 0
			endif
		endif
	ENDPROC

	PROCEDURE Text10.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text10.LostFocus
		if this.value<>valoriva
			with thisform
				if this.value=0
					.text7.value=.text9.value
					.text6.value=0
					.text3.value=0
					.text5.value=.text9.value
					valoriva=0
				else
					*.text5.value=round((.text7.value-.text3.value-.text12.value)/round(((this.value/100)+1),3),2)
					.text6.value=(.text5.value*this.value)/100
					.text7.value=.text5.value+.text6.value+.text3.value+.text12.value
				endif
			endwith
		endif
		thisform.command3.enabled=.T.
		thisform.text3.setfocus
	ENDPROC

	PROCEDURE Text11.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text12.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text12.LostFocus
		if this.value>0
			with thisform
		*		.text5.value=round((.text7.value-.text3.value-this.value)/round(((.text10.value/100)+1),4),2)
		*		.text6.value=round((.text5.value*.text10.value)/100,2)
				.text7.value=.text5.value+.text6.value+.text3.value+this.value
				.command3.enabled=.T.
			endwith
		endif
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.LostFocus
		with thisform
			if this.value>0
				frmgastos= conectar_db(_screen.cn)
					SQLEXEC(frmgastos,"select * from tiposgastos where tipgas_codi=?this.value;","cur_gaslo")
				desconectar_db(frmgastos)
				IF RECCOUNT("cur_gaslo")>0
					.label2.caption=allt(cur_gaslo.tipgas_desc)
				else
					messagebox("Tipo de Gasto no está en Archivo",0+48,"Gastos")
					this.value=0
					.label2.caption=""
					this.setfocus
				endif
			endif
		endwith
	ENDPROC

	PROCEDURE Text3.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text3.LostFocus
		if this.value>0
			with thisform
		*		.text5.value=round((.text7.value-this.value-.text12.value)/round(((.text10.value/100)+1),4),2)
		*		.text6.value=round((.text5.value*.text10.value)/100,2)
				.text7.value=.text5.value+.text6.value+this.value+.text12.value
			endwith
		endif
	ENDPROC

	PROCEDURE Text4.Valid
		IF this.Value>0
			xcadebus=ALLTRIM(STR(codiper))+ALLTRIM(thisform.text11.Value)+ALLTRIM(STR(thisform.text15.Value))+ALLTRIM(STR(this.Value))
			frmgastos= conectar_db(_screen.cn)
				SQLEXEC(frmgastos,"select * from gastos where CONCAT(TRIM(CAST(per_codi as char)),TRIM(gas_tipcbte),TRIM(CAST(gas_pto as char)),TRIM(CAST(gas_cbte as char)))=?xcadebus;","cur_gexis")
			desconectar_db(frmgastos)
			IF RECCOUNT("cur_gexis")>0
				MESSAGEBOX("Factura ya está en archivo con fecha "+ALLTRIM(DTOC(cur_gexis.gas_fech))+". Verfique.",0+48,"Aviso del Sistema")
				this.Value=0
				RETURN 0
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Text5.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text5.LostFocus
		with thisform
			if this.value<>valoraux
		*		.text9.value=this.value*round((valoriva/100)+1,4)
				valoraux=this.value
				.text6.value=round((this.value*.text10.value)/100,2)
				.text7.value=this.value+.text6.value+.text3.value+.text12.value
		*!*		else
		*!*			.text6.value=round((this.value*.text10.value)/100,2)
			endif
		*	.text7.value=this.value+.text6.value+.text3.value
		endwith
	ENDPROC

	PROCEDURE Text9.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text9.LostFocus
		with thisform
			.text7.value=this.value
			.text5.value=round(this.value/round(((valoriva/100)+1),4),2)
			valoraux=.text5.value
			.text6.value=round((.text5.value*valoriva)/100,2)
			.text10.value=valoriva
		endwith
	ENDPROC

ENDDEFINE

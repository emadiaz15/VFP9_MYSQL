		Top = 117, ;
		Width = 100
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		public muestro
		this.text1.value=0
		this.text3.value=0
	ENDPROC

	PROCEDURE Command1.Click
		codigo=0
		thisform.text1.value=0
		do form artload with codigo
		if codigo>0
			frmaltast= conectar_db(_screen.cn)
				SQLEXEC(frmaltast,"select cast(count(*) as decimal(15,3)) cant from histostock where art_codi = ?codigo;","cur_movi")
			desconectar_db(frmaltast)
			with thisform
				IF cur_movi.cant > 0
					MESSAGEBOX("Este artículo ya tiene stock inicial asignado.",48,"Aviso del Sistema")
					.text1.value=0
					.text2.Value=''
					.text3.value=0
					KEYBOARD '{TAB}'+'{TAB}'
				ELSE	
					.text1.value=cur_art.art_codi
					.text2.value=cur_art.art_desc
					.text3.value=cur_art.art_stock
					.label5.caption=ALLTRIM(cur_art.art_med)
				ENDIF
			endwith
		endif
		thisform.text3.setfocus
		
	ENDPROC

	PROCEDURE Command1.GotFocus
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		if thisform.text1.value>0
			frmaltast= conectar_db(_screen.cn)
				SQLEXEC(frmaltast,"update articulos set art_stock=?thisform.text3.value where art_codi=?thisform.text1.value;")
				SQLEXEC(frmaltast,"insert into histostock values(null,?thisform.text1.value,current_date(),current_time(),'E',0,0,0,'STOCK INICIAL','',0,0,0,0,0,0,0);")
			desconectar_db(frmaltast)
			***************** SE CONECTA AL SERVIDOR ILUMET Y SI EXISTE ARTICULO CARGA STOCK INICIAL Y REGISTRO EN HISTÓRICO *******
			conexterna= conectar_db(_screen.xconext)
			IF VARTYPE(conexterna) = "N" AND conexterna> 0
				SQLEXEC(conexterna,"update articulos set art_stock=?thisform.text3.value where art_codi=?thisform.text1.value;")
				SQLEXEC(conexterna,"insert into histostock values(null,?thisform.text1.value,current_date(),current_time(),'E',0,0,0,'STOCK INICIAL','',0,0,0,0,0,0,0);")
				desconectar_db(conexterna)
			ENDIF
			*********************************** FIN PROCESO SERVIDOR ILUMET ***********************************************
			thisform.text1.value=0
			thisform.text2.value=''
			thisform.text3.value=0
			thisform.text1.setfocus
		endif
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		thisform.release
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF LASTKEY()=13
			if this.value>0
				frmaltast= conectar_db(_screen.cn)
					SQLEXEC(frmaltast,"select cast(count(*) as decimal(15,3)) cant from histostock where art_codi = ?this.value;","cur_movi")
					SQLEXEC(frmaltast,"select * from articulos where art_codi=?this.value;","cur_art")
				desconectar_db(frmaltast)
				if RECCOUNT("cur_art")>0
					if cur_art.art_codi>5
						with thisform
							IF cur_movi.cant > 0
								MESSAGEBOX("Este artículo ya tiene stock inicial asignado.",48,"Aviso del Sistema")
								NODEFAULT
								this.Value=0
								.text2.value=''
								.text3.value=0
								this.Click()
							ELSE
								.text1.value=cur_art.art_codi
								.text2.value=cur_art.art_desc
								.text3.value=cur_art.art_stock
								.label5.caption=ALLTRIM(cur_art.art_med)
							ENDIF
						endwith
					endif
				else
					messagebox("Artículo no está en archivo",0+48,"Aviso del Sistema")
					thisform.text2.Value=''
					thisform.text3.value=0
					this.value=0
					NODEFAULT
					this.Click()
				endif
			endif
		ENDIF
		
	ENDPROC

	PROCEDURE Text3.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text3.Valid
		IF this.Value>0
			thisform.command3.Enabled= .T.
		ELSE
			thisform.command3.Enabled= .F.
		ENDIF
		
			
	ENDPROC

ENDDEFINE

	PROCEDURE Init
		PARAMETERS xcodipag
		
		SET NOTIFY off
		
		IF xcodipag = 0
			STORE 0 TO thisform.txt_cbtes.Value,thisform.txt_dtosaf.Value,thisform.txt_subt.value, ;
					   thisform.txt_dtopag.value,thisform.txt_totpag.value, ;
					   thisform.txt_antic.value,thisform.txt_npag.value
		
		else
			thisform.txt_npag.value= xcodipag
			STORE 0 TO thisform.txt_cbtes.Value,thisform.txt_dtosaf.Value,thisform.txt_subt.value, ;
				   thisform.txt_dtopag.value,thisform.txt_totpag.Value,thisform.txt_antic.Value
			LOCAL pnro
			pnro=xcodipag
			frmnpag= conectar_db(_screen.cn)
				SQLEXEC(frmnpag,"select a.*,b.prov_nomb,b.cond_codi from pagosprov a inner join proveedores b on a.prov_codi = b.prov_codi where a.pag_codi = ?pnro;","cur_paganu")
			desconectar_db(frmnpag)
			thisform.txt_prov.Value   =ALLTRIM(STR(cur_paganu.prov_codi))+" - "+ALLTRIM(cur_paganu.prov_nomb)
			thisform.codipag          =cur_paganu.pag_codi
			thisform.cond             =cur_paganu.cond_codi
			thisform.xcodiprov        =cur_paganu.prov_codi
			thisform.txt_fecha.Value  =cur_paganu.pag_fech
			thisform.txt_cbtes.Value  =cur_paganu.pag_impo+cur_paganu.pag_dtosaf
			thisform.txt_dtosaf.Value =cur_paganu.pag_dtosaf
			thisform.txt_subt.Value   =cur_paganu.pag_impo
			thisform.txt_dtopag.Value =cur_paganu.pag_dtoxpag
			thisform.txt_totpag.Value =cur_paganu.pag_impo-cur_paganu.pag_dtoxpag
			thisform.txt_antic.Value  =cur_paganu.pag_antic
					
			thisform.verocultar(.T.)
			thisform.txt_npag.Style= 1
			
			thisform.btn_cont.Enabled= .T.
		*!*		KEYBOARD '{TAB}'
		ENDIF
		
	ENDPROC

	PROCEDURE verocultar
		LPARAMETERS xboolsel
		
		
		STORE xboolsel TO thisform.lbl_fec.Visible, ;
					      thisform.txt_fecha.Visible, ;
					      thisform.lbl_cbtes.Visible, ;
					      thisform.txt_cbtes.Visible, ;
					      thisform.lbl_dtosaf.Visible, ;
					      thisform.txt_dtosaf.Visible, ;
					      thisform.lbl_subt.Visible, ;
					      thisform.txt_subt.Visible, ;
					      thisform.lbl_dtopag.Visible, ;
					      thisform.txt_dtopag.Visible, ;
		 		          thisform.lbl_totpag.Visible, ;
		 		          thisform.txt_totpag.Visible, ;
		 		          thisform.lbl_antic.Visible, ;
		 		          thisform.txt_antic.Visible, ;
		 		          thisform.line3.Visible, ;
					      thisform.btn_verpag.Visible
	ENDPROC

	PROCEDURE btn_cancel.Click
		
		thisform.Release
		
	ENDPROC

	PROCEDURE btn_cancel.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE btn_cancel.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE btn_cont.Click
		pranu=MESSAGEBOX("¿Confirma anular la Orden de Pago?",4+48,"Aviso del Sistema")
		
		IF pranu=6
			frmnpag= conectar_db(_screen.cn)
				SQLEXEC(frmnpag,"update proveedores set prov_saldo = prov_saldo + ?thisform.txt_cbtes.value where prov_codi = ?thisform.xcodiprov;")
				SQLEXEC(frmnpag,"update proveedores set prov_afvor = prov_afvor + ?thisform.txt_dtosaf.value where prov_codi = ?thisform.xcodiprov;")
				SQLEXEC(frmnpag,"update proveedores set prov_afvor = prov_afvor - ?thisform.txt_antic.value where prov_codi = ?thisform.xcodiprov;")
				SQLEXEC(frmnpag,"select * from pagosprov_debintc where pag_codi = ?thisform.codipag;","cur_deb")
				SQLEXEC(frmnpag,"select * from pagosprov_creintc where pag_codi = ?thisform.codipag;","cur_cre")
				SQLEXEC(frmnpag,"select * from pagosprov_recepciones where pag_codi = ?thisform.codipag;","cur_arep")
				SQLEXEC(frmnpag,"select * from pagosprov_pagos where pag_codi = ?thisform.codipag;","cur_ppag")
			desconectar_db(frmnpag)
			
			IF RECCOUNT("cur_deb") > 0
				LOCAL xdbc, ximpdb
				xdbc=0
				ximpdb=0
				SELECT cur_deb
				LOCATE
				SCAN
					xdbc=cur_deb.debc_codi
					ximpdb=cur_deb.pagdebi_imp
					frmnpag= conectar_db(_screen.cn)
						SQLEXEC(frmnpag,"update debintc set debc_impag = debc_impag - ?ximpdb,pagado = '' where debc_codi = ?xdbc;")
					desconectar_db(frmnpag)
					SELECT cur_deb
				ENDSCAN
				cerrar_cursor("cur_deb")
			ENDIF
		
			IF RECCOUNT("cur_cre") > 0
				LOCAL xcrc, ximpcr
				xcrc=0
				ximpcr=0
				SELECT cur_cre
				LOCATE
				SCAN
					xcrc=cur_cre.crec_codi
					ximpcr=cur_cre.pagcrei_imp
					frmnpag= conectar_db(_screen.cn)
						SQLEXEC(frmnpag,"update creintc set crec_impag = crec_impag - ?ximpcr,pagado = '' where crec_codi = ?xcrc;")
					desconectar_db(frmnpag)
					SELECT cur_deb
				ENDSCAN
				cerrar_cursor("cur_cre")
			ENDIF
		
			IF RECCOUNT("cur_arep") > 0
				LOCAL xdbr, ximpr
				xdbr=0
				ximpr=0
				SELECT cur_arep
				LOCATE
				SCAN
					xdbr=cur_arep.recep_codi
					ximpr=IIF(cur_arep.pagrecep_impo<0,ABS(cur_arep.pagrecep_impo),cur_arep.pagrecep_impo)
					frmnpag= conectar_db(_screen.cn)
						SQLEXEC(frmnpag,"update recepciones set imp_pag = imp_pag - ?ximpr,pagado = '' where recep_codi = ?xdbr;")
					desconectar_db(frmnpag)
					SELECT cur_arep
				ENDSCAN
				cerrar_cursor("cur_arep")
			ENDIF
			
			IF RECCOUNT("cur_ppag") > 0
				GO TOP IN cur_ppag
				SELECT COUNT(*) cant from cur_ppag where recpag_codi > 0 and pag_codi = thisform.codipag INTO ARRAY ar_rp
				IF TYPE("ar_rp") = "N"
					IF ar_rp[1] > 0
						frmnpag= conectar_db(_screen.cn)
							SQLEXEC(frmnpag,"update recibos_pagos set pag_codi = 0 where pag_codi = ?thisform.codipag;")
						desconectar_db(frmnpag)				
					ENDIF
				ENDIF
			ENDIF
			
			frmnpag= conectar_db(_screen.cn)
				SQLEXEC(frmnpag,"delete from pagosprov where pag_codi = ?thisform.codipag;")
				SQLEXEC(frmnpag,"delete from pagosprov_recepciones where pag_codi = ?thisform.codipag;")
				SQLEXEC(frmnpag,"delete from pagosprov_debintc where pag_codi = ?thisform.codipag;")
				SQLEXEC(frmnpag,"delete from pagosprov_creintc where pag_codi = ?thisform.codipag;")
				SQLEXEC(frmnpag,"delete from pagosprov_pagos where pag_codi = ?thisform.codipag;")
			desconectar_db(frmnpag)	
			
			MESSAGEBOX("Orden de Pago anulada exitosamente",64,"Aviso del Sistema")
			thisform.Release
		ENDIF
	ENDPROC

	PROCEDURE btn_cont.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord

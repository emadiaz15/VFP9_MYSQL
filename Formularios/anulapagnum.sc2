	ENDPROC

	PROCEDURE btn_verpag.btn.Click
		LOCAL xcodipag,xcond
		
		paspago  = 1
		xcodipag = thisform.codipag
		xcond    = thisform.cond
		
		frmnpag= conectar_db(_screen.cn)
			SQLEXEC(frmnpag,"call usp_buscarprov(?cur_paganu.prov_codi);","cur_prov")
		desconectar_db(frmnpag)
		
		do form conspago WITH xcodipag,xcond
	ENDPROC

	PROCEDURE btn_verpag.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE btn_verpag.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE btn_verpag.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE txt_npag.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE txt_npag.Valid
		IF this.Value>0 AND LASTKEY()=13
			STORE 0 TO thisform.txt_cbtes.Value,thisform.txt_dtosaf.Value,thisform.txt_subt.value, ;
					   thisform.txt_dtopag.value,thisform.txt_totpag.Value,thisform.txt_antic.Value
			LOCAL pnro
			pnro=this.Value
			frmnpag= conectar_db(_screen.cn)
				SQLEXEC(frmnpag,"select a.*,b.prov_nomb,b.cond_codi from pagosprov a inner join proveedores b on a.prov_codi = b.prov_codi where a.pag_codi = ?pnro;","cur_paganu")
			desconectar_db(frmnpag)
			IF RECCOUNT("cur_paganu")>0
				thisform.txt_prov.Value   =ALLTRIM(STR(cur_paganu.prov_codi))+" - "+ALLTRIM(cur_paganu.prov_nomb)
				thisform.codipag          =cur_paganu.pag_codi
				thisform.cond             =cur_paganu.cond_codi
				thisform.xcodiprov        =cur_paganu.prov_codi
				thisform.txt_fecha.Value  =cur_paganu.pag_fech
				thisform.txt_cbtes.Value  =cur_paganu.pag_impo+cur_paganu.pag_dtosaf
				thisform.txt_dtosaf.Value =cur_paganu.pag_dtosaf
				thisform.txt_subt.Value   =cur_paganu.pag_impo
				thisform.txt_dtopag.Value =cur_paganu.pag_dtoxpag
				thisform.txt_totpag.Value =cur_paganu.pag_impo-cur_paganu.pag_dtoxpag
				thisform.txt_antic.Value  =cur_paganu.pag_antic
						
				thisform.verocultar(.T.)
				
				thisform.btn_cont.Enabled= .T.
				KEYBOARD '{TAB}'
			ELSE
				MESSAGEBOX("Comprobante no se encuentra en archivo.",0+48,"Aviso del Sistema")
				thisform.btn_cont.Enabled= .F.
				
				thisform.verocultar(.F.)
				
				this.Value=0
				return .F.
			ENDIF
		ENDIF
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="1" />

	*<PropValue>
		DataSource = .NULL.
		Height = 0
		Left = 0
		Name = "Dataenvironment"
		Top = 0
		Width = 0
	*</PropValue>

ENDDEFINE

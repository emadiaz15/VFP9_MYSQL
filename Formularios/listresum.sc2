	PROCEDURE Destroy
		set point to
		set separator to
	ENDPROC

	PROCEDURE GotFocus
		set point to ","
		set separator to "."
	ENDPROC

	PROCEDURE Init
		*!*	clear memo
		LOCAL vendn
		set date british
		set cent on
		set dele on
		set point to ","
		set separator to "."
		saldoant=0
		cantreg=0
		zona=0
		
		vendn=UPPER(substr(sys(0),ATC("#",sys(0))+2))
		frmlstres= conectar_db(_screen.cn)
			SQLEXEC(frmlstres,"select * from vendedores where TRIM(ven_nomb)=?vendn;","cur_vend")
		desconectar_db(frmlstres)
		
		if RECCOUNT("cur_vend")>0
			ven=cur_vend.ven_codi
		else
			ven=0
		endif
		if ven>0
			this.list1.rowsourcetype=2
			frmlstres= conectar_db(_screen.cn)
				SQLEXEC(frmlstres,"select zona_desc,zona_codi from zonas where ven_codi=?ven order by zona_codi;","zon")
			desconectar_db(frmlstres)
			this.list1.rowsource="zon"
		else
			this.list1.rowsourcetype=2
			frmlstres= conectar_db(_screen.cn)
				SQLEXEC(frmlstres,"select zona_desc,zona_codi from zonas order by zona_codi;","zon")
			desconectar_db(frmlstres)
			this.list1.rowsource="zon"
		endif
		this.text1.value=CTOD("01"+"/"+ALLTRIM(STR(MONTH(DATE())))+"/"+ALLTRIM(STR(YEAR(DATE()))))
		this.text2.value=date()
		create cursor clienteszona(cli_codi N(8),cli_nomb C(45))
		create cursor saldos(cli_codi N(8),nombre C(45),carac N(5),tel N(11), cli_saldo N(10,2))
		create cursor movcli(pto_vta N(4),nro_cbte N(8),tipmov_codi N(8),fac_codi N(8),rec_codi N(8),reg_codi N(8),debv_codi N(8),sini_cod N(8),mov_fech D,mov_impo N(10,2),cli_codi N(8),reg_conc C(1),sini_sal N(10,2))
		
		*!*	create cursor siv(ven_imp N(10,2))
		*!*	create cursor ventas(ven_imp N(10,2))
		*!*	create cursor notascred(cre_imp N(10,2))
		*!*	create cursor pagos(pag_imp N(10,2))
		*!*	create cursor regul(reg_imp N(10,2))
		*!*	create cursor debint(debin_imp N(10,2))
		*!*	create cursor detacta(mov_codi N(8),mov_fech D,tipmov_codi N(8),fac_codi N(8),rec_codi N(8),reg_codi N(8),sini_cod N(8),pto_vta N(4),nro_cbte N(8),mov_impo N(10,2),reg_conc C(1),sini_sal N(10,2))
		*!*	create cursor veriffac(mov_codi N(8),mov_fech D,tipmov_codi N(8),fac_codi N(8),rec_codi N(8),reg_codi N(8),sini_cod N(8),pto_vta N(4),nro_cbte N(8),mov_impo N(10,2),reg_conc C(1),sini_sal N(10,2))
		*!*	create cursor verifcre(mov_codi N(8),mov_fech D,tipmov_codi N(8),fac_codi N(8),rec_codi N(8),reg_codi N(8),sini_cod N(8),pto_vta N(4),nro_cbte N(8),mov_impo N(10,2),reg_conc C(1),sini_sal N(10,2))
		*!*	create cursor verifdeb(mov_codi N(8),mov_fech D,tipmov_codi N(8),fac_codi N(8),rec_codi N(8),reg_codi N(8),sini_cod N(8),pto_vta N(4),nro_cbte N(8),mov_impo N(10,2),reg_conc C(1),sini_sal N(10,2))
		*!*	create cursor verifrec(mov_codi N(8),mov_fech D,tipmov_codi N(8),fac_codi N(8),rec_codi N(8),reg_codi N(8),sini_cod N(8),pto_vta N(4),nro_cbte N(8),mov_impo N(10,2),reg_conc C(1),sini_sal N(10,2))
		*!*	create cursor verifregul(mov_codi N(8),mov_fech D,tipmov_codi N(8),fac_codi N(8),rec_codi N(8),reg_codi N(8),sini_cod N(8),pto_vta N(4),nro_cbte N(8),mov_impo N(10,2),reg_conc C(1),sini_sal N(10,2))
		*!*	create cursor verifsiv(mov_codi N(8),mov_fech D,tipmov_codi N(8),fac_codi N(8),rec_codi N(8),reg_codi N(8),sini_cod N(8),pto_vta N(4),nro_cbte N(8),mov_impo N(10,2),reg_conc C(1),sini_sal N(10,2))
		*!*	create cursor verifregul(mov_codi N(8),mov_fech D,tipmov_codi N(8),fac_codi N(8),rec_codi N(8),reg_codi N(8),sini_cod N(8),pto_vta N(4),nro_cbte N(8),mov_impo N(10,2),reg_conc C(1),sini_sal N(10,2))
	ENDPROC

	PROCEDURE LostFocus
		set point to
		set separator to
	ENDPROC

	PROCEDURE Command3.Click
		local detallar,xopcion,xcodicli,xfecdes,xfechas
		set talk off
		with thisform
			wait wind "Procesando listado...Esta operación puede tardar...Aguarde por favor..." nowait
			frmlstres= conectar_db(_screen.cn)
				SQLEXEC(frmlstres,"select cli_codi,cli_nomb,cli_cartel,cli_tel1 from clientes where cli_saldo<>0 and zona_codi=?zona;","clienteszona")
			desconectar_db(frmlstres)
			go top
			
			xfecdes=.text1.value
			xfechas=.text2.value	
			do while !eof()
			   	xcodicli=cli_codi
				frmctacli= conectar_db(_screen.cn)
					xopcion=1
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","siv")
					sum sini_imp to si
					xopcion=2
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","ventas")
					sum ven_imp to vta
					xopcion=3
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","notascred")
					sum cre_imp to ncred
					xopcion=4
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","pagos")
					sum pag_imp to pag
					xopcion=5
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","regul")
					sum regul.reg_imp for regul.reg_conc="D" to regdebe
					sum regul.reg_imp for regul.reg_conc="H" to reghaber
					xopcion=12
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","debint")
					sum debin_imp to di
					 
					saldo=round(si+vta+di-ncred-pag+regdebe-reghaber,2) 
					xopcion=6
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifsiv")
					xopcion=7
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","veriffac")
					xopcion=8
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifcre")
					xopcion=9
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifdeb")
			 		xopcion=10
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifrec")
					xopcion=11
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifregul")
					xopcion=13
					SQLEXEC(frmctacli,"call usp_ctaclizona(?xopcion,?xcodicli,?xfecdes,?xfechas);","verifdebint")			
				desconectar_db(frmctacli)
				select * from veriffac union (select * from verifsiv) union ;
					(select * from verifcre) union ;
					(select * from verifdeb) union ;
					(select * from verifrec) union ;
					(select * from verifregul) union ;
				    (select * from verifdebint) into cursor detacta
		
				sele detacta
				do case
					case reccount()=0 and saldo<>0
						sele movcli
						appe blank
						repla tipmov_codi with 0
						repla cli_codi with xcodicli
					case reccount()>0
						go top
						do while !eof()
							sele movcli
							appe blank
							repla tipmov_codi with detacta.tipmov_codi
							repla fac_codi with detacta.fac_codi
							repla rec_codi with detacta.rec_codi
							repla reg_codi with detacta.reg_codi
							REPLACE debv_codi WITH detacta.debv_codi
							repla sini_cod with detacta.sini_cod
							repla mov_fech with detacta.mov_fech
							repla mov_impo with detacta.mov_impo
							REPLACE pto_vta WITH detacta.pto_vta
							REPLACE nro_cbte WITH detacta.nro_cbte
							REPLACE reg_conc WITH detacta.reg_conc
							REPLACE sini_sal WITH detacta.sini_sal
							repla cli_codi with xcodicli
							sele detacta
							skip
						enddo
				endcase
				sele saldos
				appe blank
				repla cli_codi with xcodicli
				repla cli_saldo with saldo
				REPLACE nombre with clienteszona.cli_nomb
				REPLACE carac WITH VAL(clienteszona.cli_cartel)
				REPLACE tel WITH VAL(clienteszona.cli_tel1)
				sele clienteszona      
				skip
			enddo
			this.enabled=.F.
			.command3.enabled=.T.
			sele saldos
			set safety off
			index on cli_codi to SYS(2015)
			set safety on
			GO top
			sele movcli
			set rela to cli_codi into saldos addi
			set safety off
			index on str(cli_codi)+dtos(mov_fech) to SYS(2015)
			set safety on
			go top
			if reccount()=0
				messagebox("No hay movimientos de ningún Cliente de la Zona "+allt(str(zona))+" en el período indicado como así tampoco saldos anteriores a la fecha Desde.",0+48,"Resumenes")
			else		
				report form resumenxzona TO PRINTER PROMPT noconsole
				.release
			endif
		endwith
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		thisform.release
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE List1.Click
		sele zon
		for i=1 to this.listcount
			if this.selected(i)
				zona=val(this.value)
			endif
		next i
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

ENDDEFINE

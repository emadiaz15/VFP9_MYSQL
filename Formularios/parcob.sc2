DEFINE CLASS parcob AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Shape2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command2" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: xpoint
		*p: xsepar
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		BackColor = 226,226,226
		Caption = "Comprobantes"
		Closable = .F.
		DoCreate = .T.
		Height = 226
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "parcob"
		Width = 410
		WindowType = 1
		xpoint = .F.
		xsepar = .F.
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Aceptar", ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 215, ;
		Name = "Command1", ;
		TabIndex = 2, ;
		Themes = .F., ;
		Top = 144, ;
		Width = 113
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command2' AS commandbutton WITH ;
		BackColor = 227,68,34, ;
		Caption = "\<Cancelar", ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 81, ;
		Name = "Command2", ;
		TabIndex = 3, ;
		Themes = .F., ;
		Top = 144, ;
		Width = 113
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 226,226,226, ;
		BackStyle = 0, ;
		Caption = "A COBRAR:", ;
		FontBold = .T., ;
		FontSize = 13, ;
		Height = 22, ;
		Left = 72, ;
		Name = "Label1", ;
		TabIndex = 4, ;
		Top = 89, ;
		Width = 96
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackStyle = 0, ;
		Height = 175, ;
		Left = 26, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;
		Top = 24, ;
		Width = 360
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape2' AS shape WITH ;
		BackStyle = 0, ;
		Height = 181, ;
		Left = 23, ;
		Name = "Shape2", ;
		SpecialEffect = 0, ;
		Top = 21, ;
		Width = 365
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Text1' AS textbox WITH ;
		Alignment = 1, ;
		ControlSource = "", ;
		FontSize = 12, ;
		Format = "K", ;
		Height = 30, ;
		InputMask = "$ ###,###,###.##", ;
		Left = 179, ;
		Name = "Text1", ;
		TabIndex = 1, ;
		Top = 81, ;
		Width = 145
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		*!*	SET POINT TO &thisform.xpoint
		*!*	SET SEPARATOR TO &thisform.xsepar
	ENDPROC

	PROCEDURE Init
		parameter impcbte
		
		*!*	thisform.xpoint = SYS(2001,"point")
		*!*	thisform.xsepar = SYS(2001,"separator")
		
		SET POINT TO "."
		SET SEPARATOR TO ","
		
		this.text1.value=impcbte
	ENDPROC

	PROCEDURE Unload
		*!*	set point to ","
		IF impcbte>0
			return impcbte
		ENDIF
		
	ENDPROC

	PROCEDURE Command1.Click
		impcbte=thisform.text1.value
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		impcbte=0
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Shape2.Click
		thisform.release
	ENDPROC

	PROCEDURE Text1.Valid
		if impcbte>0
		do case
			case this.value>impcbte
				=messagebox("No se puede ingresar un valor superior al del comprobante",0+48,"Comprobantes")
				this.value=impcbte
				return 0
			case this.value<0
				=messagebox("No se puede ingresar un valor negativo",0+48,"Comprobantes")
				this.value=impcbte
				return 0
		endcase
		endif
			
	ENDPROC

ENDDEFINE

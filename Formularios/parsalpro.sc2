DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BorderStyle = 0
		Caption = "Saldo a Favor"
		DoCreate = .T.
		Height = 105
		Icon = imagen\litening.ico
		MaxButton = .F.
		Name = "Form1"
		ShowWindow = 1
		Width = 324
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		Caption = "\<Aceptar", ;
		Height = 25, ;
		Left = 119, ;
		Name = "Command1", ;
		TabIndex = 3, ;
		Top = 69, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		Caption = "Saldo a favor a descontar: ", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 17, ;
		Name = "Label1", ;
		TabIndex = 1, ;
		Top = 34, ;
		Width = 153
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Text1' AS textbox WITH ;
		Alignment = 1, ;
		Format = "K", ;
		Height = 23, ;
		InputMask = "$ #######.##", ;
		Left = 173, ;
		Name = "Text1", ;
		TabIndex = 2, ;
		Top = 30, ;
		Width = 100
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		favor=this.text1.value
	ENDPROC

	PROCEDURE Init
		parameter favor
		set point to "."
		this.text1.value=favor
		
	ENDPROC

	PROCEDURE Unload
		return favor
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			favor=.text1.value
			set point to
			.release
		endwith
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.LostFocus
		do case
			case this.value>favor
				this.value=favor
			case this.value<=0
				this.value=1
		endcase
	ENDPROC

ENDDEFINE

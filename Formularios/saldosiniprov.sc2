		Caption = ("SALDO INICIAL AL "+dtoc(date())+":"), ;
		FontBold = .T., ;
		FontSize = 12, ;
		Height = 22, ;
		Left = 157, ;
		Name = "Label2", ;
		TabIndex = 8, ;
		Top = 138, ;
		Width = 234
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label3' AS label WITH ;
		AutoSize = .F., ;
		BackColor = 243,243,243, ;
		Caption = "FECHA:", ;
		FontBold = .T., ;
		FontSize = 12, ;
		Height = 22, ;
		Left = 507, ;
		Name = "Label3", ;
		TabIndex = 9, ;

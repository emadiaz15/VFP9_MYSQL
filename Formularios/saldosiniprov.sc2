		Top = 13, ;
		Width = 53
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Text1' AS textbox WITH ;
		Format = "K", ;
		Height = 23, ;
		Left = 92, ;
		Name = "Text1", ;
		TabIndex = 1, ;
		Top = 22, ;
		Width = 60
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text2' AS textbox WITH ;
		Alignment = 1, ;
		FontSize = 12, ;
		Format = "K", ;
		Height = 26, ;
		InputMask = "$ #######.##", ;
		Left = 392, ;
		Name = "Text2", ;
		TabIndex = 4, ;
		Top = 132, ;
		Width = 138
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text3' AS textbox WITH ;
		Alignment = 2, ;
		DateFormat = 3, ;
		FontSize = 12, ;
		Format = "DK", ;
		Height = 26, ;
		Left = 572, ;
		Name = "Text3", ;
		TabIndex = 3, ;
		Top = 63, ;
		Width = 103
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		*!*	public codiprov
		*!*	this.text1.value=0
		*!*	this.text2.value=0
		*!*	this.text3.value=date()
		*!*	sele saldosiniprov
		*!*	set order to sini_cod
		*!*	go bott
		*!*	this.label5.caption="0000-"+repl("0",8-len(allt(str(sini_cod+1))))+allt(str(sini_cod+1))
		
		
	ENDPROC

	PROCEDURE Load
		MESSAGEBOX("ESTA RUTINA SE ENCUENTA MOMENTÁNEAMENTE EN PROCESO DE DISEÑO Y MANTENIMIENTO."+CHR(13)+CHR(13)+;
				   "ESTARÁ DISPONIBLE EN PRÓXIMAS ACTUALIZACIONES.",64,"Aviso del Sistema")
		RETURN TO master
	ENDPROC

	PROCEDURE Combo1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Combo1.Destroy
		set notify on
	ENDPROC

	PROCEDURE Combo1.GotFocus
		set notify off
	ENDPROC

	PROCEDURE Combo1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					sele proveedores
					set order to prov_nomb
					seek allt(this.list(i))
					thisform.text1.value=prov_codi
					KEYBOARD '{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE Combo1.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade=subst(allt(this.text),2,len(allt(this.text)))
				this.rowsource="select prov_nomb from proveedores where prov_nomb like '%'+allt(cade)+'%' order by prov_nomb INTO CURSOR combo1"
				this.value=this.list(1)
				keyboard "{F4}"
				return .F.
			else
				if len(allt(this.text))>0
					this.rowsource="select prov_nomb from proveedores where prov_nomb=allt(this.text) order by prov_nomb INTO CURSOR combo1"
					this.value=this.list(1)
					keyboard "{F4}"
					return .F.
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.Click
		local cs
		cs=0
		set point to ","
		preg=messagebox("¿Confirma el saldo inicial de $ "+allt(str(thisform.text2.value,15,2))+" ingresado?",4+32+256,"Saldos de Proveedores")
		if preg=6
			set point to "."
			sele saldosiniprov
			set order to sini_cod
			go bott
			cs=sini_cod+1
			appe blan
			repla sini_cod with cs
			repla sini_fech with thisform.text3.value
			repla prov_sal with thisform.text2.value
			repla prov_codi with thisform.text1.value
			sele proveedores
			set order to prov_codi
			seek thisform.text1.value
			if found()
				repla prov_saldo with prov_saldo+thisform.text2.value
			endif
			with thisform
				.text1.value=0
				.text2.value=0
				.combo1.rowsourcetype=0
				.combo1.clear
				.combo1.value=""
				this.enabled=.F.
				.text1.setfocus
			endwith
		else
			set point to "."
			thisform.text2.setfocus
		endif
	ENDPROC

	PROCEDURE Text1.Click
		this.value=0
		this.setfocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		set notify off
		thisform.combo1.rowsourcetype=3
	ENDPROC

	PROCEDURE Text1.LostFocus
		set notify on
	ENDPROC

	PROCEDURE Text1.Valid
		if this.value>0
			sele proveedores
			set order to prov_codi
			seek this.value
			if found()
				codiprov=prov_codi
				thisform.combo1.rowsource="SELECT prov_nomb FROM PROVEEDORES WHERE PROV_CODI=CODIPROV INTO CURSOR combo1"
				thisform.combo1.value=thisform.combo1.list(1)
				thisform.text2.value=0
				keyboard '{TAB}'
			else
				=messagebox("Proveedor no está en archivo",0+48,"Advertencia")
				this.value=0
				return .F.
			endif
		endif
	ENDPROC

	PROCEDURE Text2.LostFocus
		if this.value<>0
			thisform.command3.enabled=.T.
		endif
	ENDPROC

	PROCEDURE Text3.LostFocus
		thisform.label2.caption="SALDO INICIAL AL "+dtoc(this.value)+":"
	ENDPROC

ENDDEFINE

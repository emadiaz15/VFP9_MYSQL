	PROCEDURE Activate
		set exact on
		if codigo=0
			muestro=0
		endif
		if muestro=1
			with thisform
				sele articulos
				set order to art_codi
				seek codigo
				if val(cant)>art_stock and .check1.value=0 and codigo<>4
					set point to ","
					preg=messagebox("No hay stock disponible de: "+allt(art_desc)+chr(13)+ ;
						            "Cantidad a Enviar: "+allt(str(val(cant),10,2))+" "+allt(art_med)+chr(13)+ ;
						            "Stock Actual:        "+allt(str(art_stock,10,2))+" "+allt(art_med),4+48+256,"Advertencia!!!")
				else
					preg=6
				endif
				if preg=6
					set point to
					localiz=1
					if paso=1
						.grid1.col=0
						.grid1.text=allt(str(aux))
						.grid1.col=2
						.grid1.text=art_med
						.grid1.col=3
						articulo=val(.grid1.text)
						.grid1.col=3
						cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
						.grid1.text=cadena
						.grid1.col=1			
						.grid1.text=allt(cant)
						.grid1.col=4
						if codigo=4
							.grid1.text=allt(descrip)
						else
							.grid1.text=allt(descri)
						endif
						if .check1.value=1
							.grid1.col=5
							.grid1.text="SS"
						endif
						paso=0
					else
						if insertar=0
							item=item+1
							cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
							.grid1.additem(alltrim(str(item))+chr(9)+trim(cant)+chr(9)+art_med+chr(9)+cadena+chr(9)+allt(descri))
							if .check1.value=1
								.grid1.row=.grid1.rows-1
								.grid1.col=5
								.grid1.text="SS"
							endif
							do case
								case prompt()="Por Artículo" or prompt()="Por Factura"
									if item<27
										on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
									else
										on key label INS messagebox("No puede ingresar más Items al remito"+chr(13)+ ;
										                            "Haga click en Terminar para imprimir y luego"+chr(13)+ ;
										                            "registre un nuevo remito",0+48,"Advertencia")
									endif
								case prompt()="Por Pedido"
									on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
									if item>27
										div=item/27
										if div>int(div)
											cantrem=int(div)+1
										else
											cantrem=item/27
										endif
										auxrem=nrofac
										for x=1 to cantrem
											thisform.combo1.additem("       "+replicate("0",8-len(allt(str(auxrem))))+allt(str(auxrem)))
											auxrem=auxrem+1
										next x
										thisform.text7.visible=.F.
										thisform.combo1.visible=.T.
										thisform.combo1.value=1
									endif
							endcase
						endif
					endif
				endif
			endwith
		endif
		store 0 to muestro
		
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 3 of Altas .F.
		on key label INS
		localiz=0
		item=0
		if prompt()="Por Pedido de Cliente"
			itemsfac.release
		endif
		
	ENDPROC

	PROCEDURE Init
		parameter codifac,codp,codicli,codiprov
		public elimi,descrip,muestro,opcion,nrofac,nrorem,codirem, ;
			   dato1,dato2,dato3,codigo,cant,descri,insertar, ;
			   borra,codiva,transporte,coditran1,coditran2,auxcond, ;
			   texto,rta,articulo,lugent1,lugent2,flete1,flete2,observ,comprobante,localiz,item, ;
			   buscar
		set date british
		set cent on	   
		set deleted on
		transporte=""
		lugent1=""
		lugent2=""
		observ=""
		coditran1=0
		coditran2=0
		flete1=0
		flete2=0
		paso=0
		elimi=0
		localiz=0
		muestro=0
		descrip=""
		opcion=0
		insertar=0
		borra=0
		codigo=0
		x=0
		auxregis=0
		nrofac=0
		nrorem=0
		rta=0
		texto=""
		item=0
		articulo=0
		buscar=1
		codirem=0
		this.text13.value=date()
		this.text8.value=0
		do case
			case prompt()="Por Factura"
				if codicli>0
					with thisform
						sele clientes
						set order to cli_codi
						seek codicli
						.text1.value=cli_nomb
						.text2.value=cli_domi
						.text3.value=codipostales.cp_nro
						.text4.value=localidades.loca_nomb
						.text5.value=provincias.provi_nomb
						.text6.value=condiva.cond_desc
						.text12.value=cli_cuit
						sele facturas_articulos
						set order to fac_codi
						seek codifac
						do while fac_codi=codifac and !eof()
							cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
							item=item+1
							.grid1.additem(allt(str(item))+chr(9)+str(artfac_cant,10,3)+chr(9)+articulos.art_med+chr(9)+cadena+chr(9)+allt(articulos.art_desc))
							if art_codi=4
								.grid1.col=4
								.grid1.row=item
								.grid1.text=allt(artfac_dasc)
							endif
							if dac_codi>0
								.grid1.col=4
								.grid1.row=item
								.grid1.text=allt(desc_articulos_clientes.dac_desc)
							endif
							skip
						enddo
						sele facturas
						set order to fac_codi
						seek codifac
						.text8.value=repl("0",4-len(allt(str(fac_pto))))+allt(str(fac_pto))+" - "+repl("0",8-len(allt(str(fac_nro))))+allt(str(fac_nro))
					endwith
				endif
			case prompt()="Por Artículo"
				if codicli>0
					with thisform
						sele clientes
						set order to cli_codi
						seek codicli
						.text1.value=cli_nomb
						.text2.value=cli_domi
						.text3.value=codipostales.cp_nro
						.text4.value=localidades.loca_nomb
						.text5.value=provincias.provi_nomb
						.text6.value=condiva.cond_desc
						.text12.value=cli_cuit
					endwith
				endif
			case prompt()="A Proveedores"
				if codiprov>0
					with thisform
						sele proveedores
						set order to prov_codi
						seek codiprov
						.text1.value=prov_nomb
						.text2.value=prov_domi
						.text3.value=codipostales.cp_nro
						.text4.value=localidades.loca_nomb
						.text5.value=provincias.provi_nomb
						.text6.value=condiva.cond_desc
						.text12.value=prov_cuit
					endwith
				endif
			case prompt()="Por Pedido"
				if codicli>0
					with thisform
						sele clientes
						set order to cli_codi
						seek codicli
						.text1.value=cli_nomb
						.text2.value=cli_domi
						.text3.value=codipostales.cp_nro
						.text4.value=localidades.loca_nomb
						.text5.value=provincias.provi_nomb
						.text6.value=condiva.cond_desc
						.text12.value=cli_cuit
						sele pedidos_articulos
						set order to ped_codi
						seek codp
						if found()
							item=0
							for i=1 to itemsenv.lstpedcli.listcount
								if itemsenv.lstpedcli.selected(i)
									item=item+1
									.grid1.additem(allt(str(item))+chr(9)+allt(itemsenv.lstpedcli.list(i,2))+chr(9)+allt(itemsenv.lstpedcli.list(i,3))+chr(9)+allt(itemsenv.lstpedcli.list(i,4))+chr(9)+allt(itemsenv.lstpedcli.list(i,5)))
								endif
							next
							itemsenv.release
						endif
					endwith
				endif
		endcase
		sele remitos
		if eof()
			do form inirem with nrorem
		else
			go bott
			this.text9.value=rem_pto
			nrorem=rem_nro+1
		endif
		if item>27
			div=item/27
			if div>int(div)
				cantrem=int(div)+1
			else
				cantrem=item/27
			endif
			auxrem=nrorem
			for x=1 to cantrem
				thisform.combo1.additem("       "+replicate("0",8-len(allt(str(auxrem))))+allt(str(auxrem)))
				auxrem=auxrem+1
			next x
			thisform.text7.visible=.F.
			thisform.combo1.visible=.T.
			thisform.combo1.value=1
		else
			this.text7.value=nrorem
		endif
		sele clientes
		set order to cli_codi
		localiz=1
		on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Load
		set skip of bar 3 of Altas .T.
	ENDPROC

	PROCEDURE LostFocus
		if prompt()="Por Presupuesto"
			set skip of bar 3 of Altas .F.
			localiz=0
		*	item=0
		endif
	ENDPROC

	PROCEDURE Check1.Click
		do case
			case this.value=1
				preg=messagebox("¿Confirma que envía todo sin mover Stock?",4+48+256,"Advertencia")
				if preg=6
					if thisform.grid1.rows>1
						thisform.grid1.col=5
						for i=1 to thisform.grid1.rows-1
							thisform.grid1.row=i
							thisform.grid1.text="SS"
						next i
						thisform.grid1.row=1
					endif
				else
					this.value=0
				endif
			case this.value=0
				preg=messagebox("¿Confirma que envía todo moviendo Stock?",4+48+256,"Advertencia")
				if preg=6
					if thisform.grid1.rows>1
						thisform.grid1.col=5
						for i=1 to thisform.grid1.rows-1
							thisform.grid1.row=i
							thisform.grid1.text=""
						next i
						thisform.grid1.row=1
					endif
				else
					this.value=1
				endif
		endcase
	ENDPROC

	PROCEDURE Command1.Click
		local primerem,primefac,primecodirem
		primecodirem=0
		primerem=0
		primefac=0
		DIMENSION tra[2,5]
		if item=0
			messagebox("Aún no ha ingresado ningún Item al Remito. Imposible Terminar",0+48,"Advertencia")
		else	
			preg=messagebox("¿Confirma los datos del Remito?",4+32+256,"Alta de Remitos")
		endif
		if preg=6
			messagebox("Verifique si están en la impresora los formularios de remito y haga click en Aceptar",0+48,"Advertencia")
			acu=0
			if item>27
				div=item/27
				if div>int(div)
					cantrem=int(div)+1
				else
					cantrem=item/27
				endif
			else
				cantrem=1
			endif
			c=1
			coditran=0
			do form tranload with coditran
			for x=1 to cantrem
			with thisform
				if prompt()="Por Pedido"
					sele pedidos_articulos	
					set order to ped_codi
					seek codp
					sele pedidos_transportes
					seek codp
					if ped_codi=codp
						coditran1=tran_codi
						lugent1=flete_lugent
						do case
							case flete_cargo="P"
								flete1=1
							case flete_cargo="C"
								flete1=2
						endcase
						skip
						if ped_codi=codp
							coditran2=tran_codi
							lugent2=flete_lugent
							do case
								case flete_cargo="P"
									flete2=1
								case flete_cargo="C"
									flete2=2
							endcase
						endif
					endif
				endif
				if prompt()="Por Factura"
					sele facturas
					set order to fac_codi
					seek codifac
					nrofac=fac_nro
					primefac=nrofac
				endif
				sele remitos
				set order to rem_codi
				if eof()
					appe blank
					codirem=1
				else
					go bott
					codirem=rem_codi+1
					if x>1
						nrorem=nrorem+1
					endif
					appe blank
				endif
				if x=1
					primecodirem=codirem
					primerem=nrorem
				endif
				repla rem_codi with codirem
				repla rem_pto with .text9.value
				repla rem_nro with nrorem
				repla rem_fech with .text13.value
				if prompt()="Por Factura"
					repla fac_codi with codifac
				endif
				do case
					case prompt()="Por Artículo" or prompt()="Por Factura" or prompt()="Por Pedido"
						repla cli_codi with codicli
					case prompt()="A Proveedores"
						repla prov_codi with codiprov
				endcase
				repla tran_codi with coditran
				contador=1
				for fila=c to .grid1.rows-1
					if contador<=27
					.grid1.row=fila
					sele remitos_articulos
					appe blank
					repla rem_codi with codirem
					repla rem_nro with nrorem
					.grid1.col=3
					repla art_codi with val(.grid1.text)
					articulo=val(.grid1.text)
					.grid1.col=1
					repla artrem_cant with val(.grid1.text)
					.grid1.col=4
					if art_codi=4
						repla artrem_dasc with .grid1.text
					endif
					if art_codi<>4 and allt(.grid1.text)<>allt(articulos.art_desc)
						repla artrem_ddesc with allt(.grid1.text)
						if prompt()="A Proveedores"
							sele articulos_proveedores
							set order to artprov
							seek str(codiprov)+str(articulo)
							if found()
								sele desc_articulos_proveedores
								set order to dacartpro
								seek str(articulos_proveedores.artpro_codi)+allt(.grid1.text)
								if found()
									sele remitos_articulos
									repla dap_codi with desc_articulos_proveedores.dap_codi
								endif
							endif
							sele remitos_articulos
						else
							sele articulos_clientes
							set order to artcli
							seek str(codicli)+str(articulo)
							if found()
								sele desc_articulos_clientes
								set order to dacartcli
								seek str(articulos_clientes.artcli_codi)+allt(.grid1.text)
								if found()
									sele remitos_articulos
									repla dac_codi with desc_articulos_clientes.dac_codi
								endif
							endif
							sele remitos_articulos
						endif
					endif
					.grid1.col=5
					if allt(.grid1.text)<>"SS"
						.grid1.col=1
						if articulo<>4
							repla articulos.art_stock with articulos.art_stock-val(.grid1.text)
						endif
						if prompt()="Por Pedido"
							sele pedidos_articulos
							set order to pedart
							seek str(codp)+str(articulo)
							if articulo=4
								.grid1.col=4
								if allt(artped_dasc)<>allt(.grid1.text)
									do while art_codi=4 and !eof()
										if allt(artped_dasc)=allt(.grid1.text)
											.grid1.col=1
											if val(.grid1.text)>artped_cant
												repla artped_ent with artped_cant
											else
												repla artped_ent with artped_ent+val(.grid1.text)
											endif
											exit
										endif
										skip
										.grid1.col=4
									enddo
								endif
							else
								if val(.grid1.text)>artped_cant
									repla artped_ent with artped_cant
								else
									repla artped_ent with artped_ent+remitos_articulos.artrem_cant
								endif
							endif
						endif
						if prompt()="Por Factura"
							.grid1.col=3
							sele facturas_articulos
							set order to facart
							seek str(codifac)+str(val(.grid1.text))
							if found()
								if val(.grid1.text)=4
									if facturas.ped_codi>0 and artfac_sstock="S"
										sele pedidos_articulos
										set order to pedart
										seek str(facturas.ped_codi)+str(val(.grid1.text))
										.grid1.col=4
										if allt(artped_dasc)<>allt(.grid1.text)
											do while art_codi=4 and !eof()
												if allt(artped_dasc)=allt(.grid1.text)
													.grid1.col=1
													if val(.grid1.text)>artped_cant
														repla artped_ent with artped_cant
													else
														repla artped_ent with artped_ent+val(.grid1.text)
													endif
													exit
												endif
												skip
												.grid1.col=4
											enddo
										endif
									endif
								else
									if facturas.ped_codi>0 and artfac_sstock="S"
										sele pedidos_articulos
										set order to pedart
										seek str(facturas.ped_codi)+str(val(.grid1.text))
										if found()
											.grid1.col=1
											repla artped_ent with artped_ent+val(.grid1.text)
										endif
									endif
								endif
							endif
						endif
					else
						repla artrem_sstock with "S"
					endif
					endif
					contador=contador+1
				next fila
			endwith
			if cantrem>1
				nrorem=nrorem+1
			endif
			c=fila
			next x
			if prompt()="Por Pedido" or prompt()="Por Factura"
				do cumplido with codp
			endif
			codirem=primecodirem
			nrorem=primerem
			nrofac=primefac
			for x=1 to cantrem
				do form datosremito with codirem,nrorem,nrofac,lugent,observ
				for n=1 to 3
					do case
						case n=1
							comprobante="ORIGINAL"
						case n=2
							comprobante="DUPLICADO"
						case n=3
							comprobante="TRIPLICADO"
					endcase
					do case
						case prompt()="Por Artículo" or prompt()="Por Factura" or prompt()="Por Pedido"
							set point to ","
							report form remito for remitos_articulos.rem_codi=codirem to printer noconsole
							set point to
						case prompt()="A Proveedores"
							set point to ","
							report form remitoprov for remitos_articulos.rem_codi=codirem to printer noconsole
							set point to
					endcase
				next n
				codirem=codirem+1
				nrorem=nrorem+1
				nrofac=nrofac+1
			next x
			thisform.release
		endif
		
	ENDPROC

	PROCEDURE Command2.Click
		preg=messagebox("¿Seguro que desea salir?",4+32+256,"Verifique")
		if preg=6
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command3.Click
		sele pedidos_articulos	
		set order to ped_codi
		seek codp
		sele pedidos_transportes
		seek codp
		if ped_codi=codp
			messagebox(transportes.tran_nomb)
			coditran1=tran_codi
			lugent1=flete_lugent
			do case
				case flete_cargo="P"
					flete1=1
				case flete_cargo="C"
					flete1=2
			endcase
			skip
			if ped_codi=codp
				messagebox(transportes.tran_nomb)
				coditran2=tran_codi
				lugent2=flete_lugent
				do case
					case flete_cargo="P"
						flete2=1
					case flete_cargo="C"
						flete2=2
				endcase
			endif
		endif
		
	ENDPROC

	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
		local x,y
		if item>0
			this.col=0
			aux=val(this.text)
			this.col=3
			dato1=val(this.text)
			this.col=1
			dato2=this.text
			this.col=4
			dato3=this.text
			this.col=5
			if this.text="SS"
				opcion=3
			else
				opcion=0
			endif
			do form modiremi with opcion,dato1,dato2,dato3,codigo,cant,descri
		endif
		if borra=6
			with thisform
				if this.rows=2
					item=item-1
					this.rows=1
				else
					item=item-1
					this.removeitem(this.row)
					this.col=2
					x=1
					y=0
					do while x<=this.rows-1
						this.row=x
						y=y+1
						this.col=0
						this.text=allt(str(y))
						x=x+1
					enddo
				endif			
			endwith
			borra=0
			insertar=0
		endif
		if insertar=1 and codigo<>0
			with thisform
				this.col=0
				nro=this.row
				if opcion=1
					cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
					this.additem(" "+chr(9)+trim(cant)+chr(9)+art_med+chr(9)+cadena+chr(9)+descri,.grid1.row)
					if .check1.value=1
						.grid1.col=5
						.grid1.text="SS"
					endif
					item=item+1
					muestro=0
					opcion=0
				endif
				x=1
				y=0
				filaux=this.row
				do while x<=this.rows-1
					this.row=x
					y=y+1
					this.col=0
					this.text=allt(str(y))
					x=x+1
				enddo
				this.row=filaux
			endwith
		endif
		do case
			case opcion=3
				this.col=5
				this.text="SS"
				opcion=0
			case opcion=4
				this.col=5
				this.text=""
			case opcion=5
				this.col=4
				texto=allt(this.text)
				do form difedesc with texto
				this.text=allt(texto)
		endcase
		do case
			case prompt()="Por Artículo" or prompt()="Por Factura"
				if item<27
					on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
				else
					on key label INS messagebox("No puede ingresar más Items al remito"+chr(13)+ ;
					                            "Haga click en Terminar para imprimir y luego"+chr(13)+ ;
					                            "registre un nuevo remito",0+48,"Advertencia")
				endif
			case prompt()="Por Pedido"
				on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
				if item>27
					div=item/27
					if div>int(div)
						cantfac=int(div)+1
					else
						cantfac=item/27
					endif
					auxfac=nrofac
					for x=1 to cantfac
						thisform.combo1.additem("       "+replicate("0",8-len(allt(str(auxfac))))+allt(str(auxfac)))
						auxfac=auxfac+1
					next x
					thisform.text7.visible=.F.
					thisform.combo1.visible=.T.
					thisform.combo1.value=1
				endif
		endcase
	ENDPROC

	PROCEDURE grid1.GotFocus
		if localiz=1
			if elimi=0 and item>0
				thisform.grid1.toprow=item
			else
				elimi=0
			endif
		endif
	ENDPROC

	PROCEDURE Text1.GotFocus
		if localiz=1
			thisform.grid1.toprow=item
		endif
	ENDPROC

	PROCEDURE Text13.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text8.Click
		this.setfocus
	ENDPROC

ENDDEFINE


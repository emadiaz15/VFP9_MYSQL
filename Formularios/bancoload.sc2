DEFINE CLASS bancoload AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="List1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtbanload" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 208,220,203
		BorderStyle = 0
		Caption = "Seleccione Banco"
		Closable = .F.
		DoCreate = .T.
		Height = 248
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "BANCOLOAD"
		Width = 298
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		Caption = "\<Nuevo Banco", ;
		Height = 27, ;
		Left = 101, ;
		Name = "Command1", ;
		Top = 211, ;
		Width = 85
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'List1' AS listbox WITH ;
		FontBold = .T., ;
		Height = 156, ;
		Left = 24, ;
		Name = "List1", ;
		RowSource = "bancos.ban_desc", ;
		RowSourceType = 2, ;
		Top = 46, ;
		Width = 246
		*< END OBJECT: BaseClass="listbox" />

	ADD OBJECT 'txtbanload' AS textbox WITH ;
		BackColor = 255,255,255, ;
		FontBold = .T., ;
		Format = "!", ;
		Height = 23, ;
		Left = 24, ;
		Name = "txtbanload", ;
		TabIndex = 1, ;
		Top = 20, ;
		Width = 248
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		this.list1.requery
	ENDPROC

	PROCEDURE Init
		parameter codiper
		public f
		f=1
	ENDPROC

	PROCEDURE Unload
		return codiban
	ENDPROC

	PROCEDURE Command1.Click
		do form altabanco with codiban
	ENDPROC

	PROCEDURE List1.Click
		if this.selected(this.listindex)
			codiban=bancos.ban_codi
			thisform.release
		endif
		
	ENDPROC

	PROCEDURE List1.GotFocus
		if last()=24 or last()=5
			thisform.txtbanload.setfocus
		endif
	ENDPROC

	PROCEDURE List1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			if this.selected(this.listindex)
				codiban=bancos.ban_codi
				thisform.release
			endif
		endif
		if nkeycode=27
			codiban=0
		endif
	ENDPROC

	PROCEDURE txtbanload.InteractiveChange
		local lc
		lc = allt(This.Value)
		set order to ban_desc
		if last()<>127 and last()<>7
			do while !eof()
				if lc=subst(bancos.ban_desc,1,len(lc))
					exit
				else
					skip
					f=f+1
					if eof()
						go top
						f=1
						exit
					endif
				endif
			enddo
		else
			do while lc=subst(bancos.ban_desc,1,len(lc)) and f>1
				if bof()
					exit
				endif
				skip-1
				if f>1
					f=f-1
				endif
				if lc<>subst(bancos.ban_desc,1,len(lc))
					skip
					f=f+1
					exit
				endif
			enddo				
		endif
		thisform.list1.selected(f)=.T.
		return
		
	ENDPROC

	PROCEDURE txtbanload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
				sele bancos
				set order to ban_desc
				seek allt(this.value)
				codiban=ban_codi
				thisform.release
			case last()=5
				if f>1
					f=f-1
				endif
				thisform.list1.selected(f)=f
				this.value=thisform.list1.value
			case last()=24
				if f<thisform.list1.listcount
					f=f+1
				endif
				thisform.list1.selected(f)=f
				this.value=thisform.list1.value
			case last()=27
				codiban=0
				thisform.release
		endcase
	ENDPROC

ENDDEFINE


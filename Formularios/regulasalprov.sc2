	PROCEDURE Init
		*!*	public codiprov,cade,safconsol,salconsol,cancbtes,auxsal
		*!*	auxsal=0
		*!*	codiprov=0
		*!*	safconsol=0
		*!*	salconsol=0
		*!*	cancbtes=0

		*		endif
		*	case this.value<0
		*			=messagebox("Imposible ingresar un valor negativo",0+48,"Cobranzas")
		*		this.value=thisform.text21.value
		*		return 0
		*endcase
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text3.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text4.GotFocus
		set notify off
		*!*	this.value=0
		this.setfocus
		thisform.combo1.rowsourcetype=3
	ENDPROC

	PROCEDURE Text4.LostFocus
		set notify on
	ENDPROC

	PROCEDURE Text4.Valid
		if this.value>0
			sele proveedores
			set order to prov_codi
			seek this.value
			if found()
				codiprov=prov_codi
				thisform.combo1.rowsource="SELECT prov_nomb FROM PROVEEDORES WHERE PROV_CODI=CODIPROV INTO CURSOR combo1"
				thisform.combo1.value=thisform.combo1.list(1)
				thisform.text2.value=0
				if prov_afvor>0
					store prov_afvor to thisform.pageframe1.page2.text21.value,thisform.pageframe1.page2.text22.value
				else
					store 0 to thisform.pageframe1.page2.text21.value,thisform.pageframe1.page2.text22.value
				endif
				if prov_saldo>0
					store prov_saldo to thisform.pageframe1.page3.text21.value,thisform.pageframe1.page3.text22.value
				else
					store 0 to thisform.pageframe1.page3.text21.value,thisform.pageframe1.page3.text22.value
				endif
				keyboard '{TAB}'
			else
				=messagebox("Proveedor no está en archivo",0+48,"Advertencia")
				this.value=0
				return .F.
			endif
		endif
		
	ENDPROC

ENDDEFINE

		*!*	this.text2.value=0
		*!*	this.text3.value=date()
		*!*	create cursor recep(recep_fec D,recep_codi N(8),prov_tipfac C(1),prov_pto N(4),prov_fac N(8),imp_pag N(10,2),recep_conc C(1),total N(10,2))
		*!*	sele regulaprov
		*!*	set order to regp_codi
		*!*	go bott
		*!*	this.label7.caption="0000-"+repl("0",8-len(allt(str(regp_codi+1))))+allt(str(regp_codi+1))
		*!*	*do form cliload with codicli
		*!*	*if codicli>0
		*!*	*	sele clientes
		*!*	*	set order to cli_codi
		*!*	*	seek codicli
		*!*	*	if found()
		*!*	*		this.text1.value=cli_nomb
		*!*	*		this.text2.value=0
		*!*	*	endif
		*!*	*else
		*!*	*	this.release
		*!*	*endif
		
	ENDPROC

	PROCEDURE Load
		MESSAGEBOX("ESTA RUTINA SE ENCUENTA MOMENTÁNEAMENTE EN PROCESO DE DISEÑO Y MANTENIMIENTO."+CHR(13)+CHR(13)+;
				   "ESTARÁ DISPONIBLE EN PRÓXIMAS ACTUALIZACIONES.",64,"Aviso del Sistema")
		RETURN TO master
	ENDPROC

	PROCEDURE Combo1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Combo1.Destroy
		set notify on
	ENDPROC

	PROCEDURE Combo1.GotFocus
		set notify off
	ENDPROC

	PROCEDURE Combo1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					sele proveedores
					set order to prov_nomb
					seek allt(this.list(i))
					thisform.text4.value=prov_codi
					if prov_afvor>0
						store prov_afvor to thisform.pageframe1.page2.text21.value,thisform.pageframe1.page2.text22.value
					else
						store 0 to thisform.pageframe1.page2.text21.value,thisform.pageframe1.page2.text22.value
					endif
					if prov_saldo>0
						store prov_saldo to thisform.pageframe1.page3.text21.value,thisform.pageframe1.page3.text22.value
					else
						store 0 to thisform.pageframe1.page3.text21.value,thisform.pageframe1.page3.text22.value
					endif
					KEYBOARD '{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE Combo1.LostFocus
		if thisform.text4.value>0
			SELECT recep_fec,recep_codi,prov_tipfac,prov_pto,prov_fac,imp_pag,recep_conc, ;
			recep_impng+neto_1+neto_2+recep_ivari+recep_ivarni+((neto_1+neto_2)*perc_btos)/100+((neto_1+neto_2)*perc_iva)/100 as "total" ;
			FROM recepciones WHERE pagado<>"S" AND anulado<>"S" AND prov_codi=thisform.text4.value order by recep_codi INTO CURSOR recep
			go top
			with thisform.pageframe1.page1.list1
				i=1
				scan
					.list(i,1)=dtoc(recep_fec)
					do case
						case recep_conc="F"
							.list(i,2)=iif(prov_tipfac="A","FA",iif(prov_tipfac="M","FM","FB"))
						case recep_conc="N"
							.list(i,2)=iif(PROV_tipfac="A","NCA",iif(prov_tipfac="M","NCM","NCB"))
						case recep_conc="D"
							.list(i,2)=iif(prov_tipfac="A","NDA",iif(prov_tipfac="M","NDM","NDB"))
					endcase
					.list(i,3)=allt(str(prov_pto))
					.list(i,4)=str(prov_fac)
					.list(i,5)=str(total,10,2)
					.list(i,6)=str(imp_pag,10,2)
					.list(i,7)=str(total-imp_pag,10,2)
					if recep_conc="N"
						.list(i,5)="-"+allt(.list(i,5))
						.list(i,6)="-"+allt(.list(i,6))
						.list(i,7)="-"+allt(.list(i,7))
					endif
					if i=1
						.list(i,8)=str(ConverNro(.list(i,8))+ConverNro(.list(i,7)),10,2)
					else
						.list(i,8)=str(ConverNro(.list(i-1,8))+ConverNro(.list(i,7)),10,2)
					endif
					.list(i,9)=allt(str(recep_codi))
					i=i+1
				endscan
				dife=ConverNro(.list(i-1,8))-proveedores.prov_saldo
				if .listcount>0
					thisform.pageframe1.page3.label27.caption=thisform.pageframe1.page3.label27.caption+". Sugerencia: $ "+allt(str(iif(dife<0,abs(dife),dife),10,2))+"."
				endif
			endwith
		endif
	ENDPROC

	PROCEDURE Combo1.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade=subst(allt(this.text),2,len(allt(this.text)))
				this.rowsource="select prov_nomb from proveedores where prov_nomb like '%'+allt(cade)+'%' order by prov_nomb INTO CURSOR combo1"
				this.value=this.list(1)
				keyboard "{F4}"
				return .F.
			else
				if len(allt(this.text))>0
					this.rowsource="select prov_nomb from proveedores where prov_nomb=allt(this.text) order by prov_nomb INTO CURSOR combo1"
					this.value=this.list(1)
					keyboard "{F4}"
					return .F.
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Command1.Click
		local codr
		codr=0
		set point to ","
		if cancbtes>0
			preg=messagebox("¿Confirma el saldo de $ "+allt(str(thisform.text2.value,15,2))+" a imputar en el "+iif(thisform.optiongroup1.value=1,"Debe","Haber")+" de la nuestra cuenta corriente en el Proveedor?",4+32+256,"Regularización de Saldos")
		else
			preg=messagebox("¿Confirma el saldo de $ "+allt(str(thisform.text2.value,15,2))+" a imputar?",4+32+256,"Regularización de Saldos")
		endif
		if preg=6
			with thisform
				sele regulaprov
				set order to regp_codi
				go bott
				codr=regp_codi+1
				appe blank
				repla regp_codi with codr
				repla regp_fech with .text3.value
				if cancbtes>0
					do case
						case .optiongroup1.value=1
							repla regp_conc with "D"
						case .optiongroup1.value=2
							repla regp_conc with "H"
					endcase
				endif
				repla regp_deta with allt(.edit1.value)
				repla regp_impo with .text2.value
				repla prov_codi with .text4.value
			endwith
			if cancbtes>0
				repla ctacte with "S"
				with thisform.pageframe1.page1.list1
					for x=1 to .listcount
						if .selected(x)
							sele recepciones
							set order to recep_codi
							seek val(.list(x,9))
							if found()
								repla imp_pag with ConverNro(.list(x,7))
								repla pagado with "S"
							endif
						endif
					next x
				endwith
			else
				repla ctacte with "N"
			endif
			
			with thisform	
				sele proveedores
				set order to prov_codi
				seek .text4.value
				if found()
					do case
						case safconsol>0
							do case
								case .pageframe1.page2.optiongroup1.value=1
									repla prov_afvor with prov_afvor+safconsol
								case .pageframe1.page2.optiongroup1.value=2
									repla prov_afvor with prov_afvor-safconsol
							endcase
						case salconsol>0
							do case
								case .pageframe1.page3.optiongroup1.value=1
									repla prov_saldo with prov_saldo+salconsol
								case .pageframe1.page3.optiongroup1.value=2
									repla prov_saldo with prov_saldo-salconsol
							endcase
					otherwise
						do case
							case .optiongroup1.value=1
								repla prov_saldo with prov_saldo+.text2.value
							case .optiongroup1.value=2
								repla prov_saldo with prov_saldo-.text2.value
						endcase
					endcase
				endif
				c=messagebox("¿Continúa regularizando Saldos de Proveedores?",4+32+256,"Regularización de Saldos")
				if c=6
					.text4.value=0
					.text2.value=0
					.edit1.value=""
					.optiongroup1.value=0
					.combo1.rowsourcetype=0
					.combo1.clear
					.combo1.value=""
					.label2.visible=.T.
					.shape1.visible=.T.
					.optiongroup1.visible=.T.
					salconsol=0
					safconsol=0
					cancbtes=0
					.pageframe1.page1.list1.clear
					.pageframe1.page2.setall("Value",0,"Textbox")
					.pageframe1.page3.setall("Value",0,"Textbox")
					.pageframe1.page3.label27.caption="Saldo a regularizar"
					this.enabled=.F.
					.text4.setfocus
				else
					.release
				endif
			endwith
		else
			set point to "."
			thisform.text2.setfocus
		endif
		
	ENDPROC

	PROCEDURE Command2.Click
		preg=messagebox("¿Seguro que desea Salir?",4+32+256,"Regularización de Saldos")
		if preg=6
			thisform.release
		endif
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
		
	ENDPROC

	PROCEDURE Optiongroup1.Click
		if this.value>0 and thisform.text2.value>0
			thisform.command1.enabled=.T.
		else
			thisform.command1.enabled=.F.
		endif
		thisform.text2.setfocus
	ENDPROC

	PROCEDURE Pageframe1.Page1.Click
		if safconsol>0
			thisform.text2.value=0
			thisform.edit1.value=""
			thisform.optiongroup1.value=0
			thisform.pageframe1.page2.text22.value=thisform.pageframe1.page2.text21.value
			safconsol=0
		endif
	ENDPROC

	PROCEDURE Pageframe1.Page1.Command3.Click
		local cantpos,cantneg,salpos,salneg,ncom,sigue
		cantpos=0
		salpos=0
		cantneg=0
		salneg=0
		ncom=""
		sigue=6
		with thisform.pageframe1.page1.list1
			for f=1 to .listcount
				if .selected(f)
					if ConverNro(.list(f,6))=0
						sigue=messagebox("Usted ha seleccionado uno o mas comprobantes que no han sido asociados a ningún pago efectuado"+CHR(13)+ ;
										 "verifique bien el movimiento porque puede generar inconsistencias en la cuenta corriente."+CHR(13)+ ;
										 "Si se trata de una Nota de Crédito verifique que no haya una Factura o Nota de Débito para aplicarla."+CHR(13)+ ;
										 "Y si se trata de una Factura o Nota de Débito verifique que no haya una Nota de Crédito para aplicar."+CHR(13)+CHR(13)+;
										 "¿Continúa igualmente con esta regularicación?",4+48+256,"Advertencia!!!")
						exit
					endif
				endif
			next f
		endwith
		if sigue=6				
			for x=1 to thisform.pageframe1.page1.list1.listcount
				if thisform.pageframe1.page1.list1.selected(x)
					if ConverNro(thisform.pageframe1.page1.list1.list(x,7))>0
						cantpos=cantpos+1
						salpos=salpos+ConverNro(thisform.pageframe1.page1.list1.list(x,7))
					else
						cantneg=cantneg+1
						salneg=salneg+abs(ConverNro(thisform.pageframe1.page1.list1.list(x,7)))
					endif
					ncom=repl("0",4-len(allt(thisform.pageframe1.page1.list1.list(x,3))))+ ;
								allt(thisform.pageframe1.page1.list1.list(x,3))+"-"+ ;
								repl("0",8-len(allt(thisform.pageframe1.page1.list1.list(x,4))))+ ;
								allt(thisform.pageframe1.page1.list1.list(x,4))
					do case
						case x=1
							thisform.edit1.value=allt(thisform.pageframe1.page1.list1.list(x,2))+" "+ncom+"  "+;
												allt(thisform.pageframe1.page1.list1.list(x,1))+" $ "+allt(thisform.pageframe1.page1.list1.list(x,7))
					    case x>1
							if !empty(thisform.edit1.value)
								thisform.edit1.value=thisform.edit1.value+chr(13)+allt(thisform.pageframe1.page1.list1.list(x,2))+" "+ncom+"  "+;
													allt(thisform.pageframe1.page1.list1.list(x,1))+" $ "+allt(thisform.pageframe1.page1.list1.list(x,7))
							else
								thisform.edit1.value=thisform.edit1.value+allt(thisform.pageframe1.page1.list1.list(x,2))+" "+ncom+"  "+;
													allt(thisform.pageframe1.page1.list1.list(x,1))+" $ "+allt(thisform.pageframe1.page1.list1.list(x,7))
							endif
							
					endcase
					cancbtes=cancbtes+1
				endif
			next x
			if cantpos>0 and cantneg>0
				=messagebox("No se pueden seleccionar valores positivos y negativos en una sola regularización "+ ;
							"deberá regularizar saldos positivos y negativos por separado.",0+48,"Regularizaciones")
				cancbtes=0
			else
				do case
					case cantpos>0
						thisform.text2.value=salpos
						thisform.optiongroup1.value=2
					case cantneg>0
						thisform.text2.value=abs(salneg)
						thisform.optiongroup1.value=1
				endcase
				thisform.command1.enabled=.T.
				thisform.edit1.setfocus
				KEYBOARD "{CTRL+END}"+chr(13)+chr(13)
			endif
			this.enabled=.F.
		endif
		
					
	ENDPROC

	PROCEDURE Pageframe1.Page1.List1.InteractiveChange
		for x=1 to this.listcount
			if this.selected(x)
				thisform.pageframe1.page1.command3.enabled=.T.
			endif
		next x
	ENDPROC

	PROCEDURE Pageframe1.Page2.Click
		if this.text21.value>0
			with thisform.pageframe1.page1.list1
				.clear
				sele recep
				go top
				i=1
				scan
					.list(i,1)=dtoc(recep_fec)
					do case
						case recep_conc="F"
							.list(i,2)=iif(prov_tipfac="A","FA",iif(prov_tipfac="M","FM","FB"))
						case recep_conc="N"
							.list(i,2)=iif(PROV_tipfac="A","NCA",iif(prov_tipfac="M","NCM","NCB"))
						case recep_conc="D"
							.list(i,2)=iif(prov_tipfac="A","NDA",iif(prov_tipfac="M","NDM","NDB"))
					endcase
					.list(i,3)=allt(str(prov_pto))
					.list(i,4)=str(prov_fac)
					.list(i,5)=str(total,10,2)
					.list(i,6)=str(imp_pag,10,2)
					.list(i,7)=str(total-imp_pag,10,2)
					if recep_conc="N"
						.list(i,5)="-"+allt(.list(i,5))
						.list(i,6)="-"+allt(.list(i,6))
						.list(i,7)="-"+allt(.list(i,7))
					endif
					if i=1
						.list(i,8)=str(ConverNro(.list(i,8))+ConverNro(.list(i,7)),10,2)
					else
						.list(i,8)=str(ConverNro(.list(i-1,8))+ConverNro(.list(i,7)),10,2)
					endif
					.list(i,9)=allt(str(recep_codi))
					i=i+1
				endscan
				dife=ConverNro(.list(i-1,8))-proveedores.prov_saldo
				if .listcount>0
					thisform.pageframe1.page3.label27.caption=thisform.pageframe1.page3.label27.caption+". Sugerencia: $ "+allt(str(iif(dife<0,abs(dife),dife),10,2))+"."
				endif
			endwith
			thisform.text2.value=0
			thisform.optiongroup1.value=0
			thisform.edit1.value=""
			this.text22.setfocus
		else
		*!*		this.text22.enabled=.F.
			this.command1.enabled=.F.
		endif
	ENDPROC

	PROCEDURE Pageframe1.Page2.Command1.Click
		safconsol=thisform.pageframe1.page2.text22.value
		thisform.text2.value=safconsol
		thisform.optiongroup1.value=1
		thisform.edit1.value="Saldo a Favor a Regularizar: "+chr(13)+ ;
						     "$ "+allt(str(safconsol,10,2))

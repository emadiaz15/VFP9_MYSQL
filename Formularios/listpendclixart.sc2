	PROCEDURE Init
		this.text1.Value=0
		this.text2.Value=''
	ENDPROC

	PROCEDURE btn_salir.Click
		thisform.release
	ENDPROC

	PROCEDURE btn_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE btn_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command1.Click
		SET DECIMALS TO 3
		codigo=0
		thisform.text1.value=0
		do form artload with codigo
		thisform.grd_pendientes.RecordSource=''
		thisform.grd_pendientes.Refresh()
		thisform.ven=0
		if codigo>0
			with thisform
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmcart)
				.text1.value=cur_arti.art_codi
				.text2.value=cur_arti.art_desc
				vendn=UPPER(substr(sys(0),ATC("#",sys(0))+2))
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select * from vendedores where TRIM(ven_nomb)=?vendn;","cur_vendp")
				desconectar_db(frmcart)
				if RECCOUNT("cur_vendp")>0
					thisform.ven=cur_vendp.ven_codi
				else
					thisform.ven=0
				endif
				if thisform.ven>0
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"call usp_pendxart(?codigo,?thisform.ven,1);","curpen")
					desconectar_db(frmcart)
				ELSE
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"call usp_pendxart(?codigo,0,1);","curpen")
					desconectar_db(frmcart)
				ENDIF
				IF USED("curpen")
					IF RECCOUNT("curpen")>0
						GO top
						thisform.grd_pendientes.RecordSource="curpen"
						thisform.grd_pendientes.Refresh()
					ENDIF
				ENDIF
			endwith
		ENDIF
		SET DECIMALS TO
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Command1.GotFocus
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command2.Click
		IF USED("curpen")
			IF RECCOUNT("curpen")>0
				if thisform.ven>0
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"call usp_pendxart(?thisform.text1.value,?thisform.ven,2);","curpendcli")
					desconectar_db(frmcart)
				ELSE
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"call usp_pendxart(?thisform.text1.value,0,2);","curpendcli")
					desconectar_db(frmcart)
				ENDIF
				IF thisform.chk_pant.Value=1
					report form pendxcli preview noconsole
				ELSE
					report form pendxcli TO PRINTER PROMPT noconsole
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		SET DECIMALS TO 3
		IF nkeycode=13
			if this.value<>0
				thisform.ven=0
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select * from articulos where art_codi=?this.value;","cur_arti")
				desconectar_db(frmcart)
				if RECCOUNT("cur_arti")>0
					thisform.grd_pendientes.RecordSource=''
					thisform.grd_pendientes.Refresh()
					with thisform
						.text1.value=cur_arti.art_codi
						.text2.value=cur_arti.art_desc
						vendn=UPPER(substr(sys(0),ATC("#",sys(0))+2))
						frmcart= conectar_db(_screen.cn)
							SQLEXEC(frmcart,"select * from vendedores where TRIM(ven_nomb)=?vendn;","cur_vendp")
						desconectar_db(frmcart)
						if RECCOUNT("cur_vendp")>0
							thisform.ven=cur_vendp.ven_codi
						else
							thisform.ven=0
						ENDIF
						if thisform.ven>0
							frmcart= conectar_db(_screen.cn)
								SQLEXEC(frmcart,"call usp_pendxart(?this.value,?thisform.ven,1);","curpen")
							desconectar_db(frmcart)
						ELSE
							frmcart= conectar_db(_screen.cn)
								SQLEXEC(frmcart,"call usp_pendxart(?this.value,0,1);","curpen")
							desconectar_db(frmcart)
						ENDIF
						IF USED("curpen")
							IF RECCOUNT("curpen")>0
								GO top
								thisform.grd_pendientes.RecordSource="curpen"
								thisform.grd_pendientes.Refresh()
							ENDIF
						ENDIF					
					endwith
				else
					messagebox("Artículo no está en archivo",0+48,"Advertencia")
					this.value=0
					thisform.text2.Value=''
					thisform.grd_pendientes.RecordSource=''
					thisform.grd_pendientes.Refresh()			
					return 0
				endif
			endif	
		ENDIF
		SET DECIMALS TO
		
		
	ENDPROC

ENDDEFINE

	PROCEDURE Destroy
		set skip of bar 5 of Otros .F.
		localiz=0
		item=0
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		parameter codc,cond
		public elimi,aux,descrip,muestro,insertar,observ,cantreg,coditran,transporte, ;
				impiva1,impiva2,codiva,opcion,dato1,dato2,dato3,dato4,cant,descri, ;
				pruni,prtot,opcion,borra,alternati,localiz,ivaant,ivaact,iva,codiprov,dato1, ;
				acu,nitem,acuaux,auxiva,ivadif,ivaitem,lg
		
		PUBLIC importe1,importe2
		
		store 0 to importe1,importe2
		
		set deleted on
		this.xcondpro=cond
		this.xcodcpra=codc
		acuaux=0
		auxiva=0
		ivadif=0
		ivaitem=0
		transporte=" "
		coditran=0
		observ=" "
		paso=0
		acu=0
		elimi=0
		aux=0
		descrip=""
		insertar=0
		cantreg=0
		borra=0
		prtot=""
		pruni=""
		codigo=0
		*!*	CREATE CURSOR auxdap(dap_codi N(8),dap_desc C(45))
		*!*	INDEX on dap_codi TO dp
		
		thisform.text13.value=date()
		thisform.text19.value=0
		
		frmanucom= conectar_db(_screen.cn)
			SQLEXEC(frmanucom,"select b.*,c.*,d.cond_desc from compras a inner join iva b on a.iva_codi=b.iva_codi inner join proveedores c on c.prov_codi=a.prov_codi inner join condiva d on c.cond_codi=d.cond_codi where a.orden_codi=?codc;","cur_datvar")
			SQLEXEC(frmanucom,"select a.*,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on c.provi_codi=a.provi_codi where a.loca_codi=?cur_datvar.loca_codi;","cur_ubic")
		desconectar_db(frmanucom)
		impiva1=cur_datvar.iva_1
		impiva2=cur_datvar.iva_2
		codiva=cur_datvar.iva_codi
		thisform.label12.caption=allt(str(impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(impiva2,10,2))+"%"
		
		SET DECIMALS TO 3
		frmanucom= conectar_db(_screen.cn)
			SQLEXEC(frmanucom,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dap_desc from compras_articulos a inner join articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_proveedores c on c.dap_codi=a.dap_codi where a.orden_codi=?codc order by a.artord_codi;","cur_arcom")
			SQLEXEC(frmanucom,"select * from compras where orden_codi=?codc;","cur_cpra")
		desconectar_db(frmanucom)
		SET DECIMALS TO
		
		nitem=1
		with thisform
			IF pascpra=1
				.command3.visible=.F.
			ELSE
				.command3.visible=.T.
			endif
			.text7.value=codc
			.text1.value=cur_datvar.prov_nomb
			.text2.value=cur_datvar.prov_domi
			auxcond=cur_datvar.cond_codi
			codiprov=cur_cpra.prov_codi
			.text3.value=cur_ubic.cp_nro
			.text4.value=cur_ubic.loca_nomb
			.text5.value=cur_ubic.provi_nomb
			.text6.value=cur_datvar.cond_desc
			.text12.value=VAL(cur_datvar.prov_cuit)
			.text13.value=cur_cpra.orden_fech
			.text19.value=cur_cpra.orden_dto
			.text20.value=cur_cpra.orden_ref
			.edit1.value=ALLTRIM(cur_cpra.orden_obser)
			coditran=cur_cpra.tran_codi
			frmanucom= conectar_db(_screen.cn)
				SQLEXEC(frmanucom,"select * from transportes where tran_codi=?coditran;","cur_tra")
			desconectar_db(frmanucom)
			IF RECCOUNT("cur_tra")>0
				.text14.value=tran_nomb
			ENDIF
			
			SELECT cur_arcom
			GO top
			SCAN
				cadena=repl("0",8-len(allt(str(cur_arcom.art_codi))))+allt(str(cur_arcom.art_codi))
				if cur_arcom.art_codi=4 or cur_arcom.art_codi=5
					.grid1.additem(allt(str(nitem))+chr(9)+allt(str(cur_arcom.artord_cant,10,3))+chr(9)+allt(cur_arcom.art_med)+chr(9)+cadena+chr(9)+allt(cur_arcom.artord_dasc)+chr(9)+allt(str(cur_arcom.artord_precio,10,3))+chr(9)+allt(str(cur_arcom.artord_cant*cur_arcom.artord_precio,10,2)))
					.grid1.row=this.grid1.rows-1
					this.grid1.col=7
					do case
						case cur_arcom.art_alicuota=1
							this.grid1.text=allt(str(impiva1,10,2))
						case cur_arcom.art_alicuota=2
							this.grid1.text=allt(str(impiva2,10,2))
					endcase
				else
					.grid1.additem(allt(str(nitem))+chr(9)+allt(str(cur_arcom.artord_cant,10,3))+chr(9)+allt(cur_arcom.art_med)+chr(9)+cadena+chr(9)+allt(cur_arcom.art_desc)+chr(9)+allt(str(cur_arcom.artord_precio,10,3))+chr(9)+allt(str(cur_arcom.artord_cant*cur_arcom.artord_precio,10,2)))
					if cur_arcom.dap_codi>0
						.grid1.col=4
						.grid1.row=nitem
						.grid1.text=allt(cur_arcom.dap_desc)
					ENDIF
					.grid1.row=this.grid1.rows-1
					this.grid1.col=7
					do case
						case cur_arcom.art_alicuota=1
							this.grid1.text=allt(str(impiva1,10,2))
						case cur_arcom.art_alicuota=2
							this.grid1.text=allt(str(impiva2,10,2))
					endcase
				ENDIF
				.grid1.row=this.grid1.rows-1
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					cantreg=cantreg+longdes
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				ELSE
					cantreg=cantreg+1
					.grid1.rowheight(.grid1.row)=270
				endif		
				prtot=allt(str(cur_arcom.artord_cant*cur_arcom.artord_precio,10,2))
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=0
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=1
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=6
				this.grid1.col=2
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=3
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=4
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=0
				this.grid1.col=5
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				this.grid1.col=6
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				acu=acu+(cur_arcom.artord_cant*cur_arcom.artord_precio)
		        *****************CALCULO TOTALIZADORES********************************
				.text8.value=str(acu,10,2)
				.text17.value=str(iif(.text19.value>0,round((acu*.text19.value)/100,2),0),10,2)
				.text18.value=str(ConverNro(.text8.value)-ConverNro(.text17.value),10,2)
				if .text19.value>0
					do case
						case cur_arcom.art_alicuota=1
							.grid1.col=6
							importe1=importe1+(ConverNro(prtot)*((100-.text19.value)/100))
							if thisform.xcondpro=2
								.text9.value=str(ConverNro(.text9.value)+(ConverNro(prtot)*((100-.text19.value)/100)*impiva1/100),10,2)
							endif
						case cur_arcom.art_alicuota=2
							.grid1.col=6
							importe2=importe2+(ConverNro(prtot)*((100-.text19.value)/100))
							if thisform.xcondpro=2
								.text11.value=str(ConverNro(.text11.value)+(ConverNro(prtot)*((100-.text19.value)/100)*impiva2/100),10,2)
							endif
					endcase
				else
					do case
						case cur_arcom.art_alicuota=1
							.grid1.col=6
							importe1=importe1+ConverNro(prtot)
							if thisform.xcondpro=2
								.text9.value=str(ConverNro(.text9.value)+((ConverNro(prtot))*impiva1/100),10,2)
							endif
						case cur_arcom.art_alicuota=2
							.grid1.col=6
							importe2=importe2+ConverNro(prtot)
							if thisform.xcondpro=2
								.text11.value=str(ConverNro(.text11.value)+((ConverNro(prtot))*impiva2/100),10,2)
							endif
					endcase
				endif
				.text10.value=str(ConverNro(.text18.value)+ConverNro(.text9.value)+ConverNro(.text11.value),10,2)
		        *****************FIN CALCULO TOTALIZADORES******************************
				nitem=nitem+1		
			ENDSCAN
		*!*		SET RELATION TO dap_codi INTO auxdap addi
		endwith
		if nitem>1
			nitem=nitem-1
		endif
		localiz=1
	ENDPROC

	PROCEDURE Load
		set skip of bar 5 of Otros .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if valorcadena<>"Anulación de Ordenes de Compra"
		*!*		set skip of bar 5 of Otros .F.
		*!*		thisform.hide
		*!*		localiz=0
		*!*		item=0
		*!*	endif
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		with thisform
			preg=messagebox("¿Confirma la anulación de la Orden de Compra?",4+48+256,"Advertencia!!!")
			if preg=6
				LOCAL xcodart,xpprov
				STORE 0 TO xcodart,xpprov
				if cur_cpra.anulado<>"S"
					frmanucom= conectar_db(_screen.cn)
						SQLEXEC(frmanucom,"update compras set anulado='S' where orden_codi=?cur_cpra.orden_codi;")
					desconectar_db(frmanucom)
					for i=1 to .grid1.rows-1
						.grid1.row=i
						.grid1.col=3
						xcodart=VAL(.grid1.text)
						.grid1.col=1
						xpprov=ConverNro(.grid1.text)
						frmanucom= conectar_db(_screen.cn)
							SQLEXEC(frmanucom,"update articulos set pedprov=pedprov-?xpprov where art_codi=?xcodart;")
						desconectar_db(frmanucom)
					next i
				else
					messagebox("Esta Orden de Compra ya ha sido Anulada.",0+48,"Advertencia!!!")
				endif
			endif
			.release
		endwith
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		codiprov=cur_cpra.prov_codi
		do form ordenload with codiprov
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			local acuaux,auxiva,ivadif,ivaitem
			acuaux=0
			auxiva=0
			ivadif=0
			ivaitem=0
			for i=1 to .grid1.rows-1
				.grid1.row=i
				.grid1.col=7
				if len(.grid1.text)>0
					ivaitem=ConverNro(.grid1.text)
					.grid1.col=6
					dto=ConverNro(.grid1.text)*this.value/100
					acuaux=acuaux+ConverNro(.grid1.text)-dto
					dto=ConverNro(.grid1.text)-dto
					ivaitem=dto*ivaitem/100
					ivadif=ivadif+ivaitem
				endif
			next i
			dtotot=acu*this.value/100
			.text17.value=str(dtotot,10,2)
			.text18.value=str(acu-dtotot,10,2)
			if proveedores.cond_codi=2
				dife=acu-dtotot-acuaux
				auxiva=dife*impiva1/100
				.text9.value=str(auxiva+ivadif,10,2)
			endif
			.text10.value=str(ConverNro(.text18.value)+ConverNro(.text9.value)+ConverNro(.text11.value),10,2)
		endwith
		
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="1" />

	*<PropValue>
		DataSource = .NULL.
		Height = 901
		Left = 1
		Name = "Dataenvironment"
		Top = 0
		Width = 1869
	*</PropValue>


	PROCEDURE Activate
		set exact on
		if codigo=0 and alternati="N"
			muestro=0
		endif
		if muestro=1
			with thisform
				SET POINT TO "."
				frmaltare= conectar_db(_screen.cn)
					SQLEXEC(frmaltare,"select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmaltare)
				localiz=1
				if alternati="S"
					with thisform
						do case
							case opcion=1
								if paso=1
									.grid1.col=2
									.grid1.text="DTO"
									.grid1.col=4
									.grid1.text=allt(descri)
									.grid1.col=5
									.grid1.text=allt(str(porcdto,7,3))+"%"
									filaux=.grid1.row-1
									.grid1.col=6
									desaux=ConverNro(.grid1.text)
									incremento=0
									for i=1 to filaux
										.grid1.row=i
										incremento=incremento+ConverNro(.grid1.text)
									next i
									.grid1.row=filaux+1
									.grid1.text="-"+allt(str(incremento*porcdto/100,10,2))
									do case
										case ConverNro(.grid1.text)<desaux
											dife=ConverNro(.grid1.text)-desaux
											thisform.acu=thisform.acu+dife
										case ConverNro(.grid1.text)>desaux
											dife=desaux-ConverNro(.grid1.text)
											thisform.acu=thisform.acu-dife
									endcase
								else					
									.grid1.additem(" "+chr(9)+" "+chr(9)+"DTO"+chr(9)+" "+chr(9)+allt(descri)+chr(9)+allt(str(porcdto,7,3))+"%")
									.grid1.col=6
									.grid1.row=.grid1.rows-1
					      			.grid1.text="-"+allt(str(thisform.acu*porcdto/100,10,2))
									thisform.acu=thisform.acu+ConverNro(.grid1.text)
									haydescuento="S"
								endif
							case opcion=2
								if paso=1
									.grid1.col=2
									.grid1.text="CARGO"
									.grid1.col=4
									.grid1.text=allt(descri)
									.grid1.col=5
									.grid1.text=allt(str(porccar,7,3))+"%"
									filaux=.grid1.row-1
									.grid1.col=6
									caraux=ConverNro(.grid1.text)
									incremento=0
									for i=1 to filaux
										.grid1.row=i
										incremento=incremento+ConverNro(.grid1.text)
									next i
									.grid1.row=filaux+1
									.grid1.text=allt(str(incremento*porccar/100,10,2))
									do case
										case ConverNro(.grid1.text)>caraux
											dife=ConverNro(.grid1.text)-caraux
											thisform.acu=thisform.acu+dife
										case ConverNro(.grid1.text)<caraux
											dife=caraux-ConverNro(.grid1.text)
											thisform.acu=thisform.acu-dife
									endcase
								else					
									.grid1.additem(" "+chr(9)+" "+chr(9)+"CARGO"+chr(9)+" "+chr(9)+allt(descri)+chr(9)+allt(str(porccar,7,3))+"%")
									.grid1.col=6
									.grid1.row=.grid1.rows-1
					      			.grid1.text=allt(str(thisform.acu*porccar/100,10,2))
									thisform.acu=thisform.acu+ConverNro(.grid1.text)
									fila=.grid1.rows-1
									haycargo="S"
								endif
								on key label INS do advertencia with fila
						endcase
					endwith
					alternati="N"
				else		
					if paso=1
						.grid1.col=0
						.grid1.text=allt(str(aux))
						.grid1.col=1
						.grid1.text=allt(cant)
						.grid1.col=2
						.grid1.text=cur_arti.art_med
						.grid1.col=3
						cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
						.grid1.text=cadena
						.grid1.col=4
						if codigo=4 or codigo=5
							.grid1.text=allt(descrip)
						else
							.grid1.text=allt(descri)
						endif
						.grid1.col=5
						.grid1.text=allt(pruni)
						if .check1.value=1
							.grid1.col=7
							.grid1.text="SS"
						endif
						.grid1.col=6
						if auximpo<>ConverNro(prtot)
							thisform.acu=thisform.acu-ConverNro(.grid1.text)
							.grid1.text=prtot
							if .text19.value>0
								auxiva=auxiva*((100-.text19.value)/100)
								auximpo=auximpo*((100-.text19.value)/100)
							endif
							do case
								case cur_arti.art_alicuota=1	
									thisform.impo1=thisform.impo1-auximpo
									if cond=2
										.text9.value=.text9.value-auxiva
									endif
								case cur_arti.art_alicuota=2
									thisform.impo2=thisform.impo2-auximpo
									if cond=2
										.text11.value=.text11.value-auxiva
									endif
							endcase
							thisform.acu=thisform.acu+ConverNro(prtot)
						else
							if auxalic<>cur_arti.art_alicuota
								do case
									case auxalic=thisform.impiva1
										thisform.impo1=thisform.impo1-ConverNro(prtot)
										if cond=2
											.text9.value=.text9.value-(ConverNro(prtot)*auxalic/100)
										endif
									case auxalic=thisform.impiva2
										thisform.impo2=thisform.impo2-ConverNro(prtot)
										if cond=2
											.text11.value=.text11.value-(ConverNro(prtot)*auxalic/100)
										endif
								endcase
							endif
							localiz=0
						endif
						localiz=1
		*!*					paso=0
					else
						if insertar=0
							thisform.nitem=thisform.nitem+1
							cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
							.grid1.additem(alltrim(str(thisform.nitem))+chr(9)+trim(cant)+chr(9)+art_med+chr(9)+cadena+chr(9)+allt(descri)+chr(9)+allt(pruni)+chr(9)+prtot)
							if .check1.value=1
								.grid1.row=.grid1.rows-1
								.grid1.col=7
								.grid1.text="SS"
							endif
						endif
						thisform.acu=thisform.acu+ConverNro(prtot)
					endif
					opcion=0
					valorcadena=thisform.valorcadena
					codiprov=thisform.codiprov
					on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
				endif
				if thisform.nitem=1
					.command4.enabled=.T.
				endif
				if paso=0
					this.grid1.row=this.grid1.rows-1
				endif
				this.grid1.col=8
				do case
					case cur_arti.art_alicuota=1
						this.grid1.text=allt(str(thisform.impiva1,10,2))
					case cur_arti.art_alicuota=2
						this.grid1.text=allt(str(thisform.impiva2,10,2))
				endcase
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=0
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=1
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=6
				this.grid1.col=2
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=3
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=4
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=0
				this.grid1.col=5
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				this.grid1.col=6
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				this.grid1.col=7
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				this.grid1.col=8
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				this.grid1.col=9
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				SET POINT TO
			endwith
			codigo=0
			paso=0
		endif
		if localiz=1 and thisform.nitem>0
			with thisform
				SET POINT TO "."
				if cond=4 or cond=5
					.text24.value=thisform.acu
					.text10.value=.text24.value
				else
					.text8.value=thisform.acu
					.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
					.text18.value=.text8.value-.text17.value
					.text24.value=(.text18.value*.text25.value)/100
					if .text19.value>0
						do case
							case cur_arti.art_alicuota=1
								.grid1.col=6
								thisform.impo1=thisform.impo1+(ConverNro(prtot)*((100-.text19.value)/100))
								if cond=2
									.text9.value=.text9.value+(ConverNro(prtot)*((100-.text19.value)/100)*thisform.impiva1/100)
								else
									auxiacneto=thisform.acun1
									thisform.acun1=thisform.acun1+((ConverNro(prtot)*((100-.text19.value)/100))/(1+(thisform.impiva1/100)))
									thisform.acu1=thisform.acu1+(thisform.acun1-auxiacneto)*thisform.impiva1/100
								endif
							case cur_arti.art_alicuota=2
								.grid1.col=6
								thisform.impo2=thisform.impo2+(ConverNro(prtot)*((100-.text19.value)/100))
								if cond=2
									.text11.value=.text11.value+(ConverNro(prtot)*((100-.text19.value)/100)*thisform.impiva2/100)
								else
									auxiacneto=thisform.acun2
									thisform.acun2=thisform.acun2+((ConverNro(prtot)*((100-.text19.value)/100))/(1+(thisform.impiva2/100)))
									thisform.acu2=thisform.acu2+(thisform.acun2-auxiacneto)*thisform.impiva2/100
								endif
						endcase
					else
						do case
							case cur_arti.art_alicuota=1
								.grid1.col=6
								thisform.impo1=thisform.impo1+ConverNro(prtot)
								if cond=2
									.text9.value=.text9.value+((ConverNro(prtot))*thisform.impiva1/100)
								else
									auxiacneto=thisform.acun1
									thisform.acun1=thisform.acun1+(ConverNro(prtot)/(1+(thisform.impiva1/100)))
									thisform.acu1=thisform.acu1+(thisform.acun1-auxiacneto)*thisform.impiva1/100
								endif
							case cur_arti.art_alicuota=2
								.grid1.col=6
								thisform.impo2=thisform.impo2+ConverNro(prtot)
								if cond=2
									.text11.value=.text11.value+((ConverNro(prtot))*thisform.impiva2/100)
								else
									auxiacneto=thisform.acun2
									thisform.acun2=thisform.acun2+(ConverNro(prtot)/(1+(thisform.impiva2/100)))
									thisform.acu2=thisform.acu2+(thisform.acun2-auxiacneto)*thisform.impiva2/100
								endif
						endcase
					endif
					.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
				ENDIF
				SET POINT TO
			endwith
			thisform.grid1.toprow=thisform.nitem
		endif
		store 0 to localiz,muestro
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 9 of Altas .F.
		localiz=0
		thisform.nitem=0
		_screen.xopcpra=""
		on key label INS
		menusel=''
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE dolarizar
		LPARAMETERS ndolar
		
		LOCAL xdcan,xdprec,xdsub,xdtot
		STORE 0 TO thisform.acu,thisform.impo1,thisform.impo2,thisform.acun1,thisform.acun2,thisform.acu1,thisform.acu2,xdcan,xdprec,xdsub,xdtot, ;
				   thisform.text9.Value,thisform.text11.value
		
		FOR pes=1 TO thisform.grid1.rows-1
			xdsub=0
			xdtot=0
			
			with thisform
				.grid1.row=pes
				.grid1.col=1
				SET POINT TO "."
				xdcan=ConverNro(.grid1.text)
				.grid1.col=5
				xdprec=ConverNro(.grid1.text)
				xdsub=xdprec/ndolar
				xdtot=xdcan*xdsub
				.grid1.text=ALLTRIM(STR(xdsub,10,4))
				.grid1.col=6
				.grid1.text=ALLTRIM(STR(xdtot,10,3))
				thisform.acu=thisform.acu+xdtot
				.grid1.col=8
				if cond=4 or cond=5
					.text24.value=thisform.acu
					.text10.value=.text24.value
				else
					.text8.value=thisform.acu
					.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
					.text18.value=.text8.value-.text17.value
					.text24.value=(.text18.value*.text25.value)/100
					if .text19.value>0
						do case
							case ConverNro(.grid1.text)=thisform.impiva1
								thisform.impo1=thisform.impo1+(xdtot*((100-.text19.value)/100))
								if cond=2
									.text9.value=.text9.value+(xdtot*((100-.text19.value)/100)*thisform.impiva1/100)
								else
									auxiacneto=thisform.acun1
									thisform.acun1=thisform.acun1+((xdtot*((100-.text19.value)/100))/(1+(thisform.impiva1/100)))
									thisform.acu1=thisform.acu1+(thisform.acun1-auxiacneto)*thisform.impiva1/100
								endif
							case ConverNro(.grid1.text)=thisform.impiva2
								thisform.impo2=thisform.impo2+(xdtot*((100-.text19.value)/100))
								if cond=2
									.text11.value=.text11.value+(xdtot*((100-.text19.value)/100)*thisform.impiva2/100)
								else
									auxiacneto=thisform.acun2
									thisform.acun2=thisform.acun2+((xdtot*((100-.text19.value)/100))/(1+(thisform.impiva2/100)))
									thisform.acu2=thisform.acu2+(thisform.acun2-auxiacneto)*thisform.impiva2/100
								endif
						endcase
					else
						do case
							case ConverNro(.grid1.text)=thisform.impiva1
								thisform.impo1=thisform.impo1+xdtot
								if cond=2
									.text9.value=.text9.value+((xdtot)*thisform.impiva1/100)
								else
									auxiacneto=thisform.acun1
									thisform.acun1=thisform.acun1+(xdtot/(1+(thisform.impiva1/100)))
									thisform.acu1=thisform.acu1+(thisform.acun1-auxiacneto)*thisform.impiva1/100
								endif
							case ConverNro(.grid1.text)=thisform.impiva2
								thisform.impo2=thisform.impo2+xdtot
								if cond=2
									.text11.value=.text11.value+((xdtot)*thisform.impiva2/100)
								else
									auxiacneto=thisform.acun2
									thisform.acun2=thisform.acun2+(xdtot/(1+(thisform.impiva2/100)))
									thisform.acu2=thisform.acu2+(thisform.acun2-auxiacneto)*thisform.impiva2/100
								endif
						endcase
					endif
					.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
				ENDIF
				SET POINT TO
			endwith	
		NEXT pes
		*!*	MESSAGEBOX("Los precios fueron convertidos exitosamente.",64,"Aviso del Sistema")
	ENDPROC

	PROCEDURE Init
		parameter cond,codiprov
		public elimi,aux,descrip,muestro,insertar,observ,cantreg,postal,locali,provi, ;
		       impiva1,impiva2,codiva,opcion,dato1,dato2,dato3,dato4,cant,descri, ;
			   pruni,prtot,borra,alternati,localiz,ivaant,ivaact,iva,codr,dato1, ;
			   proveedor,porcdto,porccar,fila,haydescuento,haycargo, ;
			   incremento,filaux,codigo,nitem,buscar,paso
		PUBLIC auxiacneto,auximpo,auxacuneto,auxiva,auxalic
		
		store 0 to auxiacneto,auxacuneto,auxiva,auxailc
		
		_screen.xopcpra="RE"
		
		set date british
		set cent on
		set deleted on
		observ=""
		paso=0
		thisform.valorcadena=valorcadena
		thisform.acu=0
		elimi=0
		aux=0
		descrip=""
		insertar=0
		cantreg=0
		borra=0
		prtot=""
		pruni=""
		codigo=0
		thisform.nitem=0
		codr=0
		porcdto=0
		porccar=0
		opcion=0
		fila=0
		alternati="N"
		haydescuento="N"
		haycargo="N"
		incremento=0
		filaux=0
		buscar=1
		
		this.text13.value=date()
		STORE 0 TO this.text7.value, ;
				   this.text14.value, ;
				   this.text19.value, ;
				   this.text25.value, ;
				   this.text24.value, ;
				   this.text26.value, ;
				   this.text27.value, ;
				   this.text8.Value, ;
				   this.text17.Value, ;
				   this.text18.Value, ;
				   this.text9.Value, ;
				   this.text11.Value, ;
				   this.text15.Value, ;
				   this.text20.Value, ;
				   this.text10.Value, ;
				   this.text23.Value
		frmaltare= conectar_db(_screen.cn)
			SQLEXEC(frmaltare,"select * from iva order by iva_codi desc limit 1;","cur_iva")
		desconectar_db(frmaltare)
		codiva=cur_iva.iva_codi
		thisform.impiva1=cur_iva.iva_1
		thisform.impiva2=cur_iva.iva_2
		ivaant=thisform.impiva1
		thisform.label12.caption=allt(str(thisform.impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(thisform.impiva2,10,2))+"%"
		if thisform.valorcadena="Por Artículo"
			codiprov=0
			proveedor=" "
			do form provload with proveedor,codiprov
			IF codiprov=0
				thisform.Release
			ELSE
				thisform.codiprov=codiprov
			ENDIF
		ELSE
			thisform.codiprov=codiprov
			postal=cur_prov.cp_nro
			locali=cur_prov.loca_nomb
			provi=cur_prov.provi_nomb
		ENDIF
		cond=cur_prov.cond_codi
		localiz=0
		muestro=0
		with thisform
			.text22.value=cur_prov.prov_ultiletra
			.text27.value=cur_prov.prov_ultipto
			.text1.value=allt(str(cur_prov.prov_codi))+" - "+cur_prov.prov_nomb
			.text2.value=cur_prov.prov_domi
			.text3.value=postal
			.text4.value=locali
			.text5.value=provi
			.text6.value=cur_prov.cond_desc
			.text12.value=VAL(cur_prov.prov_cuit)
			if cur_prov.percepcion="S"
				.label18.enabled=.T.
				.label19.enabled=.T.
				.text15.enabled=.T.
				.text20.enabled=.T.
				.text16.value=0
				.text21.value=0
			else
				.label18.enabled=.F.
				.label19.enabled=.F.
				.text15.enabled=.F.
				.text20.enabled=.F.
				.text16.value=0
				.text21.value=0
			ENDIF
			if menusel="Por Orden de Compra"
				LOCAL xselar
				STORE 0 TO xselar
				this.btn_pesos.Visible= .T.
				thisform.nitem=1
				SET POINT TO "."
				for i=1 to itemsrec.lstorden.listcount
					xselar=val(itemsrec.lstorden.list(i,7))
					SET DECIMALS TO 4
					frmaltare= conectar_db(_screen.cn)
						SQLEXEC(frmaltare,"select a.*,b.*,c.* from compras_articulos a inner join articulos b on a.art_codi=b.art_codi LEFT OUTER JOIN desc_articulos_proveedores c on c.dap_codi=a.dap_codi where a.artord_codi=?xselar;","cur_arsel")
					desconectar_db(frmaltare)
					SET DECIMALS TO
					if cur_arsel.art_codi=4 or cur_arsel.art_codi=5
						cantidad=ConverNro(itemsrec.lstorden.list(i,2))
						cadena=allt(repl("0",8-len(allt(str(cur_arsel.art_codi))))+allt(str(cur_arsel.art_codi)))
						this.grid1.additem(allt(str(thisform.nitem))+chr(9)+allt(str(cantidad,10,3))+chr(9)+cur_arsel.art_med+chr(9)+cadena+chr(9)+ ;
												cur_arsel.artord_dasc+chr(9)+allt(str(cur_arsel.artord_precio,15,4))+chr(9)+ ;
												allt(str(cantidad*cur_arsel.artord_precio,10,4))+chr(9)+""+chr(9)+""+chr(9)+ ;
												allt(itemsrec.lstorden.list(i,6))+CHR(9)+allt(itemsrec.lstorden.list(i,7)))
						thisform.acu=thisform.acu+(cantidad*cur_arsel.artord_precio)
						thisform.nitem=thisform.nitem+1
					else
						cantidad=ConverNro(itemsrec.lstorden.list(i,2))
						cadena=allt(repl("0",8-len(allt(str(cur_arsel.art_codi))))+allt(str(cur_arsel.art_codi)))
						this.grid1.additem(allt(str(thisform.nitem))+chr(9)+allt(str(cantidad,10,3))+chr(9)+cur_arsel.art_med+chr(9)+cadena+chr(9)+ ;
												cur_arsel.art_desc+chr(9)+allt(str(cur_arsel.artord_precio,15,4))+chr(9)+ ;
												allt(str(cantidad*cur_arsel.artord_precio,10,4))+chr(9)+""+chr(9)+""+chr(9)+ ;
												allt(itemsrec.lstorden.list(i,6))+CHR(9)+allt(itemsrec.lstorden.list(i,7)))
						if cur_arsel.dap_codi>0
							this.grid1.row=thisform.nitem
							this.grid1.col=4
							this.grid1.text=" "
							this.grid1.text=cur_arsel.dap_desc
						endif
						thisform.acu=thisform.acu+(cantidad*cur_arsel.artord_precio)
						thisform.nitem=thisform.nitem+1
					endif
					this.grid1.row=this.grid1.rows-1
					this.grid1.col=8
					do case
						case cur_arsel.art_alicuota=1
							this.grid1.text=allt(str(thisform.impiva1,10,2))
						case cur_arsel.art_alicuota=2
							this.grid1.text=allt(str(thisform.impiva2,10,2))
					endcase
					this.grid1.cellfontname="Courier New"
					this.grid1.cellfontsize=8
					this.grid1.cellalignment=3
					this.grid1.col=0
					this.grid1.cellfontname="Courier New"
					this.grid1.cellfontsize=8
					this.grid1.cellalignment=3
					this.grid1.col=1
					this.grid1.cellfontname="Courier New"
					this.grid1.cellfontsize=8
					this.grid1.cellalignment=6
					this.grid1.col=2
					this.grid1.cellfontname="Courier New"
					this.grid1.cellfontsize=8
					this.grid1.cellalignment=3
					this.grid1.col=3
					this.grid1.cellfontname="Courier New"
					this.grid1.cellfontsize=8
					this.grid1.cellalignment=3
					this.grid1.col=4
					this.grid1.cellfontname="Courier New"
					this.grid1.cellfontsize=8
					this.grid1.cellalignment=0
					this.grid1.col=5
					this.grid1.cellfontname="Courier New"
					this.grid1.cellfontsize=8
					this.grid1.cellalignment=8
					this.grid1.col=6
					this.grid1.cellfontname="Courier New"
					this.grid1.cellfontsize=8
					this.grid1.cellalignment=8
					prtot=allt(this.grid1.text)
					this.grid1.col=7
					this.grid1.cellfontname="Courier New"
					this.grid1.cellfontsize=8
					this.grid1.cellalignment=8
					this.grid1.col=8
					this.grid1.cellfontname="Courier New"
					this.grid1.cellfontsize=8
					this.grid1.cellalignment=8
					this.grid1.col=9
					this.grid1.cellfontname="Courier New"
					this.grid1.cellfontsize=8
					this.grid1.cellalignment=8
					with thisform
						if cond=4 or cond=5
							.text24.value=thisform.acu
							.text10.value=.text24.value
						else
							.text8.value=thisform.acu
							.text18.value=.text8.value
							.text24.value=(.text18.value*.text25.value)/100
							do case
								case cur_arsel.art_alicuota=1
									.grid1.col=6
									thisform.impo1=thisform.impo1+ConverNro(.grid1.text)
									if cond=2
										.text9.value=.text9.value+((ConverNro(prtot))*thisform.impiva1/100)
									else
										auxiacneto=thisform.acun1
										thisform.acun1=thisform.acun1+(ConverNro(prtot)/(1+(thisform.impiva1/100)))
										thisform.acu1=thisform.acu1+(thisform.acun1-auxiacneto)*thisform.impiva1/100
									endif
								case cur_arsel.art_alicuota=2
									.grid1.col=6
									thisform.impo2=thisform.impo2+ConverNro(.grid1.text)
									if cond=2
										.text11.value=.text11.value+((ConverNro(prtot))*thisform.impiva2/100)
									else
										auxiacneto=thisform.acun2
										thisform.acun2=thisform.acun2+(ConverNro(prtot)/(1+(thisform.impiva2/100)))
										thisform.acu2=thisform.acu2+(thisform.acun2-auxiacneto)*thisform.impiva2/100
									endif
							endcase
							.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
						endif			
					endwith
					skip
				next i
				SET POINT TO
				i=i-1
				if thisform.nitem>1
					thisform.nitem=thisform.nitem-1
				endif
				itemsrec.release
				.command4.enabled=.T.
				menusel=''
			endif
		ENDWITH
		impiva1=thisform.impiva1
		impiva2=thisform.impiva2
		codiprov=thisform.codiprov
		on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		
	ENDPROC

	PROCEDURE Load
		set skip of bar 9 of Altas .T.
	ENDPROC

	PROCEDURE pesificar
		LPARAMETERS ndolar
		
		LOCAL xdcan,xdprec,xdsub,xdtot
		STORE 0 TO thisform.acu,thisform.impo1,thisform.impo2,thisform.acun1,thisform.acun2,thisform.acu1,thisform.acu2,xdcan,xdprec,xdsub,xdtot, ;
				   thisform.text9.Value,thisform.text11.value
		
		FOR pes=1 TO thisform.grid1.rows-1
			xdsub=0
			xdtot=0
			
			with thisform
				.grid1.row=pes
				.grid1.col=1
				SET POINT TO "."
				xdcan=ConverNro(.grid1.text)
				.grid1.col=5
				xdprec=ConverNro(.grid1.text)
				xdsub=xdprec*ndolar
				xdtot=xdcan*xdsub
				.grid1.text=ALLTRIM(STR(xdsub,10,4))
				.grid1.col=6
				.grid1.text=ALLTRIM(STR(xdtot,10,3))
				thisform.acu=thisform.acu+xdtot
				.grid1.col=8
				if cond=4 or cond=5
					.text24.value=thisform.acu
					.text10.value=.text24.value
				else
					.text8.value=thisform.acu
					.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
					.text18.value=.text8.value-.text17.value
					.text24.value=(.text18.value*.text25.value)/100
					if .text19.value>0
						do case
							case ConverNro(.grid1.text)=thisform.impiva1
								thisform.impo1=thisform.impo1+(xdtot*((100-.text19.value)/100))
								if cond=2
									.text9.value=.text9.value+(xdtot*((100-.text19.value)/100)*thisform.impiva1/100)
								else
									auxiacneto=thisform.acun1
									thisform.acun1=thisform.acun1+((xdtot*((100-.text19.value)/100))/(1+(thisform.impiva1/100)))
									thisform.acu1=thisform.acu1+(thisform.acun1-auxiacneto)*thisform.impiva1/100
								endif
							case ConverNro(.grid1.text)=thisform.impiva2
								thisform.impo2=thisform.impo2+(xdtot*((100-.text19.value)/100))
								if cond=2
									.text11.value=.text11.value+(xdtot*((100-.text19.value)/100)*thisform.impiva2/100)
								else
									auxiacneto=thisform.acun2
									thisform.acun2=thisform.acun2+((xdtot*((100-.text19.value)/100))/(1+(thisform.impiva2/100)))
									thisform.acu2=thisform.acu2+(thisform.acun2-auxiacneto)*thisform.impiva2/100
								endif
						endcase
					else
						do case
							case ConverNro(.grid1.text)=thisform.impiva1
								thisform.impo1=thisform.impo1+xdtot
								if cond=2
									.text9.value=.text9.value+((xdtot)*thisform.impiva1/100)
								else
									auxiacneto=thisform.acun1
									thisform.acun1=thisform.acun1+(xdtot/(1+(thisform.impiva1/100)))
									thisform.acu1=thisform.acu1+(thisform.acun1-auxiacneto)*thisform.impiva1/100
								endif
							case ConverNro(.grid1.text)=thisform.impiva2
								thisform.impo2=thisform.impo2+xdtot
								if cond=2
									.text11.value=.text11.value+((xdtot)*thisform.impiva2/100)
								else
									auxiacneto=thisform.acun2
									thisform.acun2=thisform.acun2+(xdtot/(1+(thisform.impiva2/100)))
									thisform.acu2=thisform.acu2+(thisform.acun2-auxiacneto)*thisform.impiva2/100
								endif
						endcase
					endif
					.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
				ENDIF
				SET POINT TO
			endwith	
		NEXT pes
		MESSAGEBOX("Los precios fueron convertidos exitosamente.",64,"Aviso del Sistema")
	ENDPROC

	PROCEDURE btn_deta.Click
		IF LEN(ALLTRIM(cur_prov.prov_deta)) > 0
			MESSAGEBOX(ALLTRIM(cur_prov.prov_deta),64,"Detalles Adicionales del Proveedor")
		ELSE
			MESSAGEBOX("No hay detalles ingresados para este proveedor",48,"Detalles Adicionales del Proveedor")
		ENDIF
		
	ENDPROC

	PROCEDURE btn_pesos.btn.Click
		LOCAL xdolar
		STORE 0 TO xdolar
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select param_impo from parametros where param_codi=14;","cur_dolar")
		desconectar_db(frmaltafac)
		
		xdolar=cur_dolar.param_impo
		
		IF thisform.estadolar=0
			SET POINT TO ","
			pesos=MESSAGEBOX("La cotización de dolar actual es de $ "+ALLTRIM(STR(xdolar,10,2))+".-"+CHR(13)+CHR(13)+ ;
							 "¿Convierte los precios de la orden de compra a pesos con esta cotización?",4+32+256,"Aviso del Sistema")
			SET POINT TO
		
			IF pesos=6
				thisform.pesificar(xdolar)
				thisform.xdolar=xdolar
				thisform.estadolar=1
			ELSE
				DO FORM dolarizar WITH xdolar TO cxdolar
				IF cxdolar.Prop01>0
					thisform.pesificar(cxdolar.Prop01)
					thisform.xdolar=cxdolar.Prop01
					thisform.estadolar=1
				ELSE
					thisform.xdolar=0
					thisform.estadolar=0
				ENDIF
			ENDIF
		ELSE
			SET POINT TO ","
			ppdol=MESSAGEBOX("Los precios ya fueron convertidos a pesos con la cotización de $ "+ALLTRIM(STR(thisform.xdolar,10,2))+".-"+CHR(13)+ ;
							 "Antes de convertir nuevamente debe volver los precios al estado inicial."+CHR(13)+CHR(13)+ ;
							 "¿Procede con este cambio?",4+48+256,"Aviso del Sistema")
			SET POINT TO
			IF ppdol=6
				thisform.dolarizar(thisform.xdolar)
				thisform.xdolar=0
				thisform.estadolar=0
				
				DO FORM dolarizar WITH xdolar TO cxdolar
				
				IF cxdolar.Prop01>0
					thisform.pesificar(cxdolar.Prop01)
					thisform.xdolar=cxdolar.Prop01
					thisform.estadolar=1
				ELSE
					thisform.xdolar=0
					thisform.estadolar=0
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE btn_pesos.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE btn_pesos.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE btn_pesos.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE Check1.Click
		do case
			case this.value=1
				preg=messagebox("¿Confirma que recepciona todo sin mover Stock?",4+48+256,"Advertencia")
				if preg=6
					if thisform.grid1.rows>1
						thisform.grid1.col=7
						for i=1 to thisform.grid1.rows-1
							thisform.grid1.row=i
							thisform.grid1.text="SS"
						next i
						thisform.grid1.row=1
					endif
				else
					this.value=0
				endif
			case this.value=0
				preg=messagebox("¿Confirma que recepciona todo moviendo Stock?",4+48+256,"Advertencia")
				if preg=6
					if thisform.grid1.rows>1
						thisform.grid1.col=7
						for i=1 to thisform.grid1.rows-1
							thisform.grid1.row=i
							thisform.grid1.text=""
						next i
						thisform.grid1.row=1
					endif
				else
					this.value=1
				endif
		endcase
	ENDPROC

	PROCEDURE Check2.Click
		if this.value=1
			pag=messagebox("¿Confirma imputar esta Factura como Pagada?",4+48+256,"Recepciones")
			if pag=6
				this.value=1
			else
				this.value=0
			endif
		else
			if this.value=0
				pag=messagebox("¿Confirma imputar esta Factura como NO Pagada?",4+48+256,"Recepciones")
				if pag=6
					this.value=0
				else
					this.value=1
				endif
			endif
		endif
		
	ENDPROC

	PROCEDURE Check3.Click
		if this.value=1
			pag=messagebox("¿Confirma Asentar esta factura en la Cuenta Corriente?",4+48+256,"Recepciones")
			if pag=6
				this.value=1
			else
				this.value=0
			endif
		else
			if this.value=0
				pag=messagebox("¿Confirma NO Asentar esta factura en la Cuenta Corriente?",4+48+256,"Recepciones")
				if pag=6
					this.value=0
				else
					this.value=1
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Command1.Click
		salir=messagebox("¿Seguro que desea Salir?",4+32+256,"Verifique!!!")
		if salir=6
			thisform.release
		endif
		
	ENDPROC


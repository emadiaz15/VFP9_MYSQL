				   "thisform.impo2: "+allt(str(thisform.impo2,10,2))+chr(13)+ ;
				   "ivari: "+allt(str(thisform.impo1*thisform.impiva1/100,10,2))+chr(13)+ ;
				   "ivarni: "+allt(str(thisform.impo2*thisform.impiva2/100,10,2)))
	ENDPROC


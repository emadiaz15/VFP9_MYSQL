		*** ActiveX Control Method ***
		LPARAMETERS item, index
		
	ENDPROC

	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
		
	ENDPROC

	PROCEDURE grid1.DblClick
		*** ActiveX Control Event ***
		local x,y
		if thisform.nitem>0
			this.col=0
			aux=val(this.text)
			this.col=3
			dato1=val(this.text)
			this.col=1
			dato2=this.text
			this.col=4
			dato3=this.text
			descri=dato3
			this.col=5
			dato4=this.text
			pruni=dato4
			this.col=6
			prtot=this.text
			this.col=2
			dato5=this.text
			this.col=8
			auxalic=ConverNro(this.text)
			do case
				case this.text="DTO"
					opcion=1
					codigo=0
				case this.text="CARGO"
					opcion=2
					codigo=0
				other case
					this.col=7
					if this.text="SS"
						opcion=3
					else
						opcion=0
					endif
			ENDCASE
			frmaltare= conectar_db(_screen.cn)
				SQLEXEC(frmaltare,"select * from articulos where art_codi=?dato1;","cur_arti")
			desconectar_db(frmaltare)
			impiva1=thisform.impiva1
			impiva2=thisform.impiva2
			valorcadena=thisform.valorcadena
			do form modippreg with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
			localiz=0
		endif
		if borra=6
			with thisform
				if this.rows=2
					this.col=8
					do case
						case ConverNro(this.text)=thisform.impiva1
							ivaencol=1
						case ConverNro(this.text)=thisform.impiva2
							ivaencol=2
					endcase
					this.col=6
					prtot=this.text
					thisform.nitem=thisform.nitem-1
					this.rows=1
					thisform.acu=0
					.text8.value=""
					.text9.value=""
					.text10.value=""
					.text11.value=""
					.text17.value=""
					.text18.value=""
					.text19.value=0
				else
					this.col=8
					do case
						case ConverNro(this.text)=thisform.impiva1
							ivaencol=1
						case ConverNro(this.text)=thisform.impiva2
							ivaencol=2
					endcase
					this.col=6
					prtot=this.text
					thisform.acu=thisform.acu-ConverNro(this.text)
					thisform.nitem=thisform.nitem-1
					this.removeitem(this.row)
					this.col=2
					x=1
					y=0
					do while x<=this.rows-1
						this.row=x
						y=y+1
						this.col=0
						this.text=allt(str(y))
						x=x+1
					enddo
				endif
				thisform.text8.value=thisform.acu
				if thisform.text19.value>0
					dtopie=round((100-thisform.text19.value)/100,2)
					thisform.text17.value=thisform.acu*dtopie
					thisform.text18.value=thisform.acu-thisform.text17.value
					do case
						case ivaencol=1
							thisform.impo1=thisform.impo1-(ConverNro(prtot)*dtopie)
							if cond=2
								thisform.text9.value=thisform.text9.value-round((ConverNro(prtot)*dtopie)*thisform.impiva1/100,2)
							else
								auxiacneto=thisform.acun1
								thisform.acun1=thisform.acun1-((ConverNro(prtot)*ConverNro(allt("0"+"."+allt(str(100-.text19.value)))))/(1+(thisform.impiva1/100)))
								thisform.acu1=thisform.acu1-(thisform.acun1-auxiacneto)*thisform.impiva1/100
							endif
						case ivaencol=2
							thisform.impo2=thisform.impo2-(ConverNro(prtot)*dtopie)
							if cond=2
								thisform.text11.value=thisform.text11.value-round((ConverNro(prtot)*dtopie)*thisform.impiva2/100,2)
							else
								auxiacneto=thisform.acun2
								thisform.acun2=thisform.acun2-((ConverNro(prtot)*ConverNro(allt("0"+"."+allt(str(100-.text19.value)))))/(1+(thisform.impiva2/100)))
								thisform.acu2=thisform.acu2-(thisform.acun2-auxiacneto)*thisform.impiva2/100
							endif
					endcase
				else
					thisform.text18.value=thisform.acu
					do case
						case ivaencol=1
							thisform.impo1=thisform.impo1-ConverNro(prtot)
							if cond=2				
								thisform.text9.value=thisform.text9.value-round(ConverNro(prtot)*thisform.impiva1/100,2)
							else
								auxiacneto=thisform.acun1
								thisform.acun1=thisform.acun1-(ConverNro(prtot)/(1+(thisform.impiva1/100)))
								thisform.acu1=thisform.acu1-(thisform.acun1-auxiacneto)*thisform.impiva1/100
							endif
						case ivaencol=2
							thisform.impo2=thisform.impo2-ConverNro(prtot)
							if cond=2
								thisform.text11.value=thisform.text11.value-round(ConverNro(prtot)*thisform.impiva2/100,2)
							else
								auxiacneto=thisform.acun2
								thisform.acun2=thisform.acun2-(ConverNro(prtot)/(1+(thisform.impiva2/100)))
								thisform.acu2=thisform.acu2-(thisform.acun2-auxiacneto)*thisform.impiva2/100
							endif
					endcase
				endif
				.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
			endwith
			borra=0
			insertar=0
		*!*	*!*		with thisform
		*!*	*!*			this.col=6
		*!*	*!*			acu=acu-val(this.text)
		*!*	*!*			if this.rows=2
		*!*	*!*				item=item-1
		*!*	*!*				this.rows=1
		*!*	*!*				acu=0
		*!*	*!*				.text8.value=""
		*!*	*!*				.text9.value=""
		*!*	*!*				.text10.value=""
		*!*	*!*				.text11.value=""
		*!*	*!*				.text17.value=""
		*!*	*!*				.text18.value=""
		*!*	*!*				.text19.value=0
		*!*	*!*			else
		*!*	*!*				item=item-1
		*!*	*!*				this.removeitem(this.row)
		*!*	*!*				filaux=this.row
		*!*	*!*				x=1
		*!*	*!*				do while x<=this.rows-1
		*!*	*!*					this.row=x
		*!*	*!*					this.col=0
		*!*	*!*					this.text=allt(str(x))
		*!*	*!*					x=x+1
		*!*	*!*				enddo
		*!*	*!*				this.row=filaux
		*!*	*!*			endif
		*!*	*!*		endwith
		*!*	*!*		borra=0
		*!*	*!*		insertar=0
		endif
		*!*	if insertar=1 and codigo<>0
		*!*		with thisform
		*!*			this.col=0
		*!*			nro=this.row
		*!*			frmaltare= conectar_db(_screen.cn)
		*!*				SQLEXEC(frmaltare,"select * from articulos where art_codi=?codigo;","cur_arti")
		*!*			desconectar_db(frmaltare)
		*!*			this.additem(" "+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+allt(str(cur_arti.art_codi))+chr(9)+descri+chr(9)+allt(pruni)+chr(9)+prtot,.grid1.row)
		*!*			acu=acu+val(prtot)
		*!*			nitem=nitem+1
		*!*			muestro=0
		*!*			x=1
		*!*			do while x<=this.rows-1
		*!*				this.row=x
		*!*				this.col=0
		*!*				this.text=allt(str(x))
		*!*				x=x+1
		*!*			enddo
		*!*			insertar=0
		*!*		endwith
		*!*	endif
		*!*	if insertar=1 and alternati="S"
		*!*		with thisform
		*!*			.grid1.additem(" "+chr(9)+" "+chr(9)+"DTO"+chr(9)+" "+chr(9)+allt(descri)+chr(9)+allt(str(porcdto,7,3))+"%",.grid1.row)
		*!*			filaux=.grid1.row-1
		*!*			.grid1.col=6
		*!*			incremento=0
		*!*			for i=1 to filaux
		*!*				.grid1.row=i
		*!*				incremento=incremento+val(.grid1.text)
		*!*			next i
		*!*			.grid1.row=filaux+1
		*!*			.grid1.text="-"+allt(str(incremento*round((porcdto/100),2),10,2))
		*!*			acu=acu+val(.grid1.text)
		*!*			haydescuento="S"
		*!*			muestro=0
		*!*			insertar=0
		*!*		endwith
		*!*	endif
		do case
			case opcion=3
				this.col=7
				this.text="SS"
				opcion=0
			case opcion=4
				this.col=7
				this.text=""
		endcase
	ENDPROC

	PROCEDURE grid1.GotFocus
		valorcadena=thisform.valorcadena
		codiprov=thisform.codiprov
		on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		if localiz=1
			if elimi=0 and thisform.nitem>0
				this.toprow=thisform.nitem	
			else
				elimi=0
			endif
		endif
	ENDPROC

	PROCEDURE Text13.GotFocus
		codigo=0
		opcion=0
		valorcadena=thisform.valorcadena
		codiprov=thisform.codiprov
		on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		if localiz=1
			if elimi=0
				thisform.grid1.toprow=thisform.nitem
			else
				elimi=0
			endif
		endif
	ENDPROC

	PROCEDURE Text13.Valid
		frmaltare= conectar_db(_screen.cn)
			SQLEXEC(frmaltare,"select * from parametros where TRIM(param_desc)='ULTCIERCOM';","cur_cier")
		desconectar_db(frmaltare)
		if RECCOUNT("cur_cier")>0
			if this.value<=cur_cier.param_fec and this.value<>ctod("  /  /    ")
				=messagebox("Ultima fecha de cierre de Iva Compras "+dtoc(cur_cier.param_fec)+chr(13)+;
							"Imposible ingresar la recepción con esta fecha",0+48,"Advertencia!")
				this.value=ctod("  /  /    ")
				return 0
			endif
		endif
	ENDPROC

	PROCEDURE Text15.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text15.LostFocus
		IF LASTKEY()=13 THEN
			with thisform
				.text16.value=IIF(.text18.value>0,(this.value/.text18.value)*100,0)
				.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
			endwith
			thisform.grid1.SetFocus
		ELSE
			NODEFAULT
			this.SetFocus
		ENDIF
		
			
	ENDPROC

	PROCEDURE Text16.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text16.LostFocus
		if thisform.acu>0
			with thisform
				if this.value>0
					.text15.value=(.text18.value*.text16.value)/100
					.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
				else
					.text15.value=0
					.text10.value=.text18.value+.text24.value+.text9.value+.text11.value
				endif			
			endwith
		endif		
			
	ENDPROC

	PROCEDURE Text19.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text19.GotFocus
		public valdto
		valdto=this.value
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			if this.value<>valdto
				do case
					case this.value=0
						.text17.value=0
						.text18.value=.text8.value
						thisform.impo1=thisform.impo1/((100-valdto)/100)
						thisform.impo2=thisform.impo2/((100-valdto)/100)
						thisform.acun1=thisform.acun1/((100-valdto)/100)
						thisform.acun2=thisform.acun2/((100-valdto)/100)
						thisform.acu1=thisform.acu1/((100-valdto)/100)
						thisform.acu2=thisform.acu2/((100-valdto)/100)
						if cond=2
							.text9.value=.text9.value/((100-valdto)/100)
							.text11.value=.text11.value/((100-valdto)/100)
						ENDIF
						if .text15.value>0
							.text15.value=.text15.value/((100-valdto)/100)
						endif
						if .text20.value>0
							.text20.value=.text20.value/((100-valdto)/100)
						endif				
					otherwise
						.text17.value=(.text8.value*this.value)/100
						.text18.value=.text8.value-.text17.value
						.text24.value=(.text18.value*.text25.value)/100
						if cond=2
							if valdto>0
								.text9.value=.text9.value/((100-valdto)/100)
								.text11.value=.text11.value/((100-valdto)/100)
							endif
							.text9.value=.text9.value*((100-this.value)/100)
							.text11.value=.text11.value*((100-this.value)/100)
						endif
						if valdto>0
							thisform.impo1=thisform.impo1/((100-valdto)/100)
							thisform.impo2=thisform.impo2/((100-valdto)/100)
							thisform.acun1=thisform.acun1/((100-valdto)/100)
							thisform.acun2=thisform.acun2/((100-valdto)/100)
							thisform.acu1=thisform.acu1/((100-valdto)/100)
							thisform.acu2=thisform.acu2/((100-valdto)/100)
						endif
						thisform.impo1=thisform.impo1*((100-this.value)/100)
						thisform.impo2=thisform.impo2*((100-this.value)/100)
						thisform.acun1=thisform.acun1*((100-this.value)/100)
						thisform.acun2=thisform.acun2*((100-this.value)/100)
						thisform.acu1=thisform.acu1*((100-this.value)/100)
						thisform.acu2=thisform.acu2*((100-this.value)/100)
						if .text15.value>0
							.text15.value=.text15.value*((100-this.value)/100)
						endif
						if .text20.value>0
							.text20.value=.text20.value*((100-this.value)/100)
						endif
				endcase 
				.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
			endif
		endwith
	ENDPROC

	PROCEDURE Text20.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text20.LostFocus
		IF LASTKEY()=13 THEN
			with thisform
				.text21.value=IIF(.text18.value>0,(this.value/.text18.value)*100,0)
				.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
			endwith
			thisform.grid1.SetFocus
		ELSE
			NODEFAULT
			this.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE Text21.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text21.LostFocus
		if thisform.acu>0
			with thisform
				if this.value>0
					.text20.value=(.text18.value*.text21.value)/100
					.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
				else
					.text20.value=0
					.text10.value=.text18.value+.text24.value+.text9.value+.text11.value
				endif			
			endwith
		endif		
			
	ENDPROC

	PROCEDURE Text22.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text23.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text25.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text25.GotFocus
		public valng
		valng=this.value
	ENDPROC

	PROCEDURE Text25.LostFocus
		IF this.Value<>valng
			with thisform
				DO case
					CASE this.Value=0
						.text24.value=0
				otherwise
					.text24.value=(.text18.value*this.value)/100
				ENDCASE
				.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text11.value
			endwith
		ENDIF
		
	ENDPROC

	PROCEDURE Text26.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.Valid
		local cadepto,cadenro,xtip,xpto,xfac,xcadebus
		cadepto=""
		cadenro=""
		xtip=allt(thisform.text22.value)
		xpto=allt(str(thisform.text27.value))
		xfac=allt(str(this.value))
		xcadebus=ALLTRIM(STR(thisform.codiprov))+xtip+'PTO'+xpto+'NRO'+xfac+'F'
		frmaltare= conectar_db(_screen.cn)
			SQLEXEC(frmaltare,"select * from recepciones where concat(CAST(prov_codi as char),TRIM(prov_tipfac),'PTO',TRIM(CAST(prov_pto as char)),'NRO',TRIM(CAST(prov_fac as char)),TRIM(recep_conc))=?xcadebus;","cur_recexis")
		desconectar_db(frmaltare)
		if RECCOUNT("cur_recexis")>0
			cadepto=repl("0",4-len(xpto))+xpto
			cadenro=repl("0",8-len(xfac))+xfac
			messagebox("La factura Nº: "+xtip+" "+cadepto+"-"+cadenro+" de "+allt(cur_prov.prov_nomb)+" ya esta en archivo. Imposible ingresarla nuevamente",0+48,"Advertencia")
			return 0
		endif
	ENDPROC

ENDDEFINE


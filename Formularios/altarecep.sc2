		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		if thisform.text7.value=0
			messagebox("Debe ingresar obligatoriamente el número de factura del Proveedor",0+48,"Adevertencia")
			thisform.text7.setfocus
		else
		if thisform.nitem=0
			messagebox("Aún no ha ingresado ningún artículo a la Recepción, imposible terminar"+chr(13)+ ;
					   "Ingrese algún artículo presionando la tecla INSERT. Si desea salir de la"+chr(13)+ ; 
					   "rutina utilize el botón Salir o presione la tecla ESC",48,"Advertencia")
		else
			preg=messagebox("¿Confirma los datos de la Recepción?",4+32+256,"Recepciones")
			if preg=6
				with thisform
					LOCAL xcodir,xfecha,xtip,xpto,xfac,xrem,xdto,xpbt,xpiv,ximng,xcoti, ;
						  xne1,xne2,xivri,xivrni,xtot,xpag,ximpag,xcta,xdasc,xarti,xdap,;
						  xcant,xprec,xconc,xcpra,com,arten,canent,xstock,lnLock
					lnLock = 0
					xfecha=.text13.value
					xdto=.text19.value
					xtip=ALLTRIM(.text22.value)
					xpto=.text27.value
					xfac=.text7.value
					xrem=.text14.value
					xpiv=.text15.value
					xpbt=.text20.value
					xpag=''
					ximpag=0
					xconc=''
					xdasc=''
					xcpra=0
					canent=0
					xstock=''
					xdap=0
					ximng=0
					if cond=4 or cond=5 OR .text25.value>0
						ximng=.text24.value
					ELSE
						ximng=0
					ENDIF
					if cond=2
						xivri=.text9.value
						xivrni=.text11.value
					else
						xivri=thisform.acu1
						xivrni=thisform.acu2
					endif
					xne1=iif(cond=2,thisform.impo1,thisform.acun1)
					xne2=iif(cond=2,thisform.impo2,thisform.acun2)
					if .text23.value>0
						xcoti=.text23.value
						xtot=.text18.value*.text23.value
						if .check2.value=1
							ximpag=.text18.value*.text23.value
							xpag='S'
						endif
					else
						xtot=.text18.value
						if .check2.value=1
							ximpag=.text18.value
							xpag='S'
						endif
					ENDIF
					if .check3.value=1
						xcta=1
					else
						xcta=0
					endif
					frmaltare= conectar_db(_screen.cn)
						lnLock = MySQL_LockTables("LOCK", "recepciones WRITE", frmaltare)
						SQLEXEC(frmaltare,"select cast(recep_codi+1 as DECIMAL(8,0)) as recep_codi from recepciones order by recep_codi desc limit 1;","cur_nvoc")
						xcodir=cur_nvoc.recep_codi
						SQLEXEC(frmaltare,"insert into recepciones values(?xcodir,?xfecha,?thisform.codiprov,?observ,?xdto,?xtip,?xpto,?xfac,?xrem,?codiva,?xpiv,?xpbt,?ximpag,?xpag,'F',?xcoti,?ximng,?xivri,?xivrni,?xne1,?xne2,?xtot,0,?xcta,'');")
						lnLock = MySQL_LockTables("UNLOCK", "", frmaltare)
						IF xcta=1
							SQLEXEC(frmaltare,"update proveedores set prov_saldo=prov_saldo+?.text10.value,prov_ultiletra=?xtip,prov_ultipto=?xpto where prov_codi=?thisform.codiprov;")
						endif
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								xstock=''
								xdap=0
								.grid1.row=fila
								.grid1.col=2
								do case
									case .grid1.text="DTO"
										xconc="D"
										.grid1.col=4
										xdasc=allt(.grid1.text)
									case .grid1.text="CARGO"
										xconc="C"
										.grid1.col=4
										xdasc=allt(.grid1.text)
									other case
										.grid1.col=3
										xarti=val(.grid1.text)
										if xarti<=5
											.grid1.col=4
											xdasc=allt(.grid1.text)
										ELSE
											xdasc=''
										endif
										.grid1.col=1
										xcant=ConverNro(.grid1.text)
										.grid1.col=7
										if allt(.grid1.text)<>"SS"
											if xarti>5
												LOCAL stact,saldst,xcadecom,npto,nnro,xnompro
												xnompro  =ALLTRIM(thisform.text1.Value)
												npto     =REPLICATE("0",4-LEN(ALLTRIM(STR(xpto))))+ALLTRIM(STR(xpto))
												nnro     =REPLICATE("0",8-LEN(ALLTRIM(STR(xfac))))+ALLTRIM(STR(xfac))
												xcadecom ="FCP"+ALLTRIM(xtip)+"_"+ALLTRIM(npto)+"-"+ALLTRIM(nnro)+" -- "+xnompro
												.grid1.col=1
												SET DECIMALS TO 3
												SQLEXEC(frmaltare,"select art_stock from articulos where art_codi=?xarti;","cur_stac")
												stact=cur_stac.art_stock
												saldst=stact+xcant
												SQLEXEC(frmaltare,"update articulos set art_stock=art_stock+?xcant where art_codi=?xarti;")
												SQLEXEC(frmaltare,"insert into histostock values(null,?xarti,current_date(),current_time(),'E',?stact,?xcant,?saldst,?xcadecom,?observ,0,?xcodir,0,0,0,?cond,?codiprov);")
												**************************** SE CONECTA AL SERVIDOR ILUMET Y SI EXISTE EL ARTICULO MODIFICA STOCK E HISTORICO **********************************
												conexterna= conectar_db(_screen.xconext)
												IF VARTYPE(conexterna) = "N" AND conexterna> 0
													SQLEXEC(conexterna,"select * from articulos where art_codi = ?xarti;","cur_artext")
													IF USED("cur_artext")
														IF RECCOUNT("cur_artext") > 0
															SQLEXEC(conexterna,"select art_stock from articulos where art_codi=?xarti;","cur_stac")
															stact=cur_stac.art_stock
															saldst=stact+xcant
															xcadecom ="FCP"+ALLTRIM(xtip)+"(HP)_"+ALLTRIM(npto)+"-"+ALLTRIM(nnro)+" -- "+xnompro
															SQLEXEC(conexterna,"update articulos set art_stock=art_stock+?xcant where art_codi=?xarti;")
															SQLEXEC(conexterna,"insert into histostock values(null,?xarti,current_date(),current_time(),'E',?stact,?xcant,?saldst,?xcadecom,?observ,0,?xcodir,0,0,0,?cond,?codiprov);")
														ENDIF
														cerrar_cursor("cur_artext")
													ENDIF
													desconectar_db(conexterna)
												ENDIF
												*************************** FIN PROCESO SERVIDOR ILUMET *****************************************										
												SQLEXEC(frmaltare,"select * from articulos_proveedores where prov_codi=?thisform.codiprov and art_codi=?xarti;","cur_artpro")
												SET DECIMALS TO
												cerrar_cursor("cur_stac")
												IF RECCOUNT("cur_artpro")>0
													LOCAL xcadena
													.grid1.col=4
													xcadena=ALLTRIM(STR(cur_artpro.artpro_codi))+ALLTRIM(.grid1.text)
													SQLEXEC(frmaltare,"select * from desc_articulos_proveedores where concat(TRIM(cast(artpro_codi as char)),TRIM(dap_desc))=?xcadena;","cur_ddes")
													IF RECCOUNT("cur_ddes")>0
														xdap=cur_ddes.dap_codi
													ENDIF
												ENDIF
												cerrar_cursor("cur_artpro")
												cerrar_cursor("cur_ddes")
											endif
											.grid1.col=9
											if val(.grid1.text)>0
												xcpra=val(.grid1.text)
												.grid1.col=10
												arten=val(.grid1.text)
												SQLEXEC(frmaltare,"select * from compras_articulos where artord_codi=?arten;","cur_ent")
												IF RECCOUNT("cur_ent")>0
													.grid1.col=1
													if ConverNro(.grid1.text)>(cur_ent.artord_cant-cur_ent.artord_ent)
														canent=IIF(cur_ent.artord_ent>0,cur_ent.artord_cant-cur_ent.artord_ent,cur_ent.artord_cant)
														SQLEXEC(frmaltare,"update compras_articulos set artord_ent=artord_ent+?canent where artord_codi=?arten;")
		*!*													SQLEXEC(frmaltare,"update articulos set pedprov=pedprov-?canent where art_codi=?cur_ent.art_codi;")
													ELSE
														SQLEXEC(frmaltare,"update compras_articulos set artord_ent=artord_ent+?ConverNro(.grid1.text) where artord_codi=?arten;")
		*!*													SQLEXEC(frmaltare,"update articulos set pedprov=pedprov-?ConverNro(.grid1.text) where art_codi=?cur_ent.art_codi;")
													ENDIF
												ENDIF
												IF cur_ent.art_codi > 5
													Campo_ppr(cur_ent.art_codi)
												ENDIF
												do cumplicom with xcpra
											endif										
										else
											xstock='S'
										endif
								endcase
								.grid1.col=5
								xprec=ConverNro(.grid1.text)
								SQLEXEC(frmaltare,"insert into recepciones_articulos values(?xcodir,?xarti,?xcant,?xprec,?xdasc,?xconc,?xstock,?xdap,0,?xcpra);")
							endif
						next fila
					desconectar_db(frmaltare)
							
					for i=1 to .grid1.rows-1
						.grid1.row=i
						.grid1.col=3
						if val(.grid1.text)>0
							xarti=val(.grid1.text)
							.grid1.col=5
							valorcosto=ConverNro(.grid1.text)
							if .text19.value>0
								descosto=ConverNro(.grid1.text)*.text19.value/100
								valorcosto=ConverNro(.grid1.text)-descosto
							endif
							if .text25.value>0
								valorcosto=round(valorcosto+(iif(.text19.value>0,(valorcosto-descosto),valorcosto))*.text25.value/100,2)
							endif
							if haydescuento="S"
								auxfila=.grid1.row
								x=auxfila
								.grid1.col=2
								for x=auxfila to .grid1.rows-1
									.grid1.row=x
									if .grid1.text="DTO"
										.grid1.col=5
										valorcosto=round(valorcosto*((100-ConverNro(.grid1.text))/100),3)
										.grid1.col=2							
									endif
								next x
								.grid1.row=auxfila
							endif
							if haycargo="S"
								auxfila=.grid1.row
								x=auxfila
								.grid1.col=2
								for x=auxfila to .grid1.rows-1
									.grid1.row=x
									if .grid1.text="CARGO"
										.grid1.col=5
										valorcosto=round(valorcosto*(1+ConverNro(.grid1.text)/100),3)
										.grid1.col=2							
									endif
								next x
								.grid1.row=auxfila
							endif
							if .text23.value>0
								valorcosto=round(valorcosto*.text23.value,3)
							endif
							if xarti>5
								frmaltare= conectar_db(_screen.cn)
									SQLEXEC(frmaltare,"update articulos set costo_ultcpra=?valorcosto where art_codi=?xarti;")
								desconectar_db(frmaltare)
							endif
						endif
					next i
				endwith
				thisform.release
			endif
		endif
		endif
	ENDPROC


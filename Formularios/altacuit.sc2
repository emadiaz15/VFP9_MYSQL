DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 140,198,198
		BorderStyle = 0
		Caption = "Alta rápida de C.U.I.T. de Clientes"
		DoCreate = .T.
		Height = 167
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "Form1"
		Width = 399
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Aceptar", ;
		DisabledBackColor = 33,146,214, ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 164, ;
		Name = "Command1", ;
		TabIndex = 3, ;
		Themes = .F., ;
		Top = 122, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 140,198,198, ;
		Caption = "Cliente: ", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 30, ;
		Name = "Label1", ;
		TabIndex = 4, ;
		Top = 34, ;
		Width = 47
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label2' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 140,198,198, ;
		Caption = "C.U.I.T.", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 31, ;
		Name = "Label2", ;
		TabIndex = 5, ;
		Top = 76, ;
		Width = 40
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Text1' AS textbox WITH ;
		BackColor = 233,233,233, ;
		Height = 23, ;
		Left = 81, ;
		Name = "Text1", ;
		Style = 1, ;
		TabIndex = 1, ;
		Top = 29, ;
		Width = 276
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text2' AS textbox WITH ;
		Alignment = 2, ;
		Format = "K", ;
		Height = 23, ;
		InputMask = "##-########-#", ;
		Left = 81, ;
		Name = "Text2", ;
		TabIndex = 2, ;
		Top = 71, ;
		Width = 105
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		if thisform.text2.value=0
			=messagebox("Ud. ha optado por omitir el alta del C.U.I.T., la factura se imprimirá"+chr(13)+ ;
						"igualmente pero debe tener en cuenta este detalle.",0+48,"Advertencia!!!")
		ENDIF
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		parameter codicli
		frmcuit= conectar_db(_screen.cn)
			SQLEXEC(frmcuit,"select * from clientes where cli_codi=?codicli;","cur_cuit")
		desconectar_db(frmcuit)
		thisform.text1.value=cur_cuit.cli_nomb
		thisform.text2.value=cur_cuit.cli_cuit
		
	ENDPROC

	PROCEDURE Command1.Click
		co=messagebox("¿Confirma el C.U.I.T. ingresado?",4+32+256,"C.U.I.T.")
		if co=6
			if thisform.text2.value=0
				=messagebox("Debe ingresar el C.U.I.T. para finalizar el proceso",0+48,"Advertencia")
				thisform.text2.setfocus
			else
				frmcuit= conectar_db(_screen.cn)
					SQLEXEC(frmcuit,"update clientes set cli_cuit=?thisform.text2.value where cli_codi=?codicli;")
				desconectar_db(frmcuit)
				thisform.release
			endif
		endif
	ENDPROC

ENDDEFINE

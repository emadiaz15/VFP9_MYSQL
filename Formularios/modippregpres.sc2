	ADD OBJECT 'Command7' AS commandbutton WITH ;
		Caption = "", ;
		Height = 25, ;
		Left = 144, ;
		Name = "Command7", ;
		Top = 158, ;
		Width = 140
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Image1' AS image WITH ;
		BorderStyle = 1, ;
		Height = 33, ;
		Left = 115, ;
		Name = "Image1", ;
		Picture = imagen\w95mbx02.ico, ;
		Stretch = 2, ;
		Top = 29, ;
		Width = 33
		*< END OBJECT: BaseClass="image" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		Caption = "¿Qué desea hacer?", ;
		FontSize = 10, ;
		Height = 18, ;
		Left = 171, ;
		Name = "Label1", ;
		Top = 38, ;
		Width = 116
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Activate
		store 1 to localiz
	ENDPROC

	PROCEDURE Init
		parameter cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		do case
			case prompt()="Ordenes de Compra" or prompt()="Ordenes Compra"
				this.caption="Ordenes de Compra"
				this.command3.caption="\<Insertar Item"
			case prompt()="Por Presupuesto" or prompt()="Pedidos Clientes"
				public dto
				this.caption="Pedidos de Clientes"
				this.command3.caption="\<Insertar Item"
			case prompt()="Recepciones" or prompt()="Por Artículo" or prompt()="Por Orden de Compra"
				public dto
				this.caption="Recepciones"
				this.command3.caption="\<Insertar Descuento"
				do case
					case opcion=1
						this.command1.caption="\<Modificar Desc."
					case opcion=2
		                this.command1.caption="\<Modificar Cargo"
		            other case
		            	this.command1.caption="\<Modificar Item"
		        endcase
		        this.command5.visible=.T.
		        if opcion=3
					this.command5.caption="\<Recepcionar moviendo Stock"
				else
					this.command5.caption="\<Recepcionar sin mover Stock"
				endif
				this.command4.visible=.F.
				this.command6.visible=.F.
		*		this.height=130
			case prompt()="Por Artículos" or prompt()="Por Pedido de Cliente"
				public dto
				do case
					case concepto="F"
						this.caption="Facturas"
					case concepto="N"
						this.caption="Notas de Crédito"
						if opcion=6
							this.command7.caption="\<Calcular Con Iva"
						else
							this.command7.caption="\<Calcular Sin Iva"
						endif
						this.height=195
				endcase
				this.command3.caption="\<Insertar Item"
				this.command4.visible=.F.
				this.command5.visible=.T.
				this.command5.left=225
				this.command6.visible=.T.
				if opcion=3
					this.command5.caption="\<Facturar moviendo Stock"
				endif
		endcase
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			this.release
		endif
	ENDPROC

	PROCEDURE Unload
		return cond
		return opcion
	ENDPROC

	PROCEDURE Command1.Click
		paso=1
		if dato5="ALTERN"
			do form alternapresup with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		else
			if prompt()="Por Orden de Compra" or prompt()="Ordenes Compra" or prompt()="Ordenes de Compra" or prompt()="Por Artículo" or prompt()="Recepciones"
				do case
					case opcion=1
						pruni=substr(pruni,1,len(pruni)-1)
						porcdto=val(pruni)
						do form descuento with descri,porcdto
					case opcion=2
						pruni=substr(pruni,1,len(pruni)-1)
						porccar=val(pruni)
						do form cargo with descri,porccar
					other case
						descri=dato3
						do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
				endcase
			else
				descri=dato3
				do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
			endif
		endif
		thisform.release
	ENDPROC

	PROCEDURE Command2.Click
		borra=messagebox("¿Seguro que desea eliminar este Ítem?",4+32+256,"Presupuestos")
		thisform.release
		
	ENDPROC

	PROCEDURE Command3.Click
		insertar=1
		do case
			case prompt()="Pedidos Clientes"
				opcion=1
				do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
			case prompt()="Por Artículos"
				opcion=1
				do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
			case prompt()="Por Presupuesto" or prompt()="Por Nota de Pedido"
				opcion=1
				do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
			case prompt()="Ordenes de Compra" or prompt()="Ordenes Compra"
				opcion=1
				do form cualartprov with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
			case prompt()="Por Orden de Compra" or prompt()="Recepciones"
				opcion=1
				do form descuento with descri,porcdto
		other case
			do form itemoalter with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endcase
		thisform.release
	ENDPROC

	PROCEDURE Command4.Click
		thisform.release
		do case
			case prompt()="Presupuestos de Clientes"
				altapresup.grid1.col=6
				prtot=altapresup.grid1.text
				dto=val(prtot)*altapresup.text19.value/100
				ivaant=val(prtot)-dto
				ivaact=val(prtot)-dto
				iva=0
				altapresup.grid1.col=7
				if val(altapresup.grid1.text)=0
					ivaant=ivaant*impiva1/100
				else
					ivaant=ivaant*val(altapresup.grid1.text)/100
				endif
				do form calciva with iva,ivaact
				if iva>0
					dife=val(altapresup.text9.value)-ivaant
					altapresup.text9.value=str(dife+ivaact,10,2)
					dife=val(altapresup.text10.value)-ivaant
					altapresup.text10.value=str(dife+ivaact,10,2)
					altapresup.grid1.col=7
					altapresup.grid1.text=str(iva,6,2)
				endif
			case prompt()="Por Nota de Pedido"
				pedicli.grid1.col=6
				prtot=pedicli.grid1.text
				dto=val(prtot)*pedicli.text19.value/100
				ivaant=val(prtot)-dto
				ivaact=val(prtot)-dto
				iva=0
				pedicli.grid1.col=7
				if val(pedicli.grid1.text)=0
					ivaant=ivaant*impiva1/100
				else
					ivaant=ivaant*val(pedicli.grid1.text)/100
				endif
				do form calciva with iva,ivaact
				if iva>0
					dife=val(pedicli.text9.value)-ivaant
					pedicli.text9.value=str(dife+ivaact,10,2)
					dife=val(pedicli.text10.value)-ivaant
					pedicli.text10.value=str(dife+ivaact,10,2)
					pedicli.grid1.col=7
					pedicli.grid1.text=str(iva,6,2)
				endif
				muestro=0
			case prompt()="Pedidos Clientes"
				modipedicli.grid1.col=6
				prtot=modipedicli.grid1.text
				dto=val(prtot)*modipedicli.text19.value/100
				ivaant=val(prtot)-dto
				ivaact=val(prtot)-dto
				iva=0
				modipedicli.grid1.col=7
				if val(modipedicli.grid1.text)=0
					ivaant=ivaant*impiva1/100
				else
					ivaant=ivaant*val(modipedicli.grid1.text)/100
				endif
				do form calciva with iva,ivaact
				if iva>0
					dife=val(modipedicli.text9.value)-ivaant
					modipedicli.text9.value=str(dife+ivaact,10,2)
					dife=val(modipedicli.text10.value)-ivaant
					modipedicli.text10.value=str(dife+ivaact,10,2)
					modipedicli.grid1.col=7
					modipedicli.grid1.text=str(iva,6,2)
				endif
			case prompt()="Presupuestos Clientes"
				opcion=3
			case prompt()="Por Presupuesto"
				pediclixpresup.grid1.col=6
				prtot=pediclixpresup.grid1.text
				dto=val(prtot)*pediclixpresup.text19.value/100
				ivaant=val(prtot)-dto
				ivaact=val(prtot)-dto
				iva=0
				pediclixpresup.grid1.col=7
				if val(pediclixpresup.grid1.text)=0
					ivaant=ivaant*impiva1/100
				else
					ivaant=ivaant*val(pediclixpresup.grid1.text)/100
				endif
				do form calciva with iva,ivaact
				if iva>0
					dife=val(pediclixpresup.text9.value)-ivaant
					pediclixpresup.text9.value=str(dife+ivaact,10,2)
					dife=val(pediclixpresup.text10.value)-ivaant
					pediclixpresup.text10.value=str(dife+ivaact,10,2)
					pediclixpresup.grid1.col=7
					pediclixpresup.grid1.text=str(iva,6,2)
				endif
			case prompt()="Por Artículos" or prompt()="Por Pedido de Cliente"		
				altafactura.grid1.col=6
				prtot=altafactura.grid1.text
				dto=val(prtot)*altafactura.text19.value/100
				ivaant=val(prtot)-dto
				ivaact=val(prtot)-dto
				iva=0
				altafactura.grid1.col=7
				if val(altafactura.grid1.text)=0
					ivaant=ivaant*impiva1/100
				else
					ivaant=ivaant*val(altafactura.grid1.text)/100
				endif
				do form calciva with iva,ivaact
				if iva>0
					dife=val(altafactura.text9.value)-ivaant
					altafactura.text9.value=str(dife+ivaact,10,2)
					dife=val(altafactura.text10.value)-ivaant
					altafactura.text10.value=str(dife+ivaact,10,2)
					altafactura.grid1.col=7
					altafactura.grid1.text=str(iva,6,2)
				endif
			case prompt()="Ordenes de Compra"
				altaocpra.grid1.col=6
				prtot=altaocpra.grid1.text
				dto=val(prtot)*altaocpra.text19.value/100
				ivaant=val(prtot)-dto
				ivaact=val(prtot)-dto
				iva=0
				altaocpra.grid1.col=7
				if val(altaocpra.grid1.text)=0
					ivaant=ivaant*impiva1/100
				else
					ivaant=ivaant*val(altaocpra.grid1.text)/100
				endif
				do form calciva with iva,ivaact
				if iva>0
					dife=val(altaocpra.text9.value)-ivaant
					altaocpra.text9.value=str(dife+ivaact,10,2)
					dife=val(altaocpra.text10.value)-ivaant
					altaocpra.text10.value=str(dife+ivaact,10,2)
					altaocpra.grid1.col=7
					altaocpra.grid1.text=str(iva,6,2)
				endif
			case prompt()="Ordenes Compra"
				do form calciva with iva,ivaact
		endcase
		localiz=0
	ENDPROC

	PROCEDURE Command5.Click
		do case
			case opcion=0
				opcion=3
			case opcion=3
				opcion=4
		endcase
		thisform.release
	ENDPROC

	PROCEDURE Command6.Click
		opcion=5
		thisform.release
	ENDPROC

	PROCEDURE Command7.Click
		do case
			case opcion=0
				preg=messagebox("¿Confirma que calcula Sin Iva este item?",4+48+256,"Notas de Crédito")
				if preg=6
					opcion=6
				endif
			case opcion=6
				preg=messagebox("¿Confirma que calcula Con Iva este item?",4+48+256,"Notas de Crédito")
				if preg=6
					opcion=7
				endif
		endcase
		thisform.release
	ENDPROC

ENDDEFINE

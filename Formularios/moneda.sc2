DEFINE CLASS moneda AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Optiongroup1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 144,238,144
		BorderStyle = 2
		Caption = "Form1"
		DoCreate = .T.
		Height = 196
		MaxButton = .F.
		MinButton = .F.
		Name = "MONEDA"
		TitleBar = 0
		Width = 341
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 35,135,208, ;
		Caption = "Continuar", ;
		FontSize = 11, ;
		ForeColor = 255,255,255, ;
		Height = 34, ;
		Left = 224, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 155, ;
		Width = 109
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackStyle = 0, ;
		BorderStyle = 1, ;
		Caption = "Seleccione Moneda", ;
		FontBold = .T., ;
		FontSize = 18, ;
		Height = 32, ;
		Left = 57, ;
		Name = "Label1", ;
		Top = 17, ;
		Width = 226
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Optiongroup1' AS optiongroup WITH ;
		BackColor = 221,251,221, ;
		BackStyle = 0, ;
		ButtonCount = 2, ;
		Height = 70, ;
		Left = 102, ;
		Name = "Optiongroup1", ;
		Top = 71, ;
		Value = 0, ;
		Width = 136, ;
		Option1.AutoSize = .T., ;
		Option1.BackStyle = 0, ;
		Option1.Caption = "PESOS", ;
		Option1.FontBold = .T., ;
		Option1.FontSize = 15, ;
		Option1.Height = 27, ;
		Option1.Left = 10, ;
		Option1.Name = "Option1", ;
		Option1.Top = 9, ;
		Option1.Value = 0, ;
		Option1.Width = 89, ;
		Option2.AutoSize = .T., ;
		Option2.BackStyle = 0, ;
		Option2.Caption = "DOLARES", ;
		Option2.FontBold = .T., ;
		Option2.FontSize = 15, ;
		Option2.Height = 27, ;
		Option2.Left = 10, ;
		Option2.Name = "Option2", ;
		Option2.Top = 39, ;
		Option2.Width = 116
		*< END OBJECT: BaseClass="optiongroup" />
	
	PROCEDURE Init
		PARAMETERS letramon
	ENDPROC

	PROCEDURE Unload
		RETURN letramon
	ENDPROC

	PROCEDURE Command1.Click
		IF thisform.optiongroup1.Value>0
			DO CASE
				CASE thisform.optiongroup1.Value=1
					letramon='P'
				CASE thisform.optiongroup1.Value=2
					letramon='D'
			ENDCASE
			thisform.Release
		ELSE
			MESSAGEBOX("Debe seleccionar la moneda para continuar",0+48,"Aviso del Sistema")
		ENDIF
		
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=11
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=12
		this.FontBold= .T.
	ENDPROC

ENDDEFINE

	PROCEDURE Edit2.GotFocus
		PUBLIC estamayus,anot
		estamayus= CAPSLOCK()
		anot=ALLTRIM(this.Value)
		CAPSLOCK(.T.)
	ENDPROC

	PROCEDURE Edit2.LostFocus
		DO case
			CASE estamayus=.T.
				CAPSLOCK(.T.)
			CASE estamayus=.F.
				CAPSLOCK(.F.)
		ENDCASE
		frmcart= conectar_db(_screen.cn)
			SQLEXEC(frmcart,"update articulos set art_detaofi=?trim(this.value) where art_codi=?thisform.text1.value;")
		desconectar_db(frmcart)
	ENDPROC

	PROCEDURE grd_costos.Column1.Text1.DblClick
		thisform.grd_costos.HighlightStyle= 0
		
		opc=thisform.opcion
		
		do form consartpreg with opc
		
		thisform.opcion=opc
		
		thisform.text1.SetFocus
		with thisform
			do case
				case thisform.opcion=0
					.text1.setfocus
					thisform.grd_costos.HighlightStyle= 1
				case thisform.opcion=1
					.label22.visible=.T.
					.optiongroup2.visible=.T.
					.label21.visible=.T.
					.text14.visible=.T.
					.label16.visible=.T.
					.text17.visible=.T.
					set point to
					set separator to
					DO case
						CASE tmpc.moneda="P"
							.optiongroup2.value=1
						CASE tmpc.moneda="D"
							.optiongroup2.value=2
					ENDCASE
					.text14.value=tmpc.artpro_costo
					.text17.value=tmpc.artpro_ctovta
					KEYBOARD '{TAB}'+'{TAB}'
				case thisform.opcion=2
					pre=messagebox("¿Seguro que desea eliminar el costo de "+ALLTRIM(cur_costo.prov_nomb)+"?",4+48+256,"Advertencia!!!")
					if pre=6
						frmcart= conectar_db(_screen.cn)
							SQLEXEC(frmcart,"delete from articulos_proveedores where artpro_codi=?tmpc.artpro_codi;")
						desconectar_db(frmcart)
					ENDIF
					thisform.grd_costos.recordsource=""
					thisform.grd_costos.refresh
					SET DECIMALS TO 3
					frmcart= conectar_db(_screen.cn)
						IF thisform.chk_todos.Value=0
							SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
						ELSE
							SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
						ENDIF
					desconectar_db(frmcart)
					SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
					GO top
					.grd_costos.recordsource="tmpc"
					.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista,tmpc.cotiz)","Column")
					.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
					.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")
					SET DECIMALS TO
					.text1.setfocus
					thisform.grd_costos.HighlightStyle= 1				
			endcase
		endwith
	ENDPROC


	PROCEDURE Activate
		SET POINT TO ","
		SET SEPARATOR TO "."
	ENDPROC

	PROCEDURE Destroy
		set point to
		set separator to
		set decimals to
		
		&&Cerrar_cursores()
		
	ENDPROC

	PROCEDURE Init
		public opc,histcod,codigo,descri,impiva1,impiva2
		create cursor totped(pedidos N(10,2))
		create cursor historicostos(prov_nomb C(35),histo_fech D,histo_costo N(10,3),moneda C(1))
		opc=0
		thisform.opcion=0
		descri=""
		histcod=0
		set point to ","
		set separator to "."
		set date british
		set cent on
		set dele on
		SET TALK off
		SET ECHO OFF
		
		*!*	thisform.SetAll("Forecolor",RGB(0,225,0),"Textbox")
		*!*	thisform.SetAll("DisabledForecolor",RGB(0,225,0),"Textbox")
		*!*	thisform.SetAll("Backcolor",RGB(0,0,0),"Textbox")
		*!*	thisform.SetAll("DisabledBackcolor",RGB(0,0,0),"Textbox")
		thisform.SetAll("Fontbold",.t.,"Textbox")
		*!*	thisform.SetAll("Forecolor",RGB(0,225,0),"Editbox")
		*!*	thisform.SetAll("Backcolor",RGB(0,0,0),"Editbox")
		*!*	thisform.SetAll("DisabledForecolor",RGB(0,225,0),"Editbox")
		*!*	thisform.SetAll("DisabledBackcolor",RGB(0,0,0),"Editbox")
		thisform.SetAll("Fontbold",.t.,"Editbox")
		*!*	thisform.SetAll("Forecolor",RGB(0,225,0),"Grid")
		*!*	thisform.SetAll("Backcolor",RGB(0,0,0),"Grid")
		
		frmcart= conectar_db(_screen.cn)
			SQLEXEC(frmcart,"select MAX(iva_codi) as max_cod from iva;","cur_mcod")
			SQLEXEC(frmcart,"select iva_1,iva_2 from iva where iva_codi=?cur_mcod.max_cod;","cur_iva")
		desconectar_db(frmcart)
		
		impiva1=cur_iva.iva_1
		impiva2=cur_iva.iva_2
		this.text1.value=0
		with thisform
			.text9.value=CTOD("01"+"/"+"01"+"/"+ALLTRIM(STR(YEAR(DATE()))))
			.text10.value=DATE()
			.text3.value=0
			.text4.value=0
			.text5.value=0
			.text6.value=0
			.text7.value=0
			.text11.value=0
			.text12.value=0
			.text13.value=0
			.text15.value=0
			.grid1.refresh()
			.grid1.recordsource=" "
			.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista,tmpc.cotiz)","Column")
			.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
			.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")
		endwith
		create cursor cantvent(cant N(10,2))
		create cursor cantcred(ccred N(10,2))
		create cursor ventas(vtas N(10,4))
		create cursor creditos(cred N(10,4))
		create cursor recep(can N(8),cto N(10,4),concepto C(1))
		
		LOCAL vendn
		vendn=ALLTRIM(UPPER(substr(sys(0),ATC("#",sys(0))+2)))
		
		frmcart= conectar_db(_screen.cn)
			SQLEXEC(frmcart,"select * from vendedores where ven_nomb=?vendn;","cur_ven")
		desconectar_db(frmcart)
		
		LOCAL usuario
		usuario=UPPER(substr(sys(0),ATC("#",sys(0))+2))
		
		if reccount("cur_ven")>0 or usuario="CLOTILDE"
			with this
				.grd_costos.Visible= .F.
				.grid1.visible=.F.
				.label13.visible=.F.
				.label14.visible=.F.
				.label15.visible=.F.
				.label16.Visible= .F.
				.label18.visible=.F.
				.label19.visible=.F.
				.label21.visible=.F.
				.label22.visible=.F.
				.label23.visible=.F.
				.label24.visible=.F.
				.lbl_prov.Visible= .F.
				.optiongroup2.visible=.F.
				.text9.visible=.F.
				.text10.visible=.F.
				.text11.visible=.F.
				.text12.visible=.F.
				.text13.visible=.F.
				.text14.visible=.F.
				.text17.Visible= .F.
				.text15.visible=.F.
				.shape3.visible=.F.
				.shape4.visible=.F.
				.shape6.Visible= .F.
				.chk_todos.Visible= .F.
				.paleta_01.visible= .F.
				.text4.style=1
				.text5.style=1
				.height=320
				.command3.top=286
				.autocenter=.T.
			ENDWITH
		endif
	ENDPROC

	PROCEDURE nboldfila
		LParameters tnsel
		
		Local lnBold
		
			DO case
				CASE tnsel = 1
					lnBold = .T.
				CASE tnsel = 0
					lnBold = .F.
			ENDCASE
		Return(lnBold)
	ENDPROC

	PROCEDURE ncolorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = 1
					lnColor = RGB(255,0,0)
				CASE tnsel = 0
					lnColor = RGB(0,0,0)
			ENDCASE
		Return(lnColor)
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnlp,tncz
		
		LOCAL lnColor
		
		DO CASE 
			CASE tnlp=1 AND tncz=0
				lnColor = RGB(144,238,144)
			CASE tnlp=0 AND tncz=1
				lnColor = RGB(230,240,20)
			CASE tnlp=1 AND tncz=1
				lnColor = RGB(255,211,168)
		OTHERWISE
			lnColor = RGB(255,255,255)
		ENDCASE
		
		return(lnColor)
	ENDPROC

	PROCEDURE chk_todos.Click
		thisform.grd_costos.RecordSource=''
		thisform.grd_costos.Refresh()
		
		SET DECIMALS TO 3
		IF this.Value=1
			frmcart= conectar_db(_screen.cn)
				SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
			desconectar_db(frmcart)
			SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
			GO top
			thisform.grd_costos.recordsource="tmpc"
		ELSE
			frmcart= conectar_db(_screen.cn)
				SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
			desconectar_db(frmcart)
			SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
			GO top
			thisform.grd_costos.recordsource="tmpc"
		ENDIF
		SET DECIMALS TO
		
			
	ENDPROC

	PROCEDURE Command1.Click
		SET DECIMALS TO 3
		LOCAL xcc
		codigo=0
		thisform.text1.value=0
		do form artload with codigo
		if codigo>0
			with thisform
				.grd_costos.HighlightStyle= 1
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?codigo;","cur_arti")
				desconectar_db(frmcart)
				.lbl_prov.caption=''
				.grd_costos.recordsource=""
				.grd_costos.refresh
				.text1.value=cur_arti.art_codi
				.text2.value=cur_arti.art_desc
				.text3.value=cur_arti.art_stock
				.text15.value=cur_arti.art_stmin
				.text16.value=iif(cur_arti.art_alicuota=1,impiva1,impiva2)
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select sum(artped_cant-artped_ent) as totped from pedidos_articulos where art_codi=?.text1.value and artped_ent<artped_cant;","cur_ped")
					SQLEXEC(frmcart,"select sum(a.artord_cant-a.artord_ent) as totcom from compras_articulos as a inner join compras as b on a.orden_codi=b.orden_codi where b.anulado<>'S' and a.art_codi=?.text1.value and a.artord_ent<a.artord_cant;","cur_com")
				desconectar_db(frmcart)
				.text4.value=IIF(ISNULL(cur_ped.totped),0,cur_ped.totped)
				.text5.value=IIF(ISNULL(cur_com.totcom),0,cur_com.totcom)
				.text6.value=cur_arti.art_stock+.text5.value-.text4.value
				do case
					case cur_arti.art_med="UN"
						.optiongroup1.value=1
					case cur_arti.art_med="MT"
						.optiongroup1.value=2
					case cur_arti.art_med="KG"
						.optiongroup1.value=3
				endcase
				.text7.value=cur_arti.art_precio
				.edit1.value=cur_arti.art_deta
				.edit2.value=cur_arti.art_detaofi
				.text8.value=ALLTRIM(STR(cur_arti.rub_codi))+" - "+ALLTRIM(cur_arti.rub_desc)
				.text13.value=cur_arti.costo_ultcpra
				xcc=.text1.value
				SET DECIMALS TO 3
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
					IF RECCOUNT("provc")>0
						thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
					ENDIF		
					IF thisform.chk_todos.Value=0
						SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
					ELSE
						SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
					ENDIF
				desconectar_db(frmcart)
				SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
				GO top
				IF RECCOUNT("tmpc")>0
					thisform.chk_todos.Enabled= .T.
				ENDIF
				.grd_costos.recordsource="tmpc"
				.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista,tmpc.cotiz)","Column")
				.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
				.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")			
				SET DECIMALS TO
				.text9.enabled=.T.
				.text10.enabled=.T.
				.label17.caption=""
				.grid1.recordsource=" "
				.grid1.refresh()
			endwith
		ENDIF
		SET DECIMALS TO
		thisform.text1.setfocus
		KEYBOARD '{ENTER}'
		
		
	ENDPROC


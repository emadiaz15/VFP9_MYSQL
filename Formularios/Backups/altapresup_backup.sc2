		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txt_util' AS textbox WITH ;
		Alignment = 3, ;
		Format = "KR", ;
		Height = 23, ;
		InputMask = "% 999.9999", ;
		Left = 735, ;
		Name = "txt_util", ;
		Top = 79, ;
		Value = 0, ;
		Width = 77
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txt_utipro' AS textbox WITH ;
		Alignment = 0, ;
		Anchor = 11, ;
		BackColor = 191,202,193, ;
		BackStyle = 0, ;
		BorderStyle = 0, ;
		FontBold = .T., ;
		FontSize = 12, ;
		ForeColor = 2,51,219, ;
		Height = 23, ;
		InputMask = "999.999 %", ;
		Left = 363, ;
		Name = "txt_utipro", ;
		Style = 1, ;
		Top = 400, ;
		Value = 0, ;
		Width = 106
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		LOCAL xiva,xmone
		xmone = ''
		opcion=0
		impiva1=thisform.impiva1
		impiva2=thisform.impiva2
		valorcadena=thisform.valorcadena
		on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		set exact on
		if thisform.codicli=0
			on key label INS
			thisform.release
		endif
		if codigo=0
			muestro=0
			localiz=0
			alternati=''
		endif
		if muestro=1
			SET POINT TO ","
			SET DECIMALS TO 3
			with thisform
				xmone= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
				frmaltapr= conectar_db(_screen.cn)
					SQLEXEC(frmaltapr, "select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmaltapr)
				if alternati="S"
					with thisform
						if paso=1
							.grid1.col=3
							cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
							.grid1.text=cadena
							.grid1.col=4
							if codigo<=5
								.grid1.text=allt(descrip)
							else
								.grid1.text=allt(descri)
							endif
							.grid1.col=5
							.grid1.text=allt(pruni)
						ELSE
							cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
							.grid1.additem(" "+chr(9)+" "+chr(9)+"ALT"+chr(9)+cadena+chr(9)+allt(descri)+chr(9)+allt(pruni))
						endif
					endwith
				else
					localiz=1
					if paso=1
						SET DECIMALS TO 3
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"call usp_ctoutil(?dato1,?xmone,?DATE(),?thisform.xcotiz);","cur_cto")
						desconectar_db(frmaltapr)
						SET DECIMALS TO
						IF USED("cur_cto")
							thisform.acucto = thisform.acucto - (cur_cto.costo*ConverNro(dato2))
						ENDIF
						SELECT cur_arti
						.grid1.col=0
						.grid1.text=allt(str(aux))
						.grid1.col=1
						.grid1.text=allt(cant)
						.grid1.col=2
						.grid1.text=cur_arti.art_med
						.grid1.col=3
						cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
						.grid1.text=cadena
						.grid1.col=4
						if codigo<=5
							.grid1.text=allt(descrip)
						else
							.grid1.text=allt(descri)
						endif
						.grid1.col=5
						.grid1.text=allt(pruni)
						.grid1.col=6
						thisform.acu=thisform.acu-ConverNro(.grid1.text)
						.grid1.text=prtot
						if .text19.value>0
							auxiva=auxiva-(auxiva*.text19.value/100)
							auximpo=auximpo-(auximpo*.text19.value/100)
						ENDIF
						do case
							case art_alicuota=1
								if cond=2
									if auxali=1
										thisform.impo1=thisform.impo1-auximpo
									else
										thisform.impo2=thisform.impo2-auximpo
									endif
								else
									if auxali=1
										thisform.acun1=thisform.acun1-auximpo
									ELSE
										thisform.acun2=thisform.acun2-auximpo
									endif
								endif
							case art_alicuota=2
								if cond=2
									if auxali=2
										thisform.impo2=thisform.impo2-auximpo
									else
										thisform.impo1=thisform.impo1-auximpo
									endif
								else
									if auxali=2
										thisform.acun2=thisform.acun2-auximpo
									ELSE
										thisform.acun1=thisform.acun1-auximpo
									endif
								endif
						endcase
						thisform.acu=thisform.acu+ConverNro(prtot)
					ELSE
						if insertar=0
							thisform.nitem=thisform.nitem+1
							cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
							.grid1.additem(alltrim(str(thisform.nitem))+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+cadena+chr(9)+allt(descri)+chr(9)+allt(pruni)+chr(9)+prtot)
						endif
						thisform.acu=thisform.acu+ConverNro(prtot)
					endif
				ENDIF
				SET DECIMALS TO 3
				frmaltapr= conectar_db(_screen.cn)
					SQLEXEC(frmaltapr,"call usp_ctoutil(?codigo,?xmone,?DATE(),?thisform.xcotiz);","cur_cto")
				desconectar_db(frmaltapr)
				SET DECIMALS TO
				IF USED("cur_cto")
					thisform.acucto = thisform.acucto + (cur_cto.costo*ConverNro(cant))
				ENDIF		
				if paso=1
					paso=0
				else
					.grid1.row=this.grid1.rows-1
				endif
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				ENDIF
				IF alternati="N"
					.grid1.col=7
					do case
						case cur_arti.art_alicuota=1
							.grid1.text=allt(str(thisform.impiva1,10,2))
						case cur_arti.art_alicuota=2
							.grid1.text=allt(str(thisform.impiva2,10,2))
					ENDCASE
					.grid1.col=8
					IF paso = 1
						.grid1.text=''
					ENDIF
					frmaltapr= conectar_db(_screen.cn)
						ximpo= ConverNro(pruni)
						SQLEXEC(frmaltapr,"call usp_calcutil(?codigo,?ximpo,?xmone,?thisform.xcotiz,?cond,?thisform.impiva1,?thisform.impiva2,?cur_arti.art_alicuota);","cur_utit")
					desconectar_db(frmaltapr)
					SELECT * FROM cur_utit INTO ARRAY ar_util
					.grid1.text= IIF(ISNULL(ar_util[1]),0,ROUND(ar_util[1],3))
				ELSE
					localiz=0
					alternati="N"
				ENDIF
				.grid1.col=0
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellalignment=3
				.grid1.col=2
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellalignment=8
				.grid1.col=7
				.grid1.cellalignment=8
				.grid1.col=8
				.grid1.cellalignment=8
			ENDWITH
			SET POINT TO
			SET DECIMALS TO
			codigo=0
		endif
		if localiz=1 and thisform.nitem>0
			SET POINT TO ","
			with thisform
				.text8.value=thisform.acu
				.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
				.text18.value=.text8.value-.text17.value
				if .text19.value>0
					do case
						case cur_arti.art_alicuota=1
							if cond=2
								thisform.impo1=thisform.impo1+(ConverNro(prtot)*((100-.text19.value)/100))
								if auxali=2
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								endif
								.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							else
								thisform.acun1=thisform.acun1+round(((ConverNro(prtot)*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
								if auxali=2
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
						case cur_arti.art_alicuota=2
							if cond=2
								thisform.impo2=thisform.impo2+(ConverNro(prtot)*((100-.text19.value)/100))
								if auxali=1
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								endif
								.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							else
								thisform.acun2=thisform.acun2+round(((ConverNro(prtot)*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
								if auxali=1
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
					endcase
				else
					do case
						case cur_arti.art_alicuota=1
							if cond=2
								thisform.impo1=thisform.impo1+ConverNro(prtot)
								if auxali=2
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								endif
								.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							else
								thisform.acun1=thisform.acun1+round((ConverNro(prtot)/(1+(thisform.impiva1/100))),3)
								if auxali=2
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
						case cur_arti.art_alicuota=2
							if cond=2
								thisform.impo2=thisform.impo2+ConverNro(prtot)
								if auxali=1
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								endif
								.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							else
								thisform.acun2=thisform.acun2+round((ConverNro(prtot)/(1+(thisform.impiva2/100))),3)
								if auxali=1
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
					endcase
				endif
				.text10.value=.text18.value+.text9.value+.text11.value
				thisform.txt_utipro.Value=ROUND(((IIF(cond=2,thisform.acu,(thisform.acun1+thisform.acun2))/thisform.acucto)-1)*100,3)
			ENDWITH
			SET POINT TO 
		endif
		store 0 to localiz,muestro
		if thisform.nitem=0
			thisform.command4.enabled=.F.
			thisform.command5.enabled=.F.
		else
			thisform.command4.enabled=.T.
			thisform.command5.enabled=.T.
		endif
		*!*					xmone= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
		*!*					MESSAGEBOX("codigo: "+ALLTRIM(STR(codigo))+CHR(13)+ ;
		*!*							   "ximpo: "+ALLTRIM(STR(ximpo,15,3))+CHR(13)+ ;
		*!*							   "xmone: "+ALLTRIM(xmone)+CHR(13)+ ;
		*!*							   "xcotiz: "+ALLTRIM(STR(thisform.xcotiz,15,3))+CHR(13)+ ;
		*!*							   "cond: "+ALLTRIM(STR(cond))+CHR(13)+ ;
		*!*							   "impiva1: "+ALLTRIM(STR(thisform.impiva1,15,2))+CHR(13)+ ;
		*!*							   "impiva2: "+ALLTRIM(STR(thisform.impiva2,15,2))+CHR(13)+ ;
		*!*							   "art_alicuota: "+ALLTRIM(STR(cur_arti.art_alicuota)),64,"Variables")
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 2 of Altas .F.
		localiz=0
		
		
		IF USED("cur_utpre")
			_screen.utilidad=cur_utpre.param_impo
		endif
		on key label INS
	ENDPROC

	PROCEDURE Init
		PARAMETERS xmoneda
		
		public cond,elimi,aux,descrip,muestro,insertar,validez,plazo,condpag,lugent,observ,cantreg, ;
				postal,locali,provi,impiva1,impiva2,codiva,opcion,dato1,dato2,dato3,dato4,cant,descri, ;
				pruni,prtot,opcion,borra,alternati,localiz,ivaant,ivaact,iva,codp,codigo,nitem, ;
				buscar,paso,acu,longdes,impo1,impo2,acu1,acu2,acun1,acun2,auxiva,auximpo,auxali
		set deleted on
		set date british
		set cent on
		STORE 0 TO longdes,paso,thisform.acu,elimi,localiz,aux,muestro,insertar,cantreg,borra,thisform.nitem,codigo,dato1
		STORE "" TO validez,plazo,condpag,lugent,observ,descrip,prtot,pruni
		alternati="N"
		buscar=1
		STORE 0 TO thisform.impo1,thisform.impo2,thisform.acu1,thisform.acu2,thisform.acun1,thisform.acun2,auxiva,auximpo,auxali
		thisform.valorcadena=valorcadena
		thisform.text13.value=date()
		
		STORE 0 TO this.text19.value,this.text8.value,this.text9.value,this.text10.value,this.text11.value,this.text17.value,this.text18.value
		
		CREATE CURSOR cur_carpres(item           C(5), ;
								  artpres_cant   C(15), ;
								  art_med        C(3), ;
								  art_codi       N(8), ;
								  art_desc       C(254), ;
								  artpres_precio N(15,3), ;
								  prtotal        N(15,3), ;
								  iva            N(5,3), ;
								  util           N(15,3), ;
								  costo          N(15,3), ;
								  alicuo         N(1), ;
								  alternativa    C(1), ;
								  cond_codi      N(8), ;
								  presup_dto     N(10,2), ;
								  nro_regis      N(5))
		
		thisform.txt_util.Value=_screen.utilidad
		
		
		frmaltapr= conectar_db(_screen.cn)
			SQLEXEC(frmaltapr,"select param_impo from parametros where param_codi = 14;","cur_dolar")
			SQLEXEC(frmaltapr,"select param_impo from parametros where param_codi=12;","cur_utpre")
			SQLEXEC(frmaltapr, "select * from iva order by iva_codi desc limit 1;","cur_ivap")
		desconectar_db(frmaltapr)
		codiva=cur_ivap.iva_codi
		thisform.xcotiz =cur_dolar.param_impo
		thisform.impiva1=cur_ivap.iva_1
		thisform.impiva2=cur_ivap.iva_2
		thisform.label12.caption=allt(str(thisform.impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(thisform.impiva2,10,2))+"%"
		
		DO case
			CASE UPPER(xmoneda) = 'D'
				thisform.ctn_moneda.chk_dolares.Value = 1
				frmaltapr= conectar_db(_screen.cn)
					SQLEXEC(frmaltapr,"select * from condipresup where condp_cod=2;","cur_piep")
				desconectar_db(frmaltapr)
			CASE UPPER(xmoneda) = 'P'
				thisform.ctn_moneda.chk_pesos.Value=1
				frmaltapr= conectar_db(_screen.cn)
					SQLEXEC(frmaltapr,"select * from condipresup where condp_cod=1;","cur_piep")
				desconectar_db(frmaltapr)
		ENDCASE
		IF USED("cur_piep")
			if RECCOUNT("cur_piep")>0
				validez = cur_piep.condp_val
				plazo   = cur_piep.condp_pla
				condpag = cur_piep.condp_pag
				lugent  = cur_piep.condp_lug
				observ  = IIF(UPPER(xmoneda)='P',SUBSTR(cur_piep.condp_obs,1,65)+ALLTRIM(STR(thisform.xcotiz,15,2))+'.-',cur_piep.condp_obs)
			ENDIF
		ENDIF
		
		
		do form cliload with thisform.codicli
		
		thisform.codicli=cur_clie.cli_codi
		with thisform
			.text1.value=cur_clie.cli_nomb
			.text2.value=cur_clie.cli_domi
			.text3.value=postal
			.text4.value=locali
			.text5.value=provi
			.text6.value=cur_clie.cond_desc
			.text12.value=VAL(cur_clie.cli_cuit)
		ENDWITH
		
		cond=cur_clie.cond_codi
		
		
	ENDPROC

	PROCEDURE Load
		set skip of bar 2 of Altas .T.
	ENDPROC

	PROCEDURE Command1.Click
		salir=messagebox("¿Seguro que desea Salir?",4+32+256,"Verifique!!!")
		if salir=6
			thisform.release
		endif
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command2.Click
		DO case
			CASE thisform.nitem=0
				messagebox("Aún no ha ingresado ningún artículo al Presupuesto, imposible Terminar"+chr(13)+ ;
						   "Ingrese algún artículo presionando la tecla INSERT. Si desea salir de la"+chr(13)+ ; 
						   "rutina utilize el botón Salir o presione la tecla ESC",48,"Advertencia")
				RETURN
			CASE thisform.ctn_moneda.chk_dolares.Value = 0 AND thisform.ctn_moneda.chk_pesos.Value = 0
				MESSAGEBOX("Para continuar debe especificar la moneda para el presupuesto.",48,"Aviso del Sistema")
				RETURN
		OTHERWISE
			preg=messagebox("¿Confirma los datos del Presupuesto?",4+32+256,"Alta de Presupuestos")
			if preg=6
				with thisform
					LOCAL xcodip,xfecha,xref,xdto,xdasc,xarti,xdac,xcant,xprec,xalt,xit,xreg
					xfecha=.text13.value
					xref= ALLTRIM(.text20.value)
					xdto=.text19.value
					DO case
						CASE thisform.ctn_moneda.chk_dolares.Value =1
							xmoneda = 'D'
						CASE thisform.ctn_moneda.chk_pesos.Value = 1
							xmoneda = 'P'
					ENDCASE			
					IF thisform.npresup=0
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"select cast(presup_codi+1 as DECIMAL(8,0)) as presup_codi from presupuestos order by presup_codi desc limit 1;","cur_nvo")
						desconectar_db(frmaltapr)
						thisform.npresup=cur_nvo.presup_codi
						xcodip=thisform.npresup
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"insert into presupuestos values(?xcodip,?xfecha,?thisform.codicli,?xref,?validez,?plazo,?lugent,?condpag,?xdto,?observ,?codiva,?xmoneda,?thisform.xcotiz,?thisform.txt_utipro.value,NULL);")
						desconectar_db(frmaltapr)
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								.grid1.col=3
								if val(.grid1.text)<=5
									.grid1.col=4
									xdasc=.grid1.text
								else
									xdasc=""
								endif
								.grid1.col=3
								xarti=val(.grid1.text)
								.grid1.col=4
								frmaltapr= conectar_db(_screen.cn)
									SQLEXEC(frmaltapr,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
								desconectar_db(frmaltapr)
								if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
									frmaltapr= conectar_db(_screen.cn)
										SQLEXEC(frmaltapr,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
									desconectar_db(frmaltapr)
									IF RECCOUNT("cur_artcli")>0
										LOCAL xcadena
										xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(.grid1.text)
										frmaltapr= conectar_db(_screen.cn)
											SQLEXEC(frmaltapr,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
										desconectar_db(frmaltapr)
										IF RECCOUNT("cur_ddes")>0
											xdac=cur_ddes.dac_codi
										endif
									endif
								else
									xdac=0
								endif
								SET POINT TO ","
								SET DECIMALS TO 3
								.grid1.col=1
								xcant=ConverNro(.grid1.text)
								.grid1.col=5
								xprec=ConverNro(.grid1.text)
								SET POINT TO
								SET DECIMALS TO
								.grid1.col=2
								if allt(.grid1.text)="ALT"
									xalt="S"
									xit=0							
								else
									xalt=""
									.grid1.col=0
									xit=val(.grid1.text)
								endif
								xreg=fila
								frmaltapr= conectar_db(_screen.cn)
									SQLEXEC(frmaltapr,"insert into presupuestos_articulos values(?xcodip,?xarti,?xprec,?xcant,?xdasc,?xalt,?xit,?xreg,0,?xdac);")
								desconectar_db(frmaltapr)
							endif
						next fila
					ELSE
						xcodip=thisform.npresup
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"update presupuestos set presup_fech=?xfecha,cli_codi=?thisform.codicli,presup_ref=?xref,presup_ofer=?validez,presup_plent=?plazo,presup_lugent=?lugent,presup_cond=?condpag,presup_dto=?xdto,presup_obser=?observ,iva_codi=?codiva where presup_codi=?xcodip;")
							SQLEXEC(frmaltapr,"update presupuestos set moneda=?xmoneda,cotiz_dolar=?thisform.xcotiz,util_general=?thisform.txt_util.value where presup_codi=?xcodip;")
							SQLEXEC(frmaltapr,"select nro_regis from presupuestos_articulos where presup_codi=?xcodip order by nro_regis desc limit 1;","cur_canrg")
							IF cur_canrg.nro_regis>thisform.grid1.rows-1
								LOCAL regis
								regis=thisform.grid1.rows-1
								SQLEXEC(frmaltapr,"delete from presupuestos_articulos where presup_codi=?xcodip and nro_regis>?regis;")
							ENDIF
						desconectar_db(frmaltapr)
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								.grid1.col=3
								if val(.grid1.text)<=5
									.grid1.col=4
									xdasc=.grid1.text
								else
									xdasc=""
								endif
								.grid1.col=3
								xarti=val(.grid1.text)
								.grid1.col=4
								frmaltapr= conectar_db(_screen.cn)
									SQLEXEC(frmaltapr,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
								desconectar_db(frmaltapr)
								if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
									frmaltapr= conectar_db(_screen.cn)
										SQLEXEC(frmaltapr,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
									desconectar_db(frmaltapr)
									IF RECCOUNT("cur_artcli")>0
										LOCAL xcadena
										xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(.grid1.text)
										frmaltapr= conectar_db(_screen.cn)
											SQLEXEC(frmaltapr,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
										desconectar_db(frmaltapr)
										IF RECCOUNT("cur_ddes")>0
											xdac=cur_ddes.dac_codi
										endif
									endif
								else
									xdac=0
								ENDIF
								SET POINT TO ","
								SET DECIMALS TO 3
								.grid1.col=1
								xcant=ConverNro(.grid1.text)			
								.grid1.col=5
								xprec=ConverNro(.grid1.text)
								SET POINT TO
								SET DECIMALS TO
								.grid1.col=2
								if allt(.grid1.text)="ALT"
									xalt="S"
									xit=0							
								else
									xalt=""
									.grid1.col=0
									xit=val(.grid1.text)
								endif
								xreg=fila
								frmaltapr= conectar_db(_screen.cn)
									IF fila<=cur_canrg.nro_regis
										SQLEXEC(frmaltapr,"update presupuestos_articulos set art_codi=?xarti,artpres_precio=?xprec,artpres_cant=?xcant,artpres_dasc=?xdasc,alternativa=?xalt,nro_it=?xit,nro_regis=?xreg,alter_iva=0,dac_codi=?xdac where presup_codi=?xcodip and nro_regis=?fila;")
									ELSE
										SQLEXEC(frmaltapr,"insert into presupuestos_articulos values(?xcodip,?xarti,?xprec,?xcant,?xdasc,?xalt,?xit,?xreg,0,?xdac);")
									ENDIF
								desconectar_db(frmaltapr)
							endif
						next fila			
					ENDIF
					cantreg=.grid1.rows-1
					SET POINT TO ","
					ivari=.text9.value
					ivarni=.text11.value
					totalri=.text18.value+.text9.value
					totalrni=.text18.value+.text9.value+.text11.value
					totsiva=.text18.value
					SET POINT TO
				ENDWITH
				SET DECIMALS TO 3
				frmaltapr= conectar_db(_screen.cn)
					SQLEXEC(frmaltapr,"select a.*,b.*,c.*,d.cond_desc from presupuestos a inner join clientes b on a.cli_codi=b.cli_codi inner join iva c on c.iva_codi=a.iva_codi inner join condiva d on b.cond_codi=d.cond_codi where presup_codi=?xcodip;","cur_conpres")
					SQLEXEC(frmaltapr,"select a.loca_nomb,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on a.provi_codi=c.provi_codi where a.loca_codi=?cur_conpres.loca_codi;","cur_ubicli")
					SQLEXEC(frmaltapr,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dac_desc from presupuestos_articulos a INNER JOIN articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.presup_codi=?xcodip ORDER BY a.nro_regis;","cur_carpres")
				desconectar_db(frmaltapr)
				SET DECIMALS TO
				GO top
				set point to ","
				report form presupuesto for cur_carpres.presup_codi=thisform.npresup TO PRINTER prompt noconsole
				SET POINT TO
				thisform.release
			endif
		ENDCASE
		
	ENDPROC


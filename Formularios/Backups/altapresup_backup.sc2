	PROCEDURE Command6.Click
		with thisform
			.shape4.visible=.T.
			.optiongroup1.visible=.T.
			.label14.visible=.T.
			.text14.visible=.T.
			.command7.visible=.T.
			.label14.caption=""
			.text14.value=0
			.optiongroup1.value=0
		endwith
	ENDPROC


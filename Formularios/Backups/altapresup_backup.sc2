	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
		
	ENDPROC

	PROCEDURE grid1.DblClick
		*** ActiveX Control Event ***
		local x,y,dtopie,ivaencol,opcion2,xmone
		ivaencol=0
		if thisform.nitem>0
			this.col=0
			aux=val(this.text)
			this.col=3
			dato1=val(this.text)
			this.col=1
			dato2=this.text
			this.col=4
			dato3=this.text
			this.col=5
			dato4=this.text
			this.col=6
			prtot=this.text
			this.col=2
			dato5=this.text
			auxiva=0
			auximpo=0
			frmaltapr= conectar_db(_screen.cn)
				SQLEXEC(frmaltapr,"select * from articulos where art_codi=?dato1;","cur_arti")
			desconectar_db(frmaltapr)
			impiva1=thisform.impiva1
			impiva2=thisform.impiva2
			opcion2=0
			do form modippreg with cond,opcion,opcion2,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		if borra=6
			SET POINT TO ","
			SET DECIMALS TO 3
			with thisform
				xmone= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
				frmaltapr= conectar_db(_screen.cn)
					SQLEXEC(frmaltapr,"call usp_ctoutil(?dato1,?xmone,?DATE(),?thisform.xcotiz);","cur_cto")
				desconectar_db(frmaltapr)
				IF USED("cur_cto")
					thisform.acucto = thisform.acucto - (cur_cto.costo*ConverNro(dato2))
					MESSAGEBOX("acu: "+ALLTRIM(STR(thisform.acu,15,3))+CHR(13)+ ;
						       "acucto: "+ALLTRIM(STR(thisform.acucto,15,3))+CHR(13)+ ;
						       "dato2: "+ALLTRIM(dato2)+CHR(13)+ ;
						       "costo: "+ALLTRIM(STR(costo,15,3)),64,"Valores")
					thisform.txt_utipro.Value=ROUND(((thisform.acu/thisform.acucto)-1)*100,3)
				ENDIF
				if this.rows=2
					this.col=7
					do case
						case ConverNro(this.text)=thisform.impiva1
							ivaencol=1
						case ConverNro(this.text)=thisform.impiva2
							ivaencol=2
					endcase
					this.col=6
					prtot=this.text
					thisform.nitem=0
					this.rows=1
					thisform.acu=0
					thisform.acucto=0
					thisform.impo1=0
					thisform.impo2=0
					thisform.acun1=0
					thisform.acun2=0
					thisform.acu1=0
					thisform.acu2=0
					.text8.value=0
					.text9.value=0
					.text10.value=0
					.text11.value=0
					.text17.value=0
					.text18.value=0
					.text19.value=0
				else
					this.col=7
					do case
						case ConverNro(this.text)=thisform.impiva1
							ivaencol=1
						case ConverNro(this.text)=thisform.impiva2
							ivaencol=2
					endcase
					this.col=6
					prtot=this.text
					thisform.acu=thisform.acu-ConverNro(this.text)
					thisform.nitem=thisform.nitem-1
					this.removeitem(this.row)
					this.col=2
					x=1
					y=0
					do while x<=this.rows-1
						this.row=x
						this.col=2
						if ALLTRIM(this.text)<>"ALT"
							y=y+1
							this.col=0
							this.text=allt(str(y))
						ENDIF
						x=x+1
					ENDDO
					thisform.text8.value=thisform.acu
					if thisform.text19.value>0
						dtopie=round((100-thisform.text19.value)/100,2)
						thisform.text17.value=thisform.acu*dtopie
						thisform.text18.value=thisform.acu-thisform.text17.value
						do case
							case ivaencol=1
								thisform.impo1=thisform.impo1-(ConverNro(prtot)*dtopie)
								if cond=2
									thisform.text9.value=thisform.text9.value-round((ConverNro(prtot)*dtopie)*thisform.impiva1/100,2)
								else
									auxacuneto=thisform.acun1
									thisform.acun1=thisform.acun1-((ConverNro(prtot)*dtopie)/(1+(thisform.impiva1/100)))
									thisform.acu1=thisform.acu1-(auxacuneto-thisform.acun1)*thisform.impiva1/100
								endif
							case ivaencol=2
								thisform.impo2=thisform.impo2-(ConverNro(prtot)*dtopie)
								if cond=2
									thisform.text11.value=thisform.text11.value-round((ConverNro(prtot)*dtopie)*thisform.impiva2/100,2)
								else
									auxacuneto=thisform.acun2
									thisform.acun2=thisform.acun2-((ConverNro(prtot)*dtopie)/(1+(thisform.impiva2/100)))
									thisform.acu2=thisform.acu2-(auxacuneto-thisform.acun2)*thisform.impiva2/100
								endif
						endcase
					else
						thisform.text18.value=thisform.acu
						do case
							case ivaencol=1
								thisform.impo1=thisform.impo1-ConverNro(prtot)
								if cond=2				
									thisform.text9.value=thisform.text9.value-round(ConverNro(prtot)*thisform.impiva1/100,2)
								else
									auxacuneto=thisform.acun1
									thisform.acun1=thisform.acun1-(ConverNro(prtot)/(1+(thisform.impiva1/100)))
									thisform.acu1=thisform.acu1-(auxacuneto-thisform.acun1)*thisform.impiva1/100
								endif
							case ivaencol=2
								thisform.impo2=thisform.impo2-ConverNro(prtot)
								if cond=2
									thisform.text11.value=thisform.text11.value-round(ConverNro(prtot)*thisform.impiva2/100,2)
								else
									auxacuneto=thisform.acun2
									thisform.acun2=thisform.acun2-(ConverNro(prtot)/(1+(thisform.impiva2/100)))
									thisform.acu2=thisform.acu2-(auxacuneto-thisform.acun2)*thisform.impiva2/100
								endif
						endcase
					endif
					thisform.text10.value=thisform.text18.value+thisform.text9.value+thisform.text11.value
				endif
			endwith
			borra=0
			insertar=0
			preg=0
			SET POINT TO
			SET DECIMALS TO
		endif
		if insertar=1 and codigo<>0
			SET POINT TO ","
			SET DECIMALS TO 3
			xmone= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
			with thisform
				this.col=0
				nro=this.row
				do case
					case opcion=1
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"select * from articulos where art_codi=?codigo;","cur_arti")
						desconectar_db(frmaltapr)
						cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
						this.additem(" "+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+allt(cadena)+chr(9)+descri+chr(9)+allt(pruni)+chr(9)+prtot,.grid1.row)
						thisform.acu=thisform.acu+ConverNro(prtot)
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"call usp_ctoutil(?codigo,?xmone,?DATE(),?thisform.xcotiz);","cur_cto")
						desconectar_db(frmaltapr)
						IF USED("cur_cto")
							thisform.acucto = thisform.acucto + (cur_cto.costo*ConverNro(cant))
						ENDIF		
						SELECT cur_arti			
						this.col=7
						do case
							case cur_arti.art_alicuota=1
								this.text=allt(str(thisform.impiva1,10,2))
							case cur_arti.art_alicuota=2
								this.text=allt(str(thisform.impiva2,10,2))
						ENDCASE
						this.col=8
						frmaltapr= conectar_db(_screen.cn)
							ximpo= ConverNro(pruni)
							SQLEXEC(frmaltapr,"call usp_calcutil(?codigo,?ximpo,?xmone,?thisform.xcotiz,?cond,?thisform.impiva1,?thisform.impiva2,?cur_arti.art_alicuota);","cur_utit")
						desconectar_db(frmaltapr)
						SELECT * FROM cur_utit INTO ARRAY ar_util
						.grid1.text= IIF(ISNULL(ar_util[1]),0,ROUND(ar_util[1],3))
						.grid1.cellalignment=8
						thisform.txt_utipro.Value=ROUND(((thisform.acu/thisform.acucto)-1)*100,3)
						SELECT cur_arti
						thisform.nitem=thisform.nitem+1
						muestro=0
						localiz=1
						opcion=0
					case opcion=2
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"select * from articulos where art_codi=?codigo;","cur_arti")
						desconectar_db(frmaltapr)
						cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
						this.additem(" "+chr(9)+" "+chr(9)+"ALT"+chr(9)+allt(cadena)+chr(9)+allt(descri)+chr(9)+allt(pruni),.grid1.row+1)
						nro=nro+1
						alternati="N"
						muestro=0
						localiz=0
						opcion=0
				endcase
				.grid1.row=nro
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				endif
				.grid1.col=0
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellalignment=3
				.grid1.col=2
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellalignment=8
				.grid1.col=7
				.grid1.cellalignment=8
				x=1
				y=0
				do while x<=this.rows-1
					this.row=x
					this.col=2
					if ALLTRIM(this.text)<>"ALT"
						y=y+1
						this.col=0
						this.text=allt(str(y))
					endif
					x=x+1
				enddo
				insertar=0
			ENDWITH
			SET POINT TO
			SET DECIMALS TO
		ENDIF
		
	ENDPROC

	PROCEDURE grid1.GotFocus
		*!*	cond=cur_clie.cond_codi
		*!*	on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		*!*	if localiz=1
		*!*	*!*		if elimi=0 and thisform.nitem>0
		*!*	*!*			this.toprow=thisform.nitem	
		*!*	*!*		else
		*!*			elimi=0
		*!*	*!*		endif
		*!*	endif
	ENDPROC

	PROCEDURE Optiongroup1.Option1.Click
		thisform.label14.caption="*"
		thisform.label14.top=491
		thisform.text14.setfocus
	ENDPROC

	PROCEDURE Optiongroup1.Option2.Click
		thisform.label14.caption=":"
		thisform.label14.top=488
		thisform.text14.setfocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		codigo=0
		opcion=0
		valorcadena=thisform.valorcadena
		on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		if localiz=1
		*!*		if elimi=0
		*!*			thisform.grid1.toprow=thisform.nitem
		*!*		else
				elimi=0
		*!*		endif
		endif
	ENDPROC

	PROCEDURE Text13.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text19.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text19.GotFocus
		public valdto
		valdto=this.value
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			if this.value<>valdto
				do case
					case this.value=0
						.text17.value=""
						.text18.value=.text8.value
						thisform.acu=thisform.acu/((100-valdto)/100)
						thisform.impo1=thisform.impo1/((100-valdto)/100)
						thisform.impo2=thisform.impo2/((100-valdto)/100)
						thisform.acun1=thisform.acun1/((100-valdto)/100)
						thisform.acun2=thisform.acun2/((100-valdto)/100)
						thisform.acu1=thisform.acu1/((100-valdto)/100)
						thisform.acu2=thisform.acu2/((100-valdto)/100)
						if cond=2
							.text9.value=.text9.value/((100-valdto)/100)
							.text11.value=.text11.value/((100-valdto)/100)
						endif
					otherwise
						.text17.value=.text8.value*this.value/100
						.text18.value=.text8.value-.text17.value
						if cond=2
							if valdto>0
								.text9.value=.text9.value/((100-valdto)/100)
								.text11.value=.text11.value/((100-valdto)/100)
							endif
							.text9.value=.text9.value*((100-this.value)/100)
							.text11.value=.text11.value*((100-this.value)/100)
						endif
						if valdto>0
							thisform.acu=thisform.acu/((100-valdto)/100)
							thisform.impo1=thisform.impo1/((100-valdto)/100)
							thisform.impo2=thisform.impo2/((100-valdto)/100)
							thisform.acun1=thisform.acun1/((100-valdto)/100)
							thisform.acun2=thisform.acun2/((100-valdto)/100)
							thisform.acu1=thisform.acu1/((100-valdto)/100)
							thisform.acu2=thisform.acu2/((100-valdto)/100)
						ENDIF
						thisform.acu=thisform.acu*((100-this.value)/100)
						thisform.impo1=thisform.impo1*((100-this.value)/100)
						thisform.impo2=thisform.impo2*((100-this.value)/100)
						thisform.acun1=thisform.acun1*((100-this.value)/100)
						thisform.acun2=thisform.acun2*((100-this.value)/100)
						thisform.acu1=thisform.acu1*((100-this.value)/100)
						thisform.acu2=thisform.acu2*((100-this.value)/100)
				endcase 
				.text10.value=.text18.value+.text9.value+.text11.value
				thisform.txt_utipro.Value=ROUND(((IIF(cond=2,thisform.acu,(thisform.acun1+thisform.acun2))/thisform.acucto)-1)*100,3)
			endif
		endwith
	ENDPROC

	PROCEDURE Text20.GotFocus
		codigo=0
		opcion=0
		valorcadena=thisform.valorcadena
		on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		
	ENDPROC

	PROCEDURE txt_util.Click
		this.SetFocus
		
	ENDPROC

ENDDEFINE


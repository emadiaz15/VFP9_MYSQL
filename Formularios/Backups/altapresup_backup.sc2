	PROCEDURE Command8.Click
		LOCAL aplicar,xarti,xmone
		STORE 0 TO aplicar,xarti
		xmone=''
		
		DO case
			CASE thisform.txt_util.Value<>cur_utpre.param_impo AND thisform.utilidad=0
				aplicar=1
			CASE thisform.txt_util.Value<>cur_utpre.param_impo AND thisform.utilidad>0
				IF thisform.txt_util.Value<>thisform.utilidad
					aplicar=1
				ELSE
					aplicar=0
					MESSAGEBOX("ESTA UTILIDAD YA FUE APLICADA AL PRESUPUESTO.",0+64,"Precios")
				ENDIF
			CASE thisform.txt_util.Value=cur_utpre.param_impo AND thisform.utilidad=0
				aplicar=0	
			CASE thisform.txt_util.Value=cur_utpre.param_impo AND thisform.utilidad>0
				aplicar=1
		ENDCASE
		
		IF aplicar=1
			IF thisform.grid1.rows>1
				uti=messagebox("LA NUEVA UTILIDAD INDICADA SE APLICARÁ A TODOS LOS ITEMS DEL PRESUPUESTO."+CHR(13)+CHR(13)+ ;
							   "¿Confirma aplicar la utilidad indicada?",4+32+256,"Precios")
			ELSE
				uti=messagebox("¿Confirma aplicar la utilidad indicada?",4+32+256,"Precios")
			ENDIF
			with thisform
				if uti=6
					xmone= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
					LOCAL ivaencol
					STORE 0 TO thisform.acu,thisform.impo1,thisform.impo2,thisform.acu1,thisform.acu2,thisform.acun1,thisform.acun2,auxiva,auximpo,auxali
					.text8.value=0
					.text9.value=0
					.text10.value=0
					.text11.value=0
					.text17.value=0
					.text18.value=0
					for i=1 to .grid1.rows-1
						.grid1.row=i
						.grid1.col=1
						valor1=ConverNro(.grid1.text)
						.grid1.col=5
						valor2=ConverNro(.grid1.text)/((IIF(thisform.utilidad=0,cur_utpre.param_impo,thisform.utilidad)/100)+1)
						valor2=valor2*round((thisform.txt_util.Value/100)+1,3)
						.grid1.text=allt(str(valor2,15,3))
						.grid1.col=6
						.grid1.text=allt(str(valor1*valor2,15,2))
						thisform.acu=thisform.acu+ConverNro(.grid1.text)
						.grid1.col=3
						xarti=VAL(.grid1.text)
						
						********************COMIENZA CALCULO DE IVA*********************
						.grid1.col=2
						IF ALLTRIM(.grid1.text)<>"ALT"
							.text8.value=thisform.acu
							.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
							.text18.value=.text8.value-.text17.value
							.grid1.col=7
							do case
								case ConverNro(.grid1.text)=thisform.impiva1
									ivaencol=1
								case ConverNro(.grid1.text)=thisform.impiva2
									ivaencol=2
							ENDCASE
							.grid1.col=8
							frmaltapr= conectar_db(_screen.cn)
								SQLEXEC(frmaltapr,"call usp_calcutil(?xarti,?valor2,?xmone,?thisform.xcotiz,?cond,?thisform.impiva1,?thisform.impiva2,?ivaencol);","cur_utit")
							desconectar_db(frmaltapr)
							SELECT * FROM cur_utit INTO ARRAY ar_util
							.grid1.text= IIF(ISNULL(ar_util[1]),0,ROUND(ar_util[1],3))
							.grid1.cellalignment=8					
							.grid1.col=6
							if .text19.value>0
								do case
									case ivaencol=1
										if cond=2
											thisform.impo1=thisform.impo1+(ConverNro(.grid1.text)*((100-.text19.value)/100))
											if auxali=2
												.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
											endif
											.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
										else
											thisform.acun1=thisform.acun1+round(((ConverNro(.grid1.text)*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
											if auxali=2
												thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
											endif
											thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
										endif
									case ivaencol=2
										if cond=2
											thisform.impo2=thisform.impo2+(ConverNro(.grid1.text)*((100-.text19.value)/100))
											if auxali=1
												.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
											endif
											.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
										else
											thisform.acun2=thisform.acun2+round(((ConverNro(.grid1.text)*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
											if auxali=1
												thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
											endif
											thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
										endif
								endcase
							else
								do case
									case ivaencol=1
										if cond=2
											thisform.impo1=thisform.impo1+ConverNro(.grid1.text)
											if auxali=2
												.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
											endif
											.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
										else
											thisform.acun1=thisform.acun1+round((ConverNro(.grid1.text)/(1+(thisform.impiva1/100))),3)
											if auxali=2
												thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
											endif
											thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
										endif
									case ivaencol=2
										if cond=2
											thisform.impo2=thisform.impo2+ConverNro(.grid1.text)
											if auxali=1
												.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
											endif
											.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
										else
											thisform.acun2=thisform.acun2+round((ConverNro(.grid1.text)/(1+(thisform.impiva2/100))),3)
											if auxali=1
												thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
											endif
											thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
										endif
								endcase
							endif
							.text10.value=.text18.value+.text9.value+.text11.value
							thisform.txt_utipro.Value=ROUND(((IIF(cond=2,thisform.acu,(thisform.acun1+thisform.acun2))/thisform.acucto)-1)*100,3)
						ENDIF
					next i
					if paso>0
						paso=0
					endif
				ELSE
					thisform.txt_util.Value=cur_utpre.param_impo
				ENDIF
				IF thisform.txt_util.Value=cur_utpre.param_impo AND thisform.utilidad>0
					thisform.utilidad=0
				ELSE
					thisform.utilidad=thisform.txt_util.value
				ENDIF
				_screen.utilidad=thisform.txt_util.value
			ENDWITH
		ENDIF
		
		
	ENDPROC


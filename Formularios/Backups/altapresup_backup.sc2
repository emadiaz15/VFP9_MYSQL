	PROCEDURE Command3.Click
		DO case
			CASE thisform.nitem=0
				messagebox("Aún no ha ingresado ningún artículo al Presupuesto, imposible Guardar",48,"Advertencia")
				RETURN
			CASE thisform.ctn_moneda.chk_dolares.Value = 0 AND thisform.ctn_moneda.chk_pesos.Value = 0
				MESSAGEBOX("Para continuar debe especificar la moneda para el presupuesto.",48,"Aviso del Sistema")
				RETURN
		OTHERWISE
			with thisform
				LOCAL xcodip,xfecha,xref,xdto,xdasc,xarti,xdac,xcant,xprec,xalt,xit,xreg,xmoneda
				xfecha=.text13.value
				xref= ALLTRIM(.text20.value)
				xdto=.text19.value
				DO case
					CASE thisform.ctn_moneda.chk_dolares.Value =1
						xmoneda = 'D'
					CASE thisform.ctn_moneda.chk_pesos.Value = 1
						xmoneda = 'P'
				ENDCASE
				IF thisform.npresup=0
					frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr,"select cast(presup_codi+1 as DECIMAL(8,0)) as presup_codi from presupuestos order by presup_codi desc limit 1;","cur_nvo")
					desconectar_db(frmaltapr)
					thisform.npresup=cur_nvo.presup_codi
					xcodip=thisform.npresup
					frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr,"insert into presupuestos values(?xcodip,?xfecha,?thisform.codicli,?xref,?validez,?plazo,?lugent,?condpag,?xdto,?observ,?codiva,?xmoneda,?thisform.xcotiz,?thisform.txt_utipro.value,NULL);")
					desconectar_db(frmaltapr)
					for fila=1 to .grid1.rows
						if fila<.grid1.rows
							.grid1.row=fila
							.grid1.col=3
							if val(.grid1.text)<=5
								.grid1.col=4
								xdasc=.grid1.text
							else
								xdasc=""
							endif
							.grid1.col=3
							xarti=val(.grid1.text)
							.grid1.col=4
							frmaltapr= conectar_db(_screen.cn)
								SQLEXEC(frmaltapr,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
							desconectar_db(frmaltapr)
							if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
								frmaltapr= conectar_db(_screen.cn)
									SQLEXEC(frmaltapr,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
								desconectar_db(frmaltapr)
								IF RECCOUNT("cur_artcli")>0
									LOCAL xcadena
									xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(.grid1.text)
									frmaltapr= conectar_db(_screen.cn)
										SQLEXEC(frmaltapr,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
									desconectar_db(frmaltapr)
									IF RECCOUNT("cur_ddes")>0
										xdac=cur_ddes.dac_codi
									endif
								endif
							else
								xdac=0
							endif
							SET POINT TO ","
							SET DECIMALS TO 3
							.grid1.col=1
							xcant=ConverNro(.grid1.text)			
							.grid1.col=5
							xprec=ConverNro(.grid1.text)
							SET POINT TO
							SET DECIMALS TO
							.grid1.col=2
							if allt(.grid1.text)="ALT"
								xalt="S"
								xit=0							
							else
								xalt=""
								.grid1.col=0
								xit=val(.grid1.text)
							endif
							xreg=fila
							frmaltapr= conectar_db(_screen.cn)
								SQLEXEC(frmaltapr,"insert into presupuestos_articulos values(?xcodip,?xarti,?xprec,?xcant,?xdasc,?xalt,?xit,?xreg,0,?xdac);")
							desconectar_db(frmaltapr)
						endif
					next fila
				ELSE
					xcodip=thisform.npresup
					frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr,"update presupuestos set presup_fech=?xfecha,cli_codi=?thisform.codicli,presup_ref=?xref,presup_ofer=?validez,presup_plent=?plazo,presup_lugent=?lugent,presup_cond=?condpag,presup_dto=?xdto,presup_obser=?observ,iva_codi=?codiva where presup_codi=?xcodip;")
						SQLEXEC(frmaltapr,"update presupuestos set moneda=?xmoneda,cotiz_dolar=?thisform.xcotiz,util_general=?thisform.txt_util.value where presup_codi=?xcodip;")
						SQLEXEC(frmaltapr,"select nro_regis from presupuestos_articulos where presup_codi=?xcodip order by nro_regis desc limit 1;","cur_canrg")
						IF cur_canrg.nro_regis>thisform.grid1.rows-1
							LOCAL regis
							regis=thisform.grid1.rows-1
							SQLEXEC(frmaltapr,"delete from presupuestos_articulos where presup_codi=?xcodip and nro_regis>?regis;")
						ENDIF
					desconectar_db(frmaltapr)
					for fila=1 to .grid1.rows
						if fila<.grid1.rows
							.grid1.row=fila
							.grid1.col=3
							if val(.grid1.text)<=5
								.grid1.col=4
								xdasc=.grid1.text
							else
								xdasc=""
							endif
							.grid1.col=3
							xarti=val(.grid1.text)
							.grid1.col=4
							frmaltapr= conectar_db(_screen.cn)
								SQLEXEC(frmaltapr,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
							desconectar_db(frmaltapr)
							if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
								frmaltapr= conectar_db(_screen.cn)
									SQLEXEC(frmaltapr,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
								desconectar_db(frmaltapr)
								IF RECCOUNT("cur_artcli")>0
									LOCAL xcadena
									xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(.grid1.text)
									frmaltapr= conectar_db(_screen.cn)
										SQLEXEC(frmaltapr,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
									desconectar_db(frmaltapr)
									IF RECCOUNT("cur_ddes")>0
										xdac=cur_ddes.dac_codi
									endif
								endif
							else
								xdac=0
							ENDIF
							SET POINT TO ","
							SET DECIMALS TO 3
							.grid1.col=1
							xcant=ConverNro(.grid1.text)			
							.grid1.col=5
							xprec=ConverNro(.grid1.text)
							SET POINT TO
							SET DECIMALS TO
							.grid1.col=2
							if allt(.grid1.text)="ALT"
								xalt="S"
								xit=0							
							else
								xalt=""
								.grid1.col=0
								xit=val(.grid1.text)
							endif
							xreg=fila
							frmaltapr= conectar_db(_screen.cn)
								IF fila<=cur_canrg.nro_regis
									SQLEXEC(frmaltapr,"update presupuestos_articulos set art_codi=?xarti,artpres_precio=?xprec,artpres_cant=?xcant,artpres_dasc=?xdasc,alternativa=?xalt,nro_it=?xit,nro_regis=?xreg,alter_iva=0,dac_codi=?xdac where presup_codi=?xcodip and nro_regis=?fila;")
								ELSE
									SQLEXEC(frmaltapr,"insert into presupuestos_articulos values(?xcodip,?xarti,?xprec,?xcant,?xdasc,?xalt,?xit,?xreg,0,?xdac);")
								ENDIF
							desconectar_db(frmaltapr)
						endif
					next fila			
				ENDIF
			endwith
		ENDCASE
		MESSAGEBOX("Los datos fueron guardados corréctamente.",64,"Aviso del Sistema")
	ENDPROC


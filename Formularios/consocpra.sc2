	PROCEDURE Command2.Click
		SELECT cur_arcom
		GO top
		with thisform
		*!*		cantreg=.grid1.rows-1
			ivari=ConverNro(.text9.value)
			ivarni=ConverNro(.text11.value)
			totalri=ConverNro(.text8.value)+ConverNro(.text9.value)
			totalrni=ConverNro(.text8.value)+ConverNro(.text9.value)+ConverNro(.text11.value)
			totsiva=ConverNro(.text8.value)
			totcpra=totsiva+ivari+ivarni
			lg=messagebox("¿Imprime esta Orden de Compra con membrete?",4+32+0,"Ordenes de Compra")
			report form ordendecompra for cur_cpra.orden_codi=thisform.xcodcpra TO PRINTER prompt noconsole
		endwith
		
	ENDPROC


	PROCEDURE Activate
		store 0 to localiz
		thisform.grid1.toprow=1
		
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 7 of Modificaci .F.
		*!*	localiz=0
		*!*	nitem=0
		
		IF PEMSTATUS(thisform, "xGridArtBound", 5)
		    =GridArt_Unbind(thisform)
		ENDIF
		
		ON KEY LABEL ESC
		
		cerrar_cursor("cur_tra")
		cerrar_cursor("cur_arcom")
		cerrar_cursor("cur_cotdia")
		cerrar_cursor("cur_cotant")
		cerrar_cursor("cur_datvar")
		cerrar_cursor("cur_ubic")
		cerrar_cursor("cur_cpra")
		
	ENDPROC

	PROCEDURE gridart_menu
		LOCAL lcShortcut
		
		IF thisform.grid1.Rows <= 1
		    RETURN
		ENDIF
		
		lcShortcut = SYS(2015)
		
		DEFINE POPUP (lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		=GridArt_AddStockMenuOption(lcShortcut, 1, thisform)
		=GridArt_AddStockMenuSeparator(lcShortcut, 2)
		=GridArt_AddListaComprasMenuOption(lcShortcut, 3)
		ACTIVATE POPUP (lcShortcut)
		RELEASE POPUP (lcShortcut)
		
		RETURN
	ENDPROC

	PROCEDURE gridart_refresh
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    thisform.gridart_setup()
		ELSE
		    =GridArt_ColorearGridActivex(thisform)
		ENDIF
		
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockForm(thisform)
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE gridart_setup
		SET PROCEDURE TO grid_articulos_ui ADDITIVE
		
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    =GridArt_BindActiveX(thisform, "grid1", 3, 4)
		    =GridArt_BindTooltipEvents(thisform)
		ENDIF
		
		=GridArt_ColorearGridActivex(thisform)
		
		ON KEY LABEL ESC DO GridArt_OnEsc IN grid_articulos_ui
		
		RETURN
	ENDPROC

	PROCEDURE Init
		parameter codc,cond
		public elimi,aux,descrip,muestro,insertar,observ,cantreg,coditran,transporte, ;
				impiva1,impiva2,codiva,opcion,dato1,dato2,dato3,dato4,cant,descri, ;
				pruni,prtot,opcion,borra,alternati,localiz,ivaant,ivaact,iva,codiprov,dato1, ;
				acu,nitem,acuaux,auxiva,ivadif,ivaitem,lg
		
		PUBLIC importe1,importe2
		
		store 0 to importe1,importe2
		
		set deleted on
		this.xcondpro=cond
		this.xcodcpra=codc
		thisform.valorcadena=valorcadena
		acuaux=0
		auxiva=0
		ivadif=0
		ivaitem=0
		transporte=" "
		coditran=0
		observ=" "
		paso=0
		acu=0
		elimi=0
		aux=0
		descrip=""
		insertar=0
		cantreg=0
		borra=0
		prtot=""
		pruni=""
		codigo=0
		*!*	CREATE CURSOR auxdap(dap_codi N(8),dap_desc C(45))
		*!*	INDEX on dap_codi TO dp
		
		thisform.text13.value=date()
		thisform.text19.value=0
		
		frmconscom= conectar_db(_screen.cn)
			SQLEXEC(frmconscom,"select b.*,c.*,d.cond_desc from compras a inner join iva b on a.iva_codi=b.iva_codi inner join proveedores c on c.prov_codi=a.prov_codi inner join condiva d on c.cond_codi=d.cond_codi where a.orden_codi=?codc;","cur_datvar")
			SQLEXEC(frmconscom,"select a.*,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on c.provi_codi=a.provi_codi where a.loca_codi=?cur_datvar.loca_codi;","cur_ubic")
		desconectar_db(frmconscom)
		impiva1=cur_datvar.iva_1
		impiva2=cur_datvar.iva_2
		codiva=cur_datvar.iva_codi
		thisform.label12.caption=allt(str(impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(impiva2,10,2))+"%"
		
		SET DECIMALS TO 4
		frmconscom= conectar_db(_screen.cn)
			SQLEXEC(frmconscom,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dap_desc from compras_articulos a inner join articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_proveedores c on c.dap_codi=a.dap_codi where a.orden_codi=?codc order by a.artord_codi;","cur_arcom")
			SQLEXEC(frmconscom,"select * from compras where orden_codi=?codc;","cur_cpra")
		desconectar_db(frmconscom)
		SET DECIMALS TO
		
		nitem=1
		with thisform
			IF pascpra=1
				.command3.visible=.F.
			ELSE
				.command3.visible=.T.
			endif
			IF LEN(ALLTRIM(cur_cpra.cumplido))=0
				thisform.chk_pend.Enabled=.T.
			ELSE
				thisform.chk_pend.Enabled=.F.	
			ENDIF
			.text7.value=codc
			.text1.value=cur_datvar.prov_nomb
			.text2.value=cur_datvar.prov_domi
			auxcond=cur_datvar.cond_codi
			codiprov=cur_cpra.prov_codi
			.text3.value=cur_ubic.cp_nro
			.text4.value=cur_ubic.loca_nomb
			.text5.value=cur_ubic.provi_nomb
			.text6.value=cur_datvar.cond_desc
			.text12.value=VAL(cur_datvar.prov_cuit)
			.text15.value="0"+allt(cur_datvar.prov_cartel)+"-"+allt(cur_datvar.prov_tel1)
			.text13.value=cur_cpra.orden_fech
			.text19.value=cur_cpra.orden_dto
			.text20.value=cur_cpra.orden_ref
			.edit1.value=ALLTRIM(cur_cpra.orden_obser)
			coditran=cur_cpra.tran_codi
			frmconscom= conectar_db(_screen.cn)
				SQLEXEC(frmconscom,"select * from transportes where tran_codi=?coditran;","cur_tra")
			desconectar_db(frmconscom)
			IF RECCOUNT("cur_tra")>0
				.text14.value=tran_nomb
			ENDIF
			
			SELECT cur_arcom
			GO top
			SCAN
				cadena=repl("0",8-len(allt(str(cur_arcom.art_codi))))+allt(str(cur_arcom.art_codi))
				if cur_arcom.art_codi=4 or cur_arcom.art_codi=5
					.grid1.additem(allt(str(nitem))+chr(9)+allt(str(cur_arcom.artord_cant,10,3))+chr(9)+allt(cur_arcom.art_med)+chr(9)+cadena+chr(9)+allt(cur_arcom.artord_dasc)+chr(9)+allt(str(cur_arcom.artord_precio,10,4))+chr(9)+allt(str(cur_arcom.artord_cant*cur_arcom.artord_precio,10,2)))
					.grid1.row=this.grid1.rows-1
					this.grid1.col=7
					do case
						case cur_arcom.art_alicuota=1
							this.grid1.text=allt(str(impiva1,10,2))
						case cur_arcom.art_alicuota=2
							this.grid1.text=allt(str(impiva2,10,2))
					endcase
				else
					.grid1.additem(allt(str(nitem))+chr(9)+allt(str(cur_arcom.artord_cant,10,3))+chr(9)+allt(cur_arcom.art_med)+chr(9)+cadena+chr(9)+allt(cur_arcom.art_desc)+chr(9)+allt(str(cur_arcom.artord_precio,10,4))+chr(9)+allt(str(cur_arcom.artord_cant*cur_arcom.artord_precio,10,2)))
					if cur_arcom.dap_codi>0
						.grid1.col=4
						.grid1.row=nitem
						.grid1.text=allt(cur_arcom.dap_desc)
					ENDIF
					.grid1.row=this.grid1.rows-1
					this.grid1.col=7
					do case
						case cur_arcom.art_alicuota=1
							this.grid1.text=allt(str(impiva1,10,2))
						case cur_arcom.art_alicuota=2
							this.grid1.text=allt(str(impiva2,10,2))
					endcase
				ENDIF
				.grid1.row=this.grid1.rows-1
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					cantreg=cantreg+longdes
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				ELSE
					cantreg=cantreg+1
					.grid1.rowheight(.grid1.row)=270
				endif		
				prtot=allt(str(cur_arcom.artord_cant*cur_arcom.artord_precio,10,2))
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=0
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=1
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=6
				this.grid1.col=2
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=3
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=4
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=0
				this.grid1.col=5
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				this.grid1.col=6
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				acu=acu+(cur_arcom.artord_cant*cur_arcom.artord_precio)
		        *****************CALCULO TOTALIZADORES********************************
				.text8.value=str(acu,10,2)
				.text17.value=str(iif(.text19.value>0,round((acu*.text19.value)/100,2),0),10,2)
				.text18.value=str(ConverNro(.text8.value)-ConverNro(.text17.value),10,2)
				if .text19.value>0
					do case
						case cur_arcom.art_alicuota=1
							.grid1.col=6
							importe1=importe1+(ConverNro(prtot)*((100-.text19.value)/100))
							if thisform.xcondpro=2
								.text9.value=str(ConverNro(.text9.value)+(ConverNro(prtot)*((100-.text19.value)/100)*impiva1/100),10,2)
							endif
						case cur_arcom.art_alicuota=2
							.grid1.col=6
							importe2=importe2+(ConverNro(prtot)*((100-.text19.value)/100))
							if thisform.xcondpro=2
								.text11.value=str(ConverNro(.text11.value)+(ConverNro(prtot)*((100-.text19.value)/100)*impiva2/100),10,2)
							endif
					endcase
				else
					do case
						case cur_arcom.art_alicuota=1
							.grid1.col=6
							importe1=importe1+ConverNro(prtot)
							if thisform.xcondpro=2
								.text9.value=str(ConverNro(.text9.value)+((ConverNro(prtot))*impiva1/100),10,2)
							endif
						case cur_arcom.art_alicuota=2
							.grid1.col=6
							importe2=importe2+ConverNro(prtot)
							if thisform.xcondpro=2
								.text11.value=str(ConverNro(.text11.value)+((ConverNro(prtot))*impiva2/100),10,2)
							endif
					endcase
				endif
				.text10.value=str(ConverNro(.text18.value)+ConverNro(.text9.value)+ConverNro(.text11.value),10,2)
		        *****************FIN CALCULO TOTALIZADORES******************************
				nitem=nitem+1		
			ENDSCAN
		*!*		SET RELATION TO dap_codi INTO auxdap addi
		endwith
		if nitem>1
			nitem=nitem-1
		endif
		localiz=1
		
		thisform.gridart_setup()
	ENDPROC

	PROCEDURE Load
		set skip of bar 7 of Modificaci .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if valorcadena<>"Ordenes de Compra"
		*!*		set skip of bar 7 of Modificaci .F.
		*!*		thisform.hide
		*!*		localiz=0
		*!*		nitem=0
		*!*	endif
	ENDPROC

	PROCEDURE Btn_money1.Image1.Click
		frmconscom= conectar_db(_screen.cn)
			SQLEXEC(frmconscom,"select * from histocoti where hiscot_fecha=?thisform.text13.value order by hiscot_fecha desc limit 1;","cur_cotdia")
			IF RECCOUNT("cur_cotdia")>0
				MESSAGEBOX("         DOLAR VIGENTE AL DÍA DE LA COMPRA"+CHR(13)+CHR(13)+ ;
						   "U$S 1 = $ "+ALLTRIM(STR(cur_cotdia.hiscot_impo,14,2))+" - ACTUALIZ: "+ALLTRIM(TTOC(hiscot_fecha)),0+64,"COTIZACIONES MONEDA DOLAR")
			ELSE
				SQLEXEC(frmconscom,"select * from histocoti where hiscot_fecha<?thisform.text13.value order by hiscot_fecha desc limit 1;","cur_cotant")
				IF RECCOUNT("cur_cotant")>0
					MESSAGEBOX("         DOLAR VIGENTE AL DÍA DE LA COMPRA"+CHR(13)+CHR(13)+ ;
							   "U$S 1 = $ "+ALLTRIM(STR(cur_cotant.hiscot_impo,14,2))+" - ACTUALIZ: "+ALLTRIM(TTOC(hiscot_fecha)),0+64,"COTIZACIONES MONEDA DOLAR")
				ENDIF
			ENDIF
		desconectar_db(frmconscom)
	ENDPROC

	PROCEDURE chk_pend.Click
		LOCAL opcionpend,canpend
		cantreg=0
		SET DECIMALS TO 3
		store 0 to importe1,importe2,acu,prtot
		STORE '' TO thisform.text8.Value,thisform.text9.Value,thisform.text10.Value,thisform.text10.Value,thisform.text11.Value,thisform.text17.Value,thisform.text18.value
		DO case
			CASE this.Value=1
				opcionpend=1
				frmconscom= conectar_db(_screen.cn)
					SQLEXEC(frmconscom,"select a.*,b.art_desc,b.*,c.* from compras_articulos a inner join articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_proveedores c on c.dap_codi=a.dap_codi where a.artord_ent<a.artord_cant and a.orden_codi=?thisform.xcodcpra;","cur_arcom")
				desconectar_db(frmconscom)
			CASE this.Value=0
				opcionpend=2
				frmconscom= conectar_db(_screen.cn)
					SQLEXEC(frmconscom,"select a.*,b.art_desc,b.*,c.* from compras_articulos a inner join articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_proveedores c on c.dap_codi=a.dap_codi where a.orden_codi=?thisform.xcodcpra order by a.artord_codi;","cur_arcom")
				desconectar_db(frmconscom)
		ENDCASE
		SET DECIMALS TO 
		WITH thisform
			thisform.grid1.rows=1
			GO top
			nitem=1
			SCAN
				cadena=repl("0",8-len(allt(str(cur_arcom.art_codi))))+allt(str(cur_arcom.art_codi))
				canpend=cur_arcom.artord_cant-IIF(opcionpend=1,cur_arcom.artord_ent,0)
				if cur_arcom.art_codi=4 or cur_arcom.art_codi=5
					.grid1.additem(allt(str(nitem))+chr(9)+allt(str(canpend,10,3))+chr(9)+allt(cur_arcom.art_med)+chr(9)+cadena+chr(9)+allt(cur_arcom.artord_dasc)+chr(9)+allt(str(cur_arcom.artord_precio,10,3))+chr(9)+allt(str(canpend*cur_arcom.artord_precio,10,2)))
					.grid1.row=.grid1.rows-1
					.grid1.col=7
					do case
						case cur_arcom.art_alicuota=1
							.grid1.text=allt(str(impiva1,10,2))
						case cur_arcom.art_alicuota=2
							.grid1.text=allt(str(impiva2,10,2))
					endcase
				else
					.grid1.additem(allt(str(nitem))+chr(9)+allt(str(canpend,10,3))+chr(9)+allt(cur_arcom.art_med)+chr(9)+cadena+chr(9)+allt(cur_arcom.art_desc)+chr(9)+allt(str(cur_arcom.artord_precio,10,3))+chr(9)+allt(str(canpend*cur_arcom.artord_precio,10,2)))
					if cur_arcom.dap_codi>0
						.grid1.col=4
						.grid1.row=nitem
						.grid1.text=''
						.grid1.text=cur_arcom.dap_desc
					ENDIF
					.grid1.row=.grid1.rows-1
					.grid1.col=7
					do case
						case cur_arcom.art_alicuota=1
							.grid1.text=allt(str(impiva1,10,2))
						case cur_arcom.art_alicuota=2
							.grid1.text=allt(str(impiva2,10,2))
					endcase
				ENDIF
				.grid1.row=.grid1.rows-1
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					cantreg=cantreg+longdes
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				ELSE
					cantreg=cantreg+1
					.grid1.rowheight(.grid1.row)=270
				endif		
				prtot=allt(str(canpend*cur_arcom.artord_precio,10,2))
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=3
				.grid1.col=0
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=6
				.grid1.col=2
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=8
				acu=acu+(canpend*cur_arcom.artord_precio)
		        *****************CALCULO TOTALIZADORES********************************
				.text8.value=str(acu,10,2)
				.text17.value=str(iif(.text19.value>0,round((acu*.text19.value)/100,2),0),10,2)
				.text18.value=str(ConverNro(.text8.value)-ConverNro(.text17.value),10,2)
				if .text19.value>0
					do case
						case cur_arcom.art_alicuota=1
							.grid1.col=6
							importe1=importe1+(ConverNro(prtot)*((100-.text19.value)/100))
							if thisform.xcondpro=2
								.text9.value=str(ConverNro(.text9.value)+(ConverNro(prtot)*((100-.text19.value)/100)*impiva1/100),10,2)
							endif
						case cur_arcom.art_alicuota=2
							.grid1.col=6
							importe2=importe2+(ConverNro(prtot)*((100-.text19.value)/100))
							if thisform.xcondpro=2
								.text11.value=str(ConverNro(.text11.value)+(ConverNro(prtot)*((100-.text19.value)/100)*impiva2/100),10,2)
							endif
					endcase
				else
					do case
						case cur_arcom.art_alicuota=1
							.grid1.col=6
							importe1=importe1+ConverNro(prtot)
							if thisform.xcondpro=2
								.text9.value=str(ConverNro(.text9.value)+((ConverNro(prtot))*impiva1/100),10,2)
							endif
						case cur_arcom.art_alicuota=2
							.grid1.col=6
							importe2=importe2+ConverNro(prtot)
							if thisform.xcondpro=2
								.text11.value=str(ConverNro(.text11.value)+((ConverNro(prtot))*impiva2/100),10,2)
							endif
					endcase
				endif
				.text10.value=str(ConverNro(.text18.value)+ConverNro(.text9.value)+ConverNro(.text11.value),10,2)
		        *****************FIN CALCULO TOTALIZADORES******************************
				nitem=nitem+1		
			ENDSCAN
		endwith
		if nitem>1
			nitem=nitem-1
		ENDIF
		
		thisform.gridart_refresh()
	ENDPROC


	PROCEDURE cnt_boton1.btn.Click
		LOCAL xfecha
		sele ventascomp
		go top
		count all for !deleted() to cantreg
		xfecha=Mes_nombre(month(listmovi.text2.value))+ ' de '+allt(str(year(listmovi.text2.value)))
		report form librosiva preview noconsole
	ENDPROC

	PROCEDURE cnt_boton1.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE cnt_boton1.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE cnt_boton1.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Container2.btn.Click
		LOCAL xfecha
		sele ventascomp
		go top
		count all for !deleted() to cantreg
		xfecha=Mes_nombre(month(listmovi.text2.value))+ ' de '+allt(str(year(listmovi.text2.value)))
		report form librosiva to printer prompt noconsole
	ENDPROC

	PROCEDURE Container2.btn.MouseLeave

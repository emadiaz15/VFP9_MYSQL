	ENDPROC

	PROCEDURE Container2.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE Container2.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE Container3.btn.Click
		local Fila,fpag,pagina,empresa
		frmimpre= conectar_db(_screen.cn)
			SQLEXEC(frmimpre,"select TRIM(param_desc) as param_desc from parametros where param_codi=13;","cur_empre")
			SQLEXEC(frmimpre,"select param_impo from parametros where param_codi=3;","cur_cuit")
		desconectar_db(frmimpre)
		empresa=ALLTRIM(cur_empre.param_desc)+" - CUIT: "+SUBSTR(ALLTRIM(STR(cur_cuit.param_impo,11)),1,2)+"-"+ ;
				SUBSTR(ALLTRIM(STR(cur_cuit.param_impo,11)),3,8)+"-"+SUBSTR(ALLTRIM(STR(cur_cuit.param_impo,11)),11,1)
		cerrar_cursor("cur_empre")
		cerrar_cursor("cur_cuit")
		wait'Espere Un Momento Exportando Datos' window nowait
		_screen.mousepointer=11
		TmpSheet=GetObject('','Excel.Sheet')
		XLApp=TmpSheet.Application
		*!*	xlapp.visible=.t.
		XLApp.workbooks.add()
		XLSheet=XLApp.ActiveSheet
		with XLSheet.PageSetup
			.Orientation = 2
			.LeftMargin = XLApp.InchesToPoints(0)
			.RightMargin = XLApp.InchesToPoints(0)
		    .TopMargin = XLApp.InchesToPoints(0)
		    .BottomMargin = XLApp.InchesToPoints(0)
		    .HeaderMargin = XLApp.InchesToPoints(0)
		    .FooterMargin = XLApp.InchesToPoints(0)
		    .Zoom=85
		ENDWITH
		do case
			case listmovi.optiongroup1.value=1
				Xlsheet.cells(1,6)="LIBRO IVA COMPRAS"
			case listmovi.optiongroup1.value=2
				Xlsheet.cells(1,6)="LIBRO IVA VENTAS"
		endcase
		XLSheet.Cells(1,6).font.bold=.T.
		XLSheet.Cells(1,6).font.underline=.T.
		XLSheet.Cells(1,6).font.size="18"
		XLSheet.Cells(1,6).font.name="Courier New"
		Xlsheet.cells(1,10)=empresa
		XLSheet.Cells(1,10).font.bold=.T.
		XLSheet.Cells(1,10).font.size="13"
		XLSheet.Cells(1,10).font.name="Courier New"
		XLSheet.Cells(2,2)=Mes_nombre(month(listmovi.text2.value))+" DE "+allt(str(year(listmovi.text2.value)))
		XLSheet.Cells(2,2).font.bold=.T.
		XLSheet.Cells(2,2).font.size=12
		XLSheet.Cells(2,2).font.name="Courier New"
		XLSheet.Cells(3,2)="DÍA"
		XLSheet.Cells(3,2).font.bold=.T.
		XLSheet.Cells(3,2).font.size="8"
		XLSheet.Cells(3,2).font.name="Courier New"
		XLSheet.Cells(3,3)="TIPO"
		XLSheet.Cells(3,3).font.bold=.T.
		XLSheet.Cells(3,3).font.size="8"
		XLSheet.Cells(3,3).font.name="Courier New"
		XLSheet.Cells(3,4)="NÚMERO"
		XLSheet.Cells(3,4).font.bold=.T.
		XLSheet.Cells(3,4).font.size="8"
		XLSheet.Cells(3,4).font.name="Courier New"
		do case
			case listmovi.optiongroup1.value=1
				XLSheet.Cells(3,5)="PROVEEDOR"
			case listmovi.optiongroup1.value=2
				XLSheet.Cells(3,5)="CLIENTE"
		endcase
		XLSheet.Cells(3,5).font.bold=.T.
		XLSheet.Cells(3,5).font.size="8"
		XLSheet.Cells(3,5).font.name="Courier New"
		XLSheet.Cells(3,6)="C.U.I.T."
		XLSheet.Cells(3,6).font.bold=.T.
		XLSheet.Cells(3,6).font.size="8"
		XLSheet.Cells(3,6).font.name="Courier New"
		XLSheet.Cells(3,7)="GRAVADO"
		XLSheet.Cells(3,7).font.bold=.T.
		XLSheet.Cells(3,7).font.size="8"
		XLSheet.Cells(3,7).font.name="Courier New"
		XLSheet.Cells(3,7).WrapText=.T.
		XLSheet.Cells(3,8)="NO GRAVADOS"
		XLSheet.Cells(3,8).font.bold=.T.
		XLSheet.Cells(3,8).font.size="8"
		XLSheet.Cells(3,8).font.name="Courier New"
		XLSheet.Cells(3,8).WrapText=.T.
		XLSheet.Cells(3,9)="EXCENTO"
		XLSheet.Cells(3,9).font.bold=.T.
		XLSheet.Cells(3,9).font.size="8"
		XLSheet.Cells(3,9).font.name="Courier New"
		XLSheet.Cells(3,9).WrapText=.T.
		XLSheet.Cells(3,10)="IVA"
		XLSheet.Cells(3,10).font.bold=.T.
		XLSheet.Cells(3,10).font.size="8"
		XLSheet.Cells(3,10).font.name="Courier New"
		XLSheet.Cells(3,10).WrapText=.T.
		XLSheet.Cells(3,11)="NO INSCR."
		XLSheet.Cells(3,11).font.bold=.T.
		XLSheet.Cells(3,11).font.size="8"
		XLSheet.Cells(3,11).font.name="Courier New"
		XLSheet.Cells(3,11).WrapText=.T.
		XLSheet.Cells(3,12)="PER.IVA"
		XLSheet.Cells(3,12).font.bold=.T.
		XLSheet.Cells(3,12).font.size="8"
		XLSheet.Cells(3,12).font.name="Courier New"
		XLSheet.Cells(3,12).WrapText=.T.
		XLSheet.Cells(3,13)="TOTAL"
		XLSheet.Cells(3,13).font.bold=.T.
		XLSheet.Cells(3,13).font.size="8"
		XLSheet.Cells(3,13).font.name="Courier New"
		XLSheet.Cells(3,13).WrapText=.T.
		XLSheet.Range("B3:M3").HorizontalAlignment=3
		*!*	XLSheet.Range("B3:M3").VerticalAlignment=2
		XLSheet.Range("B3:M3").Borders.LineStyle=1
		XLSheet.Range("B3:M3").Borders.Weight=3
		sele ventascomp
		go top
		Fila=4
		fpag=1
		pagina=1
		*!*	ventascomp(fecha D,cbte C(6),nro C(15),cliprov C(17),grav N(10,2),nograv N(10,2),opexc N(10,2),iva N(10,2),nimt N(10,2),periva N(10,2),total N(10,2),cuit N(11),concepto C(1),cli_codi N(8))
		scan
		   XLSheet.Cells(Fila,2)=day(fecha)
		   XLSheet.Cells(Fila,3)=alltrim(cbte)
		   XLSheet.Cells(Fila,4)=alltrim(nro)
		   XLSheet.Cells(Fila,5)=alltrim(cliprov)
		   XLSheet.Cells(Fila,6)=alltrim(str(cuit,11))
		   XLSheet.Cells(Fila,7)=grav
		   XLSheet.Cells(Fila,8)=nograv
		   XLSheet.Cells(Fila,9)=opexc
		   XLSheet.Cells(Fila,10)=iva
		   XLSheet.Cells(Fila,11)=nimt
		   XLSheet.Cells(Fila,12)=periva
		   XLSheet.Cells(Fila,13)=total
		   Fila=Fila+1
		   fpag=fpag+1
		   if fpag=iif(pagina=1,44,47)
				XLSheet.Cells(fila,2)="DÍA"
				XLSheet.Cells(fila,2).font.bold=.T.
				XLSheet.Cells(fila,2).font.size="8"
				XLSheet.Cells(fila,2).font.name="Courier New"
				XLSheet.Cells(fila,3)="TIPO"
				XLSheet.Cells(fila,3).font.bold=.T.
				XLSheet.Cells(fila,3).font.size="8"
				XLSheet.Cells(fila,3).font.name="Courier New"
				XLSheet.Cells(fila,4)="NÚMERO"
				XLSheet.Cells(fila,4).font.bold=.T.
				XLSheet.Cells(fila,4).font.size="8"
				XLSheet.Cells(fila,4).font.name="Courier New"
				do case
					case listmovi.optiongroup1.value=1
						XLSheet.Cells(fila,5)="PROVEEDOR"
					case listmovi.optiongroup1.value=2
						XLSheet.Cells(fila,5)="CLIENTE"
				endcase
				XLSheet.Cells(fila,5).font.bold=.T.
				XLSheet.Cells(fila,5).font.size="8"
				XLSheet.Cells(fila,5).font.name="Courier New"
				XLSheet.Cells(fila,6)="C.U.I.T."
				XLSheet.Cells(fila,6).font.bold=.T.
				XLSheet.Cells(fila,6).font.size="8"
				XLSheet.Cells(fila,6).font.name="Courier New"
				XLSheet.Cells(fila,7)="GRAVADO"
				XLSheet.Cells(fila,7).font.bold=.T.
				XLSheet.Cells(fila,7).font.size="8"
				XLSheet.Cells(fila,7).font.name="Courier New"
				XLSheet.Cells(fila,7).WrapText=.T.
				XLSheet.Cells(fila,8)="NO GRAVADOS"
				XLSheet.Cells(fila,8).font.bold=.T.
				XLSheet.Cells(fila,8).font.size="8"
				XLSheet.Cells(fila,8).font.name="Courier New"
				XLSheet.Cells(fila,8).WrapText=.T.
				XLSheet.Cells(fila,9)="EXCENTO"
				XLSheet.Cells(fila,9).font.bold=.T.
				XLSheet.Cells(fila,9).font.size="8"
				XLSheet.Cells(fila,9).font.name="Courier New"
				XLSheet.Cells(fila,9).WrapText=.T.
				XLSheet.Cells(fila,10)="IVA"
				XLSheet.Cells(fila,10).font.bold=.T.
				XLSheet.Cells(fila,10).font.size="8"
				XLSheet.Cells(fila,10).font.name="Courier New"
				XLSheet.Cells(fila,10).WrapText=.T.
				XLSheet.Cells(fila,11)="NO INSCR."
				XLSheet.Cells(fila,11).font.bold=.T.
				XLSheet.Cells(fila,11).font.size="8"
				XLSheet.Cells(fila,11).font.name="Courier New"
				XLSheet.Cells(fila,11).WrapText=.T.
				XLSheet.Cells(fila,12)="PER.IVA"
				XLSheet.Cells(fila,12).font.bold=.T.
				XLSheet.Cells(fila,12).font.size="8"
				XLSheet.Cells(fila,12).font.name="Courier New"
				XLSheet.Cells(fila,12).WrapText=.T.
				XLSheet.Cells(fila,13)="TOTAL"
				XLSheet.Cells(fila,13).font.bold=.T.
				XLSheet.Cells(fila,13).font.size="8"
				XLSheet.Cells(fila,13).font.name="Courier New"
				XLSheet.Cells(fila,13).WrapText=.T.
				XLSheet.Range(XLSheet.Cells(fila,2),XLSheet.Cells(fila,13)).HorizontalAlignment=3
				XLSheet.Range(XLSheet.Cells(fila,2),XLSheet.Cells(fila,13)).VerticalAlignment=2
				XLSheet.Range(XLSheet.Cells(fila,2),XLSheet.Cells(fila,13)).Borders.LineStyle=1
				XLSheet.Range(XLSheet.Cells(fila,2),XLSheet.Cells(fila,13)).Borders.Weight=3
				fpag=1
				fila=fila+1
				pagina=2
			endif
		endscan
		XLSheet.Range(XLSheet.Cells(fila-1,2),XLSheet.Cells(fila-1,13)).Borders(9).LineStyle = 1
		XLSheet.Range(XLSheet.Cells(fila-1,2),XLSheet.Cells(fila-1,13)).Borders(9).Weight=3
		XLSheet.Cells(fila+1,5)="T O T A L E S:"
		XLSheet.Cells(fila+1,5).font.bold=.T.
		XLSheet.Cells(fila+1,5).font.size=12
		XLSheet.Cells(fila+1,5).font.name="Courier New"
		XLSheet.Cells(fila+1,7)=listmovi.text3.value
		XLSheet.Cells(fila+1,7).font.size=10
		XLSheet.Cells(fila+1,7).font.name="Courier New"
		XLSheet.Cells(fila+1,8)=listmovi.text4.value
		XLSheet.Cells(fila+1,8).font.size=10
		XLSheet.Cells(fila+1,8).font.name="Courier New"
		XLSheet.Cells(fila+1,9)=listmovi.text9.value
		XLSheet.Cells(fila+1,9).font.size=10
		XLSheet.Cells(fila+1,9).font.name="Courier New"
		XLSheet.Cells(fila+1,10)=listmovi.text5.value
		XLSheet.Cells(fila+1,10).font.size=10
		XLSheet.Cells(fila+1,10).font.name="Courier New"
		XLSheet.Cells(fila+1,11)=listmovi.text8.value
		XLSheet.Cells(fila+1,11).font.size=10
		XLSheet.Cells(fila+1,11).font.name="Courier New"
		XLSheet.Cells(fila+1,12)=listmovi.text6.value
		XLSheet.Cells(fila+1,12).font.size=10
		XLSheet.Cells(fila+1,12).font.name="Courier New"
		XLSheet.Cells(fila+1,13)=listmovi.text7.value
		XLSheet.Cells(fila+1,13).font.size=10
		XLSheet.Cells(fila+1,13).font.name="Courier New"
		XLSheet.Range(XLSheet.Cells(fila+1,7),XLSheet.Cells(fila+1,13)).NUMBERFORMAT="#,##0.00"
		XLSheet.Range(XLSheet.Cells(fila+1,7),XLSheet.Cells(fila+1,13)).font.bold=.T.
		XLSheet.Range(XLSheet.Cells(fila+1,7),XLSheet.Cells(fila+1,13)).WrapText=.T.
		XLSheet.Columns("A:A").ColumnWidth = 2
		XLSheet.Columns("B:B").ColumnWidth = 3
		XLSheet.Columns("C:C").ColumnWidth = 5
		XLSheet.Columns("D:D").ColumnWidth = 13
		XLSheet.Columns("E:E").ColumnWidth = 13
		XLSheet.Columns("F:F").ColumnWidth = 13
		XLSheet.Columns("F:F").NUMBERFORMAT="#-########-#"
		XLSheet.Columns("G:G").ColumnWidth = 16
		XLSheet.Columns("G:G").NUMBERFORMAT="#,##0.00"
		XLSheet.Columns("H:H").ColumnWidth = 16
		XLSheet.Columns("H:H").NUMBERFORMAT="#,##0.00"
		XLSheet.Columns("I:I").ColumnWidth = 16
		XLSheet.Columns("I:I").NUMBERFORMAT="#,##0.00"
		XLSheet.Columns("J:J").ColumnWidth = 16
		XLSheet.Columns("J:J").NUMBERFORMAT="#,##0.00"
		XLSheet.Columns("K:K").ColumnWidth = 16
		XLSheet.Columns("K:K").NUMBERFORMAT="#,##0.00"
		XLSheet.Columns("L:L").ColumnWidth = 16
		XLSheet.Columns("L:L").NUMBERFORMAT="#,##0.00"
		XLSheet.Columns("M:M").ColumnWidth = 16
		XLSheet.Columns("M:M").NUMBERFORMAT="#,##0.00"
		XLApp.visible=.T.
		XLApp.WindowState = -4137
		DECLARE LONG BringWindowToTop IN "user32" LONG HWND
		BringWindowToTop(XLApp.HWND)
		_screen.mousepointer=0
		
	ENDPROC

	PROCEDURE Container3.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE Container3.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE Container3.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

ENDDEFINE

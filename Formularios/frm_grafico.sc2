		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'fc1' AS foxcharts WITH ;
		Height = 556, ;
		Left = 18, ;
		Name = "fc1", ;
		Top = 8, ;
		Width = 916, ;
		Title.Name = "Title", ;
		SubTitle.Name = "SubTitle", ;
		XAxis.Name = "XAxis", ;
		YAxis.Name = "YAxis", ;
		ScaleLegend.Name = "ScaleLegend", ;
		AxisLegend2.Name = "AxisLegend2", ;
		ShapeLegend.Name = "ShapeLegend", ;
		SideLegend.Name = "SideLegend", ;
		ChartCanvas.Name = "ChartCanvas", ;
		Fields.Name = "Fields", ;
		ToolTip.Name = "ToolTip", ;
		YAxis2.Name = "YAxis2"
		*< END OBJECT: ClassLib="..\clases\foxcharts.vcx" BaseClass="container" />
	
	PROCEDURE Init
		PARAMETERS xmedida,xtitulo,xsubtitulo
		
		  WITH ThisForm.FC1
		    .ChartsCount          = 1                && Cantidad de columnas de la tabla que tienen datos numéricos
		    .FieldAxis2           = "TEM_CFILL1"     && Etiquetas que se mostrarán en el eje X
		    .FieldColor           = "TEM_NFILL2"     && Colores que tendrán las series
		    .FieldDetachSlice     = "TEM_LFILL1"     && Las porciones se mostrarán juntas o separadas
		    .FieldHideSlice       = "TEM_LFILL2"     && Las porciones se mostrarán o se ocultarán
		    .FieldLegend          = "TEM_CFILL1"     && Leyenda que se mostrará en las series
		    .Fields(1).FieldValue = "TEM_NFILL1"     && Valor numérico de la serie, el que se muestra en el gráfico
		    .Fields(1).Legend     = ""               && Cuando hay más de una serie aquí se pone el nombre de cada serie, para distinguirlas
		    .Fields(1).Color      = RGB(0, 0, 128)   && Azul oscuro
		    .Fields(1).Shape      = 1                && Estrella
		    .SourceAlias          = "CURSOR_GRAFICO1"
		    .SubTitle.Caption     = xsubtitulo
		    .Title.Caption        = xtitulo
		    .Visible              = .T.
		    .xAxis.Caption        = "Meses"
		    .yAxis.Caption        = ICASE(xmedida="MT","en metros", ;
		                                  xmedida="UN","en unidades", ;
		                                  xmedida="KG","en kilogramos")
		    .DrawChart()
		  ENDWITH
		ThisForm.Combo1.Value = 7
		=DODEFAULT()
		 
		RETURN
	ENDPROC

	PROCEDURE Load
		SET CONSOLE OFF
		SET TALK OFF
		SET NOTIFY OFF
		
		_REPORTOUTPUT = FULLPATH("REPORTOUTPUT.APP")
		 
		  DO SYSTEM.APP
		 
		RETURN
		*
		*
	ENDPROC

	PROCEDURE Combo1.Init
		This.AddProperty("aCharts[1]")
		 
		  DIMENSION This.aCharts(17)
		 
		  WITH This
		    .aCharts( 1) = " 1 - Torta "
		    .aCharts( 2) = " 2 - Rosca "
		    .aCharts( 3) = " 3 - Barras apiladas-completas "
		    .aCharts( 4) = " 4 - Puntos "
		    .aCharts( 5) = " 5 - Líneas "
		    .aCharts( 6) = " 6 - Area "
		    .aCharts( 7) = " 7 - Barras simples "
		    .aCharts( 8) = " 8 - Barras múltiples "
		    .aCharts( 9) = " 9 - Barras apiladas "
		    .aCharts(10) = "10 - Área apilada "
		    .aCharts(11) = "11 - Barras en 3D "
		    .aCharts(12) = "12 - Barras simples horizontales "
		    .aCharts(13) = "13 - Barras múltiples horizontales "
		    .aCharts(14) = "14 - Barras apiladas horizontales "
		    .aCharts(15) = "15 - Barras apiladas horizontales completas"
		    .aCharts(16) = "16 - Área apilada completa "
		    .aCharts(17) = "17 - Barras horizontales emparejadas "
		    .RowSourceType = 5     && Array
		    .RowSource = "This.aCharts"
		  ENDWITH
		 
		RETURN
		*
		*
		
	ENDPROC

	PROCEDURE Combo1.InteractiveChange
		LOCAL lnChart
		 
		  lnChart = This.Value
		 
		  IF lnChart == 2     && Rosca
		    ThisForm.FC1.Shadow = .F.
		  ENDIF
		 
		  IF lnChart == 16     && No funciona, siempre muestra un mensaje de error
		    RETURN
		  ENDIF
		 
		RETURN
		*
		*
	ENDPROC

	PROCEDURE Combo1.Valid
		LOCAL lnChart
		 
		  lnChart = This.ListIndex
		 
		  IF lnChart = 16     && No funciona, siempre muestra un mensaje de error
		    RETURN
		  ENDIF
		 
		  WITH ThisForm.FC1
			IF lnChart >= 12
				.xAxis.Caption        = ICASE(xmedida="MT","en metros", ;
		                                      xmedida="UN","en unidades", ;
		                                      xmedida="KG","en kilogramos")
				.yAxis.Caption        = "Meses"
			ELSE
				.xAxis.Caption        = "Meses"
				.yAxis.Caption        = ICASE(xmedida="MT","en metros", ;
		                                      xmedida="UN","en unidades", ;
		                                      xmedida="KG","en kilogramos")
			ENDIF
			.ChartType = lnChart
		    .DrawChart()
		  ENDWITH
		 
		RETURN
		*
		*
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL lcImgFormatTypes, lcFile
		 
		  lcImgFormatTypes = "JPG;BMP;GIF;PNG;TIF;EMF"
		 
		  lcFile = PutFile("Grabar imagen como...", "", lcImgFormatTypes)
		 
		  IF Empty(lcFile)     && Nombre de archivo inválido
		    RETURN (.F.)
		  ENDIF
		 
		  ThisForm.FC1.SaveToFile(lcFile)
		 
		RETURN
		*
		*
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC


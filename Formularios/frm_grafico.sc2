		Height = 631
		Icon = ..\imagen\vbe7_1251.ico
		MaxButton = .F.
		MinButton = .F.
		Name = "frm_grafico"
		Width = 953
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Combo1' AS combobox WITH ;
		Height = 24, ;
		Left = 290, ;
		Name = "Combo1", ;
		Style = 2, ;
		Top = 590, ;
		Width = 289
		*< END OBJECT: BaseClass="combobox" />

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "Grabar Grafico", ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 610, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 587, ;

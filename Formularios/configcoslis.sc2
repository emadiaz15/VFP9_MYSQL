	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		SET DATE BRITISH
		SET CENTURY on
		CREATE CURSOR coslist(art_codi N(8),art_desc C(45),rub_desc C(53),costo N(10,3),ctovta N(10,3),lista L,artpro_codi N(8))
		thisform.txt_codiprov.Value=0
		thisform.txt_codrub.Value=0
	ENDPROC

	PROCEDURE nboldfila
		LParameters tnsel
		
		Local lnBold
		
			DO case
				CASE tnsel = .T.
					lnBold = .T.
				CASE tnsel = .F.
					lnBold = .F.
			ENDCASE
		Return(lnBold)
	ENDPROC

	PROCEDURE ncolorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = .T.
					lnColor = RGB(255,0,0)
				CASE tnsel = .F.
					lnColor = RGB(0,0,0)
			ENDCASE
		Return(lnColor)
	ENDPROC

	PROCEDURE chk_rub.Click
		IF this.Value=1
			thisform.ncodirub=0
			thisform.txt_codrub.value=0
			thisform.cmb_rub.value=''
			thisform.cmb_rub.RowSource=''
			thisform.cmd_actualizar.click
			thisform.cmd_actualizar.setfocus
		ELSE
			thisform.ncodirub=0
			thisform.txt_codrub.SetFocus
		endif
	ENDPROC

	PROCEDURE chk_todos.Click
		IF this.Value=1
			UPDATE costolis SET lista=.T.
			this.Caption="Desmarcar Todos"
			GO top
		ELSE
			UPDATE costolis SET lista=.F.
			this.Caption="Seleccionar Todos"
			GO top
		ENDIF
			
	ENDPROC

	PROCEDURE cmb_prov.Click
		this.setfocus
	ENDPROC

	PROCEDURE cmb_prov.Destroy
		set notify on
	ENDPROC

	PROCEDURE cmb_prov.GotFocus
		set notify off
		
		
	ENDPROC

	PROCEDURE cmb_prov.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					frmcoslis= conectar_db(_screen.cn)
						xnomp=allt(this.list(i))
						SQLEXEC(frmcoslis,"select * from proveedores where TRIM(prov_nomb)=?xnomp;","cur_pro")
					desconectar_db(frmcoslis)
					thisform.txt_codiprov.value=cur_pro.prov_codi
					thisform.ncodiprov=cur_pro.prov_codi
					thisform.cmd_actualizar.setfocus
					keyboard '{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE cmb_prov.LostFocus
		IF thisform.ncodiprov>0
			thisform.cmd_actualizar.Click
		endif
	ENDPROC

	PROCEDURE cmb_prov.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade="%"+subst(allt(this.text),2,len(allt(this.text)))+"%"
				frmcoslis= conectar_db(_screen.cn)
					SQLEXEC(frmcoslis,"select * from proveedores where prov_nomb like ?cade order by prov_nomb;","cur_pro")
				desconectar_db(frmcoslis)
				IF RECCOUNT("cur_pro")>0
					this.rowsource="select prov_nomb from cur_pro INTO CURSOR cmb_prov"
					this.value=this.list(1)
					keyboard "{F4}"
					return .F.
				endif
			else
				if len(allt(this.text))>0
					cade=ALLTRIM(this.text)+"%"
					frmcoslis= conectar_db(_screen.cn)
						SQLEXEC(frmcoslis,"select * from proveedores where prov_nomb like ?cade;","cur_pro")
					desconectar_db(frmcoslis)
					IF RECCOUNT("cur_pro")>0
						this.rowsource="select prov_nomb from cur_pro INTO CURSOR cmb_prov"
						this.value=this.list(1)
						keyboard "{F4}"
						return .F.
					endif
				endif
			endif
		endif
	ENDPROC

	PROCEDURE cmb_rub.Click
		this.setfocus
	ENDPROC

	PROCEDURE cmb_rub.Destroy
		set notify on
	ENDPROC

	PROCEDURE cmb_rub.GotFocus
		set notify off
		
		
	ENDPROC

	PROCEDURE cmb_rub.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					frmcoslis= conectar_db(_screen.cn)
						xdesc=allt(this.list(i))
						SQLEXEC(frmcoslis,"select * from rubros where TRIM(rub_desc)=?xdesc;","cur_rub")
					desconectar_db(frmcoslis)
					thisform.txt_codrub.value=cur_rub.rub_codi
					thisform.ncodirub=cur_rub.rub_codi
					thisform.chk_rub.Value=0
					keyboard '{TAB}'+'{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE cmb_rub.LostFocus
		IF thisform.ncodirub>0
			thisform.cmd_actualizar.Click
		endif
	ENDPROC

	PROCEDURE cmb_rub.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade="%"+subst(allt(this.text),2,len(allt(this.text)))+"%"
				frmcoslis= conectar_db(_screen.cn)
					SQLEXEC(frmcoslis,"select * from rubros where rub_desc like ?cade order by rub_desc;","cur_rub")
				desconectar_db(frmcoslis)
				IF RECCOUNT("cur_rub")>0
					this.rowsource="select rub_desc from cur_rub INTO CURSOR cmb_rub"
					this.value=this.list(1)
					keyboard "{F4}"
					return .F.
				endif
			else
				if len(allt(this.text))>0
					cade=ALLTRIM(this.text)+"%"
					frmcoslis= conectar_db(_screen.cn)
						SQLEXEC(frmcoslis,"select * from rubros where rub_desc like ?cade;","cur_rub")
					desconectar_db(frmcoslis)
					IF RECCOUNT("cur_rub")>0
						this.rowsource="select rub_desc from cur_rub INTO CURSOR cmb_rub"
						this.value=this.list(1)
						keyboard "{F4}"
						return .F.
					endif
				endif
			endif
		endif
	ENDPROC

	PROCEDURE cmd_actualizar.Click
		IF thisform.ncodiprov>0
			thisform.grd_costos.RecordSource=''
			thisform.grd_costos.Refresh()
		
			SET DECIMALS TO 3
			frmcoslis= conectar_db(_screen.cn)
				SQLEXEC(frmcoslis,"call usp_costolis(?thisform.ncodiprov,?thisform.ncodirub);","cur_costos")
			desconectar_db(frmcoslis)
			SET DEFAULT TO
		
			IF RECCOUNT("cur_costos")>0
				SELECT art_codi,art_desc,rub_desc,artpro_costo as costo,artpro_ctovta as ctovta,IIF(lista=1,.T.,.F.) as lista,artpro_codi ;
					FROM cur_costos WHERE art_codi>5 INTO CURSOR costolis readwrite
				thisform.grd_costos.RecordSource="costolis"
				thisform.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(costolis.lista)","Column")
				thisform.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(costolis.lista)","Column")
				thisform.grd_costos.COLUMN5.DynamicBackColor='RGB(237,208,115)'
				thisform.chk_todos.Enabled= .T.
				thisform.cmd_save.Enabled= .T.
				LOCAL cantsel,ubireg
				cantsel=0
				ubireg=0
		
				SELECT costolis
				ubireg=RECNO()
				LOCATE
				COUNT ALL FOR lista=.T. TO cantsel
				GO ubireg
		
				IF RECCOUNT("costolis")=cantsel
					thisform.chk_todos.Caption="\<Desmarcar Todos"
					thisform.chk_todos.Value=1
				ELSE
					thisform.chk_todos.Caption="\<Seleccionar Todos"
					thisform.chk_todos.Value=0
				ENDIF	
			ENDIF
		ELSE
			thisform.txt_codiprov.SetFocus
			thisform.chk_todos.Enabled= .F.
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_actualizar.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_actualizar.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_return.Click
		thisform.Release
		
	ENDPROC

	PROCEDURE cmd_return.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_return.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_save.Click
		IF RECCOUNT("costolis")>0
			SELECT costolis
			GO top
			SCAN
				frmcoslis= conectar_db(_screen.cn)
					IF costolis.lista=.T.
						SQLEXEC(frmcoslis,"update articulos_proveedores set lista=1 where artpro_codi=?costolis.artpro_codi;")
					ELSE
						SQLEXEC(frmcoslis,"update articulos_proveedores set lista=0 where artpro_codi=?costolis.artpro_codi;")
					ENDIF
				desconectar_db(frmcoslis)
			ENDSCAN
		ENDIF
		
		thisform.txt_codiprov.Value=0
		thisform.txt_codrub.Value=0
		thisform.cmb_prov.RowSource=''
		thisform.cmb_prov.Value=''
		thisform.cmb_rub.RowSource=''
		thisform.cmb_rub.Value=''
		thisform.chk_rub.Value=1
		thisform.chk_todos.Value=0
		thisform.chk_todos.Enabled= .F.
		thisform.grd_costos.RecordSource=''
		thisform.grd_costos.Refresh()
		this.Enabled= .F.
		thisform.txt_codiprov.SetFocus
		
	ENDPROC

	PROCEDURE cmd_save.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_save.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Ctn_banner1.Init
		this.Height=107
		this.left=0
		this.Width=this.Parent.Width
		
	ENDPROC

	PROCEDURE grd_costos.Column5.Check1.Click
		LOCAL cantsel,ubireg
		cantsel=0
		ubireg=0
		
		SELECT costolis
		ubireg=RECNO()
		LOCATE
		COUNT ALL FOR lista=.T. TO cantsel
		GO ubireg
		
		IF RECCOUNT("costolis")=cantsel
			thisform.chk_todos.Caption="\<Desmarcar Todos"
			thisform.chk_todos.Value=1
		ELSE
			thisform.chk_todos.Caption="\<Seleccionar Todos"
			thisform.chk_todos.Value=0
		ENDIF
	ENDPROC

	PROCEDURE txt_codiprov.Click
		this.value=0
		this.setfocus
	ENDPROC

	PROCEDURE txt_codiprov.GotFocus
		set notify off
		thisform.cmb_prov.rowsourcetype=3
		
	ENDPROC

	PROCEDURE txt_codiprov.LostFocus
		set notify on
	ENDPROC

	PROCEDURE txt_codiprov.Valid
		if this.value>0
			frmcoslis= conectar_db(_screen.cn)
				SQLEXEC(frmcoslis,"select * from proveedores where prov_codi=?this.value;","cur_pro")
			desconectar_db(frmcoslis)
			if RECCOUNT("cur_pro")>0
				thisform.ncodiprov=cur_pro.prov_codi
				thisform.cmb_prov.rowsource="SELECT prov_nomb FROM cur_pro INTO CURSOR cmb_prov"
				thisform.cmb_prov.value=thisform.cmb_prov.list(1)
				thisform.txt_codrub.Value=0
				thisform.cmb_rub.RowSource=''
				thisform.cmb_rub.Value=''
				thisform.chk_rub.Value=1
				thisform.ncodirub=0
				thisform.cmd_actualizar.Click
				keyboard '{TAB}'
			else
				=messagebox("Proveedor no está en archivo",0+48,"Advertencia")
				thisform.ncodiprov=0
				this.value=0
				return .F.
			endif
		endif
	ENDPROC

	PROCEDURE txt_codrub.Click
		this.value=0
		this.setfocus
	ENDPROC

	PROCEDURE txt_codrub.GotFocus
		set notify off
		thisform.cmb_rub.rowsourcetype=3
	ENDPROC

	PROCEDURE txt_codrub.LostFocus
		set notify on
	ENDPROC

	PROCEDURE txt_codrub.Valid
		if this.value>0
			frmcoslis= conectar_db(_screen.cn)
				SQLEXEC(frmcoslis,"select * from rubros where rub_codi=?this.value;","cur_rub")
			desconectar_db(frmcoslis)
			if RECCOUNT("cur_rub")>0
				thisform.ncodirub=cur_rub.rub_codi
				thisform.cmb_rub.rowsource="SELECT rub_desc FROM cur_rub INTO CURSOR cmb_rub"
				thisform.cmb_rub.value=thisform.cmb_rub.list(1)
				thisform.chk_rub.Value=0
				thisform.cmd_actualizar.Click
				keyboard '{TAB}'+'{TAB}'
			else
				=messagebox("Rubro no está en archivo",0+48,"Advertencia")
				thisform.ncodirub=0
				this.value=0
				return .F.
			endif
		endif
	ENDPROC

ENDDEFINE

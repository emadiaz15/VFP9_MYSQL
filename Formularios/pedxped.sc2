		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		do case
		case thisform.nitem=0
			messagebox("Aún no ha ingresado ningún artículo al Pedido, imposible Guardar",48,"Advertencia")
			RETURN
		CASE thisform.text7.Value = 0
			MESSAGEBOX("Debe ingresar el número de nota de pedido",48,"Aviso del Sistema")
			thisform.text7.SetFocus
			RETURN
		case thisform.text21.value=0 and thisform.text15.value>0
			messagebox("Debe ingresar la comisión del vendedor para guardar el Pedido.",0+48,"Advertencia")
			RETURN
		CASE coditran1=0 AND coditran2>0
			MESSAGEBOX("Si seleccionó Transporte de Redespacho no puede guardar el pedido sin antes seleccionar un Transporte de Orígen.",0+48,"Advertencia")
			RETURN
		CASE thisform.ctn_moneda.chk_dolares.Value = 0 AND thisform.ctn_moneda.chk_pesos.Value = 0
			MESSAGEBOX("Para continuar debe especificar la moneda para el pedido.",48,"Aviso del Sistema")
			RETURN
		CASE thisform.ctn_moneda.chk_pesos.Value = 1 AND thisform.txt_cotiz.Value = 0
			MESSAGEBOX("Usted ha optado por la moneda PESOS, por lo tanto, debe especificar un importe de cotización de dolar mayor a 0.-",48,"Aviso del Sistema")
			thisform.txt_cotiz.SetFocus
			RETURN	
		OTHERWISE
			with thisform
				LOCAL xcodip,xfecha,xhora,xdto,xpres,xnped,xcodiven,xotracomi,xdasc,xarti,xdac,xcant,xprec,xlug,xcar,xarpc,xent,xmoneda,xcoti,xit,lnLock
				lnLock = 0
				xfecha=.text13.value
				xhora = IIF(.text13.value < DATE(),'23:59:59',TTOC(DATETIME(),2))
				xdto=.text19.value
				xpres = 0
				xnped=.text7.value
				xcodiven=.text15.value
				xotracomi=IIF(LEN(ALLTRIM(.text20.value))=0 and .text21.value>0,.text21.value,0)
				IF thisform.npedi=0
					xcodip=0
					frmaltaped= conectar_db(_screen.cn)
						DO CASE
							CASE thisform.ctn_moneda.chk_dolares.Value = 1
								xmoneda = 'D'
								xcoti = thisform.xcotiz
							CASE thisform.ctn_moneda.chk_pesos.Value = 1
								xmoneda = 'P'
								xcoti = thisform.txt_cotiz.value
						ENDCASE
						lnLock = MySQL_LockTables("LOCK", "pedidos WRITE", frmaltaped)
						SQLEXEC(frmaltaped,"call usp_guardaped(1,?xcodip,?xfecha,?xhora,?thisform.codicli,?xdto,?codiva,?xpres,?xnped,?xcodiven,?porcodi,?xotracomi,?obser,?xmoneda,?xcoti);","cur_nvo")
						lnLock = MySQL_LockTables("UNLOCK", "", frmaltaped)
						thisform.npedi=cur_nvo.ped_codi
						xcodip=thisform.npedi
						IF coditran1>0
							xlug=ALLTRIM(thisform.edit1.value)
							DO case
								CASE thisform.opcionflete1.Value=1
									xcar='C'
								CASE thisform.opcionflete1.Value=2
									xcar='P'
							ENDCASE
							SQLEXEC(frmaltaped,"select CAST(pedtran_codi+1 as DECIMAL(8,0)) as pedtran_codi from pedidos_transportes order by pedtran_codi desc limit 1;","cur_ptnvo")
							SQLEXEC(frmaltaped,"insert into pedidos_transportes values(?cur_ptnvo.pedtran_codi,?xcodip,?coditran1,?xlug,?xcar);")
						endif
						IF coditran2>0
							xlug=ALLTRIM(thisform.edit2.value)
							DO case
								CASE thisform.opcionflete2.Value=1
									xcar='C'
								CASE thisform.opcionflete2.Value=2
									xcar='P'
							ENDCASE
							SQLEXEC(frmaltaped,"select CAST(pedtran_codi+1 as DECIMAL(8,0)) as pedtran_codi from pedidos_transportes order by pedtran_codi desc limit 1;","cur_ptnvo")
							SQLEXEC(frmaltaped,"insert into pedidos_transportes values(?cur_ptnvo.pedtran_codi,?xcodip,?coditran2,?xlug,?xcar);")
						ENDIF
					desconectar_db(frmaltaped)
					for fila=1 to .grid1.rows
						if fila<.grid1.rows
							.grid1.row=fila
							.grid1.col=3
							if val(.grid1.text)=4 OR val(.grid1.text)=5
								.grid1.col=4
								xdasc=ALLTRIM(.grid1.text)
							else
								xdasc=""
							endif
							.grid1.col=3
							xarti=val(.grid1.text)
							.grid1.col=4
							frmaltaped= conectar_db(_screen.cn)
								SQLEXEC(frmaltaped,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
							desconectar_db(frmaltaped)
							if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
								frmaltaped= conectar_db(_screen.cn)
									SQLEXEC(frmaltaped,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
								desconectar_db(frmaltaped)
								IF RECCOUNT("cur_artcli")>0
									LOCAL xcadena
									xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(.grid1.text)
									frmaltaped= conectar_db(_screen.cn)
										SQLEXEC(frmaltaped,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
									desconectar_db(frmaltaped)
									IF RECCOUNT("cur_ddes")>0
										xdac=cur_ddes.dac_codi
									endif
								endif
							else
								xdac=0
							ENDIF
							.grid1.col=0
							xit=VAL(.grid1.text)
							.grid1.col=1
							xcant=ConverNro(.grid1.text)			
							.grid1.col=5
							xprec=ConverNro(.grid1.text)
							frmaltaped= conectar_db(_screen.cn)
								lnLock = MySQL_LockTables("LOCK", "pedidos_articulos WRITE", frmaltaped)
								SQLEXEC(frmaltaped,"select cast(artped_codi+1 as DECIMAL(8,0)) as artped_codi from pedidos_articulos order by artped_codi desc limit 1;","cur_pednvo")
								SQLEXEC(frmaltaped,"insert into pedidos_articulos values(?cur_pednvo.artped_codi,?xcodip,?xarti,?xcant,?xprec,0,0,?xdasc,?xdac,?xit);")
								lnLock = MySQL_LockTables("UNLOCK", "", frmaltaped)
		*!*							SQLEXEC(frmaltaped,"update articulos set pedidos = pedidos + ?xcant where art_codi = ?xarti;")
							desconectar_db(frmaltaped)
							.grid1.col=8
							.grid1.text=ALLTRIM(STR(cur_pednvo.artped_codi))
							IF xarti > 5
								Campo_ped(xarti)
							ENDIF
						endif
					next fila
					thisform.buscar_pedido(xcodip)
					cerrar_cursor("cur_arped")
				ELSE
					DO CASE
						CASE thisform.ctn_moneda.chk_dolares.Value = 1
							xmoneda = 'D'
							xcoti = thisform.xcotiz
						CASE thisform.ctn_moneda.chk_pesos.Value = 1
							xmoneda = 'P'
							xcoti = thisform.txt_cotiz.Value
					ENDCASE
					xcodip=thisform.npedi
					frmaltaped= conectar_db(_screen.cn)
						SQLEXEC(frmaltaped,"call usp_guardaped(2,?xcodip,?xfecha,?xhora,?thisform.codicli,?xdto,?codiva,?thisform.npres,?xnped,?xcodiven,?porcodi,?xotracomi,?obser,?xmoneda,?xcoti);")
						IF coditran1>0
							SQLEXEC(frmaltaped,"select * from pedidos_transportes where ped_codi=?xcodip;","cur_tra")
							xlug=ALLTRIM(thisform.edit1.value)
							DO case
								CASE thisform.opcionflete1.Value=1
									xcar='C'
								CASE thisform.opcionflete1.Value=2
									xcar='P'
							ENDCASE
							IF RECCOUNT("cur_tra")>0
								GO top
								SQLEXEC(frmaltaped,"update pedidos_transportes set tran_codi=?coditran1,flete_lugent=?xlug,flete_cargo=?xcar where pedtran_codi=?cur_tra.pedtran_codi;")
							ELSE
								SQLEXEC(frmaltaped,"select CAST(pedtran_codi+1 as DECIMAL(8,0)) as pedtran_codi from pedidos_transportes order by pedtran_codi desc limit 1;","cur_ptnvo")
								SQLEXEC(frmaltaped,"insert into pedidos_transportes values(?cur_ptnvo.pedtran_codi,?xcodip,?coditran1,?xlug,?xcar);")					
							ENDIF
							IF coditran2>0
								xlug=ALLTRIM(thisform.edit2.value)
								DO case
									CASE thisform.opcionflete2.Value=1
										xcar='C'
									CASE thisform.opcionflete2.Value=2
										xcar='P'
								ENDCASE
								IF RECCOUNT("cur_tra")>1
									SKIP IN cur_tra
									SQLEXEC(frmaltaped,"update pedidos_transportes set tran_codi=?coditran2,flete_lugent=?xlug,flete_cargo=?xcar where pedtran_codi=?cur_tra.pedtran_codi;")
								ELSE
									SQLEXEC(frmaltaped,"select CAST(pedtran_codi+1 as DECIMAL(8,0)) as pedtran_codi from pedidos_transportes order by pedtran_codi desc limit 1;","cur_ptnvo")
									SQLEXEC(frmaltaped,"insert into pedidos_transportes values(?cur_ptnvo.pedtran_codi,?xcodip,?coditran2,?xlug,?xcar);")							
								ENDIF
							ELSE
								IF RECCOUNT("cur_tra")>1
									SKIP IN cur_tra
									SQLEXEC(frmaltaped,"delete from pedidos_transportes where pedtran_codi=?cur_tra.pedtran_codi;")
								ENDIF
							ENDIF
						ELSE
							SQLEXEC(frmaltaped,"select * from pedidos_transportes where ped_codi=?xcodip;","cur_tra")
							IF RECCOUNT("cur_tra")>0
								SQLEXEC(frmaltaped,"delete from pedidos_transportes where ped_codi=?xcodip;")
							ENDIF
						ENDIF
						IF USED("delitems")
							SELECT delitems
							LOCATE
							IF RECCOUNT("delitems") > 0
								SCAN
		*!*								IF delitems.art_codi > 5
		*!*									SQLEXEC(frmaltaped,"update articulos set pedidos = pedidos - ?delitems.artped_cant where art_codi = ?delitems.art_codi;")
		*!*								ENDIF
									SQLEXEC(frmaltaped,"delete from pedidos_articulos where artped_codi = ?delitems.artped_codi;")
									IF delitems.art_codi > 5
										Campo_ped(delitems.art_codi)
									ENDIF
								ENDSCAN
								cerrar_cursor("delitems")
							ENDIF
						ENDIF
					desconectar_db(frmaltaped)
					for fila=1 to .grid1.rows
						if fila<.grid1.rows
							.grid1.row=fila
							.grid1.col=3
							if val(.grid1.text)<=5
								.grid1.col=4
								xdasc=ALLTRIM(.grid1.text)
							else
								xdasc=""
							endif
							.grid1.col=3
							xarti=val(.grid1.text)
							.grid1.col=4
							frmaltaped= conectar_db(_screen.cn)
								SQLEXEC(frmaltaped,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
							desconectar_db(frmaltaped)
							if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
								frmaltaped= conectar_db(_screen.cn)
									SQLEXEC(frmaltaped,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
								desconectar_db(frmaltaped)
								IF RECCOUNT("cur_artcli")>0
									LOCAL xcadena
									xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(.grid1.text)
									frmaltaped= conectar_db(_screen.cn)
										SQLEXEC(frmaltaped,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
									desconectar_db(frmaltaped)
									IF RECCOUNT("cur_ddes")>0
										xdac=cur_ddes.dac_codi
									endif
								endif
							else
								xdac=0
							ENDIF
							SET POINT TO ","
							SET DECIMALS TO 3
							.grid1.col=0
							xit=VAL(ALLTRIM(.grid1.text))
							.grid1.col=1
							xcant=ConverNro(.grid1.text)
							.grid1.col=5
							xprec=ConverNro(.grid1.text)
							.grid1.col=8
							xarpc=VAL(.grid1.text)
							.grid1.col=9
							xent=ConverNro(.grid1.text)
							SET POINT TO
							SET DECIMALS TO
							frmaltaped= conectar_db(_screen.cn)
								IF xarpc>0
		*!*								IF USED("cur_modic")
		*!*									SELECT cur_modic
		*!*									LOCATE
		*!*									SCAN
		*!*										artmodi = cur_modic.m_artcod
		*!*										canmodi = cur_modic.m_artcan
		*!*										SQLEXEC(frmaltaped,"update articulos set pedidos = pedidos - ?canmodi where art_codi = ?artmodi;")
		*!*									ENDSCAN
		*!*									cerrar_cursor("cur_modic")
		*!*								ENDIF
									SELECT ROUND(act_pend - ant_pend,3) fpend, actu FROM cur_pend WHERE artped_codi = xarpc INTO ARRAY ar_xpendi
									xdelpend = ar_xpendi[1,1]
									SQLEXEC(frmaltaped,"update pedidos_articulos set art_codi=?xarti,artped_cant=?xcant,artped_precio=?xprec,artped_dasc=?xdasc,dac_codi=?xdac,artped_it=?xit WHERE artped_codi=?xarpc;")
		*!*								IF ar_xpendi[1,2] = 1
		*!*									SQLEXEC(frmaltaped,"update articulos set pedidos = pedidos + ?xdelpend where art_codi = ?xarti;")
		*!*								ENDIF
								ELSE
									lnLock = MySQL_LockTables("LOCK", "pedidos_articulos WRITE", frmaltaped)
									SQLEXEC(frmaltaped,"select cast(artped_codi+1 as DECIMAL(8,0)) as artped_codi from pedidos_articulos order by artped_codi desc limit 1;","cur_pednvo")
									IF RECCOUNT("cur_pednvo")>0
										xarpc=cur_pednvo.artped_codi
									ELSE
										xarpc=1
									ENDIF
									SQLEXEC(frmaltaped,"insert into pedidos_articulos values(?xarpc,?xcodip,?xarti,?xcant,?xprec,0,?xent,?xdasc,?xdac,?xit);")
									lnLock = MySQL_LockTables("UNLOCK", "", frmaltaped)
		*!*								SQLEXEC(frmaltaped,"update articulos set pedidos = pedidos + ?xcant where art_codi = ?xarti;")
									.grid1.col=8
									.grid1.text=STR(cur_pednvo.artped_codi)			
								ENDIF
							desconectar_db(frmaltaped)
							IF xarti > 5
								Campo_ped(xarti)
							ENDIF
						ENDIF
					next fila
					cerrar_cursor("cur_pend")
					thisform.buscar_pedido(thisform.npedi)
					cerrar_cursor("cur_arped")
				ENDIF
			endwith
		ENDCASE
		MESSAGEBOX("Los datos fueron guardados corréctamente.",64,"Aviso del Sistema")
		
	ENDPROC


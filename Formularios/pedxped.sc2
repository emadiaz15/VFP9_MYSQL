	PROCEDURE ctn_moneda.chk_dolares.Click
		IF this.Value=1 AND this.Parent.chk_pesos.Value=1
			this.Parent.chk_pesos.Value=0
		*!*		thisform.ctn_moneda.Top=26
			thisform.lbl_cotiz.Visible= .F.
			thisform.txt_cotiz.Visible= .F.
			thisform.txt_cotiz.Value=0
		ENDIF
	ENDPROC

	PROCEDURE ctn_moneda.chk_dolares.InteractiveChange
		thisform.moneda_obser()
	ENDPROC

	PROCEDURE ctn_moneda.chk_pesos.Click
		&&IF this.Value=1 AND this.Parent.chk_dolares.Value=1
		IF this.Value=1
			this.Parent.chk_dolares.Value=0
		*!*		thisform.ctn_moneda.Top=3
			IF thisform.cotiz>0
				pc= MESSAGEBOX("La última cotización guardada para este pedido "+CHR(13)+ ;
							   "es igual a $ "+ALLTRIM(STR(thisform.cotiz,15,3))+".-"+CHR(13)+CHR(13)+ ;
							   "¿Quiere conservarla?",4+32+256,"Aviso del Sistema")
				IF pc=6
					thisform.txt_cotiz.Value=thisform.cotiz
				else
					thisform.txt_cotiz.Value=0
				ENDIF
			ELSE
				thisform.txt_cotiz.Value=0
			ENDIF
			thisform.lbl_cotiz.Visible= .T.
			thisform.txt_cotiz.Visible= .T.
			IF pc=7
				thisform.txt_cotiz.SetFocus
			ENDIF
		*!*		thisform.txt_cotiz.Value=0
		ELSE
		*!*		thisform.ctn_moneda.Top=26
			thisform.lbl_cotiz.Visible= .F.
			thisform.txt_cotiz.Visible= .F.
		ENDIF
	ENDPROC

	PROCEDURE ctn_moneda.chk_pesos.InteractiveChange
		thisform.moneda_obser()
	ENDPROC


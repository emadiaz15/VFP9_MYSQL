	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
		THISFORM.Grid_RefrescarDetalleStock()
	ENDPROC

	PROCEDURE grid1.DblClick
		*** ActiveX Control Event ***
		local x,y,dtopie,ivaencol
		ivaencol=0
		if thisform.nitem>0
			this.col=0
			aux=val(this.text)
			this.col=3
			dato1=val(this.text)
			this.col=1
			dato2=this.text
			this.col=4
			dato3=this.text
			this.col=5
			dato4=this.text
			this.col=6
			prtot=this.text
			this.col=2
			dato5=this.text
			auxiva=0
			auximpo=0
			frmaltaped= conectar_db(_screen.cn)
				SQLEXEC(frmaltaped,"select * from articulos where art_codi=?dato1;","cur_arti")
			desconectar_db(frmaltaped)
			impiva1=thisform.impiva1
			impiva2=thisform.impiva2
			do form modippreg with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		ENDIF
		if borra=6
			with thisform
				SET POINT TO ","
				SET DECIMALS TO 3
				LOCAL xdelarp,xdelart,xdelcant,xdelent,xdelfac
				this.col=8
				xdelarp=VAL(this.text)
				this.col=3
				xdelart=VAL(this.text)
				this.col=1
				xdelcant=ConverNro(this.text)
				this.col=9
				xdelent=ConverNro(this.text)
				this.col=10
				xdelfac=ConverNro(this.text)
				IF xdelent>0 OR xdelfac>0
					xmens = ICASE(xdelent>0 and xdelfac>0,'Este ítem fue FACTURADO y REMITADO total o parcialmente, imposible eliminar.', ;
			 					  xdelent>0 and xdelfac=0,'Este ítem fue REMITADO total o parcialmente, imposible eliminar.', ;
								  xdelent=0 and xdelfac>0,'Este ítem fue FACTURADO total o parcialmente, imposible eliminar.')
					=MESSAGEBOX(xmens,0+48,"Aviso del Sistema")
				ELSE
					IF !USED("delitems")
						CREATE CURSOR delitems(artped_codi N(8),art_codi N(8),artped_cant N(10,3))
					ENDIF		
					INSERT INTO delitems VALUES(xdelarp,xdelart,xdelcant)
					DELETE FROM cur_pend WHERE artped_codi = xdelarp
					if this.rows=2
						this.col=7
						do case
							case ConverNro(this.text)=thisform.impiva1
								ivaencol=1
							case ConverNro(this.text)=thisform.impiva2
								ivaencol=2
						endcase
						this.col=6
						prtot=this.text
						thisform.nitem=0
						this.rows=1
						thisform.acu=0
						thisform.impo1=0
						thisform.impo2=0
						thisform.acun1=0
						thisform.acun2=0
						thisform.acu1=0
						thisform.acu2=0
						.text8.value=0
						.text9.value=0
						.text10.value=0
						.text11.value=0
						.text17.value=0
						.text18.value=0
						.text19.value=0
					else
						this.col=7
						do case
							case ConverNro(this.text)=thisform.impiva1
								ivaencol=1
							case ConverNro(this.text)=thisform.impiva2
								ivaencol=2
						endcase
						this.col=6
						prtot=this.text
						thisform.acu=thisform.acu-ConverNro(this.text)
						thisform.nitem=thisform.nitem-1
						this.removeitem(this.row)
						this.col=2
						x=1
						y=0
						do while x<=this.rows-1
							this.row=x
							y=y+1
							this.col=0
							this.text=allt(str(y))
							x=x+1
						enddo
					endif
					thisform.text8.value=thisform.acu
					if this.rows=>2
						if thisform.text19.value>0
							dtopie=round((100-thisform.text19.value)/100,2)
							thisform.text17.value=thisform.acu*dtopie
							thisform.text18.value=thisform.acu-thisform.text17.value
							do case
								case ivaencol=1
									thisform.impo1=thisform.impo1-(ConverNro(prtot)*dtopie)
									if cond=2
										thisform.text9.value=thisform.text9.value-round((ConverNro(prtot)*dtopie)*thisform.impiva1/100,2)
									else
										auxacuneto=thisform.acun1
										thisform.acun1=thisform.acun1-((ConverNro(prtot)*dtopie)/(1+(thisform.impiva1/100)))
										thisform.acu1=thisform.acu1-(auxacuneto-thisform.acun1)*thisform.impiva1/100
									endif
								case ivaencol=2
									thisform.impo2=thisform.impo2-(ConverNro(prtot)*dtopie)
									if cond=2
										thisform.text11.value=thisform.text11.value-round((ConverNro(prtot)*dtopie)*thisform.impiva2/100,2)
									else
										auxacuneto=thisform.acun2
										thisform.acun2=thisform.acun2-((ConverNro(prtot)*dtopie)/(1+(thisform.impiva2/100)))
										thisform.acu2=thisform.acu2-(auxacuneto-thisform.acun2)*thisform.impiva2/100
									endif
							endcase
						else
							thisform.text18.value=thisform.acu
							do case
								case ivaencol=1
									thisform.impo1=thisform.impo1-ConverNro(prtot)
									if cond=2				
										thisform.text9.value=thisform.text9.value-round(ConverNro(prtot)*thisform.impiva1/100,2)
									else
										auxacuneto=thisform.acun1
										thisform.acun1=thisform.acun1-(ConverNro(prtot)/(1+(thisform.impiva1/100)))
										thisform.acu1=thisform.acu1-(auxacuneto-thisform.acun1)*thisform.impiva1/100
									endif
								case ivaencol=2
									thisform.impo2=thisform.impo2-ConverNro(prtot)
									if cond=2
										thisform.text11.value=thisform.text11.value-round(ConverNro(prtot)*thisform.impiva2/100,2)
									else
										auxacuneto=thisform.acun2
										thisform.acun2=thisform.acun2-(ConverNro(prtot)/(1+(thisform.impiva2/100)))
										thisform.acu2=thisform.acu2-(auxacuneto-thisform.acun2)*thisform.impiva2/100
									endif
							endcase
						endif
						thisform.text10.value=thisform.text18.value+thisform.text9.value+thisform.text11.value
					ENDIF
				ENDIF
			endwith
			borra=0
			insertar=0
			preg=0
			SET POINT TO 
			SET DECIMALS TO 	
		endif
		if insertar=1 and codigo<>0
			SET POINT TO ","
			with thisform
				this.col=0
				nro=this.row
				frmaltaped= conectar_db(_screen.cn)
					SQLEXEC(frmaltaped,"select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmaltaped)
				cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
				this.additem(" "+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+allt(cadena)+chr(9)+descri+chr(9)+allt(pruni)+chr(9)+prtot,.grid1.row)
				thisform.acu=thisform.acu+ConverNro(prtot)
				this.col=7
				do case
					case cur_arti.art_alicuota=1
						this.text=allt(str(impiva1,10,2))
					case cur_arti.art_alicuota=2
						this.text=allt(str(impiva2,10,2))
				ENDCASE
				thisform.nitem=thisform.nitem+1
				muestro=0
				localiz=1
				.grid1.row=nro
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				endif
				.grid1.col=0
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellalignment=3
				.grid1.col=2
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellalignment=8
				.grid1.col=7
				.grid1.cellalignment=8
				x=1
				y=0
				do while x<=this.rows-1
					this.row=x
					y=y+1
					this.col=0
					this.text=allt(str(y))
					x=x+1
				enddo
				insertar=0
			ENDWITH
			SET POINT TO
		ENDIF
		
		*-----------------------------------------*
		thisform.gridart_refresh()
		*-----------------------------------------*
	ENDPROC

	PROCEDURE grid1.GotFocus
		if localiz=1
			elimi=0
		ENDIF
		
		THISFORM.Grid_RefrescarDetalleStock()
	ENDPROC

	PROCEDURE grid1.KeyPress
		*** ActiveX Control Event ***
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		THISFORM.Grid_RefrescarDetalleStock()
	ENDPROC

	PROCEDURE grid1.MouseDown
		*** ActiveX Control Event ***
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		IF nButton = 2
		    thisform.gridart_menu()
		    RETURN
		ENDIF
		
		IF nButton = 1
		    thisform.grid_refrescardetallestock()
		ENDIF
	ENDPROC

	PROCEDURE Optiongroup1.Option1.Click
		thisform.label25.caption="*"
		thisform.label25.top=539
		thisform.text24.setfocus
	ENDPROC

	PROCEDURE Optiongroup1.Option2.Click
		thisform.label25.caption=":"
		thisform.label25.top=530
		thisform.text24.setfocus
	ENDPROC


		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		preg=messagebox("¿Seguro que desea Salir?",4+32+256,"Pedidos")
		if preg=6
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=8
		this.FontBold= .F.
	ENDPROC


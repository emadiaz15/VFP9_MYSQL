	PROCEDURE Activate
		LOCAL confmodi,xpen,xfac,arpc
		confmodi='N'
		
		ON KEY LABEL ESC DO GridArt_OnEsc IN grid_articulos_ui
		
		if codicli>0
			impiva1=thisform.impiva1
			impiva2=thisform.impiva2
			on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		set exact on
		if codigo=0
			muestro=0
		endif
		if muestro=1
			SET POINT TO ","
			SET DECIMALS TO 3
			with thisform
				frmaltaped= conectar_db(_screen.cn)
					SQLEXEC(frmaltaped, "select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmaltaped)
				if paso=1
					localiz=0
					.grid1.col=9
					xpen = ConverNro(.grid1.text)
					.grid1.col=10
					xfac = ConverNro(.grid1.text)
					DO case
						CASE dato1<>codigo AND xpen > 0
							MESSAGEBOX("EL CÓDIGO QUE INTENTA CAMBIAR YA FUE REMITADO TOTAL O PARCIALMENTE."+CHR(13)+CHR(13)+ ;
		    						   "IMPOSIBLE MODIFICAR",0+48,"AVISO DEL SISTEMA")
						CASE dato1<>codigo AND xfac > 0
							MESSAGEBOX("EL CÓDIGO QUE INTENTA CAMBIAR YA FUE FACTURADO TOTAL O PARCIALMENTE."+CHR(13)+CHR(13)+ ;
		    						   "IMPOSIBLE MODIFICAR",0+48,"AVISO DEL SISTEMA")
						CASE dato1<>codigo AND xpen > 0 AND xfac > 0
							MESSAGEBOX("EL CÓDIGO QUE INTENTA CAMBIAR YA FUE REMITADO Y FACTURADO TOTAL O PARCIALMENTE."+CHR(13)+CHR(13)+ ;
		    						   "IMPOSIBLE MODIFICAR",0+48,"AVISO DEL SISTEMA")
						CASE dato1=codigo AND ConverNro(cant)>ConverNro(dato2)
							IF xpen > 0
								LOCAL medi
								.grid1.col=2
								medi=ALLTRIM(.grid1.text)
								SET POINT TO ","
								SET DECIMALS TO 3
								.grid1.col=9
								pre_1=MESSAGEBOX("YA SE REMITARON "+ALLTRIM(.grid1.text)+" "+medi+" DE ESTE ARTÍCULO"+CHR(13)+ ;
												 "QUEDARÁN PENDIENTES "+ALLTRIM(STR(ConverNro(cant)-xpen,10,3))+" "+medi+"."+CHR(13)+CHR(13)+ ;
											     "¿MODIFICA IGUALMENTE?",4+48+256,"AVISO DEL SISTEMA")
								IF pre_1=6
									confmodi='S'
								ENDIF
								SET POINT TO 
								SET DECIMALS TO 
							ELSE
								confmodi='S'
							ENDIF
						CASE dato1=codigo AND ConverNro(cant)<ConverNro(dato2)
							DO case
								CASE ConverNro(cant)<xpen
									MESSAGEBOX("LA CANTIDAD INGRESADA ES MENOR A LA CANTIDAD YA REMITADA DE ESTE ARTÍCULO."+CHR(13)+CHR(13)+ ;
											   "IMPOSIBLE MODIFICAR",0+48,"AVISO DEL SISTEMA")
							    CASE ConverNro(cant)<xfac AND xpen=0
									MESSAGEBOX("LA CANTIDAD INGRESADA ES MENOR A LA CANTIDAD YA FACTURADA DE ESTE ARTÍCULO."+CHR(13)+CHR(13)+ ;
											   "IMPOSIBLE MODIFICAR",0+48,"AVISO DEL SISTEMA")
								CASE ConverNro(cant)=xpen
									pre_1=MESSAGEBOX("LA CANTIDAD INGRESADA ES IGUAL A LA CANTIDAD ENTREGADA DE ESTE ARTÍCULO ESTA MODIFICACIÓN ANULA EL PENDIENTE."+CHR(13)+CHR(13)+ ;
													 "¿MODIFICA IGUALMENTE?",4+48+256,"AVISO DEL SISTEMA")
									IF pre_1=6
										confmodi='S'
									ENDIF
								CASE ConverNro(cant)>xpen
									LOCAL medi
									.grid1.col=2
									medi=ALLTRIM(.grid1.text)
									SET POINT TO ","
									SET DECIMALS TO 3
									.grid1.col=9
									pre_1=MESSAGEBOX("YA SE ENTREGARON "+ALLTRIM(.grid1.text)+" "+medi+" DE ESTE ARTÍCULO"+CHR(13)+ ;
													 "QUEDARÁN PENDIENTES "+ALLTRIM(STR(ConverNro(cant)-xpen),10,3)+" "+medi+"."+CHR(13)+CHR(13)+ ;
												     "¿MODIFICA IGUALMENTE?",4+48+256,"AVISO DEL SISTEMA")
									IF pre_1=6
										confmodi='S'
									ENDIF
									SET POINT TO 
									SET DECIMALS TO 
							ENDCASE
					OTHERWISE
						confmodi='S'
					ENDCASE
					IF confmodi='S'
						.grid1.col=0
						.grid1.text=allt(str(aux))
						.grid1.col=1
						.grid1.text=allt(cant)
						.grid1.col=2
						.grid1.text=cur_arti.art_med
						.grid1.col=3
						cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
						.grid1.text=cadena
						.grid1.col=4
						if codigo=4
							.grid1.text=allt(descrip)
						else
							.grid1.text=allt(descri)
						endif
						.grid1.col=5
						.grid1.text=allt(pruni)
						.grid1.col=6
						thisform.acu=thisform.acu-ConverNro(.grid1.text)
						.grid1.text=prtot
						.grid1.col=8
						arpc= val(.grid1.text)
						if .text19.value>0
							auxiva=auxiva-(auxiva*.text19.value/100)
							auximpo=auximpo-(auximpo*.text19.value/100)
						ENDIF
						do case
							case art_alicuota=1
								if cond=2
									if auxali=1
										thisform.impo1=thisform.impo1-auximpo
									else
										thisform.impo2=thisform.impo2-auximpo
									endif
								else
									if auxali=1
										thisform.acun1=thisform.acun1-auximpo
									else
										thisform.acun2=thisform.acun2-auximpo
									endif
								endif
							case art_alicuota=2
								if cond=2
									if auxali=2
										thisform.impo2=thisform.impo2-auximpo
									else
										thisform.impo1=thisform.impo1-auximpo
									endif
								else
									if auxali=2
										thisform.acun2=thisform.acun2-auximpo
									else
										thisform.acun1=thisform.acun1-auximpo
									endif
								endif
						ENDCASE
						thisform.acu=thisform.acu+ConverNro(prtot)
						localiz=1
						IF dato1<>codigo
		*!*						IF !USED("cur_modic")
		*!*							CREATE CURSOR cur_modic(m_artcod N(8),m_artcan N(15,3))
		*!*						ENDIF
		*!*						INSERT INTO cur_modic values(dato1, ConverNro(dato2))
							UPDATE cur_pend SET art_codi = codigo, ant_pend = 0, act_pend = ConverNro(cant), actu = 1 ;
								 WHERE art_codi = dato1 AND artped_codi = arpc
						ELSE
							UPDATE cur_pend SET act_pend = ConverNro(cant) - xpen, actu = 1 WHERE art_codi = codigo AND artped_codi = arpc
						ENDIF				
					ENDIF
				ELSE
					if insertar=0
						thisform.nitem=thisform.nitem+1
						cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
						.grid1.additem(alltrim(str(thisform.nitem))+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+cadena+chr(9)+allt(descri)+chr(9)+allt(pruni)+chr(9)+prtot)
					ENDIF
					thisform.acu=thisform.acu+ConverNro(prtot)
					localiz=1
				endif
				if paso=1
					paso=0
				else
					.grid1.row=this.grid1.rows-1
				endif
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				ENDIF
				.grid1.col=7
				do case
					case cur_arti.art_alicuota=1
						.grid1.text=allt(str(thisform.impiva1,10,2))
					case cur_arti.art_alicuota=2
						.grid1.text=allt(str(thisform.impiva2,10,2))
				ENDCASE
				.grid1.col=0
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellalignment=3
				.grid1.col=2
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellalignment=8
				.grid1.col=7
				.grid1.cellalignment=8
			ENDWITH
			SET DECIMALS TO
			codigo=0
		ENDIF
		if localiz=1 and thisform.nitem>0
			SET POINT TO ","
			with thisform
				.text8.value=thisform.acu
				.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
				.text18.value=.text8.value-.text17.value
				if .text19.value>0
					do case
						case cur_arti.art_alicuota=1
							if cond=2
								thisform.impo1=thisform.impo1+(ConverNro(prtot)*((100-.text19.value)/100))
								if auxali=2
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								endif
								.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							else
								thisform.acun1=thisform.acun1+round(((ConverNro(prtot)*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
								if auxali=2
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
						case cur_arti.art_alicuota=2
							if cond=2
								thisform.impo2=thisform.impo2+(ConverNro(prtot)*((100-.text19.value)/100))
								if auxali=1
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								endif
								.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							else
								thisform.acun2=thisform.acun2+round(((ConverNro(prtot)*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
								if auxali=1
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
					endcase
				else
					do case
						case cur_arti.art_alicuota=1
							if cond=2
								thisform.impo1=thisform.impo1+ConverNro(prtot)
								if auxali=2
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								endif
								.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							else
								thisform.acun1=thisform.acun1+round((ConverNro(prtot)/(1+(thisform.impiva1/100))),3)
								if auxali=2
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
						case cur_arti.art_alicuota=2
							if cond=2
								thisform.impo2=thisform.impo2+ConverNro(prtot)
								if auxali=1
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								endif
								.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							else
								thisform.acun2=thisform.acun2+round((ConverNro(prtot)/(1+(thisform.impiva2/100))),3)
								if auxali=1
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
					endcase
				endif
				.text10.value=.text18.value+.text9.value+.text11.value
			ENDWITH
			SET POINT TO
		ENDIF
		&& === Colorear grid por stock ===
		IF muestro = 1
		    thisform.gridart_refresh()
		ENDIF
		&& =================================
		store 0 to localiz,muestro
	ENDPROC

	PROCEDURE buscar_pedido
		LPARAMETERS xcodped
		
		SET DECIMALS TO 3
		frmaltaped= conectar_db(_screen.cn)
			SQLEXEC(frmaltaped,"call usp_conspmod(?xcodped);","cur_arped")
			SQLEXEC(frmaltaped,"select * from pedidos where ped_codi=?xcodped;","cur_pedido")
		desconectar_db(frmaltaped)
		SET DECIMALS TO
		
		SELECT art_codi, artped_codi, ROUND(artped_cant - artped_ent,3) ant_pend, CAST("0" as numeric(15,3)) act_pend, 0 actu FROM cur_arped INTO CURSOR cur_pend READWRITE
		
		*--------------------------*
		thisform.gridart_refresh()
		*-------------------------*
		
		RETURN
		
	ENDPROC

	PROCEDURE Destroy
		IF PEMSTATUS(thisform, "xGridArtBound", 5)
		    =GridArt_Unbind(thisform)
		ENDIF
		
		ON KEY LABEL ESC
		
		set skip of bar 8 of Modificaci .F.
		on key label INS
		localiz=0
		
	ENDPROC

	PROCEDURE gridart_menu
		LOCAL lcShortcut
		
		IF thisform.grid1.Rows <= 1
		    RETURN
		ENDIF
		
		lcShortcut = SYS(2015)
		DEFINE POPUP (lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		=GridArt_AddStockMenuOption(lcShortcut, 1, thisform)
		=GridArt_AddStockMenuSeparator(lcShortcut, 2)
		=GridArt_AddListaComprasMenuOption(lcShortcut, 3)
		ACTIVATE POPUP (lcShortcut)
		RELEASE POPUP (lcShortcut)
		
		RETURN
	ENDPROC

	PROCEDURE gridart_refresh
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    thisform.gridart_setup()
		ELSE
		    =GridArt_ColorearGridActivex(thisform)
		ENDIF
		
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockForm(thisform)
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE gridart_setup
		SET PROCEDURE TO grid_articulos_ui ADDITIVE
		
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    =GridArt_BindActiveX(thisform, "grid1", 3, 4)
		    =GridArt_BindTooltipEvents(thisform)
		ENDIF
		
		=GridArt_ColorearGridActivex(thisform)
		ON KEY LABEL ESC DO GridArt_OnEsc IN grid_articulos_ui
		
		RETURN
	ENDPROC

	PROCEDURE grid_abrirdetallestock
		=GridArt_OpenStockForm(thisform)
		RETURN
	ENDPROC

	PROCEDURE grid_cerrardetallestock
		=GridArt_CloseStockPanel(thisform)
		
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    TRY
		        thisform.oStockPopForm.Release()
		    CATCH
		    ENDTRY
		    thisform.oStockPopForm = .NULL.
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE grid_refrescardetallestock
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockForm(thisform)
		ENDIF
		RETURN
	ENDPROC

	PROCEDURE grid_rightclick
		thisform.gridart_menu()
		RETURN
	ENDPROC

	PROCEDURE Init
		parameter codped,cond
		
		*--------------------------------------------*
		thisform.gridart_setup()
		*--------------------------------------------*
		
		public elimi,descrip,muestro,opcion,transporte,dato1,dato2,dato3, ;
		       dato4,codigo,cant,descri,pruni,prtot,insertar,impiva1,impiva2,nitem, ;
		       borra,codicli,codiva,codp,coditran,coditran1,coditran2,auxcond,localiz, ;
		       auximpo,auxali,npnro,porcodi,obser,letrapor,vcodi
		set deleted on
		
		STORE 0 TO porcodi,npnro,coditran,coditran1,coditran2,codp,paso,vcodi,elimi,localiz, ;
				   muestro,opcion,insertar,borra,codicli,codigo,auximpo,auxali,thisform.acu
				   
		STORE "" TO letrapor,obser,transporte,descrip
		
		STORE 0 TO this.text8.Value, ;
				   this.text17.Value, ;
				   this.text18.Value, ;
				   this.text9.Value, ;
				   this.text11.Value, ;
		           this.text10.Value, ;
		           this.text15.Value, ;
				   this.text19.value
				   
		frmaltaped= conectar_db(_screen.cn)
			SQLEXEC(frmaltaped,"select b.*,c.*,d.cond_desc from pedidos a inner join iva b on a.iva_codi=b.iva_codi inner join clientes c on c.cli_codi=a.cli_codi inner join condiva d on c.cond_codi=d.cond_codi where a.ped_codi=?codped;","cur_datvar")
			SQLEXEC(frmaltaped,"select a.*,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on c.provi_codi=a.provi_codi where a.loca_codi=?cur_datvar.loca_codi;","cur_ubic")
		desconectar_db(frmaltaped)
		thisform.codicli=cur_datvar.cli_codi
		thisform.impiva1=cur_datvar.iva_1
		thisform.impiva2=cur_datvar.iva_2
		codiva=cur_datvar.iva_codi
		thisform.label12.caption=allt(str(thisform.impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(thisform.impiva2,10,2))+"%"
		
		thisform.buscar_pedido(codped)
		
		*!*	npnro=cur_pedido.notaped_nro
		*!*	thisform.xfecha=cur_pedido.ped_fech
		*!*	thisform.xhora=TTOC(cur_pedido.ped_hora,2)
		*!*	thisform.npres=cur_pedido.presup_codi
		with thisform
			.text1.value=cur_datvar.cli_nomb
			.text2.value=cur_datvar.cli_domi
			auxcond=cur_datvar.cond_codi
			.text3.value=cur_ubic.cp_nro
			.text4.value=cur_ubic.loca_nomb
			.text5.value=cur_ubic.provi_nomb
			.text6.value=cur_datvar.cond_desc
			.text7.value=0
			.text12.value=VAL(cur_datvar.cli_cuit)
			.text13.value=DATE()
			.text19.value=cur_pedido.ped_dto
			obser=allt(cur_pedido.ped_obser)
			DO CASE
				CASE cur_pedido.moneda='D'
					thisform.ctn_moneda.chk_dolares.Value=1
					thisform.xcotiz=cur_pedido.cotiz_dolar
				CASE cur_pedido.moneda='P'
					thisform.ctn_moneda.chk_pesos.Value=1
					thisform.txt_cotiz.Value=cur_pedido.cotiz_dolar
					thisform.xcotiz=cur_pedido.cotiz_dolar
					thisform.lbl_cotiz.Visible= .T.
					thisform.txt_cotiz.Visible= .T.
			ENDCASE
			thisform.moneda_obser()
		*!*		if cur_pedido.presup_codi>0
		*!*			.label5.caption="Pedido.Nº"
		*!*			.text7.value=thisform.npedi
		*!*			.text7.style=1
		*!*			.command11.visible=.T.
		*!*			codp=cur_pedido.presup_codi
		*!*			.lbl_corpres.caption="Corresponde a Presupuesto Nº: "+ALLTRIM(STR(cur_pedido.presup_codi))
		*!*			.lbl_corpres.visible=.T.
		*!*			.lbl_corpres.left=thisform.width-(.lbl_corpres.Width+6)
		*!*		ELSE
		*!*			IF cur_pedido.notaped_nro>0
		*!*				.label5.caption="N.Pedido Nº"
		*!*				.label5.left=675
		*!*				.text7.value=cur_pedido.notaped_nro
		*!*				.text7.style=0
		*!*			ELSE
		*!*				.label5.caption="Pedido.Nº"
		*!*				.text7.value=thisform.npedi
		*!*				.text7.style=1
		*!*			endif
		*!*		endif
			frmaltaped= conectar_db(_screen.cn)
				SQLEXEC(frmaltaped,"select a.*,b.tran_nomb from pedidos_transportes a inner join transportes b on a.tran_codi=b.tran_codi where a.ped_codi=?codped;","cur_tra")
			desconectar_db(frmaltaped)
			if RECCOUNT("cur_tra")>0
				coditran1=cur_tra.tran_codi
				thisform.coditran1=coditran1
				thisform.check1.Value=0
				.text14.value=cur_tra.tran_nomb
				do case
					case cur_tra.flete_cargo="C"
						.opcionflete1.value=1
					case cur_tra.flete_cargo="P"
						.opcionflete1.value=2
				endcase
				.edit1.value=ALLTRIM(cur_tra.flete_lugent)
				IF RECCOUNT("cur_tra")=2
					skip
					coditran2=cur_tra.tran_codi
					thisform.coditran2=coditran2
					thisform.check2.Value=0
					.text22.value=cur_tra.tran_nomb
					do case
						case cur_tra.flete_cargo="C"
							.opcionflete2.value=1
						case cur_tra.flete_cargo="P"
							.opcionflete2.value=2
					endcase
					.edit2.value=ALLTRIM(cur_tra.flete_lugent)
				ENDIF
			endif
			
			frmaltaped= conectar_db(_screen.cn)
				SQLEXEC(frmaltaped,"select * from vendedores where ven_codi=?cur_pedido.ven_codi;","cur_vendedor")			
			desconectar_db(frmaltaped)
			IF cur_pedido.ven_codi>0
				.text15.value=cur_vendedor.ven_codi
				.text16.value=cur_vendedor.ven_nomb
			endif
			frmaltaped= conectar_db(_screen.cn)
				SQLEXEC(frmaltaped,"select * from porcencomi where porc_codi=?cur_pedido.porc_codi;","cur_porc")
			desconectar_db(frmaltaped)
			if cur_pedido.porc_codi>0
				porcodi=cur_porc.porc_codi
				.text20.value=cur_porc.porc_desc
				.text21.value=cur_porc.porc_impo
			else
				.text21.value=cur_pedido.otra_comi
			ENDIF
		
			SELECT cur_arped
			GO top
			SCAN
				SET POINT TO ","
				SET DECIMALS TO 3
				cadena=repl("0",8-len(allt(str(cur_arped.art_codi))))+allt(str(cur_arped.art_codi))
				if cur_arped.art_codi=4 or cur_arped.art_codi=5
					.grid1.additem(allt(str(cur_arped.artped_it))+chr(9)+allt(str(cur_arped.artped_cant,10,3))+chr(9)+allt(cur_arped.art_med)+chr(9)+cadena+chr(9)+allt(cur_arped.artped_dasc)+chr(9)+allt(str(cur_arped.artped_precio,15,4))+chr(9)+ ;
								   allt(str(cur_arped.artped_cant*cur_arped.artped_precio,15,2))+CHR(9)+''+CHR(9)+STR(cur_arped.artped_codi)+CHR(9)+STR(cur_arped.artped_ent,10,3)+CHR(9)+STR(cur_arped.artfac_cant,10,3))
				else
					.grid1.additem(allt(str(cur_arped.artped_it))+chr(9)+allt(str(cur_arped.artped_cant,10,3))+chr(9)+allt(cur_arped.art_med)+chr(9)+cadena+chr(9)+allt(cur_arped.art_desc)+chr(9)+allt(str(cur_arped.artped_precio,15,4))+chr(9)+ ;
								   allt(str(cur_arped.artped_cant*cur_arped.artped_precio,15,2))+CHR(9)+''+CHR(9)+STR(cur_arped.artped_codi)+CHR(9)+STR(cur_arped.artped_ent,10,3)+CHR(9)+STR(cur_arped.artfac_cant,10,3))
					if cur_arped.dac_codi>0
						thisform.grid1.row=thisform.grid1.rows-1
						thisform.grid1.col=4
						thisform.grid1.text=cur_arped.dac_desc
					endif
				endif
				this.grid1.row=this.grid1.rows-1
				thisform.grid1.col=7
				do case
					case cur_arped.art_alicuota=1
						thisform.grid1.text=allt(str(thisform.impiva1,10,2))
					case cur_arped.art_alicuota=2
						thisform.grid1.text=allt(str(thisform.impiva2,10,2))
				ENDCASE
				.grid1.row=this.grid1.rows-1
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				endif
				.grid1.col=0
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellalignment=3
				.grid1.col=2
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellalignment=8
				.grid1.col=7
				.grid1.cellalignment=8
				thisform.acu=thisform.acu+ROUND((cur_arped.artped_cant*cur_arped.artped_precio),2)
		*!*			thisform.nitem=thisform.nitem+1
				.text8.value=thisform.acu
				.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
				.text18.value=.text8.value-.text17.value
				if .text19.value>0
					do case
						case cur_arped.art_alicuota=1
							if cond=2
								thisform.impo1=thisform.impo1+((cur_arped.artped_cant*cur_arped.artped_precio)*((100-this.text19.value)/100))
								this.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							else
								thisform.acun1=thisform.acun1+round((((cur_arped.artped_cant*cur_arped.artped_precio)*((100-this.text19.value)/100))/(1+(thisform.impiva1/100))),3)
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
						case cur_arped.art_alicuota=2
							if cond=2
								thisform.impo2=thisform.impo2+((cur_arped.artped_cant*cur_arped.artped_precio)*((100-this.text19.value)/100))
								this.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							else
								thisform.acun2=thisform.acun2+round((((cur_arped.artped_cant*cur_arped.artped_precio)*((100-this.text19.value)/100))/(1+(thisform.impiva2/100))),3)
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
					endcase
				else
					do case
						case cur_arped.art_alicuota=1
							if cond=2
								thisform.impo1=thisform.impo1+(cur_arped.artped_cant*cur_arped.artped_precio)
								this.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							else
								thisform.acun1=thisform.acun1+round(((cur_arped.artped_cant*cur_arped.artped_precio)/(1+(thisform.impiva1/100))),3)
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
						case cur_arped.art_alicuota=2
							if cond=2
								thisform.impo2=thisform.impo2+(cur_arped.artped_cant*cur_arped.artped_precio)
								this.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							else
								thisform.acun2=thisform.acun2+round(((cur_arped.artped_cant*cur_arped.artped_precio)/(1+(thisform.impiva2/100))),3)
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
					endcase
				endif
				this.text10.value=this.text18.value+this.text9.value+this.text11.value				
				SET POINT TO
				SET DECIMALS TO 
			ENDSCAN
		endwith
		thisform.nitem = RECCOUNT("cur_arped")
		*!*	if thisform.nitem>1
		*!*		thisform.nitem=thisform.nitem-1
		*!*	ENDIF
		impiva1=thisform.impiva1
		impiva2=thisform.impiva2
		on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		STORE 0 TO localiz,muestro
		
		*---------------------------*
		thisform.gridart_refresh()
		*---------------------------*
	ENDPROC

	PROCEDURE Load
		set skip of bar 8 of Modificaci .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if valorcadena<>"Pedidos Clientes"
		*!*		set skip of bar 8 of Modificaci .F.
		*!*		thisform.hide
		*!*		localiz=0
		*!*		nitem=0
		*!*	endif
	ENDPROC

	PROCEDURE moneda_obser
		IF AT('PRECIOS EX',obser) > 0
			DO CASE
				CASE AT('DOLARES',obser) > 0 AND thisform.ctn_moneda.chk_pesos.Value = 1
					obser = STRTRAN(obser,'DOLARES','PESOS')
				CASE AT('PESOS',obser) > 0 AND thisform.ctn_moneda.chk_dolares.Value = 1
					obser = STRTRAN(obser,'PESOS','DOLARES')
				CASE thisform.ctn_moneda.chk_dolares.Value = 0 AND thisform.ctn_moneda.chk_pesos.Value = 0
					DO CASE
						CASE AT('DOLARES',obser) > 0
							obser = LEFT(obser,AT('PRECIOS EX',obser)-1) + RIGHT(obser,LEN(obser)-(AT('PRECIOS EX',obser)+32))
						CASE AT('PESOS',obser) > 0
							obser = LEFT(obser,AT('PRECIOS EX',obser)-1) + RIGHT(obser,LEN(obser)-(AT('PRECIOS EX',obser)+30))
					ENDCASE
			ENDCASE
		ELSE
			IF LEN(ALLTRIM(obser)) = 0
				DO case
					CASE thisform.ctn_moneda.chk_pesos.Value = 1
						obser = 'PRECIOS EXPRESADOS EN PESOS'
					CASE thisform.ctn_moneda.chk_dolares.Value = 1
						obser = 'PRECIOS EXPRESADOS EN DOLARES'
				ENDCASE
			ELSE
				DO case
					CASE thisform.ctn_moneda.chk_pesos.Value = 1
						obser = 'PRECIOS EXPRESADOS EN PESOS'+ CHR(13) + CHR(10)+ CHR(10) + ALLTRIM(obser)
					CASE thisform.ctn_moneda.chk_dolares.Value = 1
						obser = 'PRECIOS EXPRESADOS EN DOLARES'+ CHR(13) + CHR(10)+ CHR(10) + ALLTRIM(obser)
				ENDCASE		
			ENDIF
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE btn_deta.Click
		IF LEN(ALLTRIM(cur_clie.cli_deta)) > 0
			MESSAGEBOX(ALLTRIM(cur_clie.cli_deta),64,"Detalles Adicionales del Cliente")
		ELSE
			MESSAGEBOX("No hay detalles ingresados para este cliente",48,"Detalles Adicionales del Cliente")
		ENDIF
		
	ENDPROC

	PROCEDURE Check1.Click
		IF this.Value=1
			coditran1=0
			thisform.text14.Value=''
			thisform.edit1.Value=''
			thisform.opcionflete1.Value=0
		ELSE
			IF coditran1=0
				this.Value=1
			endif
		endif
		
	ENDPROC

	PROCEDURE Check2.Click
		IF this.Value=1
			coditran2=0
			thisform.text22.Value=''
			thisform.edit2.Value=''
			thisform.opcionflete2.Value=0
		ELSE
			IF coditran2=0
				this.Value=1
			endif
		endif
	ENDPROC

	PROCEDURE cmd_modicli.Click
		prem=MESSAGEBOX("¿MODIFICA CLIENTE PARA ESTE PEDIDO?",4+48+256,"Aviso del Sistema")
		IF prem=6
			codicli=0
			DO FORM cliload WITH codicli
			IF codicli>0
				thisform.codicli=codicli
				auxcond=cur_datvar.cond_codi
				UPDATE cur_datvar SET cli_codi   =cur_clie.cli_codi, ;
									  cli_nomb   =cur_clie.cli_nomb, ;
									  cli_domi   =cur_clie.cli_domi, ;
									  cli_cuit   =cur_clie.cli_cuit, ;
									  cli_cartel =cur_clie.cli_cartel, ;
									  cli_tel1   =cur_clie.cli_tel1, ;
									  cli_tel2   =cur_clie.cli_tel2, ;
									  cli_cel    =cur_clie.cli_cel, ;
									  cli_email  =cur_clie.cli_email, ;
									  loca_codi  =cur_clie.loca_codi, ;
									  cond_codi  =cur_clie.cond_codi, ;
									  cli_saldo  =cur_clie.cli_saldo, ;
									  zona_codi  =cur_clie.zona_codi, ;
									  cli_favor  =cur_clie.cli_favor, ;
									  cond_desc  =cur_clie.cond_desc
				frmaltaped= conectar_db(_screen.cn)
					SQLEXEC(frmaltaped,"select a.*,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on c.provi_codi=a.provi_codi where a.loca_codi=?cur_datvar.loca_codi;","cur_ubic")
				desconectar_db(frmaltaped)
				codiva=cur_datvar.iva_codi
				WITH thisform
					.text1.value=cur_datvar.cli_nomb
					.text2.value=cur_datvar.cli_domi
					cond=cur_datvar.cond_codi
					.text3.value=cur_ubic.cp_nro
					.text4.value=cur_ubic.loca_nomb
					.text5.value=cur_ubic.provi_nomb
					.text6.value=cur_datvar.cond_desc
					.text12.value=VAL(cur_datvar.cli_cuit)
		*!*				.text23.value="0"+allt(cur_datvar.cli_cartel)+"-"+allt(cur_datvar.cli_tel1)
					LOCAL itgrid,ivgrilla,cangrilla,pru
					itgrid=thisform.grid1.rows-1
					ivgrilla=0
					pru=0
					IF auxcond<>cond
						STORE 0 TO thisform.acu,auxiva,auximpo,auxali
						STORE 0 TO thisform.impo1, ;
								   thisform.impo2, ;
								   thisform.acu1, ;
								   thisform.acu2, ;
								   thisform.acun1, ;
								   thisform.acun2
						STORE 0 TO thisform.text8.value, ;
							       thisform.text9.value, ;
						           thisform.text10.value, ;
						           thisform.text11.value, ;
						           thisform.text17.value, ;
				 		           thisform.text18.value
				 		thisform.text8.ForeColor=RGB(255,255,255)
				 		thisform.text9.ForeColor=RGB(255,255,255)
				 		thisform.text10.ForeColor=RGB(255,255,255)
				 		thisform.text11.ForeColor=RGB(255,255,255)
				 		thisform.text17.ForeColor=RGB(255,255,255)
				 		thisform.text18.ForeColor=RGB(255,255,255)
						SET POINT TO ","
						SET DECIMALS TO 3
						IF cond=2
							thisform.acu=0
							FOR i=1 TO itgrid
								.grid1.row=i
								.grid1.col=3
								frmaltaped= conectar_db(_screen.cn)
									SQLEXEC(frmaltaped,"select art_alicuota from articulos where art_codi=?VAL(.grid1.text);","cur_ali")
								desconectar_db(frmaltaped)
								.grid1.col=1
								cangrilla=ConverNro(.grid1.text)
								.grid1.col=7
								ivgrilla=ConverNro(.grid1.text)
								.grid1.col=5
								.grid1.text=STR(ConverNro(.grid1.text)/(1+(ivgrilla/100)),10,4)
								pru=ROUND(cangrilla*ConverNro(.grid1.text),2)
								.grid1.col=6
								.grid1.text=STR(pru,10,2)
								thisform.acu=thisform.acu+pru
								.text8.value=thisform.acu
								.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
								.text18.value=.text8.value-.text17.value
								if .text19.value>0
									do case
										case cur_ali.art_alicuota=1
											if cond=2
												thisform.impo1=thisform.impo1+(pru*((100-.text19.value)/100))
												.text9.value=round((thisform.impo1*thisform.impiva1)/100,3)
											else
												thisform.acun1=thisform.acun1+round(((pru*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
												thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,3)
											endif
										case cur_ali.art_alicuota=2
											if cond=2
												thisform.impo2=thisform.impo2+(pru*((100-.text19.value)/100))
												.text11.value=round((thisform.impo2*thisform.impiva2)/100,3)
											else
												thisform.acun2=thisform.acun2+round(((pru*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
												thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,3)
											endif
									endcase
								else
									do case
										case cur_ali.art_alicuota=1
											if cond=2
												thisform.impo1=thisform.impo1+pru
												.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
											else
												thisform.acun1=thisform.acun1+round((pru/(1+(thisform.impiva1/100))),3)
												thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
											endif
										case cur_ali.art_alicuota=2
											if cond=2
												thisform.impo2=thisform.impo2+pru
												.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
											else
												thisform.acun2=thisform.acun2+round((pru/(1+(thisform.impiva2/100))),3)
												thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
											endif
									endcase
								endif
								.text10.value=.text18.value+.text9.value+.text11.value							
							NEXT i
						ELSE
							thisform.acu=0
							FOR i=1 TO itgrid
								.grid1.row=i
								.grid1.col=3
								frmaltaped= conectar_db(_screen.cn)
									SQLEXEC(frmaltaped,"select art_alicuota from articulos where art_codi=?VAL(.grid1.text);","cur_ali")
								desconectar_db(frmaltaped)
								.grid1.col=1
								cangrilla=ConverNro(.grid1.text)
								.grid1.col=7
								ivgrilla=ConverNro(.grid1.text)
								.grid1.col=5
								.grid1.text=STR(ConverNro(.grid1.text)*(1+(ivgrilla/100)),10,4)
								pru=ROUND(cangrilla*ConverNro(.grid1.text),2)
								.grid1.col=6
								.grid1.text=STR(pru,10,2)
								thisform.acu=thisform.acu+pru
								.text8.value=thisform.acu
								.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
								.text18.value=.text8.value-.text17.value
								if .text19.value>0
									do case
										case cur_ali.art_alicuota=1
											if cond=2
												thisform.impo1=thisform.impo1+(pru*((100-.text19.value)/100))
												.text9.value=round((thisform.impo1*thisform.impiva1)/100,3)
											else
												thisform.acun1=thisform.acun1+round(((pru*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
												thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,3)
											endif
										case cur_ali.art_alicuota=2
											if cond=2
												thisform.impo2=thisform.impo2+(pru*((100-.text19.value)/100))
												.text11.value=round((thisform.impo2*thisform.impiva2)/100,3)
											else
												thisform.acun2=thisform.acun2+round(((pru*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
												thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,3)
											endif
									endcase
								else
									do case
										case cur_ali.art_alicuota=1
											if cond=2
												thisform.impo1=thisform.impo1+pru
												.text9.value=round((thisform.impo1*thisform.impiva1)/100,3)
											else
												thisform.acun1=thisform.acun1+round((pru/(1+(thisform.impiva1/100))),3)
												thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,3)
											endif
										case cur_ali.art_alicuota=2
											if cond=2
												thisform.impo2=thisform.impo2+pru
												.text11.value=round((thisform.impo2*thisform.impiva2)/100,3)
											else
												thisform.acun2=thisform.acun2+round((pru/(1+(thisform.impiva2/100))),3)
												thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,3)
											endif
									endcase
								endif
								.text10.value=.text18.value+.text9.value+.text11.value				
							NEXT i				
						ENDIF
						SET POINT TO 
						SET DECIMALS TO
					ENDIF
				ENDWITH
			ENDIF
			thisform.text8.ForeColor=RGB(0,0,0)
			thisform.text9.ForeColor=RGB(0,0,0)
			thisform.text10.ForeColor=RGB(0,0,0)
			thisform.text11.ForeColor=RGB(0,0,0)
			thisform.text17.ForeColor=RGB(0,0,0)
			thisform.text18.ForeColor=RGB(0,0,0)
			frmaltaped= conectar_db(_screen.cn)
				SQLEXEC(frmaltaped,"select a.*,b.* from zonas a inner join vendedores b on a.ven_codi=b.ven_codi where a.zona_codi=?cur_clie.zona_codi order by b.ven_codi;","cur_vende")
			desconectar_db(frmaltaped)
			IF cur_vende.ven_codi>0
				thisform.text15.value=cur_vende.ven_codi
				thisform.text16.value=cur_vende.ven_nomb
			ELSE
				thisform.text15.Value = 0
				thisform.text16.value = ''
			ENDIF
			thisform.text20.Value = ''
			thisform.text21.value = 0
			STORE 0 TO letrapor,porcodi
		ENDIF
		
	ENDPROC

	PROCEDURE Command1.Click
		do case
		case thisform.nitem=0
			messagebox("Aún no ha ingresado ningún artículo al Pedido, imposible Guardar",48,"Advertencia")
			RETURN
		CASE thisform.text7.Value = 0
			MESSAGEBOX("Debe ingresar el número de nota de pedido",48,"Aviso del Sistema")
			thisform.text7.SetFocus
			RETURN
		case thisform.text21.value=0 and thisform.text15.value>0
			messagebox("Debe ingresar la comisión del vendedor para guardar el Pedido.",0+48,"Advertencia")
			RETURN
		CASE coditran1=0 AND coditran2>0
			MESSAGEBOX("Si seleccionó Transporte de Redespacho no puede guardar el pedido sin antes seleccionar un Transporte de Orígen.",0+48,"Advertencia")
			RETURN
		CASE thisform.ctn_moneda.chk_dolares.Value = 0 AND thisform.ctn_moneda.chk_pesos.Value = 0
			MESSAGEBOX("Para continuar debe especificar la moneda para el pedido.",48,"Aviso del Sistema")
			RETURN
		CASE thisform.ctn_moneda.chk_pesos.Value = 1 AND thisform.txt_cotiz.Value = 0
			MESSAGEBOX("Usted ha optado por la moneda PESOS, por lo tanto, debe especificar un importe de cotización de dolar mayor a 0.-",48,"Aviso del Sistema")
			thisform.txt_cotiz.SetFocus
			RETURN	
		OTHERWISE
			preg=messagebox("¿Confirma los datos del Pedido?",4+32+256,"Alta de Pedidos de Clientes")
			if preg=6
				with thisform
					LOCAL xcodip,xfecha,xhora,xdto,xpres,xnped,xcodiven,xotracomi,xdasc,xarti,xdac,xcant,xprec,xlug,xcar,xarpc,xent,xmoneda,xcoti,xit,lnLock
					lnLock = 0
					xfecha=.text13.value
					xhora = IIF(.text13.value < DATE(),'23:59:59',TTOC(DATETIME(),2))
					xdto=.text19.value
					xpres = 0
					xnped=.text7.value
					xcodiven=.text15.value
					xotracomi=IIF(LEN(ALLTRIM(.text20.value))=0 and .text21.value>0,.text21.value,0)
					IF thisform.npedi=0
						xcodip=0
						frmaltaped= conectar_db(_screen.cn)
							DO CASE
								CASE thisform.ctn_moneda.chk_dolares.Value = 1
									xmoneda = 'D'
									xcoti = thisform.xcotiz
								CASE thisform.ctn_moneda.chk_pesos.Value = 1
									xmoneda = 'P'
									xcoti = thisform.txt_cotiz.value
							ENDCASE
							lnLock = MySQL_LockTables("LOCK", "pedidos WRITE", frmaltaped)
							SQLEXEC(frmaltaped,"call usp_guardaped(1,?xcodip,?xfecha,?xhora,?thisform.codicli,?xdto,?codiva,?xpres,?xnped,?xcodiven,?porcodi,?xotracomi,?obser,?xmoneda,?xcoti);","cur_nvo")
							lnLock = MySQL_LockTables("UNLOCK", "", frmaltaped)
							thisform.npedi=cur_nvo.ped_codi
							xcodip=thisform.npedi
							IF coditran1>0
								xlug=ALLTRIM(thisform.edit1.value)
								DO case
									CASE thisform.opcionflete1.Value=1
										xcar='C'
									CASE thisform.opcionflete1.Value=2
										xcar='P'
								ENDCASE
								SQLEXEC(frmaltaped,"select CAST(pedtran_codi+1 as DECIMAL(8,0)) as pedtran_codi from pedidos_transportes order by pedtran_codi desc limit 1;","cur_ptnvo")
								SQLEXEC(frmaltaped,"insert into pedidos_transportes values(?cur_ptnvo.pedtran_codi,?xcodip,?coditran1,?xlug,?xcar);")
							endif
							IF coditran2>0
								xlug=ALLTRIM(thisform.edit2.value)
								DO case
									CASE thisform.opcionflete2.Value=1
										xcar='C'
									CASE thisform.opcionflete2.Value=2
										xcar='P'
								ENDCASE
								SQLEXEC(frmaltaped,"select CAST(pedtran_codi+1 as DECIMAL(8,0)) as pedtran_codi from pedidos_transportes order by pedtran_codi desc limit 1;","cur_ptnvo")
								SQLEXEC(frmaltaped,"insert into pedidos_transportes values(?cur_ptnvo.pedtran_codi,?xcodip,?coditran2,?xlug,?xcar);")
							ENDIF
						desconectar_db(frmaltaped)
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								.grid1.col=3
								if val(.grid1.text)=4 OR val(.grid1.text)=5
									.grid1.col=4
									xdasc=ALLTRIM(.grid1.text)
								else
									xdasc=""
								endif
								.grid1.col=3
								xarti=val(.grid1.text)
								.grid1.col=4
								frmaltaped= conectar_db(_screen.cn)
									SQLEXEC(frmaltaped,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
								desconectar_db(frmaltaped)
								if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
									frmaltaped= conectar_db(_screen.cn)
										SQLEXEC(frmaltaped,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
									desconectar_db(frmaltaped)
									IF RECCOUNT("cur_artcli")>0
										LOCAL xcadena
										xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(.grid1.text)
										frmaltaped= conectar_db(_screen.cn)
											SQLEXEC(frmaltaped,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
										desconectar_db(frmaltaped)
										IF RECCOUNT("cur_ddes")>0
											xdac=cur_ddes.dac_codi
										endif
									endif
								else
									xdac=0
								ENDIF
								.grid1.col=0
								xit=VAL(.grid1.text)
								.grid1.col=1
								xcant=ConverNro(.grid1.text)			
								.grid1.col=5
								xprec=ConverNro(.grid1.text)
								frmaltaped= conectar_db(_screen.cn)
									lnLock = MySQL_LockTables("LOCK", "pedidos_articulos WRITE", frmaltaped)
									SQLEXEC(frmaltaped,"select cast(artped_codi+1 as DECIMAL(8,0)) as artped_codi from pedidos_articulos order by artped_codi desc limit 1;","cur_pednvo")
									SQLEXEC(frmaltaped,"insert into pedidos_articulos values(?cur_pednvo.artped_codi,?xcodip,?xarti,?xcant,?xprec,0,0,?xdasc,?xdac,?xit);")
									lnLock = MySQL_LockTables("UNLOCK", "", frmaltaped)
		*!*								SQLEXEC(frmaltaped,"update articulos set pedidos = pedidos + ?xcant where art_codi = ?xarti;")
								desconectar_db(frmaltaped)
								.grid1.col=8
								.grid1.text=ALLTRIM(STR(cur_pednvo.artped_codi))
								IF xarti > 5
									Campo_ped(xarti)
								ENDIF
							endif
						next fila
						thisform.buscar_pedido(xcodip)
						cerrar_cursor("cur_arped")				
					ELSE
						DO CASE
							CASE thisform.ctn_moneda.chk_dolares.Value = 1
								xmoneda = 'D'
								xcoti = thisform.xcotiz
							CASE thisform.ctn_moneda.chk_pesos.Value = 1
								xmoneda = 'P'
								xcoti = thisform.txt_cotiz.Value
						ENDCASE
						frmaltaped= conectar_db(_screen.cn)
							SQLEXEC(frmaltaped,"call usp_guardaped(2,?xcodip,?xfecha,?xhora,?thisform.codicli,?xdto,?codiva,?thisform.npres,?xnped,?xcodiven,?porcodi,?xotracomi,?obser,?xmoneda,?xcoti);")
							IF coditran1>0
								SQLEXEC(frmaltaped,"select * from pedidos_transportes where ped_codi=?xcodip;","cur_tra")
								xlug=ALLTRIM(thisform.edit1.value)
								DO case
									CASE thisform.opcionflete1.Value=1
										xcar='C'
									CASE thisform.opcionflete1.Value=2
										xcar='P'
								ENDCASE
								IF RECCOUNT("cur_tra")>0
									GO top
									SQLEXEC(frmaltaped,"update pedidos_transportes set tran_codi=?coditran1,flete_lugent=?xlug,flete_cargo=?xcar where pedtran_codi=?cur_tra.pedtran_codi;")
								ELSE
									SQLEXEC(frmaltaped,"select CAST(pedtran_codi+1 as DECIMAL(8,0)) as pedtran_codi from pedidos_transportes order by pedtran_codi desc limit 1;","cur_ptnvo")
									SQLEXEC(frmaltaped,"insert into pedidos_transportes values(?cur_ptnvo.pedtran_codi,?xcodip,?coditran1,?xlug,?xcar);")					
								ENDIF
								IF coditran2>0
									xlug=ALLTRIM(thisform.edit2.value)
									DO case
										CASE thisform.opcionflete2.Value=1
											xcar='C'
										CASE thisform.opcionflete2.Value=2
											xcar='P'
									ENDCASE
									IF RECCOUNT("cur_tra")>1
										SKIP IN cur_tra
										SQLEXEC(frmaltaped,"update pedidos_transportes set tran_codi=?coditran2,flete_lugent=?xlug,flete_cargo=?xcar where pedtran_codi=?cur_tra.pedtran_codi;")
									ELSE
										SQLEXEC(frmaltaped,"select CAST(pedtran_codi+1 as DECIMAL(8,0)) as pedtran_codi from pedidos_transportes order by pedtran_codi desc limit 1;","cur_ptnvo")
										SQLEXEC(frmaltaped,"insert into pedidos_transportes values(?cur_ptnvo.pedtran_codi,?xcodip,?coditran2,?xlug,?xcar);")							
									ENDIF
								ELSE
									IF RECCOUNT("cur_tra")>1
										SKIP IN cur_tra
										SQLEXEC(frmaltaped,"delete from pedidos_transportes where pedtran_codi=?cur_tra.pedtran_codi;")
									ENDIF
								ENDIF
							ELSE
								SQLEXEC(frmaltaped,"select * from pedidos_transportes where ped_codi=?xcodip;","cur_tra")
								IF RECCOUNT("cur_tra")>0
									SQLEXEC(frmaltaped,"delete from pedidos_transportes where ped_codi=?xcodip;")
								ENDIF
							ENDIF
							IF USED("delitems")
								SELECT delitems
								LOCATE
								IF RECCOUNT("delitems") > 0
									SCAN
		*!*									IF delitems.art_codi > 5
		*!*										SQLEXEC(frmaltaped,"update articulos set pedidos = pedidos - ?delitems.artped_cant where art_codi = ?delitems.art_codi;")
		*!*									ENDIF
										SQLEXEC(frmaltaped,"delete from pedidos_articulos where artped_codi = ?delitems.artped_codi;")
										IF delitems.art_codi > 5
											Campo_ped(delitems.art_codi)
										ENDIF
									ENDSCAN
									cerrar_cursor("delitems")
								ENDIF
							ENDIF
						desconectar_db(frmaltaped)
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								.grid1.col=3
								if val(.grid1.text)<=5
									.grid1.col=4
									xdasc=ALLTRIM(.grid1.text)
								else
									xdasc=""
								endif
								.grid1.col=3
								xarti=val(.grid1.text)
								.grid1.col=4
								frmaltaped= conectar_db(_screen.cn)
									SQLEXEC(frmaltaped,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
								desconectar_db(frmaltaped)
								if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
									frmaltaped= conectar_db(_screen.cn)
										SQLEXEC(frmaltaped,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
									desconectar_db(frmaltaped)
									IF RECCOUNT("cur_artcli")>0
										LOCAL xcadena
										xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(.grid1.text)
										frmaltaped= conectar_db(_screen.cn)
											SQLEXEC(frmaltaped,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
										desconectar_db(frmaltaped)
										IF RECCOUNT("cur_ddes")>0
											xdac=cur_ddes.dac_codi
										endif
									endif
								else
									xdac=0
								ENDIF
								SET POINT TO ","
								SET DECIMALS TO 3
								.grid1.col=0
								xit=VAL(.grid1.text)
								.grid1.col=1
								xcant=ConverNro(.grid1.text)			
								.grid1.col=5
								xprec=ConverNro(.grid1.text)
								.grid1.col=8
								xarpc=VAL(.grid1.text)
								.grid1.col=9
								xent=ConverNro(.grid1.text)
								SET POINT TO 
								SET DECIMALS TO 
								frmaltaped= conectar_db(_screen.cn)
									IF xarpc>0
		*!*									IF USED("cur_modic")
		*!*										SELECT cur_modic
		*!*										LOCATE
		*!*										SCAN
		*!*											artmodi = cur_modic.m_artcod
		*!*											canmodi = cur_modic.m_artcan
		*!*											SQLEXEC(frmaltaped,"update articulos set pedidos = pedidos - ?canmodi where art_codi = ?artmodi;")
		*!*										ENDSCAN
		*!*										cerrar_cursor("cur_modic")
		*!*									ENDIF
										SELECT ROUND(act_pend - ant_pend,3) fpend, actu FROM cur_pend WHERE artped_codi = xarpc INTO ARRAY ar_xpendi
										xdelpend = ar_xpendi[1,1]
										SQLEXEC(frmaltaped,"update pedidos_articulos set art_codi=?xarti,artped_cant=?xcant,artped_precio=?xprec,artped_dasc=?xdasc,dac_codi=?xdac,artped_it=?xit WHERE artped_codi=?xarpc;")
		*!*									IF ar_xpendi[1,2] = 1
		*!*										SQLEXEC(frmaltaped,"update articulos set pedidos = pedidos + ?xdelpend where art_codi = ?xarti;")
		*!*									ENDIF
									ELSE
										lnLock = MySQL_LockTables("LOCK", "pedidos_articulos WRITE", frmaltaped)
										SQLEXEC(frmaltaped,"select cast(artped_codi+1 as DECIMAL(8,0)) as artped_codi from pedidos_articulos order by artped_codi desc limit 1;","cur_pednvo")
										IF RECCOUNT("cur_pednvo")>0
											xarpc=cur_pednvo.artped_codi
										ELSE
											xarpc=1
										ENDIF
										SQLEXEC(frmaltaped,"insert into pedidos_articulos values(?xarpc,?xcodip,?xarti,?xcant,?xprec,0,?xent,?xdasc,?xdac,?xit);")
										lnLock = MySQL_LockTables("UNLOCK", "", frmaltaped)
		*!*									SQLEXEC(frmaltaped,"update articulos set pedidos = pedidos + ?xcant where art_codi = ?xarti;")
										.grid1.col=8
										.grid1.text=STR(cur_pednvo.artped_codi)			
									ENDIF
								desconectar_db(frmaltaped)
								IF xarti > 5
									Campo_ped(xarti)
								ENDIF
							ENDIF
						next fila
						cerrar_cursor("cur_pend")
						cerrar_cursor("cur_arped")
					ENDIF
					ivari=.text9.value
					ivarni=.text11.value
					totalri=.text18.value+.text9.value
					totalrni=.text18.value+.text9.value+.text11.value
					totsiva=.text18.value
					DIMENSION tra[2,3]
					store "" to tra
					IF coditran1>0
						frmaltaped= conectar_db(_screen.cn)
							SQLEXEC(frmaltaped,"select * from transportes where tran_codi=?coditran1;","cur_tra")
						desconectar_db(frmaltaped)
						if RECCOUNT("cur_tra")>0
							tra[1,1]=allt(cur_tra.tran_nomb)
						endif
						tra[1,2]=allt(.edit1.value)
						tra[1,3]=iif(.opcionflete1.value=1,"C",iif(.opcionflete1.value=2,"P",""))
						if coditran2>0
							frmaltaped= conectar_db(_screen.cn)
								SQLEXEC(frmaltaped,"select * from transportes where tran_codi=?coditran2;","cur_tra2")
							desconectar_db(frmaltaped)
							if RECCOUNT("cur_tra2")>0
								tra[2,1]=allt(cur_tra2.tran_nomb)
							endif
							tra[2,2]=allt(.edit2.value)
							tra[2,3]=iif(.opcionflete2.value=1,"C",iif(.opcionflete2.value=2,"P",""))
						ENDIF
					ENDIF
					SET DECIMALS TO 4
					frmaltaped= conectar_db(_screen.cn)
						SQLEXEC(frmaltaped,"select b.*,c.*,d.cond_desc from pedidos a inner join iva b on a.iva_codi=b.iva_codi inner join clientes c on c.cli_codi=a.cli_codi inner join condiva d on c.cond_codi=d.cond_codi where a.ped_codi=?xcodip;","cur_datvar")
						SQLEXEC(frmaltaped,"select a.*,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on c.provi_codi=a.provi_codi where a.loca_codi=?cur_datvar.loca_codi;","cur_ubic")
						SQLEXEC(frmaltaped,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dac_desc from pedidos_articulos a inner join articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.ped_codi=?xcodip order by a.artped_it;","cur_arped")
						SQLEXEC(frmaltaped,"select * from pedidos where ped_codi=?xcodip;","cur_pedido")
						IF USED("cur_vendedor")
							USE IN cur_vendedor
						ENDIF
						SQLEXEC(frmaltaped,"select a.*,b.* from zonas a inner join vendedores b on a.ven_codi=b.ven_codi where a.zona_codi=?cur_datvar.zona_codi;","cur_vendedor")				
					desconectar_db(frmaltaped)
					SET DECIMALS TO
					SET POINT TO ","
					SET SEPARATOR TO "."
					SELECT cur_arped
					GO top
					report form pedidocliente for cur_pedido.ped_codi=xcodip TO PRINTER prompt noconsole
					SET POINT TO
					SET SEPARATOR TO
					MESSAGEBOX("No olvide obtener la Nota de Pedido Nº: "+ALLTRIM(STR(thisform.text7.Value))+" del talonario de Notas de Pedidos",16,"Aviso del Sistema")
					thisform.release
				ENDWITH
			endif
		endcase
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=8
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command10.Click
		coe=messagebox("¿Confirma aplicar el coeficiente indicado?",4+32+256,"Precios")
		if coe=6
			with thisform
				LOCAL ivaencol
				STORE 0 TO thisform.acu,auxiva,auximpo,auxali
				STORE 0 TO thisform.impo1, ;
						   thisform.impo2, ;
						   thisform.acu1, ;
						   thisform.acu2, ;
						   thisform.acun1, ;
						   thisform.acun2
				STORE 0 TO .text8.value, ;
					       .text9.value, ;
				           .text10.value, ;
				           .text11.value, ;
				           .text17.value, ;
		 		           .text18.value
		 		SET POINT TO ","
		 		SET DECIMALS TO 3
				for i=1 to .grid1.rows-1
					.grid1.row=i
					.grid1.col=1
					valor1=ConverNro(.grid1.text)
					.grid1.col=5
					if .optiongroup1.value=1
						valor2=ConverNro(.grid1.text)*.text24.value
					else
						valor2=round(ConverNro(.grid1.text)/.text24.value,3)
					endif
					.grid1.text=allt(str(valor2,10,3))
					.grid1.col=6
					.grid1.text=allt(str(valor1*valor2,10,2))
					thisform.acu=thisform.acu+ConverNro(.grid1.text)
					********************COMIENZA CALCULO DE IVA*********************
					.grid1.col=2
					.text8.value=thisform.acu
					.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
					.text18.value=.text8.value-.text17.value
					.grid1.col=7
					do case
						case ConverNro(.grid1.text)=thisform.impiva1
							ivaencol=1
						case ConverNro(.grid1.text)=thisform.impiva2
							ivaencol=2
					ENDCASE
					.grid1.col=6
					if .text19.value>0
						do case
							case ivaencol=1
								if cond=2
									thisform.impo1=thisform.impo1+(ConverNro(.grid1.text)*((100-.text19.value)/100))
									if auxali=2
										.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
									endif
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								else
									thisform.acun1=thisform.acun1+round(((ConverNro(.grid1.text)*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
									if auxali=2
										thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
									endif
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
							case ivaencol=2
								if cond=2
									thisform.impo2=thisform.impo2+(ConverNro(.grid1.text)*((100-.text19.value)/100))
									if auxali=1
										.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
									endif
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								else
									thisform.acun2=thisform.acun2+round(((ConverNro(.grid1.text)*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
									if auxali=1
										thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
									endif
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
						endcase
					else
						do case
							case ivaencol=1
								if cond=2
									thisform.impo1=thisform.impo1+ConverNro(.grid1.text)
									if auxali=2
										.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
									endif
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								else
									thisform.acun1=thisform.acun1+round((ConverNro(.grid1.text)/(1+(thisform.impiva1/100))),3)
									if auxali=2
										thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
									endif
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
							case ivaencol=2
								if cond=2
									thisform.impo2=thisform.impo2+ConverNro(.grid1.text)
									if auxali=1
										.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
									endif
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								else
									thisform.acun2=thisform.acun2+round((ConverNro(.grid1.text)/(1+(thisform.impiva2/100))),3)
									if auxali=1
										thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
									endif
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
						endcase
					endif
					.text10.value=.text18.value+.text9.value+.text11.value
				next i
				if paso>0
					paso=0
				endif
				.shape5.visible=.F.
				.optiongroup1.visible=.F.
				.label25.visible=.F.
				.text24.visible=.F.
				this.visible=.F.
			endwith
		else
			.text24.value=0
			.shape5.visible=.F.
			.optiongroup1.visible=.F.
			.label25.visible=.F.
			.text24.visible=.F.
			this.visible=.F.
		endif
	ENDPROC


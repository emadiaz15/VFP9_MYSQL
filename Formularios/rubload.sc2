	PROCEDURE Activate
		public d
		d=1
	ENDPROC

	PROCEDURE Destroy
		d=1
	ENDPROC

	PROCEDURE Init
		parameters rubroc,rubrod
		
		THISFORM.AddProperty("oRet")
		THISFORM.oRet = CREATEOBJECT("Empty")
		
		frmrublo= conectar_db(_screen.cn)
			SQLEXEC(frmrublo,"select rub_codi,rub_desc from rubros order by rub_desc;","cur_rub")
		desconectar_db(frmrublo)
		
		thisform.lstrub.RowSource="cur_rub"
		
	ENDPROC

	PROCEDURE Unload
		RETURN ThisForm.oRet
	ENDPROC

	PROCEDURE Command1.Click
		
		do form altarub
		
		frmrublo= conectar_db(_screen.cn)
			SQLEXEC(frmrublo,"select rub_codi,rub_desc from rubros order by rub_desc;","cur_rub")
		desconectar_db(frmrublo)
		
		GO top
		thisform.lstrub.requery
		thisform.txtrubload.setfocus
	ENDPROC

	PROCEDURE Command1.GotFocus
		if last()=5 or last()=24
			thisform.txtrubload.setfocus
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE lstrub.Click
		ADDPROPERTY(THISFORM.oRet, "xcodrub", cur_rub.rub_codi)
		ADDPROPERTY(THISFORM.oRet, "xdesrub", cur_rub.rub_desc)
		*!*	rubroc=cur_rub.rub_codi
		*!*	rubrod=cur_rub.rub_desc
		*!*	if prompt()<>"Por Rubro"
		*!*		frmrublo= conectar_db(_screen.cn)
		*!*			SQLEXEC(frmrublo,"select * from articulos where rub_codi=?rubroc;","cur_art")
		*!*		desconectar_db(frmrublo)
		*!*		if RECCOUNT("cur_art")>0
		*!*			GO top
		*!*	*!*			with altasart
		*!*	*!*				cadena="  "+repl("0",8-len(allt(str(rubroc))))+allt(str(rubroc))
		*!*	*!*				.text5.value=cadena+"  |  "+rubrod
		*!*	*!*				.shape1.visible=.T.
		*!*	*!*				.label6.visible=.T.
		*!*	*!*				.text5.visible=.T.
		*!*	*!*			endwith
		*!*			thisform.release
		*!*		else
		*!*			messagebox("Rubro no tiene artículos en archivo",0+64,"Alta de Artículos")
		*!*			altasart.grid1.visible=.F.
		*!*			thisform.release
		*!*		endif
		*!*		do form altartpreg with rubroc,rubrod
		*!*		do form altartpreg with thisform.oRet.xcodrub,thisform.oRet.xdesrub
		*!*	*!*	else
			thisform.release
		*!*	endif
	ENDPROC

	PROCEDURE lstrub.GotFocus
		if last()=24 or last()=5
			thisform.txtrubload.setfocus
			aviso=0
		endif
	ENDPROC

	PROCEDURE lstrub.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode=27
			ADDPROPERTY(THISFORM.oRet, "xcodrub", 0)
			ADDPROPERTY(THISFORM.oRet, "xdesrub", '')
		ENDIF
		
	ENDPROC

	PROCEDURE txtrubload.InteractiveChange
		local lc
		lc = allt(This.Value)
		if last()<>127 and last()<>7
			do while !eof()
				if lc=subst(cur_rub.rub_desc,1,len(lc))
					exit
				else
					skip
					d=d+1
					if eof()
						go top
						d=1
						exit
					endif
				endif
			enddo
		else
			do while lc=subst(cur_rub.rub_desc,1,len(lc)) and d>1
				if bof()
					exit
				endif
				skip-1
				if d>1
					d=d-1
				endif
				if lc<>subst(cur_rub.rub_desc,1,len(lc))
					skip
					d=d+1
					exit
				endif
			enddo				
		endif
		thisform.lstrub.selected(d)=.T.
		return
		
	ENDPROC

	PROCEDURE txtrubload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case nKeyCode=13
		*!*			if prompt()<>"Por Rubro"
		*!*				frmrublo= conectar_db(_screen.cn)
		*!*					SQLEXEC(frmrublo,"select * from articulos where rub_codi=?rubroc;","cur_art")
		*!*				desconectar_db(frmrublo)
		*!*				if RECCOUNT("cur_art")>0
		*!*					GO top
		*!*					with altasart
		*!*						cadena="  "+repl("0",8-len(allt(str(rubroc))))+allt(str(rubroc))
		*!*						.text5.value=cadena+"  |  "+rubrod
		*!*						.shape1.visible=.T.
		*!*						.label6.visible=.T.
		*!*						.text5.visible=.T.
		*!*					endwith
		*!*					thisform.release
		*!*				else
		*!*					aviso=messagebox("Rubro no tiene artículos en archivo",0+64,"Alta de Artículos")
		*!*					altasart.grid1.visible=.F.
		*!*					with altasart
		*!*						cadena="  "+repl("0",8-len(allt(str(rubroc))))+allt(str(rubroc))
		*!*						.text5.value=cadena+"  |  "+rubrod
		*!*						.shape1.visible=.T.
		*!*						.label6.visible=.T.
		*!*						.text5.visible=.T.
		*!*					endwith				
		*!*					thisform.release
		*!*				endif
				if allt(this.value)="FLIA 010"
					ADDPROPERTY(THISFORM.oRet, "xcodrub", 0)
					ADDPROPERTY(THISFORM.oRet, "xdesrub", '')
					altasart.release
					thisform.release
					do form ajustestock
				ELSE
					ADDPROPERTY(THISFORM.oRet, "xcodrub", cur_rub.rub_codi)
					ADDPROPERTY(THISFORM.oRet, "xdesrub", cur_rub.rub_desc)
					thisform.release
				endif
		*!*			else
		*!*				thisform.release			
		*!*			endif
			case nKeyCode=5
				if d>1
					d=d-1
				endif
				thisform.lstrub.selected(d)=.T.
				this.value=thisform.lstrub.value
			case nKeyCode=24
				if d<thisform.lstrub.listcount
					d=d+1
				endif
				thisform.lstrub.selected(d)=.T.
				this.value=thisform.lstrub.value
			case nKeyCode=27
				ADDPROPERTY(THISFORM.oRet, "xcodrub", 0)
				ADDPROPERTY(THISFORM.oRet, "xdesrub", '')			
				thisform.release
		endcase
	ENDPROC

ENDDEFINE

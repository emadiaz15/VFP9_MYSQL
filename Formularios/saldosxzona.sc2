	PROCEDURE Destroy
		set point to
		set separator to
	ENDPROC

	PROCEDURE GotFocus
		set point to ","
		set separator to "."
	ENDPROC

	PROCEDURE Init
		LOCAL saltot,vendn
		codifac=0
		saltot=0
		vendn=''
		set date british
		set cent on
		set point to ","
		set separator to "."
		zona=0
		ven=0
		vendn=UPPER(substr(sys(0),ATC("#",sys(0))+2))
		frmsalzon= conectar_db(_screen.cn)
			SQLEXEC(frmsalzon,"select * from vendedores where TRIM(ven_nomb)=?vendn;","cur_vendz")
		desconectar_db(frmsalzon)
		if RECCOUNT("cur_vendz")>0
			ven=cur_vendz.ven_codi
		else
			ven=0
		ENDIF
		CREATE CURSOR zon(zona_codi N(8),zona_desc C(10))
		if ven>0
			this.list1.rowsourcetype=2
			frmsalzon= conectar_db(_screen.cn)
				SQLEXEC(frmsalzon,"select zona_desc,zona_codi from zonas where ven_codi=?ven order by zona_codi;","zon")
			desconectar_db(frmsalzon)
			this.list1.rowsource="zon"
		else
			this.list1.rowsourcetype=2
			frmsalzon= conectar_db(_screen.cn)
				SQLEXEC(frmsalzon,"SELECT * FROM zonas order by zona_codi;","auxizon")
				SQLEXEC(frmsalzon,"select zona_desc,zona_codi from zonas order by zona_codi;","zon")
			desconectar_db(frmsalzon)
			this.list1.rowsource="zon"
		ENDIF
		
		frmsalzon= conectar_db(_screen.cn)
			IF ven>0
				SQLEXEC(frmsalzon,"select SUM(cli_saldo-cli_favor) as sal_tot from clientes where zona_codi = any (select zona_codi from zonas where ven_codi=?ven);","cur_stot")
			ELSE
				SQLEXEC(frmsalzon,"select SUM(cli_saldo-cli_favor) as sal_tot from clientes;","cur_stot")
			ENDIF
			saltot=cur_stot.sal_tot
		desconectar_db(frmsalzon)
		
		thisform.label2.Caption="TOTAL DE SALDOS DE TODAS LAS ZONAS:"
		thisform.text2.Value=saltot
		SET FILTER TO
		create cursor saldosxzona(cli_codi N(8),cli_nomb C(45),cli_domi C(35),cli_saldo N(15,2),loca_nomb C(20),provi_nomb C(20))
		sele saldosxzona
		this.text1.value=0
		
		****LABEL INFORMATIVO ************
		THISFORM.AddObject("lbl_info", "label")
		WITH THISFORM.lbl_info
		    .Left       = 148
		    .Top        = 283
		    .Autosize   = .T.
		    .Height     = 18
		    .Caption    = "Doble clic en un registro para ver la cuenta corriente"
		    .ForeColor  = RGB(255, 0, 0)
		    .BackStyle  = 0
		    .FontSize   = 10
		    .FontItalic = .T.
		    .FontBold   = .T.
		    .Alignment  = 0
		    .Visible    = .T.
		ENDWITH
	ENDPROC

	PROCEDURE LostFocus
		set point to
		set separator to
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(205,205,205)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE chk_saldo.Click
		thisform.grid1.RecordSource=''
		thisform.grid1.Refresh()
		DO CASE
			CASE this.Value=1
				SELECT * FROM cursal WHERE sal<>0 INTO CURSOR cursal
			CASE this.Value=0
				frmsalzon= conectar_db(_screen.cn)
					SQLEXEC(frmsalzon,"select a.cli_nomb,b.loca_nomb,c.provi_nomb,a.cli_saldo-a.cli_favor sal,a.cli_codi from clientes a inner join localidades  b on a.loca_codi=b.loca_codi,provincias as c where c.provi_codi=b.provi_codi and a.zona_codi=?zona order by a.cli_nomb;","cursal")
				desconectar_db(frmsalzon)
		ENDCASE 
		GO TOP IN cursal
		thisform.grid1.RecordSource='cursal'
		thisform.grid1.Refresh()
		
		
		
	ENDPROC

	PROCEDURE Command3.Click
		with thisform
			frmsalzon= conectar_db(_screen.cn)
				SQLEXEC(frmsalzon,"call usp_salxzon(?zona);","saldosxzona")
			desconectar_db(frmsalzon)
			.command3.enabled=.T.
			sele saldosxzona
			GO top
			IF .chk_saldo.value = 1
				SET FILTER TO cli_saldo <> 0
			ENDIF
			report form saldos TO PRINTER PROMPT noconsole
			IF .chk_saldo = 1
				SET FILTER TO
			ENDIF
			cerrar_cursor("saldosxzona")
			.release
		endwith
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		thisform.release
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Grid1.DblClick
		DO FORM consctacte WITH cursal.cli_codi, 2
	ENDPROC

	PROCEDURE List1.Click
		sele zon
		dimension valor[1,1]
		valor[1,1]=0
		thisform.grid1.RecordSource=''
		thisform.grid1.Refresh()
		IF thisform.chk_saldo.Visible= .T.
			thisform.chk_saldo.Value=0
			thisform.chk_saldo.Visible= .F.
		ENDIF
		
		for i=1 to this.listcount
			if this.selected(i)
				zona=val(this.value)
				frmsalzon= conectar_db(_screen.cn)
					SQLEXEC(frmsalzon,"select a.cli_nomb,b.loca_nomb,c.provi_nomb,a.cli_saldo-a.cli_favor sal,a.cli_codi from clientes a inner join localidades  b on a.loca_codi=b.loca_codi,provincias as c where c.provi_codi=b.provi_codi and a.zona_codi=?zona order by a.cli_nomb;","cursal")
					SQLEXEC(frmsalzon,"select round(sum(cli_saldo-cli_favor),2) as tot from clientes where zona_codi=?zona;","curtot")
				desconectar_db(frmsalzon)
				GO TOP IN cursal
				thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
				thisform.grid1.recordsource="cursal"
				valor[1,1]=curtot.tot
				thisform.label1.caption="Total a cobrar en la Zona "+allt(str(zona))+":"
				thisform.text1.value=IIF(ISNULL(valor[1,1]),0,valor[1,1])
				if thisform.text1.value<>0
					thisform.command3.enabled=.T.
				else
					thisform.command3.enabled=.F.
				endif
			endif
		next i
		thisform.grid1.forecolor=0
		thisform.chk_saldo.Visible= .T.
		
	ENDPROC

ENDDEFINE

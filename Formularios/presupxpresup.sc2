	PROCEDURE Command7.Click
		coe=messagebox("¿Confirma aplicar el coeficiente indicado?",4+32+256,"Precios")
		if coe=6
			SET POINT TO ","
			with thisform
				LOCAL ivaencol,xmone,xcotiz,xutilact,xcostoact
				STORE 0 TO thisform.acu,auxiva,auximpo,auxali,xutilact,xcostoact
				STORE 0 TO thisform.impo1, ;
						   thisform.impo2, ;
						   thisform.acu1, ;
						   thisform.acu2, ;
						   thisform.acun1, ;
						   thisform.acun2
				STORE 0 TO .text8.value, ;
					       .text9.value, ;
				           .text10.value, ;
				           .text11.value, ;
				           .text17.value, ;
		 		           .text18.value
				SELECT (thisform.xcurarpres)
				LOCATE
				SCAN
					valor1=ConverNro(artpres_cant)
					if .optiongroup1.value=1
						valor2=artpres_precio*.text14.value
					else
						valor2=round(artpres_precio/.text14.value,3)
					endif
					REPLACE artpres_precio WITH valor2
					xtotal = (valor1*valor2)
					REPLACE prtotal WITH xtotal
					**************************** COMIENZA CALCULO UTILIDAD Y COSTO ACTUAL ***********************************
					xmone = ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
					xcotiz= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,thisform.xcotiz,thisform.ctn_moneda.chk_pesos.Value=1,thisform.txt_cotiz.Value)
					xarti =art_codi
					xalicuo= alicuo
					IF xarti>5			
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr, "call usp_calcutil(?xarti,?valor2,?xmone,?xcotiz,?cond,?impiva1,?impiva2,?xalicuo);","cur_utiln")
							SQLEXEC(frmaltapr, "call usp_ctoutil(?xarti,?xmone,?DATE(),?xcotiz);","cur_cton")
						desconectar_db(frmaltapr)
						IF RECCOUNT("cur_utiln") > 0
							SELECT IIF(ISNULL(util),0,util) FROM cur_utiln INTO ARRAY ar_utiln
							cerrar_cursor("cur_utiln")
						ENDIF
						xutilact=IIF(TYPE("ar_utiln")="N",ar_utiln[1],0)
						IF RECCOUNT("cur_cton") > 0
							SELECT IIF(ISNULL(costo),0,costo) FROM cur_cton INTO ARRAY ar_cton
							cerrar_cursor("cur_cton")
						ENDIF
						xcostoact=IIF(TYPE("ar_cton")="N",ar_cton[1],0)
					ELSE
						STORE 0 TO xutilact,xcostoact
					ENDIF
					***************************** FIN CALCULO UTILIDAD Y COSTO ACTUAL **************************************
					SELECT (thisform.xcurarpres)
					REPLACE util WITH xutilact
					REPLACE costo WITH xcostoact
					thisform.acu=thisform.acu+xtotal
					********************COMIENZA CALCULO DE IVA*********************
					IF ALLTRIM(art_med)<>"ALT"
						.text8.value=thisform.acu
						.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
						.text18.value=.text8.value-.text17.value
						do case
							case iva=thisform.impiva1
								ivaencol=1
							case iva=thisform.impiva2
								ivaencol=2
						ENDCASE
						if .text19.value>0
							do case
								case ivaencol=1
									if cond=2
										thisform.impo1=thisform.impo1+(xtotal*((100-.text19.value)/100))
										if auxali=2
											.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
										endif
										.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
									else
										thisform.acun1=thisform.acun1+round(((xtotal*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
										if auxali=2
											thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
										endif
										thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
									endif
								case ivaencol=2
									if cond=2
										thisform.impo2=thisform.impo2+(xtotal*((100-.text19.value)/100))
										if auxali=1
											.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
										endif
										.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
									else
										thisform.acun2=thisform.acun2+round(((xtotal*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
										if auxali=1
											thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
										endif
										thisform.acu2=round((acun2*thisform.impiva2)/100,2)
									endif
							endcase
						else
							do case
								case ivaencol=1
									if cond=2
										thisform.impo1=thisform.impo1+xtotal
										if auxali=2
											.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
										endif
										.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
									else
										thisform.acun1=thisform.acun1+round((xtotal/(1+(thisform.impiva1/100))),3)
										if auxali=2
											thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
										endif
										thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
									endif
								case ivaencol=2
									if cond=2
										thisform.impo2=thisform.impo2+xtotal
										if auxali=1
											.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
										endif
										.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
									else
										thisform.acun2=thisform.acun2+round((xtotal/(1+(thisform.impiva2/100))),3)
										if auxali=1
											thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
										endif
										thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
									endif
							endcase
						endif
						.text10.value=.text18.value+.text9.value+.text11.value
						thisform.calcutilidad(2)
						thisform.grd_detalle.Refresh
					ENDIF
				ENDSCAN
				if paso>0
					paso=0
				endif
				.shape4.visible=.F.
				.optiongroup1.visible=.F.
				.label14.visible=.F.
				.text14.visible=.F.
				this.visible=.F.
			ENDWITH
			SET POINT TO
		ELSE
			WITH thisform
				.text14.value=0
				.shape4.visible=.F.
				.optiongroup1.visible=.F.
				.label14.visible=.F.
				.text14.visible=.F.
			ENDWITH
			this.visible=.F.
		endif
	ENDPROC


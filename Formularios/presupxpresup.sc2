	PROCEDURE Activate
		LOCAL xiva,xmone,xutilact,xcostoact,xcotiz,xprbajo
		STORE 0 TO xutilact,xcostoact
		xmone = ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
		xcotiz= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,thisform.xcotiz,thisform.ctn_moneda.chk_pesos.Value=1,thisform.txt_cotiz.Value)
		opcion=0
		impiva1=thisform.impiva1
		impiva2=thisform.impiva2
		valorcadena=thisform.valorcadena
		on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		set exact on
		if thisform.codicli=0
			on key label INS
			thisform.release
		endif
		if codigo=0
			muestro=0
			localiz=0
			alternati=''
		endif
		if muestro=1
			SET POINT TO ","
			SET DECIMALS TO 3
			with thisform
				frmaltapr= conectar_db(_screen.cn)
					SQLEXEC(frmaltapr, "select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmaltapr)
				**************************** COMIENZA CALCULO UTILIDAD Y COSTO ACTUAL ***********************************
				IF codigo>5
					xprbajo= ROUND((ConverNro(pruni)*thisform.xdolarbajo)/_screen.dolarpres,3)
					frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr, "call usp_calcutil(?codigo,?xprbajo,?xmone,?xcotiz,?cond,?impiva1,?impiva2,?cur_arti.art_alicuota);","cur_utiln")
						SQLEXEC(frmaltapr, "call usp_ctoutil(?codigo,?xmone,?DATE(),?xcotiz);","cur_cton")
					desconectar_db(frmaltapr)
					IF RECCOUNT("cur_utiln") > 0
						SELECT IIF(ISNULL(util),0,util) FROM cur_utiln INTO ARRAY ar_utiln
						cerrar_cursor("cur_utiln")
					ENDIF
					xutilact=IIF(TYPE("ar_utiln")="N",ar_utiln[1],0)
					IF RECCOUNT("cur_cton") > 0
						SELECT IIF(ISNULL(costo),0,costo) FROM cur_cton INTO ARRAY ar_cton
						cerrar_cursor("cur_cton")
					ENDIF
					xcostoact=IIF(TYPE("ar_cton")="N",ar_cton[1],0)
				ELSE
					STORE 0 TO xutilact,xcostoact
				ENDIF				
				***************************** FIN CALCULO UTILIDAD Y COSTO ACTUAL **************************************
				if alternati="S"
					SELECT (thisform.xcurarpres)
					localiz=0
					with thisform
						if paso=1
							nregistro=nro_regis
							&&cur_arpres.nro_regis
							UPDATE (thisform.xcurarpres) SET art_codi=codigo,art_desc=IIF(codigo<=5,ALLTRIM(descrip),ALLTRIM(descri)), ;
												   artpres_precio=ConverNro(pruni),util=xutilact WHERE nro_regis = nregistro
							GO nregistro IN (thisform.xcurarpres)
							thisform.grd_detalle.Refresh
						ELSE
							SELECT MAX(nro_regis)+1 FROM (thisform.xcurarpres) INTO ARRAY xreg
							nregistro = IIF(ISNULL(xreg[1]),1,xreg[1])
							INSERT INTO (thisform.xcurarpres) values('','','ALT',codigo,IIF(codigo<=5,ALLTRIM(descrip),ALLTRIM(descri)),ConverNro(pruni),0,0,xutilact,xcostoact, ;
													       cur_arti.art_alicuota,'S',cond,thisform.text19.Value,nregistro)
							thisform.grd_detalle.Refresh
						endif
					ENDWITH
					alternati=''
				else
					localiz=1
					if paso=1
						SELECT (thisform.xcurarpres)
						nregistro=nro_regis
						&&cur_arpres.nro_regis
						thisform.acu=thisform.acu-prtotal &&cur_arpres.prtotal
						xdto= thisform.text19.Value
						cant=SPACE(15-LEN(ALLTRIM(cant)))+ALLTRIM(cant)
						UPDATE (thisform.xcurarpres) SET artpres_cant=cant,art_med=cur_arti.art_med,art_codi=codigo, ;
										       art_desc=IIF(codigo<=5,ALLTRIM(descrip),ALLTRIM(descri)), ;
										       artpres_precio=ConverNro(pruni),prtotal=ConverNro(prtot), ;
										       iva=IIF(cur_arti.art_alicuota=1,impiva1,impiva2), ;
										       util=xutilact,costo=xcostoact,alicuo=cur_arti.art_alicuota, ;
										       presup_dto=xdto WHERE nro_regis = nregistro
		
						if .text19.value>0
							auxiva=auxiva-(auxiva*.text19.value/100)
							auximpo=auximpo-(auximpo*.text19.value/100)
						ENDIF
						do case
							case cur_arti.art_alicuota=1
								if cond=2
									if auxali=1
										thisform.impo1=thisform.impo1-auximpo
									else
										thisform.impo2=thisform.impo2-auximpo
									endif
								else
									if auxali=1
										thisform.acun1=thisform.acun1-auximpo
									else
										thisform.acun2=thisform.acun2-auximpo
									endif
								endif
							case cur_arti.art_alicuota=2
								if cond=2
									if auxali=2
										thisform.impo2=thisform.impo2-auximpo
									else
										thisform.impo1=thisform.impo1-auximpo
									endif
								else
									if auxali=2
										thisform.acun2=thisform.acun2-auximpo
									else
										thisform.acun1=thisform.acun1-auximpo
									endif
								endif
						ENDCASE
						SET POINT TO ","
						thisform.acu=thisform.acu+ConverNro(prtot)
						SET POINT TO
						thisform.calcutilidad(2)
						GO nregistro IN (thisform.xcurarpres)
						thisform.grd_detalle.Refresh
						paso=0
					ELSE
						if insertar=0
							SELECT MAX(ConverNro(item))+1 FROM (thisform.xcurarpres) INTO ARRAY ar_item
							thisform.nitem = IIF(ISNULL(ar_item[1]),1,ar_item[1])
							SELECT MAX(nro_regis)+1 FROM (thisform.xcurarpres) INTO ARRAY ar_regis
							nregistro = IIF(ISNULL(ar_regis[1]),1,ar_regis[1])
							cant=SPACE(15-LEN(ALLTRIM(cant)))+ALLTRIM(cant)
							INSERT INTO (thisform.xcurarpres) VALUES(ALLTRIM(STR(thisform.nitem)),cant,cur_arti.art_med, ;
														   cur_arti.art_codi,IIF(codigo<=5,ALLTRIM(descrip),ALLTRIM(descri)), ;
														   ConverNro(pruni),ConverNro(prtot),IIF(cur_arti.art_alicuota=1,impiva1,impiva2), ;
														   xutilact,xcostoact,cur_arti.art_alicuota,'',cond, ;
														   thisform.text19.Value,nregistro)
							thisform.grd_detalle.Refresh
						ENDIF
						SET POINT TO ","
						thisform.acu=thisform.acu+ConverNro(prtot)
						SET POINT TO
					endif
				ENDIF
				if paso=1
					paso=0
				endif
			ENDWITH
			SET POINT TO
			SET DECIMALS TO 
			codigo=0
			thisform.grd_detalle.SetFocus
		endif
		if localiz=1 and thisform.nitem>0
			SET POINT TO ","
			with thisform
				.text8.value=thisform.acu
				.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
				.text18.value=.text8.value-.text17.value
				if .text19.value>0
					do case
						case cur_arti.art_alicuota=1
							if cond=2
								thisform.impo1=thisform.impo1+(ConverNro(prtot)*((100-.text19.value)/100))
								if auxali=2
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								endif
								.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							else
								thisform.acun1=thisform.acun1+round(((ConverNro(prtot)*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
								if auxali=2
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
						case cur_arti.art_alicuota=2
							if cond=2
								thisform.impo2=thisform.impo2+(ConverNro(prtot)*((100-.text19.value)/100))
								if auxali=1
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								endif
								.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							else
								thisform.acun2=thisform.acun2+round(((ConverNro(prtot)*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
								if auxali=1
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
								thisform.acu2=round((acun2*thisform.impiva2)/100,2)
							endif
					endcase
				else
					do case
						case cur_arti.art_alicuota=1
							if cond=2
								thisform.impo1=thisform.impo1+ConverNro(prtot)
								if auxali=2
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								endif
								.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							else
								thisform.acun1=thisform.acun1+round((ConverNro(prtot)/(1+(thisform.impiva1/100))),3)
								if auxali=2
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
						case cur_arti.art_alicuota=2
							if cond=2
								thisform.impo2=thisform.impo2+ConverNro(prtot)
								if auxali=1
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								endif
								.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							else
								thisform.acun2=thisform.acun2+round((ConverNro(prtot)/(1+(thisform.impiva2/100))),3)
								if auxali=1
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
					endcase
				endif
				.text10.value=.text18.value+.text9.value+.text11.value
				thisform.calcutilidad(2)
			ENDWITH
			SET POINT TO
		endif
		store 0 to localiz,muestro
		
		SELECT MAX(ConverNro(item)) FROM (thisform.xcurarpres) INTO ARRAY ar_item
		IF TYPE("ar_item")="N"
			thisform.nitem = ar_item[1]
		endif
		
		if thisform.nitem=0
			thisform.command4.enabled=.F.
			thisform.command5.enabled=.F.
		else
			thisform.command4.enabled=.T.
			thisform.command5.enabled=.T.
		endif
	ENDPROC

	PROCEDURE calcutilidad
		LPARAMETERS xopcion
		
		IF cond = 2
			SELECT SUM(artpres_precio*ConverNro(artpres_cant)) FROM (thisform.xcurarpres) WHERE alternativa<>'S' AND art_codi > 5 AND util > 0 into array ar_totv
		ELSE
			SELECT SUM((artpres_precio/((iva/100)+1))*ConverNro(artpres_cant)) FROM (thisform.xcurarpres) WHERE alternativa<>'S' AND art_codi > 5 AND util > 0 into array ar_totv
		ENDIF
		
		SELECT SUM(costo*ConverNro(artpres_cant)) FROM (thisform.xcurarpres) WHERE alternativa<>'S' AND art_codi > 5 into array ar_totc
		*!*	SELECT SUM(costo*ConverNro(artpres_cant)) FROM cur_arpres WHERE alternativa<>'S' into array ar_totcact
		
		IF xopcion = 1
			xutipro = ROUND(((ar_totv[1]/ar_totc[1])-1)*100,3)
			thisform.txt_utilact.Value=IIF(ISNULL(xutipro),0,xutipro)
			_screen.utilidad=xutipro
		ENDIF
		
		xutiact=IIF(ar_totc[1]=0,0,ROUND(((ar_totv[1]/ar_totc[1])-1)*100,3))
		
		thisform.txt_utipro.Value=IIF(ISNULL(xutiact),0,xutiact)
		
		RETURN
		
	ENDPROC

	PROCEDURE calc_totales
		SET ENGINEBEHAVIOR 70
		
		SELECT ROUND(SUM(ConverNro(artpres_cant)*artpres_precio),2) FROM (thisform.xcurarpres) INTO ARRAY ar_acu
		thisform.acu=ar_acu[1]
		
		thisform.text8.value=thisform.acu
		thisform.text17.value=iif(thisform.text19.value>0,round((thisform.acu*thisform.text19.value)/100,2),0)
		thisform.text18.value=thisform.text8.value-thisform.text17.value
		
		SELECT SUM(IIF(presup_dto>0,(prtotal*(100-presup_dto)/100),prtotal)) ;
				FROM (thisform.xcurarpres) WHERE alicuo = 1 AND cond_codi = 2 INTO ARRAY ar_impo1
		IF TYPE("ar_impo1")="N"
			thisform.impo1= IIF(ISNULL(ar_impo1[1]),0,ar_impo1[1])
		ENDIF
		
		SELECT SUM(IIF(presup_dto>0,(prtotal*(100-presup_dto)/100),prtotal)) ;
				FROM (thisform.xcurarpres) WHERE alicuo = 2 AND cond_codi = 2 INTO ARRAY ar_impo2		
		IF TYPE("ar_impo2")="N"
			thisform.impo2= IIF(ISNULL(ar_impo2[1]),0,ar_impo2[1])
		ENDIF
		
		SELECT SUM(IIF(presup_dto>0,(prtotal*(100-presup_dto)/100),prtotal)/((iva/100)+1)) ;
				FROM (thisform.xcurarpres) WHERE alicuo = 1 AND cond_codi <> 2 INTO ARRAY ar_acn1
		IF TYPE("ar_acn1")="N"
			thisform.acun1= IIF(ISNULL(ar_acn1[1]),0,ar_acn1[1])
			thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
		ENDIF
		
		SELECT SUM(IIF(presup_dto>0,(prtotal*(100-presup_dto)/100),prtotal)/((iva/100)+1)) ;
				FROM (thisform.xcurarpres) WHERE alicuo = 2 AND cond_codi <> 2 INTO ARRAY ar_acn2
		IF TYPE("ar_acn2")="N"
			thisform.acun2= IIF(ISNULL(ar_acn2[1]),0,ar_acn2[1])
			thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
		ENDIF
			
		SELECT ROUND(SUM(IIF(presup_dto>0,(((ConverNro(artpres_cant)*artpres_precio)*((100-presup_dto)/100)) * iva)/100, ;
				(((ConverNro(artpres_cant)*artpres_precio)* iva)/100))),2) ;
				FROM (thisform.xcurarpres) WHERE alicuo = 1 AND cond_codi = 2 INTO ARRAY ar_iva1
		IF TYPE("ar_iva1")="N"
			thisform.text9.value= IIF(ISNULL(ar_iva1[1]),0,ar_iva1[1])
		ENDIF
		
		SELECT ROUND(SUM(IIF(presup_dto>0,(((ConverNro(artpres_cant)*artpres_precio)*((100-presup_dto)/100)) * iva)/100, ;
				(((ConverNro(artpres_cant)*artpres_precio)* iva)/100))),2) ;
				FROM (thisform.xcurarpres) WHERE alicuo = 2 AND cond_codi = 2 INTO ARRAY ar_iva2
		IF TYPE("ar_iva2")="N"
			thisform.text11.value= IIF(ISNULL(ar_iva2[1]),0,ar_iva2[1])
		ENDIF
						                  
		thisform.text10.value=thisform.text18.value+thisform.text9.value+thisform.text11.value
		
		SET ENGINEBEHAVIOR
		
		RETURN
	ENDPROC

	PROCEDURE datos_click
		
		thisform.RemoveObject("shp_datos")
		thisform.RemoveObject("edt_datos")
		thisform.RemoveObject("cmd_datos")
	ENDPROC

	PROCEDURE datos_mleave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.F.
		thisform.cmd_datos.FontSize=9
	ENDPROC

	PROCEDURE datos_mmove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.T.
		thisform.cmd_datos.FontSize=10
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 2 of Altas .F.
		localiz=0
		
		_screen.xopvta=""
		
		IF USED("cur_utpre")
			_screen.utilidad=cur_utpre.param_impo
		endif
		on key label INS
	ENDPROC

	PROCEDURE excelautomatiz
		IF USED((thisform.xcurarpres))
			IF RECCOUNT((thisform.xcurarpres)) > 0
				SELECT (thisform.xcurarpres)
				LOCATE
				local Fila,fpag,pagina,cantit,nvalfila,nresto
		
				wait'Espere Un Momento Exportando Datos' window nowait
				_screen.mousepointer=11
				TmpSheet=GetObject('','Excel.Sheet')
				XLApp=TmpSheet.Application
				XLApp.workbooks.add()
				XLSheet=XLApp.ActiveSheet
				with XLSheet.PageSetup
					.Orientation = 1
					.LeftMargin = XLApp.InchesToPoints(0.5)
					.RightMargin = XLApp.InchesToPoints(0)
				    .TopMargin = XLApp.InchesToPoints(0)
				    .BottomMargin = XLApp.InchesToPoints(0)
				    .HeaderMargin = XLApp.InchesToPoints(0)
				    .FooterMargin = XLApp.InchesToPoints(0)
				    .Zoom=80
				ENDWITH
				XLSheet.Columns("A:A").ColumnWidth = 3.71
				XLSheet.Columns("B:B").ColumnWidth = 10.73
				XLSheet.Columns("C:C").ColumnWidth = 3.71
				XLSheet.Columns("D:D").ColumnWidth = 9.43
				XLSheet.Columns("E:E").ColumnWidth = 48.71
				XLSheet.Columns("F:F").ColumnWidth = 5
				XLSheet.Columns("G:G").ColumnWidth = 15.14
				XLSheet.Columns("H:H").ColumnWidth = 17.60
		
				thisform.excelencabezado(3)
				nvalfila = 0
				cantit = 0
				pagina = 0
				Fila = 19
				SELECT (thisform.xcurarpres)
				LOCATE
				SCAN
					XLSheet.Cells(Fila,1)=item
					XLSheet.Cells(Fila,1).HorizontalAlignment=-4108
					XLSheet.Cells(Fila,2)=artpres_cant
					XLSheet.Cells(Fila,2).NUMBERFORMAT="#,###0.000"
					XLSheet.Cells(Fila,3)=art_med
					XLSheet.Cells(Fila,4)=IIF(art_codi>5,art_codi,"S/C")
					IF art_codi<=5
						XLSheet.Cells(Fila,4).font.bold=.T.
					ENDIF
		  			xini = "A"+ALLTRIM(STR(Fila))
					xfin = "D"+ALLTRIM(STR(Fila))
					rango= '"'+xini+':'+xfin+'"'			
					XLSheet.range(&rango).VerticalAlignment=-4160
					XLSheet.Cells(Fila,5)=ALLTRIM(art_desc)
					XLSheet.Cells(Fila,5).WrapText = .T.
					XLSheet.Cells(Fila,6)=iva
					XLSheet.Cells(Fila,6).NUMBERFORMAT="#,##0.00"
					XLSheet.Cells(Fila,7)=IIF(artpres_precio>0,artpres_precio,"No Cotizamos")
					IF artpres_precio=0
						XLSheet.Cells(Fila,7).HorizontalAlignment=-4108
						XLSheet.Cells(Fila,7).font.bold=.T.
						XLSheet.Cells(Fila,7).font.italic=.T.
					ENDIF
					XLSheet.Cells(Fila,8)=IIF(artpres_precio>0,prtotal,"")
		  			XLSheet.Cells(Fila,7).NUMBERFORMAT="#,###0.000"
		  			XLSheet.Cells(Fila,8).NUMBERFORMAT="#,##0.00"
		  			xini = "C"+ALLTRIM(STR(Fila))
					xfin = "D"+ALLTRIM(STR(Fila))
					rango= '"'+xini+':'+xfin+'"'			
					XLSheet.range(&rango).HorizontalAlignment=-4108
		  			xini = "A"+ALLTRIM(STR(Fila))
					xfin = "H"+ALLTRIM(STR(Fila))
					rango= '"'+xini+':'+xfin+'"'
					XLSheet.range(&rango).font.name="Arial"
					XLSheet.range(&rango).font.size=9
					IF XLSheet.Rows(Fila).RowHeight > 16
						nvalfila = XLSheet.Rows(Fila).RowHeight/15
						nresto   = (MOD(XLSheet.Rows(Fila).RowHeight,15)/15)*100
						IF nresto < 50
							cantit = cantit + INT(nvalfila)
						ELSE
							cantit = cantit + (INT(nvalfila)+1)
						ENDIF
					ELSE
						cantit = cantit + 1
					ENDIF
					
					IF cantit=47
						Fila = Fila + 1
						pagina = pagina + 1
						xini = "A"+ALLTRIM(STR(Fila))
						xfin = "H"+ALLTRIM(STR(Fila))
						rango= '"'+xini+':'+xfin+'"'
						XLSheet.range(&rango).Borders(3).LineStyle = 1
						XLSheet.range(&rango).Borders(3).Weight = 2
						XLSheet.Cells(Fila,1)="Página "+ALLTRIM(STR(pagina))
						XLSheet.Cells(Fila,1).font.name="Arial"
						XLSheet.Cells(Fila,1).font.size=9
						XLSheet.Cells(Fila,1).font.italic=.T.
						difefil=49-cantit
						Fila = Fila + (difefil + 8)
						thisform.excelencabezado(Fila)
						Fila = Fila + 16
						cantit=0
					ELSE
						Fila=Fila+1
					ENDIF				
				ENDSCAN
				thisform.excelfooter(Fila)
				Fila=Fila+6
				thisform.excelcondi(Fila)
				pagina = pagina + 1
				Fila = thisform.xlsultpag + 1
				XLSheet.Cells(Fila,1)="Página "+ALLTRIM(STR(pagina))
				XLSheet.Cells(Fila,1).font.name="Arial"
				XLSheet.Cells(Fila,1).font.size=9
				XLSheet.Cells(Fila,1).font.italic=.T.
				Xlsheet.cells(1,1).Select
				XLApp.visible=.T.
				XLApp.WindowState = -4137
				DECLARE LONG BringWindowToTop IN "user32" LONG HWND
				BringWindowToTop(XLApp.HWND)
				_screen.mousepointer=0
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE excelcondi
		LPARAMETERS xfila
		
		LOCAL primfila
		
		XLSheet.cells(xFila,1)="Validez Oferta: "+ALLTRIM(cur_conpres.presup_ofer)
		XLSheet.cells(xFila+1,1)="Plazo Entrega: "+ALLTRIM(cur_conpres.presup_plent)
		XLSheet.cells(xFila+2,1)="Condiciones de Pago: "+ALLTRIM(cur_conpres.presup_cond)
		XLSheet.cells(xFila+3,1)="Lugar de Entrega: "+ALLTRIM(cur_conpres.presup_lugent)
		sizeob = LEN(ALLTRIM(cur_conpres.presup_obser))
		primfila = xFila
		IF sizeob<=109
			XLSheet.cells(xFila+4,1)="Observaciones: "+TRIM(cur_conpres.presup_obser)
			XLSheet.cells(xFila+4,1).WrapText=.F.
			thisform.xlsultpag=xFila + 5
		ELSE
			rengob = CEILING(sizeob/90)
			xFila = xFila + 4
			FOR x=1 TO rengob
				IF x=1
					XLSheet.cells(xFila,1)="Observaciones: "+SUBSTR(ALLTRIM(cur_conpres.presup_obser),1,90)
					XLSheet.cells(xFila,1).WrapText=.F.
				ELSE
					posicion = IIF(x=1,1,((90*x)-90)+1)
					XLSheet.cells(xFila,1)=SUBSTR(ALLTRIM(cur_conpres.presup_obser),posicion,90)
					XLSheet.cells(xFila,1).WrapText=.F.
				ENDIF
				xFila = xFila +1
			NEXT x
			thisform.xlsultpag=xFila + 3
		ENDIF
		xini = "A"+ALLTRIM(STR(primfila))
		xfin = "A"+ALLTRIM(STR(primfila+30))
		xrango= '"'+xini+':'+xfin+'"'
		XLSheet.Range(&xrango).font.name="Arial"
		XLSheet.Range(&xrango).font.size=9
		
		xrango = ALLTRIM('"A'+ALLTRIM(STR(primfila))+'"')
		With XLSheet.Range(&xrango).Characters(1,15).Font
		    .Name = "Courier New"
		    .Size = 9
		    .bold = .T.
		ENDWITH
		xrango = ALLTRIM('"A'+ALLTRIM(STR(primfila+1))+'"')
		With XLSheet.Range(&xrango).Characters(1,14).Font
		    .Name = "Courier New"
		    .Size = 9
		    .bold = .T.
		EndWith
		xrango = ALLTRIM('"A'+ALLTRIM(STR(primfila+2))+'"')
		With XLSheet.Range(&xrango).Characters(1,20).Font
		    .Name = "Courier New"
		    .Size = 9
		    .bold = .T.
		EndWith
		xrango = ALLTRIM('"A'+ALLTRIM(STR(primfila+3))+'"')
		With XLSheet.Range(&xrango).Characters(1,17).Font
		    .Name = "Courier New"
		    .Size = 9
		    .bold = .T.
		EndWith
		xrango = ALLTRIM('"A'+ALLTRIM(STR(primfila+4))+'"')
		With XLSheet.Range(&xrango).Characters(1,14).Font
		    .Name = "Courier New"
		    .Size = 9
		    .bold = .T.
		EndWith
		
		    
		RETURN
			
	ENDPROC

	PROCEDURE excelencabezado
		LPARAMETERS xFila
		
		lcImagen = "C:\VFP9_MYSQL\hp.jpg"
		Xlsheet.cells(xFila,2).Select
		xname = "Picture "+ALLTRIM(STR(xFila))
		XLSheet.Pictures.Insert(lcImagen).name=xname
		XLSheet.Shapes(xname).Width=135
		XLSheet.Shapes(xname).Height=135
		
		xFila = xFila + 1
		Xlsheet.cells(xFila,7)="Presup. Nº:"
		XLSheet.Cells(xFila,7).font.bold=.T.
		XLSheet.Cells(xFila,7).font.size="10"
		XLSheet.Cells(xFila,7).font.name="Arial"
		XLSheet.Cells(xFila,7).HorizontalAlignment=-4152
		Xlsheet.cells(xFila,8)=cur_conpres.presup_codi
		XLSheet.Cells(xFila,8).font.size="10"
		XLSheet.Cells(xFila,8).font.name="Arial"
		XLSheet.Cells(xFila,8).HorizontalAlignment=-4131
		
		xFila = xFila + 1
		Xlsheet.cells(xFila,7)="Fecha:"
		XLSheet.Cells(xFila,7).font.bold=.T.
		XLSheet.Cells(xFila,7).font.size="10"
		XLSheet.Cells(xFila,7).font.name="Arial"
		XLSheet.Cells(xFila,7).HorizontalAlignment=-4152
		Xlsheet.cells(xFila,8)=cur_conpres.presup_fech
		XLSheet.Cells(xFila,8).font.size="10"
		XLSheet.Cells(xFila,8).font.name="Arial"
		XLSheet.Cells(xFila,8).HorizontalAlignment=-4131
		
		xFila = xFila + 1
		xini = "E"+ALLTRIM(STR(xFila))
		xfin = "F"+ALLTRIM(STR(xFila))
		rango= '"'+xini+':'+xfin+'"'
		XLSheet.range(&rango).merge
		Xlsheet.cells(xFila,5)="PRESUPUESTO"
		XLSheet.Cells(xFila,5).font.bold=.T.
		XLSheet.Cells(xFila,5).font.underline=.T.
		XLSheet.Cells(xFila,5).font.size="18"
		XLSheet.Cells(xFila,5).font.name="Arial"
		XLSheet.range(&rango).HorizontalAlignment=7
		
		xFila = xFila + 1
		xini = "G"+ALLTRIM(STR(xFila))
		xfin = "G"+ALLTRIM(STR(xFila+2))
		rango= '"'+xini+':'+xfin+'"'
		XLSheet.range(&rango).Borders(1).LineStyle = 1
		XLSheet.range(&rango).Borders(1).Weight = 2
		xini = "H"+ALLTRIM(STR(xFila))
		xfin = "H"+ALLTRIM(STR(xFila+2))
		rango= '"'+xini+':'+xfin+'"'
		XLSheet.range(&rango).Borders(2).LineStyle = 1
		XLSheet.range(&rango).Borders(2).Weight = 2
		xini = "G"+ALLTRIM(STR(xFila))
		xfin = "H"+ALLTRIM(STR(xFila))
		rango= '"'+xini+':'+xfin+'"'
		XLSheet.range(&rango).Borders(3).LineStyle = 1
		XLSheet.range(&rango).Borders(3).Weight = 2
		xini = "G"+ALLTRIM(STR(xFila+2))
		xfin = "H"+ALLTRIM(STR(xFila+2))
		rango= '"'+xini+':'+xfin+'"'
		XLSheet.range(&rango).Borders(4).LineStyle = 1
		XLSheet.range(&rango).Borders(4).Weight = 2
		Xlsheet.cells(xFila,7)="  CUIT: 30-70965506-6"
		Xlsheet.cells(xFila+1,7)="  ING. BRUTOS: 904-2423081"
		Xlsheet.cells(xFila+2,7)="  Inicio Activ.: 01/05/2006"
		xini = "G"+ALLTRIM(STR(xFila))
		xfin = "H"+ALLTRIM(STR(xFila+2))
		rango= '"'+xini+':'+xfin+'"'
		Xlsheet.range(&rango).Font.name="Courier New"
		Xlsheet.range(&rango).Font.size=10
		Xlsheet.range(&rango).Font.bold=.T.
		Xlsheet.range(&rango).Font.Italic=.T.
		
		xFila = xFila + 5
		xini = "A"+ALLTRIM(STR(xFila))
		xfin = "H"+ALLTRIM(STR(xFila))
		rango= '"'+xini+':'+xfin+'"'
		XLSheet.range(&rango).Borders(3).LineStyle = 1
		XLSheet.range(&rango).Borders(3).Weight = 2
		
		XLSheet.Rows(xFila).RowHeight = 10
		
		xFila = xFila + 1
		Xlsheet.cells(xFila,2)="        Sr/es:"
		Xlsheet.cells(xFila,2).font.name="Arial"
		Xlsheet.cells(xFila,2).font.bold=.T.
		Xlsheet.cells(xFila,2).font.size=10
		Xlsheet.cells(xFila,3)=cur_conpres.cli_nomb
		Xlsheet.cells(xFila+1,3)=cur_conpres.cli_domi
		Xlsheet.cells(xFila+2,3)=ALLTRIM(STR(cur_ubicli.cp_nro))+"   "+PADR(ALLTRIM(cur_ubicli.loca_nomb),30," ")+"   "+ALLTRIM(cur_ubicli.provi_nomb)
		xini = "C"+ALLTRIM(STR(xFila))
		xfin = "C"+ALLTRIM(STR(xFila+2))
		rango= '"'+xini+':'+xfin+'"'
		XLSheet.range(&rango).font.name="Arial"
		XLSheet.range(&rango).font.size=10
		Xlsheet.cells(xFila,6)="CUIT:"
		Xlsheet.cells(xFila,6).font.name="Arial"
		Xlsheet.cells(xFila,6).font.bold=.T.
		Xlsheet.cells(xFila,6).font.size=10
		XLSheet.Cells(xFila,6).HorizontalAlignment=-4152
		Xlsheet.cells(xFila,7)=cur_conpres.cli_cuit
		Xlsheet.cells(xFila,7).font.name="Arial"
		Xlsheet.cells(xFila,7).font.size=10
		Xlsheet.cells(xFila,7).numberformat="##-########-#"
		XLSheet.Cells(xFila,7).HorizontalAlignment=-4131
		Xlsheet.cells(xFila+1,6)="C.IVA:"
		Xlsheet.cells(xFila+1,6).font.name="Arial"
		Xlsheet.cells(xFila+1,6).font.bold=.T.
		Xlsheet.cells(xFila+1,6).font.size=10
		XLSheet.Cells(xFila+1,6).HorizontalAlignment=-4152
		Xlsheet.cells(xFila+1,7)=cur_conpres.cond_desc
		Xlsheet.cells(xFila+1,7).font.name="Arial"
		Xlsheet.cells(xFila+1,7).font.size=10
		XLSheet.Cells(xFila+1,7).HorizontalAlignment=-4131
		Xlsheet.cells(xFila+2,6)="Tel/Fax:"
		Xlsheet.cells(xFila+2,6).font.name="Arial"
		Xlsheet.cells(xFila+2,6).font.bold=.T.
		Xlsheet.cells(xFila+2,6).font.size=10
		XLSheet.Cells(xFila+2,6).HorizontalAlignment=-4152
		Xlsheet.cells(xFila+2,7)="0"+ALLT(cur_conpres.cli_cartel)+"-"+ALLT(cur_conpres.cli_tel1)
		Xlsheet.cells(xFila+2,7).font.name="Arial"
		Xlsheet.cells(xFila+2,7).font.size=10
		XLSheet.Cells(xFila+2,7).HorizontalAlignment=-4131
		Xlsheet.cells(xFila+3,2)="           Ref:"
		Xlsheet.cells(xFila+3,2).font.name="Arial"
		Xlsheet.cells(xFila+3,2).font.bold=.T.
		Xlsheet.cells(xFila+3,2).font.size=10
		Xlsheet.cells(xFila+3,3)=cur_conpres.presup_ref
		Xlsheet.cells(xFila+3,3).font.name="Arial"
		Xlsheet.cells(xFila+3,3).font.size=10
		XLSheet.Cells(xFila+3,3).HorizontalAlignment=-4131
		Xlsheet.cells(xFila+3,7)="0"+ALLT(cur_conpres.cli_cartel)+"-"+ALLT(cur_conpres.cli_tel2)
		Xlsheet.cells(xFila+3,7).font.name="Arial"
		Xlsheet.cells(xFila+3,7).font.size=10
		XLSheet.Cells(xFila+3,7).HorizontalAlignment=-4131
		
		xFila = xFila + 4
		XLSheet.Rows(xFila).RowHeight = 10
		xFila = xFila + 1
		XLSheet.Rows(xFila).RowHeight = 20
		xini = "A"+ALLTRIM(STR(xFila))
		xfin = "H"+ALLTRIM(STR(xFila))
		rango= '"'+xini+':'+xfin+'"'
		**** DOBLE BORDE**************
		XLSheet.range(&rango).Borders(3).LineStyle = -4119
		XLSheet.range(&rango).Borders(3).ColorIndex = -4105
		XLSheet.range(&rango).Borders(3).TintAndShade = 0
		XLSheet.range(&rango).Borders(3).Weight = 4
		**** FIN DOBLE BORDE***********
		**** DOBLE BORDE**************
		XLSheet.range(&rango).Borders(4).LineStyle = -4119
		XLSheet.range(&rango).Borders(4).ColorIndex = -4105
		XLSheet.range(&rango).Borders(4).TintAndShade = 0
		XLSheet.range(&rango).Borders(4).Weight = 4
		**** FIN DOBLE BORDE***********
		XLSheet.Cells(xFila,1)="Item"
		XLSheet.Cells(xFila,2)="Cant"
		XLSheet.Cells(xFila,3)="Med"
		XLSheet.Cells(xFila,4)="Código"
		XLSheet.Cells(xFila,5)="Descripción"
		XLSheet.Cells(xFila,6)="%IVA"
		XLSheet.Cells(xFila,7)="Pr.Unit."
		XLSheet.Cells(xFila,8)="Pr.Total"
		XLSheet.range(&rango).font.name="Courier New"
		XLSheet.range(&rango).font.size=10
		XLSheet.range(&rango).font.bold=.T.
		XLSheet.range(&rango).HorizontalAlignment=-4108
		XLSheet.range(&rango).VerticalAlignment=-4108
		
		return
	ENDPROC

	PROCEDURE excelfooter
		LPARAMETERS xFila
		
		xini = "A"+ALLTRIM(STR(xFila))
		xfin = "H"+ALLTRIM(STR(xFila))
		rango= '"'+xini+':'+xfin+'"'
		XLSheet.range(&rango).Borders(3).LineStyle = 1
		XLSheet.range(&rango).Borders(3).Weight = 2
		
		XLSheet.cells(xFila,7)="Subtotal"
		XLSheet.cells(xFila+1,7)="Dto % "+str(cur_conpres.presup_dto,7,2)
		XLSheet.cells(xFila+2,7)="Gravado"
		XLSheet.cells(xFila+3,7)="Iva RI "+allt(str(impiva1,10,2))+"%"
		XLSheet.cells(xFila+4,7)="Iva RNI "+allt(str(impiva2,10,2))+"%"
		XLSheet.cells(xFila+5,7)="Total"
		xini = "G"+ALLTRIM(STR(xFila))
		xfin = "G"+ALLTRIM(STR(xFila+5))
		rango= '"'+xini+':'+xfin+'"'
		XLSheet.range(&rango).font.name="Courier New"
		XLSheet.range(&rango).font.size=9
		XLSheet.range(&rango).font.bold=.T.
		XLSheet.range(&rango).HorizontalAlignment=-4131
		XLSheet.cells(xFila,8)=thisform.text8.Value
		XLSheet.cells(xFila+1,8)=thisform.text17.Value
		XLSheet.cells(xFila+2,8)=thisform.text18.Value
		XLSheet.cells(xFila+3,8)=thisform.text9.Value
		XLSheet.cells(xFila+4,8)=thisform.text11.Value
		XLSheet.cells(xFila+5,8)=thisform.text10.Value
		xini = "H"+ALLTRIM(STR(xFila))
		xfin = "H"+ALLTRIM(STR(xFila+5))
		rango= '"'+xini+':'+xfin+'"'
		XLSheet.range(&rango).font.name="Arial"
		XLSheet.range(&rango).font.size=9
		XLSheet.range(&rango).NUMBERFORMAT=IIF(cur_conpres.moneda='D',"_-[$USD] * #,##0.00",IIF(cur_conpres.moneda='P',"_-[$$-es-AR] * #,##0.00","#,##0.00"))
		XLSheet.range(&rango).HorizontalAlignment=-4152
		xFila = xFila + 6
		xini = "A"+ALLTRIM(STR(xFila))
		xfin = "H"+ALLTRIM(STR(xFila))
		rango= '"'+xini+':'+xfin+'"'
		**** DOBLE BORDE**************
		XLSheet.range(&rango).Borders(3).LineStyle = -4119
		XLSheet.range(&rango).Borders(3).ColorIndex = -4105
		XLSheet.range(&rango).Borders(3).TintAndShade = 0
		XLSheet.range(&rango).Borders(3).Weight = 4
		
		RETURN
		
	ENDPROC

	PROCEDURE grid_dblclick
		** ActiveX Control Event 
		local x,y,dtopie,ivaencol,xmone,opcion2,xutilact,xcostoact,xcotiz,xprbajo
		STORE 0 TO xutilact,xcostoact
		xmone = ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
		xcotiz= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,thisform.xcotiz,thisform.ctn_moneda.chk_pesos.Value=1,thisform.txt_cotiz.Value)
		
		ivaencol=0
		if RECCOUNT((thisform.xcurarpres))>0
			SELECT (thisform.xcurarpres)
			aux= ALLTRIM(item)
			dato1= art_codi
			dato2= ALLTRIM(artpres_cant)
			dato3= ALLTRIM(art_desc)
			dato4= ALLTRIM(STR(artpres_precio,15,3))
			prtot= ALLTRIM(STR(prtotal,15,3))
			dato5= ALLTRIM(art_med)
			_screen.alteralta=dato5
			auxiva=0
			auximpo=0
			frmaltapr= conectar_db(_screen.cn)
				SQLEXEC(frmaltapr,"select * from articulos where art_codi=?dato1;","cur_arti")
			desconectar_db(frmaltapr)
			impiva1=thisform.impiva1
			impiva2=thisform.impiva2
			opcion2=0
			do form modippreg with cond,opcion,opcion2,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		ENDIF
		if borra=6
		*!*		thisform.estadodel=.T.
			SET POINT TO ","
			with thisform
				SELECT (thisform.xcurarpres)
				xregis = nro_regis
				do case
					case iva=thisform.impiva1
						ivaencol=1
					case iva=thisform.impiva2
						ivaencol=2
				endcase
				thisform.acu=thisform.acu-prtotal
		
				DELETE FROM (thisform.xcurarpres) WHERE nro_regis =  xregis
				
				SELECT (thisform.xcurarpres)
				LOCATE
				xit=1
				xreg=1
				SCAN
					REPLACE nro_regis WITH xreg
					IF alternativa<>"S"
						REPLACE item with ALLTRIM(STR(xit))
						xit = xit + 1
					ENDIF
					xreg=xreg+1
				ENDSC
				LOCATE FOR nro_regis = xregis
				thisform.text8.value=thisform.acu
				if thisform.text19.value>0
					dtopie=round((100-thisform.text19.value)/100,2)
					thisform.text17.value=thisform.acu*dtopie
					thisform.text18.value=thisform.acu-thisform.text17.value
					do case
						case ivaencol=1
							thisform.impo1=thisform.impo1-(ConverNro(prtot)*dtopie)
							if cond=2
								thisform.text9.value=thisform.text9.value-round((ConverNro(prtot)*dtopie)*thisform.impiva1/100,2)
							else
								auxacuneto=thisform.acun1
								thisform.acun1=thisform.acun1-((ConverNro(prtot)*dtopie)/(1+(thisform.impiva1/100)))
								thisform.acu1=thisform.acu1-(auxacuneto-thisform.acun1)*thisform.impiva1/100
							endif
						case ivaencol=2
							thisform.impo2=thisform.impo2-(ConverNro(prtot)*dtopie)
							if cond=2
								thisform.text11.value=thisform.text11.value-round((ConverNro(prtot)*dtopie)*thisform.impiva2/100,2)
							else
								auxacuneto=thisform.acun2
								thisform.acun2=thisform.acun2-((ConverNro(prtot)*dtopie)/(1+(thisform.impiva2/100)))
								thisform.acu2=thisform.acu2-(auxacuneto-thisform.acun2)*thisform.impiva2/100
							endif
					endcase
				else
					thisform.text18.value=thisform.acu
					do case
						case ivaencol=1
							thisform.impo1=thisform.impo1-ConverNro(prtot)
							if cond=2				
								thisform.text9.value=thisform.text9.value-round(ConverNro(prtot)*thisform.impiva1/100,2)
							else
								auxacuneto=thisform.acun1
								thisform.acun1=thisform.acun1-(ConverNro(prtot)/(1+(thisform.impiva1/100)))
								thisform.acu1=thisform.acu1-(auxacuneto-thisform.acun1)*thisform.impiva1/100
							endif
						case ivaencol=2
							thisform.impo2=thisform.impo2-ConverNro(prtot)
							if cond=2
								thisform.text11.value=thisform.text11.value-round(ConverNro(prtot)*thisform.impiva2/100,2)
							else
								auxacuneto=thisform.acun2
								thisform.acun2=thisform.acun2-(ConverNro(prtot)/(1+(thisform.impiva2/100)))
								thisform.acu2=thisform.acu2-(auxacuneto-thisform.acun2)*thisform.impiva2/100
							endif
					endcase
				endif
				thisform.text10.value=thisform.text18.value+thisform.text9.value+thisform.text11.value
				
		*!*			LOCATE
		*!*			GO xregis
				thisform.calcutilidad(2)
				thisform.grd_detalle.Refresh
			ENDWITH
			_screen.alteralta=""
			borra=0
			insertar=0
			preg=0
			SET POINT TO
		endif
		if insertar=1 and codigo<>0
			SET POINT TO ","
			SET DECIMALS TO 3
			with thisform
				SELECT (thisform.xcurarpres)
				xregis= nro_regis
				frmaltapr= conectar_db(_screen.cn)
					SQLEXEC(frmaltapr,"select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmaltapr)
				**************************** COMIENZA CALCULO UTILIDAD Y COSTO ACTUAL ***********************************
				IF codigo>5
					xprbajo= ROUND((ConverNro(pruni)*thisform.xdolarbajo)/_screen.dolarpres,3)
					frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr, "call usp_calcutil(?codigo,?xprbajo,?xmone,?xcotiz,?cond,?impiva1,?impiva2,?cur_arti.art_alicuota);","cur_utiln")
						SQLEXEC(frmaltapr, "call usp_ctoutil(?codigo,?xmone,?DATE(),?xcotiz);","cur_cton")
					desconectar_db(frmaltapr)
					IF RECCOUNT("cur_utiln") > 0
						SELECT IIF(ISNULL(util),0,util) FROM cur_utiln INTO ARRAY ar_utiln
						cerrar_cursor("cur_utiln")
					ENDIF
					xutilact=IIF(TYPE("ar_utiln")="N",ar_utiln[1],0)
					IF RECCOUNT("cur_cton") > 0
						SELECT IIF(ISNULL(costo),0,costo) FROM cur_cton INTO ARRAY ar_cton
						cerrar_cursor("cur_cton")
					ENDIF
					xcostoact=IIF(TYPE("ar_cton")="N",ar_cton[1],0)
				ELSE
					STORE 0 TO xutilact,xcostoact
				ENDIF	
				***************************** FIN CALCULO UTILIDAD Y COSTO ACTUAL **************************************
				do case
					case opcion=1
						cant=SPACE(15-LEN(ALLTRIM(cant)))+ALLTRIM(cant)
						SELECT (thisform.xcurarpres)
		*!*					GO IIF(thisform.estadodel=.T.,xregis+1,xregis)
						LOCATE FOR nro_regis = xregis
						INSERT before blank
						REPLACE item           WITH '0'
						REPLACE artpres_cant   WITH cant
						REPLACE art_med        WITH cur_arti.art_med
						REPLACE art_codi       WITH cur_arti.art_codi
						REPLACE art_desc       WITH IIF(codigo<=5,ALLTRIM(descrip),ALLTRIM(descri))
						REPLACE artpres_precio WITH ConverNro(pruni)
						REPLACE prtotal        WITH ConverNro(prtot)
						REPLACE iva            WITH IIF(cur_arti.art_alicuota=1,impiva1,impiva2)
						REPLACE util           WITH xutilact
						REPLACE costo          WITH xcostoact
						REPLACE alicuo         WITH cur_arti.art_alicuota
						REPLACE alternativa    WITH ''
						REPLACE cond_codi      WITH cond
						REPLACE presup_dto     WITH thisform.text19.Value
						REPLACE nro_regis      WITH 0
						thisform.acu=thisform.acu+ConverNro(prtot)
						STORE 0 TO muestro,opcion
						localiz=1
					case opcion=2
						SELECT (thisform.xcurarpres)
		*!*					GO IIF(thisform.estadodel=.T.,xregis+1,xregis)
						LOCATE FOR nro_regis = xregis
						INSERT after blank
						REPLACE item           WITH ''
						REPLACE artpres_cant   WITH ''
						REPLACE art_med        WITH 'ALT'
						REPLACE art_codi       WITH cur_arti.art_codi
						REPLACE art_desc       WITH IIF(codigo<=5,ALLTRIM(descrip),ALLTRIM(descri))
						REPLACE artpres_precio WITH ConverNro(pruni)
						REPLACE prtotal        WITH 0
						REPLACE iva            WITH 0
						REPLACE util           WITH xutilact
						REPLACE costo          WITH xcostoact
						REPLACE alicuo         WITH cur_arti.art_alicuota
						REPLACE alternativa    WITH 'S'
						REPLACE cond_codi      WITH cond
						REPLACE presup_dto     WITH thisform.text19.Value
						REPLACE nro_regis      WITH 0				
						alternati="N"
						STORE 0 TO muestro,localiz,opcion
						xregis = xregis + 1
				ENDCASE
				SELECT (thisform.xcurarpres)
				LOCATE
				xregini=1
				xitini =1
				SCAN
					REPLACE nro_regis WITH xregini
					xregini = xregini + 1
					IF alternativa<>"S"
						REPLACE item WITH ALLTRIM(STR(xitini))
						xitini = xitini + 1
					ENDIF                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
				ENDSCAN
				LOCATE FOR nro_regis = xregis
				thisform.calcutilidad(2)
				thisform.grd_detalle.Refresh
				insertar=0
				_screen.alteralta=""
				thisform.estadodel=.F.
			ENDWITH
			SET POINT TO
			SET DECIMALS TO
		endif
	ENDPROC

	PROCEDURE grid_rightclick
		LOCAL lcShortcut, loRef
		m.loRef = this
		m.lcShortcut = SYS(2015)
		
		DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Ver Descripción Completa]
		
		ON SELECTION BAR 1 OF (m.lcShortcut) m.loRef.Grid_ShowDesc()
		*!*	SET MARK OF BAR 1 OF (m.lcShortcut) TO m.loRef.lExpanded
		
		
		ACTIVATE POPUP (m.lcShortcut)
		RELEASE POPUP (m.lcShortcut)
		
	ENDPROC

	PROCEDURE grid_showdesc
		
		IF USED((thisform.xcurarpres))
			IF VARTYPE(thisform.shp_datos)="U"
				SELECT (thisform.xcurarpres)
				thisform.AddObject("shp_datos","shape")
				WITH thisform.shp_datos
					.left    = 105
					.top     = 275
					.width   = 574
					.height  = 173
					.backcolor = RGB(140, 165, 176)
					.SpecialEffect = 0
					.Visible = .T.
				ENDWITH
					
				THISFORM. ADDOBJECT("edt_datos","EDITBOX")
				WITH THISform.edt_datos
					.left    = 117
					.top     = 288
					.width   = 550
					.height  = 125
					.disabledbackcolor = RGB(40,44,52)
					.forecolor = RGB(244,210,50)
					.fontsize  = 10
					.fontbold  = .T.
					.readonly  = .T.
					.value     = ALLTRIM(art_desc)
					.themes    = .F.
					.Visible   = .T.
				ENDWITH
				
				thisform.AddObject("cmd_datos","Commandbutton")
				WITH thisform.cmd_datos
					.left      = 333
					.top       = 416
					.width     = 108
					.height    = 27
					.themes    = .F.
					.forecolor = RGB(255,255,255)
					.backcolor = RGB(227,68,34)
					.alignment = 2
					.caption   = "\<Cerrar Ventana"
					.Visible   = .T.
					=BINDEVENT(ThisForm.cmd_datos, "Click", ThisForm, "datos_click")
					=BINDEVENT(ThisForm.cmd_datos, "MouseMove", ThisForm, "datos_mmove")
					=BINDEVENT(ThisForm.cmd_datos, "MouseLeave", ThisForm, "datos_mleave")
				ENDWITH
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS xmoneda
		
		public cond,elimi,aux,descrip,muestro,insertar,validez,plazo,condpag,lugent,observ,cantreg, ;
			   postal,locali,provi,impiva1,impiva2,codiva,opcion,dato1,dato2,dato3,dato4,cant,descri, ;
			   pruni,prtot,opcion,borra,alternati,localiz,ivaant,ivaact,iva,codp,codigo,nitem, ;
		  	   buscar,paso,acu,longdes,impo1,impo2,acu1,acu2,acun1,acun2,auxiva,auximpo,auxali
		set deleted on
		set date british
		set cent on
		
		_screen.xopvta="PR"
		
		thisform.xcurarpres = SYS(2015)
		
		STORE 0 TO longdes,paso,thisform.acu,elimi,localiz,aux,muestro,insertar,cantreg,borra,thisform.nitem,codigo,dato1, ;
				   thisform.txt_cotiz.Value
		
		STORE "" TO validez,plazo,condpag,lugent,observ,descrip,prtot,pruni
		alternati="N"
		buscar=1
		STORE 0 TO thisform.impo1,thisform.impo2,thisform.acu1,thisform.acu2,thisform.acun1,thisform.acun2,auxiva,auximpo,auxali
		thisform.valorcadena=valorcadena
		thisform.text13.value=date()
		
		STORE 0 TO this.text19.value,this.text8.value,this.text9.value,this.text10.value,this.text11.value,this.text17.value,this.text18.value
		
		CREATE CURSOR (thisform.xcurarpres)(item           C(5), ;
			  								artpres_cant   C(15), ;
								 			art_med        C(3), ;
											art_codi       N(8), ;
								 			art_desc       M, ;
								 			artpres_precio N(15,3), ;
											prtotal        N(15,3), ;
											iva            N(5,3), ;
											util           N(15,3), ;
											costo          N(15,3), ;
											alicuo         N(1), ;
											alternativa    C(1), ;
											cond_codi      N(8), ;
											presup_dto     N(10,2), ;
											nro_regis      N(5))
		
		thisform.grd_detalle.RecordSource=(thisform.xcurarpres)
		thisform.grd_detalle.column5.ControlSource="(art_desc)"
		thisform.grd_detalle.COLUMN9.DynamicBackColor='RGB(85,88,106)'
		thisform.grd_detalle.COLUMN9.DynamicForeColor='RGB(242,243,249)'
		
		frmaltapr= conectar_db(_screen.cn)
			SQLEXEC(frmaltapr,"select param_impo from parametros where param_codi=11;","cur_rjdolar")
			SQLEXEC(frmaltapr,"select param_impo from parametros where param_codi = 14;","cur_dolar")
			SQLEXEC(frmaltapr,"select param_impo from parametros where param_codi=12;","cur_utpre")
			SQLEXEC(frmaltapr,"select * from iva order by iva_codi desc limit 1;","cur_ivap")
		desconectar_db(frmaltapr)
		thisform.txt_cotiz.Value= cur_dolar.param_impo
		_screen.dolarpres=cur_dolar.param_impo
		
		LOCAL xdolar,xreaj
		
		xdolar=cur_dolar.param_impo
		xreaj =(100-cur_rjdolar.param_impo)/100
		thisform.xdolarbajo= xdolar*xreaj
		
		thisform.ctn_utilact.txt_utilact.Value=_screen.utilidad
		** ROUND((((1*xdolar*(1+(_screen.utilidad/100)))/(xdolar*xreaj))-1)*100,3)
		
		_screen.utilidad=ROUND((((1*xdolar*(1+(_screen.utilidad/100)))/thisform.xdolarbajo)-1)*100,3)
		** thisform.ctn_utilact.txt_utilact.Value
		
		codiva=cur_ivap.iva_codi
		thisform.xcotiz =cur_dolar.param_impo
		thisform.impiva1=cur_ivap.iva_1
		thisform.impiva2=cur_ivap.iva_2
		thisform.label12.caption=allt(str(thisform.impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(thisform.impiva2,10,2))+"%"
		
		do form cliload with thisform.codicli
		
		thisform.codicli=cur_clie.cli_codi
		with thisform
			.text1.value=cur_clie.cli_nomb
			.text2.value=cur_clie.cli_domi
			.text3.value=postal
			.text4.value=locali
			.text5.value=provi
			.text6.value=cur_clie.cond_desc
			.text12.value=VAL(cur_clie.cli_cuit)
		ENDWITH
		
		cond=cur_clie.cond_codi
		
		DO case
			CASE UPPER(xmoneda) = 'D'
				thisform.ctn_moneda.chk_dolares.Value = 1
				_screen.monepres='D'
			CASE UPPER(xmoneda) = 'P'
				thisform.ctn_moneda.chk_pesos.Value=1
				thisform.ctn_moneda.Top=1
				thisform.lbl_cotiz.Visible= .T.
				thisform.txt_cotiz.Visible= .T.	
				_screen.monepres='P'
		ENDCASE
		
		FOR ncol=1 TO 9
			xsource="Thisform.grd_detalle.column"+ALLTRIM(STR(ncol))+".text1"
			BINDEVENT(&xsource,"DblClick",Thisform,"Grid_DblClick")
			BINDEVENT(&xsource,"RightClick",Thisform,"Grid_RightClick")
		NEXT ncol
		
		
		
	ENDPROC

	PROCEDURE Load
		set skip of bar 2 of Altas .T.
	ENDPROC

	PROCEDURE pesifica_dolariza
		LPARAMETERS xopcmon
		
		SET POINT TO ","
		with thisform
			LOCAL ivaencol,xmone,xcotiz
			STORE 0 TO thisform.acu,auxiva,auximpo,auxali
			STORE 0 TO thisform.impo1, ;
					   thisform.impo2, ;
					   thisform.acu1, ;
					   thisform.acu2, ;
					   thisform.acun1, ;
					   thisform.acun2
			STORE 0 TO .text8.value, ;
				       .text9.value, ;
			           .text10.value, ;
			           .text11.value, ;
			           .text17.value, ;
			           .text18.value
		
			xcotiz= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,thisform.xcotiz,thisform.ctn_moneda.chk_pesos.Value=1,thisform.txt_cotiz.Value)
			SELECT (thisform.xcurarpres)
			LOCATE
			SCAN
				valor1=ConverNro(artpres_cant)
				valor2=ROUND(ICASE(xopcmon=1,artpres_precio/xcotiz,xopcmon=2,artpres_precio*xcotiz),3)
				REPLACE artpres_precio WITH valor2
				xtotal = (valor1*valor2)
				REPLACE prtotal WITH xtotal
				**************************** COMIENZA CALCULO UTILIDAD Y COSTO ACTUAL ***********************************
				xmone = ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
				xarti = art_codi
				frmaltapr= conectar_db(_screen.cn)
					xprbajo= ROUND((valor2*thisform.xdolarbajo)/thisform.xcotiz,3)
					xalicuo=alicuo
					SQLEXEC(frmaltapr, "call usp_calcutil(?xarti,?xprbajo,?xmone,?xcotiz,?cond,?impiva1,?impiva2,?xalicuo);","cur_utiln")
					SQLEXEC(frmaltapr, "call usp_ctoutil(?xarti,?xmone,?DATE(),?xcotiz);","cur_cton")
				desconectar_db(frmaltapr)
				IF RECCOUNT("cur_utiln") > 0
					SELECT IIF(ISNULL(util),0,util) FROM cur_utiln INTO ARRAY ar_utiln
					cerrar_cursor("cur_utiln")
				ENDIF
				IF RECCOUNT("cur_cton") > 0
					SELECT IIF(ISNULL(costo),0,costo) FROM cur_cton INTO ARRAY ar_cton
					cerrar_cursor("cur_cton")
				ENDIF		
				***************************** FIN CALCULO UTILIDAD Y COSTO ACTUAL **************************************
				SELECT (thisform.xcurarpres)
				REPLACE util WITH ar_utiln[1]
				REPLACE costo WITH ar_cton[1]
				thisform.acu=thisform.acu+xtotal
				********************COMIENZA CALCULO DE IVA*********************
				IF ALLTRIM(art_med)<>"ALT"
					.text8.value=thisform.acu
					.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
					.text18.value=.text8.value-.text17.value
					do case
						case iva=thisform.impiva1
							ivaencol=1
						case iva=thisform.impiva2
							ivaencol=2
					ENDCASE
					if .text19.value>0
						do case
							case ivaencol=1
								if cond=2
									thisform.impo1=thisform.impo1+(xtotal*((100-.text19.value)/100))
									if auxali=2
										.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
									endif
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								else
									thisform.acun1=thisform.acun1+round(((xtotal*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
									if auxali=2
										thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
									endif
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
							case ivaencol=2
								if cond=2
									thisform.impo2=thisform.impo2+(xtotal*((100-.text19.value)/100))
									if auxali=1
										.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
									endif
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								else
									thisform.acun2=thisform.acun2+round(((xtotal*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
									if auxali=1
										thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
									endif
									thisform.acu2=round((acun2*thisform.impiva2)/100,2)
								endif
						endcase
					else
						do case
							case ivaencol=1
								if cond=2
									thisform.impo1=thisform.impo1+xtotal
									if auxali=2
										.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
									endif
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								else
									thisform.acun1=thisform.acun1+round((xtotal/(1+(thisform.impiva1/100))),3)
									if auxali=2
										thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
									endif
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
							case ivaencol=2
								if cond=2
									thisform.impo2=thisform.impo2+xtotal
									if auxali=1
										.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
									endif
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								else
									thisform.acun2=thisform.acun2+round((xtotal/(1+(thisform.impiva2/100))),3)
									if auxali=1
										thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
									endif
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
						endcase
					endif
					.text10.value=.text18.value+.text9.value+.text11.value
					thisform.calcutilidad(2)
					thisform.grd_detalle.Refresh
				ENDIF
			ENDSCAN
			if paso>0
				paso=0
			endif
		ENDWITH
		SET POINT TO
		
	ENDPROC

	PROCEDURE btn_deta.Click
		IF LEN(ALLTRIM(cur_clie.cli_deta)) > 0
			MESSAGEBOX(ALLTRIM(cur_clie.cli_deta),64,"Detalles Adicionales del Cliente")
		ELSE
			MESSAGEBOX("No hay detalles ingresados para este cliente",48,"Detalles Adicionales del Cliente")
		ENDIF
		
	ENDPROC

	PROCEDURE Command1.Click
		salir=messagebox("¿Seguro que desea Salir?",4+32+256,"Verifique!!!")
		if salir=6
			thisform.release
		endif
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command2.Click
		DO case
			CASE thisform.nitem=0
				messagebox("Aún no ha ingresado ningún artículo al Presupuesto, imposible Terminar"+chr(13)+ ;
						   "Ingrese algún artículo presionando la tecla INSERT. Si desea salir de la"+chr(13)+ ; 
						   "rutina utilize el botón Salir o presione la tecla ESC",48,"Advertencia")
				RETURN
			CASE thisform.ctn_moneda.chk_dolares.Value = 0 AND thisform.ctn_moneda.chk_pesos.Value = 0
				MESSAGEBOX("Para continuar debe especificar la moneda para el presupuesto.",48,"Aviso del Sistema")
				RETURN
		OTHERWISE
			preg=messagebox("¿Confirma los datos del Presupuesto?",4+32+256,"Alta de Presupuestos")
			if preg=6
				with thisform
					LOCAL xfecha,xref,xdto,xdasc,xarti,xdac,xcant,xprec,xalt,xit,xreg,xmoneda,opcodi,xdd1,xdd2
					STORE "" TO xdd1,xdd2
					xfecha=.text13.value
					xref= ALLTRIM(.text20.value)
					xdto=.text19.value
					xmoneda= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
					IF thisform.npresup=0
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"lock tables presupuestos write;")
							SQLEXEC(frmaltapr,"select cast(presup_codi+1 as DECIMAL(8,0)) as presup_codi from presupuestos order by presup_codi desc limit 1;","cur_nvo")
		*!*					desconectar_db(frmaltapr)
							thisform.npresup=cur_nvo.presup_codi
		*!*					frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"insert into presupuestos values(?thisform.npresup,?xfecha,?thisform.codicli,?xref,?validez,?plazo,?lugent,?condpag,?xdto,?observ,?codiva,?xmoneda,?thisform.xcotiz,?thisform.txt_utipro.value,NULL);")
							SQLEXEC(frmaltapr,"unlock tables;")
						desconectar_db(frmaltapr)
					ELSE
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"select COUNT(*) cant from presupuestos_articulos where presup_codi=?thisform.npresup;","cur_canit")
							SQLEXEC(frmaltapr,"update presupuestos set presup_fech=?xfecha,cli_codi=?thisform.codicli,presup_ref=?xref,presup_ofer=?validez,presup_plent=?plazo,presup_lugent=?lugent,presup_cond=?condpag,presup_dto=?xdto where presup_codi=?thisform.npresup;")
							SQLEXEC(frmaltapr,"update presupuestos set presup_obser=?observ,iva_codi=?codiva,moneda=?xmoneda,cotiz_dolar=?thisform.xcotiz,presup_util=?thisform.txt_utipro.value where presup_codi=?thisform.npresup;")
						desconectar_db(frmaltapr)
						LOCAL dbcant
						SELECT COUNT(*) FROM (thisform.xcurarpres) INTO ARRAY ccantit
						dbcant =VAL(ALLTRIM(cur_canit.cant))
						IF dbcant>ccantit
							frmaltapr= conectar_db(_screen.cn)
								SQLEXEC(frmaltapr,"delete from presupuestos_articulos where presup_codi = ?thisform.npresup and nro_regis > ?ccantit;")
							desconectar_db(frmaltapr)
							cerrar_cursor("cur_canit")
						ENDIF
						RELEASE ccantit, dbcant			
					ENDIF
					SELECT (thisform.xcurarpres)
					LOCATE
					SCAN
						if art_codi<=5
							xdasc=ALLTRIM(art_desc)
						else
							xdasc=""
						endif
						xarti=art_codi
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
						desconectar_db(frmaltapr)
						SELECT (thisform.xcurarpres)
						xdd1=allt(art_desc)
						xdd2=allt(cur_desc.art_desc)
						if xarti>5 AND xdd1<>xdd2 &&allt(cur_arpres.art_desc)<>allt(cur_desc.art_desc)
							frmaltapr= conectar_db(_screen.cn)
								SQLEXEC(frmaltapr,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
							desconectar_db(frmaltapr)
							IF RECCOUNT("cur_artcli")>0
								LOCAL xcadena
								SELECT(thisform.xcurarpres)
								xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+xdd1
		*!*							xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(art_desc)
								frmaltapr= conectar_db(_screen.cn)
									SQLEXEC(frmaltapr,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
								desconectar_db(frmaltapr)
								IF RECCOUNT("cur_ddes")>0
									xdac=cur_ddes.dac_codi
								endif
							endif
						else
							xdac=0
						ENDIF
						SELECT (thisform.xcurarpres)
						SET POINT TO ","
						SET DECIMALS TO 4
						xcant=ConverNro(artpres_cant)			
						xprec=artpres_precio
						SET POINT TO
						SET DECIMALS TO
						
						if allt(art_med)="ALT"
							xalt="S"
							xit=0							
						else
							xalt=""
							xit=val(item)
						ENDIF
						xreg=nro_regis
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"select * from presupuestos_articulos where presup_codi=?thisform.npresup and nro_regis=?xreg;","cur_registro")
							IF RECCOUNT("cur_registro")>0
								SQLEXEC(frmaltapr,"update presupuestos_articulos set art_codi=?xarti,artpres_precio=?xprec,artpres_cant=?xcant,artpres_dasc=?xdasc,alternativa=?xalt,nro_it=?xit,nro_regis=?xreg,alter_iva=0,dac_codi=?xdac where presup_codi=?thisform.npresup and nro_regis=?xreg;")
							ELSE
								SQLEXEC(frmaltapr,"insert into presupuestos_articulos values(?thisform.npresup,?xarti,?xprec,?xcant,?xdasc,?xalt,?xit,?xreg,0,?xdac);")
							ENDIF
						desconectar_db(frmaltapr)
						cerrar_cursor("cur_registro")
						SELECT (thisform.xcurarpres)
					ENDSCAN
					SELECT COUNT(*) FROM (thisform.xcurarpres) INTO ARRAY ccantit
					cantreg=ccantit[1]
					SET POINT TO ","
					ivari=.text9.value
					ivarni=.text11.value
					totalri=.text18.value+.text9.value
					totalrni=.text18.value+.text9.value+.text11.value
					totsiva=.text18.value
					SET POINT TO
				ENDWITH
				SET DECIMALS TO 3
				frmaltapr= conectar_db(_screen.cn)
					LOCAL xcodip
					xcodip=thisform.npresup
					SQLEXEC(frmaltapr,"select a.*,b.*,c.*,d.cond_desc from presupuestos a inner join clientes b on a.cli_codi=b.cli_codi inner join iva c on c.iva_codi=a.iva_codi inner join condiva d on b.cond_codi=d.cond_codi where presup_codi=?xcodip;","cur_conpres")
					SQLEXEC(frmaltapr,"select a.loca_nomb,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on a.provi_codi=c.provi_codi where a.loca_codi=?cur_conpres.loca_codi;","cur_ubicli")
					SQLEXEC(frmaltapr,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dac_desc from presupuestos_articulos a INNER JOIN articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.presup_codi=?xcodip ORDER BY a.nro_regis;","cur_carpres")
				desconectar_db(frmaltapr)
				SET DECIMALS TO
				GO top
				_screen.numepres = thisform.npresup
				opcodi=''
				do form frm_imprimir with opcodi TO xopcodi
				DO case
					CASE xopcodi.prop01='I'
						set point to ","
						report form presupuesto for cur_carpres.presup_codi=thisform.npresup TO PRINTER prompt noconsole
						SET POINT TO
					CASE xopcodi.prop01='E'
						thisform.excelautomatiz()
				ENDCASE
				thisform.release
			endif
		ENDCASE
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command3.Click
		DO case
			CASE thisform.nitem=0
				messagebox("Aún no ha ingresado ningún artículo al Presupuesto, imposible Guardar",48,"Advertencia")
				RETURN
			CASE thisform.ctn_moneda.chk_dolares.Value = 0 AND thisform.ctn_moneda.chk_pesos.Value = 0
				MESSAGEBOX("Para continuar debe especificar la moneda para el presupuesto.",48,"Aviso del Sistema")
				RETURN
		OTHERWISE
			with thisform
				LOCAL xfecha,xref,xdto,xdasc,xarti,xdac,xcant,xprec,xalt,xit,xreg,xmoneda,xdd1,xdd2
				STORE "" TO xdd1,xdd2
				xfecha=.text13.value
				xref= ALLTRIM(.text20.value)
				xdto=.text19.value
				xmoneda= ICASE(thisform.ctn_moneda.chk_dolares.Value=1,'D',thisform.ctn_moneda.chk_pesos.Value=1,'P')
				IF thisform.npresup=0
					frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr,"lock tables presupuestos write;")
						SQLEXEC(frmaltapr,"select cast(presup_codi+1 as DECIMAL(8,0)) as presup_codi from presupuestos order by presup_codi desc limit 1;","cur_nvo")
		*!*				desconectar_db(frmaltapr)
						thisform.npresup=cur_nvo.presup_codi
		*!*				frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr,"insert into presupuestos values(?thisform.npresup,?xfecha,?thisform.codicli,?xref,?validez,?plazo,?lugent,?condpag,?xdto,?observ,?codiva,?xmoneda,?thisform.xcotiz,?thisform.txt_utipro.value,NULL);")
						SQLEXEC(frmaltapr,"unlock tables;")
					desconectar_db(frmaltapr)
				ELSE
					frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr,"select COUNT(*) cant from presupuestos_articulos where presup_codi=?thisform.npresup;","cur_canit")
						SQLEXEC(frmaltapr,"update presupuestos set presup_fech=?xfecha,cli_codi=?thisform.codicli,presup_ref=?xref,presup_ofer=?validez,presup_plent=?plazo,presup_lugent=?lugent,presup_cond=?condpag,presup_dto=?xdto where presup_codi=?thisform.npresup;")
						SQLEXEC(frmaltapr,"update presupuestos set presup_obser=?observ,iva_codi=?codiva,moneda=?xmoneda,cotiz_dolar=?thisform.xcotiz,presup_util=?thisform.txt_utipro.value where presup_codi=?thisform.npresup;")
					desconectar_db(frmaltapr)
					LOCAL dbcant
					SELECT COUNT(*) FROM (thisform.xcurarpres) INTO ARRAY ccantit
					dbcant =VAL(ALLTRIM(cur_canit.cant))
					IF dbcant>ccantit
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"delete from presupuestos_articulos where presup_codi = ?thisform.npresup and nro_regis > ?ccantit;")
						desconectar_db(frmaltapr)
						cerrar_cursor("cur_canit")
					ENDIF
					RELEASE ccantit, dbcant			
				ENDIF
				SELECT (thisform.xcurarpres)
				LOCATE
				SCAN
					if art_codi<=5
						xdasc=ALLTRIM(art_desc)
					else
						xdasc=""
					endif
					xarti=art_codi
					frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
					desconectar_db(frmaltapr)
					SELECT (thisform.xcurarpres)
					xdd1=allt(art_desc)
					xdd2=allt(cur_desc.art_desc)
					if xarti>5 and xdd1<>xdd2
						frmaltapr= conectar_db(_screen.cn)
							SQLEXEC(frmaltapr,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
						desconectar_db(frmaltapr)
						IF RECCOUNT("cur_artcli")>0
							LOCAL xcadena
							SELECT (thisform.xcurarpres)
							xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+xdd1
		*!*						xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(art_desc)
							frmaltapr= conectar_db(_screen.cn)
								SQLEXEC(frmaltapr,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
							desconectar_db(frmaltapr)
							IF RECCOUNT("cur_ddes")>0
								xdac=cur_ddes.dac_codi
							endif
						endif
					ELSE
						xdac=0
					ENDIF
					SELECT (thisform.xcurarpres)
					SET POINT TO ","
					SET DECIMALS TO 4
					xcant=ConverNro(artpres_cant)			
					xprec=artpres_precio
					SET POINT TO
					SET DECIMALS TO
					if allt(art_med)="ALT"
						xalt="S"
						xit=0							
					else
						xalt=""
						xit=val(item)
					ENDIF
					xreg=nro_regis
					frmaltapr= conectar_db(_screen.cn)
						SQLEXEC(frmaltapr,"select * from presupuestos_articulos where presup_codi=?thisform.npresup and nro_regis=?xreg;","cur_registro")
						IF RECCOUNT("cur_registro")>0
							SQLEXEC(frmaltapr,"update presupuestos_articulos set art_codi=?xarti,artpres_precio=?xprec,artpres_cant=?xcant,artpres_dasc=?xdasc,alternativa=?xalt,nro_it=?xit,nro_regis=?xreg,alter_iva=0,dac_codi=?xdac where presup_codi=?thisform.npresup and nro_regis=?xreg;")
						ELSE
							SQLEXEC(frmaltapr,"insert into presupuestos_articulos values(?thisform.npresup,?xarti,?xprec,?xcant,?xdasc,?xalt,?xit,?xreg,0,?xdac);")
						ENDIF
					desconectar_db(frmaltapr)
					cerrar_cursor("cur_registro")
					SELECT (thisform.xcurarpres)
				ENDSCAN		
			ENDWITH
		ENDCASE
		MESSAGEBOX("Los datos fueron guardados corréctamente.",64,"Aviso del Sistema")
	ENDPROC


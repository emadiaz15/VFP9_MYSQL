	PROCEDURE ctn_moneda.chk_dolares.Click
		IF this.Value=1
			LOCAL dbcant
			SELECT COUNT(*) FROM (thisform.xcurarpres) INTO ARRAY ccantit
			IF TYPE("ccantit") = "N"
				IF ccantit[1] > 0
					prmon= MESSAGEBOX("¿Dolariza el total de los ítems del presupuesto?",4+64+256,"Aviso del Sistema")
					IF prmon=6
						thisform.pesifica_dolariza(1)
					ELSE
						MESSAGEBOX("Debe modificar manualmente cada ítem cotizado.",48,"Aviso del Sistema")
					ENDIF
				ENDIF
			ENDIF
			_screen.monepres='D'
			_screen.dolarpres=thisform.txt_cotiz.Value
		ENDIF
		*!*	DO case
			IF this.Value=1 AND this.Parent.chk_pesos.Value=1
				this.Parent.chk_pesos.Value=0
		*!*			frmaltapr= conectar_db(_screen.cn)
		*!*				SQLEXEC(frmaltapr,"select * from condipresup where condp_cod=2;","cur_piep")
		*!*			desconectar_db(frmaltapr)
		*!*			if RECCOUNT("cur_piep")>0
		*!*				validez = cur_piep.condp_val
		*!*				plazo   = cur_piep.condp_pla
		*!*				condpag = cur_piep.condp_pag
		*!*				lugent  = cur_piep.condp_lug
		*!*				observ  = cur_piep.condp_obs
		*!*			ENDIF
				thisform.ctn_moneda.Top=20
				thisform.lbl_cotiz.Visible= .F.
				thisform.txt_cotiz.Visible= .F.
			ENDIF
		*!*		CASE this.Value=1 AND this.Parent.chk_pesos.Value=0
		*!*			frmaltapr= conectar_db(_screen.cn)
		*!*				SQLEXEC(frmaltapr,"select * from condipresup where condp_cod=2;","cur_piep")
		*!*			desconectar_db(frmaltapr)
		*!*			if RECCOUNT("cur_piep")>0
		*!*				validez = cur_piep.condp_val
		*!*				plazo   = cur_piep.condp_pla
		*!*				condpag = cur_piep.condp_pag
		*!*				lugent  = cur_piep.condp_lug
		*!*				observ  = cur_piep.condp_obs
		*!*			ENDIF		
		*!*	ENDCASE
	ENDPROC

	PROCEDURE ctn_moneda.chk_pesos.Click
		IF this.Value = 1
			LOCAL dbcant
			SELECT COUNT(*) FROM (thisform.xcurarpres) INTO ARRAY ccantit
			IF TYPE("ccantit") = "N"
				IF ccantit[1] > 0
					prmon= MESSAGEBOX("¿Pesifica todos los ítems del presupuesto?",4+32+256,"Aviso del Sistema")
					IF prmon=6
						thisform.estapesif=.T.	
					ENDIF
				ENDIF
			ENDIF
		*!*		DO CASE
				IF this.Value=1 AND this.Parent.chk_dolares.Value=1
					this.Parent.chk_dolares.Value=0
				ENDIF
		*!*				frmaltapr= conectar_db(_screen.cn)
		*!*					SQLEXEC(frmaltapr,"select * from condipresup where condp_cod=1;","cur_piep")
		*!*				desconectar_db(frmaltapr)
		*!*				if RECCOUNT("cur_piep")>0
		*!*					validez = cur_piep.condp_val
		*!*					plazo   = cur_piep.condp_pla
		*!*					condpag = cur_piep.condp_pag
		*!*					lugent  = cur_piep.condp_lug
		*!*					observ  = cur_piep.condp_obs
		*!*				ENDIF
		*!*			CASE this.Value=0 AND this.Parent.chk_dolares.Value=0
		*!*				frmaltapr= conectar_db(_screen.cn)
		*!*					SQLEXEC(frmaltapr,"select * from condipresup where condp_cod=1;","cur_piep")
		*!*				desconectar_db(frmaltapr)
		*!*				if RECCOUNT("cur_piep")>0
		*!*					validez = cur_piep.condp_val
		*!*					plazo   = cur_piep.condp_pla
		*!*					condpag = cur_piep.condp_pag
		*!*					lugent  = cur_piep.condp_lug
		*!*					observ  = cur_piep.condp_obs
		*!*				ENDIF	
		*!*		ENDCASE
			_screen.monepres='P'
			this.Parent.chk_dolares.Value=0
			thisform.ctn_moneda.Top=1
			thisform.lbl_cotiz.Visible= .T.
			thisform.txt_cotiz.Visible= .T.
			thisform.txt_cotiz.SetFocus
		ELSE
			thisform.ctn_moneda.Top=20
			thisform.lbl_cotiz.Visible= .F.
			thisform.txt_cotiz.Visible= .F.
		ENDIF
		
	ENDPROC

	PROCEDURE ctn_utilact.cmd_util.Click
		this.Parent.txt_utilact.Style= 0
		this.Parent.txt_utilact.SetFocus	
		
		
	ENDPROC

	PROCEDURE ctn_utilact.txt_utilact.Click
		this.SetFocus
	ENDPROC

	PROCEDURE ctn_utilact.txt_utilact.GotFocus
		thisform.utilitem=this.Value
	ENDPROC

	PROCEDURE ctn_utilact.txt_utilact.LostFocus
		this.Style= 1
	ENDPROC

	PROCEDURE ctn_utilact.txt_utilact.Valid
		IF LASTKEY()=13
			IF this.Value <= 0
				MESSAGEBOX("La utilidad debe ser mayor a cero.",48,"Aviso del Sistema")
				RETURN .F.
			ELSE
				IF this.Value<>thisform.utilitem
					LOCAL xutipro,utmasfor
					_screen.utilidad=ROUND((((1*thisform.xcotiz*(1+(this.value/100)))/thisform.xdolarbajo)-1)*100,3)
					xutipro  = this.Value
					utmasfor = _screen.utilidad
					IF RECCOUNT((thisform.xcurarpres)) > 0
						UPDATE (thisform.xcurarpres) SET artpres_precio=ROUND(((utmasfor/100)+1)*IIF(cond_codi =2,costo,costo*((iva/100)+1)),3), ;
							prtotal= (ROUND(((utmasfor/100)+1)*IIF(cond_codi =2,costo,costo*((iva/100)+1)),3))*ConverNro(artpres_cant), ;
							util=ROUND(((thisform.xdolarbajo*(ROUND(((utmasfor/100)+1)*IIF(cond_codi =2,costo,costo*((iva/100)+1)),3))/ ;
								 IIF(cond_codi =2,costo,costo*((iva/100)+1))/thisform.xcotiz-1)*100),3)
						thisform.calcutilidad(2)
						thisform.calc_totales()
					ENDIF
				ENDIF
				KEYBOARD '{TAB}'+'{TAB}'+'{TAB}'
			ENDIF
		ELSE
			RETURN .F.
			this.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE grd_detalle.Column9.Text1.Click
		this.SetFocus
	ENDPROC

	PROCEDURE grd_detalle.Column9.Text1.GotFocus
		SELECT (thisform.xcurarpres)
		thisform.utilitem=util
	ENDPROC

	PROCEDURE grd_detalle.Column9.Text1.Valid
		IF LASTKEY()=13
			IF this.Value<>thisform.utilitem
				LOCAL xreaj,xreg
				frmaltapr= conectar_db(_screen.cn)
					SQLEXEC(frmaltapr,"select param_impo from parametros where param_codi=11;","cur_rjdolar")			
				desconectar_db(frmaltapr)
				xreaj =(100-cur_rjdolar.param_impo)/100
				SELECT (thisform.xcurarpres)
				xreg= nro_regis
				UPDATE (thisform.xcurarpres) SET artpres_precio = IIF(cond=2,1,((iva/100)+1)) * ((((this.value/100)+1)/xreaj)*costo) ;
					WHERE nro_regis = xreg
				UPDATE (thisform.xcurarpres) SET prtotal = artpres_precio*ConverNro(artpres_cant) ;
					WHERE nro_regis = xreg
				thisform.grd_detalle.Refresh
				thisform.calcutilidad(2)
				thisform.calc_totales()
			ENDIF
		ENDIF
	ENDPROC


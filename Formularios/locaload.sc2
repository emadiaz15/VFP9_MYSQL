		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'txtlocaload' AS textbox WITH ;
		BackColor = 216,216,216, ;
		FontBold = .T., ;
		Format = "!", ;
		Height = 23, ;
		Left = 39, ;
		Name = "txtlocaload", ;
		TabIndex = 1, ;
		Top = 48, ;
		Width = 513
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		public d,localiz
		store 1 to localiz,d
		if last()=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Init
		parameter postal,locali,provi,codloca
		
		frmlocalo= conectar_db(_screen.cn)
			SQLEXEC(frmlocalo,"select c.cp_nro,a.loca_nomb,b.provi_nomb,a.loca_codi,a.cp_codi from localidades a inner join provincias b on a.provi_codi=b.provi_codi inner join codipostales c on c.cp_codi=a.cp_codi order by a.loca_nomb;","cur_llo")
		desconectar_db(frmlocalo)
		
		thisform.lstloca.RowSource="cur_llo"
	ENDPROC

	PROCEDURE Unload
		RETURN postal
		RETURN locali
		RETURN provi
		RETURN codloca
	ENDPROC

	PROCEDURE lstloca.Click
		cp=cur_llo.cp_codi
		locali=cur_llo.loca_nomb
		codloca=cur_llo.loca_codi
		provi=cur_llo.provi_nomb
		postal=cur_llo.cp_nro
		
		thisform.release
	ENDPROC

	PROCEDURE lstloca.GotFocus
		if last()=24 or last()=5
			thisform.txtlocaload.setfocus
		endif
	ENDPROC

	PROCEDURE txtlocaload.InteractiveChange
		local lc
		lc = allt(This.Value)
		if last()<>127 and last()<>7
			do while !eof()
				if lc=subst(cur_llo.loca_nomb,1,len(lc))
					exit
				else
					skip
					d=d+1
					if eof()
						go top
						d=1
						exit
					endif
				endif
			enddo
		else
			do while lc=subst(cur_llo.loca_nomb,1,len(lc)) and d>1
				if bof()
					exit
				endif
				skip-1
				if d>1
					d=d-1
				endif
				if lc<>subst(cur_llo.loca_nomb,1,len(lc))
					skip
					d=d+1
					exit
				endif
			enddo				
		endif
		thisform.lstloca.selected(d)=.T.
		return
		
	ENDPROC

	PROCEDURE txtlocaload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
				cp=cur_llo.cp_codi
				codloca=cur_llo.loca_codi
				locali=cur_llo.loca_nomb
				provi=cur_llo.provi_nomb
				postal=cur_llo.cp_nro
		
				thisform.release
			case last()=5
				if d>1
					d=d-1
					skip-1
				endif
				thisform.lstloca.selected(d)=d
				this.value=thisform.lstloca.value
			case last()=24
				if d<thisform.lstloca.listcount
					d=d+1
					skip
				endif
				thisform.lstloca.selected(d)=d
				this.value=thisform.lstloca.value
			case last()=27
				thisform.release
		endcase
	ENDPROC

ENDDEFINE

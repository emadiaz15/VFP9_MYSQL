		*< END OBJECT: BaseClass="listbox" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackColor = 3,60,122, ;
		BackStyle = 1, ;
		Height = 270, ;
		Left = 13, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;

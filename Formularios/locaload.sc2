	ADD OBJECT 'lstloca' AS listbox WITH ;
		BoundColumn = 2, ;
		ColumnCount = 3, ;
		ColumnWidths = "68,235,201", ;
		FontBold = .T., ;
		Height = 183, ;
		ItemBackColor = 216,216,216, ;
		ItemTips = .T., ;

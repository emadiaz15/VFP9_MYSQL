DEFINE CLASS itemoalter AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Image1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BorderStyle = 0
		Caption = "Presupuestos"
		DoCreate = .T.
		Height = 134
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "ITEMOALTER"
		Width = 305
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Item", ;
		DisabledBackColor = 33,146,214, ;
		ForeColor = 255,255,255, ;
		Height = 25, ;
		Left = 31, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 82, ;
		Width = 109
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command2' AS commandbutton WITH ;
		BackColor = 0,138,124, ;
		Caption = "\<Alternativa", ;
		DisabledBackColor = 0,138,124, ;
		ForeColor = 255,255,255, ;
		Height = 25, ;
		Left = 151, ;
		Name = "Command2", ;
		Themes = .F., ;
		Top = 82, ;
		Width = 121
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Image1' AS image WITH ;
		BorderStyle = 1, ;
		Height = 33, ;
		Left = 54, ;
		Name = "Image1", ;
		Picture = ..\imagen\w95mbx02.ico, ;
		Stretch = 2, ;
		Top = 26, ;
		Width = 33
		*< END OBJECT: BaseClass="image" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		Caption = "¿Qué desea insertar?", ;
		FontSize = 10, ;
		Height = 18, ;
		Left = 110, ;
		Name = "Label1", ;
		Top = 35, ;
		Width = 127
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Activate
		store 1 to localiz
	ENDPROC

	PROCEDURE Init
		parameter cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
	ENDPROC

	PROCEDURE Unload
		return dato1
		return dato2
		return dato3
		return dato4
		return opcion
		return cond
	ENDPROC

	PROCEDURE Command1.Click
		DO case
			CASE (WEXIST("modipresup") AND _screen.altermodi="ALT") OR (WEXIST("altapresup") AND _screen.alteralta="ALT")
				MESSAGEBOX("No puede ingresar un ítem en el lugar ocupado por una alternativa.",48,"Aviso del Sistema")
				STORE 0 TO insertar, codigo
				thisform.release
				RETURN
			OTHERWISE
				opcion=1
				do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
				thisform.release		
		ENDCASE
	ENDPROC

	PROCEDURE Command2.Click
		opcion=2
		do form alternapresup with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		thisform.release
		
	ENDPROC

ENDDEFINE

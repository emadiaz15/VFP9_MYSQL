	PROCEDURE crearcursores
		CREATE CURSOR cheq(recpag_codi N(8)) 
		CREATE CURSOR cur_valores(chequenro C(14),movtippag_fvto D,fechapago D,ban_desc C(45),movtippag_pza C(50),movtippag_imp N(15,2),recpag_codi N(8))
		
		RETURN
		
	ENDPROC

	PROCEDURE Destroy
		SET POINT TO thisform.punto
		SET SEPARATOR TO thisform.separador
	ENDPROC

	PROCEDURE Init
		SET DELETED ON
		
		thisform.punto=SET("POINT")
		thisform.separador=SET("SEPARATOR")
		
		SET POINT TO ","
		SET SEPARATOR TO "."
		
		PUBLIC numero,banco,plaza,fechavto,valor,cuit,valorcheq,rpgcodi,xtipo
		
		thisform.crearcursores()
		
		frmaltadep= conectar_db(_screen.cn)
			SQLEXEC(frmaltadep,"select banc_desc,banc_codi,banc_ncta from bancos_caja order by banc_desc;","cur_bank")
		desconectar_db(frmaltadep)
		
		IF RECCOUNT("cur_bank")>0
			GO top
			thisform.cmb_banco.rowsource="select banc_desc,banc_codi,banc_ncta from cur_bank INTO CURSOR cmb_banco"
			thisform.cmb_banco.SetFocus
			KEYBOARD '{F4}'
			cerrar_cursor("cur_bank")
		ENDIF
		
		thisform.txt_fechadep.Value=DATE()
		
		thisform.txt_nbol.Value='##########'
	ENDPROC

	PROCEDURE Boten_del1.img_del.Click
		
		IF RECCOUNT("cur_valores")>0
			LOCAL xrpg,xval
			xrpg=cur_valores.recpag_codi
			xval=cur_valores.movtippag_imp
			DELETE FROM cheq WHERE recpag_codi = xrpg
			DELETE FROM cur_valores WHERE recpag_codi = xrpg
			thisform.totaldep=thisform.totaldep-xval
		ENDIF
		
		thisform.grd_cheques.RecordSource="cur_valores"
		GO TOP IN cur_valores
		thisform.grd_cheques.Refresh()
		GO BOTTOM IN cur_valores
		thisform.txt_total.Refresh()
		thisform.grd_cheques.SetFocus
		
		LOCAL lcletra
		do monto2letra with thisform.txt_total.value,lcletra in ntoletra
		SELECT COUNT(*) cant FROM cur_valores WHERE NOT DELETED() INTO ARRAY ar_cntc
		
		thisform.lbl_cancheq.Caption=IIF(ar_cntc[1,1]>0,"Cantidad de Cheques Físicos Agregados "+ALLTRIM(STR(ar_cntc[1,1])),"")
		thisform.lbl_totletra.Caption=IIF(thisform.totaldep>0,PROPER(LOWER("SON EN TOTAL: "+ALLTRIM(lcletra))),"")
		
		IF ar_cntc[1,1]>0
			thisform.cmd_guardar.Enabled= .T.
		ELSE
			thisform.cmd_guardar.Enabled= .F.
		ENDIF
		
	ENDPROC

	PROCEDURE Boton_add1.img_add.Click
		_screen.deposito=.T.
		numero=""
		banco=""
		plaza=""
		fechavto=ctod("  /  /    ")
		valor=0
		cuit=0
		valorcheq=thisform.totaldep
		rgpcodi=0
		xtipo=1
		
		do form chequesdisp with numero,banco,plaza,fechavto,valor,cuit,valorcheq,rpgcodi,rpgcodig,xtipo
		
		IF rpgcodi>0
			insert into cheq(recpag_codi) values(rpgcodi)
			INSERT INTO cur_valores values(numero,fechavto,fechavto+30,banco,plaza,valor,rpgcodi)
			thisform.totaldep=thisform.totaldep+valor
		ENDIF
		
		thisform.grd_cheques.RecordSource="cur_valores"
		GO TOP IN cur_valores
		thisform.grd_cheques.Refresh()
		GO BOTTOM IN cur_valores
		thisform.txt_total.Refresh()
		thisform.grd_cheques.SetFocus
		
		LOCAL lcletra
		do monto2letra with thisform.txt_total.value,lcletra in ntoletra
		
		SELECT COUNT(*) cant FROM cur_valores WHERE NOT DELETED() INTO ARRAY ar_cntc
		
		thisform.lbl_cancheq.Caption=IIF(ar_cntc[1,1]>0,"Cantidad de Cheques Físicos Agregados "+ALLTRIM(STR(ar_cntc[1,1])),"")
		thisform.lbl_totletra.Caption=IIF(thisform.totaldep>0,PROPER(LOWER("SON EN TOTAL: "+ALLTRIM(lcletra))),"")
		
		IF ar_cntc[1,1]>0
			thisform.cmd_guardar.Enabled= .T.
		ELSE
			thisform.cmd_guardar.Enabled= .F.
		ENDIF
	ENDPROC

	PROCEDURE cmb_banco.Click
		thisform.etq_seleccion.Visible= .F.
		thisform.codibank=cmb_banco.banc_codi
		STORE "" TO thisform.etq_cuenta.Caption
		IF LEN(ALLTRIM(cmb_banco.banc_ncta))>0
			thisform.etq_cuenta.Caption="Número de Cuenta: "+ALLTRIM(cmb_banco.banc_ncta)
		ENDIF
		KEYBOARD '{TAB}'
	ENDPROC

	PROCEDURE cmd_guardar.Click
		LOCAL xdepo,xboleta,xfechdep,xtotal,xobser,xrpg
		
		xfechdep  = thisform.txt_fechadep.Value
		xtotal    = thisform.totaldep
		xobser    = ALLTRIM(thisform.edt_obser.Value)
		
		
		frmaltadep= conectar_db(_screen.cn)
			SQLEXEC(frmaltadep,"select cast(dep_codi+1 as DECIMAL(8,0)) as dep_codi from depositos order by dep_codi desc limit 1;","cur_nvo")
			IF RECCOUNT("cur_nvo")>0
				xdepo= cur_nvo.dep_codi
			ELSE
				xdepo=1
			ENDIF
			xboleta   = REPLICATE("0",10-LEN(ALLTRIM(STR(xdepo))))+ALLTRIM(STR(xdepo))
			SQLEXEC(frmaltadep,"insert into depositos values(?xdepo,?xfechdep,?xboleta,?xtotal,?thisform.codibank,?xobser,1);")
		desconectar_db(frmaltadep)
		
		SELECT cur_valores
		GO top
		SCAN
			xrpg=cur_valores.recpag_codi
			frmaltadep= conectar_db(_screen.cn)
				SQLEXEC(frmaltadep,"update recibos_pagos set dep_codi = ?xdepo where recpag_codi = ?xrpg;")
			desconectar_db(frmaltadep)
			SELECT cur_valores
		ENDSCAN
		
		thisform.txt_nbol.Value = xboleta
		
		MESSAGEBOX("El depósito en Cuenta Propia fue asentado exitosamente con Boleta Nº: "+xboleta+".-",64,"Aviso del Sistema")
		
		thisform.txt_nbol.Value='##########'
		thisform.txt_fechadep.Value=DATE()
		thisform.txt_total.Value=0
		thisform.edt_obser.Value=''
		thisform.lbl_cancheq.Caption=''
		thisform.lbl_totletra.Caption=''
		thisform.grd_cheques.RecordSource=''
		thisform.grd_cheques.Refresh()
		cerrar_cursor("cheq")
		cerrar_cursor("cur_valores")
		
		thisform.crearcursores()
	ENDPROC

	PROCEDURE cmd_guardar.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE cmd_guardar.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE cmd_salir.Click
		thisform.Release
		
	ENDPROC

	PROCEDURE cmd_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE cmd_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Ctn_banner.Init
		this.Height=130
		this.left=0
		this.Width=this.Parent.Width
	ENDPROC

	PROCEDURE edt_obser.Click
		this.SetFocus
	ENDPROC

	PROCEDURE edt_obser.GotFocus
		CAPSLOCK(.T.)
	ENDPROC

	PROCEDURE edt_obser.LostFocus
		CAPSLOCK(.F.)
	ENDPROC

	PROCEDURE txt_fechadep.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_nbol.Click
		this.SetFocus
	ENDPROC

ENDDEFINE

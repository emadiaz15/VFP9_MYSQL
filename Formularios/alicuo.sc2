DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Check1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Check2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 216,226,207
		BorderStyle = 0
		Caption = "Alícuota IVA"
		DoCreate = .T.
		Height = 189
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "Form1"
		Width = 313
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Check1' AS checkbox WITH ;
		Alignment = 0, ;
		AutoSize = .T., ;
		BackColor = 216,226,207, ;
		Caption = ("IVA "+allt(str(impiva1,10,2))+"%"), ;
		FontBold = .T., ;
		FontSize = 18, ;
		Height = 32, ;
		Left = 76, ;
		Name = "Check1", ;
		Top = 47, ;
		Value = 1, ;
		Width = 22
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'Check2' AS checkbox WITH ;
		Alignment = 0, ;
		AutoSize = .T., ;
		BackColor = 216,226,207, ;
		Caption = ("IVA "+allt(str(impiva2,10,2))+"%"), ;
		FontBold = .T., ;
		FontSize = 18, ;
		Height = 32, ;
		Left = 76, ;
		Name = "Check2", ;
		Top = 85, ;
		Width = 22
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Aceptar", ;
		DisabledBackColor = 33,146,214, ;
		FontSize = 10, ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 84, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 153, ;
		Width = 113
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 216,226,207, ;
		Caption = "Alícuotas Vigentes", ;
		FontBold = .T., ;
		FontSize = 10, ;
		Height = 18, ;
		Left = 52, ;
		Name = "Label1", ;
		Top = 21, ;
		Width = 119
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackStyle = 0, ;
		BorderStyle = 1, ;
		Height = 108, ;
		Left = 39, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;
		Top = 28, ;
		Width = 216
		*< END OBJECT: BaseClass="shape" />
	
	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		parameter aliiva
		
		frmalicuo= conectar_db(_screen.cn)
			SQLEXEC(frmalicuo,"select * from iva order by iva_codi desc limit 1;","cur_iva")
		desconectar_db(frmalicuo)
		impiva1=cur_iva.iva_1
		impiva2=cur_iva.iva_2
	ENDPROC

	PROCEDURE Unload
		return aliiva
	ENDPROC

	PROCEDURE Check1.Click
		if this.value=1
			thisform.check2.value=0
		else
			thisform.check2.value=1
		endif
	ENDPROC

	PROCEDURE Check2.Click
		if this.value=1
			thisform.check1.value=0
		else
			thisform.check1.value=1
		endif
	ENDPROC

	PROCEDURE Command1.Click
		do case
			case thisform.check1.value=1
				aliiva=impiva1
			case thisform.check2.value=1
				aliiva=impiva2
		endcase
		thisform.release
				
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .F.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .T.
		this.FontSize=11
	ENDPROC

ENDDEFINE

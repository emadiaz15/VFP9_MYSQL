	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		PARAMETERS codiper
		public localiz,postal,locali,provi,op,codloca,cp,codp
		localiz=0
		postal=0
		locali=""
		provi=""
		codloca=0
		op=0
		this.text6.Value=0
		this.text12.value=0
		STORE "" TO thisform.lbl_carn.Caption,thisform.lbl_card.Caption
		frmaltap= conectar_db(_screen.cn)
			SQLEXEC(frmaltap,"select provi_nomb,provi_codi from provincias order by provi_nomb;","curprovi")
		desconectar_db(frmaltap)
		this.combo1.RowSourcetype= 2
		this.combo1.RowSource="curprovi"
		
	ENDPROC

	PROCEDURE Unload
		RETURN codiper
	ENDPROC

	PROCEDURE Combo1.Click
		IF LEN(ALLTRIM(this.Value))>0
			KEYBOARD '{TAB}'
		ENDIF
		
	ENDPROC

	PROCEDURE Combo1.GotFocus
		keyboard "{F4}"
	ENDPROC

	PROCEDURE Combo1.LostFocus
		if LEN(ALLTRIM(this.text))>0
			xnompro=ALLTRIM(this.text)
			frmaltap= conectar_db(_screen.cn)
				SQLEXEC(frmaltap,"select * from provincias where TRIM(provi_nomb)=?xnompro;","cur_nuepro")
			desconectar_db(frmaltap)
			if RECCOUNT("cur_nuepro")=0
				frmaltap= conectar_db(_screen.cn)
					SQLEXEC(frmaltap,"select MAX(provi_codi) as provi_codi from provincias order by provi_codi;","cur_codp")
					IF ISNULL(cur_codp.provi_codi)
						pro=1
					ELSE
						pro=cur_codp.provi_codi+1
					ENDIF
					nomnue=ALLTRIM(this.text)
					SQLEXEC(frmaltap,"insert into provincias values(?pro,?nomnue);")
					SQLEXEC(frmaltap,"select provi_nomb,provi_codi from provincias order by provi_nomb;","curprovi")
				desconectar_db(frmaltap)
				this.RowSource = "curprovi"
				this.requery
				this.value=allt(this.text)
				frmaltap= conectar_db(_screen.cn)
					SQLEXEC(frmaltap,"update localidades set provi_codi=?pro where loca_codi=?codloca;")
				desconectar_db(frmaltap)
			else
				pro=cur_nuepro.provi_codi
				frmaltap= conectar_db(_screen.cn)
					SQLEXEC(frmaltap,"update localidades set provi_codi=?pro where loca_codi=?codloca;")
				desconectar_db(frmaltap)		
			endif
		endif
		thisform.command2.enabled=.T.
		thisform.command2.Themes= .F.
	ENDPROC

	PROCEDURE Combo1.When
		IF thisform.estadocp=1
			thisform.estadocp=0
			KEYBOARD '{TAB}'
		ENDIF
		
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command2.Click
		con=messagebox("¿Confirma los datos ingresados?",4+32+256,"Alta de Proveedores")
		if con=6
			with thisform
				do case
					CASE TYPE("codloca") # "N" OR codloca <= 0
					    =MESSAGEBOX("La localidad no quedó correctamente asociada. Verifique Código Postal, Localidad y Provincia.",0+48,"Advertencia")
					    .text6.SetFocus			
					case len(allt(.text1.value))=0
						=messagebox("No ha ingresado el nombre o denominación del Proveedor,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.text1.setfocus
					case .text6.value=0
						=messagebox("No ha ingresado el Código Postal,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.text6.setfocus
					case len(allt(.text3.value))=0
						=messagebox("No ha ingresado la Localidad,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.text3.setfocus
					case len(allt(.combo1.text))=0
						=messagebox("No ha ingresado la Provincia,"+chr(13)+ ;
									"es un dato indispensable para efectuar el alta.",0+48,"Advertencia")
						.combo1.setfocus
					other case
						LOCAL xopcion, ;
							  xcodigo, ;
		                      xnombre, ;
		                      xdomi, ;
							  xcartel, ;
		                      xtel1, ;
		                      xtel2, ;
		                      xcel, ;
		                      xcuit, ;
		                      xemail, ;
		                      xcond, ;
		                      xpercep, ;
		                      xdto, ;
		                      lnLock
		                lnLock  = 0
		    			xopcion = 1
						xcodigo = 0
						xnombre = ALLTRIM(.text1.value)
						xdomi   = ALLTRIM(.text2.value)
						xcartel = VAL(.text11.value)
						xtel1   = VAL(.text7.value)
						xtel2   = VAL(.text10.value)
						xcel    = ALLTRIM(.text8.value)
						xcuit   = VAL(.text5.value)
						xemail  = ALLTRIM(.text9.value)
						xcond   = .optiongroup1.value
						if .check1.value=1
							xpercep = "S"
						else
							xpercep = "N"
						endif
						xdto    = .text12.value
		*!*					MESSAGEBOX("xopcion  ="+ALLTRIM(STR(xopcion))+CHR(13)+;
		*!*				               "xcodigo  ="+ALLTRIM(STR(xcodigo))+CHR(13)+;
		*!*							   "xnombre  ="+xnombre+CHR(13)+;
		*!*					           "xdomi    ="+xdomi+CHR(13)+;
		*!*					           "codloca  ="+ALLTRIM(STR(codloca))+CHR(13)+;
		*!*					           "xcartel  ="+ALLTRIM(STR(xcartel))+CHR(13)+;
		*!*					           "xtel1    ="+ALLTRIM(str(xtel1))+CHR(13)+;
		*!*	    				       "xtel2    ="+ALLTRIM(STR(xtel2))+CHR(13)+;
		*!*					           "xcel     ="+ALLTRIM(xcel)+CHR(13)+;
		*!*					           "xcuit    ="+ALLTRIM(STR(xcuit,11))+CHR(13)+;
		*!*					           "xemail   ="+ALLTRIM(xemail)+CHR(13)+;
		*!*					           "xcond    ="+ALLTRIM(STR(xcond))+CHR(13)+;
		*!*					           "xpercep  ="+xpercep+CHR(13)+;
		*!*					           "xdto     ="+ALLTRIM(STR(xdto,6,2)))
						frmaltap= conectar_db(_screen.cn)
							lnLock = MySQL_LockTables("LOCK", "personas WRITE", frmaltap)
							SQLEXEC(frmaltap,"call usp_guardar_persona(?xopcion,?xcodigo,?xnombre,?xdomi,?codloca,?xcartel,?xtel1,?xtel2,?xcel,?xcuit,?xemail,?xcond,?xpercep,?xdto);")
							lnLock = MySQL_LockTables("UNLOCK", "", frmaltap)
						desconectar_db(frmaltap)
						.SetAll("value", "", "Textbox")
						.combo1.value=""
						this.enabled=.F.
						.text1.setfocus
				endcase
			endwith
		endif
			
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command2.When
		IF VAL(thisform.text5.value)>0 AND thisform.nestadocuit=0
			frmaltac= conectar_db(_screen.cn)
				SQLEXEC(frmaltac,"select * from personas where per_cuit=?VAL(thisform.text5.value);","cur_procui")
			desconectar_db(frmaltac)
			IF RECCOUNT("cur_procui")>0
				IF RECCOUNT("cur_procui")=1
					
					ppcui=MESSAGEBOX("Ya existe en archivo el Proveedor "+ALLTRIM(cur_procui.per_desc)+" con el mismo CUIT."+CHR(13)+CHR(13)+ ;
					      		     "¿Ingresa igualmente el Proveedor con este CUIT?",4+48+256,"Aviso del Sistema")
					IF ppcui=7
						thisform.text5.value=''
						KEYBOARD '{LEFTARROW}'
						RETURN
					ELSE
						thisform.nestadocuit=1
					ENDIF
				ELSE
					DO FORM frmmascuit WITH 3,VAL(thisform.text5.value),sino
					IF sino=0
						thisform.text5.Value=''
						KEYBOARD '{LEFTARROW}'
						RETURN
					ELSE
						thisform.nestadocuit=1
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE lst_prove.Click
		xcuit=SUBSTR(ALLTRIM(per_cuit),1,2)+"-"+SUBSTR(ALLTRIM(per_cuit),3,8)+"-"+SUBSTR(ALLTRIM(per_cuit),11,1)
		MESSAGEBOX("EL CUIT EN ARCHIVO PARA ESTE PROVEEDOR ES: "+xcuit,64,"Informe del Sistema")
	ENDPROC

	PROCEDURE Optiongroup1.Click
		if this.value<>1
			thisform.label9.visible=.T.
			thisform.text5.visible=.T.
			thisform.text5.setfocus
		else
			thisform.label9.visible=.F.
			thisform.text5.visible=.F.
		endif
		
	ENDPROC

	PROCEDURE Text1.InteractiveChange
		IF LEN(ALLTRIM(this.Value))>0
			thisform.lbl_carn.Caption=ALLTRIM(STR(LEN(ALLTRIM(this.Value))))
			IF LEN(ALLTRIM(this.Value))=50
				thisform.lbl_carn.ForeColor= RGB(255,0,0)
			ELSE
				thisform.lbl_carn.ForeColor= RGB(0,0,0)
			ENDIF
			xcadena="%"+ALLTRIM(this.Value)+"%"
			frmaltap= conectar_db(_screen.cn)
				SQLEXEC(frmaltap,"select per_desc,per_cuit from personas where per_desc like ?xcadena order by per_desc;","cur_auxp")
			desconectar_db(frmaltap)
			IF RECCOUNT()>0
				thisform.lst_prove.RowSource="cur_auxp"
				thisform.lst_prove.Visible=.T.
				thisform.lst_prove.ZOrder(0)
			ELSE
				thisform.lst_prove.Visible=.F.
			ENDIF
		ELSE
			thisform.lbl_carn.Caption=""
			thisform.lst_prove.Visible=.F.
		endif
	ENDPROC

	PROCEDURE Text2.InteractiveChange
		IF LEN(ALLTRIM(this.Value)) > 0
			thisform.lbl_card.Caption=ALLTRIM(STR(LEN(ALLTRIM(this.Value))))
			IF LEN(ALLTRIM(this.Value))=50
				thisform.lbl_card.ForeColor= RGB(255,0,0)
			ELSE
				thisform.lbl_card.ForeColor= RGB(0,0,0)
			ENDIF
		ELSE
			thisform.lbl_card.Caption=""
		ENDIF
		
	ENDPROC

	PROCEDURE Text3.GotFocus
		if op=7
			thisform.text6.value=0
			thisform.text6.setfocus
		endif
	ENDPROC

	PROCEDURE Text3.LostFocus
		LOCAL xprovic
		xprovic=0
		if LEN(ALLTRIM(this.value))>0
			xnomloc=ALLTRIM(this.Value)
			frmaltac= conectar_db(_screen.cn)
				SQLEXEC(frmaltac,"select * from localidades where TRIM(loca_nomb)=?xnomloc;","cur_nueloc")
			desconectar_db(frmaltac)
			if RECCOUNT("cur_nueloc")=0
				frmaltac= conectar_db(_screen.cn)
					SQLEXEC(frmaltac,"select MAX(loca_codi) as loca_codi from localidades order by loca_codi;","cur_codl")
					IF ISNULL(cur_codl.loca_codi)
						loc=1
					ELSE
						loc=cur_codl.loca_codi+1
					ENDIF
					nomnue=ALLTRIM(this.Value)
					IF thisform.estadocp=1
						xprovic=curprovi.provi_codi
					ENDIF
					SQLEXEC(frmaltac,"insert into localidades values(?loc,?nomnue,?xprovic,?cp,0);")
				desconectar_db(frmaltac)
				codloca=loc
			else
				if cur_nueloc.cp_codi<>codp
					frmaltac= conectar_db(_screen.cn)
						SQLEXEC(frmaltac,"select MAX(loca_codi) as loca_codi from localidades order by loca_codi;","cur_codl")
						IF ISNULL(cur_codl.loca_codi)
							loc=1
						ELSE
							loc=cur_codl.loca_codi+1
						ENDIF
						nomnue=ALLTRIM(this.Value)
						IF thisform.estadocp=1
							xprovic=curprovi.provi_codi
						ENDIF				
						SQLEXEC(frmaltac,"insert into localidades values(?loc,?nomnue,0,?codp,0);")
					desconectar_db(frmaltac)		
					codloca=loc
				ELSE
					codloca = cur_nueloc.loca_codi
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Text3.Valid
		*!*	if LEN(ALLTRIM(this.value))=0 and last()<>-4
		*!*		messagebox("Recuerde que debe ingresar la Localidad",0+48,"Advertencia!!!")
		*!*	endif
	ENDPROC

	PROCEDURE Text5.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text5.GotFocus
		thisform.cuitaux=VAL(this.value)
	ENDPROC

	PROCEDURE Text5.LostFocus
		IF VAL(this.Value)<>thisform.cuitaux
			thisform.nestadocuit=0
		ENDIF
		thisform.command2.setfocus
	ENDPROC

	PROCEDURE Text6.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE Text6.GotFocus
		thisform.lbl_aviso.Visible=.T.
		
		
	ENDPROC

	PROCEDURE Text6.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = -4
			do form locaload with postal,locali,provi,codloca
			if postal>0
				with thisform
					this.value=postal
					.text3.value=locali
					.combo1.value=provi
					thisform.command2.enabled=.T.
					thisform.command2.Themes= .F.
					thisform.lbl_aviso.Visible=.F.
					.text11.setfocus
				ENDWITH
			ELSE
				this.setfocus
			ENDIF
		endif
	ENDPROC

	PROCEDURE Text6.LostFocus
		IF this.Value>0
			frmaltac= conectar_db(_screen.cn)
				SQLEXEC(frmaltac,"select * from codipostales where cp_nro=?this.value;","cur_cpn")
			desconectar_db(frmaltac)
			if RECCOUNT()>0
				codp=cur_cpn.cp_codi
				cp=codp
				frmaltac= conectar_db(_screen.cn)
					SQLEXEC(frmaltac,"select a.*,b.provi_nomb from localidades a inner join provincias b on a.provi_codi=b.provi_codi where a.cp_codi=?codp;","cur_lcp")
				desconectar_db(frmaltac)
				IF RECCOUNT("cur_lcp")>0
					if RECCOUNT("cur_lcp")>1
						do form locamismocp with codp,codloca,locali,provi
						if codloca>0
							thisform.text3.value=locali
							thisform.combo1.value=provi
							thisform.text11.setfocus
							thisform.command2.enabled=.T.
							thisform.command2.Themes= .F.
						ELSE
							thisform.estadocp=1
							thisform.combo1.value=provi
							thisform.text3.SetFocus
						ENDIF
						thisform.lbl_aviso.Visible= .F.
					else
						con=messagebox("Solo existe en archivo la Localidad "+allt(cur_lcp.loca_nomb)+chr(13)+ ;
									   "de la Provincia de "+allt(cur_lcp.provi_nomb)+" con éste Código Postal "+chr(13)+;
									   "¿Ingresa otra Localidad con el mismo Código? ",4+32+256,"Localidades")
						do case
							case con=6
								thisform.estadocp=1
								thisform.combo1.value=cur_lcp.provi_nomb
								this.value=ALLT(str(cur_cpn.cp_nro))
								thisform.text3.setfocus
							case con=7
								thisform.text3.value=cur_lcp.loca_nomb
								thisform.combo1.value=cur_lcp.provi_nomb
								codloca=cur_lcp.loca_codi
								thisform.command2.enabled=.T.
								thisform.command2.Themes= .F.
								thisform.text11.setfocus
						ENDCASE
						thisform.lbl_aviso.Visible= .F.
					ENDIF
		*!*				thisform.lbl_aviso.Visible= .F.
		*!*				thisform.combo2.setfocus
		*!*				keyboard "{F4}"
				endif
			else
				op=messagebox("Ud. ha ingresado un nuevo Código Postal"+chr(13)+ ;
							  "¿Confirma el código ingresado?",4+32+256,"Códigos Postales")
				if op=6
					frmaltac= conectar_db(_screen.cn)
						SQLEXEC(frmaltac,"select MAX(cp_codi) as cp_codi from codipostales order by cp_codi;","cur_maxc")
						IF ISNULL(cur_maxc.cp_codi)
							cp=1
						ELSE
							cp=cur_maxc.cp_codi+1
						ENDIF
						codp=cp
						SQLEXEC(frmaltac,"insert into codipostales values(?codp,?this.value);")
					desconectar_db(frmaltac)
					thisform.lbl_aviso.Visible= .F.
				endif
			endif
		endif
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="1" />

	*<PropValue>
		DataSource = .NULL.
		Height = 419
		InitialSelectedAlias = "proveedores"
		Left = 1
		Name = "Dataenvironment"
		Top = 220
		Width = 792
	*</PropValue>

ENDDEFINE

	PROCEDURE Text19.LostFocus
		with thisform
			dtotot=acu*this.value/100
			.text17.value=str(dtotot,10,2)
			.text18.value=str(acu-dtotot,10,2)
			if cond=2
				dife=acu-dtotot
				auxiva=dife*impiva1/100
				.text9.value=str(auxiva,10,2)
			endif
			.text10.value=CAST(str(ConverNro(.text18.value)+ConverNro(.text9.value)+ConverNro(.text11.value),15,3) as numeric(15,3))
		endwith
		
		
	ENDPROC

	PROCEDURE Text7.Click
		this.setfocus
	ENDPROC

ENDDEFINE


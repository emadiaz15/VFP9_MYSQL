	PROCEDURE Activate
		local dfac
		if localiz=1
			with thisform
				if .text19.value>0
					dfac=round((100-.text19.value)/100,3)
					.text8.value=round((cur_confac.fac_ng+cur_confac.neto_1+cur_confac.neto_2)/dfac,2)
					.text17.value=round((.text8.value*.text19.value)/100,2)
				else
					.text8.value=cur_confac.fac_ng+cur_confac.neto_1+cur_confac.neto_2
				endif
				.text18.value=cur_confac.fac_ng+cur_confac.neto_1+cur_confac.neto_2
				.text9.value=cur_confac.fac_ivari
				.text11.value=cur_confac.fac_ivarni
				.text10.value=CAST(ConverNro(str(.text18.value+.text9.value+.text11.value,15,2)) as numeric(15,2))
			endwith
		endif
		store 0 to localiz
	ENDPROC

	PROCEDURE buscar_compasoc
		LPARAMETERS _xCodf
		
		LOCAL xpto,xfac,xtip,xcadeb,xtex,xnump,xpedtex
		***************************************BUSCA PEDIDO*********************************************
		IF thisform.xcodp>0
			frmconsfac= conectar_db(_screen.cn)
				SQLEXEC(frmconsfac,"select * from pedidos where ped_codi= ?thisform.xcodp;","cur_ped")
			desconectar_db(frmconsfac)
			IF RECCOUNT("cur_ped") > 0
				xnump  = IIF(cur_ped.notaped_nro>0 , cur_ped.notaped_nro, cur_ped.ped_codi)
				xpedtex= IIF(cur_ped.notaped_nro>0 , 'NPED_', 'PED_')
				xcade  = REPLICATE("0",8-LEN(ALLTRIM(STR(xnump ))))+ALLTRIM(STR(xnump ))
				INSERT INTO (thisform.xcurcomp) values(ALLTRIM(xpedtex+'0000'+'-'+xcade),'PED',cur_ped.ped_codi)
			ENDIF
		ENDIF
		
		cerrar_cursor("cur_ped")
		************************************************************************************************
		***************************************BUSCA REMITOS********************************************
		frmconsfac= conectar_db(_screen.cn)
			SQLEXEC(frmconsfac,"call usp_loadrem(?_xCodf);","cur_remi")
		desconectar_db(frmconsfac)
		
		IF RECCOUNT("cur_remi") > 0
			LOCATE
			SCAN
				xcade1 = REPLICATE("0",4-LEN(ALLTRIM(STR(cur_remi.rem_pto))))+ALLTRIM(STR(cur_remi.rem_pto))
				xcade2 = REPLICATE("0",8-LEN(ALLTRIM(STR(cur_remi.rem_nro))))+ALLTRIM(STR(cur_remi.rem_nro))
				INSERT INTO (thisform.xcurcomp) values(ALLTRIM('REM_'+xcade1+'-'+xcade2),'REM',cur_remi.rem_codi)		
			ENDSCAN
		ENDIF
		
		cerrar_cursor("cur_remi")
		************************************************************************************************
		******************************BUSCA CPBTE ASOC POR FAC / NC / ND********************************
		frmconsfac= conectar_db(_screen.cn)
			SQLEXEC(frmconsfac,"select * from facturas where fac_codi = ?_xCodf;","cur_lcomp")
		desconectar_db(frmconsfac)
		
		IF RECCOUNT("cur_lcomp") > 0
			LOCATE
			xtip   = ALLTRIM(cur_lcomp.fac_tipo)
			xpto   = ALLTRIM(STR(cur_lcomp.fac_pto))
			IF cur_lcomp.fac_compas > 0
				xfac = ALLTRIM(STR(cur_lcomp.fac_compas))
			ELSE
				xfac = ALLTRIM(STR(cur_lcomp.fac_nro))
			ENDIF
			xcadeb =  xtip + xpto + xfac
			frmconsfac= conectar_db(_screen.cn)
				IF cur_lcomp.fac_compas > 0
					SQLEXEC(frmconsfac,"select * from facturas where concat(TRIM(fac_tipo),TRIM(CAST(fac_pto as char)),TRIM(CAST(fac_nro as char))) = ?xcadeb;","cur_factu")
				ELSE
					SQLEXEC(frmconsfac,"select * from facturas where concat(TRIM(fac_tipo),TRIM(CAST(fac_pto as char)),TRIM(CAST(fac_compas as char))) = ?xcadeb;","cur_factu")
				ENDIF
			desconectar_db(frmconsfac)
			IF RECCOUNT("cur_factu") > 0
				LOCATE
				SCAN
					xcade1 = REPLICATE("0",4-LEN(ALLTRIM(STR(cur_factu.fac_pto))))+ALLTRIM(STR(cur_factu.fac_pto))
					xcade2 = REPLICATE("0",8-LEN(ALLTRIM(STR(cur_factu.fac_nro))))+ALLTRIM(STR(cur_factu.fac_nro))
					xtex = ICASE(cur_factu.fac_conc='F','FAC',cur_factu.fac_conc='N','NC',cur_factu.fac_conc='D','ND')
					INSERT INTO (thisform.xcurcomp) values(ALLTRIM(xtex+'_'+xcade1+'-'+xcade2),xtex,cur_factu.fac_codi)
				ENDSCAN
			ENDIF
		ENDIF
		
		cerrar_cursor("cur_lcomp")
		cerrar_cursor("cur_factu")
		************************************************************************************************
		****************************************BUSCA RECIBOS*******************************************
		frmconsfac= conectar_db(_screen.cn)
			SQLEXEC(frmconsfac,"select b.* from recibos_facturas a inner join recibos b on a.rec_codi = b.rec_codi where a.fac_codi=?_xCodf order by b.rec_codi;","cur_reci")
		desconectar_db(frmconsfac)
		
		IF RECCOUNT("cur_reci") > 0
			LOCATE
			SCAN
				xcade1 = REPLICATE("0",4-LEN(ALLTRIM(STR(cur_reci.rec_tipo))))+ALLTRIM(STR(cur_reci.rec_tipo))
				xcade2 = REPLICATE("0",8-LEN(ALLTRIM(STR(cur_reci.rec_nro))))+ALLTRIM(STR(cur_reci.rec_nro))
				INSERT INTO (thisform.xcurcomp) values(ALLTRIM('REC'+'_'+xcade1+'-'+xcade2),'REC',cur_reci.rec_codi)
			ENDSCAN	
		ENDIF
		
		cerrar_cursor("cur_reci")
		************************************************************************************************
		SELECT (thisform.xcurcomp)
		LOCATE
		
		thisform.comp_asoc.cmb_comp.RowSource = (thisform.xcurcomp)
		thisform.comp_asoc.cmb_comp.value = cpbte
	ENDPROC


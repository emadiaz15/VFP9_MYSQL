	PROCEDURE Comp_asoc.btn_buscar.img_buscar.Click
		SELECT (thisform.xcurcomp)
		
		DO CASE
			CASE tipcbte = "FAC" OR tipcbte = "NC" OR tipcbte = "ND"
				pasfac=1
				Ej_Consfac(codbus, thisform.ncondcli)
			CASE tipcbte = "REM"
				pasrem=1
				DO FORM consremito WITH codbus,cond
			CASE tipcbte = "PED"
				DO FORM conspedicli WITH codbus,cond
			CASE tipcbte = "REC"
				SELECT * FROM cur_nomcli INTO CURSOR cur_clie
				SELECT (thisform.xcurcomp)
				DO FORM consrecibo WITH codbus,cond
		ENDCASE
		
	ENDPROC


	PROCEDURE grid_showdesc
		
		IF USED("cur_facart")
			IF VARTYPE(thisform.shp_datos)="U"
				thisform.AddObject("shp_datos","shape")
				WITH thisform.shp_datos
					.left    = 105
					.top     = 275
					.width   = 574
					.height  = 173
					.backcolor = RGB(140, 165, 176)
					.SpecialEffect = 0
					.Visible = .T.
				ENDWITH
					
				THISFORM. ADDOBJECT("edt_datos","EDITBOX")
				WITH THISform.edt_datos
					.left    = 117
					.top     = 288
					.width   = 550
					.height  = 125
					.disabledbackcolor = RGB(40,44,52)
					.forecolor = RGB(244,210,50)
					.fontsize  = 10
					.fontbold  = .T.
					.readonly  = .T.
					.value     = ALLTRIM(cur_facart.artfac_desc)
					.themes    = .F.
					.Visible   = .T.
				ENDWITH
				
				thisform.AddObject("cmd_datos","Commandbutton")
				WITH thisform.cmd_datos
					.left      = 333
					.top       = 416
					.width     = 108
					.height    = 27
					.themes    = .F.
					.forecolor = RGB(255,255,255)
					.backcolor = RGB(227,68,34)
					.alignment = 2
					.caption   = "\<Cerrar Ventana"
					.Visible   = .T.
					=BINDEVENT(ThisForm.cmd_datos, "Click", ThisForm, "datos_click")
					=BINDEVENT(ThisForm.cmd_datos, "MouseMove", ThisForm, "datos_mmove")
					=BINDEVENT(ThisForm.cmd_datos, "MouseLeave", ThisForm, "datos_mleave")
				ENDWITH
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		parameter codifac,ncond
		this.ncondcli=ncond
		public elimi,descrip,postal,locali,provi,nrofac,nrorem, ;
			   impiva1,impiva2,codiva,transporte,coditran,auxcond, ;
			   rta,articulo,localiz,acu
		set dele on
		SET DATE BRITISH
		SET CENTURY on
		SET POINT TO ","
		SET SEPARATOR TO "."
		LOCAL xvend,xporc
		STORE 0 TO coditran,paso,acu,elimi,localiz,muestro,opcion,insertar,borra,codigo,x,nrofac,nrorem,rta,xvend
		STORE "" TO descrip,texto
		
		thisform.xcurcomp = SYS(2015)
		
		CREATE CURSOR (thisform.xcurcomp)(cpbte C(20),tipcbte C(3),codbus N(10))
		
		frmconsfac= conectar_db(_screen.cn)
			SQLEXEC(frmconsfac,"select a.*,b.iva_1,b.iva_2 from facturas as a inner join iva as b on a.iva_codi=b.iva_codi where a.fac_codi=?codifac;","cur_confac")
		desconectar_db(frmconsfac)
		if empty(cur_confac.fac_pie)
			this.command3.enabled=.F.
		else
			this.command3.enabled=.T.
		endif
		if empty(cur_confac.nc_texto)
			this.command4.enabled=.F.
		else
			this.command4.enabled=.T.
		ENDIF
		IF cur_confac.cotiz_dolar>0
			thisform.xdolar=cur_confac.cotiz_dolar
			thisform.btn_money.Visible= .T.
		ENDIF
		this.xcodicli=cur_confac.cli_codi
		this.xcodp   =cur_confac.ped_codi
		this.text13.value=cur_confac.fac_fec
		this.text7.value=repl("0",4-len(allt(str(cur_confac.fac_pto))))+allt(str(cur_confac.fac_pto))+"-"+repl("0",8-len(allt(str(cur_confac.fac_nro))))+allt(str(cur_confac.fac_nro))
		frmconsfac= conectar_db(_screen.cn)
			SQLEXEC(frmconsfac,"select rem_codi,rem_pto,rem_nro from remitos where fac_codi=?codifac;","cur_rem")
		desconectar_db(frmconsfac)
		if pasfac=1
			this.command1.visible=.F.
		endif
		this.label20.caption=allt(cur_confac.cae)
		if len(allt(cur_confac.cae))>0 and cur_confac.anulado<>"S"
			this.command6.enabled=.T.
		endif
		nrofac=cur_confac.fac_nro
		this.text19.value=cur_confac.fac_dto
		if cur_confac.anulado="S"
			this.label14.visible=.T.
		endif
		do case
			case cur_confac.fac_conc="F"
				thisform.optiongroup2.value=1
			case cur_confac.fac_conc="N"
				thisform.optiongroup2.value=2
			case cur_confac.fac_conc="D"
				thisform.optiongroup2.value=3
		endcase
		nrorem=cur_rem.rem_nro
		codiva=cur_confac.iva_codi
		impiva1=cur_confac.iva_1
		impiva2=cur_confac.iva_2
		thisform.label12.caption=allt(str(impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(impiva2,10,2))+"%"
		frmconsfac= conectar_db(_screen.cn)
			SQLEXEC(frmconsfac,"call usp_buscarcli(?cur_confac.cli_codi);","cur_nomcli")
		desconectar_db(frmconsfac)
		with thisform
			.text1.value=cur_nomcli.cli_nomb
			.text2.value=cur_nomcli.cli_domi
			.text3.value=cur_nomcli.cp_nro
			.text4.value=cur_nomcli.loca_nomb
			.text5.value=cur_nomcli.provi_nomb
			.text6.value=cur_nomcli.cond_desc
			.text12.value=SUBSTR(ALLTRIM(cur_nomcli.cli_cuit),1,2)+"-"+SUBSTR(ALLTRIM(cur_nomcli.cli_cuit),3,8)+"-"+SUBST(ALLTRIM(cur_nomcli.cli_cuit),11,1)
			.text15.value="0"+allt(cur_nomcli.cli_cartel)+"-"+allt(cur_nomcli.cli_tel1)
		endwith					
		cond=cur_nomcli.cond_codi
		if cond<>2
			thisform.label10.visible=.F.
			thisform.text12.visible=.F.
			thisform.optiongroup1.value=2
		endif
		auxcond=cond
		IF cur_confac.ven_codi>0
			xvend=cur_confac.ven_codi
			frmconsfac= conectar_db(_screen.cn)
				SQLEXEC(frmconsfac,"select * from vendedores where ven_codi = ?xvend;","cur_vendcf")
			desconectar_db(frmconsfac)
			IF RECCOUNT("cur_vendcf") > 0
				thisform.ctn_vendedor.lbl_vend.Caption=ALLTRIM(cur_vendcf.ven_nomb)
			ENDIF
			IF cur_confac.otra_comi > 0
				thisform.ctn_vendedor.lbl_comi.Caption=ALLTRIM(STR(cur_confac.otra_comi))+"%"
			ELSE
				IF cur_confac.porc_codi>0
					xporc = cur_confac.porc_codi
					frmconsfac= conectar_db(_screen.cn)
						SQLEXEC(frmconsfac,"select * from porcencomi where porc_codi = ?xporc;","cur_porcf")
					desconectar_db(frmconsfac)
					IF RECCOUNT("cur_porcf") > 0
						thisform.ctn_vendedor.lbl_comi.Caption='"'+ALLTRIM(cur_porcf.porc_desc)+'"'+' '+ALLTRIM(STR(cur_porcf.porc_impo,8,3))+'%'
					ENDIF
				ENDIF
			ENDIF
			IF USED("cur_vendcf")
				cerrar_cursor("cur_vendcf")
			ENDIF
			IF USED("cur_porcf")
				cerrar_cursor("cur_porcf")
			ENDIF
		ENDIF
		SET DECIMALS TO 3
		frmconsfac= conectar_db(_screen.cn)
			SQLEXEC(frmconsfac,"call usp_facnum(?codifac);","cur_facart")
		desconectar_db(frmconsfac)
		SET DECIMALS TO
		GO TOP
		thisform.grd_articulos.RecordSource="cur_facart"
		thisform.grd_articulos.column5.ControlSource="(artfac_desc)"
		
		thisform.buscar_compasoc(codifac)
		SELECT cur_facart
		
		=BINDEVENT(ThisForm.grd_articulos, "RightClick", ThisForm, "Grid_RightClick")
		localiz=1
		
	ENDPROC


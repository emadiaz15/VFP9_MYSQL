		Top = 64, ;
		Width = 96
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text2' AS textbox WITH ;
		Alignment = 1, ;
		Format = "K", ;
		Height = 23, ;
		InputMask = "#######.##", ;
		Left = 124, ;
		Name = "Text2", ;
		TabIndex = 1, ;
		Top = 64, ;
		Width = 71
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text3' AS textbox WITH ;
		Format = "K", ;
		Height = 23, ;
		Left = 201, ;
		Name = "Text3", ;
		ReadOnly = .T., ;
		TabIndex = 5, ;
		Top = 64, ;
		Width = 298
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text4' AS textbox WITH ;
		Format = "K", ;
		Height = 23, ;
		InputMask = "######.###", ;
		Left = 504, ;
		Name = "Text4", ;
		TabIndex = 2, ;
		Top = 64, ;
		Width = 84
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text5' AS textbox WITH ;
		Height = 23, ;
		InputMask = "#######.##", ;
		Left = 595, ;
		Name = "Text5", ;
		ReadOnly = .T., ;
		TabIndex = 6, ;
		Top = 64, ;
		Width = 81
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		parameter articulo,cantidad,descripcion,precio
		with this
			.text1.value=articulo
			.text2.value=cantidad
			.text3.value=allt(descripcion)
			.text4.value=precio
			.text5.value=cantidad*precio
		endwith
	ENDPROC

	PROCEDURE Unload
		return cantidad
		return precio
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			do case
				case .text2.value=0 and .text4.value=0
					preg=messagebox("Ud. a optado por continuar con cantidad y precio 0 para este"+chr(13)+ ;
									"artículo."+chr(13)+ ;
									"¿Continúa igualmente?",4+48+256,"Advertencia!!!")
					if preg=7
						.text2.setfocus
					else
						thisform.release
					endif
				case .text2.value=0 and .text4.value>0
					preg=messagebox("Ud. a optado por continuar con cantidad 0 para este"+chr(13)+ ;
									"artículo."+chr(13)+ ;
									"¿Continúa igualmente?",4+48+256,"Advertencia!!!")
					if preg=7
						.text2.setfocus
					else
						thisform.release
					endif
				case .text2.value>0 and .text4.value=0
					preg=messagebox("Ud. a optado por continuar con precio 0 para este"+chr(13)+ ;
									"artículo."+chr(13)+ ;
									"¿Continúa igualmente?",4+48+256,"Advertencia!!!")
					if preg=7
						.text4.setfocus
					else
						thisform.release
					endif
			other case
				cantidad=.text2.value
				precio=.text4.value
				thisform.release
			endcase
		endwith
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text3.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Text3.LostFocus
		capslock(.F.)
		this.readonly=.T.
		thisform.text4.setfocus
	ENDPROC

	PROCEDURE Text4.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text4.LostFocus
		with thisform
			.text5.value=.text2.value*this.value
		endwith
	ENDPROC

ENDDEFINE

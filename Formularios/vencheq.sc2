	PROCEDURE Init
		local xfecdes,xfechas
		xfecdes=DATE()
		xfechas=xfecdes+1
		
		concheqv= conectar_db(_screen.cn)
			SQLEXEC(concheqv,"call usp_vencecheq(?xfecdes,?xfechas);","auxcheq")
		desconectar_db(concheqv)
		
		with thisform
			.grid1.SetAll("DynamicForeColor", "IIF(auxcheq.fecha=DATE(), RGB(225,0,113) ,RGB(0,128,0))", "Column")
			.grid1.recordsourcetype=1
			.grid1.recordsource="auxcheq"
		endwith
		
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Grid1.DblClick
		LOCAL xcheque
		
		xcheque=auxcheq.chequenro
		
		DO FORM conscheqrap WITH xcheque
	ENDPROC

	PROCEDURE Text1.GotFocus
		thisform.grid1.HighlightStyle=1
	ENDPROC

	PROCEDURE Text1.LostFocus
		thisform.grid1.HighlightStyle=0
	ENDPROC

ENDDEFINE

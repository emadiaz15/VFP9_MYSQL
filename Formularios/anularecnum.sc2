		TabIndex = 8, ;
		Top = 177, ;
		Visible = .F., ;
		Width = 124
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETERS xcodirec
		
		SET NOTIFY off
		
		IF xcodirec = 0
			STORE 0 TO thisformset.frmprincipal.txt_cbtes.Value,thisformset.frmprincipal.txt_dtosaf.Value, ;
					   thisformset.frmprincipal.txt_totpag.value,thisformset.frmprincipal.txt_antic.value, ;
					   thisformset.frmprincipal.txt_cod.value,thisformset.frmprincipal.txt_npag.value
		
		else
			STORE 0 TO thisformset.frmprincipal.txt_cbtes.Value,thisformset.frmprincipal.txt_dtosaf.Value, ;
				   thisformset.frmprincipal.txt_totpag.Value,thisformset.frmprincipal.txt_antic.Value
			LOCAL pnro
			pnro=xcodirec
			frmnpag= conectar_db(_screen.cn)
				SQLEXEC(frmnpag,"select a.*,b.cli_nomb,b.cond_codi from recibos a inner join clientes b on a.cli_codi = b.cli_codi where a.rec_codi = ?pnro;","cur_recanu")
			desconectar_db(frmnpag)
			thisformset.frmprincipal.txt_cliente.Value=ALLTRIM(STR(cur_recanu.cli_codi))+" - "+ALLTRIM(cur_recanu.cli_nomb)
			thisformset.codirec                       =cur_recanu.rec_codi
			thisformset.cond                          =cur_recanu.cond_codi
			thisformset.xcodicli                      =cur_recanu.prov_codi
			thisformset.frmprincipal.txt_cod .value   =cur_recanu.rec_tipo
			thisformset.frmprincipal.txt_npag.value   =cur_recanu.rec_nro
			thisformset.frmprincipal.txt_fecha.Value  =cur_recanu.rec_fec
			thisformset.frmprincipal.txt_cbtes.Value  =cur_recanu.rec_impo+cur_recanu.rec_dtosaf
			thisformset.frmprincipal.txt_dtosaf.Value =cur_recanu.rec_dtosaf
			thisformset.frmprincipal.txt_antic.Value  =cur_recanu.rec_antic
			thisformset.frmprincipal.txt_totpag.Value =thisformset.frmprincipal.txt_cbtes.Value+thisformset.frmprincipal.txt_dtosaf.Value+thisformset.frmprincipal.txt_antic.Value
					
			thisformset.verocultar(.T.)
			thisformset.frmprincipal.txt_cod.Style = 1
			thisformset.frmprincipal.txt_npag.Style= 1
			
			thisformset.frmprincipal.btn_cont.Enabled= .T.
		*!*		KEYBOARD '{TAB}'
		ENDIF
		
	ENDPROC

	PROCEDURE revisarpagos
		LPARAMETERS xcodirec
		
		frmnpag= conectar_db(_screen.cn)
			SQLEXEC(frmnpag,"select * from recibos_pagos where rec_codi = ?xcodirec order by recpag_codi;","cur_recpag")
		desconectar_db(frmnpag)
		
		IF RECCOUNT("cur_recpag")>0
			SELECT COUNT(*) cant FROM cur_recpag WHERE pag_codi > 0 INTO ARRAY ar_entreg
			IF TYPE("ar_entreg")="N"
				IF ar_entreg[1]>0
					MESSAGEBOX("Hay valores entregados a Proveedores."+CHR(13)+CHR(13)+ ;
						       "Para anular este recibo debe anular las Ordenes de Pago a Proveedores a quienes hayan sido entregados."+CHR(13)+CHR(13)+ ;
					           "Haga Click en Aceptar para ver el detalle.",48,"Aviso del Sistema")
					frmnpag= conectar_db(_screen.cn)
						SQLEXEC(frmnpag,"call usp_detavalent(?thisformset.codirec);","cur_detaval")
					desconectar_db(frmnpag)
					IF RECCOUNT("cur_detaval")>0
						GO TOP IN cur_detaval
						thisformset.frmdetalle.grd_deta.RecordSource="cur_detaval"
						thisformset.frmdetalle.grd_deta.column2.DynamicAlignment = 2
						thisformset.frmdetalle.grd_deta.column3.DynamicInputMask = [('$999,999,999.99')]
						thisformset.frmprincipal.AlwaysOnBottom= .T.
						thisformset.frmprincipal.Visible= .F.
						thisformset.frmdetalle.Visible= .T.
						thisformset.frmdetalle.btn_retornar.SetFocus
					ENDIF
					thisformset.estadoanula=.F.
				ELSE
					thisformset.estadoanula=.T.
				ENDIF
			ENDIF
		ELSE
			thisformset.estadoanula=.T.
		ENDIF
		
		RETURN
		
		
	ENDPROC

	PROCEDURE verocultar
		LPARAMETERS xboolsel
		
		
		STORE xboolsel TO thisformset.frmprincipal.lbl_fec.Visible, ;
					      thisformset.frmprincipal.txt_fecha.Visible, ;
					      thisformset.frmprincipal.lbl_cbtes.Visible, ;
					      thisformset.frmprincipal.txt_cbtes.Visible, ;
					      thisformset.frmprincipal.lbl_dtosaf.Visible, ;
					      thisformset.frmprincipal.txt_dtosaf.Visible, ;
		 		          thisformset.frmprincipal.lbl_antic.Visible, ;
		 		          thisformset.frmprincipal.txt_antic.Visible, ;
		 		          thisformset.frmprincipal.lbl_totpag.Visible, ;
		 		          thisformset.frmprincipal.txt_totpag.Visible, ;
		 		          thisformset.frmprincipal.line3.Visible, ;
					      thisformset.frmprincipal.btn_verpag.Visible
	ENDPROC

	PROCEDURE frmdetalle.btn_retornar.Click
		
		thisformset.frmdetalle.Visible= .F.
		thisformset.frmprincipal.AlwaysOnBottom= .F.
		thisformset.frmprincipal.Visible= .T.
		
	ENDPROC

	PROCEDURE frmdetalle.btn_retornar.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE frmdetalle.btn_retornar.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE frmprincipal.btn_cancel.Click
		
		thisformset.Release
		
	ENDPROC

	PROCEDURE frmprincipal.btn_cancel.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE frmprincipal.btn_cancel.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE frmprincipal.btn_cont.Click
		thisformset.frmdetalle.grd_deta.RecordSource=''
		thisformset.frmdetalle.grd_deta.Refresh()
		thisformset.revisarpagos(thisformset.codirec)
		
		IF thisformset.estadoanula=.T.
			pranu=MESSAGEBOX("¿Confirma anular el Recibo?",4+48,"Aviso del Sistema")
		
			IF pranu=6
				frmnpag= conectar_db(_screen.cn)
					SQLEXEC(frmnpag,"update clientes set cli_saldo = cli_saldo + ?thisformset.frmprincipal.txt_cbtes.value where cli_codi = ?thisformset.xcodicli;")
					SQLEXEC(frmnpag,"update clientes set cli_favor = cli_favor + ?thisformset.frmprincipal.txt_dtosaf.value where cli_codi = ?thisformset.xcodicli;")
					SQLEXEC(frmnpag,"update clientes set cli_favor = cli_favor - ?thisformset.frmprincipal.txt_antic.value where cli_codi = ?thisformset.xcodicli;")
					SQLEXEC(frmnpag,"select * from recibos_debintv where rec_codi = ?thisformset.codirec;","cur_deb")
					SQLEXEC(frmnpag,"select * from recibos_creintv where rec_codi = ?thisformset.codirec;","cur_cre")
					SQLEXEC(frmnpag,"select * from recibos_facturas where rec_codi = ?thisformset.codirec;","cur_afac")
				desconectar_db(frmnpag)
				
				IF RECCOUNT("cur_deb") > 0
					LOCAL xdbc, ximpdb
					xdbc=0
					ximpdb=0
					SELECT cur_deb
					LOCATE
					SCAN
						xdbc=cur_deb.debv_codi
						ximpdb=cur_deb.recdebi_imp
						frmnpag= conectar_db(_screen.cn)
							SQLEXEC(frmnpag,"update debintv set debv_impag = debv_impag - ?ximpdb,pagado = '' where debv_codi = ?xdbc;")
						desconectar_db(frmnpag)
						SELECT cur_deb
					ENDSCAN
					cerrar_cursor("cur_deb")
				ENDIF
		
				IF RECCOUNT("cur_cre") > 0
					LOCAL xcrc, ximpcr
					xcrc=0
					ximpcr=0
					SELECT cur_cre
					LOCATE
					SCAN
						xcrc=cur_cre.crev_codi
						ximpcr=cur_cre.reccrei_imp
						frmnpag= conectar_db(_screen.cn)
							SQLEXEC(frmnpag,"update creintv set crev_impag = crev_impag - ?ximcr,pagado = '' where crev_codi = ?xcrc;")
						desconectar_db(frmnpag)
						SELECT cur_cre
					ENDSCAN
					cerrar_cursor("cur_cre")
				ENDIF
				
				
				IF RECCOUNT("cur_afac") > 0
					LOCAL xdbr, ximpr
					xdbr=0
					ximpr=0
					SELECT cur_afac
					LOCATE
					SCAN
						xdbr=cur_afac.fac_codi
						ximpr=IIF(cur_afac.recfac_impo<0,ABS(cur_afac.recfac_impo),cur_afac.recfac_impo)
						frmnpag= conectar_db(_screen.cn)
							SQLEXEC(frmnpag,"update facturas set imp_pag = imp_pag - ?ximpr,pagado = '' where fac_codi = ?xdbr;")
						desconectar_db(frmnpag)
						SELECT cur_arep
					ENDSCAN
					cerrar_cursor("cur_afac")
				ENDIF
				
				frmnpag= conectar_db(_screen.cn)
					SQLEXEC(frmnpag,"delete from recibos where rec_codi = ?thisformset.codirec;")
					SQLEXEC(frmnpag,"delete from recibos_facturas where rec_codi = ?thisformset.codirec;")
					SQLEXEC(frmnpag,"delete from recibos_debintv where rec_codi = ?thisformset.codirec;")
					SQLEXEC(frmnpag,"delete from recibos_creintv where rec_codi = ?thisformset.codirec;")
					SQLEXEC(frmnpag,"delete from recibos_pagos where rec_codi = ?thisformset.codirec;")
				desconectar_db(frmnpag)	
				
				MESSAGEBOX("Recibo anulado exitosamente",64,"Aviso del Sistema")
				thisformset.Release
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmprincipal.btn_cont.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE frmprincipal.btn_cont.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE frmprincipal.btn_verpag.btn.Click
		LOCAL xcodirec,xcond
		
		pasrec  = 1
		xcodirec = thisformset.codirec
		xcond    = thisformset.cond
		
		frmnpag= conectar_db(_screen.cn)
			SQLEXEC(frmnpag,"call usp_buscarcli(?cur_recanu.cli_codi);","cur_clie")
		desconectar_db(frmnpag)
		
		do form consrecibo WITH xcodirec,xcond
	ENDPROC

	PROCEDURE frmprincipal.btn_verpag.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE frmprincipal.btn_verpag.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE frmprincipal.btn_verpag.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE frmprincipal.txt_cod.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE frmprincipal.txt_cod.Valid
		*!*	IF this.Value>0 AND LASTKEY()=13
		*!*		STORE 0 TO thisform.txt_cbtes.Value,thisform.txt_dtosaf.Value, ;
		*!*				   thisform.txt_totpag.Value,thisform.txt_antic.Value
		*!*		LOCAL pnro
		*!*		pnro=this.Value
		*!*		frmnpag= conectar_db(_screen.cn)
		*!*			SQLEXEC(frmnpag,"select a.*,b.prov_nomb,b.cond_codi from pagosprov a inner join proveedores b on a.prov_codi = b.prov_codi where a.pag_codi = ?pnro;","cur_paganu")
		*!*		desconectar_db(frmnpag)
		*!*		IF RECCOUNT("cur_paganu")>0
		*!*			thisform.txt_cliente.Value   =ALLTRIM(STR(cur_paganu.prov_codi))+" - "+ALLTRIM(cur_paganu.prov_nomb)
		*!*			thisform.codirec          =cur_paganu.pag_codi
		*!*			thisform.cond             =cur_paganu.cond_codi
		*!*			thisform.xcodicli        =cur_paganu.prov_codi
		*!*			thisform.txt_fecha.Value  =cur_paganu.pag_fech
		*!*			thisform.txt_cbtes.Value  =cur_paganu.pag_impo+cur_paganu.pag_dtosaf
		*!*			thisform.txt_dtosaf.Value =cur_paganu.pag_dtosaf
		*!*			thisform.txt_totpag.Value =cur_paganu.pag_impo-cur_paganu.pag_dtoxpag
		*!*			thisform.txt_antic.Value  =cur_paganu.pag_antic
		*!*					
		*!*			thisform.verocultar(.T.)
		*!*			
		*!*			thisform.btn_cont.Enabled= .T.
		*!*			KEYBOARD '{TAB}'
		*!*		ELSE
		*!*			MESSAGEBOX("Comprobante no se encuentra en archivo.",0+48,"Aviso del Sistema")
		*!*			thisform.btn_cont.Enabled= .F.
		*!*			
		*!*			thisform.verocultar(.F.)
		*!*			
		*!*			this.Value=0
		*!*			return .F.
		*!*		ENDIF
		*!*	ENDIF
	ENDPROC

	PROCEDURE frmprincipal.txt_npag.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE frmprincipal.txt_npag.Valid
		IF this.Value>0 AND LASTKEY()=13
			DO case
			CASE thisformset.frmprincipal.txt_cod.Value = 0 OR thisformset.frmprincipal.txt_cod.Value > 2
				messagebox("Solo puede ingresar Código 1 y 2"+chr(13)+chr(13)+;
					       "1- Recibo Manuscrito"+chr(13)+ ;
					       "2- Recibo Interno",0+48,"Advertencia")
				KEYBOARD '{LEFTARROW}'
				RETURN 0
			OTHERWISE
				STORE 0 TO thisformset.frmprincipal.txt_cbtes.Value,thisformset.frmprincipal.txt_dtosaf.Value, ;
						   thisformset.frmprincipal.txt_antic.Value,thisformset.frmprincipal.txt_totpag.Value
				LOCAL rcod,rnro
				rcod=thisformset.frmprincipal.txt_cod.value
				pnro=this.Value
				frmnpag= conectar_db(_screen.cn)
					SQLEXEC(frmnpag,"select a.*,b.cli_nomb,b.cond_codi from recibos a inner join clientes b on a.cli_codi = b.cli_codi where a.rec_tipo = ?rcod and a.rec_nro = ?pnro;","cur_recanu")
				desconectar_db(frmnpag)
				IF RECCOUNT("cur_recanu")>0
					thisformset.frmprincipal.txt_cliente.Value=ALLTRIM(STR(cur_recanu.cli_codi))+" - "+ALLTRIM(cur_recanu.cli_nomb)
					thisformset.codirec                       =cur_recanu.rec_codi
					thisformset.cond                          =cur_recanu.cond_codi
					thisformset.xcodicli                      =cur_recanu.cli_codi
					thisformset.frmprincipal.txt_fecha.Value  =cur_recanu.rec_fec
					thisformset.frmprincipal.txt_cbtes.Value  =cur_recanu.rec_impo+cur_recanu.rec_dtosaf
					thisformset.frmprincipal.txt_dtosaf.Value =cur_recanu.rec_dtosaf
					thisformset.frmprincipal.txt_antic.Value  =cur_recanu.rec_antic
					thisformset.frmprincipal.txt_totpag.Value =thisform.txt_cbtes.Value+thisform.txt_dtosaf.Value+thisform.txt_antic.Value
							
					thisformset.verocultar(.T.)
					
					thisformset.frmprincipal.btn_cont.Enabled= .T.
					KEYBOARD '{TAB}'
				ELSE
					MESSAGEBOX("Comprobante no se encuentra en archivo.",0+48,"Aviso del Sistema")
					thisformset.frmprincipal.btn_cont.Enabled= .F.
					
					thisformset.verocultar(.F.)
					
					this.Value=0
					return .F.
				ENDIF
			ENDCASE
		ENDIF
	ENDPROC

ENDDEFINE

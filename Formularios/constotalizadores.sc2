	PROCEDURE Destroy
		&& constotalizadores.destroy
		
		set point to
		set separator to
		SET NULL OFF
		
		LOCAL lnI
		LOCAL ARRAY laAlias(47)
		
		* Cursores creados en Init
		laAlias(1)  = "ventas"
		laAlias(2)  = "ventasng"
		laAlias(3)  = "creditos"
		laAlias(4)  = "creading"
		laAlias(5)  = "totgastos"
		laAlias(6)  = "totcregas"
		laAlias(7)  = "totgasng"
		laAlias(8)  = "totcrgasng"
		laAlias(9)  = "compras"
		laAlias(10) = "rfcpra"
		laAlias(11) = "rfcprang"
		laAlias(12) = "crecomp"
		laAlias(13) = "cprasng"
		laAlias(14) = "crecompng"
		laAlias(15) = "a_ivaventas"
		laAlias(16) = "a_ivacreditos"
		laAlias(17) = "ivagastos"
		laAlias(18) = "ivacregas"
		laAlias(19) = "ivacompras"
		laAlias(20) = "ivarfcpra"
		laAlias(21) = "altivacomptas"
		laAlias(22) = "ivacrecomp"
		laAlias(23) = "altivacrecomp"
		laAlias(24) = "retiva"
		laAlias(25) = "retbtos"
		laAlias(26) = "retgcias"
		laAlias(27) = "percepiva"
		laAlias(28) = "percepbtos"
		laAlias(29) = "credperciva"
		laAlias(30) = "credpercbtos"
		laAlias(31) = "totxcli"
		laAlias(32) = "crexcli"
		laAlias(33) = "gaspercep"
		laAlias(34) = "notasdeb"
		laAlias(35) = "totprovi"
		laAlias(36) = "notasdbv"
		laAlias(37) = "notasdbg"
		* Cursores temporales de Command2.Click
		laAlias(38) = "creding"
		laAlias(39) = "cur_totc"
		laAlias(40) = "cur_totp"
		laAlias(41) = "cur_histoc"
		laAlias(42) = "cur_histop"
		laAlias(43) = "cur_provi"
		laAlias(44) = "gasperciva"
		laAlias(45) = "gascrepiva"
		laAlias(46) = "percepbgas"
		laAlias(47) = "credpercbgas"
		
		FOR lnI = 1 TO ALEN(laAlias)
			IF USED(laAlias(lnI))
				USE IN SELECT(laAlias(lnI))
			ENDIF
		ENDFOR
	ENDPROC

	PROCEDURE GotFocus
		set point to ","
		set separator to "."
	ENDPROC

	PROCEDURE Init
		&& constotalizadores.init
		
		this.grid2.recordsource=" "
		this.refresh()
		set point to ","
		set separator to "."
		SET NULL ON
		
		this.text15.value=0
		this.text16.value=0
		this.label19.caption="Total por cobrar al "+dtoc(date())+":"
		this.label20.caption="Total por pagar al "+dtoc(date())+":"
		this.text8.value=date()
		this.text1.value=ctod("01/"+allt(str(month(date())))+"/"+allt(str(year(date()))))
		this.text2.value=date()
		*create cursor cantvent(art_codi N(8),cant N(10,2),vent 1(0,3))
		*create cursor recep(art_codi N(8), can N(10,2),cto N(10,3))
		create cursor ventas(ven_impo N(15,2))
		create cursor ventasng(ven_impo N(15,2))
		create cursor creditos(cre_impo N(15,2))
		create cursor creading(cre_impo N(15,2))
		create cursor totgastos(gas_impo N(15,2))
		create cursor totcregas(cgas_impo N(15,2))
		create cursor totgasng(gas_impo N(15,2))
		create cursor totcrgasng(cgas_impo N(15,2))
		create cursor compras(com_impo N(15,2))
		create cursor rfcpra(rfc_impo N(15,2))
		create cursor rfcprang(rfc_impo N(15,2))
		create cursor crecomp(crec_impo N(15,2))
		create cursor cprasng(com_impo N(15,2))
		create cursor crecompng(crec_impo N(15,2))
		create cursor a_ivaventas(iva_vta N(15,2))
		create cursor a_ivacreditos(iva_cre N(15,2))
		create cursor ivagastos(iva_gtos N(15,2))
		create cursor ivacregas(civa_gtos N(15,2))
		create cursor ivacompras(iva_cpra N(15,2))
		create cursor ivarfcpra(iva_rfcpra N(15,2))
		create cursor altivacomptas(iva_cpra N(15,2))
		create cursor ivacrecomp(iva_crecomp N(15,2))
		create cursor altivacrecomp(iva_crecomp N(15,2))
		create cursor retiva(ret_iva N(15,2))
		create cursor retbtos(ret_btos N(15,2))
		create cursor retgcias(ret_gcias N(15,2))
		create cursor percepiva(perc_impo N(15,2))
		create cursor percepbtos(perc_impo N(15,2))
		create cursor credperciva(cpiva_impo N(15,2))
		create cursor credpercbtos(cpbtos_impo N(15,2))
		create cursor totxcli(cli_codi N(8),ven N(15,2))
		create cursor crexcli(cli_codi N(8),cre N(15,2))
		create cursor gaspercep(gas_piva N(15,2))
		
		
		*-------------20-05-2026-------------------*
		CREATE CURSOR notasdeb(nd_impo N(15,2))
		CREATE CURSOR notasdbv(ndv_impo N(15,2))
		CREATE CURSOR notasdbg(ndg_impo N(15,2))
		*-------------------------------------------*
		
		
		
		
		CREATE CURSOR totprovi(provi C(20),total N(15,2),porc N(10,3),provi_codi N(8))
		INDEX on provi_codi TO SYS(2015) ADDITIVE
		INDEX on provi TO SYS(2015) ADDITIVE
		
	ENDPROC

	PROCEDURE LostFocus
		set point to
		set separator to
	ENDPROC

	PROCEDURE mostrar_desglose
		&& constotalizadores.mostrar_desglose
		LPARAMETERS tcCaption, tcTitulo, tcTot, tcL1, tcV1, tcL2, tcV2, tcL3, tcV3
		
		LOCAL loFrm, lnFilas, lnSepTop
		
		lnFilas = 1
		IF PARAMETERS() >= 7 AND !EMPTY(tcL2)
			lnFilas = 2
		ENDIF
		IF PARAMETERS() >= 9 AND !EMPTY(tcL3)
			lnFilas = 3
		ENDIF
		
		lnSepTop = 47 + (lnFilas - 1) * 28 + 27
		
		loFrm = CREATEOBJECT("Form")
		loFrm.Caption     = tcCaption
		loFrm.Width       = 420
		loFrm.Height      = lnSepTop + 60
		loFrm.AutoCenter  = .T.
		loFrm.MaxButton   = .F.
		loFrm.MinButton   = .F.
		loFrm.Closable    = .T.
		loFrm.BorderStyle = 2
		loFrm.MousePointer = 1
		
		loFrm.AddObject("lblTit","Label")
		WITH loFrm.lblTit
			.Caption  = tcTitulo
			.FontBold = .T.
			.FontSize = 10
			.BackStyle = 0
			.Left     = 15
			.Top      = 12
			.AutoSize = .T.
			.Visible  = .T.
		ENDWITH
		
		loFrm.AddObject("lbl1","Label")
		WITH loFrm.lbl1
			.Caption   = tcL1
			.FontBold  = .T.
			.BackStyle = 0
			.Left      = 15
			.Top       = 50
			.AutoSize  = .T.
			.Visible   = .T.
		ENDWITH
		loFrm.AddObject("txt1","TextBox")
		WITH loFrm.txt1
			.Value        = tcV1
			.Alignment    = 1
			.Enabled      = .F.
			.BorderStyle  = 0
			.FontBold     = .T.
			.MousePointer = 1
			.TabStop      = .F.
			.Left         = 265
			.Top          = 47
			.Width        = 140
			.Height       = 22
			.Visible      = .T.
		ENDWITH
		
		IF lnFilas >= 2
			loFrm.AddObject("lbl2","Label")
			WITH loFrm.lbl2
				.Caption   = tcL2
				.FontBold  = .T.
				.BackStyle = 0
				.Left      = 15
				.Top       = 78
				.AutoSize  = .T.
				.Visible   = .T.
			ENDWITH
			loFrm.AddObject("txt2","TextBox")
			WITH loFrm.txt2
				.Value        = tcV2
				.Alignment    = 1
				.Enabled      = .F.
				.BorderStyle  = 0
				.FontBold     = .T.
				.MousePointer = 1
				.TabStop      = .F.
				.Left         = 265
				.Top          = 75
				.Width        = 140
				.Height       = 22
				.Visible      = .T.
			ENDWITH
		ENDIF
		
		IF lnFilas >= 3
			loFrm.AddObject("lbl3","Label")
			WITH loFrm.lbl3
				.Caption   = tcL3
				.FontBold  = .T.
				.BackStyle = 0
				.Left      = 15
				.Top       = 106
				.AutoSize  = .T.
				.Visible   = .T.
			ENDWITH
			loFrm.AddObject("txt3","TextBox")
			WITH loFrm.txt3
				.Value        = tcV3
				.Alignment    = 1
				.Enabled      = .F.
				.BorderStyle  = 0
				.FontBold     = .T.
				.MousePointer = 1
				.TabStop      = .F.
				.Left         = 265
				.Top          = 103
				.Width        = 140
				.Height       = 22
				.Visible      = .T.
			ENDWITH
		ENDIF
		
		loFrm.AddObject("shp1","Shape")
		WITH loFrm.shp1
			.Left      = 10
			.Top       = lnSepTop
			.Width     = 395
			.Height    = 2
			.BackColor = RGB(120,120,120)
			.Visible   = .T.
		ENDWITH
		
		loFrm.AddObject("lblTot","Label")
		WITH loFrm.lblTot
			.Caption   = "TOTAL NETO:"
			.FontBold  = .T.
			.FontSize  = 10
			.BackStyle = 0
			.Left      = 15
			.Top       = lnSepTop + 12
			.AutoSize  = .T.
			.Visible   = .T.
		ENDWITH
		loFrm.AddObject("txtTot","TextBox")
		WITH loFrm.txtTot
			.Value        = tcTot
			.Alignment    = 1
			.Enabled      = .F.
			.BorderStyle  = 0
			.FontBold     = .T.
			.FontSize     = 10
			.MousePointer = 1
			.TabStop      = .F.
			.Left         = 265
			.Top          = lnSepTop + 9
			.Width        = 140
			.Height       = 24
			.Visible      = .T.
		ENDWITH
		
		loFrm.Icon = "C:\VFP9_MYSQL\imagen\moneda01.ico"
		loFrm.Show(1)
		loFrm = .NULL.
		
		
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(215,215,215)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command2.Click
		&& constotalizadores.command2.click
		
		with thisform
		frmtotaliz= conectar_db(_screen.cn)
			SQLEXEC(frmtotaliz,"select sum(neto_1+neto_2) as ven_impo from facturas where fac_fec between ?.text1.value and ?.text2.value and anulado<>'S' and  fac_conc<>'N';","ventas")
			SQLEXEC(frmtotaliz,"select sum(fac_ng) as ven_impo from facturas where fac_fec between ?.text1.value and ?.text2.value and anulado<>'S' and fac_conc<>'N';","ventasng")
			SQLEXEC(frmtotaliz,"select sum(neto_1+neto_2) as cre_impo from facturas where fac_fec between ?.text1.value and ?.text2.value and	anulado<>'S' and fac_conc='N';","creditos")
			SQLEXEC(frmtotaliz,"select sum(fac_ng) as ven_impo from facturas where fac_fec between ?.text1.value and ?.text2.value and anulado<>'S' and fac_conc='N';","creding")
			.text9.value=IIF(ISNULL(ventas.ven_impo),0,ventas.ven_impo)-IIF(ISNULL(creditos.cre_impo),0,creditos.cre_impo)
			.text17.value=IIF(ISNULL(ventasng.ven_impo),0,ventasng.ven_impo)-IIF(ISNULL(creding.ven_impo),0,creding.ven_impo)
			SQLEXEC(frmtotaliz,"select sum(gas_impo) as gas_impo from gastos where gas_fech between ?.text1.value and ?.text2.value and gas_nc=0;","totgastos")
			SQLEXEC(frmtotaliz,"select sum(gas_impo) as cgas_impo from gastos where gas_fech between ?.text1.value and ?.text2.value and gas_nc=1;","totcregas")
			SQLEXEC(frmtotaliz,"select sum(gas_impng) as gas_impo from gastos where gas_fech between ?.text1.value and ?.text2.value and gas_nc=0;","totgasng")
			SQLEXEC(frmtotaliz,"select sum(gas_impng) as cgas_impo from gastos where gas_fech between ?.text1.value and ?.text2.value and gas_nc=1;","totcrgasng")
			
			
			
			*-----------------------------20-05-2026------------------------------------------------------*
		*!*		.text10.value=IIF(ISNULL(totgastos.gas_impo),0,totgastos.gas_impo)-IIF(ISNULL(totcregas.cgas_impo),0,totcregas.cgas_impo)
			.text10.value=IIF(ISNULL(totgastos.gas_impo),0,totgastos.gas_impo) + ;
		              IIF(ISNULL(notasdbg.ndg_impo),0,notasdbg.ndg_impo) - ;
		              IIF(ISNULL(totcregas.cgas_impo),0,totcregas.cgas_impo)
			*---------------------------------------------------------------------------------------------*
			
			
			
			.text19.value=IIF(ISNULL(totgasng.gas_impo),0,totgasng.gas_impo)-IIF(ISNULL(totcrgasng.cgas_impo),0,totcrgasng.cgas_impo)
			SQLEXEC(frmtotaliz,"select sum(recep_tot) as com_impo from recepciones where recep_fec between ?.text1.value and ?.text2.value and recep_conc<>'N';","compras")
			SQLEXEC(frmtotaliz,"select sum(rfc_neto1+rfc_neto2) as rfc_impo from rfc where rfc_fec between ?.text1.value and ?.text2.value;","rfcpra")
			SQLEXEC(frmtotaliz,"select sum(recep_tot) as crec_impo from recepciones where recep_fec between ?.text1.value and ?.text2.value and recep_conc='N';","crecomp")
			
			
			*----------------------------20-05-2026--------------------------------------------------*
			SQLEXEC(frmtotaliz,"select sum(recep_tot) as nd_impo from recepciones where recep_fec between ?.text1.value and ?.text2.value and recep_conc='D';","notasdeb")
			SQLEXEC(frmtotaliz,"select sum(neto_1+neto_2) as ndv_impo from facturas where fac_fec between ?.text1.value and ?.text2.value and anulado<>'S' and fac_conc='D';","notasdbv")
			SQLEXEC(frmtotaliz,"select sum(gas_impo) as ndg_impo from gastos where gas_fech between ?.text1.value and ?.text2.value and gas_conc='D';","notasdbg")
			*----------------------------------------------------------------------------------------*
			
			SQLEXEC(frmtotaliz,"select sum(recep_impng) as com_impo from recepciones where recep_fec between ?.text1.value and ?.text2.value and recep_conc<>'N';","cprasng")
			SQLEXEC(frmtotaliz,"select sum(rfc_impng) as rfc_impo from rfc where rfc_fec between ?.text1.value and ?.text2.value;","rfcprang")
			SQLEXEC(frmtotaliz,"select sum(recep_impng) as crec_impo from recepciones where recep_fec between ?.text1.value and ?.text2.value and recep_conc='N';","crecompng")
			.text11.value=IIF(ISNULL(compras.com_impo),0,compras.com_impo)-IIF(ISNULL(crecomp.crec_impo),0,crecomp.crec_impo)- ;
							IIF(ISNULL(rfcpra.rfc_impo),0,rfcpra.rfc_impo)
			.text18.value=IIF(ISNULL(cprasng.com_impo),0,cprasng.com_impo)-IIF(ISNULL(crecompng.crec_impo),0,crecompng.crec_impo)- ;
							IIF(ISNULL(rfcprang.rfc_impo),0,rfcprang.rfc_impo)
			*************************************COMIENZA IVA VENTAS****************************************
			SQLEXEC(frmtotaliz,"select SUM(fac_ivari+fac_ivarni) as iva_vta from facturas where fac_fec between ?.text1.value and ?.text2.value and anulado<>'S' and fac_conc<>'N';","a_ivaventas")
		
			SQLEXEC(frmtotaliz,"select SUM(fac_ivari+fac_ivarni) as iva_cre from facturas where fac_fec between ?.text1.value and ?.text2.value and anulado<>'S' and fac_conc='N';","a_ivacreditos")
		
			.text3.value=IIF(ISNULL(a_ivaventas.iva_vta),0,a_ivaventas.iva_vta)-IIF(ISNULL(a_ivacreditos.iva_cre),0,a_ivacreditos.iva_cre)
		*************************************FIN IVA VENTAS************************************************
		********************************COMIENZA IVA COMPRAS***********************************************
			SQLEXEC(frmtotaliz,"select sum(gas_iva) as iva_gtos from gastos where gas_fech between ?.text1.value and ?.text2.value and (gas_tipcbte='A' or gas_tipcbte='M' or gas_tipcbte='L' or gas_tipcbte='RB') and gas_nc<>1;","ivagastos")
			SQLEXEC(frmtotaliz,"select sum(gas_iva) as civa_gtos from gastos where gas_fech between ?.text1.value and ?.text2.value	and (gas_tipcbte='A' or gas_tipcbte='M' or gas_tipcbte='L' or gas_tipcbte='RB') and gas_nc=1;","ivacregas")
			SQLEXEC(frmtotaliz,"select sum(recep_ivari+recep_ivarni) as iva_cpra from recepciones where recep_fec between ?.text1.value and ?.text2.value and recep_conc<>'N' and (prov_tipfac='A' or prov_tipfac='M');","ivacompras")
			SQLEXEC(frmtotaliz,"select sum(rfc_ivari+rfc_ivarni) as iva_rfcpra from rfc where rfc_fec between ?.text1.value and ?.text2.value;","ivarfcpra")
			SQLEXEC(frmtotaliz,"select sum(recep_ivari+recep_ivarni) as iva_crecomp from recepciones where recep_fec between ?.text1.value and ?.text2.value and recep_conc='N'  and (prov_tipfac='A' or prov_tipfac='M');","ivacrecomp")
			SQLEXEC(frmtotaliz,"select sum(a.movtippag_imp) as ret_iva from recibos_pagos a inner join recibos b on a.rec_codi=b.rec_codi where a.tippag_codi=6 and b.rec_fec between ?.text1.value and ?.text2.value;","retiva")
			.text5.value=IIF(ISNULL(retiva.ret_iva),0,retiva.ret_iva)
			SQLEXEC(frmtotaliz,"select round(sum(perc_iva),2) as perc_impo from recepciones where recep_fec between ?.text1.value and ?.text2.value and recep_conc<>'N';","percepiva")
			SQLEXEC(frmtotaliz,"select round(sum(perc_iva),2) as cpiva_impo from recepciones where recep_fec between ?.text1.value and ?.text2.value and recep_conc='N';","credperciva")
			SQLEXEC(frmtotaliz,"select ROUND(sum(gas_piva),2) as gas_piva from gastos where gas_fech between ?.text1.value and ?.text2.value and gas_conc<>'N';","gasperciva")
			SQLEXEC(frmtotaliz,"select ROUND(sum(gas_piva),2) as gas_crepiva from gastos where gas_fech between ?.text1.value and ?.text2.value and gas_conc='N';","gascrepiva")
			.text13.value=(IIF(ISNULL(percepiva.perc_impo),0,percepiva.perc_impo)-IIF(ISNULL(credperciva.cpiva_impo),0,credperciva.cpiva_impo))+ ;
						  (IIF(ISNULL(gasperciva.gas_piva),0,gasperciva.gas_piva)-IIF(ISNULL(gascrepiva.gas_crepiva),0,gascrepiva.gas_crepiva))
		
			.text4.value=IIF(ISNULL(ivagastos.iva_gtos),0,ivagastos.iva_gtos)-IIF(ISNULL(ivacregas.civa_gtos),0,ivacregas.civa_gtos)+ ;
							IIF(ISNULL(ivacompras.iva_cpra),0,ivacompras.iva_cpra)-IIF(ISNULL(ivacrecomp.iva_crecomp),0,ivacrecomp.iva_crecomp)- ;
							IIF(ISNULL(ivarfcpra.iva_rfcpra),0,ivarfcpra.iva_rfcpra)
		*****************************FIN IVA COMPRAS***************************************************
			.text7.value=.text3.value-.text4.value
			SQLEXEC(frmtotaliz,"select sum(a.movtippag_imp) as ret_btos from recibos_pagos a inner join recibos b on a.rec_codi=b.rec_codi where a.tippag_codi=7 and b.rec_fec between ?.text1.value and ?.text2.value;","retbtos")
			.text6.value=IIF(ISNULL(retbtos.ret_btos),0,retbtos.ret_btos)
			SQLEXEC(frmtotaliz,"select sum(a.movtippag_imp) as ret_gcias from recibos_pagos a inner join recibos b on a.rec_codi=b.rec_codi where a.tippag_codi=8 and b.rec_fec between ?.text1.value AND ?.text2.value);","retgcias")
			.text12.value=IIF(ISNULL(retgcias.ret_gcias),0,retgcias.ret_gcias)
			SQLEXEC(frmtotaliz,"select round(sum(perc_btos),2) as perc_impo from recepciones where recep_fec between ?.text1.value and ?.text2.value and recep_conc<>'N';","percepbtos")
			SQLEXEC(frmtotaliz,"select round(sum(perc_btos),2) as cpbtos_impo from recepciones where recep_fec between ?.text1.value and ?.text2.value and recep_conc='N';","credpercbtos")
			SQLEXEC(frmtotaliz,"select round(sum(gas_btos),2) as perc_impo from gastos where gas_fech between ?.text1.value and ?.text2.value and gas_conc<>'N';","percepbgas")
			SQLEXEC(frmtotaliz,"select round(sum(gas_btos),2) as cpbtos_impo from gastos where gas_fech between ?.text1.value and ?.text2.value and gas_conc='N';","credpercbgas")
			.text14.value=(IIF(ISNULL(percepbtos.perc_impo),0,percepbtos.perc_impo)-IIF(ISNULL(credpercbtos.cpbtos_impo),0,credpercbtos.cpbtos_impo))+ ;
					      (IIF(ISNULL(percepbgas.perc_impo),0,percepbgas.perc_impo)-IIF(ISNULL(credpercbgas.cpbtos_impo),0,credpercbgas.cpbtos_impo))
			SQLEXEC(frmtotaliz,"select cli_codi,sum(fac_ng+neto_1+neto_2) as ven from facturas where fac_fec between ?.text1.value and ?.text2.value and anulado<>'S' and fac_conc<>'N'	group by cli_codi order by cli_codi;","totxcli")
			SQLEXEC(frmtotaliz,"select cli_codi,sum(fac_ng+neto_1+neto_2) as cre from facturas where fac_fec between ?.text1.value and ?.text2.value and anulado<>'S' and fac_conc='N' group by cli_codi order by cli_codi;","crexcli")
			thisform.label19.caption="Total por cobrar al "+dtoc(thisform.text2.value)+":"
			thisform.label20.caption="Total por pagar al "+dtoc(thisform.text2.value)+":"
			if thisform.text2.value=date()
				SQLEXEC(frmtotaliz,"select sum(cli_saldo-cli_favor) as totc from clientes;","cur_totc")
				thisform.text15.Value=IIF(ISNULL(cur_totc.totc),0,cur_totc.totc)
				SQLEXEC(frmtotaliz,"select sum(prov_saldo-prov_afvor) as totp from proveedores where prov_codi<>46 and prov_codi<>153 and prov_codi<>178 and prov_codi<>229;","cur_totp")
				thisform.text16.value=IIF(ISNULL(cur_totp.totp),0,cur_totp.totp)
			else
				SQLEXEC(frmtotaliz,"select histoc_impo from histocobrar where histoc_fecha=?thisform.text2.value;","cur_histoc")
				if RECCOUNT()>0
					thisform.text15.value=cur_histoc.histoc_impo
				else
					thisform.text15.value=0
				endif
				SQLEXEC(frmtotaliz,"select histop_impo from histopagar where histop_fecha=?thisform.text2.value;","cur_histop")
				if RECCOUNT()>0
					thisform.text16.value=cur_histop.histop_impo
				else
					thisform.text16.value=0
				endif
			ENDIF
			******************** COMIENZA CALCULO TOTAL POR PROVINCIA ****************************
			LOCAL prov,cprov
			SELECT totprovi
			SET SAFETY off
			ZAP
			SET SAFETY on
			sele totxcli
			if reccount()>0
				go top
				do while !eof()
					SQLEXEC(frmtotaliz,"select c.provi_nomb,b.provi_codi from clientes a inner join localidades b on a.loca_codi=b.loca_codi inner join provincias c on c.provi_codi=b.provi_codi where a.cli_codi=?totxcli.cli_codi;","cur_provi")
					prov=cur_provi.provi_nomb
					cprov =cur_provi.provi_codi
					SELECT totprovi
					SET ORDER TO 1			
					SEEK cprov
					if FOUND()
						REPLACE totprovi.total WITH totprovi.total+totxcli.ven
					ELSE
						APPEND BLANK
						REPLACE totprovi.provi WITH prov
						REPLACE totprovi.total WITH totxcli.ven
						replace totprovi.provi_codi WITH cprov
					endif
					sele totxcli
					skip
				enddo
			endif
			sele crexcli
			if reccount()>0
				go top
				do while !eof()
					SQLEXEC(frmtotaliz,"select c.provi_nomb,b.provi_codi from clientes a inner join localidades b on a.loca_codi=b.loca_codi inner join provincias c on c.provi_codi=b.provi_codi where a.cli_codi=?crexcli.cli_codi;","cur_provi")
					prov=cur_provi.provi_nomb
					cprov =cur_provi.provi_codi
					SELECT totprovi
					SET ORDER TO 1			
					SEEK cprov
					if FOUND()
						REPLACE totprovi.total WITH totprovi.total-crexcli.cre
					ELSE
						APPEND BLANK
						REPLACE totprovi.provi WITH prov
						REPLACE totprovi.total WITH -crexcli.cre
						replace totprovi.provi_codi WITH cprov
					endif
					sele crexcli
					skip
				enddo
			ENDIF	
			SELECT totprovi
			GO top
			IF RECCOUNT()>0
				SCAN
					REPLACE totprovi.porc WITH totprovi.total*100/(.text9.value+.text17.value)
				ENDSCAN
			ENDIF
			SET ORDER TO
			GO TOP
			thisform.grid2.recordsourcetype=1
			thisform.grid2.recordsource="totprovi"
			thisform.grid2.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
			Thisform.grid2.column2.DynamicInputMask = [('$999,999,999.99')]
			.text1.setfocus
		desconectar_db(frmtotaliz)
		endwith
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text10.Click
		&& constotalizadores.text10.click
		
		PRIVATE lnGastos, lnNotasDebito, lnCreditos
		LOCAL lcGas, lcND, lcNC, lcTot
		
		lnGastos      = 0
		lnNotasDebito = 0
		lnCreditos    = 0
		IF USED("totgastos") AND !EOF("totgastos")
			lnGastos = IIF(ISNULL(totgastos.gas_impo), 0, totgastos.gas_impo)
		ENDIF
		IF USED("notasdbg") AND !EOF("notasdbg")
			lnNotasDebito = IIF(ISNULL(notasdbg.ndg_impo), 0, notasdbg.ndg_impo)
		ENDIF
		IF USED("totcregas") AND !EOF("totcregas")
			lnCreditos = IIF(ISNULL(totcregas.cgas_impo), 0, totcregas.cgas_impo)
		ENDIF
		SET POINT TO ","
		SET SEPARATOR TO "."
		lcGas = ALLTRIM(TRANSFORM(lnGastos,              "999,999,999,999,999.99"))
		lcND  = ALLTRIM(TRANSFORM(lnNotasDebito,         "999,999,999,999,999.99"))
		lcNC  = ALLTRIM(TRANSFORM(lnCreditos,            "999,999,999,999,999.99"))
		lcTot = ALLTRIM(TRANSFORM(thisform.text10.value, "999,999,999,999,999.99"))
		thisform.mostrar_desglose("Gastos","DETALLE - GASTOS",lcTot, ;
			"Gastos:",lcGas,"Notas de Debito  (+):",lcND,"Notas de Credito  (-):",lcNC)
		
		
	ENDPROC

	PROCEDURE Text11.Click
		&& constotalizadores.text11.click
		
		PRIVATE lnFacturas, lnNotasDebito, lnNotasCredito
		LOCAL lcFact, lcND, lcNC, lcTot
		
		lnFacturas     = 0
		lnNotasDebito  = 0
		lnNotasCredito = 0
		IF USED("compras") AND !EOF("compras")
			lnFacturas = IIF(ISNULL(compras.com_impo), 0, compras.com_impo)
		ENDIF
		IF USED("notasdeb") AND !EOF("notasdeb")
			lnNotasDebito = IIF(ISNULL(notasdeb.nd_impo), 0, notasdeb.nd_impo)
		ENDIF
		IF USED("crecomp") AND !EOF("crecomp")
			lnNotasCredito = IIF(ISNULL(crecomp.crec_impo), 0, crecomp.crec_impo)
		ENDIF
		lnFacturas = lnFacturas - lnNotasDebito
		SET POINT TO ","
		SET SEPARATOR TO "."
		lcFact = ALLTRIM(TRANSFORM(lnFacturas,            "999,999,999,999,999.99"))
		lcND   = ALLTRIM(TRANSFORM(lnNotasDebito,         "999,999,999,999,999.99"))
		lcNC   = ALLTRIM(TRANSFORM(lnNotasCredito,        "999,999,999,999,999.99"))
		lcTot  = ALLTRIM(TRANSFORM(thisform.text11.value, "999,999,999,999,999.99"))
		thisform.mostrar_desglose("Compras Mercaderias","DETALLE - COMPRAS MERCADERIA",lcTot, ;
			"Facturas:",lcFact,"Notas de Debito  (+):",lcND,"Notas de Credito  (-):",lcNC)
		
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text9.Click
		&& constotalizadores.text9.click
		
		PRIVATE lnVentas, lnNotasDebito, lnCreditos
		LOCAL lcFact, lcND, lcNC, lcTot, lnFacturas
		
		lnVentas      = 0
		lnNotasDebito = 0
		lnCreditos    = 0
		IF USED("ventas") AND !EOF("ventas")
			lnVentas = IIF(ISNULL(ventas.ven_impo), 0, ventas.ven_impo)
		ENDIF
		IF USED("notasdbv") AND !EOF("notasdbv")
			lnNotasDebito = IIF(ISNULL(notasdbv.ndv_impo), 0, notasdbv.ndv_impo)
		ENDIF
		IF USED("creditos") AND !EOF("creditos")
			lnCreditos = IIF(ISNULL(creditos.cre_impo), 0, creditos.cre_impo)
		ENDIF
		lnFacturas = lnVentas - lnNotasDebito
		SET POINT TO ","
		SET SEPARATOR TO "."
		lcFact = ALLTRIM(TRANSFORM(lnFacturas,          "999,999,999,999,999.99"))
		lcND   = ALLTRIM(TRANSFORM(lnNotasDebito,       "999,999,999,999,999.99"))
		lcNC   = ALLTRIM(TRANSFORM(lnCreditos,          "999,999,999,999,999.99"))
		lcTot  = ALLTRIM(TRANSFORM(thisform.text9.value,"999,999,999,999,999.99"))
		thisform.mostrar_desglose("Ventas Mercaderias","DETALLE - VENTAS",lcTot, ;
			"Facturas:",lcFact,"Notas de Debito  (+):",lcND,"Notas de Credito  (-):",lcNC)
		
		
	ENDPROC

ENDDEFINE


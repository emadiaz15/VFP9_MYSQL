	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		frmcond= conectar_db(_screen.cn)
			SQLEXEC(frmcond,"select CAST(MAX(condp_cod)+1 as DECIMAL(8,0)) as condp_cod from condipresup order by condp_cod;","cur_ncond")
		desconectar_db(frmcond)
		this.text5.value=cur_ncond.condp_cod
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Command1.Click
		preg=messagebox("¿Seguro que desea Salir?",4+32+256,"Condiciones para Presupuestos")
		if preg=6
			thisform.release
		else
			thisform.text1.setfocus
		endif
		
	ENDPROC

	PROCEDURE Command2.Click
		preg=messagebox("¿Confirma los datos ingresados?",4+48+256,"Advertencia")
		if preg=6
			with thisform
				LOCAL xcodi,xval,xpla,xpag,xlug,xobs
				xcodi=thisform.text5.Value
				STORE '' TO xval,xpla,xpag,xlug,xobs
				
				xval=allt(.text1.value)
				xpla=allt(.text2.value)
				xpag=allt(.text3.value)
				xlug=allt(.text4.value)
				xobs=allt(.edit1.value)
				frmcond= conectar_db(_screen.cn)
					SQLEXEC(frmcond,"insert into condipresup values(?xcodi,?xval,?xpla,?xpag,?xlug,?xobs);")
				desconectar_db(frmcond)
				.SetAll("Value", "", "Textbox")
				.SetAll("Value", "", "Editbox")
				.text5.value=cur_ncond.condp_cod+1
			endwith
		endif
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC


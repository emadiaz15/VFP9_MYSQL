	PROCEDURE Edit3.GotFocus
		PUBLIC estamayus,anot
		estamayus= CAPSLOCK()
		anot=ALLTRIM(this.Value)
		CAPSLOCK(.T.)
	ENDPROC

	PROCEDURE Edit3.LostFocus
		DO case
			CASE estamayus=.T.
				CAPSLOCK(.T.)
			CASE estamayus=.F.
				CAPSLOCK(.F.)
		ENDCASE
		frmcart= conectar_db(_screen.cn)
			SQLEXEC(frmcart,"update articulos set art_detaofi=?trim(this.value) where art_codi=?thisform.text1.value;")
		desconectar_db(frmcart)
	ENDPROC


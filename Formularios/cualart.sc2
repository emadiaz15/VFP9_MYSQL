	PROCEDURE Text1.Valid
		LOCAL xcc
		if this.value<>0
			xcc=this.value
			thisform.chk_todos.Enabled= .F.
			thisform.chk_todos.Value=0
			thisform.lbl_prov.BackStyle= 0
			thisform.lbl_prov.Caption=''
			thisform.grd_costos.RecordSource=''
			thisform.grd_costos.Refresh()
			frmcualart= conectar_db(_screen.cn)
				if this.Value<=5
					SQLEXEC(frmcualart, "select * from articulos where art_codi=?this.value;","cur_arti")
				else
					SQLEXEC(frmcualart, "select a.*,b.* from articulos a inner join rubros b on a.rub_codi=b.rub_codi where a.art_codi=?this.value;","cur_arti")
				endif
			desconectar_db(frmcualart)
			IF RECCOUNT("cur_arti")>0
				if cur_arti.art_codi>5
					frmcualart= conectar_db(_screen.cn)
						SQLEXEC(frmcualart,"select * from desc_articulos_clientes where artcli_codi = any (select artcli_codi from articulos_clientes where art_codi=?this.value and cli_codi=?codicli);","cur_difdes")
					desconectar_db(frmcualart)
					IF RECCOUNT("cur_difdes")>0
		*!*					IF _screen.xopvta<>"FA"
		*!*						frmcualart= conectar_db(_screen.cn)
		*!*							SQLEXEC(frmcualart,"call usp_ultdesvta(?cur_arti.art_codi,?codicli,0,?_screen.xopvta);","cur_udd")
		*!*						desconectar_db(frmcualart)
		*!*						IF RECCOUNT("cur_udd") > 0
		*!*							thisform.text3.value=cur_udd.dac_desc
		*!*							cerrar_cursor("cur_udd")
		*!*						ELSE
		*!*							thisform.text3.value=cur_arti.art_desc
		*!*						ENDIF
		*!*					ELSE
		*!*					thisform.text3.value=cur_arti.art_desc
		*!*					ENDIF
						thisform.cmd_masdes.Visible= .T.
		*!*					codiprov=0
		*!*					descri=""
		*!*					do form diferentesdesc with codicli,codiprov,descri,this.value
		*!*					if not isblank(descri)
		*!*						thisform.text3.value=allt(descri)
		*!*					else
		*!*						thisform.text3.value=cur_arti.art_desc
		*!*					endif
		*!*				ELSE
		*!*					thisform.text3.value=cur_arti.art_desc
					ENDIF
					thisform.text7.Style= 0
					thisform.text8.Style= 0
					thisform.text3.value=cur_arti.art_desc
					thisform.text6.value=cur_arti.art_stock
					thisform.text7.value=cur_arti.pedidos
					thisform.text8.value=cur_arti.pedprov
					cerrar_cursor("cur_tped")
					cerrar_cursor("cur_tcom")
					do case
						case cur_arti.art_med="UN"
							thisform.optiongroup1.value=1
						case cur_arti.art_med="MT"
							thisform.optiongroup1.value=2
						case cur_arti.art_med="KG"
							thisform.optiongroup1.value=3
					endcase			
					thisform.text9.value=cur_arti.art_stock+thisform.text8.value-thisform.text7.value
					thisform.text10.value=cur_arti.art_precio
					thisform.text13.value=cur_arti.costo_ultcpra
					thisform.text14.Value=cur_arti.art_stmin
					thisform.text11.value=cur_arti.rub_desc
					thisform.edit2.value=cur_arti.art_deta
					thisform.edit3.value=cur_arti.art_detaofi
					thisform.dias_actcosto(this.value)
					thisform.btn_cotiz.Visible= .T.
					WITH thisform
						IF LEN(ALLTRIM(.edit3.Value))>0
							.shape5.visible=.T.
							.label25.visible=.T.
							.edit3.visible=.T.
							.edit2.visible=.T.
							.label16.visible=.T.
							thisform.command5.caption="\<Ocultar Detalles"
							IF thisform.text1.Value>0
								.edit3.enabled=.T.
							ENDIF
						ELSE
							.shape5.visible=.F.
							.label25.visible=.F.
							.edit3.visible=.F.
							.edit2.visible=.F.
							.label16.visible=.F.
							thisform.command5.caption="\<Ver Detalles"
							.edit3.enabled=.F.
						ENDIF
					ENDWITH		
					thisform.grd_costos.RecordSource=''
					thisform.grd_costos.Refresh()
					SET DECIMALS TO 3
					frmcualart= conectar_db(_screen.cn)
						SQLEXEC(frmcualart,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
						IF RECCOUNT("provc")>0
							thisform.lbl_prov.BackStyle= 1
							thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
						ENDIF
						SQLEXEC(frmcualart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?this.value and a.otro=0 order by a.artpro_costo;","cur_costos")
						IF RECCOUNT("cur_costos")>0
							thisform.chk_todos.Enabled= .T.
							GO top
							thisform.grd_costos.RecordSource="cur_costos"
							thisform.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(cur_costos.lista,cur_costos.cotiz)","Column")
							thisform.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(cur_costos.otro)","Column")
							thisform.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(cur_costos.otro)","Column")
							GO top
							SQLEXEC(frmcualart,"select param_impo from parametros where param_codi=9;","cur_dolar")
							SQLEXEC(frmcualart,"select param_impo from parametros where param_codi=14;","cur_dolarofi")
							SQLEXEC(frmcualart,"select param_impo from parametros where param_codi=11;","cur_rjdolar")
		
							LOCAL xdolar,xdolarofi,xreaj,xutil,costmin
		
							xdolar=cur_dolar.param_impo
							xdolarofi= IIF(WEXIST("modipresup") OR WEXIST("altapresup"),_screen.dolarpres,cur_dolarofi.param_impo)
							xreaj =ROUND(xdolar*((100-cur_rjdolar.param_impo)/100),3)
							xutil =1+(_screen.utilidad/100)
		
							IF WEXIST("modipresup") OR WEXIST("altapresup")
								IF _screen.monepres='D'
									SELECT IIF(moneda="D",artpro_costo,ROUND(artpro_costo/xdolarofi,3)) as costo ;
											FROM cur_costos WHERE cotiz=1 INTO CURSOR calc_costos
								ELSE
									SELECT IIF(moneda="P",artpro_costo,ROUND(artpro_costo*xdolarofi,3)) as costo ;
											FROM cur_costos WHERE cotiz=1 INTO CURSOR calc_costos
								ENDIF
								cerrar_cursor("cur_dolarofi")
							ELSE
								SELECT IIF(moneda="D",ROUND((artpro_costo*xdolar)/xreaj,3),ROUND(artpro_costo/xreaj,5)) as costo ;
										FROM cur_costos WHERE cotiz=1 INTO CURSOR calc_costos
							ENDIF
							
							costmin= IIF(RECCOUNT("calc_costos")>0,calc_costos.costo,0)
							if paso=0
								if cond=2
									thisform.text4.value=ROUND(costmin*xutil,3)
								ELSE
									thisform.text4.value=ROUND((costmin+costmin*iif(cur_arti.art_alicuota=1,impiva1,impiva2)/100)*xutil,3)
								ENDIF
							ELSE
								IF this.Value <> dato1
									if cond=2
										thisform.text4.value=ROUND(costmin*xutil,3)
									ELSE
										thisform.text4.value=ROUND((costmin+costmin*iif(cur_arti.art_alicuota=1,impiva1,impiva2)/100)*xutil,3)
									ENDIF
								ENDIF
							ENDIF
						ELSE
							if paso=0
								if cond=2
									thisform.text4.value=cur_arti.art_precio
								ELSE
									thisform.text4.value=cur_arti.art_precio+cur_arti.art_precio*iif(cur_arti.art_alicuota=1,impiva1,impiva2)/100
								ENDIF
							ENDIF
						ENDIF
						IF ISNULL(thisform.text4.value)
							thisform.text4.Value=0
						ENDIF
					desconectar_db(frmcualart)
					SET DECIMALS TO
				ELSE
					thisform.text7.Style= 1
					thisform.text8.Style= 1
					thisform.text4.value=0
					thisform.text5.value=0
					thisform.btn_cotiz.Visible= .F.
					thisform.cmd_masdes.Visible= .F.
				endif
				do case
					case cur_arti.art_alicuota=1
						thisform.text12.value=allt(str(impiva1,10,2))
					case cur_arti.art_alicuota=2
						thisform.text12.value=allt(str(impiva2,10,2))
				endcase
				thisform.command4.enabled=.T.
			else
				messagebox("Artículo no está en archivo",0+48,"Advertencia")
				this.value=0
				return 0
			endif
		endif
	ENDPROC

	PROCEDURE Text13.Click
		if this.value>0
			do form consrapcosto with thisform.text1.value
		endif
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.LostFocus
		if cur_arti.art_codi=4 or cur_arti.art_codi=5
			do form artsincodi with descrip
			thisform.text3.visible=.F.
			thisform.text3.value=descrip
			thisform.edit1.value=descrip
			thisform.edit1.visible=.T.
			codigo=1
		endif
		thisform.text4.setfocus
		
	ENDPROC

	PROCEDURE Text3.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Text3.LostFocus
		capslock(.F.)
		this.readonly=.T.
		thisform.text4.setfocus
	ENDPROC

	PROCEDURE Text4.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text4.LostFocus
		with thisform
		*!*		.label15.caption="Dto: "+allt(str(100-(this.value*100/iif(cond=2,cur_arti.art_precio,cur_arti.art_precio+cur_arti.art_precio*ConverNro(.text12.value)/100)),10,2))+" %"
			.text5.value=.text2.value*this.value
		endwith
	ENDPROC

	PROCEDURE Text5.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			SET POINT TO ","
			codigo=thisform.text1.value
			cant=allt(str(thisform.text2.value,10,3))
			descri=ALLTRIM(thisform.text3.value)
			pruni=allt(str(thisform.text4.value,15,3))
			prtot=allt(str(this.value,15,2))
			SET POINT TO
			if allt(thisform.text3.value)<>allt(cur_arti.art_desc) and codigo>5
				frmcualart= conectar_db(_screen.cn)
					SQLEXEC(frmcualart,"select * from articulos_clientes where cli_codi=?codicli and art_codi=?codigo;","cur_arcli")
				desconectar_db(frmcualart)
				IF RECCOUNT("cur_arcli")>0
					if allt(thisform.text3.value)<>allt(cur_arcli.artcli_desc)
						frmcualart= conectar_db(_screen.cn)
							LOCAL xdes
							xdes=allt(thisform.text3.value)
							SQLEXEC(frmcualart,"update articulos_clientes set artcli_desc=?xdes where artcli_codi=?cur_arcli.artcli_codi;")
						desconectar_db(frmcualart)
					endif
					LOCAL xcadena
					xcadena=ALLTRIM(STR(cur_arcli.artcli_codi))+ALLTRIM(descri)
					frmcualart= conectar_db(_screen.cn)
						SQLEXEC(frmcualart,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
					desconectar_db(frmcualart)
					IF RECCOUNT("cur_ddes")=0
						frmcualart= conectar_db(_screen.cn)
							SQLEXEC(frmcualart,"select CAST(dac_codi+1 as decimal(8,0)) as dac_codi from desc_articulos_clientes order by dac_codi desc limit 1;","cur_nvo")
							SQLEXEC(frmcualart,"insert into desc_articulos_clientes values(?cur_nvo.dac_codi,?cur_arcli.artcli_codi,?descri);")
						desconectar_db(frmcualart)
					endif
				ELSE
					frmcualart= conectar_db(_screen.cn)
						SQLEXEC(frmcualart,"select CAST(artcli_codi+1 as decimal(8,0)) as artcli_codi from articulos_clientes order by artcli_codi desc limit 1;","cur_nvo1")
						SQLEXEC(frmcualart,"insert into articulos_clientes values(?cur_nvo1.artcli_codi,?codigo,?codicli,?descri);" )
		
						SQLEXEC(frmcualart,"select CAST(dac_codi+1 as decimal(8,0)) as dac_codi from desc_articulos_clientes order by dac_codi desc limit 1;","cur_nvo2")
						SQLEXEC(frmcualart,"insert into desc_articulos_clientes values(?cur_nvo2.dac_codi,?cur_nvo1.artcli_codi,?descri);")
					desconectar_db(frmcualart)
				endif
			endif
			cerrar_cursor("cur_nvo")
			cerrar_cursor("cur_arcli")
			cerrar_cursor("cur_nvo1")
			cerrar_cursor("cur_nvo2")
			store 1 to localiz,muestro
			thisform.release
		endif
		
	ENDPROC

	PROCEDURE Text7.Click
		codigo=thisform.text1.value
		descri=allt(thisform.text2.value)
		do form pendclirapi with codigo,descri
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text8.Click
		codigo=thisform.text1.value
		descri=allt(thisform.text2.value)
		do form pendprovrapi with codigo,descri
		thisform.text1.setfocus
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="2" />

	*<PropValue>
		DataSource = .NULL.
		Height = 415
		Left = 1
		Name = "Dataenvironment"
		Top = 220
		Width = 792
	*</PropValue>

ENDDEFINE

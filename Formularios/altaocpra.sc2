	PROCEDURE Text1.GotFocus
		codigo=0
		opcion=0
		valorcadena=thisform.valorcadena
		codiprov=thisform.codiprov
		on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		if localiz=1
			if elimi=0
				thisform.grid1.toprow=thisform.nitem
			else
				elimi=0
			endif
		endif
	ENDPROC

	PROCEDURE Text13.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text19.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			local acuaux,auxiva,ivadif,ivaitem
			acuaux=0
			auxiva=0
			ivadif=0
			ivaitem=0
			for i=1 to .grid1.rows-1
				.grid1.row=i
				.grid1.col=7
				if len(.grid1.text)>0
					ivaitem=ConverNro(.grid1.text)
					.grid1.col=6
					dto=ConverNro(.grid1.text)*this.value/100
					acuaux=acuaux+(ConverNro(.grid1.text)-dto)
					dto=ConverNro(.grid1.text)-dto
					ivaitem=dto*ivaitem/100
					ivadif=ivadif+ivaitem
				endif
			next i
			dtotot=ROUND(thisform.acu*this.value/100,2)
			.text17.value=dtotot
			.text18.value=ROUND(thisform.acu-dtotot,2)
			if cur_prov.cond_codi=2
				dife=ROUND(thisform.acu-dtotot-acuaux,2)
				auxiva=ROUND(dife*thisform.impiva1/100,2)
				.text9.value=ROUND(auxiva+ivadif,2)
			endif
			.text10.value=ROUND(.text18.value+.text9.value+.text11.value,2)
		endwith
		
	ENDPROC

	PROCEDURE Text20.GotFocus
		codigo=0
		opcion=0
		valorcadena=thisform.valorcadena
		codiprov=thisform.codiprov
		on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		
	ENDPROC

ENDDEFINE


	PROCEDURE Command2.Click
		if thisform.nitem=0
			messagebox("Aún no ha ingresado ningún artículo a la Orden de Compra, imposible Terminar"+chr(13)+ ;
					   "Ingrese algún artículo presionando la tecla INSERT. Si desea salir de la"+chr(13)+ ; 
					   "rutina utilize el botón Salir o presione la tecla ESC",48,"Advertencia")
		else
			preg=messagebox("¿Confirma los datos de la Orden de Compra?",4+32+256,"Ordenes de Compra")
			if preg=6
				with thisform
					LOCAL xcodip,xfecha,xref,xdto,xcoti,xdasc,xarti,xdap,xcant,xprec,xaroc, xmone, lnLock
					lnLock = 0
					xmone = _screen.moneocpra
					xfecha=.text13.value
					xdto=.text19.value
					xref=ALLTRIM(.text20.value)
					frmaltac= conectar_db(_screen.cn)
						SQLEXEC(frmaltac,"select param_impo from parametros where param_codi=9;","cur_coti")
						xcoti=cur_coti.param_impo
					desconectar_db(frmaltac)
					IF thisform.nocpra=0
						frmaltac= conectar_db(_screen.cn)
							lnLock = MySQL_LockTables("LOCK", "compras WRITE", frmaltac)
							SQLEXEC(frmaltac,"select cast(orden_codi+1 as DECIMAL(8,0)) as orden_codi from compras order by orden_codi desc limit 1;","cur_nvoc")
							thisform.nocpra=cur_nvoc.orden_codi
							xcodip=thisform.nocpra
							SQLEXEC(frmaltac,"insert into compras values(?xcodip,?xfecha,?thisform.codiprov,?xref,?obser,?xdto,?coditran,?codiva,'','',?xcoti,?xmone);")
							lnLock = MySQL_LockTables("UNLOCK", "", frmaltac)
						desconectar_db(frmaltac)
						thisform.nitem=0
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								.grid1.col=3
								if val(.grid1.text)<=5
									.grid1.col=4
									xdasc=ALLTRIM(.grid1.text)
								else
									xdasc=""
								endif
								.grid1.col=3
								xarti=val(.grid1.text)
								.grid1.col=4
								frmaltac= conectar_db(_screen.cn)
									SQLEXEC(frmaltac,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
								desconectar_db(frmaltac)
								if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
									frmaltac= conectar_db(_screen.cn)
										SQLEXEC(frmaltac,"select * from articulos_proveedores where prov_codi=?thisform.codiprov and art_codi=?xarti;","cur_artpro")
									desconectar_db(frmaltac)
									IF RECCOUNT("cur_artpro")>0
										LOCAL xcadena
										xcadena=ALLTRIM(STR(cur_artpro.artpro_codi))+ALLTRIM(.grid1.text)
										frmaltac= conectar_db(_screen.cn)
											SQLEXEC(frmaltac,"select * from desc_articulos_proveedores where concat(cast(artpro_codi as char),TRIM(dap_desc))=?xcadena;","cur_ddes")
										desconectar_db(frmaltac)
										IF RECCOUNT("cur_ddes")>0
											xdap=cur_ddes.dap_codi
										endif
									endif
								else
									xdap=0
								endif
								.grid1.col=1
								xcant=ConverNro(.grid1.text)			
								.grid1.col=5
								xprec=ConverNro(.grid1.text)
								frmaltac= conectar_db(_screen.cn)
									lnLock = MySQL_LockTables("LOCK", "compras_articulos WRITE", frmaltac)
									SQLEXEC(frmaltac,"select cast(artord_codi+1 as DECIMAL(8,0)) as artord_codi from compras_articulos order by artord_codi desc limit 1;","cur_ordnva")
									SQLEXEC(frmaltac,"insert into compras_articulos values(?cur_ordnva.artord_codi,?xcodip,?xarti,?xprec,?xcant,0,?xdasc,0,?xdap,0);")
									lnLock = MySQL_LockTables("UNLOCK", "", frmaltac)
		*!*								SQLEXEC(frmaltac,"update articulos set pedprov = pedprov + ?xcant where art_codi = ?xarti;")
								desconectar_db(frmaltac)
								IF xarti > 5
									Campo_ppr(xarti)
								ENDIF
							ENDIF
							thisform.nitem=thisform.nitem+1
						next fila
						thisform.nitem=thisform.nitem-1
					ELSE
						xcodip=thisform.nocpra
						frmaltac= conectar_db(_screen.cn)
							SQLEXEC(frmaltac,"update compras set orden_fech=?xfecha,prov_codi=?thisform.codiprov,orden_ref=?xref,orden_obser=?obser,orden_dto=?xdto,tran_codi=?coditran,iva_codi=?codiva,cotiz_dolar=?xcoti,moneda=?xmone where orden_codi=?xcodip;")
						desconectar_db(frmaltac)
						IF USED("delitems")
							SELECT delitems
							LOCATE
							LOCAL xap
							SCAN
								xap= delitems.artord_codi
								frmaltaped= conectar_db(_screen.cn)
		*!*								IF delitems.art_codi > 5
		*!*									SQLEXEC(frmaltaped,"update articulos set pedprov = pedprov - ?delitems.artord_cant where art_codi = ?delitems.art_codi;")
		*!*								ENDIF
									SQLEXEC(frmaltaped, "delete from compras_articulos where artord_codi = ?xap;")
								desconectar_db(frmaltaped)
								IF delitems.art_codi > 5
									Campo_ppr(delitems.art_codi)
								ENDIF						
							ENDSCAN
							cerrar_cursor("delitems")
						ENDIF
						thisform.nitem=0
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								.grid1.col=3
								if val(.grid1.text)=4 OR val(.grid1.text)=5
									.grid1.col=4
									xdasc=ALLTRIM(.grid1.text)
								else
									xdasc=""
								endif
								.grid1.col=3
								xarti=val(.grid1.text)
								.grid1.col=4
								frmaltac= conectar_db(_screen.cn)
									SQLEXEC(frmaltac,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
								desconectar_db(frmaltac)
								if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
									frmaltac= conectar_db(_screen.cn)
										SQLEXEC(frmaltac,"select * from articulos_proveedores where prov_codi=?thisform.codiprov and art_codi=?xarti;","cur_artpro")
									desconectar_db(frmaltac)
									IF RECCOUNT("cur_artpro")>0
										LOCAL xcadena
										xcadena=ALLTRIM(STR(cur_artpro.artpro_codi))+ALLTRIM(.grid1.text)
										frmaltac= conectar_db(_screen.cn)
											SQLEXEC(frmaltac,"select * from desc_articulos_proveedores where concat(cast(artpro_codi as char),TRIM(dap_desc))=?xcadena;","cur_ddes")
										desconectar_db(frmaltac)
										IF RECCOUNT("cur_ddes")>0
											xdap=cur_ddes.dap_codi
										endif
									endif
								else
									xdap=0
								endif
								.grid1.col=1
								xcant=ConverNro(.grid1.text)			
								.grid1.col=5
								xprec=ConverNro(.grid1.text)
								.grid1.col=8
								xaroc=VAL(.grid1.text)						
								frmaltac= conectar_db(_screen.cn)
									IF xaroc>0
		*!*									IF USED("cur_modic")
		*!*										SELECT cur_modic
		*!*										LOCATE
		*!*										SCAN
		*!*											artmodi = cur_modic.m_artcod
		*!*											canmodi = cur_modic.m_artcan
		*!*											SQLEXEC(frmaltac,"update articulos set pedprov = pedprov - ?canmodi where art_codi = ?artmodi;")
		*!*										ENDSCAN
		*!*										cerrar_cursor("cur_modic")
		*!*									ENDIF
										SELECT act_pend FROM cur_penp WHERE artord_codi = xaroc INTO ARRAY ar_xactp
										SELECT ROUND(act_pend - ant_pend,3) fpend FROM cur_penp WHERE artord_codi = xaroc INTO ARRAY ar_xpendi
										xdelpend = ar_xpendi[1,1]
										SQLEXEC(frmaltac,"update compras_articulos set art_codi=?xarti,artord_precio=?xprec,artord_cant=?xcant,artord_dasc=?xdasc,dap_codi=?xdap where artord_codi=?xaroc;")
		*!*									IF ar_xactp[1,1] <> 0
		*!*										SQLEXEC(frmaltac,"update articulos set pedprov = pedprov + ?xdelpend where art_codi = ?xarti;")
		*!*									ENDIF
									ELSE
										lnLock = MySQL_LockTables("LOCK", "compras_articulos WRITE", frmaltac)
										SQLEXEC(frmaltac,"select cast(artord_codi+1 as DECIMAL(8,0)) as artord_codi from compras_articulos order by artord_codi desc limit 1;","cur_ordnva")
										IF RECCOUNT("cur_ordnva")>0
											xaroc=cur_ordnva.artord_codi
										ELSE
											xaroc=1
										ENDIF
										SQLEXEC(frmaltac,"insert into compras_articulos values(?cur_ordnva.artord_codi,?xcodip,?xarti,?xprec,?xcant,0,?xdasc,0,?xdap,0);")
										lnLock = MySQL_LockTables("UNLOCK", "", frmaltac)								
		*!*									SQLEXEC(frmaltac,"update articulos set pedprov = pedprov + ?xcant where art_codi = ?xarti;")
										.grid1.col=8
										.grid1.text=STR(cur_ordnva.artord_codi)	
										IF xarti > 5
											Campo_ppr(xarti)
										ENDIF
									ENDIF
								desconectar_db(frmaltac)
								IF xarti > 5
									Campo_ppr(xarti)
								ENDIF
							ENDIF
							thisform.nitem=thisform.nitem+1
						next fila
						thisform.nitem=thisform.nitem-1
						cerrar_cursor("cur_penp")
					ENDIF
					cantreg=.grid1.rows-1
					ivari=.text9.value
					ivarni=.text11.value
					totalri=.text18.value+.text9.value
					totalrni=.text18.value+.text9.value+.text11.value
					totsiva=.text18.value
					totcpra=totsiva+ivari+ivarni
				ENDWITH
				SET DECIMALS TO 4
				frmaltac= conectar_db(_screen.cn)
					SQLEXEC(frmaltac,"select b.*,c.*,d.cond_desc from compras a inner join iva b on a.iva_codi=b.iva_codi inner join proveedores c on c.prov_codi=a.prov_codi inner join condiva d on c.cond_codi=d.cond_codi where a.orden_codi=?xcodip;","cur_datvar")
					SQLEXEC(frmaltac,"select a.*,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on c.provi_codi=a.provi_codi where a.loca_codi=?cur_datvar.loca_codi;","cur_ubic")
					SQLEXEC(frmaltac,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dap_desc from compras_articulos a inner join articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_proveedores c on c.dap_codi=a.dap_codi where a.orden_codi=?xcodip order by a.artord_codi;","cur_arcom")
					SQLEXEC(frmaltac,"select * from compras where orden_codi=?xcodip;","cur_cpra")
					SQLEXEC(frmaltac,"select * from transportes where tran_codi=?coditran;","cur_tra")
				desconectar_db(frmaltac)
				SET DATABASE TO
				SET POINT TO ","
				SET SEPARATOR TO "."
				SELECT cur_arcom
				GO top		
				lg=messagebox("¿Imprime esta Orden de Compra con membrete?",4+32+0,"Ordenes de Compra")
				report form ordendecompra for cur_cpra.orden_codi=xcodip to printer prompt noconsole
				thisform.release
			endif
		endif
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		do case
		CASE thisform.nitem=0
			messagebox("Aún no ha ingresado ningún artículo a la Orden de Compra, imposible Guardar",48,"Advertencia")
		OTHERWISE
			with thisform
				LOCAL xcodip,xfecha,xref,xdto,xcoti,xdasc,xarti,xdap,xcant,xprec,xcant,xaroc,xmone,lnLock
				lnLock = 0
				xmone = _screen.moneocpra
				xfecha=.text13.value
				xdto=.text19.value
				xref=ALLTRIM(.text20.value)
				frmaltac= conectar_db(_screen.cn)
					SQLEXEC(frmaltac,"select param_impo from parametros where param_codi=14;","cur_coti")
					xcoti=cur_coti.param_impo
				desconectar_db(frmaltac)
				IF thisform.nocpra=0
					frmaltac= conectar_db(_screen.cn)
						lnLock = MySQL_LockTables("LOCK", "compras WRITE", frmaltac)
						SQLEXEC(frmaltac,"select cast(orden_codi+1 as DECIMAL(8,0)) as orden_codi from compras order by orden_codi desc limit 1;","cur_nvoc")
						thisform.nocpra=cur_nvoc.orden_codi
						xcodip=thisform.nocpra
						SQLEXEC(frmaltac,"insert into compras values(?xcodip,?xfecha,?thisform.codiprov,?xref,?obser,?xdto,?coditran,?codiva,'','',?xcoti,?xmone);")
						lnLock = MySQL_LockTables("UNLOCK", "", frmaltac)
					desconectar_db(frmaltac)
					thisform.nitem=0
					for fila=1 to .grid1.rows
						if fila<.grid1.rows
							.grid1.row=fila
							.grid1.col=3
							if val(.grid1.text)<=5
								.grid1.col=4
								xdasc=ALLTRIM(.grid1.text)
							else
								xdasc=""
							endif
							.grid1.col=3
							xarti=val(.grid1.text)
							.grid1.col=4
							frmaltac= conectar_db(_screen.cn)
								SQLEXEC(frmaltac,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
							desconectar_db(frmaltac)
							if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
								frmaltac= conectar_db(_screen.cn)
									SQLEXEC(frmaltac,"select * from articulos_proveedores where prov_codi=?thisform.codiprov and art_codi=?xarti;","cur_artpro")
								desconectar_db(frmaltac)
								IF RECCOUNT("cur_artpro")>0
									LOCAL xcadena
									xcadena=ALLTRIM(STR(cur_artpro.artpro_codi))+ALLTRIM(.grid1.text)
									frmaltac= conectar_db(_screen.cn)
										SQLEXEC(frmaltac,"select * from desc_articulos_proveedores where concat(cast(artpro_codi as char),TRIM(dap_desc))=?xcadena;","cur_ddes")
									desconectar_db(frmaltac)
									IF RECCOUNT("cur_ddes")>0
										xdap=cur_ddes.dap_codi
									endif
								endif
							else
								xdap=0
							endif
							.grid1.col=1
							xcant=ConverNro(.grid1.text)			
							.grid1.col=5
							xprec=ConverNro(.grid1.text)
							frmaltac= conectar_db(_screen.cn)
								lnLock = MySQL_LockTables("LOCK", "compras_articulos WRITE", frmaltac)
								SQLEXEC(frmaltac,"select cast(artord_codi+1 as DECIMAL(8,0)) as artord_codi from compras_articulos order by artord_codi desc limit 1;","cur_ordnva")
								SQLEXEC(frmaltac,"insert into compras_articulos values(?cur_ordnva.artord_codi,?xcodip,?xarti,?xprec,?xcant,0,?xdasc,0,?xdap,0);")
								lnLock = MySQL_LockTables("UNLOCK", "", frmaltac)
		*!*							SQLEXEC(frmaltac,"update articulos set pedprov = pedprov + ?xcant where art_codi = ?xarti;")
							desconectar_db(frmaltac)
							.grid1.col=8
							.grid1.text=ALLTRIM(STR(cur_ordnva.artord_codi))
							IF xarti > 5
								Campo_ppr(xarti)
							ENDIF
						ENDIF
						thisform.buscar_pend(xcodip)
						thisform.nitem=thisform.nitem+1
					next fila
					thisform.nitem=thisform.nitem-1
				ELSE
					xcodip=thisform.nocpra
					frmaltac= conectar_db(_screen.cn)
						SQLEXEC(frmaltac,"update compras set orden_fech=?xfecha,prov_codi=?thisform.codiprov,orden_ref=?xref,orden_obser=?obser,orden_dto=?xdto,tran_codi=?coditran,iva_codi=?codiva,cotiz_dolar=?xcoti,moneda=?xmone where orden_codi=?xcodip;")
					desconectar_db(frmaltac)
					IF USED("delitems")
						SELECT delitems
						LOCATE
						LOCAL xap
						SCAN
							xap= delitems.artord_codi
							frmaltaped= conectar_db(_screen.cn)
		*!*							IF delitems.art_codi > 5
		*!*								SQLEXEC(frmaltaped,"update articulos set pedprov = pedprov - ?delitems.artord_cant where art_codi = ?delitems.art_codi;")
		*!*							ENDIF
								SQLEXEC(frmaltaped, "delete from compras_articulos where artord_codi = ?xap;")
							desconectar_db(frmaltaped)
							IF delitems.art_codi > 5
								Campo_ppr(delitems.art_codi)
							ENDIF					
						ENDSCAN
						cerrar_cursor("delitems")
					ENDIF
					thisform.nitem=0
					for fila=1 to .grid1.rows
						if fila<.grid1.rows
							.grid1.row=fila
							.grid1.col=3
							if val(.grid1.text)=4 OR val(.grid1.text)=5
								.grid1.col=4
								xdasc=ALLTRIM(.grid1.text)
							else
								xdasc=""
							endif
							.grid1.col=3
							xarti=val(.grid1.text)
							.grid1.col=4
							frmaltac= conectar_db(_screen.cn)
								SQLEXEC(frmaltac,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
							desconectar_db(frmaltac)
							if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
								frmaltac= conectar_db(_screen.cn)
									SQLEXEC(frmaltac,"select * from articulos_proveedores where prov_codi=?thisform.codiprov and art_codi=?xarti;","cur_artpro")
								desconectar_db(frmaltac)
								IF RECCOUNT("cur_artpro")>0
									LOCAL xcadena
									xcadena=ALLTRIM(STR(cur_artpro.artpro_codi))+ALLTRIM(.grid1.text)
									frmaltac= conectar_db(_screen.cn)
										SQLEXEC(frmaltac,"select * from desc_articulos_proveedores where concat(cast(artpro_codi as char),TRIM(dap_desc))=?xcadena;","cur_ddes")
									desconectar_db(frmaltac)
									IF RECCOUNT("cur_ddes")>0
										xdap=cur_ddes.dap_codi
									endif
								endif
							else
								xdap=0
							endif
							.grid1.col=1
							xcant=ConverNro(.grid1.text)			
							.grid1.col=5
							xprec=ConverNro(.grid1.text)
							.grid1.col=8
							xaroc=VAL(.grid1.text)					
							frmaltac= conectar_db(_screen.cn)
								IF xaroc>0
		*!*								IF USED("cur_modic")
		*!*									SELECT cur_modic
		*!*									LOCATE
		*!*									SCAN
		*!*										artmodi = cur_modic.m_artcod
		*!*										canmodi = cur_modic.m_artcan
		*!*										SQLEXEC(frmaltac,"update articulos set pedprov = pedprov - ?canmodi where art_codi = ?artmodi;")
		*!*									ENDSCAN
		*!*									cerrar_cursor("cur_modic")
		*!*								ENDIF
									SELECT act_pend FROM cur_penp WHERE artord_codi = xaroc INTO ARRAY ar_xactp
									SELECT ROUND(act_pend - ant_pend,3) fpend FROM cur_penp WHERE artord_codi = xaroc INTO ARRAY ar_xpendi
									xdelpend = ar_xpendi[1,1]
									SQLEXEC(frmaltac,"update compras_articulos set art_codi=?xarti,artord_precio=?xprec,artord_cant=?xcant,artord_dasc=?xdasc,dap_codi=?xdap where artord_codi=?xaroc;")
		*!*								IF ar_xactp[1,1] <> 0
		*!*									SQLEXEC(frmaltac,"update articulos set pedprov = pedprov + ?xdelpend where art_codi = ?xarti;")
		*!*								ENDIF
								ELSE
									lnLock = MySQL_LockTables("LOCK", "compras_articulos WRITE", frmaltac)
									SQLEXEC(frmaltac,"select cast(artord_codi+1 as DECIMAL(8,0)) as artord_codi from compras_articulos order by artord_codi desc limit 1;","cur_ordnva")
									IF RECCOUNT("cur_ordnva")>0
										xaroc=cur_ordnva.artord_codi
									ELSE
										xaroc=1
									ENDIF
									SQLEXEC(frmaltac,"insert into compras_articulos values(?cur_ordnva.artord_codi,?xcodip,?xarti,?xprec,?xcant,0,?xdasc,0,?xdap,0);")
									lnLock = MySQL_LockTables("UNLOCK", "", frmaltac)
		*!*								SQLEXEC(frmaltac,"update articulos set pedprov = pedprov + ?xcant where art_codi = ?xarti;")
									.grid1.col=8
									.grid1.text=STR(cur_ordnva.artord_codi)	
								ENDIF					
							desconectar_db(frmaltac)
							IF xarti > 5
								Campo_ppr(xarti)
							ENDIF
						ENDIF
						thisform.nitem=thisform.nitem+1
					next fila
					thisform.nitem=thisform.nitem-1
					cerrar_cursor("cur_penp")
					thisform.buscar_pend(xcodip)
				ENDIF
			ENDWITH
			MESSAGEBOX("Los datos fueron guardados corréctamente.",64,"Aviso del Sistema")
		ENDCASE
	ENDPROC


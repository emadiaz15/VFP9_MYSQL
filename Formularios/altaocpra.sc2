	PROCEDURE Activate
		LOCAL modisi,auxmon
		modisi=0
		auxmon=''
		if thisform.codiprov>0
			_screen.xopcpra="CO"
			impiva1=thisform.impiva1
			impiva2=thisform.impiva2
			valorcadena=thisform.valorcadena
			codiprov=thisform.codiprov
			on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		set exact on
		if codigo=0
			muestro=0
		endif
		if muestro=1
			with thisform
				frmaltac= conectar_db(_screen.cn)
		*!*		*---------------------ANTES-----------------------------------*
		*!*		SQLEXEC(frmaltac, "select * from articulos where art_codi=?codigo;","cur_arti")
		*!*	    *-------------------------------------------------------------*
				
				*---------------------DESPUES-----------------------------------*
				SQLEXEC(frmaltac, ;
				"SELECT a.*, IFNULL(m.estado, 1) AS estado_metricas " + ;
				"FROM articulos a " + ;
				"LEFT JOIN art_metricas m ON m.art_codi = a.art_codi " + ;
				"WHERE a.art_codi = ?codigo;", ;
				"cur_arti")
				desconectar_db(frmaltac)
				*=========================================================
				* BLOQUE CONTROL ESTADO COMPRA - art_metricas.estado
				* Solo aplica para artículos reales: art_codi > 5
				*
				* MsgBoxEx devuelve:
				*   1 = Cancelar
				*   2 = Agregar y Activar
				*   3 = Ignorar
				*=========================================================
				LOCAL lnEstadoCompra, lnRespEstado, lnArtEstado
				LOCAL conhp, conilu
				lnArtEstado = codigo
				lnEstadoCompra = 1
				IF lnArtEstado > 5
					IF USED("cur_arti") AND RECCOUNT("cur_arti") > 0
						lnEstadoCompra = VAL(TRANSFORM(cur_arti.estado_metricas))
					ENDIF
					IF lnEstadoCompra = 0
						lnRespEstado = MsgBoxEx( ;
							"El artículo está INACTIVO para compras." + CHR(13) + CHR(13) + ;
							"Cancelar = No agregar" + CHR(13) + ;
							"Activar  = Activar artículo y agregar" + CHR(13) + ;
							"Ignorar  = Agregar igual y mantener INACTIVO", ;
							"!", ;
							"Artículo inactivo para compras", ;
							"Cancelar,Activar,Ignorar")
						DO CASE
							*-----------------------------------------------------
							* CANCELAR
							* No agrega el artículo al grid
							*-----------------------------------------------------
							CASE lnRespEstado = 1
								codigo = 0
								muestro = 0
								RETURN
							*-----------------------------------------------------
							* AGREGAR Y ACTIVAR
							* Primero confirma activación.
							* Si confirma, actualiza art_metricas.estado = 1
							* en HP + ILUMET y deja continuar el alta.
							*-----------------------------------------------------
							CASE lnRespEstado = 2
								IF MsgBoxEx( ;
									"¿Confirma activar este artículo para compras?", ;
									"?", ;
									"Confirmar activación", ;
									"No,Sí") <> 2
									
									codigo = 0
									muestro = 0
									RETURN
		
								ENDIF
								*=================================================
								* BLOQUE HP ELECTRICIDAD - DB PRINCIPAL
								*=================================================
								conhp = conectar_db(_screen.cn)
		
								IF VARTYPE(conhp) = "N" AND conhp > 0
		
									SQLEXEC(conhp, ;
										"INSERT INTO art_metricas (art_codi, estado) " + ;
										"VALUES (?lnArtEstado, 1) " + ;
										"ON DUPLICATE KEY UPDATE estado = 1;")
		
									desconectar_db(conhp)
								ENDIF
								*=================================================
								* BLOQUE ILUMET - DB EXTERNA
								*=================================================
								conilu = conectar_db(_screen.xconext)
								IF VARTYPE(conilu) = "N" AND conilu > 0
									SQLEXEC(conilu, ;
										"INSERT INTO art_metricas (art_codi, estado) " + ;
										"VALUES (?lnArtEstado, 1) " + ;
										"ON DUPLICATE KEY UPDATE estado = 1;")
									desconectar_db(conilu)
								ENDIF
							*-----------------------------------------------------
							* IGNORAR
							* Agrega igual y mantiene art_metricas.estado = 0
							* No toca la DB.
							*-----------------------------------------------------
							CASE lnRespEstado = 3
								* Sigue normal
						ENDCASE
					ENDIF
				ENDIF
				*-------------------------NUEVO HASTA AQUI-----------------------------------------*
				localiz=1
				SET POINT TO "."
				if paso=1
					SET POINT TO "."
					.grid1.col=0
					.grid1.text=allt(str(aux))
					.grid1.col=1
					.grid1.text=allt(cant)
					.grid1.col=2
					.grid1.text=cur_arti.art_med
					.grid1.col=3
					cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
					.grid1.text=cadena
					.grid1.col=4
					if codigo<=5
						.grid1.text=allt(descrip)
					else
						.grid1.text=allt(descri)
					endif
					.grid1.col=5
					.grid1.text=allt(pruni)
					.grid1.col=6
					thisform.acu=thisform.acu-ConverNro(.grid1.text)
					.grid1.text=prtot
					if .text19.value>0
						auxiva=auxiva-(auxiva*.text19.value/100)
						auximpo=auximpo-(auximpo*.text19.value/100)
					ENDIF
					.grid1.col=8
					xaroc=VAL(.grid1.text)
					do case
						case cur_arti.art_alicuota=1
							if cond=2
								if auxali=1
									thisform.impo1=thisform.impo1-auximpo
								else
									thisform.impo2=thisform.impo2-auximpo
								endif
							else
								if auxali=1
									thisform.acun1=thisform.acun1-auximpo
								else
									thisform.acun2=thisform.acun2-auximpo
								endif
							endif
						case cur_arti.art_alicuota=2
							if cond=2
								if auxali=2
									thisform.impo2=thisform.impo2-auximpo
								else
									thisform.impo1=thisform.impo1-auximpo
								endif
							else
								if auxali=2
									thisform.acun2=thisform.acun2-auximpo
								else
									thisform.acun1=thisform.acun1-auximpo
								endif
							endif
					endcase
					thisform.acu=thisform.acu+CAST(STRTRAN(prtot,",",".") AS N(15,2))
					.grid1.col=4
					if len(allt(.grid1.text))>47
						div=len(allt(.grid1.text))/47
						if div>int(div)
							longdes=int(div)+1
						else
							longdes=div
						endif
						longdes=longdes*240
						.grid1.rowheight(.grid1.row)=longdes
					else
						.grid1.rowheight(.grid1.row)=270
					ENDIF
					.grid1.col=7
					do case
						case cur_arti.art_alicuota=1
							.grid1.text=allt(str(thisform.impiva1,10,2))
						case cur_arti.art_alicuota=2
							.grid1.text=allt(str(thisform.impiva2,10,2))
					ENDCASE
					thisform.format_cells()
					IF USED("cur_penp")
						IF dato1<>codigo
		*!*						IF !USED("cur_modic")
		*!*							CREATE CURSOR cur_modic(m_artcod N(8),m_artcan N(15,3))
		*!*						ENDIF
		*!*						INSERT INTO cur_modic values(dato1, ConverNro(dato2))
							UPDATE cur_penp SET art_codi = codigo, ant_pend = 0, act_pend = ConverNro(cant) ;
								 WHERE art_codi = dato1 AND artord_codi = xaroc
							IF dato1 > 5
								Campo_ppr(dato1)
							ENDIF
						ELSE
							UPDATE cur_penp SET act_pend = ConverNro(cant) WHERE art_codi = codigo AND artord_codi = xaroc
						ENDIF
					ENDIF
					codigo=0
					localiz=1
					paso=0
					SET POINT TO
				ELSE
					if insertar=0
						thisform.nitem=thisform.nitem+1
						SET POINT TO "."
						cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
						.grid1.additem(alltrim(str(thisform.nitem))+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+cadena+chr(9)+allt(descri)+chr(9)+allt(pruni)+chr(9)+prtot)
						thisform.acu=thisform.acu+CAST(STRTRAN(prtot,",",".") AS N(15,2))
						SET POINT TO
						.grid1.row=this.grid1.rows-1
						.grid1.col=4
						if len(allt(.grid1.text))>47
							div=len(allt(.grid1.text))/47
							if div>int(div)
								longdes=int(div)+1
							else
								longdes=div
							endif
							longdes=longdes*240
							.grid1.rowheight(.grid1.row)=longdes
						else
							.grid1.rowheight(.grid1.row)=270
						ENDIF
						.grid1.col=7
						do case
							case cur_arti.art_alicuota=1
								.grid1.text=allt(str(thisform.impiva1,10,2))
							case cur_arti.art_alicuota=2
								.grid1.text=allt(str(thisform.impiva2,10,2))
						ENDCASE
						thisform.format_cells()
						codigo=0
						localiz=1				
					endif
				ENDIF
				SET POINT TO
			endwith
		endif
		if localiz=1 and thisform.nitem>0
			thisform.totales(prtot)
			thisform.gridart_refresh()
		endif
		store 0 to localiz,muestro
		
	ENDPROC

	PROCEDURE buscar_pend
		LPARAMETERS xocpra
		
		frmaltac= conectar_db(_screen.cn)
			SQLEXEC(frmaltac,"SELECT art_codi, artord_codi, artord_cant ant_pend FROM compras_articulos where orden_codi = ?xocpra;","cur_cpra")
		desconectar_db(frmaltac)
		
		SELECT art_codi, artord_codi, ant_pend, CAST("0" as numeric(15,3)) act_pend FROM cur_cpra INTO CURSOR cur_penp READWRITE
		cerrar_cursor("cur_cpra")
		
		RETURN
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 8 of Altas .F.
		localiz=0
		thisform.nitem=0
		_screen.xopcpra=""
		on key label INS
		
		IF PEMSTATUS(thisform, "xGridArtBound", 5)
		    =GridArt_Unbind(thisform)
		ENDIF
		ON KEY LABEL ESC
	ENDPROC

	PROCEDURE format_cells
		WITH thisform
			.grid1.col=0
			.grid1.cellalignment=3
			.grid1.col=1
			.grid1.cellalignment=3
			.grid1.col=2
			.grid1.cellalignment=3
			.grid1.col=3
			.grid1.cellalignment=3
			.grid1.col=4
			.grid1.cellalignment=0
			.grid1.col=5
			.grid1.cellalignment=8
			.grid1.col=6
			.grid1.cellalignment=8
			.grid1.col=7
			.grid1.cellalignment=8
		ENDWITH
		
		RETURN
		
		
	ENDPROC

	PROCEDURE gridart_menu
		LOCAL lcShortcut
		
		IF thisform.grid1.Rows <= 1
		    RETURN
		ENDIF
		
		lcShortcut = SYS(2015)
		
		DEFINE POPUP (lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		=GridArt_AddStockMenuOption(lcShortcut, 1, thisform)
		=GridArt_AddStockMenuSeparator(lcShortcut, 2)
		=GridArt_AddListaComprasMenuOption(lcShortcut, 3)
		ACTIVATE POPUP (lcShortcut)
		RELEASE POPUP (lcShortcut)
		
		RETURN
	ENDPROC

	PROCEDURE gridart_refresh
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    thisform.gridart_setup()
		ELSE
		    =GridArt_ColorearGridActivex(thisform)
		ENDIF
		
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockForm(thisform)
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE gridart_setup
		SET PROCEDURE TO grid_articulos_ui ADDITIVE
		
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    =GridArt_BindActiveX(thisform, "grid1", 3, 4)
		    =GridArt_BindTooltipEvents(thisform)
		ENDIF
		
		=GridArt_ColorearGridActivex(thisform)
		
		RETURN
	ENDPROC

	PROCEDURE Init
		PARAMETERS xmoneda
		
		public cond,elimi,descrip,muestro,postal,locali,provi,opcion,transporte,x, ;
			   dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot,insertar, ;
			   impiva1,impiva2,borra,codiva,codp,coditran,buscar,localiz, ;
			   letrapor,porcodi,nitem,paso,acu,obser,auxiva,auximpo,auxali,proveedor
		STORE 0 TO auxiva,auximpo,auxali,porcodi,codped,coditran,paso,elimi,elimi,localiz,muestro,opcion, ;
				   insertar,borra,codigo,codp,dato1
		
		STORE "" TO obser,transporte,descrip
		
		set dele on
		set date british
		set cent on
		
		frmaltac= conectar_db(_screen.cn)
			SQLEXEC(frmaltac,"select param_impo from parametros where param_codi = 14;","cur_dolar")
		desconectar_db(frmaltac)
		
		thisform.xdolar=cur_dolar.param_impo
		
		cerrar_cursor("cur_dolar")
		
		thisform.nitem=0
		thisform.valorcadena=valorcadena
		thisform.acu=0
		buscar=1
		this.text13.value=date()
		STORE 0 TO this.text19.value, ;
				   this.text8.Value, ;
				   this.text17.Value, ;
				   this.text18.Value, ;
				   this.text9.Value, ;
				   this.text11.Value, ;
		           this.text10.Value		   
			   
		frmaltac= conectar_db(_screen.cn)
			SQLEXEC(frmaltac,"select * from iva order by iva_codi desc limit 1;","cur_iva")
		desconectar_db(frmaltac)
		thisform.impiva1=cur_iva.iva_1
		thisform.impiva2=cur_iva.iva_2
		codiva=iva_codi
		thisform.label12.caption=allt(str(thisform.impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(thisform.impiva2,10,2))+"%"
		proveedor=''
		do form provload with proveedor,codiprov
		STORE 0 TO localiz,muestro
		with this
			.codiprov=codiprov
			.text1.value=cur_prov.prov_nomb
			.text2.value=cur_prov.prov_domi
			.text3.value=postal
			.text4.value=locali
			.text5.value=provi
			.text6.value=cur_prov.cond_desc
			.text12.value=VAL(cur_prov.prov_cuit)
		ENDWITH
		cond=cur_prov.cond_codi
		
		DO case
			CASE UPPER(xmoneda) = 'D'
				thisform.ctn_moneda.chk_dolares.Value = 1
				thisform.edit1.Value='PRECIOS EXPRESADOS EN DOLARES'
				_screen.moneocpra='D'
			CASE UPPER(xmoneda) = 'P'
				thisform.ctn_moneda.chk_pesos.Value=1
				thisform.edit1.Value='PRECIOS EXPRESADOS EN PESOS'
				_screen.moneocpra='P'
		ENDCASE
		
		thisform.gridart_setup()
	ENDPROC

	PROCEDURE Load
		set skip of bar 2 of Proveedores .T.
	ENDPROC

	PROCEDURE pesifica_dolariza
		LPARAMETERS xopcmon
		
		SET POINT TO ","
		with thisform
			LOCAL ivaencol,xmone,xcotiz,xcanti,xcodpd
			STORE 0 TO thisform.acu,auxiva,auximpo,auxali
			STORE 0 TO thisform.impo1, ;
					   thisform.impo2, ;
					   thisform.acu1, ;
					   thisform.acu2, ;
					   thisform.acun1, ;
					   thisform.acun2
			STORE 0 TO .text8.value, ;
				       .text9.value, ;
			           .text10.value, ;
			           .text11.value, ;
			           .text17.value, ;
			           .text18.value
		
			xcotiz= thisform.xdolar
		
			FOR n=1 TO .grid1.rows-1
				.grid1.row=n
				.grid1.col=3
				xcodpd=VAL(.grid1.text)
				frmaltac= conectar_db(_screen.cn)
					SQLEXEC(frmaltac,"select * from articulos where art_codi = ?xcodpd;","cur_arti")
				desconectar_db(frmaltac)
				.grid1.col=1
				xcanti=ConverNro(.grid1.text)
				.grid1.col=5
				valor1=ConverNro(.grid1.text)
				valor2=ROUND(ICASE(xopcmon=1,valor1/xcotiz,xopcmon=2,valor1*xcotiz),3)
				.grid1.text=ALLTRIM(STR(valor2,15,3))
				xtotal = (xcanti*valor2)
				.grid1.col=6
				.grid1.text=ALLTRIM(STR(xtotal,15,2))
				thisform.acu=thisform.acu+xtotal
				thisform.totales(STR(xtotal,15,3))
			NEXT n
			if paso>0
				paso=0
			endif
		ENDWITH
		SET POINT TO
	ENDPROC

	PROCEDURE totales
		LPARAMETERS ximpo
		
		with thisform
			SET POINT TO "."
			.text8.value=ROUND(thisform.acu,2)
			.text17.value=ROUND(iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0),2)
			.text18.value=ROUND(.text8.value-.text17.value,2)
			if .text19.value>0
				do case
					case cur_arti.art_alicuota=1
						if cond=2
							thisform.impo1=thisform.impo1+(CAST(STRTRAN(ximpo,",",".") AS N(15,2))*((100-.text19.value)/100))
							if auxali=2
								.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							endif
							.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
						else
							thisform.acun1=thisform.acun1+round(((CAST(STRTRAN(ximpo,",",".") AS N(15,2))*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
							if auxali=2
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
							thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
						endif
					case cur_arti.art_alicuota=2
						if cond=2
							thisform.impo2=thisform.impo2+(CAST(STRTRAN(ximpo,",",".") AS N(15,2))*((100-.text19.value)/100))
							if auxali=1
								.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							endif
							.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
						else
							thisform.acun2=thisform.acun2+round(((CAST(STRTRAN(ximpo,",",".") AS N(15,2))*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
							if auxali=1
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
							thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
						endif
				endcase
			ELSE
				do case
					case cur_arti.art_alicuota=1
						if cond=2
							thisform.impo1=thisform.impo1+CAST(STRTRAN(ximpo,",",".") AS N(15,2))
							if auxali=2
								.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							endif
							.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
						else
							thisform.acun1=thisform.acun1+round((CAST(STRTRAN(ximpo,",",".") AS N(15,2))/(1+(thisform.impiva1/100))),3)
							if auxali=2
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
							thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
						endif
					case cur_arti.art_alicuota=2
						if cond=2
							thisform.impo2=thisform.impo2+CAST(STRTRAN(ximpo,",",".") AS N(15,2))
							if auxali=1
								.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							endif
							.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
						else
							thisform.acun2=thisform.acun2+round((CAST(STRTRAN(ximpo,",",".") AS N(15,2))/(1+(thisform.impiva2/100))),3)
							if auxali=1
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
							thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
						endif
				endcase
			endif
			.text10.value=ROUND(.text18.value+.text9.value+.text11.value,2)
			auxiva=0
			auximpo=0	
			SET POINT TO
		ENDWITH
		
		RETURN
		
	ENDPROC

	PROCEDURE btn_deta.Click
		IF LEN(ALLTRIM(cur_prov.prov_deta)) > 0
			MESSAGEBOX(ALLTRIM(cur_prov.prov_deta),64,"Detalles Adicionales del Proveedor")
		ELSE
			MESSAGEBOX("No hay detalles ingresados para este proveedor",48,"Detalles Adicionales del Proveedor")
		ENDIF
		
	ENDPROC

	PROCEDURE Check1.Click
		IF this.Value=1
			coditran=0
			thisform.text14.Value=''
		ELSE
			IF coditran=0
				this.Value=1
			endif
		endif
		
	ENDPROC

	PROCEDURE Command1.Click
		salir=messagebox("¿Seguro que desea Salir?",4+32+256,"Verifique!!!")
		if salir=6
			thisform.release
		endif
		
	ENDPROC


	PROCEDURE ctn_moneda.chk_dolares.Click
		IF this.Value=1
			IF thisform.nitem > 0
				prmon= MESSAGEBOX("¿Dolariza el total de los ítems de la orden de compra?",4+64+256,"Aviso del Sistema")
				IF prmon=6
					thisform.pesifica_dolariza(1)
				ELSE
					MESSAGEBOX("Debe modificar manualmente cada ítem.",48,"Aviso del Sistema")
				ENDIF
			ENDIF
			_screen.moneocpra='D'
			LOCAL posicar,posicarp
			STORE 0 TO posicar,posicarp
			posicar=AT("PRECIOS EXPRESADOS",thisform.edit1.Value,1)
			IF posicar>0
				posicarp=AT("PESOS",thisform.edit1.Value,1)
				IF posicarp > 0
					thisform.edit1.Value=SUBSTR(thisform.edit1.Value,28)
				ENDIF
			ENDIF
			thisform.edit1.Value='PRECIOS EXPRESADOS EN DOLARES'+thisform.edit1.Value
		ENDIF
		IF this.Value=1 AND this.Parent.chk_pesos.Value=1
			this.Parent.chk_pesos.Value=0
		ENDIF
		
	ENDPROC

	PROCEDURE ctn_moneda.chk_pesos.Click
		IF this.Value = 1
			IF thisform.nitem > 0
				prmon= MESSAGEBOX("¿Pesifica todos los ítems de la orden de compra?",4+32+256,"Aviso del Sistema")
				IF prmon=6
					thisform.pesifica_dolariza(2)
				ELSE
					MESSAGEBOX("Debe modificar manualmente cada ítem.",48,"Aviso del Sistema")
				ENDIF
			ENDIF
			_screen.moneocpra='P'
			LOCAL posicar,posicard
			STORE 0 TO posicar,posicard
			posicar=AT("PRECIOS EXPRESADOS",thisform.edit1.Value,1)
			IF posicar>0
				posicard=AT("DOLARES",thisform.edit1.Value,1)
				IF posicard > 0
					thisform.edit1.Value=SUBSTR(thisform.edit1.Value,30)
				ENDIF
			ENDIF
			thisform.edit1.Value='PRECIOS EXPRESADOS EN PESOS'+thisform.edit1.Value
		ENDIF
		IF this.Value=1 AND this.Parent.chk_dolares.Value=1
			this.Parent.chk_dolares.Value=0
		ENDIF
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockForm(thisform)
		ENDIF
	ENDPROC

	PROCEDURE grid1.DblClick
		*** ActiveX Control Event ***
		local x,y,dtopie,ivaencol
		ivaencol=0
		if thisform.nitem>0
			this.col=0
			aux=val(this.text)
			this.col=3
			dato1=val(this.text)
			this.col=1
			dato2=this.text
			this.col=4
			dato3=this.text
			this.col=5
			dato4=this.text
			this.col=6
			prtot=this.text
			this.col=2
			dato5=this.text
			auxiva=0
			auximpo=0
			frmaltac= conectar_db(_screen.cn)
				SQLEXEC(frmaltac,"select * from articulos where art_codi=?dato1;","cur_arti")
			desconectar_db(frmaltac)
			impiva1=thisform.impiva1
			impiva2=thisform.impiva2
			valorcadena=thisform.valorcadena
			do form modippreg with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		if borra=6
			with thisform
				LOCAL xdelaro,xdelart,xdelcant
				this.col=8
				xdelaro=VAL(this.text)
				this.col=3
				xdelart=VAL(this.text)
				this.col=1
				xdelcant=ConverNro(this.text)		
				IF xdelaro > 0
					IF !USED("delitems")
						CREATE CURSOR delitems(artord_codi N(8),art_codi N(8),artord_cant N(10,3))
					ENDIF
					INSERT INTO delitems values(xdelaro,xdelart,xdelcant)
				ENDIF
				if this.rows=2
					this.col=7
					do case
						case ConverNro(this.text)=thisform.impiva1
							ivaencol=1
						case ConverNro(this.text)=thisform.impiva2
							ivaencol=2
					endcase
					this.col=6
					prtot=this.text
					thisform.nitem=0
					this.rows=1
					thisform.acu=0
					thisform.impo1=0
					thisform.impo2=0
					thisform.acun1=0
					thisform.acun2=0
					thisform.acu1=0
					thisform.acu2=0
					.text8.value=0
					.text9.value=0
					.text10.value=0
					.text11.value=0
					.text17.value=0
					.text18.value=0
					.text19.value=0
					thisform.ctn_mone.lbl_mone.caption=''
					thisform.ctn_mone.Visible= .F.
					LOCAL posicar,posicarp,posicard
					STORE 0 TO posicar,posicarp,posicard,texto
					posicar=AT("PRECIOS EXPRESADOS",thisform.edit1.Value,1)
					IF posicar>0
						posicarp=AT("PESOS",thisform.edit1.Value,1)
						posicard=AT("DOLARES",thisform.edit1.Value,1)
						DO case
							CASE posicarp > 0
								thisform.edit1.Value=SUBSTR(thisform.edit1.Value,28)
							CASE posicard > 0
								thisform.edit1.Value=SUBSTR(thisform.edit1.Value,30)
						ENDCASE
					ENDIF
				else
					this.col=7
					do case
						case ConverNro(this.text)=thisform.impiva1
							ivaencol=1
						case ConverNro(this.text)=thisform.impiva2
							ivaencol=2
					endcase
					this.col=6
					prtot=this.text
					thisform.acu=thisform.acu-CAST(STRTRAN(prtot,",",".") AS N(15,2))
					thisform.nitem=thisform.nitem-1
					this.removeitem(this.row)
					this.col=2
					x=1
					y=0
					do while x<=this.rows-1
						this.row=x
						y=y+1
						this.col=0
						this.text=allt(str(y))
						x=x+1
					enddo
				endif
				thisform.text8.value=thisform.acu
				if this.rows=>2
					if thisform.text19.value>0
						dtopie=round((100-thisform.text19.value)/100,2)
						thisform.text17.value=thisform.acu*dtopie
						thisform.text18.value=thisform.acu-thisform.text17.value
						do case
							case ivaencol=1
								thisform.impo1=thisform.impo1-(CAST(STRTRAN(prtot,",",".") AS N(15,2))*dtopie)
								if cond=2
									thisform.text9.value=thisform.text9.value-round((CAST(STRTRAN(prtot,",",".") AS N(15,2))*dtopie)*thisform.impiva1/100,2)
								else
									auxacuneto=thisform.acun1
									thisform.acun1=thisform.acun1-((CAST(STRTRAN(prtot,",",".") AS N(15,2))*dtopie)/(1+(thisform.impiva1/100)))
									thisform.acu1=thisform.acu1-(auxacuneto-thisform.acun1)*thisform.impiva1/100
								endif
							case ivaencol=2
								thisform.impo2=thisform.impo2-(CAST(STRTRAN(prtot,",",".") AS N(15,2))*dtopie)
								if cond=2
									thisform.text11.value=thisform.text11.value-round((CAST(STRTRAN(prtot,",",".") AS N(15,2))*dtopie)*thisform.impiva2/100,2)
								else
									auxacuneto=thisform.acun2
									thisform.acun2=thisform.acun2-((CAST(STRTRAN(prtot,",",".") AS N(15,2))*dtopie)/(1+(thisform.impiva2/100)))
									thisform.acu2=thisform.acu2-(auxacuneto-thisform.acun2)*thisform.impiva2/100
								endif
						endcase
					else
						thisform.text18.value=thisform.acu
						do case
							case ivaencol=1
								thisform.impo1=thisform.impo1-CAST(STRTRAN(prtot,",",".") AS N(15,2))
								if cond=2				
									thisform.text9.value=thisform.text9.value-round(CAST(STRTRAN(prtot,",",".") AS N(15,2))*thisform.impiva1/100,2)
								else
									auxacuneto=thisform.acun1
									thisform.acun1=thisform.acun1-(CAST(STRTRAN(prtot,",",".") AS N(15,2))/(1+(thisform.impiva1/100)))
									thisform.acu1=thisform.acu1-(auxacuneto-thisform.acun1)*thisform.impiva1/100
								endif
							case ivaencol=2
								thisform.impo2=thisform.impo2-CAST(STRTRAN(prtot,",",".") AS N(15,2))
								if cond=2
									thisform.text11.value=thisform.text11.value-round(CAST(STRTRAN(prtot,",",".") AS N(15,2))*thisform.impiva2/100,2)
								else
									auxacuneto=thisform.acun2
									thisform.acun2=thisform.acun2-(CAST(STRTRAN(prtot,",",".") AS N(15,2))/(1+(thisform.impiva2/100)))
									thisform.acu2=thisform.acu2-(auxacuneto-thisform.acun2)*thisform.impiva2/100
								endif
						endcase
					endif
					thisform.text10.value=thisform.text18.value+thisform.text9.value+thisform.text11.value
				endif	
			endwith
			borra=0
			insertar=0
			preg=0
		ENDIF
		
		thisform.gridart_refresh()
	ENDPROC

	PROCEDURE grid1.GotFocus
		valorcadena=thisform.valorcadena
		codiprov=thisform.codiprov
		on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		*!*	if localiz=1
		*!*		if elimi=0 and nitem>0
		*!*			this.toprow=item	
		*!*		else
		*!*			elimi=0
		*!*		endif
		*!*	endif
	ENDPROC


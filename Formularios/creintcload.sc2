	PROCEDURE Activate
		if codiprov=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE Init
		parameter codiprov
		public cond,postal,provi,locali
		**,i,codifac
		proveedor=""
		postal=0
		provi=""
		locali=""
		set date british
		set cent on
		set dele on
		with thisform
			if codiprov=0
				do form provload with proveedor,codiprov,postal,provi,locali
				cond=cond_codi
				.text1.value=cur_prov.prov_nomb
				.text2.value=cur_prov.prov_domi
				.text6.value=cur_prov.cond_desc
				.text12.value=cur_prov.prov_cuit
				.text3.value=cur_prov.cp_nro
				.text4.value=cur_prov.loca_nomb
				.text5.value=cur_prov.provi_nomb
			ELSE
				frmdiclo= conectar_db(_screen.cn)
					SQLEXEC(frmdiclo,"call usp_buscarprov(?codiprov);","cur_prov")
				desconectar_db(frmdiclo)
				.text1.value=cur_prov.prov_nomb
				.text2.value=cur_prov.prov_domi
				.text6.value=cur_prov.cond_desc
				.text12.value=cur_prov.prov_cuit
				.text3.value=cur_prov.cp_nro
				.text4.value=cur_prov.loca_nomb
				.text5.value=cur_prov.provi_nomb
			ENDIF
			frmdiclo= conectar_db(_screen.cn)
				SQLEXEC(frmdiclo,"select crec_codi,crec_fech from creintc where prov_codi=?codiprov order by crec_fech,crec_codi desc;","cur_dil")
			desconectar_db(frmdiclo)
			IF RECCOUNT("cur_dil")>0
				LOCATE
				thisform.lst_dilo.RowSource="cur_dil"
				frmdiclo= conectar_db(_screen.cn)
					SQLEXEC(frmdiclo,"select crecin_desc,crecin_impo from creintc_items where crec_codi=?cur_dil.crec_codi;","cur_dialo")
				desconectar_db(frmdiclo)
				LOCATE
				IF RECCOUNT("cur_dialo")>0
					LOCATE
					SCAN
						thisform.grid1.additem(ALLTRIM(cur_dialo.crecin_desc)+chr(9)+TRANSFORM(cur_dialo.crecin_impo, "$ 999,999,999.99"))
						with thisform
							.grid1.row=.grid1.rows-1
							.grid1.col=0
							if len(allt(.grid1.text))>47
								div=len(allt(.grid1.text))/47
								if div>int(div)
									longdes=int(div)+1
								else
									longdes=div
								endif
								longdes=longdes*250
								.grid1.rowheight(.grid1.row)=longdes
							else
								.grid1.rowheight(.grid1.row)=270
							endif
							.grid1.col=0
							.grid1.cellalignment=0
							.grid1.col=1
							.grid1.cellalignment=8
						endwith		
					ENDSCAN
				endif
				thisform.lst_dilo.Selected(1)=.T.
				thisform.command2.enabled=.T.
			ENDIF
		endwith
		
		
	ENDPROC

	PROCEDURE Command1.Click
		local paso
		paso=0
		thisform.grid1.rows=1
		do form provload with proveedor,codiprov,postal,provi,locali
		WITH thisform
			.text1.value=cur_prov.prov_nomb
			.text2.value=cur_prov.prov_domi
			.text6.value=cur_prov.cond_desc
			.text12.value=cur_prov.prov_cuit
			.text3.value=cur_prov.cp_nro
			.text4.value=cur_prov.loca_nomb
			.text5.value=cur_prov.provi_nomb
			frmdiclo= conectar_db(_screen.cn)
				SQLEXEC(frmdiclo,"select crec_codi,crec_fech from creintc where prov_codi=?codiprov order by crec_fech,crec_codi desc;","cur_dil")
			desconectar_db(frmdiclo)
			IF RECCOUNT("cur_dil")>0
				thisform.lst_dilo.RowSource="cur_dil"
				frmdiclo= conectar_db(_screen.cn)
					SQLEXEC(frmdiclo,"select crecin_desc,crecin_impo from creintc_items where crec_codi=?cur_dil.crec_codi;","cur_dialo")
				desconectar_db(frmdiclo)
				IF RECCOUNT("cur_dialo")>0
					LOCATE
					SCAN
						thisform.grid1.additem(ALLTRIM(cur_dialo.crecin_desc)+chr(9)+TRANSFORM(cur_dialo.crecin_impo, "$ 999,999,999.99"))
						with thisform
							.grid1.row=.grid1.rows-1
							.grid1.col=0
							if len(allt(.grid1.text))>47
								div=len(allt(.grid1.text))/47
								if div>int(div)
									longdes=int(div)+1
								else
									longdes=div
								endif
								longdes=longdes*250
								.grid1.rowheight(.grid1.row)=longdes
							else
								.grid1.rowheight(.grid1.row)=270
							endif
							.grid1.col=0
							.grid1.cellalignment=0
							.grid1.col=1
							.grid1.cellalignment=8
						endwith		
					ENDSCAN
				ENDIF
				thisform.lst_dilo.Selected(1)=.T.
				thisform.command2.enabled=.T.
			ENDIF
		ENDWITH
	ENDPROC


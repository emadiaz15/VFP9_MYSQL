	PROCEDURE lst_dilo.Click
		local paso
		paso=0
		thisform.grid1.rows=1
		frmdiclo= conectar_db(_screen.cn)
			SQLEXEC(frmdiclo,"select crecin_desc,crecin_impo from creintc_items where crec_codi=?cur_dil.crec_codi;","cur_dialo")
		desconectar_db(frmdiclo)
		IF RECCOUNT("cur_dialo")>0
			LOCATE
			SCAN
				thisform.grid1.additem(ALLTRIM(cur_dialo.crecin_desc)+chr(9)+TRANSFORM(cur_dialo.crecin_impo, "$ 999,999,999.99"))
				with thisform
					.grid1.row=.grid1.rows-1
					.grid1.col=0
					if len(allt(.grid1.text))>47
						div=len(allt(.grid1.text))/47
						if div>int(div)
							longdes=int(div)+1
						else
							longdes=div
						endif
						longdes=longdes*250
						.grid1.rowheight(.grid1.row)=longdes
					else
						.grid1.rowheight(.grid1.row)=270
					endif
					.grid1.col=0
					.grid1.cellalignment=0
					.grid1.col=1
					.grid1.cellalignment=8
				endwith		
			ENDSCAN
		endif
		thisform.command2.enabled=.T.
	ENDPROC

	PROCEDURE lst_dilo.KeyPress
		&& creintcload.lst_dilo.keypress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = 13
		    THIS.Click()
		
		    IF THISFORM.Command2.Enabled
		        THISFORM.Command2.Click()
		    ENDIF
		
		    NODEFAULT
		ENDIF
	ENDPROC


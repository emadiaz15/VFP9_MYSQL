		*< END OBJECT: BaseClass="listbox" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackColor = 170,213,213, ;
		BackStyle = 1, ;
		Height = 292, ;
		Left = 21, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;
		Top = 29, ;
		Width = 715
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'txtprovload' AS textbox WITH ;
		BackColor = 215,215,215, ;
		FontBold = .T., ;
		Format = "!", ;
		Height = 23, ;
		Left = 45, ;
		Name = "txtprovload", ;
		TabIndex = 1, ;
		Top = 47, ;
		Width = 674
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		public f
		f=1
		thisform.lstprov.requery
		thisform.txtprovload.setfocus
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS codiper    &&,postal,provi,locali,persona
		
		PUBLIC cade
		
		frmperlo= conectar_db(_screen.cn)
			SQLEXEC(frmperlo,"call usp_buscarper(0);","cur_per")
		desconectar_db(frmperlo)
		
		GO top
		
		thisform.lstprov.RowSource="cur_per"
	ENDPROC

	PROCEDURE LostFocus
		set skip of bar 4 of Altas .T.
	ENDPROC

	PROCEDURE Unload
		**return persona
		return codiper
		**return postal
		**return provi
		**return locali
	ENDPROC

	PROCEDURE Command1.Click
		do form altaper
	ENDPROC

	PROCEDURE Command1.GotFocus
		if last()=5 or last()=24
			thisform.txtprovload.setfocus
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE lstprov.Click
		persona=cur_per.per_desc
		codiper=cur_per.per_codi
		cond=cur_per.cond_codi
		locali=cur_per.loca_nomb
		provi=cur_per.provi_nomb
		postal=cur_per.cp_nro
		if last()!=24 AND last()!=5
			thisform.release
		ENDIF
	ENDPROC

	PROCEDURE lstprov.GotFocus
		if last()=24 or last()=5
			thisform.txtprovload.setfocus
		endif
	ENDPROC

	PROCEDURE lstprov.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		ENDIF
		IF nkeycode=13
			codiper=cur_per.per_codi
			persona=ALLTRIM(cur_per.per_desc)
			thisform.release
		ENDIF
	ENDPROC

	PROCEDURE txtprovload.InteractiveChange
		if subst(allt(this.value),1,1)="?"
			SELECT cur_per
			SET FILTER TO
		endif
		if subst(allt(this.value),1,1)!="?"
			sele cur_per
			local lc
			lc = allt(This.Value)
			if last()<>127 and last()<>7
				do while !eof()
					if lc=subst(cur_per.per_desc,1,len(lc))
						exit
					else
						skip
						f=f+1
						if eof()
							go top
							f=1
							exit
						endif
					endif
				enddo
			else
				do while lc=subst(cur_per.per_desc,1,len(lc)) and f>1
					if bof()
						exit
					endif
					skip-1
					if f>1
						f=f-1
					endif
					if lc<>subst(cur_per.per_desc,1,len(lc))
						skip
						f=f+1
						exit
					endif
				enddo				
			endif
			thisform.lstprov.selected(f)=.T.
			RETURN
		ENDIF
		
		
	ENDPROC

	PROCEDURE txtprovload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
				if subst(allt(this.value),1,1)="?"
					cade=subst(allt(this.value),2,len(allt(this.value)))
					sele cur_per
					set filter to atcline(cade,per_desc)!=0
				else	
					persona=cur_per.per_desc
					codiper=cur_per.per_codi
					cond=cur_per.cond_codi
					locali=cur_per.loca_nomb
					provi=cur_per.provi_nomb
					postal=cur_per.cp_nro
					thisform.release
				endif
			case last()=5
				if f>1
					f=f-1
				endif
				thisform.lstprov.selected(f)=f
				this.value=thisform.lstprov.value
			case last()=24
				if f<thisform.lstprov.listcount
					f=f+1
				endif
				thisform.lstprov.selected(f)=f
				this.value=thisform.lstprov.value
			case last()=27
				thisform.release
		endcase
	ENDPROC

ENDDEFINE

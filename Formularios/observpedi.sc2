DEFINE CLASS observpedi AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Edit1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 206,223,217
		BorderStyle = 0
		Caption = "Observaciones para el Pedido"
		DoCreate = .T.
		Height = 205
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "OBSERVPEDI"
		Width = 672
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Aceptar", ;
		DisabledBackColor = 33,146,214, ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 288, ;
		Name = "Command1", ;
		TabIndex = 2, ;
		Themes = .F., ;
		Top = 166, ;
		Width = 110
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Edit1' AS editbox WITH ;
		AddLineFeeds = .T., ;
		Height = 109, ;
		Left = 38, ;
		Name = "Edit1", ;
		TabIndex = 1, ;
		Top = 36, ;
		Width = 591
		*< END OBJECT: BaseClass="editbox" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 206,223,217, ;
		Caption = "Observaciones", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 66, ;

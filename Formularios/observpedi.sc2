		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackStyle = 0, ;
		Height = 133, ;
		Left = 24, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;
		Top = 24, ;
		Width = 624
		*< END OBJECT: BaseClass="shape" />
	
	PROCEDURE Init
		parameter obser
		this.edit1.value=obser
	ENDPROC

	PROCEDURE Unload
		return obser
	ENDPROC

	PROCEDURE Command1.Click
		obser=allt(thisform.edit1.value)
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Edit1.GotFocus
		CAPSLOCK(.T.)
		This.SelStart = LEN(RTRIM(This.value))
	ENDPROC

	PROCEDURE Edit1.LostFocus
		CAPSLOCK(.F.)
	ENDPROC

ENDDEFINE

	PROCEDURE Activate
		set exact on
	ENDPROC

	PROCEDURE Init
		PUBLIC codicli
		
		create cursor detalle(deta C(250),importe N(16,2))
		INSERT INTO detalle (deta,importe) VALUES ('',0)
		thisform.grd_cre.RecordSource="detalle"
		
		thisform.text10.value=0
		
		codicli=0
		do form cliload with codicli
		this.text13.value=date()
		with thisform
			frmdebin= conectar_db(_screen.cn)
				SQLEXEC(frmdebin,"select MAX(crev_codi) as crev_codi from creintv order by crev_codi desc limit 1;","cur_inccre")
				IF ISNULL(cur_inccre.crev_codi) then
					thisform.text7.Value=1
				ELSE
					thisform.text7.Value=cur_inccre.crev_codi+1
				ENDIF
				cerrar_cursor("cur_inccre")
				SQLEXEC(frmdebin,"call usp_buscarcli(?codicli);","cur_clie")
			desconectar_db(frmdebin)
			.text1.value=cur_clie.cli_nomb
			.text2.value=cur_clie.cli_domi
			.text3.value=cur_clie.cp_nro
			.text4.value=cur_clie.loca_nomb
			.text5.value=cur_clie.provi_nomb
			.text6.value=cur_clie.cond_desc
			.text12.value=VAL(cur_clie.cli_cuit)
		endwith
	ENDPROC

	PROCEDURE insertar_item
		LPARAMETERS xnTecla , xoObjeto
		
		IF xnTecla=22
			LOCAL registros,contit
			registros=0
			contit=RECCOUNT("detalle")+1
			GO BOTTOM in detalle
			INSERT INTO detalle VALUES ('',0)
			registros=RECCOUNT("detalle")
		
			xoObjeto.RecordSource=''
			xoObjeto.Refresh()
			GO bott
			xoObjeto.recordsource="detalle"
			FOR x=1 TO registros
				xoObjeto.DoScroll(0)
			NEXT x
			xoObjeto.Refresh()
			xoObjeto.setfocus
		ENDIF
	ENDPROC

	PROCEDURE btn_deta.Click
		IF LEN(ALLTRIM(cur_clie.cli_deta)) > 0
			MESSAGEBOX(ALLTRIM(cur_clie.cli_deta),64,"Detalles Adicionales del Cliente")
		ELSE
			MESSAGEBOX("No hay detalles ingresados para este cliente",48,"Detalles Adicionales del Cliente")
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_salir.Click
		preg=messagebox("¿Seguro que desea salir?",4+32+256,"Verifique")
		if preg=6
			thisform.release
		endif
	ENDPROC

	PROCEDURE cmd_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_teminar.Click
		preg=messagebox("¿Confirma los datos del Crédito Interno?",4+32+256,"Aviso del Sistema")
		if preg=6
			LOCAL xcodicli,xdebcod,xfecha,xtotal,xobse,xdvincod,xdesc,ximpo
			frmdebin= conectar_db(_screen.cn)
				SQLEXEC(frmdebin,"select MAX(crev_codi) as crev_codi from creintv order by crev_codi desc limit 1;","cur_nueb")
				IF ISNULL(cur_nueb.crev_codi) then
					xdebcod=1
				ELSE
					xdebcod=cur_nueb.crev_codi+1
				ENDIF
				xfecha=thisform.text13.Value
				xtotal=thisform.text10.Value
				xobse =ALLTRIM(thisform.edit1.Value)
				xcodicli=cur_clie.cli_codi
				SQLEXEC(frmdebin,"insert into creintv values(?xdebcod,?xfecha,?xcodicli,?xtotal,?xobse,0,'');")
				SQLEXEC(frmdebin,"update clientes set cli_saldo=cli_saldo-?xtotal where cli_codi=?xcodicli;")
				SELECT detalle
				LOCATE
				SCAN
					xdesc=ALLTRIM(detalle.deta)
					ximpo=detalle.importe
					SQLEXEC(frmdebin,"select MAX(crevin_codi)+1 as crevin_codi from creintv_items order by crevin_codi desc limit 1;","cur_nvin")
					IF ISNULL(cur_nvin.crevin_codi) then
						xdvincod=1
					ELSE
						xdvincod=cur_nvin.crevin_codi	
					ENDIF
					SQLEXEC(frmdebin,"insert into creintv_items values(?xdvincod,?xdebcod,?xdesc,?ximpo);")
				ENDSCAN
				pdeb=MESSAGEBOX("¿Imprime Crédito Interno?",4+32+256,"Aviso del Sistema")
				IF pdeb=6
					SQLEXEC(frmdebin,"select param_desc as emp_desc from parametros where param_codi=13;","cur_empresa")
					SQLEXEC(frmdebin,"select * from creintv where crev_codi=?xdebcod;","cur_credito")
					SQLEXEC(frmdebin,"select * from creintv_items where crev_codi=?xdebcod;","cur_detacre")
					SELECT cur_detadeb
					GO top
					REPORT FORM creint_cliente FOR cur_detacre.crev_codi=xdebcod TO PRINTER PROMPT noconsole
					cerrar_cursor("cur_empresa")
					cerrar_cursor("cur_credito")
					cerrar_cursor("cur_detacre")
				ENDIF
			desconectar_db(frmdebin)
			thisform.release
		ENDIF
	ENDPROC

	PROCEDURE cmd_teminar.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_teminar.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Edit1.GotFocus
		CAPSLOCK(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		CAPSLOCK(.F.)
	ENDPROC

	PROCEDURE grd_cre.Column1.Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode=22
		    thisform.insertar_item(nKeyCode, thisform.grd_deb)
		ENDIF
	ENDPROC

	PROCEDURE grd_cre.Column2.Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode=22
		    thisform.insertar_item(nKeyCode, thisform.grd_deb)
		ENDIF
	ENDPROC

	PROCEDURE grd_cre.Column2.Text1.LostFocus
		IF this.Value>0
			CALCULATE SUM(detalle.importe) TO thisform.text10.Value
			thisform.cmd_teminar.Enabled= .T.
		ENDIF
		
		
	ENDPROC

	PROCEDURE Text13.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.Click
		this.setfocus
	ENDPROC

ENDDEFINE


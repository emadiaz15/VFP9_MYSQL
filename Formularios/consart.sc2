	PROCEDURE Activate
		SET POINT TO ","
		SET SEPARATOR TO "."
	ENDPROC

	PROCEDURE calc_meses
		LPARAMETERS ndias
		
		LOCAL nmeses
		
		nmeses = ndias / 30
		
		thisform.lbl_diascosto.ToolTipText='Cantidad de días equivale a '+ALLTRIM(STR(nmeses,6,1))+' meses'
		
		RETURN
	ENDPROC

	PROCEDURE Destroy
		set point to
		set separator to
		set decimals to
		
		&&Cerrar_cursores()
		
	ENDPROC

	PROCEDURE dias_actcosto
		LPARAMETERS tnArtCodi
		
		LOCAL lnConn
		
		thisform.lbl_diascosto.Caption = ""
		
		IF VARTYPE(tnArtCodi) <> "N" OR tnArtCodi <= 0
			RETURN
		ENDIF
		
		lnConn = conectar_db(_screen.cn)
		
		SQLEXEC(lnConn, ;
		"SELECT " + ;
		"  DATEDIFF(CURDATE(), DATE(hc.histo_fech)) AS dias, " + ;
		"  p.prov_nomb " + ;
		"FROM histocosto hc " + ;
		"INNER JOIN articulos_proveedores ap ON ap.artpro_codi = hc.artpro_codi " + ;
		"INNER JOIN proveedores p ON p.prov_codi = ap.prov_codi " + ;
		"WHERE ap.art_codi = ?tnArtCodi " + ;
		"ORDER BY hc.histo_fech DESC, hc.histo_codi DESC " + ;
		"LIMIT 1;", ;
		"cur_ultcosto")
		
		desconectar_db(lnConn)
		
		IF RECCOUNT("cur_ultcosto") > 0
			thisform.lbl_diascosto.Caption = ;
				ALLTRIM(ALLTRIM(STR(cur_ultcosto.dias)) + " días - Últ. actualización de costo" + CHR(13) + ;
				ALLTRIM(cur_ultcosto.prov_nomb))
			thisform.ndiascosto=cur_ultcosto.dias
		ELSE
			thisform.lbl_diascosto.Caption = "Sin historial de costos"
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE Init
		public opc,histcod,codigo,descri,impiva1,impiva2
		create cursor totped(pedidos N(10,2))
		create cursor historicostos(prov_nomb C(35),histo_fech D,histo_costo N(10,3),moneda C(1))
		opc=0
		thisform.opcion=0
		descri=""
		histcod=0
		set point to ","
		set separator to "."
		set date british
		set cent on
		set dele on
		SET TALK off
		SET ECHO OFF
		
		*!*	thisform.SetAll("Forecolor",RGB(0,225,0),"Textbox")
		*!*	thisform.SetAll("DisabledForecolor",RGB(0,225,0),"Textbox")
		*!*	thisform.SetAll("Backcolor",RGB(0,0,0),"Textbox")
		*!*	thisform.SetAll("DisabledBackcolor",RGB(0,0,0),"Textbox")
		thisform.SetAll("Fontbold",.t.,"Textbox")
		*!*	thisform.SetAll("Forecolor",RGB(0,225,0),"Editbox")
		*!*	thisform.SetAll("Backcolor",RGB(0,0,0),"Editbox")
		*!*	thisform.SetAll("DisabledForecolor",RGB(0,225,0),"Editbox")
		*!*	thisform.SetAll("DisabledBackcolor",RGB(0,0,0),"Editbox")
		thisform.SetAll("Fontbold",.t.,"Editbox")
		*!*	thisform.SetAll("Forecolor",RGB(0,225,0),"Grid")
		*!*	thisform.SetAll("Backcolor",RGB(0,0,0),"Grid")
		
		frmcart= conectar_db(_screen.cn)
			SQLEXEC(frmcart,"select MAX(iva_codi) as max_cod from iva;","cur_mcod")
			SQLEXEC(frmcart,"select iva_1,iva_2 from iva where iva_codi=?cur_mcod.max_cod;","cur_iva")
		desconectar_db(frmcart)
		
		impiva1=cur_iva.iva_1
		impiva2=cur_iva.iva_2
		this.text1.value=0
		with thisform
			.text9.value=CTOD("01"+"/"+"01"+"/"+ALLTRIM(STR(YEAR(DATE()))))
			.text10.value=DATE()
			.text3.value=0
			.text4.value=0
			.text5.value=0
			.text6.value=0
			.text7.value=0
			.text11.value=0
			.text12.value=0
			.text13.value=0
			.text15.value=0
			.grid1.refresh()
			.grid1.recordsource=" "
			.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista,tmpc.cotiz)","Column")
			.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
			.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")
		endwith
		create cursor cantvent(cant N(10,2))
		create cursor cantcred(ccred N(10,2))
		create cursor ventas(vtas N(10,4))
		create cursor creditos(cred N(10,4))
		create cursor recep(can N(8),cto N(10,4),concepto C(1))
		
		LOCAL vendn
		vendn=ALLTRIM(UPPER(substr(sys(0),ATC("#",sys(0))+2)))
		
		frmcart= conectar_db(_screen.cn)
			SQLEXEC(frmcart,"select * from vendedores where ven_nomb=?vendn;","cur_ven")
		desconectar_db(frmcart)
		
		LOCAL usuario
		usuario=UPPER(substr(sys(0),ATC("#",sys(0))+2))
		
		if reccount("cur_ven")>0 or usuario="CLOTILDE"
			with this
				.grd_costos.Visible= .F.
				.grid1.visible=.F.
				.label13.visible=.F.
				.label14.visible=.F.
				.label15.visible=.F.
				.label16.Visible= .F.
				.label18.visible=.F.
				.label19.visible=.F.
				.label21.visible=.F.
				.label22.visible=.F.
				.label23.visible=.F.
				.label24.visible=.F.
				.lbl_prov.Visible= .F.
				.optiongroup2.visible=.F.
				.text9.visible=.F.
				.text10.visible=.F.
				.cmdcal1.Visible= .F.
				.cmdcal2.Visible= .F.
				.text11.visible=.F.
				.text12.visible=.F.
				.text13.visible=.F.
				.text14.visible=.F.
				.text17.Visible= .F.
				.text15.visible=.F.
				.shape3.visible=.F.
				.shape4.visible=.F.
				.shape6.Visible= .F.
				.chk_todos.Visible= .F.
				.paleta_01.visible= .F.
				.text4.style=1
				.text5.style=1
				.height=320
				.command3.top=286
				.autocenter=.T.
			ENDWITH
		ENDIF
	ENDPROC

	PROCEDURE nboldfila
		LParameters tnsel
		
		Local lnBold
		
			DO case
				CASE tnsel = 1
					lnBold = .T.
				CASE tnsel = 0
					lnBold = .F.
			ENDCASE
		Return(lnBold)
	ENDPROC

	PROCEDURE ncolorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = 1
					lnColor = RGB(255,0,0)
				CASE tnsel = 0
					lnColor = RGB(0,0,0)
			ENDCASE
		Return(lnColor)
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnlp,tncz
		
		LOCAL lnColor
		
		DO CASE 
			CASE tnlp=1 AND tncz=0
				lnColor = RGB(144,238,144)
			CASE tnlp=0 AND tncz=1
				lnColor = RGB(230,240,20)
			CASE tnlp=1 AND tncz=1
				lnColor = RGB(255,211,168)
		OTHERWISE
			lnColor = RGB(255,255,255)
		ENDCASE
		
		return(lnColor)
	ENDPROC

	PROCEDURE verdetalles
		WITH thisform
			IF LEN(ALLTRIM(.edit2.Value))>0
				.shape5.visible=.T.
				.label25.visible=.T.
				.edit2.visible=.T.
				.edit1.visible=.T.
				.label11.visible=.T.
				thisform.command2.caption="\<Ocultar Detalles"
				IF thisform.text1.Value>0
					.edit2.enabled=.T.
				ENDIF
			ELSE
				.shape5.visible=.F.
				.label25.visible=.F.
				.edit2.visible=.F.
				.edit1.visible=.F.
				.label11.visible=.F.
				thisform.command2.caption="\<Ver Detalles"
				.edit2.enabled=.F.
			ENDIF
		ENDWITH
		
		RETURN
	ENDPROC

	PROCEDURE bnt_imagen.Click
		IF thisform.text1.Value>0
			LOCAL nCodigo, cURL
		
			* Tomar el valor del TextBox que contiene el código
			nCodigo = ALLTRIM(STR(ThisForm.text1.Value))
		
			IF EMPTY(nCodigo)
			    MESSAGEBOX("No hay código de artículo para abrir en la web.", 48, "Atención")
			    RETURN
			ENDIF
		
			* Armar la URL dinámica con el código del artículo
			cURL = SUBSTR(_screen.urlapi,2)+':3000/public/product-files?code=' + nCodigo
		
			* Abrir la URL en el navegador predeterminado
			IF "WINDOWS" $ UPPER(OS())
			    RUN /N explorer.exe "&cURL"
			ELSE
			    * Para Linux o macOS, por si lo corrés con Wine
			    RUN /N xdg-open "&cURL"
			ENDIF
		ELSE
			MESSAGEBOX("Debe consultar un artículo para poder ver la imágen.",48,"Aviso del Sistema")
		ENDIF
		
	ENDPROC

	PROCEDURE bnt_imagen.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE bnt_imagen.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE check_estado.Click
		*=========================================================
		* check_estado.Click
		* Guarda art_metricas.estado en HP + ILUMET
		*=========================================================
		
		LOCAL lnEstado, lnEstadoActual, lnArtCodi, tnTexto
		LOCAL frmcart, conexterna
		LOCAL preg
		
		lnArtCodi = VAL(TRANSFORM(thisform.text1.Value))
		lnEstado  = IIF(this.Value = 1, 1, 0)
		
		IF lnArtCodi <= 0
		    RETURN
		ENDIF
		
		*=========================================================
		* BLOQUE VALOR ACTUAL
		* Convierte estado_metricas a número real para evitar:
		* Operator/operand type mismatch
		*=========================================================
		IF USED("cur_arti") AND TYPE("cur_arti.estado_metricas") <> "U"
		    lnEstadoActual = VAL(TRANSFORM(cur_arti.estado_metricas))
		ELSE
		    lnEstadoActual = 1
		ENDIF
		
		IF lnEstado <> lnEstadoActual
		
		    preg = MESSAGEBOX("¿Confirma modificar el estado de métricas del artículo?", 4+32+256, "Artículos")
		
		    IF preg = 6
		
		        *=========================================================
		        * BLOQUE HP ELECTRICIDAD - DB PRINCIPAL
		        * Conexión: _screen.cn
		        * Tabla: art_metricas
		        * Campo: estado
		        *=========================================================
		        frmcart = conectar_db(_screen.cn)
		
			        IF VARTYPE(frmcart) = "N" AND frmcart > 0
		
			            SQLEXEC(frmcart, ;
			                "INSERT INTO art_metricas (art_codi, estado) " + ;
			                "VALUES (?lnArtCodi, ?lnEstado) " + ;
			                "ON DUPLICATE KEY UPDATE estado = ?lnEstado;")
		
			        ENDIF
		
		        desconectar_db(frmcart)
		
		
		        *=========================================================
		        * BLOQUE ILUMET - DB EXTERNA
		        * Conexión: _screen.xconext
		        * Tabla: art_metricas
		        * Campo: estado
		        *=========================================================
		        conexterna = conectar_db(_screen.xconext)
		
			        IF VARTYPE(conexterna) = "N" AND conexterna > 0
		
			            SQLEXEC(conexterna, ;
			                "INSERT INTO art_metricas (art_codi, estado) " + ;
			                "VALUES (?lnArtCodi, ?lnEstado) " + ;
			                "ON DUPLICATE KEY UPDATE estado = ?lnEstado;")
		
				    ENDIF
		
		        desconectar_db(conexterna)
		
		
		        *=========================================================
		        * BLOQUE CURSOR LOCAL / UI
		        * No hacemos REPLACE porque estado_metricas puede venir
		        * desde MySQL/ODBC con tipo incompatible.
		        * Dejamos el checkbox reflejando el nuevo estado.
		        *=========================================================
				tnTexto = ICASE(lnEstado = 1,"Activo P/Compras",lnEstado = 0,"Inactivo P/Compras")
				this.Caption = tnTexto
		        this.Value = IIF(lnEstado = 1, 1, 0)
				this.Fontbold = IIF(lnEstado = 1, .F., .T.)
				this.Forecolor = IIF(lnEstado = 1, RGB(0,0,0), RGB(255,0,0))
				
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart, ;
						"SELECT a.*, b.rub_desc, IFNULL(m.art_pct_alerta, 0) AS art_pct_alerta,IFNULL(m.estado, 0) AS estado_metricas " + ;
						"FROM articulos AS a " + ;
						"INNER JOIN rubros AS b ON a.rub_codi = b.rub_codi " + ;
						"LEFT JOIN art_metricas AS m ON m.art_codi = a.art_codi " + ;
						"WHERE a.art_codi = ?lnArtCodi;", ;
						"cur_arti")
				desconectar_db(frmcart)
		    ELSE
		
		        *=========================================================
		        * BLOQUE CANCELACIÓN
		        * Vuelve el check al estado anterior
		        *=========================================================
				tnTexto = ICASE(lnEstadoActual = 1,"Activo P/Compras",lnEstadoActual = 0,"Inactivo P/Compras")
				this.Caption = tnTexto
		        this.Value = IIF(lnEstadoActual = 1, 1, 0)
				this.Fontbold = IIF(lnEstadoActual = 1, .F., .T.)
				this.Forecolor = IIF(lnEstadoActual = 1, RGB(0,0,0), RGB(255,0,0))
		    ENDIF
		  
		
		ENDIF
	ENDPROC

	PROCEDURE chk_todos.Click
		thisform.grd_costos.RecordSource=''
		thisform.grd_costos.Refresh()
		
		SET DECIMALS TO 3
		IF this.Value=1
			frmcart= conectar_db(_screen.cn)
				SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
			desconectar_db(frmcart)
			SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
			GO top
			thisform.grd_costos.recordsource="tmpc"
		ELSE
			frmcart= conectar_db(_screen.cn)
				SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
			desconectar_db(frmcart)
			SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
			GO top
			thisform.grd_costos.recordsource="tmpc"
		ENDIF
		SET DECIMALS TO
		
			
	ENDPROC

	PROCEDURE Command1.Click
		&& consart.command1.click
		
		SET DECIMALS TO 3
		LOCAL xcc, tnTexto
		codigo=0
		thisform.text1.value=0
		do form artload with codigo
		if codigo>0
			with thisform
				.grd_costos.HighlightStyle= 1
				frmcart= conectar_db(_screen.cn)
		
				SQLEXEC(frmcart, ;
					"SELECT a.*, b.rub_desc, IFNULL(m.art_pct_alerta, 0) AS art_pct_alerta,IFNULL(m.estado, 0) AS estado_metricas " + ;
					"FROM articulos AS a " + ;
					"INNER JOIN rubros AS b ON a.rub_codi = b.rub_codi " + ;
					"LEFT JOIN art_metricas AS m ON m.art_codi = a.art_codi " + ;
					"WHERE a.art_codi = ?codigo;", ;
					"cur_arti")
		
				desconectar_db(frmcart)
				.lbl_prov.caption=''
				.grd_costos.recordsource=""
				.grd_costos.refresh
				.text1.value=cur_arti.art_codi
				.text2.value=cur_arti.art_desc
				.text3.value=cur_arti.art_stock
				.text15.value=cur_arti.art_stmin
				.text18.Value = cur_arti.art_pct_alerta
				tnTexto = ICASE(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1,"Activo P/Compras",VAL(TRANSFORM(cur_arti.estado_metricas)) = 0,"Inactivo P/Compras")
				.check_estado.Caption = tnTexto
				.check_estado.Value = IIF(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1, 1, 0)
				.check_estado.Fontbold = IIF(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1, .F., .T.)
				.check_estado.Forecolor = IIF(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1, RGB(0,0,0), RGB(255,0,0))				
				.check_estado.Enabled = .T.
				.text16.value=iif(cur_arti.art_alicuota=1,impiva1,impiva2)
				.text4.value=cur_arti.pedidos
				.text5.value=cur_arti.pedprov
				.text6.value=cur_arti.art_stock+.text5.value-.text4.value
				do case
					case cur_arti.art_med="UN"
						.optiongroup1.value=1
					case cur_arti.art_med="MT"
						.optiongroup1.value=2
					case cur_arti.art_med="KG"
						.optiongroup1.value=3
				endcase
				.text7.value=cur_arti.art_precio
				.edit1.value=cur_arti.art_deta
				.edit2.value=cur_arti.art_detaofi
				thisform.verdetalles()
				.text8.value=ALLTRIM(STR(cur_arti.rub_codi))+" - "+ALLTRIM(cur_arti.rub_desc)
				.text13.value=cur_arti.costo_ultcpra
				xcc=.text1.value
				SET DECIMALS TO 3
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
					IF RECCOUNT("provc")>0
						thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
					ENDIF		
					IF thisform.chk_todos.Value=0
						SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
					ELSE
						SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
					ENDIF
				desconectar_db(frmcart)
				SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
				GO top
				IF RECCOUNT("tmpc")>0
					thisform.chk_todos.Enabled= .T.
				ENDIF
				.grd_costos.recordsource="tmpc"
				.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista,tmpc.cotiz)","Column")
				.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
				.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")			
				SET DECIMALS TO
				thisform.dias_actcosto(cur_arti.art_codi)
				.text9.enabled=.T.
				.text10.enabled=.T.
				.label17.caption=""
				.grid1.recordsource=" "
				.grid1.refresh()
			endwith
		ENDIF
		SET DECIMALS TO
		thisform.text1.setfocus
		KEYBOARD '{ENTER}'
		
		
	ENDPROC


	PROCEDURE Text1.KeyPress
		&& consart.text1.keypress
		
		LPARAMETERS nKeyCode, nShiftAltCtrl
		CREATE CURSOR codaux(art_codi N(8))
		LOCAL xcc, tnTexto
		SET DECIMALS TO 3
		do case
			CASE nkeycode=13
				if this.value<>0
					xcc=this.value
					frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart, ;
					"SELECT a.*, b.rub_desc, IFNULL(m.art_pct_alerta, 0) AS art_pct_alerta, IFNULL(m.estado, 0) AS estado_metricas " + ;
					"FROM articulos AS a " + ;
					"INNER JOIN rubros AS b ON a.rub_codi = b.rub_codi " + ;
					"LEFT JOIN art_metricas AS m ON m.art_codi = a.art_codi " + ;
					"WHERE a.art_codi = ?this.value;", ;
					"cur_arti")
					desconectar_db(frmcart)
					if RECCOUNT("cur_arti")>0
						if cur_arti.art_codi<>4 AND cur_arti.art_codi<>5
							with thisform
								.lbl_prov.caption=''
								.grd_costos.HighlightStyle= 1
								.grd_costos.recordsource=''
								.grd_costos.refresh()
								.text1.value=cur_arti.art_codi
								.text2.value=cur_arti.art_desc
								.text3.value=cur_arti.art_stock
								.text15.value=cur_arti.art_stmin
								.text18.Value = cur_arti.art_pct_alerta
								tnTexto = ICASE(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1,"Activo P/Compras",VAL(TRANSFORM(cur_arti.estado_metricas)) = 0,"Inactivo P/Compras")
								.check_estado.Caption = tnTexto
								.check_estado.Value = IIF(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1, 1, 0)
								.check_estado.Fontbold = IIF(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1, .F., .T.)
								.check_estado.Forecolor = IIF(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1, RGB(0,0,0), RGB(255,0,0))
								.check_estado.Enabled = .T.
								.text16.value=iif(cur_arti.art_alicuota=1,impiva1,impiva2)
								.text4.value=cur_arti.pedidos
								.text5.value=cur_arti.pedprov
								.text6.value=cur_arti.art_stock+.text5.value-.text4.value
								do case
									case cur_arti.art_med="UN"
										.optiongroup1.value=1
									case cur_arti.art_med="MT"
										.optiongroup1.value=2
									case cur_arti.art_med="KG"
										.optiongroup1.value=3
								endcase
								.text7.value=cur_arti.art_precio
								.edit1.value=cur_arti.art_deta
								.edit2.value=cur_arti.art_detaofi
								thisform.verdetalles()
								.text8.value=ALLTRIM(STR(cur_arti.rub_codi))+" - "+ALLTRIM(cur_arti.rub_desc)
								.text13.value=cur_arti.costo_ultcpra
								SET DECIMALS TO 3
								frmcart= conectar_db(_screen.cn)
									SQLEXEC(frmcart,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
									IF RECCOUNT("provc")>0
										thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
									ENDIF
									IF thisform.chk_todos.Value=0
										SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
									ELSE
										SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
									ENDIF
								desconectar_db(frmcart)
								SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
								GO top
								IF RECCOUNT("tmpc")>0
									thisform.chk_todos.Enabled= .T.
								ENDIF
								.grd_costos.recordsource="tmpc"
								.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista,tmpc.cotiz)","Column")
								.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
								.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")
								SET DECIMALS TO
								thisform.dias_actcosto(cur_arti.art_codi)
								.text9.enabled=.T.
								.text10.enabled=.T.
								.label17.caption=""
								.text11.value=0
								.text12.value=0
								.grid1.recordsource=""
								.grid1.refresh()
							endwith
						endif
					else
						messagebox("Artículo no está en archivo",0+48,"Advertencia")
						this.value=0
						return 0
					endif
				endif	
			case nkeycode=19 or nkeycode=24
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select art_codi from articulos where art_codi<?this.value and art_codi<>4 and art_codi<>5 order by art_codi desc limit 1;","cur_inter")
					IF RECCOUNT()>0
						INSERT INTO codaux values(cur_inter.art_codi)
					ENDIF
				desconectar_db(frmcart)
				SELECT codaux
				IF RECCOUNT()>0
					frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart, ;
					"SELECT a.*, b.rub_desc, IFNULL(m.art_pct_alerta, 0) AS art_pct_alerta, IFNULL(m.estado, 0) AS estado_metricas " + ;
					"FROM articulos AS a " + ;
					"INNER JOIN rubros AS b ON a.rub_codi = b.rub_codi " + ;
					"LEFT JOIN art_metricas AS m ON m.art_codi = a.art_codi " + ;
					"WHERE a.art_codi = ?codaux.art_codi;", ;
					"cur_arti")
					desconectar_db(frmcart)													
					with thisform
						xcc=cur_arti.art_codi
						.lbl_prov.caption=''
						.grd_costos.HighlightStyle= 1
						.grd_costos.recordsource=""
						.grd_costos.refresh
						.text1.value=cur_arti.art_codi
						.text2.value=cur_arti.art_desc
						.text3.value=cur_arti.art_stock
						.text15.value=cur_arti.art_stmin
						.text18.Value = cur_arti.art_pct_alerta
						tnTexto = ICASE(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1,"Activo P/Compras",VAL(TRANSFORM(cur_arti.estado_metricas)) = 0,"Inactivo P/Compras")
						.check_estado.Caption = tnTexto
						.check_estado.Value = IIF(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1, 1, 0)
						.check_estado.Fontbold = IIF(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1, .F., .T.)
						.check_estado.Forecolor = IIF(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1, RGB(0,0,0), RGB(255,0,0))
						.check_estado.Enabled = .T.
						.text16.value=iif(cur_arti.art_alicuota=1,impiva1,impiva2)
						.text4.value=cur_arti.pedidos
						.text5.value=cur_arti.pedprov
						.text6.value=cur_arti.art_stock+.text5.value-.text4.value
						do case
							case cur_arti.art_med="UN"
								.optiongroup1.value=1
							case cur_arti.art_med="MT"
								.optiongroup1.value=2
							case cur_arti.art_med="KG"
								.optiongroup1.value=3
						endcase
						.text7.value=cur_arti.art_precio
						.edit1.value=cur_arti.art_deta
						.edit2.value=cur_arti.art_detaofi
						thisform.verdetalles()
						.text8.value=ALLTRIM(STR(cur_arti.rub_codi))+" - "+ALLTRIM(cur_arti.rub_desc)
						.text13.value=cur_arti.costo_ultcpra
						SET DECIMALS TO 3
						frmcart= conectar_db(_screen.cn)
							SQLEXEC(frmcart,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
							IF RECCOUNT("provc")>0
								thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
							ENDIF				
							IF thisform.chk_todos.Value=0
								SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
							ELSE
								SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
							ENDIF
						desconectar_db(frmcart)
						SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
						GO top
						IF RECCOUNT("tmpc")>0
							thisform.chk_todos.Enabled= .T.
						ENDIF
						.grd_costos.recordsource="tmpc"
		*!*					.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista)","Column")
		*!*					.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
		*!*					.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")				
						SET DECIMALS TO
						thisform.dias_actcosto(cur_arti.art_codi)
						.text9.enabled=.T.
						.text10.enabled=.T.
						.label17.caption=""
						.text11.value=0
						.text12.value=0
						.grid1.recordsource=""
					ENDWITH
					NODEFAULT
					this.Refresh()
					this.setfocus
				ENDIF
			case nkeycode=4 or nkeycode=5
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select art_codi from articulos where art_codi>?this.value order by art_codi limit 1;","cur_inter")
					IF RECCOUNT()>0
						INSERT INTO codaux values(cur_inter.art_codi)
					ENDIF
				desconectar_db(frmcart)
				SELECT codaux
				IF RECCOUNT()>0
					frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart, ;
					"SELECT a.*, b.rub_desc, IFNULL(m.art_pct_alerta, 0) AS art_pct_alerta,IFNULL(m.estado, 0) AS estado_metricas " + ;
					"FROM articulos AS a " + ;
					"INNER JOIN rubros AS b ON a.rub_codi = b.rub_codi " + ;
					"LEFT JOIN art_metricas AS m ON m.art_codi = a.art_codi " + ;
					"WHERE a.art_codi = ?codaux.art_codi;", ;
					"cur_arti")
					desconectar_db(frmcart)				
					with thisform
						xcc=cur_arti.art_codi
						.lbl_prov.caption=''
						.grd_costos.HighlightStyle= 1
						.grd_costos.recordsource=""
						.grd_costos.refresh
						.text1.value=cur_arti.art_codi
						.text2.value=cur_arti.art_desc
						.text3.value=cur_arti.art_stock
						.text15.value=cur_arti.art_stmin
						.text18.Value = cur_arti.art_pct_alerta
						tnTexto = ICASE(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1,"Activo P/Compras",VAL(TRANSFORM(cur_arti.estado_metricas)) = 0,"Inactivo P/Compras")
						.check_estado.Caption = tnTexto
						.check_estado.Value = IIF(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1, 1, 0)				
						.check_estado.Fontbold = IIF(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1, .F., .T.)
						.check_estado.Forecolor = IIF(VAL(TRANSFORM(cur_arti.estado_metricas)) = 1, RGB(0,0,0), RGB(255,0,0))
						.check_estado.Enabled = .T.
						.text16.value=iif(cur_arti.art_alicuota=1,impiva1,impiva2)
						.text4.value=cur_arti.pedidos
						.text5.value=cur_arti.pedprov
						.text6.value=cur_arti.art_stock+.text5.value-.text4.value
						do case
							case cur_arti.art_med="UN"
								.optiongroup1.value=1
							case cur_arti.art_med="MT"
								.optiongroup1.value=2
							case cur_arti.art_med="KG"
								.optiongroup1.value=3
						endcase
						.text7.value=cur_arti.art_precio
						.edit1.value=cur_arti.art_deta
						.edit2.value=cur_arti.art_detaofi
						thisform.verdetalles()
						.text8.value=ALLTRIM(STR(cur_arti.rub_codi))+" - "+ALLTRIM(cur_arti.rub_desc)
						.text13.value=cur_arti.costo_ultcpra
						SET DECIMALS TO 3
						frmcart= conectar_db(_screen.cn)
							SQLEXEC(frmcart,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
							IF RECCOUNT("provc")>0
								thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
							ENDIF				
							IF thisform.chk_todos.Value=0
								SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
							ELSE
								SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
							ENDIF
						desconectar_db(frmcart)
						SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
						GO top
						IF RECCOUNT("tmpc")>0
							thisform.chk_todos.Enabled= .T.
						ENDIF
						.grd_costos.recordsource="tmpc"
		*!*					.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista)","Column")
		*!*					.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
		*!*					.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")				
						SET DECIMALS TO
						thisform.dias_actcosto(cur_arti.art_codi)
						.text9.enabled=.T.
						.text10.enabled=.T.
						.label17.caption=""
						.text11.value=0
						.text12.value=0
						.grid1.recordsource=""
						KEYBOARD '{TAB}'
					ENDWITH
					NODEFAULT
					this.Refresh()
					this.setfocus
				ELSE
					KEYBOARD '{TAB}'
				ENDIF
		ENDCASE
		SET DECIMALS TO
		
		
	ENDPROC

	PROCEDURE Text10.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text10.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode=13
		*!*		WAIT 'PROCESANDO CONSULTA....' WINDOW NOWAIT
		*!*		_screen.MousePointer=11
		*!*		valor=0
			with thisform
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select a.fac_codi,a.fac_fec,a.fac_conc,b.artfac_cant,b.artfac_impo,a.anulado from facturas as a inner join facturas_articulos as b on a.fac_codi=b.fac_codi where b.art_codi=?.text1.value and a.fac_fec between ?.text9.value and ?.text10.value;","cur_vtas")
					SQLEXEC(frmcart,"select a.recep_codi,a.recep_fec,a.recep_conc,b.artrecep_cant,b.artrecep_prec from recepciones as a inner join recepciones_articulos as b on a.recep_codi=b.recep_codi where b.art_codi=?.text1.value and a.recep_fec between ?.text9.value and ?.text10.value;","cur_cpras")
				desconectar_db(frmcart)
		
				.grid1.recordsource=""
				.grid1.refresh()
				select sum(artfac_cant) as "cant" from cur_vtas WHERE anulado<>"S" and fac_conc="F" into cursor cantvent
				select sum(artfac_cant) as "ccred" from cur_vtas where anulado<>"S" and fac_conc="N" into cursor cantcred
				select sum(artfac_impo) as "vtas" from cur_vtas where anulado<>"S" and fac_conc="F" into cursor ventas
				select sum(artfac_impo) as "cred" from cur_vtas where anulado<>"S" and fac_conc="N" into cursor creditos
				
				select artrecep_cant as "can",artrecep_prec as "cto",recep_conc as "concepto" from cur_cpras into cursor recep
				
				.text11.value=IIF(ISNULL(cantvent.cant),0,cantvent.cant)-IIF(ISNULL(cantcred.ccred),0,cantcred.ccred)
				if cantvent.cant>0
					promvta=(IIF(ISNULL(ventas.vtas),0,ventas.vtas)-IIF(ISNULL(creditos.cred),0,creditos.cred))/(IIF(ISNULL(cantvent.cant),0,cantvent.cant)-IIF(ISNULL(cantcred.ccred),0,cantcred.ccred))
				else
					promvta=0
				endif
				sele recep
				go top
				if reccount()>0
					acucant=0
					acuprec=0
					do while acucant<=.text11.value and !eof()
						if concepto="N"
							acucant=acucant-can
							acuprec=acuprec-cto
						else
							acucant=acucant+can
							acuprec=acuprec+cto
						endif
						skip
					enddo
					if acucant>.text11.value
						acucant=cantvent.cant
					endif
					promcpra=acuprec/acucant
					.text12.value=((promvta/promcpra)-1)*100
				else
					.text12.value=0
				ENDIF
		
				xcodigo=.text1.value
				xfedes =DTOT(.text9.value)
				IF this.value < DATE()
					xfehas = DTOT(this.value+1)
				ELSE
					xfehas =DATETIME()
				ENDIF
				SET decimals TO 3
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"call usp_histocostos(?xcodigo,?xfedes,?xfehas);","cur_his")
				desconectar_db(frmcart)
				SET DECIMALS TO
				SELECT prov_nomb, ;
			   		TTOD(histo_fech) fecha, ;
			   		TTOC(histo_fech,2) hora, ;
			   		histo_costo, ;
			   		histo_ctovta, ;
			   		moneda ;
				FROM cur_his INTO CURSOR cur_histo
				.grid1.recordsourcetype=1
				.grid1.recordsource="cur_histo"
				.text9.setfocus
			ENDWITH
		*!*		MOUSE DRAG TO 35,150
		*!*		_screen.MousePointer=0
		ENDIF
		
		
	ENDPROC

	PROCEDURE Text13.Click
		if this.value>0
			do form consrapcosto with thisform.text1.value
		ENDIF
		*!*	IF !WEXIST("consrapcosto")
		*!*		thisform.text1.setfocus
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE Text14.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text14.GotFocus
		SET POINT TO
		SET SEPARATOR to
		this.BackColor= RGB(255,238,194)
		this.ForeColor= RGB(0,0,0)
		this.BorderColor= RGB(255,149,0)
	ENDPROC

	PROCEDURE Text14.LostFocus
		IF LASTKEY()=13 THEN 
			LOCAL mone,his_nvo,fechoy,coefdto,auxarpro
			auxarpro=0
			coefdto=0
			this.BackColor= RGB(124,136,151)
			this.ForeColor= RGB(255,255,0)
			this.BorderColor= RGB(141,178,227)
			fechoy=DATETIME()
			with thisform
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select param_impo from parametros where param_codi=10;","cur_dtoadi")
					SQLEXEC(frmcart,"select a.*,b.dto_coef from articulos_proveedores_descuentos a inner join descuentos b on a.dto_codi=b.dto_codi where a.artpro_codi=?tmpc.artpro_codi;","cur_dtos")
				desconectar_db(frmcart)
				IF RECCOUNT("cur_dtos")>0
					GO top
					SCAN
						IF RECNO()=1
							coefdto=ROUND(IIF(negativo=0,dto_coef,1/dto_coef),9)
						ELSE
							IF negativo=0
								coefdto=ROUND(coefdto*dto_coef,9)
							ELSE
								coefdto=ROUND(coefdto/dto_coef,9)
							ENDIF
						ENDIF
					ENDSCAN
					coefdto=ROUND(coefdto/((100-cur_dtoadi.param_impo)/100),9)
				ELSE
					coefdto=ROUND(1/((100-cur_dtoadi.param_impo)/100),9)
				ENDIF
				.text17.value=ROUND(this.value*coefdto,3)
				do case
					case .optiongroup2.value=1
						mone="P"
					case .optiongroup2.value=2
						mone="D"
				ENDCASE
				if this.value<>tmpc.artpro_costo
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"update articulos_proveedores set moneda=?mone,artpro_costo=?this.value,artpro_ctovta=?.text17.value where artpro_codi=?tmpc.artpro_codi;")
						SQLEXEC(frmcart,"select * from histocosto where artpro_codi = ?tmpc.artpro_codi and DATE(histo_fech) = ?TTOD(fechoy);","cur_encontre")
						IF RECCOUNT("cur_encontre") > 0
							SQLEXEC(frmcart,"update histocosto set histo_fech = ?fechoy, histo_costo = ?this.value, histo_ctovta = ?.text17.value, moneda = ?mone where histo_codi = ?cur_encontre.histo_codi;")
							thisform.nhisto=cur_encontre.histo_codi
						ELSE
							SQLEXEC(frmcart,"select CAST(histo_codi+1 as decimal(8,0)) as histo_codi from histocosto order by histo_codi desc limit 1;","cur_maxcod")
							his_nvo=cur_maxcod.histo_codi
							thisform.nhisto=his_nvo
							SQLEXEC(frmcart,"insert into histocosto values(?his_nvo,?fechoy,?this.value,?.text17.value,?tmpc.artpro_codi,?mone);")
						ENDIF
					desconectar_db(frmcart)
					************************** SE CONECTA AL SERVIDOR ILUMET Y ACTUALIZA COSTO E HISTORICO DE COSTO TAMBIEN ***********************
					conexterna= conectar_db(_screen.xconext)
					IF VARTYPE(conexterna) = "N" AND conexterna> 0
						SQLEXEC(conexterna,"update articulos_proveedores set moneda=?mone,artpro_costo=?this.value,artpro_ctovta=?.text17.value where artpro_codi=?tmpc.artpro_codi;")
						SQLEXEC(conexterna,"select * from histocosto where artpro_codi = ?tmpc.artpro_codi and DATE(histo_fech) = ?TTOD(fechoy);","cur_encontre2")
						IF RECCOUNT("cur_encontre2") > 0
							SQLEXEC(conexterna,"update histocosto set histo_fech = ?fechoy, histo_costo = ?this.value, histo_ctovta = ?.text17.value, moneda = ?mone where histo_codi = ?cur_encontre2.histo_codi;")
						ELSE
							SQLEXEC(conexterna,"select CAST(histo_codi+1 as decimal(8,0)) as histo_codi from histocosto order by histo_codi desc limit 1;","cur_maxcod2")
							his_nvo2=cur_maxcod2.histo_codi
							SQLEXEC(conexterna,"insert into histocosto values(?his_nvo2,?fechoy,?this.value,?.text17.value,?tmpc.artpro_codi,?mone);")
						ENDIF
						desconectar_db(conexterna)
					ENDIF
					************************** FIN PROCESO SERVIDOR ILUMET *********************************************
				ELSE
					IF tmpc.moneda<>mone
						frmcart= conectar_db(_screen.cn)
							SQLEXEC(frmcart,"update articulos_proveedores set moneda=?mone where artpro_codi=?tmpc.artpro_codi;")
							SQLEXEC(frmcart,"select * from histocosto where artpro_codi = ?tmpc.artpro_codi and DATE(histo_fech) = ?TTOD(fechoy);","cur_encontre")
							IF RECCOUNT("cur_encontre") > 0
								SQLEXEC(frmcart,"update histocosto set histo_fech = ?fechoy, histo_costo = ?this.value, histo_ctovta = ?tmpc.artpro_ctovta, moneda = ?mone where histo_codi = ?cur_encontre.histo_codi;")
								thisform.nhisto=cur_encontre.histo_codi
							ELSE					
								SQLEXEC(frmcart,"select CAST(histo_codi+1 as decimal(8,0)) as histo_codi from histocosto order by histo_codi desc limit 1;","cur_maxcod")
								his_nvo=cur_maxcod.histo_codi
								thisform.nhisto=his_nvo
								SQLEXEC(frmcart,"insert into histocosto values(?his_nvo,?fechoy,?this.value,?tmpc.artpro_ctovta,?tmpc.artpro_codi,?mone);")
							ENDIF
						desconectar_db(frmcart)
						************************** SE CONECTA AL SERVIDOR ILUMET Y ACTUALIZA COSTO E HISTORICO DE COSTO TAMBIEN ***********************
						conexterna= conectar_db(_screen.xconext)
						IF VARTYPE(conexterna) = "N" AND conexterna> 0
							SQLEXEC(conexterna,"update articulos_proveedores set moneda=?mone where artpro_codi=?tmpc.artpro_codi;")
							SQLEXEC(conexterna,"select * from histocosto where artpro_codi = ?tmpc.artpro_codi and DATE(histo_fech) = ?TTOD(fechoy);","cur_encontre2")
							IF RECCOUNT("cur_encontre2") > 0
								SQLEXEC(conexterna,"update histocosto set histo_fech = ?fechoy, histo_costo = ?this.value, histo_ctovta = ?tmpc.artpro_ctovta, moneda = ?mone where histo_codi = ?cur_encontre2.histo_codi;")
							ELSE
								SQLEXEC(conexterna,"select CAST(histo_codi+1 as decimal(8,0)) as histo_codi from histocosto order by histo_codi desc limit 1;","cur_maxcod2")
								his_nvo2=cur_maxcod2.histo_codi
								SQLEXEC(conexterna,"insert into histocosto values(?his_nvo2,?fechoy,?this.value,?tmpc.artpro_ctovta,?tmpc.artpro_codi,?mone);")
							ENDIF
							desconectar_db(conexterna)
						ENDIF
						************************** FIN PROCESO SERVIDOR ILUMET *********************************************
					ENDIF
				ENDIF
				auxarpro=tmpc.artpro_codi
				.grd_costos.recordsource=""
				.grd_costos.refresh
				SET DECIMALS TO 3
				frmcart= conectar_db(_screen.cn)
					IF thisform.chk_todos.Value=0
						SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
					ELSE
						SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
					ENDIF
				desconectar_db(frmcart)
				SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
				GO top
				.grd_costos.recordsource="tmpc"
				.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista,tmpc.cotiz)","Column")
				.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
				.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")	
				SET DECIMALS TO
				thisform.dias_actcosto(cur_arti.art_codi)
				.grd_costos.HighlightStyle= 1
				SELECT tmpc
				LOCATE FOR artpro_codi=auxarpro
				set point to ","
				set separator to "."
				.text17.setfocus
			ENDWITH
		ELSE
			NODEFAULT
			this.SetFocus
		ENDIF
	ENDPROC

	PROCEDURE Text15.Click
		set point to "."
		this.setfocus
	ENDPROC

	PROCEDURE Text15.LostFocus
		if this.value<>cur_arti.art_stmin
			preg=messagebox("¿Confirma el Stock Mínimo Ingresado?",4+32+256,"Artículos")
			if preg=6
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"update articulos set art_stmin=?this.value where art_codi=?thisform.text1.value;")
				desconectar_db(frmcart)
		        ***************** SE CONECTA AL SERVIDOR ILUMET Y ACTUALIZA POS MÍNIMA ******************
				conexterna= conectar_db(_screen.xconext)
				IF VARTYPE(conexterna) = "N" AND conexterna > 0
					SQLEXEC(conexterna,"update articulos set art_stmin=?this.value where art_codi=?thisform.text1.value;")
					desconectar_db(conexterna)
				ENDIF
				****************** FIN PROCESO SERVIDOR ILUMET ***********************************		
			else
				this.value=0
			endif
		endif
		set point to ","
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text17.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text17.GotFocus
		set point to
		set separator to
		this.BackColor= RGB(255,238,194)
		this.ForeColor= RGB(0,0,0)
		this.BorderColor= RGB(255,149,0)
	ENDPROC

	PROCEDURE Text17.LostFocus
		IF LASTKEY()=13 then
			LOCAL mone,fechoy
			this.BackColor= RGB(124,136,151)
			this.ForeColor= RGB(255,255,0)
			this.BorderColor= RGB(141,178,227)
			fechoy=DATE()
			with thisform
				do case
					case .optiongroup2.value=1
						mone="P"
					case .optiongroup2.value=2
						mone="D"
				endcase
				if this.value<>tmpc.artpro_ctovta
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"update articulos_proveedores set moneda=?mone,artpro_ctovta=?this.value where artpro_codi=?tmpc.artpro_codi;")
						SQLEXEC(frmcart,"update histocosto set histo_ctovta=?this.value,moneda=?mone where histo_codi=?thisform.nhisto;")
					desconectar_db(frmcart)
					***************** SE CONECTA AL SERVIDOR ILUMET, MODIFICA COSTO E HISTORICO DE COSTO *****************
					conexterna= conectar_db(_screen.xconext)
					IF VARTYPE(conexterna) = "N" AND conexterna > 0
						SQLEXEC(conexterna,"update articulos_proveedores set moneda=?mone,artpro_ctovta=?this.value where artpro_codi=?tmpc.artpro_codi;")
						SQLEXEC(conexterna,"update histocosto set histo_ctovta=?this.value,moneda=?mone where histo_codi=?thisform.nhisto;")
						desconectar_db(conexterna)
					ENDIF
					***************** FIN PROCESO SERVIDOR ILUMET *****************************			
				ELSE
					IF tmpc.moneda<>mone
						frmcart= conectar_db(_screen.cn)
							SQLEXEC(frmcart,"update articulos_proveedores set moneda=?mone where artpro_codi=?tmpc.artpro_codi;")
							SQLEXEC(frmcart,"update histocosto set histo_ctovta=?this.value,moneda=?mone where histo_codi=?thisform.nhisto;")
						desconectar_db(frmcart)
						***************** SE CONECTA AL SERVIDOR ILUMET, MODIFICA COSTO E HISTORICO DE COSTO *****************
						conexterna= conectar_db(_screen.xconext)
						IF VARTYPE(conexterna) = "N" AND conexterna > 0
							SQLEXEC(conexterna,"update articulos_proveedores set moneda=?mone where artpro_codi=?tmpc.artpro_codi;")
							SQLEXEC(conexterna,"update histocosto set histo_ctovta=?this.value,moneda=?mone where histo_codi=?thisform.nhisto;")
							desconectar_db(conexterna)
						ENDIF
						***************** FIN PROCESO SERVIDOR ILUMET *****************************				
					ENDIF
				ENDIF
				.grd_costos.recordsource=""
				.grd_costos.refresh
				SET DECIMALS TO 3
				frmcart= conectar_db(_screen.cn)
					IF thisform.chk_todos.Value=0
						SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
					ELSE
						SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
					ENDIF
				desconectar_db(frmcart)
				SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
				GO top
				.grd_costos.recordsource="tmpc"
				.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista,tmpc.cotiz)","Column")
				.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
				.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")	
				SET DECIMALS TO
				thisform.dias_actcosto(cur_arti.art_codi)
				.grd_costos.HighlightStyle= 1				
				set point to ","
				set separator to "."	
				.label22.visible=.F.
				.label21.visible=.F.
				.optiongroup2.visible=.F.
				.text14.visible=.F.
				.label16.visible=.F.
				this.Visible= .F.
				.text1.setfocus
			ENDWITH
		ELSE
			NODEFAULT
			this.SetFocus
		ENDIF
	ENDPROC

	PROCEDURE Text18.Click
		set point to "."
		this.setfocus
	ENDPROC

	PROCEDURE Text18.LostFocus
		*=========================================================
		* text18.LostFocus
		* Guarda art_metricas.art_pct_alerta en HP + ILUMET
		* Permite porcentajes negativos
		*=========================================================
		
		LOCAL lnValor, lnValorActual, lnArtCodi
		LOCAL frmcart, conexterna
		LOCAL preg
		
		SET POINT TO "."
		
		lnArtCodi = VAL(TRANSFORM(thisform.text1.Value))
		lnValor   = VAL(TRANSFORM(this.Value))
		
		IF lnArtCodi <= 0
		    SET POINT TO ","
		    RETURN
		ENDIF
		
		lnValorActual = IIF(TYPE("cur_arti.art_pct_alerta") <> "U", cur_arti.art_pct_alerta, 30)
		
		IF lnValor <> lnValorActual
		
		    preg = MESSAGEBOX("¿Confirma el % de Alerta Ingresado?", 4+32+256, "Artículos")
		
		    IF preg = 6
		
		        *=========================================================
		        * BLOQUE HP ELECTRICIDAD - DB PRINCIPAL
		        * Conexión: _screen.cn
		        * Tabla: art_metricas
		        * Acción: INSERT si no existe / UPDATE si existe
		        *=========================================================
		        frmcart = conectar_db(_screen.cn)
		
			        IF VARTYPE(frmcart) = "N" AND frmcart > 0
		
			            SQLEXEC(frmcart, ;
			                "INSERT INTO art_metricas (art_codi, art_pct_alerta) " + ;
			                "VALUES (?lnArtCodi, ?lnValor) " + ;
			                "ON DUPLICATE KEY UPDATE art_pct_alerta = ?lnValor;")
		
			        ENDIF
		
		        desconectar_db(frmcart)
		
		        *=========================================================
		        * BLOQUE ILUMET - DB EXTERNA
		        * Conexión: _screen.xconext
		        * Tabla: art_metricas
		        * Acción: INSERT si no existe / UPDATE si existe
		        *=========================================================
		        conexterna = conectar_db(_screen.xconext)
		
			        IF VARTYPE(conexterna) = "N" AND conexterna > 0
		
			            SQLEXEC(conexterna, ;
			                "INSERT INTO art_metricas (art_codi, art_pct_alerta) " + ;
			                "VALUES (?lnArtCodi, ?lnValor) " + ;
			                "ON DUPLICATE KEY UPDATE art_pct_alerta = ?lnValor;")
		
			        ENDIF
		
		        desconectar_db(conexterna)
		
		        *=========================================================
		        * BLOQUE CURSOR LOCAL
		        * Actualiza cur_arti para que no vuelva a preguntar
		        * si el usuario sale y entra nuevamente del campo
		        *=========================================================
		        IF USED("cur_arti")
		            REPLACE art_pct_alerta WITH lnValor IN cur_arti
		        ENDIF
		
		    ELSE
		
		        *=========================================================
		        * BLOQUE CANCELACIÓN
		        * Si el usuario no confirma, vuelve al valor anterior
		        *=========================================================
		        this.Value = lnValorActual
		
		    ENDIF
		
		ENDIF
		
		SET POINT TO ","
		thisform.text1.SetFocus()
	ENDPROC

	PROCEDURE Text3.Click
		LOCAL lnCodigo
		
		lnCodigo = IIF(VARTYPE(THISFORM.text1.Value)="N", THISFORM.text1.Value, 0)
		
		IF lnCodigo <= 0
		    lnCodigo = VAL(ALLTRIM(THISFORM.text1.Text))
		ENDIF
		
		IF lnCodigo <= 0
		    MESSAGEBOX("Primero seleccione un artículo.", 48, "Histórico de Stock")
		    THISFORM.text1.SetFocus
		    RETURN
		ENDIF
		
		DO FORM frmhistostock WITH lnCodigo
	ENDPROC

	PROCEDURE Text4.Click
		codigo=thisform.text1.value
		descri=allt(thisform.text2.value)
		do form pendclirapi with codigo,descri
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text5.Click
		codigo=thisform.text1.value
		descri=allt(thisform.text2.value)
		do form pendprovrapi with codigo,descri
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text9.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text9.GotFocus
		if last()=4 or last()=5 or last()=19 or last()=24
			thisform.text1.setfocus
		endif
		
	ENDPROC

ENDDEFINE


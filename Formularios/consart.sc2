	PROCEDURE grd_costos.Column5.Check1.Click
		LOCAL artcc, conexterna
		IF this.Value=1
			IF tmpc.otro=1
				MESSAGEBOX("El Costo seleccionado está marcado como OTRO COSTO, imposible utilizarlo para generar precio de venta."+CHR(13)+ ;
						   "Para poder utilizarlo deberá ir al menú Modificaciones\Costos de Artículos\Configurar Costos\Activar/Desactivar Otros Costos,y alli desactivarle la marca de Otro Costo.",48,"Aviso del Sistema")
				this.Value=0
			else
				pregcos=MESSAGEBOX("¿Confirma utilizar este costo para la próxima actualizción de precios de venta?",4+48+256,"Precios")
				IF pregcos=6
					artcc=tmpc.artpro_codi
					UPDATE tmpc SET lista=0
					UPDATE tmpc SET lista=1 WHERE artpro_codi=artcc
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"update articulos_proveedores set lista=0 where art_codi=?thisform.text1.value;")
						SQLEXEC(frmcart,"update articulos_proveedores set lista=1 where artpro_codi=?artcc;")
					desconectar_db(frmcart)
		            **************** SE CONECTA AL SERVIDOR ILUMET Y MODIFICA COSTO L.P ***************
					conexterna = conectar_db(_screen.xconext)
					IF VARTYPE(conexterna)="N" AND conexterna>0
						SQLEXEC(conexterna,"update articulos_proveedores set lista=0 where art_codi=?thisform.text1.value;")
						SQLEXEC(conexterna,"update articulos_proveedores set lista=1 where artpro_codi=?artcc;")
						desconectar_db(conexterna)
					ENDIF
					******************** FIN PROCESO SERVIDOR ILUMET ***************************
								
					GO TOP IN tmpc
					thisform.grd_costos.Refresh()
				ELSE
					this.Value=0
					thisform.grd_costos.Refresh()
				ENDIF
			ENDIF
		ELSE
			artcc=tmpc.artpro_codi
			UPDATE tmpc SET lista=0 WHERE artpro_codi = artcc
			frmcart= conectar_db(_screen.cn)
				SQLEXEC(frmcart,"update articulos_proveedores set lista=0 where artpro_codi=?artcc;")
			desconectar_db(frmcart)
			**************** SE CONECTA AL SERVIDOR ILUMET Y MODIFICA COSTO L.P ***************
			conexterna = conectar_db(_screen.xconext)
			IF VARTYPE(conexterna)="N" AND conexterna>0
				SQLEXEC(conexterna,"update articulos_proveedores set lista=0 where artpro_codi=?artcc;")
				desconectar_db(conexterna)
			ENDIF
			******************** FIN PROCESO SERVIDOR ILUMET ***************************	
			GO TOP IN tmpc
			thisform.grd_costos.Refresh()
		ENDIF
		thisform.text1.SetFocus
	ENDPROC

	PROCEDURE grd_costos.Column6.Check1.Click
		LOCAL arcot
		IF this.Value=1
			pregcos=MESSAGEBOX("¿Confirma utilizar este costo por defecto para cotizaciones?",4+48+256,"Precios")
			IF pregcos=6
				arcot=tmpc.artpro_codi
				UPDATE tmpc SET cotiz=0
				UPDATE tmpc SET cotiz=1 WHERE artpro_codi=arcot
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"update articulos_proveedores set cotiz=0 where art_codi=?thisform.text1.value;")
					SQLEXEC(frmcart,"update articulos_proveedores set cotiz=1 where artpro_codi=?arcot;")
				desconectar_db(frmcart)
				**************** SE CONECTA AL SERVIDOR ILUMET Y MODIFICA COSTO COTIZ ***************
				conexterna = conectar_db(_screen.xconext)
				IF VARTYPE(conexterna)="N" AND conexterna>0
					SQLEXEC(conexterna,"update articulos_proveedores set cotiz=0 where art_codi=?thisform.text1.value;")
					SQLEXEC(conexterna,"update articulos_proveedores set cotiz=1 where artpro_codi=?arcot;")
					desconectar_db(conexterna)
				ENDIF
				******************* FIN PROCESO SERVIDOR ILUMET ************************************			
				GO TOP IN tmpc
				thisform.grd_costos.Refresh()
			ELSE
				this.Value=0
				thisform.grd_costos.Refresh()
			ENDIF
		ELSE
			arcot=tmpc.artpro_codi
			UPDATE tmpc SET cotiz=0 WHERE artpro_codi = arcot
			frmcart= conectar_db(_screen.cn)
				SQLEXEC(frmcart,"update articulos_proveedores set cotiz=0 where artpro_codi=?arcot;")
			desconectar_db(frmcart)
			**************** SE CONECTA AL SERVIDOR ILUMET Y MODIFICA COSTO COTIZ ***************
			conexterna = conectar_db(_screen.xconext)
			IF VARTYPE(conexterna)="N" AND conexterna>0
				SQLEXEC(conexterna,"update articulos_proveedores set cotiz=0 where artpro_codi=?arcot;")
				desconectar_db(conexterna)
			ENDIF
			******************* FIN PROCESO SERVIDOR ILUMET ************************************	
			GO TOP IN tmpc
			thisform.grd_costos.Refresh()	
		ENDIF
		thisform.text1.SetFocus
	ENDPROC


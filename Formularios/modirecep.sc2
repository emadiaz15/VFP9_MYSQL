	PROCEDURE Activate
		on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		set exact on
		if proveedor=" "
			on key label INS
			thisform.release
		endif
		if codigo=0 and alternati="N"
			muestro=0
		endif
		if muestro=1
			with thisform
				sele articulos
				set order to art_codi
				seek codigo
				localiz=1
				if alternati="S"
					with thisform
						do case
							case opcion=1
								if paso=1
									.grid1.col=2
									.grid1.text="DTO"
									.grid1.col=4
									.grid1.text=allt(descri)
									.grid1.col=5
									.grid1.text=allt(str(porcdto,7,3))+"%"
									filaux=.grid1.row-1
									.grid1.col=6
									desaux=val(.grid1.text)
									incremento=0
									for i=1 to filaux
										.grid1.row=i
										incremento=incremento+val(.grid1.text)
									next i
									.grid1.row=filaux+1
									.grid1.text="-"+allt(str(incremento*porcdto/100,10,2))
									do case
										case val(.grid1.text)<desaux
											dife=val(.grid1.text)-desaux
											acu=acu+dife
										case val(.grid1.text)>desaux
											dife=desaux-val(.grid1.text)
											acu=acu-dife
									endcase
								else
									.grid1.additem(" "+chr(9)+" "+chr(9)+"DTO"+chr(9)+" "+chr(9)+allt(descri)+chr(9)+allt(str(porcdto,7,3))+"%")
									.grid1.col=6
									.grid1.row=.grid1.rows-1
					      			.grid1.text="-"+allt(str(acu*porcdto/100,10,2))
									acu=acu+val(.grid1.text)
									haydescuento="S"
								endif
							case opcion=2
								if paso=1
									.grid1.col=2
									.grid1.text="CARGO"
									.grid1.col=4
									.grid1.text=allt(descri)
									.grid1.col=5
									.grid1.text=allt(str(porccar,7,3))+"%"
									filaux=.grid1.row-1
									.grid1.col=6
									caraux=val(.grid1.text)
									incremento=0
									for i=1 to filaux
										.grid1.row=i
										incremento=incremento+val(.grid1.text)
									next i
									.grid1.row=filaux+1
									.grid1.text=allt(str(incremento*porccar/100,10,2))
									do case
										case val(.grid1.text)>caraux
											dife=val(.grid1.text)-caraux
											acu=acu+dife
										case val(.grid1.text)<caraux
											dife=caraux-val(.grid1.text)
											acu=acu-dife
									endcase
								else				
									.grid1.additem(" "+chr(9)+" "+chr(9)+"CARGO"+chr(9)+" "+chr(9)+allt(descri)+chr(9)+allt(str(porccar,7,3))+"%")
									.grid1.col=6
									.grid1.row=.grid1.rows-1
				    	  			.grid1.text=allt(str(acu*porccar/100,10,2))
									acu=acu+val(.grid1.text)
									fila=.grid1.rows-1
									haycargo="S"
								endif
								on key label INS do advertencia with fila
						endcase
					endwith
					alternati="N"
				else		
					if paso=1
						.grid1.col=0
						.grid1.text=allt(str(aux))
						.grid1.col=1
						.grid1.text=allt(cant)
						.grid1.col=2
						.grid1.text=art_med
						.grid1.col=3
						cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
						.grid1.text=cadena
						.grid1.col=4
						if codigo=4
							.grid1.text=allt(descrip)
						else
							.grid1.text=allt(descri)
						endif
						.grid1.col=5
						.grid1.text=allt(pruni)
						if .check1.value=1
							.grid1.col=7
							.grid1.text="SS"
						endif
						.grid1.col=6
						acu=acu-val(.grid1.text)
						.grid1.text=prtot
						acu=acu+val(prtot)
						paso=0
					else
						if insertar=0
							nitem=nitem+1
							cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
							.grid1.additem(alltrim(str(nitem))+chr(9)+trim(cant)+chr(9)+art_med+chr(9)+cadena+chr(9)+allt(descri)+chr(9)+allt(pruni)+chr(9)+prtot)
							if .check1.value=1
								.grid1.row=.grid1.rows-1
								.grid1.col=7
								.grid1.text="SS"
							endif
						endif
						acu=acu+val(prtot)
					endif
					opcion=0
					on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
				endif
				if nitem=1
					.command4.enabled=.T.
				endif
			endwith
			codigo=0
		endif
		if localiz=1 and nitem>0
			with thisform
				if .optiongroup1.value=2
					pregciva=messagebox("¿Calcula Iva para este Item?",4+48+256,"Advertencia")
					.text8.value=str(acu,10,2)
					.text17.value=str(acu*.text19.value/100,10,2)
					.text18.value=str(acu-val(.text17.value),10,2)
					.text24.value=str(val(.text18.value)*.text25.value/100,10,2)
					if cond=2
						if pregciva=6
							.grid1.col=8
							.grid1.row=nitem
							.grid1.text="X"
							dto=val(prtot)-round(val(prtot)*.text19.value/100,2)
							.text9.value=str((val(.text9.value)+dto)*impiva1/100,10,2)
						endif
					endif
					if .text16.value>0
						.text15.value=val(str((val(.text18.value)*.text16.value)/100,10,2))
						.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+val(.text11.value),10,2)
					else
						.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+val(.text11.value),10,2)
					endif
					if .text21.value>0
						.text20.value=val(str((val(.text18.value)*.text21.value)/100,10,2))
						.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+.text20.value+val(.text11.value),10,2)
					else
						.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+val(.text11.value),10,2)
					endif			
				else
					.text8.value=str(acu,10,2)
					.text17.value=str(acu*.text19.value/100,10,2)
					.text18.value=str(acu-val(.text17.value),10,2)
					.text24.value=str(val(.text18.value)*.text25.value/100,10,2)
					if cond=2
						.text9.value=str(val(.text18.value)*impiva1/100,10,2)
					endif
					if .text16.value>0
						.text15.value=val(str((val(.text18.value)*.text16.value)/100,10,2))
						.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+val(.text11.value),10,2)
					else
						.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+val(.text11.value),10,2)
					endif
					if .text21.value>0
						.text20.value=val(str((val(.text18.value)*.text21.value)/100,10,2))
						.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+.text20.value+val(.text11.value),10,2)
					else
						.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+val(.text11.value),10,2)
					endif
				endif
			endwith	
			thisform.grid1.toprow=nitem
		endif
		store 0 to localiz,muestro
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 11 of Modificaci .F.
		localiz=0
		nitem=0
		on key label INS
	ENDPROC

	PROCEDURE Init
		parameter codr,cond
		public elimi,aux,descrip,muestro,insertar,observ,cantreg, ;
		       impiva1,impiva2,codiva,opcion,dato1,dato2,dato3,dato4,cant,descri, ;
			   pruni,prtot,opcion,borra,alternati,localiz,ivaant,ivaact,iva,codiprov,dato1, ;
			   totalaux,nitem,haydescuento,haycargo,porcdto,porccar, ;
			   filaux,incremento,desaux,caraux,codigo,buscar,paso,com,art
		set deleted on
		create cursor tempo(art_codi N(8),cantidad N(10,3),precio N(10,4),sstock C(1),esta C(1))
		index on art_codi to artempo
		com=0
		art=0
		observ=" "
		paso=0
		acu=0
		elimi=0
		aux=0
		descrip=""
		insertar=0
		cantreg=0
		borra=0
		prtot=""
		pruni=""
		codigo=0
		codiprov=0
		alternati="N"
		haydescuento="N"
		haycargo="N"
		porcdto=0
		porccar=0
		filaux=0
		incremento=0
		desaux=0
		caraux=0
		buscar=1
		sele iva
		go bott
		codiva=iva_codi
		impiva1=iva_1
		impiva2=iva_2
		ivaant=impiva1
		thisform.label12.caption=allt(str(impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(impiva2,10,2))+"%"
		sele recepciones_articulos
		set order to recep_codi
		seek codr
		if found()
			if valorcadena="N. Crédito/N. Débito"
				this.caption="Modificación de Notas de Crédito y Notas de Débito de Proveedores"
				this.optiongroup1.visible=.T.
				if recepciones.recep_conc="N"
					this.optiongroup1.value=1
				else
					this.optiongroup1.value=2
				endif
			endif
			nitem=1
			with thisform
				.text1.value=proveedores.prov_nomb
				.text2.value=proveedores.prov_domi
				.text3.value=codipostales.cp_nro
				.text4.value=localidades.loca_nomb
				.text5.value=provincias.provi_nomb
				.text6.value=condiva.cond_desc
				.text12.value=proveedores.prov_cuit
				if proveedores.percepcion="S"
					.label18.enabled=.T.
					.label19.enabled=.T.	
					.text15.enabled=.T.
					.text20.enabled=.T.
					.text16.enabled=.T.
					.text21.enabled=.T.
					.text16.value=recepciones.perc_iva
					.text21.value=recepciones.perc_btos
				else
					.label18.enabled=.F.
					.label19.enabled=.F.
					.text15.enabled=.F.
					.text20.enabled=.F.
					.text16.enabled=.F.
					.text21.enabled=.F.
					.text16.value=0
					.text21.value=0
				endif
				.text13.value=recepciones.recep_fec
				.text7.value=recepciones.prov_fac
				.text22.value=recepciones.prov_tipfac
				.text14.value=recepciones.prov_rto
				.text19.value=recepciones.recep_dto
				.edit1.value=recepciones.recep_obser
				.text23.value=recepciones.cotiz_dolar
				.text25.value=round((recepciones.recep_impng/recepciones.recep_tot)*100,3)
				.text15.value=0
				.text20.value=0
				codiprov=proveedores.prov_codi
				con=0
				do while recep_codi=codr
					do case
						case concepto="D"
							.grid1.additem(" "+chr(9)+" "+chr(9)+"DTO"+chr(9)+" "+chr(9)+allt(artrecep_dasc)+chr(9)+allt(str(artrecep_prec,7,3))+"%")
							.grid1.col=6
							.grid1.row=.grid1.rows-1
			      			.grid1.text="-"+allt(str(acu*artrecep_prec/100,10,2))
							acu=acu+val(.grid1.text)
							haydescuento="S"
						case concepto="C"
							.grid1.additem(" "+chr(9)+" "+chr(9)+"CARGO"+chr(9)+" "+chr(9)+allt(artrecep_dasc)+chr(9)+allt(str(artrecep_prec,7,3))+"%")
							.grid1.col=6
							.grid1.row=.grid1.rows-1
			      			.grid1.text=allt(str(acu*artrecep_prec/100,10,2))
							acu=acu+val(.grid1.text)
							fila=.grid1.rows-1
							haycargo="S"
							on key label INS do advertencia with fila
						other case
							cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
							.grid1.additem(allt(str(nitem))+chr(9)+allt(str(artrecep_cant,10,3))+chr(9)+allt(articulos.art_med)+chr(9)+cadena+chr(9)+allt(articulos.art_desc)+chr(9)+allt(str(artrecep_prec,10,4))+chr(9)+allt(str(artrecep_cant*artrecep_prec,10,2)))
							if art_codi=4
								.grid1.col=4
								.grid1.row=nitem
								.grid1.text=allt(artrecep_dasc)
							endif
							if orden_codi>0
								.grid1.col=8
								.grid1.row=nitem
								.grid1.text=str(orden_codi)
							endif
							if recep_sstock="S"
								.grid1.col=7
								.grid1.row=nitem
								.grid1.text="SS"
								con=con+1
							endif
							insert into tempo(art_codi,cantidad,precio,sstock) ;
								values(recepciones_articulos.art_codi,recepciones_articulos.artrecep_cant,recepciones_articulos.artrecep_prec,recepciones_articulos.recep_sstock)
							acu=acu+(artrecep_cant*artrecep_prec)
							nitem=nitem+1
					endcase
					skip
				enddo
			endwith
			if nitem>1
				nitem=nitem-1
			endif
			if con=nitem
				thisform.check1.value=1
			endif
		endif
		with thisform
			.text8.value=str(acu,10,2)
			.text17.value=str(acu*.text19.value/100,10,2)
			.text18.value=str(acu-val(.text17.value),10,2)
			.text24.value=str(val(.text18.value)*.text25.value/100,10,2)
			if cond=2
				.text9.value=iif(recepciones.recep_conc="D",str(recepciones.ivand,10,2),str(val(.text18.value)*impiva1/100,10,2))
			endif
			if .text16.value>0
				.text15.value=val(str((val(.text18.value)*.text16.value)/100,10,2))
				.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+val(.text11.value),10,2)
			else
				.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+val(.text11.value),10,2)
			endif
			if .text21.value>0
				.text20.value=val(str((val(.text18.value)*.text21.value)/100,10,2))
				.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+.text20.value+val(.text11.value),10,2)
			else
				.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+val(.text11.value),10,2)
			endif
		endwith
		
	ENDPROC

	PROCEDURE Load
		set skip of bar 11 of Modificaci .T.
	ENDPROC

	PROCEDURE LostFocus
		if valorcadena<>"Recepciones"
			set skip of bar 11 of Modificaci .F.
			thisform.hide
			localiz=0
			nitem=0
		endif
	ENDPROC

	PROCEDURE Check1.Click
		do case
			case this.value=1
				preg=messagebox("¿Confirma que recepciona todo sin mover Stock?",4+48+256,"Advertencia")
				if preg=6
					if thisform.grid1.rows>1
						thisform.grid1.col=7
						for i=1 to thisform.grid1.rows-1
							thisform.grid1.row=i
							thisform.grid1.text="SS"
						next i
						thisform.grid1.row=1
					endif
				else
					this.value=0
				endif
			case this.value=0
				preg=messagebox("¿Confirma que recepciona todo moviendo Stock?",4+48+256,"Advertencia")
				if preg=6
					if thisform.grid1.rows>1
						thisform.grid1.col=7
						for i=1 to thisform.grid1.rows-1
							thisform.grid1.row=i
							thisform.grid1.text=""
						next i
						thisform.grid1.row=1
					endif
				else
					this.value=1
				endif
		endcase
	ENDPROC

	PROCEDURE Command1.Click
		salir=messagebox("¿Seguro que desea Salir?",4+32+256,"Verifique!!!")
		if salir=6
			thisform.release
		endif
		
	ENDPROC

	PROCEDURE Command2.Click
		if thisform.text7.value=0
			messagebox("Debe ingresar obligatoriamente el número de factura del Proveedor",0+48,"Adevertencia")
			thisform.text7.setfocus
		else
			preg=messagebox("¿Confirma los datos de la Recepción?",4+32+256,"Recepciones")
			if preg=6
				with thisform
					sele recepciones
					set order to recep_codi
					seek codr
					repla recep_fec with .text13.value
					repla prov_codi with codiprov
					repla recep_obser with observ
					repla recep_dto with .text19.value
					repla iva_codi with codiva
					if .text16.value>0
						repla perc_iva with .text16.value
					endif
					if .text21.value>0
						repla perc_btos with .text21.value
					endif
					repla prov_fac with .text7.value
					repla prov_tipfac with allt(.text22.value)
					repla prov_rto with .text14.value
					if recep_conc="D"
						repla ivand with val(.text9.value)
					endif
					if .text23.value>0
						repla cotiz_dolar with .text23.value
						repla recep_tot with val(.text18.value)*.text23.value
					else
						repla recep_tot with val(.text18.value)
					endif
					if .text25.value>0
						repla recep_impng with val(.text24.value)
					endif
					if impiva1<>ivaant
						repla altiva_1 with impiva1
						repla altiva_2 with impiva2
					endif
					sele proveedores
					set order to prov_codi
					seek codiprov
					repla prov_saldo with prov_saldo+val(.text10.value)
					sele recepciones_articulos
					set reprocess to automatic
					if flock()
						set order to recep_codi
						seek codr
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								if eof() or recep_codi<>codr
									appe blank
									repla recep_codi with codr
								else
									if fila>1
										skip
										if eof() or recep_codi<>codr
											appe blank
											repla recep_codi with codr
										endif
									endif
								endif
								.grid1.col=2
								do case
									case .grid1.text="DTO"
										repla concepto with "D"
										.grid1.col=4
										repla artrecep_dasc with allt(.grid1.text)
									case .grid1.text="CARGO"
										repla concepto with "C"
										.grid1.col=4
										repla artrecep_dasc with allt(.grid1.text)
									other case
										.grid1.col=3
										auxart=art_codi
										if val(.grid1.text)<>art_codi
											repla art_codi with val(.grid1.text)
										endif
										articulo=val(.grid1.text)
										if articulo=4
											.grid1.col=4
											repla artrecep_dasc with allt(.grid1.text)
										endif
										.grid1.col=3
										sele tempo
										set order to artempo
										seek val(.grid1.text)
										if found()
											repla esta with "S"
										endif
										sele recepciones_articulos
										com=0
										.grid1.col=8
										if val(.grid1.text)>0
											repla orden_codi with val(.grid1.text)
											sele compras_articulos
											set order to ordenart
											com=val(.grid1.text)
											.grid1.col=3
											art=val(.grid1.text)
											seek str(com)+str(art)
											if found()
												if art=4
													.grid1.col=4
													if allt(.grid1.text)<>allt(artord_dasc)
														do while allt(.grid1.text)<>allt(artord_dasc)
															if allt(.grid1.text)=allt(artord_dasc)
																exit
															endif
															skip
														enddo
													endif
												endif
											endif
										endif
										sele recepciones_articulos
										.grid1.col=1
										do case
											case val(.grid1.text)>artrecep_cant
												dife=val(.grid1.text)-artrecep_cant
											case val(.grid1.text)<artrecep_cant
												dife=artrecep_cant-val(.grid1.text)
										endcase
										do case
											case auxart<>art_codi
												.grid1.col=7
												if allt(.grid1.text)<>"SS"
													.grid1.col=1
													if articulo<>4
														repla articulos.art_stock with articulos.art_stock+val(.grid1.text)
													endif
													if com>0
														repla compras_articulos.artord_ent with iif(compras_articulos.artord_ent+val(.grid1.text)>compras_articulos.artord_cant,compras_articulos.artord_cant,compras_articulos.artord_ent+val(.grid1.text))
													endif
												else
													repla recep_sstock with "S"
												endif
											case auxart=art_codi and val(.grid1.text)>artrecep_cant
												.grid1.col=7
												if allt(.grid1.text)<>"SS"
													if articulo<>4
														repla articulos.art_stock with articulos.art_stock+dife	
													endif
													if com>0
														repla compras_articulos.artord_ent with iif(compras_articulos.artord_ent+dife>compras_articulos.artord_cant,compras_articulos.artord_cant,compras_articulos.artord_ent+dife)
													endif
												else
													repla recep_sstock with "S"
												endif
											case auxart=art_codi and val(.grid1.text)<artrecep_cant
												.grid1.col=7
												if allt(.grid1.text)<>"SS"
													if articulo<>4
		 												repla articulos.art_stock with articulos.art_stock-dife
		 											endif
		 											if com>0
														repla compras_articulos.artord_ent with compras_articulos.artord_ent-dife
													endif
												else
													repla recep_sstock with "S"
												endif
										endcase
										if com>0
											do cumplicom with com
										endif
										.grid1.col=1
										repla artrecep_cant with val(.grid1.text)
								endcase
								.grid1.col=5
								repla artrecep_prec with val(.grid1.text)
							endif
						next fila
						skip
						if recep_codi=codr
							do while recep_codi=codr and !eof()
								dele
								skip
							enddo
						endif
					endif
					unlock
					for i=1 to .grid1.rows-1
						.grid1.row=i
						.grid1.col=3
						if val(.grid1.text)>0
							.grid1.col=5
							valorcosto=val(.grid1.text)
							if .text19.value>0
								descosto=val(.grid1.text)*.text19.value/100
								valorcosto=val(.grid1.text)-descosto
							endif
							if .text25.value>0
								valorcosto=round(valorcosto+(iif(.text19.value>0,(valorcosto-descosto),valorcosto))*.text25.value/100,2)
							endif
							if haydescuento="S"
								auxfila=.grid1.row
								x=auxfila
								.grid1.col=2
								for x=auxfila to .grid1.rows-1
									.grid1.row=x
									if .grid1.text="DTO"
										.grid1.col=5
										valorcosto=round(valorcosto*((100-val(.grid1.text))/100),3)
										.grid1.col=2							
									endif
								next x
								.grid1.row=auxfila
							endif
							if haycargo="S"
								auxfila=.grid1.row
								x=auxfila
								.grid1.col=2
								for x=auxfila to .grid1.rows-1
									.grid1.row=x
									if .grid1.text="CARGO"
										.grid1.col=5
										valorcosto=round(valorcosto*(1+val(.grid1.text)/100),3)
										.grid1.col=2							
									endif
								next x
								.grid1.row=auxfila
							endif
							if .text23.value>0
								valorcosto=round(valorcosto*.text23.value,3)
							endif
							if codiprov<>46 and articulo<>4
								sele articulos
								set order to art_codi
								seek articulo
								repla costo_ultcpra with valorcosto
							endif
						endif
					next i
				endwith
				sele tempo
				set order to artempo
				set rela to art_codi into articulos
				go top
				scan
					if esta<>"S"
						if art_codi<>4
							if sstock<>"S"
								repla articulos.art_stock with articulos.art_stock-cantidad
							endif
							repla articulos.pedprov with articulos.pedprov+cantidad
						endif
					endif
				endscan
				thisform.release
			endif
		endif
	ENDPROC

	PROCEDURE Command3.Click
		if thisform.text7.value=0
			messagebox("Debe ingresar obligatoriamente el número de factura del Proveedor",0+48,"Adevertencia")
			thisform.text7.setfocus
		else
			preg=messagebox("¿Confirma los datos de la Recepción?",4+32+256,"Recepciones")
			if preg=6
				with thisform
					sele recepciones
					set order to recep_codi
					seek codr
					repla recep_fec with .text13.value
					repla prov_codi with codiprov
					repla recep_obser with observ
					repla recep_dto with .text19.value
					repla iva_codi with codiva
					if .text16.value>0
						repla perc_iva with .text16.value
					endif
					if .text21.value>0
						repla perc_btos with .text21.value

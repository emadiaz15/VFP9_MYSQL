					repla prov_fac with .text7.value
					repla prov_tipfac with allt(.text22.value)
					repla prov_rto with .text14.value
					repla recep_conc with "F"
					if .text23.value>0
						repla cotiz_dolar with .text23.value
						repla recep_tot with val(.text18.value)*.text23.value
					else

					if .text25.value>0
						repla recep_impng with val(.text24.value)
					endif
					if impiva1<>ivaant
						repla altiva_1 with impiva1
						repla altiva_2 with impiva2
					endif
					sele proveedores
					set order to prov_codi
					seek codiprov
					repla prov_saldo with prov_saldo+val(.text10.value)
					sele recepciones_articulos
					set reprocess to automatic
					if flock()
						set order to recep_codi
						seek codr
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								if eof() or recep_codi<>codr
									appe blank
									repla recep_codi with codr
								else
									if fila>1
										skip
										if eof() or recep_codi<>codr
											appe blank
											repla recep_codi with codr
										endif
									endif
								endif
								.grid1.col=2
								do case
									case .grid1.text="DTO"
										repla concepto with "D"
										.grid1.col=4
										repla artrecep_dasc with allt(.grid1.text)
									case .grid1.text="CARGO"
										repla concepto with "C"
										.grid1.col=4
										repla artrecep_dasc with allt(.grid1.text)
									other case
										.grid1.col=3
										auxart=art_codi
										if val(.grid1.text)<>art_codi
											repla art_codi with val(.grid1.text)
										endif
										articulo=val(.grid1.text)
										if articulo=4
											.grid1.col=4
											repla artrecep_dasc with allt(.grid1.text)
										endif
										com=0
										.grid1.col=8
										if val(.grid1.text)>0
											repla orden_codi with val(.grid1.text)
											sele compras_articulos
											set order to ordenart
											com=val(.grid1.text)
											.grid1.col=3
											art=val(.grid1.text)
											seek str(com)+str(art)
											if found()
												if art=4
													.grid1.col=4
													if allt(.grid1.text)<>allt(artord_dasc)
														do while allt(.grid1.text)<>allt(artord_dasc)
															if allt(.grid1.text)=allt(artord_dasc)
																exit
															endif
															skip
														enddo
													endif
												endif
											endif
										endif
										sele recepciones_articulos
										.grid1.col=1
										do case
											case val(.grid1.text)>artrecep_cant
												dife=val(.grid1.text)-artrecep_cant
											case val(.grid1.text)<artrecep_cant
												dife=artrecep_cant-val(.grid1.text)
										endcase
										do case
											case auxart<>art_codi
												.grid1.col=7
												if allt(.grid1.text)<>"SS"
													.grid1.col=1
													if articulo<>4
														repla articulos.art_stock with articulos.art_stock+val(.grid1.text)
													endif
													if com>0
														repla compras_articulos.artord_ent with iif(compras_articulos.artord_ent+val(.grid1.text)>compras_articulos.artord_cant,compras_articulos.artord_cant,compras_articulos.artord_ent+val(.grid1.text))
													endif
												else
													repla recep_sstock with "S"
												endif
											case auxart=art_codi and val(.grid1.text)>artrecep_cant
												.grid1.col=7
												if allt(.grid1.text)<>"SS"
													if articulo<>4
														repla articulos.art_stock with articulos.art_stock+dife	
													endif
													if com>0
														repla compras_articulos.artord_ent with iif(compras_articulos.artord_ent+dife>compras_articulos.artord_cant,compras_articulos.artord_cant,compras_articulos.artord_ent+dife)
													endif
												else
													repla recep_sstock with "S"
												endif
											case auxart=art_codi and val(.grid1.text)<artrecep_cant
												.grid1.col=7
												if allt(.grid1.text)<>"SS"
													if articulo<>4
		 												repla articulos.art_stock with articulos.art_stock-dife
		 											endif
		 											if com>0
														repla compras_articulos.artord_ent with compras_articulos.artord_ent-dife
													endif
												else
													repla recep_sstock with "S"
												endif
										endcase
										if com>0
											do cumplicom with com
										endif
										.grid1.col=1
										repla artrecep_cant with val(.grid1.text)
								endcase
								.grid1.col=5
								repla artrecep_prec with val(.grid1.text)
							endif
						next fila
						skip
						if recep_codi=codr
							do while recep_codi=codr and !eof()
								dele
								skip
							enddo
						endif
					endif
					unlock
					for i=1 to .grid1.rows-1
						.grid1.row=i
						.grid1.col=3
						if val(.grid1.text)>0
							.grid1.col=5
							valorcosto=val(.grid1.text)
							if .text19.value>0
								descosto=val(.grid1.text)*.text19.value/100
								valorcosto=val(.grid1.text)-descosto
							endif
							if .text25.value>0
								valorcosto=round(valorcosto+(iif(.text19.value>0,(valorcosto-descosto),valorcosto))*.text25.value/100,2)
							endif
							if haydescuento="S"
								auxfila=.grid1.row
								x=auxfila
								.grid1.col=2
								for x=auxfila to .grid1.rows-1
									.grid1.row=x
									if .grid1.text="DTO"
										.grid1.col=5
										valorcosto=round(valorcosto*((100-val(.grid1.text))/100),3)
										.grid1.col=2							
									endif
								next x
								.grid1.row=auxfila
							endif
							if haycargo="S"
								auxfila=.grid1.row
								x=auxfila
								.grid1.col=2
								for x=auxfila to .grid1.rows-1
									.grid1.row=x
									if .grid1.text="CARGO"
										.grid1.col=5
										valorcosto=round(valorcosto*(1+val(.grid1.text)/100),3)
										.grid1.col=2							
									endif
								next x
								.grid1.row=auxfila
							endif
							if .text23.value>0
								valorcosto=round(valorcosto*.text23.value,3)
							endif
							if codiprov<>46 and articulo<>4
								sele articulos
								set order to art_codi
								seek articulo
								repla costo_ultcpra with valorcosto
							endif
						endif
					next i
				endwith
			endif
		endif
	ENDPROC

	PROCEDURE Command4.Click
		descri=""
		porcdto=0
		porccar=0
		opcion=0
		do form descocargo with descri,porcdto,porccar,opcion
	ENDPROC

	PROCEDURE Command5.Click
		iva=0
		ivaact=0
		do form calciva with iva,ivaact
		if iva>0
			impiva1=iva
			impiva2=iva/2
			with thisform
				.label12.caption=allt(str(impiva1,10,2))+"%"
				.label13.caption=allt(str(impiva2,10,2))+"%"
				.text9.value=round(val(.text18.value)*impiva1/100,2)
				.text10.value=str(val(.text18.value)+.text9.value+.text15.value+.text20.value+val(.text11.value),10,2)
			endwith
		endif
		
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
		local x,y
		if nitem>0
			this.col=0
			aux=val(this.text)
			this.col=3
			dato1=val(this.text)
			this.col=1
			dato2=this.text
			this.col=4
			dato3=this.text
			descri=dato3	
			this.col=5
			dato4=this.text
			pruni=dato4
			this.col=6
			prtot=this.text
			this.col=2
			dato5=this.text
			do case
				case this.text="DTO"
					opcion=1
					codigo=0
				case this.text="CARGO"
					opcion=2
					codigo=0
				other case
					this.col=7
					if this.text="SS"
						opcion=3
					else
						opcion=0
					endif
			endcase
			do form modippreg with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		if borra=6
			with thisform
				this.col=6
				acu=acu-val(this.text)
		*		sele recepciones_articulos
		*		set order to artrecep
		*		seek str(codr)+str(dato1)
		*		if found()
		*			this.col=3
		*			repla articulos.pedprov with articulos.pedprov+val(dato2)
		*		endif
				if this.rows=2
					nitem=nitem-1
					this.rows=1
					acu=0
					.text8.value=""
					.text9.value=""
					.text10.value=""
					.text11.value=""
					.text17.value=""
					.text18.value=""
					.text19.value=0
				else
					nitem=nitem-1
					this.removeitem(this.row)
					filaux=this.row
					x=1
					do while x<=this.rows-1
						this.row=x
						this.col=0
						this.text=allt(str(x))
						x=x+1
					enddo
					this.row=filaux
				endif
			endwith
			borra=0
			insertar=0
		endif
		if insertar=1 and codigo<>0
			with thisform
				this.col=0
				nro=this.row
				sele articulos
				set order to art_codi
				seek codigo
				this.additem(" "+chr(9)+trim(cant)+chr(9)+art_med+chr(9)+allt(str(art_codi))+chr(9)+descri+chr(9)+allt(pruni)+chr(9)+prtot,.grid1.row)
				acu=acu+val(prtot)
				nitem=nitem+1
				muestro=0
				x=1
				do while x<=this.rows-1
					this.row=x
					this.col=0
					this.text=allt(str(x))
					x=x+1
				enddo
				insertar=0
			endwith
		endif
		if insertar=1 and alternati="S"
			with thisform
				.grid1.additem(" "+chr(9)+" "+chr(9)+"DTO"+chr(9)+" "+chr(9)+allt(descri)+chr(9)+allt(str(porcdto,7,3))+"%",.grid1.row)
				filaux=.grid1.row-1
				.grid1.col=6
				incremento=0
				for i=1 to filaux
					.grid1.row=i
					incremento=incremento+val(.grid1.text)
				next i
				.grid1.row=filaux+1
				.grid1.text="-"+allt(str(incremento*round((porcdto/100),2),10,2))
				acu=acu+val(.grid1.text)
				haydescuento="S"
				muestro=0
				insertar=0
			endwith
		endif
		do case
			case opcion=3
				this.col=7
				this.text="SS"
				opcion=0
			case opcion=4
				this.col=7
				this.text=""
		endcase
	ENDPROC

	PROCEDURE grid1.GotFocus
		on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		if localiz=1
			if elimi=0 and nitem>0
				this.toprow=nitem	
			else
				elimi=0
			endif
		endif
	ENDPROC

	PROCEDURE Text13.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text13.GotFocus
		codigo=0
		opcion=0
		on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		if localiz=1
			if elimi=0
				thisform.grid1.toprow=nitem
			else
				elimi=0
			endif
		endif
	ENDPROC

	PROCEDURE Text13.Valid
		sele parametros
		set order to param_desc
		seek "ULTCIERCOM"
		if found()
			if this.value<param_fec and this.value<>ctod("  /  /    ")
				=messagebox("Ultima fecha de cierre de Iva Compras "+dtoc(param_fec)+chr(13)+;
							"Imposible ingresar la recepcion con esta fecha",0+48,"Advertencia!")
				this.value=ctod("  /  /    ")
				return 0
			endif
		endif
	ENDPROC

	PROCEDURE Text14.Valid
		sele recepciones
		set order to recep_codi
		seek codr
		if found()
			if this.value<>prov_rto
				factura=messagebox("Seguro que desea modificar el Número de Remito, por favor verifique con sumo cuidado",4+48+256,"Advertencia")
				if factura=7
					this.value=prov_rto
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Text16.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text16.LostFocus
		if acu>0
			with thisform
				if this.value>0
					.text15.value=val(str((val(.text18.value)*.text16.value)/100,10,2))
					.text10.value=str(val(.text18.value)+val(.text9.value)+.text15.value+.text20.value+val(.text11.value),10,2)
				else
					.text15.value=0
					.text10.value=str(val(.text18.value)+val(.text9.value)+val(.text11.value),10,2)
				endif			
			endwith
		endif		
			
	ENDPROC

	PROCEDURE Text19.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text19.LostFocus
		local acuivait
		acuivait=0
		with thisform
			if .optiongroup1.value=2
				acu=0
				for i=1 to .grid1.rows-1
					.grid1.row=i
					.grid1.col=8
					if allt(.grid1.text)="X"
						.grid1.col=6
						acuivait=acuivait+val(.grid1.text)
					else
						.grid1.col=6
						acu=acu+val(.grid1.text)
					endif
				next
				dtotot=((acu+acuivait)*this.value)/100
				.text17.value=str(dtotot,10,2)
				.text18.value=str((acu+acuivait)-dtotot,10,2)
				.text24.value=str(val(.text18.value)*.text25.value/100,10,2)
				if cond=2
					.text9.value=str((acuivait*round((100-this.value)/100,2))*impiva1/100,10,2)
				endif
				if .text16.value>0
					.text15.value=val(str((val(.text18.value)*.text16.value)/100,10,2))
				endif
				if .text21.value>0
					.text20.value=val(str((val(.text18.value)*.text21.value)/100,10,2))
				endif
				.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+.text20.value+val(.text11.value),10,2)
				acu=acu+acuivait
			else
				dtotot=acu*this.value/100
				.text17.value=str(dtotot,10,2)
				.text18.value=str(acu-dtotot,10,2)
				.text24.value=str(val(.text18.value)*.text25.value/100,10,2)
				if cond=2
					.text9.value=str(val(.text18.value)*impiva1/100,10,2)
				endif
				if .text16.value>0
					.text15.value=val(str((val(.text18.value)*.text16.value)/100,10,2))
				endif
				if .text21.value>0
					.text20.value=val(str((val(.text18.value)*.text21.value)/100,10,2))
				endif
				.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+.text20.value+val(.text11.value),10,2)
			endif
		endwith
	ENDPROC

	PROCEDURE Text21.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text21.LostFocus
		if acu>0
			with thisform
				if this.value>0
					.text20.value=val(str((val(.text18.value)*.text21.value)/100,10,2))
					.text10.value=str(val(.text18.value)+val(.text9.value)+.text15.value+.text20.value+val(.text11.value),10,2)
				else
					.text20.value=0
					.text10.value=str(val(.text18.value)+val(.text9.value)+val(.text11.value),10,2)
				endif			
			endwith
		endif		
			
	ENDPROC

	PROCEDURE Text22.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text23.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text25.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text25.LostFocus
		local acuivait
		acuivait=0
		with thisform
			if .optiongroup1.value=2
				acu=0
				for i=1 to .grid1.rows-1
					.grid1.row=i
					.grid1.col=8
					if allt(.grid1.text)="X"
						.grid1.col=6
						acuivait=acuivait+val(.grid1.text)
					else
						.grid1.col=6
						acu=acu+val(.grid1.text)
					endif
				next
				.text17.value=str((acu+acuivait)*.text19.value/100,10,2)
				.text18.value=str((acu+acuivait)-val(.text17.value),10,2)
				.text24.value=str(val(.text18.value)*this.value/100,10,2)
				if cond=2
					.text9.value=str((acuivait*round((100-.text19.value)/100,2))*impiva1/100,10,2)
				endif
				if .text16.value>0
					.text15.value=val(str((val(.text18.value)*.text16.value)/100,10,2))
				endif
				if .text21.value>0
					.text20.value=val(str((val(.text18.value)*.text21.value)/100,10,2))
				endif
				.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+.text20.value+val(.text11.value),10,2)
				acu=acu+acuivait
			else
				.text17.value=str(acu*.text19.value/100,10,2)
				.text18.value=str(acu-val(.text17.value),10,2)
				.text24.value=str(val(.text18.value)*this.value/100,10,2)
				if cond=2
					.text9.value=str(val(.text18.value)*impiva1/100,10,2)
				endif
				if .text16.value>0
					.text15.value=val(str((val(.text18.value)*.text16.value)/100,10,2))
				endif
				if .text21.value>0
					.text20.value=val(str((val(.text18.value)*.text21.value)/100,10,2))
				endif
				.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+.text20.value+val(.text11.value),10,2)
			endif
		endwith
	ENDPROC

	PROCEDURE Text7.Valid
		sele recepciones
		set order to facprov
		seek str(codiprov)+str(this.value)
		if found() and this.value<>prov_fac
			messagebox("La factura Nº: "+allt(str(this.value))+" de "+allt(proveedores.prov_nomb)+" ya esta en archivo. No puede ingresar mas de una vez las facturas de los proveedores, duplicaría stock inexistente",0+48,"Advertencia")
			this.value=0
			return 0
		endif
	ENDPROC

ENDDEFINE

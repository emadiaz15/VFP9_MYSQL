	PROCEDURE Destroy
		set point to
		set separator to
		pasrec=0
	ENDPROC

	PROCEDURE GotFocus
		set point to ","
		set separator to "."
	ENDPROC

	PROCEDURE Init
		parameter codirec,cond
		set dele on
		set point to ","
		set separator to "."
		set date british
		set cent on
		set exact on
		
		local cad1,cad2,cad3,cadenanro
		
		create cursor recfac(fecha D,fac_codi N(8),impag N(15,2),parcial N(1))
		create cursor recsini(fecha D,sini_cod N(8),impag N(15,2),parcial N(1))
		CREATE CURSOR recdebi(fecha D,debv_codi N(8),impag N(15,2),parcial N(1))
		CREATE CURSOR reccrei(fecha D,crev_codi N(8),impag N(15,2),parcial N(1))
		create cursor recfacsini(fecha D,fac_codi N(8),sini_cod N(8),debv_codi N(8),crev_codi N(8),impag N(15,2),parcial N(1))
		
		create cursor totregis(instancia N(2),rec_nro N(8),fac_codi N(8),sini_cod N(8),debv_codi N(8),crev_codi N(8),sa C(1),pagfac_impo N(15,2),pag_fech D, ;
		                       cli_codi N(8),rec_dtosaf N(15,2),rec_antic N(15,2),rec_restsaf N(15,2),recfac_codi N(8),recsini_cod N(8),recdebi_cod N(8),reccrei_cod N(8), ;
		                       fac_conc C(1),fac_pto N(4),fac_nro N(8),fac_fec D,sini_fech D,debv_fech D,crev_fech D,recfac_parci N(1),recsini_parci N(1), ;
		                       recdebi_parci N(1),reccrei_parci N(1),recpag_codi N(8),tippag_codi N(8), ;
		                       tippag_desc C(25),movtippag_nro C(14),ban_codi N(8),ban_desc C(45),ban_cuit N(11),movtippag_pza C(25), movtippag_fvto D, ;
		                       movtippag_imp N(15,2),cuit_lib N(11),parcial N(1))
		
		index on instancia to SYS(2015)
		
		public obser,pasfac
		
		obser=""
		importe=0
		totalfac=0
		totcred=0
		totdeb=0
		codrecpag=0
		pasfac=0
		with this
			.text7.value=0
			.text8.value=0
			.text14.value=0
			.text15.value=0
			.text9.value=0
			.text10.value=0
			.text16.value=0
		endwith
		if codirec>0
			frmconsrec= conectar_db(_screen.cn)
				SQLEXEC(frmconsrec,"select * from recibos where rec_codi=?codirec;","cur_reci")
				codicli=cur_reci.cli_codi
			desconectar_db(frmconsrec)
			with thisform
				.command2.enabled=.T.
				if pasrec=1
					.command2.visible=.F.
				else
					.command2.visible=.T.
				endif
				.command3.enabled=.T.
				.text1.value=cur_clie.cli_nomb
				.text2.value=cur_clie.cli_domi
				.text6.value=cur_clie.cond_desc
				.text12.value=ALLTRIM(cur_clie.cli_cuit)
				.text3.value=cur_clie.cp_nro
				.text4.value=cur_clie.loca_nomb
				.text5.value=cur_clie.provi_nomb
				IF LEN(ALLTRIM(cur_reci.rec_obser)) > 0
					thisform.cmd_obser.Enabled= .T.
				ELSE
					thisform.cmd_obser.Enabled= .F.
				ENDIF 		
				cuit=VAL(cur_clie.cli_cuit)
				cond=cur_clie.cond_codi
				obser=cur_reci.rec_obser
				if RECCOUNT("cur_reci")>0
					insert into totregis(instancia,rec_nro,pag_fech,cli_codi);
						values(1,cur_reci.rec_nro,cur_reci.rec_fec,codicli)
					frmconsrec= conectar_db(_screen.cn)
						SQLEXEC(frmconsrec,"SELECT b.fac_fec,a.fac_codi,a.recfac_impo,a.recfac_parci FROM recibos_facturas a INNER JOIN facturas b on a.fac_codi=b.fac_codi WHERE a.rec_codi=?codirec;","recfac")
						index on fac_codi to SYS(2015)
					
						SQLEXEC(frmconsrec,"SELECT b.sini_fech,a.sini_cod,a.recsini_imp,a.recsini_parci FROM recibos_saldosiniciales a INNER JOIN saldosiniciales b on a.sini_cod=b.sini_cod WHERE a.rec_codi=?codirec;","recsini")
						index on sini_cod to SYS(2015)
						
						SQLEXEC(frmconsrec,"SELECT b.debv_fech,a.debv_codi,a.recdebi_imp,a.recdebi_parci FROM recibos_debintv a INNER JOIN debintv b on a.debv_codi=b.debv_codi WHERE a.rec_codi=?codirec;","recdebi")
						index on debv_codi to SYS(2015)
		
						SQLEXEC(frmconsrec,"SELECT b.crev_fech,a.crev_codi,a.reccrei_imp,a.reccrei_parci FROM recibos_creintv a INNER JOIN creintv b on a.crev_codi=b.crev_codi WHERE a.rec_codi=?codirec;","reccrei")
						index on crev_codi to SYS(2015)				
					desconectar_db(frmconsrec)
					sele recfac
					go top
					scan
						insert into recfacsini(fecha,fac_codi,sini_cod,debv_codi,crev_codi,impag,parcial) ;
									values(recfac.fac_fec,recfac.fac_codi,0,0,0,recfac.recfac_impo,recfac.recfac_parci)
					endscan
					sele recsini
					go top
					scan
						insert into recfacsini(fecha,fac_codi,sini_cod,debv_codi,crev_codi,impag,parcial) ;
									values(recsini.sini_fech,0,recsini.sini_cod,0,0,recsini.recsini_imp,recsini.recsini_parci)
					endscan
					sele recdebi
					go top
					scan
						insert into recfacsini(fecha,fac_codi,sini_cod,debv_codi,crev_codi,impag,parcial) ;
									values(recdebi.debv_fech,0,0,recdebi.debv_codi,0,recdebi.recdebi_imp,recdebi.recdebi_parci)
					ENDSCAN
					sele reccrei
					go top
					scan
						insert into recfacsini(fecha,fac_codi,sini_cod,debv_codi,crev_codi,impag,parcial) ;
									values(reccrei.crev_fech,0,0,0,reccrei.crev_codi,reccrei.reccrei_imp,reccrei.reccrei_parci)
					endscan			
					sele recfacsini
					index on fecha to SYS(2015)
					go top
					i=1
					scan
						do case
							case fac_codi>0
								frmconsrec= conectar_db(_screen.cn)
									SQLEXEC(frmconsrec,"select * from facturas where fac_codi=?recfacsini.fac_codi;","faclis")
								desconectar_db(frmconsrec)
								.list1.list(i,1)=dtoc(faclis.fac_fec)
								do case
									case faclis.fac_conc="F"
										.list1.list(i,2)=iif(faclis.fac_tipo="A","FA","FB")
									case faclis.fac_conc="N"
										.list1.list(i,2)=iif(faclis.fac_tipo="A","NCA","NCB")
									case faclis.fac_conc="D"
										.list1.list(i,2)=iif(faclis.fac_tipo="A","NDA","NDB")
								endcase
								.list1.list(i,3)=alltrim(str(faclis.fac_pto))
								.list1.list(i,4)=rtrim(str(faclis.fac_nro))
								.list1.list(i,6)=str(faclis.fac_codi)
								insert into totregis(instancia,fac_codi,fac_fec,fac_pto,fac_nro,fac_conc,pagfac_impo,recfac_parci) ;
										values(1,faclis.fac_codi,faclis.fac_fec,faclis.fac_pto,faclis.fac_nro,faclis.fac_conc,recfacsini.impag,recfac.recfac_parci)
							case sini_cod>0
								frmconsrec= conectar_db(_screen.cn)
									SQLEXEC(frmconsrec,"select * from saldosiniciales where sini_cod=?recfacsini.sini_cod;","sinlis")
								desconectar_db(frmconsrec)
								.list1.list(i,1)=dtoc(sinlis.sini_fech)
								.list1.list(i,2)="SIV"
								.list1.list(i,3)="0"
								.list1.list(i,4)=rtrim(str(sini_cod))
								.list1.list(i,6)=str(sinlis.sini_cod)
								frmconsrec= conectar_db(_screen.cn)
									SQLEXEC(frmconsrec,"select * from recibos_saldosiniciales where rec_codi=?codirec and sini_cod=?recfacsini.sini_cod;","reci_fac")
								desconectar_db(frmconsrec)
								insert into totregis(instancia,sini_cod,sini_fech,recsini_cod,pagfac_impo,recsini_parci) ;
										values(1,recfacsini.sini_cod,sinlis.sini_fech,reci_fac.recsini_cod,recfacsini.impag,reci_fac.recsini_parci)
								sele recfacsini
							case debv_codi>0
								frmconsrec= conectar_db(_screen.cn)
									SQLEXEC(frmconsrec,"select * from debintv where debv_codi=?recfacsini.debv_codi;","deblis")
								desconectar_db(frmconsrec)
								.list1.list(i,1)=dtoc(deblis.debv_fech)
								.list1.list(i,2)="DIV"
								.list1.list(i,3)="0"
								.list1.list(i,4)=rtrim(str(deblis.debv_codi))
								.list1.list(i,6)=str(deblis.debv_codi)
								frmconsrec= conectar_db(_screen.cn)
									SQLEXEC(frmconsrec,"select * from recibos_debintv where rec_codi=?codirec and debv_codi=?recfacsini.debv_codi;","reci_deb")
								desconectar_db(frmconsrec)
								insert into totregis(instancia,debv_codi,debv_fech,recdebi_cod,pagfac_impo,recdebi_parci) ;
										values(1,recfacsini.debv_codi,deblis.debv_fech,reci_deb.recdebi_cod,recfacsini.impag,reci_deb.recdebi_parci)
								sele recfacsini
							case crev_codi>0
								frmconsrec= conectar_db(_screen.cn)
									SQLEXEC(frmconsrec,"select * from creintv where crev_codi=?recfacsini.crev_codi;","crelis")
								desconectar_db(frmconsrec)
								.list1.list(i,1)=dtoc(crelis.crev_fech)
								.list1.list(i,2)="CIV"
								.list1.list(i,3)="0"
								.list1.list(i,4)=rtrim(str(crelis.crev_codi))
								.list1.list(i,6)=str(crelis.crev_codi)
								frmconsrec= conectar_db(_screen.cn)
									SQLEXEC(frmconsrec,"select * from recibos_creintv where rec_codi=?codirec and crev_codi=?recfacsini.crev_codi;","reci_cre")
								desconectar_db(frmconsrec)
								insert into totregis(instancia,crev_codi,crev_fech,reccrei_cod,pagfac_impo,reccrei_parci) ;
										values(1,recfacsini.crev_codi,crelis.crev_fech,reci_cre.reccrei_cod,recfacsini.impag,reci_cre.reccrei_parci)
								sele recfacsini											
						endcase
						.list1.list(i,5)=TRANSFORM(recfacsini.impag ,"$ 999,999,999.99")&&rtrim(str(recfacsini.impag,15,2))
						i=i+1
					endscan
					.text9.style=1
					.text10.style=1
					.text13.style=1
					.text9.value=cur_reci.rec_tipo
					.text10.value=cur_reci.rec_nro
					.text13.value=cur_reci.rec_fec
					.text7.value=cur_reci.rec_impo+cur_reci.rec_dtosaf
					.text8.value=-cur_reci.rec_dtosaf
					.text16.value=cur_reci.rec_antic
					.text14.value=.text7.value+.text8.value+.text16.value
					frmconsrec= conectar_db(_screen.cn)
						SQLEXEC(frmconsrec,"select a.*,b.tippag_desc from recibos_pagos a inner join tipospago b on a.tippag_codi=b.tippag_codi where a.rec_codi=?codirec;","cur_recpag")
					desconectar_db(frmconsrec)
					IF RECCOUNT("cur_recpag")>0
						GO top
						scan
							if tippag_codi=3 OR tippag_codi=20
								cadenacuit=subst(ALLTRIM(cuit_lib),1,2)+"-"+subst(ALLTRIM(cuit_lib),3,8)+"-"+SUBSTR(allt(cuit_lib),11,1)
							else
								cadenacuit=""
							endif
							if tippag_codi=3
								cad1=repl("0",3-len(allt(str(ban_codi))))+allt(str(ban_codi))
								cad2=repl("0",3-len(allt(str(suc_codi))))+allt(str(suc_codi))
								cad3=repl("0",8-len(allt(movtippag_nro)))+allt(movtippag_nro)
								cadenanro=cad1+cad2+cad3
							else
								cadenanro=allt(movtippag_nro)
							ENDIF
							frmconsrec= conectar_db(_screen.cn)
								SQLEXEC(frmconsrec,"select * from bancos where ban_codi=?cur_recpag.ban_codi;","cur_bco")
							desconectar_db(frmconsrec)
							fvto=IIF(ISNULL(cur_recpag.movtippag_fvto),{  /  /    },cur_recpag.movtippag_fvto)
							.olecontrol1.additem(allt(cur_recpag.tippag_desc)+chr(9)+cadenanro+chr(9)+ ;
											     cadenacuit+chr(9)+allt(cur_bco.ban_desc)+chr(9)+allt(cur_recpag.movtippag_pza)+chr(9)+ ;
										   		 dtoc(fvto)+chr(9)+allt(str(cur_recpag.movtippag_imp,15,2))+CHR(9)+ ;
										   		 IIF(ISNULL(cur_recpag.cheqid),'',ALLTRIM(cur_recpag.cheqid))+chr(9)+allt(str(cur_recpag.recpag_codi)))
							.olecontrol1.row=.olecontrol1.rows-1
							.olecontrol1.col=3
							.olecontrol1.cellalignment=0
							.olecontrol1.col=4
							.olecontrol1.cellalignment=0
							.text15.value=.text15.value+cur_recpag.movtippag_imp
							insert into totregis(instancia,recpag_codi,tippag_codi,tippag_desc,movtippag_nro,ban_codi,ban_desc,ban_cuit, ;
			                                     movtippag_pza,movtippag_fvto,movtippag_imp,cuit_lib) ;
			                             values(2,cur_recpag.recpag_codi,cur_recpag.tippag_codi,cur_recpag.tippag_desc,cadenanro, ;
			                             		cur_recpag.ban_codi,cur_bco.ban_desc,VAL(cur_bco.ban_cuit),cur_recpag.movtippag_pza, ;
			                             		fvto,cur_recpag.movtippag_imp, ;
			                             		VAL(cur_recpag.cuit_lib))
						ENDSCAN
					endif
				ENDIF
				SELECT totregis
		
				GO top
		*!*			LOCAL arch
		*!*			
		*!*			arch="C:\Users\Administrador\Desktop\instancia_"+SYS(2015)+".xls"
		*!*			
		*!*			COPY TO &arch TYPE xls
				
				*DISPLAY STRUCTURE TO FILE &arch
		
		    ENDWITH
		else
			with thisform
				.text9.style=0
				.text10.style=0
				frmconsrec= conectar_db(_screen.cn)
					SQLEXEC(frmconsrec,"select rec_tipo from recibos order by rec_codi desc limit 1;","cur_tipo")
				desconectar_db(frmconsrec)
				.text9.value=cur_tipo.rec_tipo
			endwith
		endif
	ENDPROC

	PROCEDURE LostFocus
		set point to
		set separator to
	ENDPROC

	PROCEDURE cmd_obser.Click
		IF USED("cur_reci")
			IF LEN(ALLTRIM(cur_reci.rec_obser)) > 0
				MESSAGEBOX(cur_reci.rec_obser,64,"Observaciones del Recibo")
			ENDIF
		ENDIF 
	ENDPROC

	PROCEDURE cmd_obser.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE cmd_obser.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command2.Click
		codicli=cur_reci.cli_codi
		do form reciload with codicli
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command3.Click
		local comprobante,lcletra,xfecha
		
		xfecha="Río Cuarto, "+Dia_nombre(dow(totregis.pag_fech)) +" "+ allt(str(DAY(totregis.pag_fech)))+ ' de ' +Mes_nombre(month(totregis.pag_fech))+ ' de '+allt(str(year(totregis.pag_fech)))
		
		do monto2letra with thisform.text14.value,lcletra in ntoletra
		
		SELECT totregis
		
		GO TOP
		
		for m=1 to 2
			do case
				case m=1
					comprobante="Original"
				case m=2
					comprobante="Duplicado"
			endcase
			report form recibo TO PRINTER PROMPT noconsole
		next
		thisform.text9.setfocus
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE List1.Click
		*!*	if this.selected(this.listindex)
		*!*		this.selected(this.listindex)=.F.
		*!*	endif
	ENDPROC

	PROCEDURE List1.DblClick
		LOCAL codifac,debintcli,creintcli
		STORE 0 TO codifac,debintcli,creintcli
		WITH thisform
			for n=1 to this.listcount
				if this.selected(n) AND VAL(this.List(n,6))>0
					DO CASE
						CASE ALLTRIM(this.List(n,2))="DIV"
							pasdiv=1
							debintcli=VAL(this.List(n,6))
							DO FORM consdebintcli with debintcli
						CASE ALLTRIM(this.List(n,2))="CIV"
							pasdiv=1
							creintcli=VAL(this.List(n,6))
							DO FORM conscreintcli with creintcli
					OTHERWISE
						pasfac=1
						codifac=val(.list1.list(n,6))
						do form consfactura with codifac,cond
						SELECT totregis
					ENDCASE
				endif
			next n
		ENDWITH
	ENDPROC

	PROCEDURE Olecontrol1.DblClick
		*** ActiveX Control Event ***
		LOCAL xchcod,xtip
		this.col=0
		if allt(this.text)="CHEQUE" OR allt(this.text)="ECHEQ"
			xtip = ICASE(allt(this.text)="CHEQUE",1,allt(this.text)="ECHEQ",2)
			this.col=8
			xchcod=VAL(this.text)
			do form conscheqrap with xchcod,xtip
			SELECT totregis
		endif
	ENDPROC

	PROCEDURE Text10.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text10.LostFocus
		local paso
		
		local cad1,cad2,cad3,cadenanro
		
		paso=0
		SET SAFETY OFF
		sele totregis
		ZAP
		SELECT recfacsini
		ZAP
		SET SAFETY ON
		with thisform
		.text1.value=""
		.text2.value=""
		.text3.value=""
		.text4.value=""
		.text5.value=""
		.text6.value=""
		.text12.value=""
		.text13.value=ctod("  /  /    ")
		.text7.value=0
		.text8.value=0
		.text16.value=0
		.text14.value=0
		.text15.value=0
		.list1.rowsource=''
		if .olecontrol1.rows>1
			.olecontrol1.rows=1
		endif
		if this.value>0
		*!*		.command2.enabled=.T.
		*!*		if pasrec=1
		*!*			.command2.visible=.F.
		*!*		else
		*!*			.command2.visible=.T.
		*!*		endif
			.command3.enabled=.T.
			frmconsrec= conectar_db(_screen.cn)
				SQLEXEC(frmconsrec,"select * from recibos where rec_tipo=?.text9.value and rec_nro=?this.value;","cur_reci")
				codicli=cur_reci.cli_codi
				codirec=cur_reci.rec_codi
				SQLEXEC(frmconsrec,"call usp_buscarcli(?codicli);","cur_clie")
		*!*			SQLEXEC(frmconsrec,"select * from condiva where cond_codi=?cur_clie.cond_codi;","cur_condi")
			desconectar_db(frmconsrec)
			if RECCOUNT("cur_reci")>0
		*!*			.command2.enabled=.T.
		*!*			if pasrec=1
		*!*				.command2.visible=.F.
		*!*			else
		*!*				.command2.visible=.T.
		*!*			endif
				.command3.enabled=.T.
				.text1.value=cur_clie.cli_nomb
				.text2.value=cur_clie.cli_domi
				.text6.value=cur_clie.cond_desc
				.text12.value=ALLTRIM(cur_clie.cli_cuit)
				.text3.value=cur_clie.cp_nro
				.text4.value=cur_clie.loca_nomb
				.text5.value=cur_clie.provi_nomb
				IF LEN(ALLTRIM(cur_reci.rec_obser)) > 0
					thisform.cmd_obser.Enabled= .T.
				ELSE
					thisform.cmd_obser.Enabled= .F.
				ENDIF 
				cuit=VAL(cur_clie.cli_cuit)
				cond=cur_clie.cond_codi
				obser=cur_reci.rec_obser
				insert into totregis(instancia,rec_nro,pag_fech,cli_codi);
					values(1,cur_reci.rec_nro,cur_reci.rec_fec,codicli)
				frmconsrec= conectar_db(_screen.cn)
					SQLEXEC(frmconsrec,"SELECT b.fac_fec,a.fac_codi,a.recfac_impo,a.recfac_parci FROM recibos_facturas a INNER JOIN facturas b on a.fac_codi=b.fac_codi WHERE a.rec_codi=?codirec;","recfac")
					index on fac_codi to SYS(2015)
				
					SQLEXEC(frmconsrec,"SELECT b.sini_fech,a.sini_cod,a.recsini_imp,a.recsini_parci FROM recibos_saldosiniciales a INNER JOIN saldosiniciales b on a.sini_cod=b.sini_cod WHERE a.rec_codi=?codirec;","recsini")
					index on sini_cod to SYS(2015)
						
					SQLEXEC(frmconsrec,"SELECT b.debv_fech,a.debv_codi,a.recdebi_imp,a.recdebi_parci FROM recibos_debintv a INNER JOIN debintv b on a.debv_codi=b.debv_codi WHERE a.rec_codi=?codirec;","recdebi")
					index on debv_codi to SYS(2015)
		
					SQLEXEC(frmconsrec,"SELECT b.crev_fech,a.crev_codi,a.reccrei_imp,a.reccrei_parci FROM recibos_creintv a INNER JOIN creintv b on a.crev_codi=b.crev_codi WHERE a.rec_codi=?codirec;","reccrei")
					index on crev_codi to SYS(2015)			
				desconectar_db(frmconsrec)
				sele recfac
				go top
				scan
					insert into recfacsini(fecha,fac_codi,sini_cod,debv_codi,crev_codi,impag,parcial) ;
								values(recfac.fac_fec,recfac.fac_codi,0,0,0,recfac.recfac_impo,recfac.recfac_parci)
				endscan
				sele recsini
				go top
				scan
					insert into recfacsini(fecha,fac_codi,sini_cod,debv_codi,crev_codi,impag,parcial) ;
								values(recsini.sini_fech,0,recsini.sini_cod,0,0,recsini.recsini_imp,recsini.recsini_parci)
				endscan
				sele recdebi
				go top
				scan
					insert into recfacsini(fecha,fac_codi,sini_cod,debv_codi,crev_codi,impag,parcial) ;
								values(recdebi.debv_fech,0,0,recdebi.debv_codi,0,recdebi.recdebi_imp,recdebi.recdebi_parci)
				ENDSCAN
				sele reccrei
				go top
				scan
					insert into recfacsini(fecha,fac_codi,sini_cod,debv_codi,crev_codi,impag,parcial) ;
								values(reccrei.crev_fech,0,0,0,reccrei.crev_codi,reccrei.reccrei_imp,reccrei.reccrei_parci)
				endscan			
				sele recfacsini
				index on fecha to SYS(2015)
				go top
				i=1
				scan
					do case
						case fac_codi>0
							frmconsrec= conectar_db(_screen.cn)
								SQLEXEC(frmconsrec,"select * from facturas where fac_codi=?recfacsini.fac_codi;","faclis")
							desconectar_db(frmconsrec)
							.list1.list(i,1)=dtoc(faclis.fac_fec)
							do case
								case faclis.fac_conc="F"
									.list1.list(i,2)=iif(faclis.fac_tipo="A","FA","FB")
								case faclis.fac_conc="N"
									.list1.list(i,2)=iif(faclis.fac_tipo="A","NCA","NCB")
								case faclis.fac_conc="D"
									.list1.list(i,2)=iif(faclis.fac_tipo="A","NDA","NDB")
							endcase
							.list1.list(i,3)=alltrim(str(faclis.fac_pto))
							.list1.list(i,4)=rtrim(str(faclis.fac_nro))
							.list1.list(i,6)=str(faclis.fac_codi)
							insert into totregis(instancia,fac_codi,fac_fec,fac_pto,fac_nro,fac_conc,pagfac_impo,recfac_parci) ;
									values(1,faclis.fac_codi,faclis.fac_fec,faclis.fac_pto,faclis.fac_nro,faclis.fac_conc,recfacsini.impag,recfacsini.parcial)
							SELECT recfacsini
						case sini_cod>0
							frmconsrec= conectar_db(_screen.cn)
								SQLEXEC(frmconsrec,"select * from saldosiniciales where sini_cod=?recfacsini.sini_cod;","sinlis")
							desconectar_db(frmconsrec)
							.list1.list(i,1)=dtoc(sinlis.sini_fech)
							.list1.list(i,2)="SIV"
							.list1.list(i,3)="0"
							.list1.list(i,4)=rtrim(str(sini_cod))
							.list1.list(i,6)=str(sinlis.sini_cod)
							frmconsrec= conectar_db(_screen.cn)
								SQLEXEC(frmconsrec,"select * from recibos_saldosiniciales where rec_codi=?codirec and sini_cod=?recfacsini.sini_cod;","reci_fac")
							desconectar_db(frmconsrec)	
							insert into totregis(instancia,sini_cod,sini_fech,recsini_cod,pagfac_impo,recsini_parci) ;
									values(1,recfacsini.sini_cod,sinlis.sini_fech,reci_fac.recsini_cod,recfacsini.impag,recfacsini.parcial)
							sele recfacsini
						case debv_codi>0
							frmconsrec= conectar_db(_screen.cn)
								SQLEXEC(frmconsrec,"select * from debintv where debv_codi=?recfacsini.debv_codi;","deblis")
							desconectar_db(frmconsrec)
							.list1.list(i,1)=dtoc(deblis.debv_fech)
							.list1.list(i,2)="DIV"
							.list1.list(i,3)="0"
							.list1.list(i,4)=rtrim(str(deblis.debv_codi))
							.list1.list(i,6)=str(deblis.debv_codi)
							frmconsrec= conectar_db(_screen.cn)
								SQLEXEC(frmconsrec,"select * from recibos_debintv where rec_codi=?codirec and debv_codi=?recfacsini.debv_codi;","reci_deb")
							desconectar_db(frmconsrec)
							insert into totregis(instancia,debv_codi,debv_fech,recdebi_cod,pagfac_impo,recdebi_parci) ;
									values(1,recfacsini.debv_codi,deblis.debv_fech,reci_deb.recdebi_cod,recfacsini.impag,reci_deb.recdebi_parci)
							sele recfacsini
						case crev_codi>0
							frmconsrec= conectar_db(_screen.cn)
								SQLEXEC(frmconsrec,"select * from creintv where crev_codi=?recfacsini.crev_codi;","crelis")
							desconectar_db(frmconsrec)
							.list1.list(i,1)=dtoc(crelis.crev_fech)
							.list1.list(i,2)="CIV"
							.list1.list(i,3)="0"
							.list1.list(i,4)=rtrim(str(crelis.crev_codi))
							.list1.list(i,6)=str(crelis.crev_codi)
							frmconsrec= conectar_db(_screen.cn)
								SQLEXEC(frmconsrec,"select * from recibos_creintv where rec_codi=?codirec and crev_codi=?recfacsini.crev_codi;","reci_cre")
							desconectar_db(frmconsrec)
							insert into totregis(instancia,crev_codi,crev_fech,reccrei_cod,pagfac_impo,reccrei_parci) ;
									values(1,recfacsini.crev_codi,crelis.crev_fech,reci_cre.reccrei_cod,recfacsini.impag*(-1),reci_cre.reccrei_parci)
							sele recfacsini						
					endcase
					.list1.list(i,5)=rtrim(str(recfacsini.impag,10,2))
					i=i+1
				endscan
				.text9.value=cur_reci.rec_tipo
				.text10.value=cur_reci.rec_nro
				.text13.value=cur_reci.rec_fec
				.text7.value=cur_reci.rec_impo+cur_reci.rec_dtosaf
				.text8.value=-cur_reci.rec_dtosaf
				.text16.value=cur_reci.rec_antic
				.text14.value=.text7.value+.text8.value+.text16.value
				frmconsrec= conectar_db(_screen.cn)
					SQLEXEC(frmconsrec,"select a.*,b.tippag_desc from recibos_pagos a inner join tipospago b on a.tippag_codi=b.tippag_codi where a.rec_codi=?codirec;","cur_recpag")
				desconectar_db(frmconsrec)
				IF RECCOUNT("cur_recpag")>0
					GO top
					scan
						if tippag_codi=3 OR tippag_codi=20
							cadenacuit=subst(ALLTRIM(cuit_lib),1,2)+"-"+subst(ALLTRIM(cuit_lib),3,8)+"-"+SUBSTR(allt(cuit_lib),11,1)
						else
							cadenacuit=""
						endif
						if tippag_codi=3
							cad1=repl("0",3-len(allt(str(ban_codi))))+allt(str(ban_codi))
							cad2=repl("0",3-len(allt(str(suc_codi))))+allt(str(suc_codi))
							cad3=repl("0",8-len(allt(movtippag_nro)))+allt(movtippag_nro)
							cadenanro=cad1+cad2+cad3
						else
							cadenanro=allt(movtippag_nro)
						ENDIF
						frmconsrec= conectar_db(_screen.cn)
							SQLEXEC(frmconsrec,"select * from bancos where ban_codi=?cur_recpag.ban_codi;","cur_bco")
						desconectar_db(frmconsrec)
						fvto=IIF(ISNULL(cur_recpag.movtippag_fvto),{  /  /    },cur_recpag.movtippag_fvto)
						.olecontrol1.additem(allt(cur_recpag.tippag_desc)+chr(9)+cadenanro+chr(9)+ ;
										     cadenacuit+chr(9)+allt(cur_bco.ban_desc)+chr(9)+allt(cur_recpag.movtippag_pza)+chr(9)+ ;
									   		 dtoc(fvto)+chr(9)+allt(str(cur_recpag.movtippag_imp,10,2))+chr(9)+''+chr(9)+allt(str(cur_recpag.recpag_codi)))
						.olecontrol1.row=.olecontrol1.rows-1
						.olecontrol1.col=3
						.olecontrol1.cellalignment=0
						.olecontrol1.col=4
						.olecontrol1.cellalignment=0
						.text15.value=.text15.value+cur_recpag.movtippag_imp
						insert into totregis(instancia,recpag_codi,tippag_codi,tippag_desc,movtippag_nro,ban_codi,ban_desc,ban_cuit, ;
		                                     movtippag_pza,movtippag_fvto,movtippag_imp,cuit_lib) ;
		                             values(2,cur_recpag.recpag_codi,cur_recpag.tippag_codi,cur_recpag.tippag_desc,cadenanro, ;
		                             		cur_recpag.ban_codi,cur_bco.ban_desc,VAL(cur_bco.ban_cuit),cur_recpag.movtippag_pza, ;
		                             		fvto,cur_recpag.movtippag_imp, ;
		                             		VAL(cur_recpag.cuit_lib))
					ENDSCAN
				ENDIF
				SELECT totregis
				GO top
				.text9.setfocus		
			else
				.command3.enabled=.F.
				.text1.value=""
				.text2.value=""
				.text3.value=""
				.text4.value=""
				.text5.value=""
				.text6.value=""
				.text12.value=""
				.text13.value=ctod("  /  /    ")
				.text7.value=0
				.text8.value=0
				.text14.value=0
				.list1.rowsourcetype=0
				if .olecontrol1.rows>1
					.olecontrol1.rows=1
				endif
				messagebox("Recibo no está en archivo",0+48,"Advertencia")
			endif
		endif
		.text9.setfocus
		endwith
		
	ENDPROC

	PROCEDURE Text7.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.LostFocus
		fact=0
		totcred=0
		sele totalcbtes
		if reccount()>0
			dele all
		endif
		go top
		with thisform
			if .list1.listcount>0
				.list1.boundcolumn=3
				for i=1 to .list1.listcount
					if .list1.list(i,1)="NC"
						.text8.value=.text8.value+abs(ConverNro(.list1.list(i,4)))
						totcred=totcred+abs(ConverNro(.list1.list(i,4)))
					else
						.text9.value=.text9.value+ConverNro(.list1.list(i,4))
						fact=fact+ConverNro(.list1.list(i,4))
					endif
					auxiliar=fact-totcred
					do case
						case auxiliar<this.value
							inser into totalcbtes(conc,punto,numero,impabona) ;
								  values(allt(.list1.list(i,1)),val(.list1.list(i,2)),val(.list1.list(i,3)),ConverNro(.list1.list(i,4)))
						case auxiliar=this.value
							inser into totalcbtes(conc,punto,numero,impabona) ;
								  values(allt(.list1.list(i,1)),val(.list1.list(i,2)),val(.list1.list(i,3)),ConverNro(.list1.list(i,4)))
							exit
						case auxiliar>this.value
							diferencia=auxiliar-this.value
							fact=fact-diferencia
							abona=ConverNro(.list1.list(i,4))-(ConverNro(.list1.list(i,5))-(this.value))
							insert into totalcbtes(conc,punto,numero,impabona) ;
								values(allt(.list1.list(i,1)),val(.list1.list(i,2)),val(.list1.list(i,3)),abona)
							exit
					endcase
				next i
				.text9.value=fact
				.text8.value=totcred
			endif
			if this.value>0
				.command3.enabled=.T.
				.command3.setfocus
			endif
		endwith
	ENDPROC

	PROCEDURE Text8.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text8.LostFocus
		fact=0
		totcred=0
		sele totalcbtes
		if reccount()>0
			dele all
		endif
		go top
		with thisform
			if .list1.listcount>0
				.list1.boundcolumn=3
				for i=1 to .list1.listcount
					if .list1.list(i,1)="NC"
						.text8.value=.text8.value+abs(ConverNro(.list1.list(i,4)))
						totcred=totcred+abs(ConverNro(.list1.list(i,4)))
					else
						.text9.value=.text9.value+ConverNro(.list1.list(i,4))
						fact=fact+ConverNro(.list1.list(i,4))
					endif
					auxiliar=fact-totcred
					do case
						case auxiliar<this.value
							inser into totalcbtes(conc,punto,numero,impabona) ;
								  values(allt(.list1.list(i,1)),val(.list1.list(i,2)),val(.list1.list(i,3)),ConverNro(.list1.list(i,4)))
						case auxiliar=this.value
							inser into totalcbtes(conc,punto,numero,impabona) ;
								  values(allt(.list1.list(i,1)),val(.list1.list(i,2)),val(.list1.list(i,3)),ConverNro(.list1.list(i,4)))
							exit
						case auxiliar>this.value
							diferencia=auxiliar-this.value
							fact=fact-diferencia
							abona=ConverNro(.list1.list(i,4))-(ConverNro(.list1.list(i,5))-(this.value))
							insert into totalcbtes(conc,punto,numero,impabona) ;
								values(allt(.list1.list(i,1)),val(.list1.list(i,2)),val(.list1.list(i,3)),abona)
							exit
					endcase
				next i
				.text9.value=fact
				.text8.value=totcred
			endif
			if this.value>0
				.command3.enabled=.T.
				.command3.setfocus
			endif
		endwith
	ENDPROC

	PROCEDURE Text9.Valid
		if !between(this.value,1,2)
				=messagebox("Solo puede ingresar Código 1 y 2"+chr(13)+chr(13)+;
						"1- Recibo Manuscrito"+chr(13)+ ;
						"2- Recibo Interno",0+48,"Advertencia")
			return 0
		endif
		
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="1" />

	*<PropValue>
		DataSource = .NULL.
		Height = 570
		Left = 1
		Name = "Dataenvironment"
		Top = 220
		Width = 1016
	*</PropValue>


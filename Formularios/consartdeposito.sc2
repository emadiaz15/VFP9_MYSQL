	ENDPROC

	PROCEDURE Command4.Click
		*=========================================================
		* consartdeposito.command4.Click
		* - Guarda art_deta en ambas bases de datos
		* - Bloquea articulos para cada UPDATE
		*=========================================================
		
		LOCAL lnConn, lnRet, lnLock
		LOCAL lcValor, lnArtCodi
		LOCAL laErr[1]
		
		lcValor   = ALLTRIM(THISFORM.edit1.Value)
		lnArtCodi = VAL(TRANSFORM(THISFORM.text1.Value))
		
		IF lnArtCodi <= 0
		    MESSAGEBOX("No se pudo guardar. Código de artículo inválido.", 48, "Observaciones")
		    RETURN .F.
		ENDIF
		
		
		*=========================================================
		* 1) UPDATE en conexión principal: _screen.cn
		*=========================================================
		lnConn = Conectar_DB(_screen.cn)
		
		IF VARTYPE(lnConn) = "N" AND lnConn > 0
		
		    lnLock = MySQL_LockTables("LOCK", "articulos WRITE", lnConn)
		
		    IF lnLock = 1
		
		        lnRet = SQLEXEC(lnConn, ;
		            "UPDATE articulos " + ;
		            "SET art_deta = ?lcValor " + ;
		            "WHERE art_codi = ?lnArtCodi")
		
		        *-- Desbloquear SIEMPRE
		        = MySQL_LockTables("UNLOCK", "", lnConn)
		
		        IF lnRet < 0
		            AERROR(laErr)
		            MESSAGEBOX("Error al guardar observación en conexión principal:" + CHR(13) + ;
		                IIF(ALEN(laErr,1) >= 2, TRANSFORM(laErr[2]), "Error desconocido"), ;
		                16, "SQL")
		        ENDIF
		
		    ELSE
		        MESSAGEBOX("No se pudo bloquear la tabla articulos en conexión principal.", 48, "Bloqueo")
		    ENDIF
		
		    Desconectar_DB(lnConn)
		
		ELSE
		    MESSAGEBOX("No se pudo conectar a la base principal.", 48, "Conexión")
		ENDIF
		
		
		*=========================================================
		* 2) UPDATE en conexión secundaria/remota: _screen.xconext
		*=========================================================
		lnConn = Conectar_DB(_screen.xconext)
		
		IF VARTYPE(lnConn) = "N" AND lnConn > 0
		
		    lnLock = MySQL_LockTables("LOCK", "articulos WRITE", lnConn)
		
		    IF lnLock = 1
		
		        lnRet = SQLEXEC(lnConn, ;
		            "UPDATE articulos " + ;
		            "SET art_deta = ?lcValor " + ;
		            "WHERE art_codi = ?lnArtCodi")
		
		        *-- Desbloquear SIEMPRE
		        = MySQL_LockTables("UNLOCK", "", lnConn)
		
		        IF lnRet < 0
		            AERROR(laErr)
		            MESSAGEBOX("Error al guardar observación en conexión secundaria:" + CHR(13) + ;
		                IIF(ALEN(laErr,1) >= 2, TRANSFORM(laErr[2]), "Error desconocido"), ;
		                16, "SQL")
		        ENDIF
		
		    ELSE
		        MESSAGEBOX("No se pudo bloquear la tabla articulos en conexión secundaria.", 48, "Bloqueo")
		    ENDIF
		
		    Desconectar_DB(lnConn)
		
		ELSE
		    MESSAGEBOX("No se pudo conectar a la base secundaria.", 48, "Conexión")
		ENDIF
		
		
		THISFORM.edit1.Enabled = .F.
		THISFORM.text1.SetFocus
		
		RETURN .T.
	ENDPROC

	PROCEDURE Command4.GotFocus
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Optiongroup1.Option1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Optiongroup1.Option2.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Optiongroup1.Option3.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		CREATE CURSOR codaux(art_codi N(8))
		LOCAL xcc
		SET DECIMALS TO 3
		do case
			CASE nkeycode=13
				if this.value<>0
					xcc=this.value
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?this.value;","cur_arti")
					desconectar_db(frmcart)
					if RECCOUNT("cur_arti")>0
						if cur_arti.art_codi<>4 AND cur_arti.art_codi<>5
							with thisform
								.text1.value=cur_arti.art_codi
								.text2.value=cur_arti.art_desc
								.text3.value=cur_arti.art_stock
								.text15.value=cur_arti.art_stmin
								.text4.value=cur_arti.pedidos
								.text5.value=cur_arti.pedprov
								.text6.value=cur_arti.art_stock+.text5.value-.text4.value
								do case
									case cur_arti.art_med="UN"
										.optiongroup1.value=1
									case cur_arti.art_med="MT"
										.optiongroup1.value=2
									case cur_arti.art_med="KG"
										.optiongroup1.value=3
								endcase
								.text8.value=cur_arti.rub_desc
								.edit1.value=ALLTRIM(cur_arti.art_deta)
							endwith
						endif
					else
						messagebox("Artículo no está en archivo",0+48,"Advertencia")
						this.value=0
						return 0
					endif
				endif	
			case nkeycode=19 or nkeycode=24
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select art_codi from articulos where art_codi<?this.value and art_codi<>4 and art_codi<>5 order by art_codi desc limit 1;","cur_inter")
					IF RECCOUNT()>0
						INSERT INTO codaux values(cur_inter.art_codi)
					ENDIF
				desconectar_db(frmcart)
				SELECT codaux
				IF RECCOUNT()>0
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?codaux.art_codi;","cur_arti")
					desconectar_db(frmcart)													
					with thisform
						xcc=cur_arti.art_codi
						.text1.value=cur_arti.art_codi
						.text2.value=cur_arti.art_desc
						.text3.value=cur_arti.art_stock
						.text15.value=cur_arti.art_stmin
						.text4.value=cur_arti.pedidos
						.text5.value=cur_arti.pedprov
						.text6.value=cur_arti.art_stock+.text5.value-.text4.value
						do case
							case cur_arti.art_med="UN"
								.optiongroup1.value=1
							case cur_arti.art_med="MT"
								.optiongroup1.value=2
							case cur_arti.art_med="KG"
								.optiongroup1.value=3
						endcase
						.edit1.value=cur_arti.art_deta
						.text8.value=cur_arti.rub_desc
					ENDWITH
					NODEFAULT
					this.Refresh()
					this.setfocus
				ENDIF
			case nkeycode=4 or nkeycode=5
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select art_codi from articulos where art_codi>?this.value order by art_codi limit 1;","cur_inter")
					IF RECCOUNT()>0
						INSERT INTO codaux values(cur_inter.art_codi)
					ENDIF
				desconectar_db(frmcart)
				SELECT codaux
				IF RECCOUNT()>0
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?codaux.art_codi;","cur_arti")
					desconectar_db(frmcart)				
					with thisform
						xcc=cur_arti.art_codi
						.text1.value=cur_arti.art_codi
						.text2.value=cur_arti.art_desc
						.text3.value=cur_arti.art_stock
						.text15.value=cur_arti.art_stmin
						.text4.value=cur_arti.pedidos
						.text5.value=cur_arti.pedprov
						.text6.value=cur_arti.art_stock+.text5.value-.text4.value
						do case
							case cur_arti.art_med="UN"
								.optiongroup1.value=1
							case cur_arti.art_med="MT"
								.optiongroup1.value=2
							case cur_arti.art_med="KG"
								.optiongroup1.value=3
						endcase
						.edit1.value=cur_arti.art_deta
						.text8.value=cur_arti.rub_desc
						KEYBOARD '{TAB}'
					ENDWITH
					NODEFAULT
					this.Refresh()
					this.setfocus
				ELSE
					KEYBOARD '{TAB}'
				ENDIF
		ENDCASE
		SET DECIMALS TO
	ENDPROC

	PROCEDURE Text15.Click
		set point to "."
		this.setfocus
	ENDPROC

	PROCEDURE Text15.LostFocus
		sele articulos
		if this.value<>art_stmin
			preg=messagebox("¿Confirma el Stock Mínimo Ingresado?",4+32+256,"Artículos")
			if preg=6
				repla art_stmin with this.value
			else
				this.value=0
			endif
		endif
		set point to ","
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text3.Click
		LOCAL lnCodigo
		
		lnCodigo = IIF(VARTYPE(THISFORM.text1.Value)="N", THISFORM.text1.Value, 0)
		
		IF lnCodigo <= 0
		    lnCodigo = VAL(ALLTRIM(THISFORM.text1.Text))
		ENDIF
		
		IF lnCodigo <= 0
		    MESSAGEBOX("Primero seleccione un artículo.", 48, "Histórico de Stock")
		    THISFORM.text1.SetFocus
		    RETURN
		ENDIF
		
		DO FORM frmhistostock WITH lnCodigo
	ENDPROC

	PROCEDURE Text4.Click
		artdepo=cur_arti.art_codi
		descdepo=allt(cur_arti.art_desc)
		do form pendclirapi with artdepo,descdepo
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text5.Click
		artdepo=cur_arti.art_codi
		descdepo=allt(cur_arti.art_desc)
		do form pendprovrapi with artdepo,descdepo
		thisform.text1.setfocus
	ENDPROC

ENDDEFINE


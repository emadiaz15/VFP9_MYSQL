	PROCEDURE Destroy
		set point to
		set separator to
		set decimals to
		
	ENDPROC

	PROCEDURE Init
		public opcion,codiprov,artdepo,descdepo
		create cursor totped(pedidos N(10,2))
		opcion=0
		codiprov=0
		artdepo=0
		descdepo=''
		set point to ","
		set separator to "."
		set date british
		set cent on
		set dele on
		this.text1.value=0
		with thisform
			.text3.value=0
			.text4.value=0
			.text5.value=0
			.text6.value=0
		endwith
	ENDPROC

	PROCEDURE bnt_imagen.Click
		IF thisform.text1.Value>0
			LOCAL nCodigo, cURL
		
			* Tomar el valor del TextBox que contiene el código
			nCodigo = ALLTRIM(STR(ThisForm.text1.Value))
		
			IF EMPTY(nCodigo)
			    MESSAGEBOX("No hay código de artículo para abrir en la web.", 48, "Atención")
			    RETURN
			ENDIF
		
			* Armar la URL dinámica con el código del artículo
			cURL = "http://192.168.0.240:3000/public/product-files?code=" + nCodigo
		
			* Abrir la URL en el navegador predeterminado
			IF "WINDOWS" $ UPPER(OS())
			    RUN /N explorer.exe "&cURL"
			ELSE
			    * Para Linux o macOS, por si lo corrés con Wine
			    RUN /N xdg-open "&cURL"
			ENDIF
		ELSE
			MESSAGEBOX("Debe consultar un artículo para poder ver la imágen.",48,"Aviso del Sistema")
		ENDIF
		
	ENDPROC

	PROCEDURE bnt_imagen.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE bnt_imagen.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command1.Click
		codigo=0
		thisform.text1.value=0
		do form artload with codigo
		if codigo>0
			with thisform
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?codigo;","cur_arti")
				desconectar_db(frmcart)
				.text1.value=cur_arti.art_codi
				.text2.value=cur_arti.art_desc
				.text3.value=cur_arti.art_stock
				.text15.value=art_stmin
				.text4.value=cur_arti.pedidos
				.text5.value=cur_arti.pedprov
				.text6.value=cur_arti.art_stock+.text5.value-.text4.value
				do case
					case cur_arti.art_med="UN"
						.optiongroup1.value=1
					case cur_arti.art_med="MT"
						.optiongroup1.value=2
					case cur_arti.art_med="KG"
						.optiongroup1.value=3
				endcase
				.text8.value=cur_arti.rub_desc
				.edit1.value=allt(cur_arti.art_deta)
			endwith
		endif
		thisform.text1.setfocus
		
	ENDPROC

	PROCEDURE Command1.GotFocus
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord

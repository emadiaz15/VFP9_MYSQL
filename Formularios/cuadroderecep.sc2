		Top = 88, ;
		Width = 279, ;
		Column1.ControlSource = "", ;
		Column1.FontBold = .F., ;
		Column1.ForeColor = 255,255,255, ;
		Column1.Name = "Column1", ;
		Column1.ReadOnly = .T., ;

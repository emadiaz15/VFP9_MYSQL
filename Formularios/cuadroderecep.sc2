		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text2' AS textbox WITH ;
		Alignment = 2, ;
		Format = "K", ;
		Height = 23, ;
		Left = 347, ;
		Name = "Text2", ;
		TabIndex = 2, ;
		Top = 24, ;
		Width = 90
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text3' AS textbox WITH ;
		Alignment = 3, ;
		Height = 23, ;
		InputMask = "$ ###,###,###,###.##", ;
		Left = 410, ;
		Name = "Text3", ;
		Style = 1, ;
		Top = 206, ;
		Value = 0, ;
		Width = 137
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		set dele on
		set point to ","
		set separator to "."
		set dele on
		this.text1.value=ctod("01/"+"01"+"/"+allt(str(year(date()))))
		this.text2.value=date()
		create cursor cuadro(mes C(15),impo N(15,2))
	ENDPROC

	PROCEDURE Command1.Click
		sele cuadro
		go top
		report form proyrecep TO PRINTER PROMPT noconsole
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.Click
		local x,aux,totalg,totalnc,totalnd,perbtos,periva,tot
		perbtos=0
		periva=0
		totalg=0
		totalnc=0
		totalnd=0
		tot=0
		frmcuadrec= conectar_db(_screen.cn)
			SQLEXEC(frmcuadrec,"select * from recepciones where recep_fec between ?thisform.text1.value and ?thisform.text2.value order by recep_fec;","cur_cuadro")
		desconectar_db(frmcuadrec)
		LOCATE
		
		sele cuadro
		go top
		if reccount()>0
			dele all
		endif
		fecha=ctod("01/"+"01"+"/"+allt(str(year(thisform.text1.value))))
		for i=1 to 12
			appe blank
			repla mes with upper(Mes_nombre(i))
		next i
		sele cuadro
		go top
		
		set talk off
		aux=0
		x=1
		SCAN
			perbtos=0
			periva=0
			totalg=0
			totalnc=0
			totalnd=0
		*	wait wind "PROCESANDO LISTADO AGUARDE POR FAVOR..." nowait
		*!*		set near on
		*!*		sele cur_cuadro
		*!*		LOCATE FOR recep_fec=ctod("01"+"/"+allt(str(x))+"/"+allt(str(year(thisform.text1.value))))
		*!*		if !eof()
			IF x!=aux
				do while month(cur_cuadro.recep_fec)=x and !eof()
					if cur_cuadro.perc_btos>0
						perbtos=cur_cuadro.perc_btos
					endif
					if cur_cuadro.perc_iva>0
						periva=cur_cuadro.perc_iva
					endif
					do case
						case cur_cuadro.recep_conc="F"
							totalg=totalg+(cur_cuadro.neto_1+cur_cuadro.neto_2+cur_cuadro.recep_impng)
							*(recep_tot+recep_impng+perbtos+periva+iif(prov_tipfac="A" or prov_tipfac="M",iif(altiva_1=0,round((recep_tot*iva.iva_1)/100,2),round((recep_tot*altiva_1)/100,2)),0))
						case cur_cuadro.recep_conc="N"
							totalnc=totalnc+(cur_cuadro.neto_1+cur_cuadro.neto_2+cur_cuadro.recep_impng)
							*(recep_tot+recep_impng+perbtos+periva+iif(prov_tipfac="A" or prov_tipfac="M",ivanc,0))
						case cur_cuadro.recep_conc="D"
							totalnd=totalnd+(cur_cuadro.neto_1+cur_cuadro.neto_2+cur_cuadro.recep_impng)
							*(recep_tot+recep_impng+perbtos+periva+iif(prov_tipfac="A" or prov_tipfac="M",ivand,0))
					endcase
					perbtos=0
					periva=0
					sele cur_cuadro
					skip
				ENDDO
				aux=x
		*!*			WAIT WINDOW x TIMEOUT 0.5
				sele cuadro
				do case
					case x=1
						locate for allt(mes)="ENERO"
						repla impo with totalg+totalnd-totalnc
					case x=2
						locate for allt(mes)="FEBRERO"
						repla impo with totalg+totalnd-totalnc
					case x=3
						locate for allt(mes)="MARZO"
						repla impo with totalg+totalnd-totalnc
					case x=4
						locate for allt(mes)="ABRIL"
						repla impo with totalg+totalnd-totalnc
					case x=5
						locate for allt(mes)="MAYO"
						repla impo with totalg+totalnd-totalnc
					case x=6
						locate for allt(mes)="JUNIO"
						repla impo with totalg+totalnd-totalnc
					case x=7
						locate for allt(mes)="JULIO"
						repla impo with totalg+totalnd-totalnc
					case x=8
						locate for allt(mes)="AGOSTO"
						repla impo with totalg+totalnd-totalnc
					case x=9
						locate for allt(mes)="SETIEMBRE"
						repla impo with totalg+totalnd-totalnc
					case x=10
						locate for allt(mes)="OCTUBRE"
						repla impo with totalg+totalnd-totalnc
					case x=11
						locate for allt(mes)="NOVIEMBRE"
						repla impo with totalg+totalnd-totalnc
					case x=12
						locate for allt(mes)="DICIEMBRE"
						repla impo with totalg+totalnd-totalnc
				endcase
			endif
			tot=tot+(totalg+totalnd-totalnc)
			x=x+1
			sele cuadro
		endscan
		sele cuadro
		go top
		thisform.grid1.recordsource="cuadro"
		thisform.grid1.forecolor=0
		thisform.grid1.column1.forecolor=rgb(255,0,128)
		thisform.grid1.column1.fontbold=.T.
		thisform.text3.value=tot
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
		
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

ENDDEFINE


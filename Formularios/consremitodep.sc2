	PROCEDURE Destroy
		item=0
	ENDPROC

	PROCEDURE Init
		parameter nrorem,cond
		public descrip,postal,locali,provi
		sele remitos
		set order to rem_nro
		seek nrorem
		this.text13.value=rem_fech
		this.text7.value=rem_nro
		this.text14.value=facturas.fac_nro
		*if anulado="S"
		*	this.label14.visible=.T.
		*endif
		thisform.text6.value=transportes.tran_nomb
		do case
			case flete_cargo="P"
				thisform.optiongroup1.value=1
			case flete_cargo="C"
				thisform.optiongroup1.value=2
		endcase
		thisform.text8.value=flete_valor
		thisform.text9.value=flete_peso
		thisform.edit1.value=flete_lugent
		thisform.edit2.value=rem_observ
		with thisform
			.caption="Consulta de Remitos por Cliente"			
			sele clientes
			set order to cli_codi
			seek codicli
			.text1.value=cli_nomb
			.text2.value=cli_domi
			.text3.value=codipostales.cp_nro
			.text4.value=localidades.loca_nomb
			.text5.value=provincias.provi_nomb
		endwith					
		sele remitos_articulos
		set order to rem_nro
		seek nrorem
		item=1
		con=0
		scan for rem_nro=nrorem
			if art_codi=4
				if len(artrem_dasc)>0
					sele remitos_articulos
					cadena=allt(repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi)))
					cantidad=artrem_cant
					this.grid1.additem(allt(str(item))+chr(9)+str(artrem_cant,10,2)+chr(9)+articulos.art_med+chr(9)+cadena+chr(9)+artrem_dasc)
					item=item+1
				endif
			else
				cadena=allt(repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi)))
				this.grid1.additem(allt(str(item))+chr(9)+str(artrem_cant,10,2)+chr(9)+articulos.art_med+chr(9)+cadena+chr(9)+articulos.art_desc)
				if artrem_sstock="S"
					this.grid1.col=5
					this.grid1.row=item
					this.grid1.text="SS"
				endif
				item=item+1
			endif
		endscan
		
	ENDPROC

	PROCEDURE Command1.Click
		sele remitos_articulos
		set order to rem_nro
		seek nrorem
		codicli=remitos.cli_codi
		do form remload with codicli
		thisform.release
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Text1.GotFocus
		if localiz=1
			thisform.grid1.toprow=item
		endif
	ENDPROC

	PROCEDURE Text13.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.Click
		this.setfocus
	ENDPROC

ENDDEFINE


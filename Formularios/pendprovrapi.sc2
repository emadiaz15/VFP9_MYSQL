		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		parameter codigo,descri
		set dele on
		dimension tot[1,1]
		this.caption="Pendientes de Proveedores de "+descri
		xcodigo=codigo
		frmpenp= conectar_db(_screen.cn)
			SQLEXEC(frmpenp,"call usp_penprorap(?xcodigo);","cur_penp")
		desconectar_db(frmpenp)
		IF RECCOUNT("cur_penp")>0
			this.lstpendp.rowsourcetype=3
			this.lstpendp.rowsource="select distinct nombre from cur_penp into cursor lstpendp"
		ELSE
			MESSAGEBOX("Artículo no es adeudado por ningún Proveedor",48,"Aviso del sistema")
			KEYBOARD '{ESC}'
		ENDIF
		
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if last()=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		
	ENDPROC

	PROCEDURE Grid1.DblClick
		LOCAL nocpra,ncond
		
		nocpra= ordepend.ocpra
		ncond= ordepend.cond_codi
		
		pascpra=1
		DO FORM consocpra WITH nocpra,ncond
		
	ENDPROC

	PROCEDURE lstpendp.Click
		with thisform
			for x=1 to this.listcount
				if this.selected(x)
					.grid1.recordsource=''
					.grid1.refresh
					select ocpra,fecha,ent,pend,cond_codi from cur_penp where nombre=allt(this.list(x,1)) into cursor ordepend
					.grid1.recordsource="ordepend"
					.grid1.forecolor=0
					select sum(pend) from cur_penp where nombre=allt(this.list(x,1)) into array tot
					.text3.value=tot[1,1]
					.label4.caption=allt(cur_penp.art_med)
				endif
			next x
		endwith
	ENDPROC

ENDDEFINE

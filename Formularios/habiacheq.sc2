	PROCEDURE Init
		PARAMETERS xcheqnro,xconf
		
		THISFORM.AddProperty("oRet")
		THISFORM.oRet = CREATEOBJECT("Empty")
		
		frmhabia= conectar_db(_screen.cn)
			SQLEXEC(frmhabia,"call usp_habiacheq(?xcheqnro);","cur_habia")
		desconectar_db(frmhabia)
		
		IF RECCOUNT("cur_habia")=1
			thisform.lbl_aviso.Caption='Se encontró en archivo el siguiente cheque con el número '+SUBSTR(ALLTRIM(xcheqnro),1,3)+"-"+SUBSTR(ALLTRIM(xcheqnro),4,3)+"-"+SUBSTR(ALLTRIM(xcheqnro),7,8)
		ELSE
			thisform.lbl_aviso.Caption=thisform.lbl_aviso.Caption+" "+SUBSTR(ALLTRIM(xcheqnro),1,3)+"-"+SUBSTR(ALLTRIM(xcheqnro),4,3)+"-"+SUBSTR(ALLTRIM(xcheqnro),7,8)
		ENDIF
		
		GO top
		thisform.grd_cheques.RecordSource='cur_habia'
	ENDPROC

	PROCEDURE Unload
		RETURN ThisForm.oRet
	ENDPROC

	PROCEDURE btn_print.Click
		xconf='S'
		xrpcod=cur_habia.recpag_codi
		ADDPROPERTY(THISFORM.oRet, "Prop1", xcheqnro)
		ADDPROPERTY(THISFORM.oRet, "Prop2", xconf)
		ADDPROPERTY(THISFORM.oRet, "Prop3", xrpcod)
		
		thisform.release
	ENDPROC

	PROCEDURE btn_print.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE btn_print.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE btn_salir.Click
		xconf='N'
		xrpcod=0
		ADDPROPERTY(THISFORM.oRet, "Prop1", xcheqnro)
		ADDPROPERTY(THISFORM.oRet, "Prop2", xconf)
		ADDPROPERTY(THISFORM.oRet, "Prop3", xrpcod)
		
		thisform.release
	ENDPROC

	PROCEDURE btn_salir.MouseLeave

DEFINE CLASS excedestenv AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="grid1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Image1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Image2" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: inseritems
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		BackColor = 215,215,215
		BorderStyle = 0
		Caption = "Advertencia!!!"
		DoCreate = .T.
		Height = 320
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "EXCEDESTENV"
		Width = 637
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Continuar", ;
		DisabledBackColor = 33,146,214, ;
		FontBold = .F., ;
		ForeColor = 255,255,255, ;
		Height = 24, ;
		Left = 154, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 271, ;
		Width = 144
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command3' AS commandbutton WITH ;
		BackColor = 227,68,34, ;
		Caption = "Ca\<ncelar", ;
		DisabledBackColor = 227,68,34, ;
		FontBold = .F., ;
		ForeColor = 255,255,255, ;
		Height = 24, ;
		Left = 327, ;
		Name = "Command3", ;
		Themes = .F., ;
		Top = 271, ;
		Width = 144
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grid1' AS olecontrol WITH ;
		Height = 204, ;
		Left = 16, ;
		Name = "grid1", ;
		TabIndex = 2, ;
		Top = 48, ;
		Width = 605
		*< END OBJECT: BaseClass="olecontrol" OLEObject="c:\windows\syswow64\msflxgrd.ocx" Value="" />

	ADD OBJECT 'Image1' AS image WITH ;
		BackStyle = 0, ;
		Height = 32, ;
		Left = 108, ;
		Name = "Image1", ;
		Picture = ..\imagen\w95mbx03.ico, ;
		Top = 8, ;
		Width = 32
		*< END OBJECT: BaseClass="image" />

	ADD OBJECT 'Image2' AS image WITH ;
		BackStyle = 0, ;
		Height = 32, ;
		Left = 487, ;
		Name = "Image2", ;
		Picture = ..\imagen\w95mbx03.ico, ;
		Top = 8, ;
		Width = 32
		*< END OBJECT: BaseClass="image" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 215,215,215, ;
		Caption = "Excede el stock de los siguientes artículos ", ;
		FontBold = .T., ;
		FontSize = 13, ;
		Height = 22, ;
		Left = 147, ;
		Name = "Label1", ;
		Top = 19, ;
		Width = 340
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Init
		parameter rta,xcodfa
		LOCAL artexc
		artexc=0
		SELECT cur_itemsped
		GO top
		SCAN FOR selart=.T.
			artexc=cur_itemsped.art_codi
			frmexc= conectar_db(_screen.cn)
				SQLEXEC(frmexc,"select * from articulos where art_codi=?artexc;","cur_exc")
			desconectar_db(frmexc)
			IF xcodfa>0
				IF cur_itemsped.artfac_sstock='S'
					thisform.inseritems()
				ENDIF
			ELSE
				thisform.inseritems()
			ENDIF
			SELECT cur_itemsped
		ENDSCAN
	ENDPROC

	PROCEDURE inseritems
		if cur_exc.art_stock-cur_itemsped.artped_cant<0 and cur_exc.art_codi>5
			cadena=repl("0",8-len(allt(str(cur_exc.art_codi))))+allt(str(cur_exc.art_codi))
			thisform.grid1.additem(cadena+chr(9)+ALLTRIM(cur_itemsped.art_desc)+chr(9)+STR(cur_itemsped.artped_cant,10,2)+chr(9)+str(cur_exc.art_stock,7,2))
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE Unload
		return rta
	ENDPROC

	PROCEDURE Command1.Click
		rta=1
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		rta=2
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE grid1.GotFocus
		*!*	cond=clientes.cond_codi
		*on key label INS do form cualart with cond
		*!*	if localiz=1
		*!*		if elimi=0	
		*!*			thisform.grid1.toprow=item
		*!*		else
		*!*			elimi=0
		*!*		endif
		*!*	endif
	ENDPROC

ENDDEFINE

	PROCEDURE Optiongroup2.Init
		*if valorcadena="Por Pedido de Cliente"
		*	this.option2.enabled=.F.
		*endif
	ENDPROC

	PROCEDURE Text1.GotFocus
		*if localiz=1
		*	thisform.grid1.toprow=item
		*endif
	ENDPROC

	PROCEDURE Text13.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text13.Valid
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select * from parametros where param_desc='ULTCIERBEN';","cur_param")
		desconectar_db(frmaltafac)
		IF RECCOUNT("cur_param")>0
			if this.value<=cur_param.param_fec
				=messagebox("El ultimo cierre de Iva Ventas realizado fue el día "+dtoc(cur_param.param_fec)+chr(13)+;
							"imposible facturar con la fecha indicada.",0+48,"Advertencia!"))
			*!*		this.value=date()
				return 0
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE Text15.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text15.Valid
		if this.value>0
			frmaltafac= conectar_db(_screen.cn)
				SQLEXEC(frmaltafac,"select * from vendedores where ven_codi=?this.value;","cur_vende")
			desconectar_db(frmaltafac)	
			if RECCOUNT("cur_vende")>0
				thisform.text16.value=allt(cur_vende.ven_nomb)
			else
				=messagebox("Vendedor no está en archivo",0+48,"Advertencia!!!")
				this.value=0
				return 0
			endif
		else
			thisform.text16.value=""
		endif
	ENDPROC

	PROCEDURE Text19.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text19.GotFocus
		public valdto
		valdto=this.value
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			if this.value<>valdto
				do case
					case this.value=0
						.text17.value=""
						.text18.value=.text8.value
						impo1=impo1/((100-valdto)/100)
						impo2=impo2/((100-valdto)/100)
						acun1=acun1/((100-valdto)/100)
						acun2=acun2/((100-valdto)/100)
						acu1=acu1/((100-valdto)/100)
						acu2=acu2/((100-valdto)/100)
						if cond=2
							.text9.value=.text9.value/((100-valdto)/100)
							.text11.value=.text11.value/((100-valdto)/100)
						endif
					otherwise
						.text17.value=.text8.value*this.value/100
						.text18.value=.text8.value-.text17.value
						if cond=2
							if valdto>0
								.text9.value=.text9.value/((100-valdto)/100)
								.text11.value=.text11.value/((100-valdto)/100)
							endif
							.text9.value=.text9.value*((100-this.value)/100)
							.text11.value=.text11.value*((100-this.value)/100)
						endif
						if valdto>0
							impo1=impo1/((100-valdto)/100)
							impo2=impo2/((100-valdto)/100)
							acun1=acun1/((100-valdto)/100)
							acun2=acun2/((100-valdto)/100)
							acu1=acu1/((100-valdto)/100)
							acu2=acu2/((100-valdto)/100)
						endif
						impo1=impo1*((100-this.value)/100)
						impo2=impo2*((100-this.value)/100)
						acun1=acun1*((100-this.value)/100)
						acun2=acun2*((100-this.value)/100)
						acu1=acu1*((100-this.value)/100)
						acu2=acu2*((100-this.value)/100)
				endcase 
				.text10.value=.text18.value+.text9.value+.text11.value
			endif
		endwith
	ENDPROC

	PROCEDURE Text20.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text20.Valid
		if LEN(ALLTRIM(this.value))>0
			frmaltafac= conectar_db(_screen.cn)
				SQLEXEC(frmaltafac,"select * from porcencomi where porc_desc=?this.value;","cur_porcen")
			desconectar_db(frmaltafac)
			if RECCOUNT("cur_porcen")>0
				porcodi=cur_porcen.porc_codi
				thisform.text21.value=cur_porcen.porc_impo
			else
				=messagebox("Porcentaje de Comisión no está en archivo",0+48,"Advertencia!!!")
				this.value=""
				return 0
			endif
		else
			thisform.text21.value=0
			porodi=0
		endif
	ENDPROC

	PROCEDURE Text21.Click
		this.setfocus
	ENDPROC

ENDDEFINE


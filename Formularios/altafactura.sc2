		MESSAGEBOX("acu: "+ALLTRIM(STR(thisform.acu,15,3))+CHR(13)+ ;
				   "impo1: "+ALLTRIM(STR(impo1,15,3))+CHR(13)+ ;
				   "impo2: "+ALLTRIM(STR(impo2,15,3))+CHR(13)+ ;
				   "acun1: "+ALLTRIM(STR(acun1,15,3))+CHR(13)+ ;
				   "acun2: "+ALLTRIM(STR(acun2,15,3))+CHR(13)+ ;
				   "impiva1: "+ALLTRIM(STR(impiva1,15,2))+CHR(13)+ ;
				   "impiva2: "+ALLTRIM(STR(impiva2,15,2))+CHR(13)+ ;
				   "localiz: "+ALLTRIM(STR(localiz))+CHR(13)+ ;
				   "preg: "+ALLTRIM(STR(preg))+CHR(13)+ ;
				   "renglon: "+ALLTRIM(STR(renglon)),64,"Variables de Entorno")
	ENDPROC


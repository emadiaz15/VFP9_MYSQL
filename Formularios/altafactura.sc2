	PROCEDURE Activate
		set exact on
		*!*	set point to ","
		*!*	set separator to "."
		
		IF thisform.optiongroup2.Value=2
			IF estadoasoc=.F.
				nroasoc=0
				thisform.Release
			ENDIF
		ENDIF
		
		cond=auxcond
		if codigo=0
			muestro=0
		ENDIF
		SET POINT TO ","
		if muestro=1
			with thisform
				frmaltafac= conectar_db(_screen.cn)
					SQLEXEC(frmaltafac,"select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmaltafac)
				if ConverNro(cant)>cur_arti.art_stock and .check1.value=0 and codigo>5
		*!*				set point to ","
					if .optiongroup2.value=1
						preg=messagebox("Excede el stock de: "+allt(cur_arti.art_desc)+chr(13)+ ;
								        "Cantidad a Facturar: "+allt(str(ConverNro(cant),15,3))+" "+allt(cur_arti.art_med)+chr(13)+ ;
								        "Stock Actual:        "+allt(str(cur_arti.art_stock,10,2))+" "+allt(cur_arti.art_med)+chr(13)+ ;
								        chr(13)+ ;
								        "¿Factura este artículo igualmente?",4+48+256,"Advertencia!!!")
					else
						preg=6
					endif
				else
					preg=6
				endif
				if preg=6
		*!*				set point to
					localiz=1
					if paso=1
						.grid1.col=0
						.grid1.text=allt(str(aux))
						.grid1.col=2
						.grid1.text=cur_arti.art_med
						.grid1.col=3
						articulo=val(.grid1.text)
						.grid1.col=3
						cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
						.grid1.text=cadena
						.grid1.col=1			
						.grid1.text=allt(cant)
						.grid1.col=4
						if codigo=4 or codigo=5
							.grid1.text=allt(descrip)
						else
							.grid1.text=allt(descri)
						endif
						if len(allt(.grid1.text))>44
							div=len(allt(.grid1.text))/44
							if div>int(div)
								longdes=int(div)+1
							else
								longdes=div
							endif
							longdes=longdes*250
							this.grid1.rowheight(aux)=longdes
						else
							this.grid1.rowheight(aux)=-1
						endif				
						.grid1.col=5
						.grid1.text=allt(pruni)
						if .check1.value=1
							.grid1.col=7
							.grid1.text="SS"
						endif
						.grid1.col=6
						thisform.acu=ROUND(thisform.acu-CAST(STRTRAN(.grid1.text,",",".") as N(15,2)),2)
						.grid1.text=prtot
						if .text19.value>0
							auxiva=auxiva-(auxiva*.text19.value/100)
							auximpo=auximpo-(auximpo*.text19.value/100)
						endif
						do case
							case art_alicuota=1
								if cond=2
									if auxali=1
										impo1=impo1-auximpo
									else
										impo2=impo2-auximpo
									endif
								ELSE
									if auxali=1
										acun1=acun1-auximpo
									else
										acun2=acun2-auximpo
									endif
								endif
							case art_alicuota=2
								if cond=2
									if auxali=2
										impo2=impo2-auximpo
									else
										impo1=impo1-auximpo
									endif
								ELSE
									if auxali=2
										acun2=acun2-auximpo
									else
										acun1=acun1-auximpo
									endif
								endif
						endcase
						thisform.acu=ROUND(thisform.acu+CAST(STRTRAN(prtot,",",".") as N(15,2)),2)
						paso=0
					else
						if insertar=0
							thisform.cmd_terminar.Enabled= .T.
							nitem=nitem+1
							cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
							.grid1.additem(alltrim(str(nitem))+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+cadena+chr(9)+allt(descri)+chr(9)+allt(pruni)+chr(9)+prtot)
							if .check1.value=1
								.grid1.row=.grid1.rows-1
								.grid1.col=7
								.grid1.text="SS"
							endif
							.grid1.row=.grid1.rows-1
							.grid1.col=9
							.grid1.text="SI"
							if len(allt(descri))>44
								div=len(allt(descri))/44
								if div>int(div)
									longdes=int(div)+1
								else
									longdes=div
								endif
								renglon=renglon+longdes
								longdes=longdes*250
								this.grid1.rowheight(nitem)=longdes
							else
								renglon=renglon+1
								this.grid1.rowheight(nitem)=-1
							endif
		*					do case
		*						case valorcadena="Por Artículos"
									if renglon<27
										on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
									else
										on key label INS messagebox("No puede ingresar más Items a la factura"+chr(13)+ ;
										                            "Haga click en Terminar para concluir esta factura y luego"+chr(13)+ ;
										                            "registre una nueva factura",0+48,"Advertencia")
									endif
		*						case valorcadena="Por Pedido de Cliente"
		*							on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		*							if renglon>10
		*								=messagebox("La cantidad de ítems seleccionados supera la cantidad permitida por comprobante,"+chr(13)+ ;
		*											"solo se tomaron algunos ítems del pedido."+chr(13)+chr(13)+ ;
		*											"Para facturar el resto deberá efectuar otra vez la operación.",0+64,"Facturación de Pedidos")
		*								exit
		*								div=renglon/27
		*								if div>int(div)
		*									cantfac=int(div)+1
		*								else
		*									cantfac=renglon/27
		*								endif
		*								auxfac=nrofac
		*								if cantfac>thisform.combo1.listcount
		*									x=thisform.combo1.listcount
		*									for x=thisform.combo1.listcount+1 to cantfac
		*										thisform.combo1.additem("       "+replicate("0",8-len(allt(str(auxfac))))+allt(str(auxfac)))
		*										auxfac=auxfac+1
		*									next x
		*								endif
		*								thisform.text7.visible=.F.
		*								thisform.combo1.visible=.T.
		*								thisform.combo1.value=1
		*							endif
		*					endcase
							this.label5.caption="TOTAL RENGLONES A IMPRIMIR: "+allt(str(renglon))
							this.label5.visible=.T.
						ENDIF
						thisform.acu=ROUND(thisform.acu+CAST(STRTRAN(prtot,",",".") as N(15,2)),2)
					endif
					.grid1.row=this.grid1.rows-1
					.grid1.col=8
					do case
						case cur_arti.art_alicuota=1
							.grid1.text=allt(str(impiva1,10,2))
						case cur_arti.art_alicuota=2
							.grid1.text=allt(str(impiva2,10,2))
					endcase
		*			if .optiongroup2.value=2
		*				.grid1.col=9
		*				.grid1.text="SI"
		*			endif
					.grid1.col=0
					.grid1.cellfontname="Courier New"
					.grid1.cellfontsize=8
					.grid1.cellalignment=3
					.grid1.col=1
					.grid1.cellfontname="Courier New"
					.grid1.cellfontsize=8
					.grid1.cellalignment=6
					.grid1.col=2
					.grid1.cellfontname="Courier New"
					.grid1.cellfontsize=8
					.grid1.cellalignment=3
					.grid1.col=3
					.grid1.cellfontname="Courier New"
					.grid1.cellfontsize=8
					.grid1.cellalignment=3
					.grid1.col=4
					.grid1.cellfontname="Courier New"
					.grid1.cellfontsize=8
					.grid1.cellalignment=0
					.grid1.col=5
					.grid1.cellfontname="Courier New"
					.grid1.cellfontsize=8
					.grid1.cellalignment=8
					.grid1.col=6
					.grid1.cellfontname="Courier New"
					.grid1.cellfontsize=8
					.grid1.cellalignment=8
					.grid1.col=8
					.grid1.cellfontname="Courier New"
					.grid1.cellfontsize=8
					.grid1.cellalignment=8
				endif
				codigo=0
			endwith
		endif
		if preg=6
			if localiz=1 and nitem>0
				with thisform
					.grid1.col=9
					.text8.value=thisform.acu
					.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
					.text18.value=.text8.value-.text17.value
					if .text19.value>0
						do case
							case cur_arti.art_alicuota=1
								if cond=2
									impo1=impo1+(CAST(STRTRAN(prtot,",",".") as N(15,2))*((100-.text19.value)/100))
									if auxali=2
										.text11.value=round((impo2*impiva2)/100,2)
									endif
									.text9.value=round((impo1*impiva1)/100,2)
								else
									acun1=acun1+round(((CAST(STRTRAN(prtot,",",".") as N(15,2))*((100-.text19.value)/100))/(1+(impiva1/100))),3)
									if auxali=2
										acu2=round((acun2*impiva2)/100,2)
									endif
									acu1=round((acun1*impiva1)/100,2)
								endif
							case cur_arti.art_alicuota=2
								if cond=2
									impo2=impo2+(CAST(STRTRAN(prtot,",",".") as N(15,2))*((100-.text19.value)/100))
									if auxali=1
										.text9.value=round((impo1*impiva1)/100,2)
									endif
									.text11.value=round((impo2*impiva2)/100,2)
								else
									acun2=acun2+round(((CAST(STRTRAN(prtot,",",".") as N(15,2))*((100-.text19.value)/100))/(1+(impiva2/100))),3)
									if auxali=1
										acu1=round((acun1*impiva1)/100,2)
									endif
									acu2=round((acun2*impiva2)/100,2)
								endif
						endcase
					else
						do case
							case cur_arti.art_alicuota=1
								if cond=2
									impo1=impo1+CAST(STRTRAN(prtot,",",".") as N(15,2))
									if auxali=2
										.text11.value=round((impo2*impiva2)/100,2)
									endif
									.text9.value=round((impo1*impiva1)/100,2)
								else
									acun1=acun1+round((CAST(STRTRAN(prtot,",",".") as N(15,2))/(1+(impiva1/100))),3)
									if auxali=2
										acu2=round((acun2*impiva2)/100,2)
									endif
									acu1=round((acun1*impiva1)/100,2)
								endif
							case cur_arti.art_alicuota=2
								if cond=2
									impo2=impo2+CAST(STRTRAN(prtot,",",".") as N(15,2))
									if auxali=1
										.text9.value=round((impo1*impiva1)/100,2)
									endif
									.text11.value=round((impo2*impiva2)/100,2)
								else
									acun2=acun2+round((CAST(STRTRAN(prtot,",",".") as N(15,2))/(1+(impiva2/100))),3)
									if auxali=1
										acu1=round((acun1*impiva1)/100,2)
									endif
									acu2=round((acun2*impiva2)/100,2)
								endif
						endcase
					endif
					.text10.value=.text18.value+.text9.value+.text11.value
				endwith
			endif
			store 0 to localiz,muestro
		ENDIF
		SET POINT TO
		*!*	messagebox("acun1: "+allt(str(acun1,10,3))+chr(13)+ ;
		*!*			   "acun2: "+allt(str(acun2,10,3))+chr(13)+ ;
		*!*			   "acu1: "+allt(str(acu1,10,3))+chr(13)+ ;
		*!*			   "acu2: "+allt(str(acu2,10,3))+chr(13)+ ;
		*!*			   "impo1: "+allt(str(impo1,10,3))+chr(13)+ ;
		*!*			   "impo2: "+allt(str(impo2,10,3))+chr(13)+ ;
		*!*			   "auximpo: "+allt(str(auximpo,10,3))+chr(13)+ ;
		*!*			   "auxiva: "+allt(str(auxiva,10,3)))
		*!*	with this
		*!*		.text7.value=acun1
		*!*		.text14.value=acun2
		*!*		.text23.value=acu1
		*!*		.text24.value=acu2
		*!*		.text25.value=impo1
		*!*		.text26.value=impo2
		*!*		.text27.value=auximpo
		*!*		.text28.value=auxiva
		*!*		.text29.value=round(acun1+acu1,2)
		*!*	endwith
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 3 of Altas .F.
		_screen.xopvta=""
		on key label INS
		store 0 to localiz,nitem,impo1,impo2,acun1,acun2
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE dolarizar
		LPARAMETERS ndolar
		
		LOCAL xdcan,xdprec,xdsub,xdtot
		STORE 0 TO thisform.acu,impo1,impo2,acun1,acun2,acu1,acu2,xdcan,xdprec,xdsub,xdtot
		
		FOR pes=1 TO thisform.grid1.rows-1
			xdsub=0
			xdtot=0
			WITH thisform
				.grid1.row=pes
				.grid1.col=1
				SET POINT TO ","
				xdcan=CAST(STRTRAN(.grid1.text,",",".") as N(15,3))
				.grid1.col=5
				xdprec=CAST(STRTRAN(.grid1.text,",",".") as N(15,3))
				xdsub=xdprec/ndolar
				xdtot=xdcan*xdsub
				.grid1.text=ALLTRIM(STR(xdsub,15,3))
				.grid1.col=6
				.grid1.text=ALLTRIM(STR(xdtot,15,3))
				thisform.acu=ROUND(thisform.acu+xdtot,2)
				.text8.value=thisform.acu
				.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
				.text18.value=.text8.value-.text17.value
				.grid1.col=8
				if .text19.value>0
					do case
						case ConverNro(.grid1.text)=impiva1
							if cond=2
								impo1=impo1+(xdtot*((100-.text19.value)/100))
							else
								acun1=acun1+((xdtot*((100-.text19.value)/100))/(1+(impiva1/100)))
							endif
						case ConverNro(.grid1.text)=impiva2
							if cond=2
								impo2=impo2+(xdtot*((100-.text19.value)/100))
							else
								acun2=acun2+((xdtot*((100-.text19.value)/100))/(1+(impiva2/100)))
							endif
					endcase
				else
					do case
						case ConverNro(.grid1.text)=impiva1
							if cond=2
								impo1=impo1+xdtot
							else
								acun1=acun1+(xdtot/(1+(impiva1/100)))
							endif
						case ConverNro(.grid1.text)=impiva2
							if cond=2
								impo2=impo2+xdtot
							else
								acun2=acun2+(xdtot/(1+(impiva2/100)))
							endif
					endcase
				ENDIF
				SET POINT TO
			ENDWITH
		NEXT pes
		with thisform
			if cond=2
				.text9.value=round((impo1*impiva1)/100,2)
				.text11.value=round((impo2*impiva2)/100,2)
			else
				acu1=round((acun1*impiva1)/100,2)
				acu2=round((acun2*impiva2)/100,2)
			endif
			.text10.value=.text18.value+.text9.value+.text11.value
		endwith
		*!*	MESSAGEBOX("Los precios fueron convertidos exitosamente.",64,"Aviso del Sistema")
	ENDPROC

	PROCEDURE factuped
		LPARAMETERS nCodp
		
		LOCAL xrer
		xrer=0
		
		thisform.label15.caption="Vendedor:"
		thisform.label20.caption="Comisión:"
		thisform.command5.visible=.F.
		thisform.command6.visible=.F.
		thisform.btn_pesos.Visible= .T.
		thisform.text15.style=1
		thisform.text20.style=1
		thisform.text21.style=1
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select * from pedidos where ped_codi=?nCodp;","cur_ped")
			do case
				case cur_ped.ven_codi>0 and cur_ped.porc_codi>0
					SQLEXEC(frmaltafac,"select * from vendedores where ven_codi=?cur_ped.ven_codi;","cur_vend")
					if RECCOUNT("cur_vend")>0
						thisform.text15.value=cur_vend.ven_codi
						thisform.text16.value=allt(cur_vend.ven_nomb)
					endif
					porcodi=cur_ped.porc_codi
					SET DECIMALS TO 3
					SQLEXEC(frmaltafac,"select * from porcencomi where porc_codi=?porcodi;","cur_porc")
					SET DECIMALS TO
					if RECCOUNT("cur_porc")>0
						thisform.text20.value=cur_porc.porc_desc
						thisform.text21.value=cur_porc.porc_impo
					endif
				case cur_ped.ven_codi>0 and cur_ped.otra_comi>0
					SQLEXEC(frmaltafac,"select * from vendedores where ven_codi=?cur_ped.ven_codi;","cur_vend")
					if RECCOUNT("cur_vend")>0
						thisform.text15.value=cur_vend.ven_codi
						thisform.text16.value=allt(cur_vend.ven_nomb)
					endif
					thisform.text20.value=""
					thisform.text21.value=cur_ped.otra_comi
			ENDCASE
		*!*		IF LEN(ALLTRIM(cur_ped.ped_obser))>0
		*!*			thisform.cmd_obspe.Visible= .T.
		*!*		ENDIF
		desconectar_db(frmaltafac)	
		thisform.text19.value=cur_ped.ped_dto
		SELECT cur_itemsped
		LOCATE
		nitem=1
		LOCAL countss
		countss=0
		SCAN
			xrer=0
			IF cur_itemsped.selart=.T.
				cantidad=cur_itemsped.artped_cant
				articulo=cur_itemsped.art_codi
				descripcion=cur_itemsped.art_desc
				precio=cur_itemsped.artped_precio
				do case
					case cantidad=0 and cur_itemsped.artped_precio=0
						co=messagebox("El artículo "+allt(descripcion)+" está con cantidad y precio 0"+chr(13)+chr(13)+ ;
									  "¿Desea modificarlos ahora?",4+48+256,"Advertencia!!!")
						if co=6
							do form altarapartped with articulo,cantidad,descripcion,precio
							frmaltafac= conectar_db(_screen.cn)
								SQLEXEC(frmaltafac,"update pedidos_articulos set artped_precio=precio where artped_codi=?cur_itemsped.artped_codi;")
							desconectar_db(frmaltafac)
						else
							=messagebox("Ud. a optado por dejar la cantidad y precio de este artículo en 0"+chr(13)+ ;
										"La factura se registrará igualmente pero debe tener en cuenta este"+chr(13)+ ;
										"detalle.",0+48,"Advertencia!!!")
						endif
					case cantidad=0 and cur_itemsped.artped_precio>0
						co=messagebox("El artículo "+allt(descripcion)+" está con cantidad 0"+chr(13)+chr(13)+ ;
									  "¿Desea modificarlo ahora?",4+48+256,"Advertencia!!!")
						if co=6
							do form altarapartped with articulo,cantidad,descripcion,precio
							frmaltafac= conectar_db(_screen.cn)
								SQLEXEC(frmaltafac,"update pedidos_articulos set artped_precio=precio where artped_codi=?cur_itemsped.artped_codi;")
							desconectar_db(frmaltafac)
						else
							=messagebox("Ud. a optado por dejar la cantidad de este artículo en 0"+chr(13)+ ;
										"La factura se registrará igualmente pero debe tener en cuenta"+chr(13)+ ;
										"este detalle.",0+48,"Advertencia!!!")
						endif
					case cantidad>0 and cur_itemsped.artped_precio=0
						co=messagebox("El artículo "+allt(descripcion)+" está con precio 0"+chr(13)+chr(13)+ ;
									  "¿Desea modificarlo ahora?",4+48+256,"Advertencia!!!")
						if co=6
							do form altarapartped with articulo,cantidad,descripcion,precio
							frmaltafac= conectar_db(_screen.cn)
								SQLEXEC(frmaltafac,"update pedidos_articulos set artped_precio=precio where artped_codi=?cur_itemsped.artped_codi;")
							desconectar_db(frmaltafac)
						else
							=messagebox("Ud. a optado por dejar el precios de este artículo en 0"+chr(13)+ ;
										"La factura se registrará igualmente pero debe tener en cuenta"+chr(13)+ ;
										"este detalle.",0+48,"Advertencia!!!")
						endif
				ENDCASE
				IF thisform.valorcadena="Por Remito de Cliente"
					frmaltafac= conectar_db(_screen.cn)
						SQLEXEC(frmaltafac,"select rer_codi,rem_codi from remitos_articulos where artped_codi=?cur_itemsped.artped_codi;","cur_rer")
					desconectar_db(frmaltafac)
					IF RECCOUNT("cur_rer")>0
						xrer=cur_rer.rer_codi 
						codirem=cur_rer.rem_codi
					ENDIF
					cerrar_cursor("cur_rer")
				ENDIF
				SET POINT TO ","
				cadena=allt(repl("0",8-len(allt(str(cur_itemsped.art_codi))))+allt(str(cur_itemsped.art_codi)))
				thisform.grid1.additem(allt(str(nitem))+chr(9)+allt(str(cantidad,10,3))+chr(9)+allt(cur_itemsped.art_med)+chr(9)+ ;
								   cadena+chr(9)+cur_itemsped.art_desc+chr(9)+allt(str(cur_itemsped.artped_precio,10,4))+chr(9)+ ;
								   allt(str(cantidad*cur_itemsped.artped_precio,10,2))+CHR(9)+''+CHR(9)+''+CHR(9)+''+CHR(9)+allt(str(cur_itemsped.artped_codi));
								   +CHR(9)+IIF(xrer>0,ALLTRIM(STR(xrer)),''))
				SET POINT TO
				if len(allt(cur_itemsped.art_desc))>44
					div=len(allt(cur_itemsped.art_desc))/44
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					renglon=renglon+longdes
					longdes=longdes*250
					thisform.grid1.rowheight(nitem)=longdes
				else
					renglon=renglon+1
					thisform.grid1.rowheight(nitem)=-1
				endif
				thisform.acu=ROUND(thisform.acu+(cantidad*cur_itemsped.artped_precio),2)
				nitem=nitem+1
				thisform.grid1.row=thisform.grid1.rows-1
				IF thisform.valorcadena="Por Remito de Cliente"
					frmaltafac= conectar_db(_screen.cn)
						SQLEXEC(frmaltafac,"select artrem_sstock from remitos_articulos where rer_codi=?xrer;","cur_stock")
					desconectar_db(frmaltafac)
					IF ALLTRIM(cur_stock.artrem_sstock) <> 'S'
						thisform.grid1.col=7
						thisform.grid1.text="SS"
						countss=countss+1
					ENDIF
					cerrar_cursor("cur_stock")
					SELECT cur_itemsped
				ENDIF
				thisform.grid1.col=9
				thisform.grid1.text="SI"
				if renglon>27
					=messagebox("La cantidad de ítems seleccionados supera la cantidad permitida"+chr(13)+ ;
								"por comprobante, solo se tomaron algunos ítems del pedido."+chr(13)+chr(13)+ ;
								"Para facturar el resto deberá efectuar otra vez la operación.",0+64,"Facturación de Pedidos")
					thisform.grid1.removeitem(nitem)
					thisform.acu=ROUND(thisform.acu-(cantidad*cur_itemsped.artped_precio),2)
					nitem=nitem-1
					exit
				endif
				thisform.grid1.row=thisform.grid1.rows-1
				thisform.grid1.col=8
				SET POINT TO ","
				do case
					case cur_itemsped.art_alicuota=1
						thisform.grid1.text=allt(str(impiva1,10,2))
					case cur_itemsped.art_alicuota=2
						thisform.grid1.text=allt(str(impiva2,10,2))
				ENDCASE
				SET POINT TO
				thisform.grid1.cellfontname="Courier New"
				thisform.grid1.cellfontsize=8
				thisform.grid1.cellalignment=3
				thisform.grid1.col=0
				thisform.grid1.cellfontname="Courier New"
				thisform.grid1.cellfontsize=8
				thisform.grid1.cellalignment=3
				thisform.grid1.col=1
				thisform.grid1.cellfontname="Courier New"
				thisform.grid1.cellfontsize=8
				thisform.grid1.cellalignment=6
				thisform.grid1.col=2
				thisform.grid1.cellfontname="Courier New"
				thisform.grid1.cellfontsize=8
				thisform.grid1.cellalignment=3
				thisform.grid1.col=3
				thisform.grid1.cellfontname="Courier New"
				thisform.grid1.cellfontsize=8
				thisform.grid1.cellalignment=3
				thisform.grid1.col=4
				thisform.grid1.cellfontname="Courier New"
				thisform.grid1.cellfontsize=8
				thisform.grid1.cellalignment=0
				thisform.grid1.col=5
				thisform.grid1.cellfontname="Courier New"
				thisform.grid1.cellfontsize=8
				thisform.grid1.cellalignment=8
				thisform.grid1.col=6
				prtot=STRTRAN(ALLTRIM(thisform.grid1.text),",",".")
				thisform.grid1.cellfontname="Courier New"
				thisform.grid1.cellfontsize=8
				thisform.grid1.cellalignment=8
		        thisform.cmd_terminar.Enabled= .T.
		        SET POINT TO ","
				with thisform
					.text8.value=thisform.acu
					.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
					.text18.value=.text8.value-.text17.value
					if .text19.value>0
						do case
							case cur_itemsped.art_alicuota=1
								.grid1.col=6
								if cond=2
									impo1=impo1+(CAST(prtot as N(15,2))*((100-.text19.value)/100))
								else
									acun1=acun1+((CAST(prtot as N(15,2))*((100-.text19.value)/100))/(1+(impiva1/100)))
								endif
							case cur_itemsped.art_alicuota=2
								.grid1.col=6
								if cond=2
									impo2=impo2+(CAST(prtot as N(15,2))*((100-.text19.value)/100))
								else
									acun2=acun2+((CAST(prtot as N(15,2))*((100-.text19.value)/100))/(1+(impiva2/100)))
								endif
						endcase
					else
						do case
							case cur_itemsped.art_alicuota=1
								.grid1.col=6
								if cond=2
									impo1=impo1+CAST(prtot as N(15,2))
								else
									acun1=acun1+(CAST(prtot as N(15,2))/(1+(impiva1/100)))
								endif
							case cur_itemsped.art_alicuota=2
								.grid1.col=6
								if cond=2
									impo2=impo2+CAST(prtot as N(15,2))
								else
									acun2=acun2+(CAST(prtot as N(15,2))/(1+(impiva2/100)))
								endif
						endcase
					ENDIF
					SET POINT TO
				endwith
			endif
		ENDSCAN
		IF countss>0
			thisform.check1.Value=1
		ELSE
			thisform.check1.Value=0
		ENDIF
		with this
			if cond=2
				.text9.value=round((impo1*impiva1)/100,2)
				.text11.value=round((impo2*impiva2)/100,2)
			else
				acu1=round((acun1*impiva1)/100,2)
				acu2=round((acun2*impiva2)/100,2)
			endif
			.text10.value=.text18.value+.text9.value+.text11.value
		endwith
		*!*	i=i-1
		if nitem>1
			nitem=nitem-1
		endif
		itemsfac.release
		localiz=0
		thisform.label5.caption="TOTAL RENGLONES A IMPRIMIR: "+allt(str(renglon))
		thisform.label5.visible=.T.
	ENDPROC

	PROCEDURE facturados
		LPARAMETERS lcodrem
		
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select COUNT(*) canrr from remitos_articulos where rem_codi=?lcodrem;","cur_canrr")
			SQLEXEC(frmaltafac,"select COUNT(*) canrf from remitos_articulos where rem_codi=?lcodrem and facturado=1;","cur_canrf")
		desconectar_db(frmaltafac)
		
		IF cur_canrf.canrf=cur_canrr.canrr
			frmaltafac= conectar_db(_screen.cn)
				SQLEXEC(frmaltafac,"update remitos set facturado=1 where rem_codi=?lcodrem;")
			desconectar_db(frmaltafac)
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE Init
		parameter codp,cond,codicli
		
		public elimi,descrip,muestro,postal,locali,provi,opcion,nrofac,nrorem, ;
			   dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot,insertar, ;
			   impiva1,impiva2,borra,codiva,codirem,transporte,coditran1,coditran2,auxcond, ;
			   texto,rta,articulo,nctext,lugent1,lugent2,observ,ivaprinc,comprobante,localiz, ;
			   nitem,flete1,flete2,piepagina,paso,buscar,dife,precio,cantidad,aux,;
			   vcodi,letrapor,porcodi,renglon,longdes,concepto,auxiva,ptorem,impo1,impo2,acun1,acun2,acu1,acu2,auximpo,auxacuneto,auxali
		
		LOCAL cani
		
		set talk off
		set deleted on
		create cursor creditos(fac_codi N(8),cred N(10,2))
		create cursor factu(cod N(8),nro N(8),pto N(4))
		create cursor remi(cod N(8),nro N(8),pto N(4))
		CREATE CURSOR cur_stact(art_codi N(8),st_act N(15,3))
		CREATE CURSOR cur_stact_ext(art_codi N(8),st_act N(15,3))
		STORE 0 TO nitem,dato1,auxiva,renglon,longdes, ;
				   porcodi,vcodi,dife,flete1,flete2, ;
				   coditran1,coditran2,paso,thisform.acu,elimi, ;
				   localiz,muestro,opcion,insertar,borra, ;
				   codigo,x,codirem,auxregis,nrofac, ;
				   nrorem,rta,ivaprinc,cantidad,precio,ptorem, ;
				   impo1,impo2,acu1,acu2,acun1,acun2,auximpo, ;
				   auxacuneto,auxali,letrapor
		buscar=1
		
		_screen.xopvta="FA"
		
		STORE '' TO concepto,piepagina,nctext,;
					transporte,lugent1,lugent2,observ,;
					descrip,texto
		
		STORE 0 TO this.text15.value,;
				   this.text21.value
		
		STORE 0 TO this.text19.value,;
				   this.text8.value,;
				   this.text9.value,;
				   this.text10.value,;
				   this.text11.value,;
				   this.text17.value,;
				   this.text18.value
		
		thisform.valorcadena=valorcadena
		
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select * from iva order by iva_codi desc limit 1;","cur_iva")
		desconectar_db(frmaltafac)
		codiva=cur_iva.iva_codi
		impiva1=cur_iva.iva_1
		impiva2=cur_iva.iva_2
		ivaprinc=impiva1
		
		do case
			case thisform.valorcadena="Por Artículos"
				do form cliload with codicli
				thisform.optiongroup2.option2.enabled=.F.
				thisform.check1.caption="Facturar todo sin mover Stock"
			case thisform.valorcadena="Notas de Crédito"
				do form cliload with codicli
				DO FORM numfacasoc WITH codicli
				thisform.notacredito()
				thisform.lbl_asoc.Caption=thisform.lbl_asoc.Caption+" "+REPLICATE("0",8-LEN(ALLTRIM(STR(nroasoc))))+ALLTRIM(STR(nroasoc))
				thisform.lbl_asoc.Visible=.T.
				thisform.optiongroup2.option1.enabled=.F.
				thisform.optiongroup2.value=2
				thisform.check1.caption="Acreditar todo sin mover Stock"
		otherwise
			thisform.optiongroup2.option1.enabled=.T.
			thisform.optiongroup2.option2.enabled=.F.
			thisform.check1.caption="Facturar todo sin mover Stock"
		endcase
		this.text13.value=date()
		
		thisform.label12.caption=allt(str(impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(impiva2,10,2))+"%"
		with thisform
			frmaltafac= conectar_db(_screen.cn)
				SQLEXEC(frmaltafac,"call usp_buscarcli(?codicli);","cur_clie")
			desconectar_db(frmaltafac)
			if VAL(cur_clie.cli_cuit)=0 and cur_clie.cond_codi=2 AND estadoasoc!=.F.
				preg=messagebox("No se ha ingresado aún el CUIT de este Cliente."+chr(13)+chr(13)+ ;
								"¿Desea ingresarlo ahora?",4+48+256,"Advertencia!!!")
				if preg=6
					do form altacuit with codicli
				else
					=messagebox("Ud. ha optado por omitir el alta del CUIT, la factura se registrará"+chr(13)+ ;
								"igualmente pero debe tener en cuenta este detalle.",0+48,"Advertencia!!!")
				endif
			endif
			.text22.value=cur_clie.cli_codi
			.text1.value=cur_clie.cli_nomb
			.text2.value=cur_clie.cli_domi
			.text3.value=cur_clie.cp_nro
			.text4.value=cur_clie.loca_nomb
			.text5.value=cur_clie.provi_nomb
			.text6.value=cur_clie.cond_desc
			.text12.value=VAL(cur_clie.cli_cuit)
		endwith
		cond=cur_clie.cond_codi
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select rem_codi as 'cod',rem_nro as 'nro',rem_pto as 'pto' from remitos ORDER BY rem_codi DESC;","remi")
		desconectar_db(frmaltafac)
		if RECCOUNT("remi")=0
			do form inirem with nrorem
		else
			nrorem=remi.nro+1
			ptorem=remi.pto
		endif
		auxcond=cond
		if thisform.valorcadena="Por Artículo"
			nitem=0
		ENDIF
		IF thisform.valorcadena="Por Pedido de Cliente" OR thisform.valorcadena="Por Remito de Cliente"
			thisform.factuped(codp)
		ELSE
			frmaltaped= conectar_db(_screen.cn)
				SQLEXEC(frmaltaped,"select a.*,b.* from zonas a inner join vendedores b on a.ven_codi=b.ven_codi where a.zona_codi=?cur_clie.zona_codi order by b.ven_codi;","cur_vende")
			desconectar_db(frmaltaped)
			thisform.text15.value=cur_vende.ven_codi
			thisform.text16.value=cur_vende.ven_nomb
			localiz=1
		ENDIF
		if cond=2
			this.optiongroup1.value=1
			this.optiongroup1.option1.enabled=.T.
			this.optiongroup1.option2.enabled=.F.
		else
			this.optiongroup1.value=2
			this.optiongroup1.option1.enabled=.F.
			this.optiongroup1.option2.enabled=.T.
		endif
		if renglon<27
			on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		else
			on key label INS messagebox("No puede ingresar más Items a la factura"+chr(13)+ ;
			                            "Haga click en Terminar para concluir esta factura y luego"+chr(13)+ ;
			                            "registre una nueva factura",0+48,"Advertencia")
		endif
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Load
		set skip of bar 3 of Altas .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if valorcadena="Por Presupuesto"
		*!*		set skip of bar 3 of Altas .F.
		*!*		localiz=0
		*!*	*	item=0
		*!*	endif
	ENDPROC

	PROCEDURE notacredito
		LOCAL cani
		
		thisform.label15.caption="Vendedor:"
		thisform.label20.caption="Comisión:"
		thisform.command5.visible=.F.
		thisform.command6.visible=.F.
		thisform.btn_pesos.Visible= .T.
		thisform.text15.style=1
		thisform.text20.style=1
		thisform.text21.style=1
		frmaltafac= conectar_db(_screen.cn)
			do case
				case _screen.vendasoc>0 and _screen.porcodiasoc>0
					SQLEXEC(frmaltafac,"select * from vendedores where ven_codi=?_screen.vendasoc;","cur_vend")
					if RECCOUNT("cur_vend")>0
						thisform.text15.value=cur_vend.ven_codi
						thisform.text16.value=allt(cur_vend.ven_nomb)
					endif
					porcodi=_screen.porcodiasoc
					SET DECIMALS TO 3
					SQLEXEC(frmaltafac,"select * from porcencomi where porc_codi=?porcodi;","cur_porc")
					SET DECIMALS TO
					if RECCOUNT("cur_porc")>0
						thisform.text20.value=cur_porc.porc_desc
						thisform.text21.value=cur_porc.porc_impo
					endif
				case _screen.vendasoc>0 and _screen.otcomiasoc>0
					SQLEXEC(frmaltafac,"select * from vendedores where ven_codi=?_screen.vendasoc;","cur_vend")
					if RECCOUNT("cur_vend")>0
						thisform.text15.value=cur_vend.ven_codi
						thisform.text16.value=allt(cur_vend.ven_nomb)
					endif
					thisform.text20.value=""
					thisform.text21.value=_screen.otcomiasoc
			ENDCASE
		desconectar_db(frmaltafac)
		IF USED("cur_itemscre")
			SELECT cur_itemscre
			LOCATE
			COUNT FOR selart = .T. TO cani
			IF cani > 0
				thisform.check1.Enabled= .F.
				LOCATE
				LOCAL countss
				nitem=1
				countss=0
				COUNT FOR artfac_sstock = 'S' TO countss
				IF countss = cani
					thisform.check1.Value = 1
				ENDIF
				LOCATE
				SCAN
					IF cur_itemscre.selart=.T.
						cantidad=cur_itemscre.artfac_cant
						articulo=cur_itemscre.art_codi
						descripcion=cur_itemscre.art_desc
						precio=cur_itemscre.artfac_impo
						SET POINT TO ","
						cadena=allt(repl("0",8-len(allt(str(cur_itemscre.art_codi))))+allt(str(cur_itemscre.art_codi)))
						thisform.grid1.additem(allt(str(nitem))+chr(9)+allt(str(cantidad,10,3))+chr(9)+allt(cur_itemscre.art_med)+chr(9)+ ;
										   cadena+chr(9)+cur_itemscre.art_desc+chr(9)+allt(str(cur_itemscre.artfac_impo,15,3))+chr(9)+ ;
										   allt(str(cantidad*cur_itemscre.artfac_impo,15,2))+CHR(9)+IIF(ALLTRIM(cur_itemscre.artfac_sstock)='S','SS','')+CHR(9)+ ;
										   ''+CHR(9)+''+CHR(9)+allt(str(cur_itemscre.artped_codi))+CHR(9)+'')
						SET POINT TO
						if len(allt(cur_itemscre.art_desc))>44
							div=len(allt(cur_itemscre.art_desc))/44
							if div>int(div)
								longdes=int(div)+1
							else
								longdes=div
							endif
							renglon=renglon+longdes
							longdes=longdes*250
							thisform.grid1.rowheight(nitem)=longdes
						else
							renglon=renglon+1
							thisform.grid1.rowheight(nitem)=-1
						endif
						thisform.acu=ROUND(thisform.acu+(cantidad*cur_itemscre.artfac_impo),2)
						nitem=nitem+1
						thisform.grid1.row=thisform.grid1.rows-1
						thisform.grid1.col=9
						thisform.grid1.text="SI"
						thisform.grid1.row=thisform.grid1.rows-1
						thisform.grid1.col=8
						SET POINT TO ","
						do case
							case cur_itemscre.art_alicuota=1
								thisform.grid1.text=allt(str(impiva1,10,2))
							case cur_itemscre.art_alicuota=2
								thisform.grid1.text=allt(str(impiva2,10,2))
						ENDCASE
						SET POINT TO
						thisform.grid1.cellfontname="Courier New"
						thisform.grid1.cellfontsize=8
						thisform.grid1.cellalignment=3
						thisform.grid1.col=0
						thisform.grid1.cellfontname="Courier New"
						thisform.grid1.cellfontsize=8
						thisform.grid1.cellalignment=3
						thisform.grid1.col=1
						thisform.grid1.cellfontname="Courier New"
						thisform.grid1.cellfontsize=8
						thisform.grid1.cellalignment=6
						thisform.grid1.col=2
						thisform.grid1.cellfontname="Courier New"
						thisform.grid1.cellfontsize=8
						thisform.grid1.cellalignment=3
						thisform.grid1.col=3
						thisform.grid1.cellfontname="Courier New"
						thisform.grid1.cellfontsize=8
						thisform.grid1.cellalignment=3
						thisform.grid1.col=4
						thisform.grid1.cellfontname="Courier New"
						thisform.grid1.cellfontsize=8
						thisform.grid1.cellalignment=0
						thisform.grid1.col=5
						thisform.grid1.cellfontname="Courier New"
						thisform.grid1.cellfontsize=8
						thisform.grid1.cellalignment=8
						thisform.grid1.col=6
						prtot=STRTRAN(ALLTRIM(thisform.grid1.text),",",".")
						thisform.grid1.cellfontname="Courier New"
						thisform.grid1.cellfontsize=8
						thisform.grid1.cellalignment=8
				        thisform.cmd_terminar.Enabled= .T.
				        SET POINT TO ","
						with thisform
							.text8.value=thisform.acu
							.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
							.text18.value=.text8.value-.text17.value
							if .text19.value>0
								do case
									case cur_itemscre.art_alicuota=1
										.grid1.col=6
										if cond=2
											impo1=impo1+(CAST(prtot as N(15,2))*((100-.text19.value)/100))
										else
											acun1=acun1+((CAST(prtot as N(15,2))*((100-.text19.value)/100))/(1+(impiva1/100)))
										endif
									case cur_itemscre.art_alicuota=2
										.grid1.col=6
										if cond=2
											impo2=impo2+(CAST(prtot as N(15,2))*((100-.text19.value)/100))
										else
											acun2=acun2+((CAST(prtot as N(15,2))*((100-.text19.value)/100))/(1+(impiva2/100)))
										endif
								endcase
							else
								do case
									case cur_itemscre.art_alicuota=1
										.grid1.col=6
										if cond=2
											impo1=impo1+CAST(prtot as N(15,2))
										else
											acun1=acun1+(CAST(prtot as N(15,2))/(1+(impiva1/100)))
										endif
									case cur_itemscre.art_alicuota=2
										.grid1.col=6
										if cond=2
											impo2=impo2+CAST(prtot as N(15,2))
										else
											acun2=acun2+(CAST(prtot as N(15,2))/(1+(impiva2/100)))
										endif
								endcase
							ENDIF
							SET POINT TO
						endwith
					endif
				ENDSCAN
				if nitem>1
					nitem=nitem-1
				ENDIF
				with this
					if cond=2
						.text9.value=round((impo1*impiva1)/100,2)
						.text11.value=round((impo2*impiva2)/100,2)
					else
						acu1=round((acun1*impiva1)/100,2)
						acu2=round((acun2*impiva2)/100,2)
					endif
					.text10.value=.text18.value+.text9.value+.text11.value
				ENDWITH
				STORE 0 TO localiz,preg
			ENDIF
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE pesificar
		LPARAMETERS ndolar
		
		LOCAL xdcan,xdprec,xdsub,xdtot
		STORE 0 TO thisform.acu,impo1,impo2,acun1,acun2,acu1,acu2,xdcan,xdprec,xdsub,xdtot
		
		FOR pes=1 TO thisform.grid1.rows-1
			xdsub=0
			xdtot=0
			WITH thisform
				.grid1.row=pes
				.grid1.col=1
				SET POINT TO ","
				xdcan=CAST(STRTRAN(.grid1.text,",",".") as N(15,3))
				.grid1.col=5
				xdprec=CAST(STRTRAN(.grid1.text,",",".") as N(15,3))
				xdsub=xdprec*ndolar
				xdtot=xdcan*xdsub
				.grid1.text=ALLTRIM(STR(xdsub,10,3))
				.grid1.col=6
				.grid1.text=ALLTRIM(STR(xdtot,10,3))
				thisform.acu=ROUND(thisform.acu+xdtot,2)
				.text8.value=thisform.acu
				.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
				.text18.value=.text8.value-.text17.value
				.grid1.col=8
				if .text19.value>0
					do case
						case ConverNro(.grid1.text)=impiva1
							if cond=2
								impo1=impo1+(xdtot*((100-.text19.value)/100))
							else
								acun1=acun1+((xdtot*((100-.text19.value)/100))/(1+(impiva1/100)))
							endif
						case ConverNro(.grid1.text)=impiva2
							if cond=2
								impo2=impo2+(xdtot*((100-.text19.value)/100))
							else
								acun2=acun2+((xdtot*((100-.text19.value)/100))/(1+(impiva2/100)))
							endif
					endcase
				else
					do case
						case ConverNro(.grid1.text)=impiva1
							if cond=2
								impo1=impo1+xdtot
							else
								acun1=acun1+(xdtot/(1+(impiva1/100)))
							endif
						case ConverNro(.grid1.text)=impiva2
							if cond=2
								impo2=impo2+xdtot
							else
								acun2=acun2+(xdtot/(1+(impiva2/100)))
							endif
					endcase
				ENDIF
				SET POINT TO
			ENDWITH
		NEXT pes
		with thisform
			if cond=2
				.text9.value=round((impo1*impiva1)/100,2)
				.text11.value=round((impo2*impiva2)/100,2)
			else
				acu1=round((acun1*impiva1)/100,2)
				acu2=round((acun2*impiva2)/100,2)
			endif
			.text10.value=.text18.value+.text9.value+.text11.value
		endwith
		MESSAGEBOX("Los precios fueron convertidos exitosamente.",64,"Aviso del Sistema")
	ENDPROC

	PROCEDURE registrahistostock
		LPARAMETERS xcodifac
		
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select a.*,b.fac_conc,b.fac_tipo,b.fac_pto,b.fac_nro,b.fac_pie from facturas_articulos a inner join facturas b on a.fac_codi = b.fac_codi where a.fac_codi = ?xcodifac;","cur_farhis")
		desconectar_db(frmaltafac)
		
		IF RECCOUNT("cur_farhis")>0
			GO top
			IF USED("cur_stact")
				GO TOP IN cur_stact
			ENDIF
			SELECT COUNT(*) css FROM cur_farhis WHERE artfac_sstock="S" INTO ARRAY ar_ss
			IF TYPE("ar_ss")="N"
				IF ar_ss[1,1]<RECCOUNT("cur_farhis")
					LOCAL xarti,xcantf,xsstock,xpie,xcadecom,xpto,xnro,xnomcli
					xnomcli=ALLTRIM(thisform.text1.Value)
					SELECT cur_farhis
					LOCATE
					SCAN
						xarti    =cur_farhis.art_codi
						xcantf   =cur_farhis.artfac_cant
						xsstock  =ALLTRIM(NVL(cur_farhis.artfac_sstock,""))
						xpie     =ALLTRIM(NVL(cur_farhis.fac_pie,""))
						xpto     =REPLICATE("0",4-LEN(ALLTRIM(STR(cur_farhis.fac_pto))))+ALLTRIM(STR(cur_farhis.fac_pto))
						xnro     =REPLICATE("0",8-LEN(ALLTRIM(STR(cur_farhis.fac_nro))))+ALLTRIM(STR(cur_farhis.fac_nro))
						xcadecom =ALLTRIM(cur_farhis.fac_conc)+"C"+ALLTRIM(cur_farhis.fac_tipo)+"_"+ALLTRIM(xpto)+"-"+ALLTRIM(xnro)+" -- "+xnomcli
						if xarti>5 and ALLTRIM(xsstock)<>"S"
							LOCAL stact,saldst
							SELECT st_act FROM cur_stact WHERE art_codi = xarti INTO ARRAY ar_stvig
							IF TYPE("ar_stvig")="N"
								stact=ar_stvig[1,1]
							ELSE
								stact=0
							ENDIF
							frmaltafac= conectar_db(_screen.cn)
								do case
									case ALLTRIM(cur_farhis.fac_conc)=="F"
										SET DECIMALS TO 3
										saldst=stact-xcantf
										SQLEXEC(frmaltafac,"insert into histostock values(null,?xarti,current_date(),current_time(),'S',?stact,-?xcantf,?saldst,?xcadecom,?xpie,0,0,?xcodifac,0,0,?cond,?codicli);")
										SET DECIMALS TO
									case ALLTRIM(cur_farhis.fac_conc)=="N"
										SET DECIMALS TO 3
										saldst=stact+xcantf
										SQLEXEC(frmaltafac,"insert into histostock values(null,?xarti,current_date(),current_time(),'E',?stact,?xcantf,?saldst,?xcadecom,?xpie,0,0,?xcodifac,0,0,?cond,?codicli);")
										SET DECIMALS TO
								ENDCASE
								cerrar_cursor("cur_stac")
							desconectar_db(frmaltafac)
							*-------------------------------------------
							* Actualizar cur_stact local para artículos repetidos
							*-------------------------------------------
							SELECT cur_stact
							LOCATE FOR art_codi = xarti
							IF FOUND()
								REPLACE st_act WITH saldst
							ENDIF
						ENDIF
						SELECT cur_farhis
					ENDSCAN
					IF USED("cur_stact")
						cerrar_cursor("cur_stact")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		RETURN
		
		
	ENDPROC

	PROCEDURE registrarhistostock_ilumet
		LPARAMETERS xcodifac
		
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select a.*,b.fac_conc,b.fac_tipo,b.fac_pto,b.fac_nro,b.fac_pie from facturas_articulos a inner join facturas b on a.fac_codi = b.fac_codi where a.fac_codi = ?xcodifac;","cur_farhis")
		desconectar_db(frmaltafac)
		
		IF RECCOUNT("cur_farhis")>0
			GO top
			IF USED("cur_stact_ext")
				GO TOP IN cur_stact_ext
			ENDIF
			SELECT COUNT(*) css FROM cur_farhis WHERE artfac_sstock="S" INTO ARRAY ar_ss
			IF TYPE("ar_ss")="N"
				IF ar_ss[1,1]<RECCOUNT("cur_farhis")
					LOCAL xarti,xcantf,xsstock,xpie,xcadecom,xpto,xnro,xnomcli
					xnomcli=ALLTRIM(thisform.text1.Value)
					SELECT cur_farhis
					LOCATE
					SCAN
						xarti    =cur_farhis.art_codi
						conexterna= conectar_db(_screen.xconext)
							SQLEXEC(conexterna,"select * from articulos where art_codi = ?xarti;","cur_artext")
						desconectar_db(conexterna)
						IF USED("cur_artext")
							IF RECCOUNT("cur_artext") > 0
								xcantf   =cur_farhis.artfac_cant
								xsstock  =ALLTRIM(NVL(cur_farhis.artfac_sstock,""))
								xpie     =ALLTRIM(NVL(cur_farhis.fac_pie,""))
								xpto     =REPLICATE("0",4-LEN(ALLTRIM(STR(cur_farhis.fac_pto))))+ALLTRIM(STR(cur_farhis.fac_pto))
								xnro     =REPLICATE("0",8-LEN(ALLTRIM(STR(cur_farhis.fac_nro))))+ALLTRIM(STR(cur_farhis.fac_nro))
								xcadecom =ALLTRIM(cur_farhis.fac_conc)+"C"+ALLTRIM(cur_farhis.fac_tipo)+" HP"+"_"+ALLTRIM(xpto)+"-"+ALLTRIM(xnro)+" -- "+xnomcli
								if xarti>5 and ALLTRIM(xsstock)<>"S"
									LOCAL stact,saldst
									SELECT st_act FROM cur_stact_ext WHERE art_codi = xarti INTO ARRAY ar_stvig
									IF TYPE("ar_stvig")="N"
										stact=ar_stvig[1,1]
									ELSE
										stact=0
									ENDIF
									conexterna= conectar_db(_screen.xconext)
									IF VARTYPE(conexterna) = "N" AND conexterna> 0
										do case
											case ALLTRIM(cur_farhis.fac_conc)="F"
												SET DECIMALS TO 3
												saldst=stact-xcantf
												SQLEXEC(conexterna,"insert into histostock values(null,?xarti,current_date(),current_time(),'S',?stact,-?xcantf,?saldst,?xcadecom,?xpie,0,0,?xcodifac,0,0,?cond,?codicli);")
												SET DECIMALS TO
											case ALLTRIM(cur_farhis.fac_conc)="N"
												SET DECIMALS TO 3
												saldst=stact+xcantf
												SQLEXEC(conexterna,"insert into histostock values(null,?xarti,current_date(),current_time(),'E',?stact,?xcantf,?saldst,?xcadecom,?xpie,0,0,?xcodifac,0,0,?cond,?codicli);")
												SET DECIMALS TO
										ENDCASE
										cerrar_cursor("cur_stac")
										desconectar_db(conexterna)
									ENDIF
								ENDIF
								*-------------------------------------------
								* Actualizar cur_stact local para artículos repetidos
								*-------------------------------------------
								SELECT cur_stact_ext
								LOCATE FOR art_codi = xarti
								IF FOUND()
									REPLACE st_act WITH saldst
								ENDIF						
								SELECT cur_farhis
							ENDIF
						ENDIF
						IF USED("cur_artext")
							USE IN cur_artext
						ENDIF
						SELECT cur_farhis
					ENDSCAN
					IF USED("cur_stact_ext")
						cerrar_cursor("cur_stact_ext")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		RETURN
		
		
	ENDPROC

	PROCEDURE remitados
		LPARAMETERS lcodfac
		
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select COUNT(*) can1 from facturas_articulos where fac_codi=?lcodfac;","cur_canrr")
			SQLEXEC(frmaltafac,"select COUNT(*) can2 from facturas_articulos where fac_codi=?lcodfac and remitado=1;","cur_canrf")
		desconectar_db(frmaltafac)
		
		IF cur_canrf.can2=cur_canrr.can1
			frmaltafac= conectar_db(_screen.cn)
				SQLEXEC(frmaltafac,"update facturas set remitado=1 where fac_codi=?lcodfac;")
			desconectar_db(frmaltafac)
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE btn_deta.Click
		IF LEN(ALLTRIM(cur_clie.cli_deta)) > 0
			MESSAGEBOX(ALLTRIM(cur_clie.cli_deta),64,"Detalles Adicionales del Cliente")
		ELSE
			MESSAGEBOX("No hay detalles ingresados para este cliente",48,"Detalles Adicionales del Cliente")
		ENDIF
		
	ENDPROC

	PROCEDURE btn_pesos.btn.Click
		LOCAL xdolar
		STORE 0 TO xdolar
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select param_impo from parametros where param_codi=14;","cur_dolar")
		desconectar_db(frmaltafac)
		
		xdolar=cur_dolar.param_impo
		
		IF thisform.estadolar=0
			SET POINT TO ","
			pesos=MESSAGEBOX("La cotización de dolar actual es de $ "+ALLTRIM(STR(xdolar,10,2))+".-"+CHR(13)+CHR(13)+ ;
							 "¿Convierte los precios del pedido a pesos con esta cotización?",4+32+256,"Aviso del Sistema")
			SET POINT TO
		
			IF pesos=6
				thisform.pesificar(xdolar)
				thisform.xdolar=xdolar
				thisform.estadolar=1
			ELSE
				DO FORM dolarizar WITH xdolar TO cxdolar
				IF cxdolar.Prop01>0
					thisform.pesificar(cxdolar.Prop01)
					thisform.xdolar=cxdolar.Prop01
					thisform.estadolar=1
				ELSE
					thisform.xdolar=0
					thisform.estadolar=0
				ENDIF
			ENDIF
		ELSE
			SET POINT TO ","
			ppdol=MESSAGEBOX("Los precios ya fueron convertidos a pesos con la cotización de $ "+ALLTRIM(STR(thisform.xdolar,10,2))+".-"+CHR(13)+ ;
							 "Antes de convertir nuevamente debe volver los precios al estado inicial."+CHR(13)+CHR(13)+ ;
							 "¿Procede con este cambio?",4+48+256,"Aviso del Sistema")
			SET POINT TO
			IF ppdol=6
				thisform.dolarizar(thisform.xdolar)
				thisform.xdolar=0
				thisform.estadolar=0
				
				DO FORM dolarizar WITH xdolar TO cxdolar
				
				IF cxdolar.Prop01>0
					thisform.pesificar(cxdolar.Prop01)
					thisform.xdolar=cxdolar.Prop01
					thisform.estadolar=1
				ELSE
					thisform.xdolar=0
					thisform.estadolar=0
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE btn_pesos.btn.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 0
		this.Parent.shape1.Visible= .F.
		
	ENDPROC

	PROCEDURE btn_pesos.btn.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.Parent.BackStyle= 1
		this.Parent.shape1.Visible= .T.
	ENDPROC

	PROCEDURE btn_pesos.Init
		this.BorderWidth = 0
		this.shape1.Height=this.Height
		this.shape1.Width =this.Width
		
		this.btn.Top   = 0
		this.btn.Left  = 0
		this.btn.Height=this.Height
		this.btn.Width =this.Width
		
	ENDPROC

	PROCEDURE Check1.Click
		do case
			case this.value=1
				if thisform.optiongroup2.value=1
					preg=messagebox("¿Confirma que factura todo sin mover Stock?",4+48+256,"Advertencia")
				else
					preg=messagebox("¿Confirma que acredita todo sin mover Stock?",4+48+256,"Advertencia")
				endif
				if preg=6
					if thisform.grid1.rows>1
						thisform.grid1.col=7
						for i=1 to thisform.grid1.rows-1
							thisform.grid1.row=i
							thisform.grid1.text="SS"
						next i
						thisform.grid1.row=1
					endif
				else
					this.value=0
				endif
			case this.value=0
				if thisform.optiongroup2.value=1
					preg=messagebox("¿Confirma que factura todo moviendo Stock?",4+48+256,"Advertencia")
				else
					preg=messagebox("¿Confirma que acredita todo moviendo Stock?",4+48+256,"Advertencia")
				endif
				if preg=6
					if thisform.grid1.rows>1
						thisform.grid1.col=7
						for i=1 to thisform.grid1.rows-1
							thisform.grid1.row=i
							thisform.grid1.text=""
						next i
						thisform.grid1.row=1
					endif
				else
					this.value=1
				endif
		endcase
	ENDPROC

	PROCEDURE Check2.Click
		DO case
			CASE this.Value=1
				IF thisform.text15.Value>0
					thisform.text15.Value=0
					STORE '' TO thisform.text16.Value, ;
								thisform.text20.Value
					thisform.text21.Value=0
					vcodi=0
					letrapor=''
					thisform.text15.Enabled= .F.
					thisform.text16.Enabled= .F.
					thisform.text20.Enabled= .F.
					thisform.text21.Enabled= .F.
					thisform.command5.Enabled= .F.
					thisform.command6.Enabled= .F.
				ENDIF
			CASE this.Value=0
				frmaltaped= conectar_db(_screen.cn)
					SQLEXEC(frmaltaped,"select a.*,b.* from zonas a inner join vendedores b on a.ven_codi=b.ven_codi where a.zona_codi=?cur_clie.zona_codi order by b.ven_codi;","cur_vende")
				desconectar_db(frmaltaped)
				thisform.text15.value=cur_vende.ven_codi
				thisform.text16.value=cur_vende.ven_nomb
				thisform.text15.Enabled= .T.
				thisform.text16.Enabled= .T.
				thisform.text20.Enabled= .T.
				thisform.text21.Enabled= .T.
				thisform.command5.Enabled= .T.
				thisform.command6.Enabled= .T.
		ENDCASE
	ENDPROC

	PROCEDURE chk_pcae.Click
		IF this.Value = 0
			xcadetip = ICASE(thisform.optiongroup2.Value=1,"ESTA FACTURA",thisform.optiongroup2.Value=2,"ESTA NOTA DE CRÉDITO")
			MESSAGEBOX("SI ELIGE NO SOLICITAR CAE PARA "+xcadetip+", EL COMPROBANTE QUEDARÁ GRABADO EN LA BASE DE DATOS SIN NÚMERO. DEBERÁ MODIFICARLO EN EL MENÚ MANTENIMIENTO DE COMPROBANTES.",0+48,"Alta Factura")
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_terminar.Click
		IF thisform.text15.Value>0 AND LEN(ALLTRIM(thisform.text20.Value))=0 AND letrapor=0
			MESSAGEBOX("Para continuar debe seleccionar la comisión para el Vendedor seleccionado.",0+48,"Aviso del Sistema")
			RETURN
		ELSE
			local primecodirem,primerem,primefac,valor,tsiva,letra_abc,dtipo,tipo, ;
				  xcompas,xdolar,ppend
		
			local nfelec,pfelec,cfelec,ffelec,bfelec,;
			      xtipo,xfecha,xcodicli,xcodiva,xdto,;
			      xcodp,xconc,xng,xnet1,xnet2,xivari,;
			      xivarni,xftot,xpie,xvend,xporc,xotcom,;
			      xart,xcant,ximpo,xdasc,xdc,xsst,xciva,xarpc
			      
			LOCAL xnfar,xnrar,xrmtdo
			STORE 0 TO xnfar,xnrar,xrmtdo
		
			STORE '' TO xtipo,xconc,xpie,xdasc,xsst,xciva
			STORE 0 TO xcodicli,xcodiva,xdto,xcodp,xconc,xng,xnet1,xnet2,;
			           xivari,xivarni,xftot,xvend,xporc,xotcom,xart,xcant,;
			           ximpo,xdc,xarpc,xcompas
			primecodirem=0
			primerem=0
			primefac=0
			valor=0
			tsiva=""
			letra_abc=""
			dtipo=""
			tipo=""
			xdolar = thisform.xdolar
			DIMENSION tra[2,5]
			if nitem=0
				messagebox("Aún no ha ingresado ningún Item a la Factura. Imposible Terminar",0+48,"Advertencia")
			else
				do case
					case thisform.optiongroup2.value=1
						preg=messagebox("¿Confirma los datos de la Factura?",4+32+256,"Alta de Facturas")
					case thisform.optiongroup2.value=2
						preg=messagebox("¿Confirma los datos de la Nota de Crédito?",4+32+256,"Alta de Facturas")
				endcase
				x=1
				if preg=6
					thisform.acu=0
					c=1
				*!*		if thisform.optiongroup2.value=2
				*!*			do form textonc with nctext
				*!*		endif
					do case
						case thisform.optiongroup2.value=1
							IF thisform.valorcadena="Por Remito de Cliente"
								pregunta=7
							ELSE
								pregunta=messagebox("¿Imprime Remito?",4+32+256,"Consulta")
							ENDIF
						case thisform.optiongroup2.value=2
							pregunta=7
						other case
							pregunta=6
					endcase
					thisform.acu=0
					ivari=0
					with thisform
						if thisform.valorcadena="Por Pedido de Cliente" OR thisform.valorcadena="Por Remito de Cliente"
							frmaltafac= conectar_db(_screen.cn)
								SQLEXEC(frmaltafac,"select * from pedidos_transportes where ped_codi=?codp;","cur_pedtra")
							desconectar_db(frmaltafac)
							if RECCOUNT("cur_pedtra")>0
								GO top
								coditran1=cur_pedtra.tran_codi
								lugent1=cur_pedtra.flete_lugent
								do case
									case cur_pedtra.flete_cargo="P"
										flete1=1
									case cur_pedtra.flete_cargo="C"
										flete1=2
								ENDCASE
								if RECCOUNT("cur_pedtra")>1
									skip
									coditran2=cur_pedtra.tran_codi
									lugent2=cur_pedtra.flete_lugent
									do case
										case cur_pedtra.flete_cargo="P"
											flete2=1
										case cur_pedtra.flete_cargo="C"
											flete2=2
									endcase
								ENDIF
							ENDIF
						endif
						do case
							case .optiongroup1.value=1
								xtipo="A"
								xivari=.text9.value
								xivarni=.text11.value
							case .optiongroup1.value=2
								xtipo="B"
								xivari=acu1
								xivarni=acu2
						endcase
						xnet1=iif(cond=2,impo1,acun1)
						xnet2=iif(cond=2,impo2,acun2)
						if cond=2 and .text18.value-impo1-impo2>0
							xng=.text18.value-impo1-impo2
						endif
						xfecha=.text13.value
						xcodicli=codicli
						xcodiva=codiva
						xdto=.text19.value
						xpie=ALLTRIM(piepagina)
						LOCAL totot
						totot=xng+xnet1+xnet2+xivari+xivarni
						frmaltafac= conectar_db(_screen.cn)
							do case
								case .optiongroup2.value=1
									xconc="F"
									SQLEXEC(frmaltafac,"update clientes set cli_saldo=cli_saldo+?totot where cli_codi=?codicli;")
								case .optiongroup2.value=2
									xconc="N"
									SQLEXEC(frmaltafac,"update clientes set cli_saldo=cli_saldo-?totot where cli_codi=?codicli;")
							ENDCASE
						desconectar_db(frmaltafac)		
						if thisform.valorcadena="Por Pedido de Cliente" OR thisform.valorcadena="Por Remito de Cliente"
							xcodp=codp
						endif
						if .text15.value>0
							xvend=.text15.value
							if LEN(ALLTRIM(.text20.value))=0
								if thisform.text21.value>0
									xotcom=.text21.value
								endif
							else
								xporc=porcodi
							ENDIF
						ENDIF
						totsiva=round((.text8.value-(.text8.value*.text19.value/100)),2)
						ivari=.text9.value
						ivarni=.text11.value
						totalri=totsiva+ivari
						totalrni=totsiva+ivari+ivarni
						xftot=xng+xnet1+xnet2
						xcompas=IIF(thisform.optiongroup2.Value=2,nroasoc,0)
						frmaltafac= conectar_db(_screen.cn)
							SQLEXEC(frmaltafac,"call usp_guardarfac(?xtipo,?xfecha,?xcompas,?xcodicli,?xcodiva,?xdto,?xcodp,?xconc,?xng,?xnet1,?xnet2,?xivari,?xivarni,?xftot,?xpie,?xvend,?xporc,?xotcom,?xdolar);","cur_codifac")
						desconectar_db(frmaltafac)
						thisform.xcodifac=cur_codifac.ncodi
		*!*					IF thisform.valorcadena="Por Remito de Cliente"
		*!*						frmaltafac= conectar_db(_screen.cn)
		*!*							SQLEXEC(frmaltafac,"update remitos set fac_codi=?codifac where rem_codi=?codirem;")
		*!*						desconectar_db(frmaltafac)						
		*!*					ENDIF
						if pregunta=6 and thisform.optiongroup2.value=1
							frmaltafac= conectar_db(_screen.cn)
								SQLEXEC(frmaltafac,"select MAX(rem_codi) as rem_codi from remitos order by rem_codi;","cur_nvorem")
								if RECCOUNT("cur_nvorem")>0
									IF ISNULL(cur_nvorem.rem_codi)
										codirem=1
										nrorem=1
									else
										codirem=cur_nvorem.rem_codi+1
										if x>1
											nrorem=nrorem+1
										endif
									ENDIF
								ENDIF
		*!*							if x=1
		*!*								primecodirem=codirem
		*!*								primerem=nrorem
		*!*							endif
								SQLEXEC(frmaltafac,"insert into remitos values(?codirem,?nrorem,?ptorem,?.text13.value,?thisform.xcodifac,0,?codicli,?xcodp,0,'',0,0,'','','',1);")
							desconectar_db(frmaltafac)
						else
							nrorem=0
						ENDIF
						if thisform.valorcadena="Notas de Crédito" AND codp>0
							ppend= MESSAGEBOX("¿DEVUELVE LOS PENDIENTES AL PEDIDO DEL CLIENTE?",4+48+256,"Aviso del Sistema")
						ENDIF
						contador=1
						for fila=c to .grid1.rows-1
							STORE '' TO xdasc,xsst,xciva
							STORE 0 TO xart,xcant,ximpo,xdc,xarpc,xrmtdo
							if contador<=27
								if fila<.grid1.rows
									.grid1.row=fila
									.grid1.col=3
									if val(.grid1.text)<=5
										.grid1.col=4
										xdasc=.grid1.text
										.grid1.col=3
									endif
									xart=val(.grid1.text)
									articulo=val(.grid1.text)
									.grid1.col=4
									frmaltafac= conectar_db(_screen.cn)
										SQLEXEC(frmaltafac,"select * from articulos where art_codi=?articulo;","cur_arti")
									desconectar_db(frmaltafac)
									if articulo>5 and allt(.grid1.text)<>allt(cur_arti.art_desc)
										LOCAL cadebus1,cadebus2
										cadebus1=ALLTRIM(str(codicli))+ALLTRIM(str(articulo))
										frmaltafac= conectar_db(_screen.cn)
											SQLEXEC(frmaltafac,"select * from articulos_clientes where CONCAT(TRIM(CAST(cli_codi as CHAR)),TRIM(CAST(art_codi as CHAR)))=?cadebus1;","cur_arcli")
											if RECCOUNT("cur_arcli")>0
												cadebus2=ALLTRIM(str(cur_arcli.artcli_codi))+allt(.grid1.text)
												SQLEXEC(frmaltafac,"select * from desc_articulos_clientes where CONCAT(TRIM(CAST(artcli_codi as CHAR)),TRIM(dac_desc))=?cadebus2;","cur_darc")
												if RECCOUNT("cur_darc")>0
													xdc=cur_darc.dac_codi
												ELSE
													xdc=0
												endif
											ENDIF
										desconectar_db(frmaltafac)
									ELSE
										xdc=0
									ENDIF
									.grid1.col=1
									SET POINT TO ","
									SET DECIMALS TO 3
									xcant=ConverNro(.grid1.text)
									.grid1.col=7
									if allt(.grid1.text)="SS"
										xsst="S"
										.grid1.col=10
										xarpc=VAL(.grid1.text)
									ELSE
										xsst=''
										DO case
											CASE thisform.valorcadena="Por Pedido de Cliente" OR thisform.valorcadena="Por Remito de Cliente"
												.grid1.col=10
												xarpc=VAL(.grid1.text)
												frmaltafac= conectar_db(_screen.cn)
													SQLEXEC(frmaltafac,"select * from pedidos_articulos where artped_codi=?xarpc;","cur_ap")
													IF RECCOUNT("cur_ap")>0
														.grid1.col=1
														if ConverNro(.grid1.text)>(cur_ap.artped_cant-cur_ap.artped_ent)
															xcntped=IIF(cur_ap.artped_ent>0,cur_ap.artped_cant-cur_ap.artped_ent,cur_ap.artped_cant)
															SQLEXEC(frmaltafac,"update pedidos_articulos set artped_ent=artped_ent+?xcntped where artped_codi=?cur_ap.artped_codi;")
														ELSE
															SQLEXEC(frmaltafac,"update pedidos_articulos set artped_ent=artped_ent+?ConverNro(.grid1.text) where artped_codi=?cur_ap.artped_codi;")
														ENDIF
													ENDIF
												desconectar_db(frmaltafac)
												IF cur_ap.art_codi > 5
													Campo_ped(cur_ap.art_codi)
												ENDIF
											CASE thisform.valorcadena="Notas de Crédito" AND codp>0
												IF ppend=6
													.grid1.col=10
													xarpc=VAL(.grid1.text)
													frmaltafac= conectar_db(_screen.cn)
														SQLEXEC(frmaltafac,"update pedidos_articulos set artped_ent=artped_ent-?xcant where artped_codi=?xarpc;")
													desconectar_db(frmaltafac)
													IF xart > 5
														Campo_ped(xart)
													ENDIF
													do cumplido with codp
												ENDIF
										ENDCASE
									endif
									.grid1.col=7
									if cur_arti.art_codi>5 and allt(.grid1.text)<>"SS"
										frmaltafac= conectar_db(_screen.cn)
											SQLEXEC(frmaltafac,"select art_stock st_act from articulos where art_codi = ?articulo;","cur_stvig")
										desconectar_db(frmaltafac)
										IF RECCOUNT("cur_stvig")>0
											INSERT INTO cur_stact values(articulo,cur_stvig.st_act)
											INSERT INTO cur_stact_ext values(articulo,cur_stvig.st_act)
										ENDIF
										frmaltafac= conectar_db(_screen.cn)
											do case
												case .optiongroup2.value=1
													SQLEXEC(frmaltafac,"update articulos set art_stock=art_stock-?xcant where art_codi=?articulo;")
												case .optiongroup2.value=2
													SQLEXEC(frmaltafac,"update articulos set art_stock=art_stock+?xcant where art_codi=?articulo;")
											ENDCASE
										desconectar_db(frmaltafac)
										******************* SE CONECTA AL SERVIDOR ILUMET Y CHEQUEA SI EXISTE ARTÍCULO Y MODIFICA STOCK TAMBIEN ****************
										conexterna= conectar_db(_screen.xconext)
										IF VARTYPE(conexterna) = "N" AND conexterna> 0
											SQLEXEC(conexterna,"select * from articulos where art_codi = ?articulo;","cur_artext")
											IF USED("cur_artext")
												IF RECCOUNT("cur_artext") > 0
													do case
														case .optiongroup2.value=1
															SQLEXEC(conexterna,"update articulos set art_stock=art_stock-?xcant where art_codi=?articulo;")
														case .optiongroup2.value=2
															SQLEXEC(conexterna,"update articulos set art_stock=art_stock+?xcant where art_codi=?articulo;")
													ENDCASE											
												ENDIF
												cerrar_cursor("cur_artext")
											ENDIF
											desconectar_db(conexterna)
										ENDIF
										********************** FIN PROCESO SERVIDOR ILUMET *******************************
									endif
									.grid1.col=4
									if articulo<=5
										xdasc=ALLTRIM(.grid1.text)
									endif
									.grid1.col=5
									ximpo=ConverNro(.grid1.text)
									if .optiongroup1.value=1
										.grid1.col=9
										if allt(.grid1.text)="NO"
											xciva="NO"
										else
											xciva="SI"
										endif
									ENDIF							
									SET POINT TO
									SET DECIMALS TO
									frmaltafac= conectar_db(_screen.cn)
										SQLEXEC(frmaltafac,"select cast(far_codi+1 as DECIMAL(8,0)) as far_codi from facturas_articulos order by far_codi desc limit 1;","cur_farnvo")
										IF RECCOUNT("cur_farnvo")>0
											xnfar=cur_farnvo.far_codi
										ENDIF
										IF pregunta=6
											xrmtdo=1
										ENDIF
										SQLEXEC(frmaltafac,"insert into facturas_articulos values(?xnfar,?thisform.xcodifac,?articulo,?xcant,?ximpo,?xdasc,?xdc,'','',?xsst,?xciva,?xarpc,?xrmtdo);")
										IF thisform.valorcadena="Por Remito de Cliente"
											.grid1.col=11
											xnrer=VAL(.grid1.text)
											SQLEXEC(frmaltafac,"insert into facar_remar values(?xnfar,?xnrer,?xcant);")
											LOCAL xcrfac
											SQLEXEC(frmaltafac,"select ROUND(SUM(farrer_cant),3) farrer_cant from facar_remar where rer_codi=?xnrer;","cur_canrer")
											xcrfac = IIF(ISNULL(cur_canrer.farrer_cant),0,cur_canrer.farrer_cant)
											SQLEXEC(frmaltafac,"update remitos_articulos set facturado=if(?xcrfac>=artrem_cant,1,0) where rer_codi=?xnrer;")
											SQLEXEC(frmaltafac,"update facturas_articulos set remitado=if(?xcrfac>=artfac_cant,1,0) where far_codi=?xnfar;")
										ENDIF
										if pregunta=6 and thisform.optiongroup2.value=1
											SQLEXEC(frmaltafac,"select cast(rer_codi+1 as DECIMAL(8,0)) as rer_codi from remitos_articulos order by rer_codi desc limit 1;","cur_rernvo")
											IF RECCOUNT("cur_rernvo")>0
												xnrer=cur_rernvo.rer_codi
											ENDIF
											SQLEXEC(frmaltafac,"insert into remitos_articulos values(?xnrer,?codirem,?articulo,?nrorem,?xcant,?xdasc,?xdc,0,'','',?xarpc,1);")
											SQLEXEC(frmaltafac,"insert into facar_remar values(?xnfar,?xnrer,?xcant);")
										ENDIF
									desconectar_db(frmaltafac)
								endif
								contador=contador+1
								thisform.acu=ROUND(thisform.acu+round((xcant*ximpo),2),2)
							else
								exit
							ENDIF
						next fila
						IF pregunta=6 and thisform.optiongroup2.value=1
							frmaltafac= conectar_db(_screen.cn)
								SQLEXEC(frmaltafac,"update remitos set facturado=1 where rem_codi=?codirem;")
								SQLEXEC(frmaltafac,"update facturas set remitado=1 where fac_codi=?thisform.xcodifac;")
							desconectar_db(frmaltafac)
						ELSE
							IF thisform.valorcadena="Por Remito de Cliente"
								thisform.facturados(codirem)
								thisform.remitados(thisform.xcodifac)
							ENDIF
						ENDIF
					ENDWITH
					thisform.registrahistostock(thisform.xcodifac)
					******************* INTENTA REGISTRO DE HISTORICO EN SERVIDOR ILUMET ***************************
					thisform.registrarhistostock_ilumet(thisform.xcodifac)			
					IF thisform.chk_pcae.Value=1
						************//////////// COMIENZA FACTURA ELECTRÓNICA \\\\\\\\\\\\\**********
						with thisform
							if .optiongroup2.value=1
								tipo="FC"
							else
								tipo="NC"
							endif
							do case
								case cond=1
									tsiva="F"
									letra_abc="B"
								case cond=2
									tsiva="I"
									letra_abc="A"
								case cond=4
									tsiva="M"
									letra_abc="B"
								case cond=5
									tsiva="E"
									letra_abc="B"
							endcase
							dtipo=tipo
							sele 0
							use "c:\sistema srl\factelec\fe_cabez"
							set reprocess to automatic
							if flock()
								repla estado with "0"
								repla previa with "1"
								repla destino with "1"
								repla tipo with dtipo
								repla letra with letra_abc
								repla puesto with 0
								repla numero with 0
								repla fe_emi with .text13.value
								repla razon with cur_clie.cli_nomb
								repla domic with cur_clie.cli_domi
								repla local with cur_clie.loca_nomb
								if tsiva="I" or tsiva="E" or tsiva="M"
									repla cuit with allt(cur_clie.cli_cuit)
								else
									repla cuit with subst(allt(cur_clie.cli_cuit),3,8)
								endif
								repla siva with tsiva
								repla ibru with space(15)
								repla condi with iif(tipo = "FC", "CTA. CTE. [VTO.:"+dtoc(.text13.value+30)+"]","CONTADO")+IIF(LEN(ALLTRIM(xpie))>0,"   - OBSER: "+ALLTRIM(xpie),"")
								repla otros with ""
								repla total with xnet1+xnet2+xivari+xivarni+xng
								repla neto210 with xnet1
								repla neto105 with xnet2
								repla neto270 with 0
								repla iva_210 with xivari
								repla iva_105 with xivarni
								repla iva_270 with 0
								repla exento with xng
								repla nograb with 0
								repla iminte with 0
								repla subtotal with xnet1+xnet2+xng
								repla descuento with ((xnet1+xnet2+xng)*xdto)/100
								repla porcentaje with xdto
								repla cae with space(30)
								repla fvtocae with ctod("  /  /  ")
								repla observ with space(100)
								IF thisform.optiongroup2.Value=2
									REPLACE barra WITH REPLICATE("0",8-LEN(ALLTRIM(STR(nroasoc))))+ALLTRIM(STR(nroasoc))
								ELSE
									repla barra with space(40)
								ENDIF
					*			repla cartel1 with space(40)
					*			repla cartel2 with space(40)
					*			repla cartel3 with space(100)
							ENDIF
							sele 0
							use "c:\sistema srl\factelec\fe_detal" exclusive
							set reprocess to automatic
							if flock()
								set safety off
								zap
								set safety on
								use in fe_detal
								sele 0
								use "c:\sistema srl\factelec\fe_detal"
								SET DECIMALS TO 3
								frmaltafac= conectar_db(_screen.cn)
									SQLEXEC(frmaltafac,"select a.*,b.art_desc,b.art_alicuota,c.dac_desc from facturas_articulos a inner join articulos b on a.art_codi=b.art_codi left outer join desc_articulos_clientes c on c.dac_codi=a.dac_codi where fac_codi=?thisform.xcodifac;","cur_facfel")
								desconectar_db(frmaltafac)
								SET DECIMALS TO
								GO top
								scan
									sele fe_detal
									appe blan
									repla codigo with allt(str(cur_facfel.art_codi,8))
									if cur_facfel.art_codi=4 or cur_facfel.art_codi=5
										if len(allt(cur_facfel.artfac_dasc))>44
											posin=1
											poscar=44
											contcar=44
											do while contcar<=len(allt(cur_facfel.artfac_dasc))
												if !inlist(subst(allt(cur_facfel.artfac_dasc),contcar,1)," ",".","-","_")
													do while !inlist(subst(allt(cur_facfel.artfac_dasc),contcar,1)," ",".","-","_")
														poscar=poscar-1
														contcar=contcar-1
													enddo
												endif
												if posin>1
													appe blank
												endif
												if posin=1
													repla codigo with allt(str(cur_facfel.art_codi,8))
													repla cantid with cur_facfel.artfac_cant
												endif
												repla descri with subst(allt(cur_facfel.artfac_dasc),posin,poscar)
						   						contcar=contcar+1
												posin=contcar
												restcar=len(allt(cur_facfel.artfac_dasc))-(contcar-1)
												if restcar<=44
													if posin>1
														appe blank
													endif
													if posin=1
														repla codigo with allt(str(cur_facfel.art_codi,8))
														repla cantid with cur_facfel.artfac_cant
													endif
													repla descri with subst(allt(cur_facfel.artfac_dasc),posin,poscar)
													exit
												else
													contcar=contcar+44
													poscar=44
												endif
											enddo
										else
											repla cantid with cur_facfel.artfac_cant
											repla descri with allt(cur_facfel.artfac_dasc)
										endif						
									else
										repla cantid with cur_facfel.artfac_cant
										repla descri with IIF(cur_facfel.dac_codi>0,ALLTRIM(cur_facfel.dac_desc),ALLTRIM(cur_facfel.art_desc))
									endif
									repla observ with space(49)
									repla prlist with cur_facfel.artfac_impo
									repla bonifi with 0
									repla prunit with cur_facfel.artfac_impo
									do case
										case cur_facfel.calciva="SI"
											repla iva with iif(cur_facfel.art_alicuota=1,impiva1,impiva2)
										case cur_facfel.calciva="NO"
											repla iva with 0
									endcase
									repla inter with 0
									repla total with cur_facfel.artfac_cant*cur_facfel.artfac_impo
									sele cur_facfel
								endscan
							ENDIF
						ENDWITH
						******************COMIENZA SOLICITUD DE CAE**************************************
						cdir=sys(5)+sys(2003)
						oWsh = CREATEOBJECT ("wscript.shell")
						set defa to "c:\sistema srl\factelec\"
						oWsh.Run ("felec.exe", 3, .T.)
						set defa to (cdir)
						*******************FIN SOLICITUD CAE********************************************
						*******************VALIDA CAE***************************************************
						sele fe_cabez
						go top
						nfelec=numero
						pfelec=puesto
						cfelec=cae
						ffelec=fvtocae
						bfelec=ALLTRIM(barra)
						if estado!="A"
							DO case
								CASE LEN(ALLTRIM(bfelec))>0
									messagebox(ALLTRIM(bfelec),0+48,"Mensaje de Webservice AFIP")
								CASE LEN(ALLTRIM(fe_cabez.observ))>0
									messagebox(ALLTRIM(fe_cabez.observ),0+48,"Mensaje de Webservice AFIP")
							ENDCASE
						ELSE
							frmaltafac= conectar_db(_screen.cn)
								SQLEXEC(frmaltafac,"update facturas set fac_nro=?nfelec,fac_pto=?pfelec,cae=?cfelec,fvtocae=?ffelec,barra=?bfelec where fac_codi=?thisform.xcodifac;")
							desconectar_db(frmaltafac)
						endif
						use in fe_cabez
						use in fe_detal
		
			     		*******************FIN VALIDACIÓN DE CAE*************************************
						************//////////// FIN FACTURA ELECTRÓNICA \\\\\\\\\\\\\***********************
					ELSE
						frmaltafac= conectar_db(_screen.cn)
							SQLEXEC(frmaltafac,"update facturas set fac_pcae=0 where fac_codi=?thisform.xcodifac;")
						desconectar_db(frmaltafac)
					ENDIF
					********************************************************************************************				
		*!*				thisform.xcodifac=0
					c=fila
					if thisform.valorcadena="Por Pedido de Cliente" OR thisform.valorcadena="Por Remito de Cliente"
						do cumplido with codp
					endif
					if pregunta=6
						if thisform.optiongroup2.value=1
							messagebox("Verifique Impresora de Remitos",0+48,"Advertencia!!!")
		*!*						codirem=primecodirem
		*!*						nrorem=primerem
							nrofac=nfelec
							do form datosremito with codirem,nrorem,nrofac,lugent1,lugent2,observ,flete1,flete2,coditran1,coditran2
							store "" to tra[1,1],tra[1,2],tra[1,5],tra[2,1],tra[2,2],tra[2,5],tra[1,3],tra[1,4],tra[2,3],tra[2,4]
							frmaltafac= conectar_db(_screen.cn)
								SQLEXEC(frmaltafac,"select * from transportes where tran_codi=?coditran1;","cur_tran1")
								if RECCOUNT("cur_tran1")>0
									tra[1,1]=allt(cur_tran1.tran_nomb)
									tra[1,2]=allt(cur_tran1.tran_domi)
									tra[1,3]=cur_tran1.tran_cartel
									tra[1,4]=cur_tran1.tran_tel1
									tra[1,5]=allt(lugent1)
								ENDIF
								SQLEXEC(frmaltafac,"select * from transportes where tran_codi=?coditran2;","cur_tran2")
								if RECCOUNT("cur_tran2")>0
									tra[2,1]=allt(cur_tran2.tran_nomb)
									tra[2,2]=allt(cur_tran2.tran_domi)
									tra[2,3]=cur_tran2.tran_cartel
									tra[2,4]=cur_tran2.tran_tel1
									tra[2,5]=allt(lugent2)
								ENDIF
								SQLEXEC(frmaltafac,"call usp_buscarcli(?codicli);","cur_clir")
								SQLEXEC(frmaltafac,"select * from remitos where rem_codi=?codirem;","cur_rem")
								SQLEXEC(frmaltafac,"select a.*,b.art_desc,b.art_med,c.dac_desc from remitos_articulos a inner join articulos b on a.art_codi=b.art_codi left outer join desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.rem_codi=?codirem;","cur_remart")
								GO top
							desconectar_db(frmaltafac)
							for n=1 to 3
								do case
									case n=1
										comprobante="ORIGINAL"
									case n=2
										comprobante="DUPLICADO"
									case n=3
										comprobante="TRIPLICADO"
								endcase
								set point to ","
								report form remito for cur_remart.rem_codi=codirem TO PRINTER PROMPT noconsole
								set point to
							next n
						endif
					ENDIF
					estadoasoc=.F.
					nroasoc=0
					_screen.vendasoc=0
					_screen.porcodiasoc=0
					_screen.otcomiasoc=0.000
					thisform.release
				endif
			ENDIF
		ENDIF
		
		
		***************************************************************************************************
		
	ENDPROC

	PROCEDURE cmd_terminar.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_terminar.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC


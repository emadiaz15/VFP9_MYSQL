	PROCEDURE Command5.Click
		do form locavend with vcodi
		if vcodi>0
			frmaltafac= conectar_db(_screen.cn)
				SQLEXEC(frmaltafac,"select * from vendedores where ven_codi=?vcodi;","cur_vende")
			desconectar_db(frmaltafac)
			IF RECCOUNT("cur_vende")>0
				thisform.text15.value=cur_vende.ven_codi
				thisform.text16.value=cur_vende.ven_nomb
			ENDIF
		else
			thisform.text16.value=""
		endif
	ENDPROC

	PROCEDURE Command5.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command5.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command6.Click
		do form locapcom with letrapor
		if letrapor>0
			frmaltafac= conectar_db(_screen.cn)
				SQLEXEC(frmaltafac,"select * from porcencomi where porc_codi=?letrapor;","cur_porcen")
			desconectar_db(frmaltafac)
			IF RECCOUNT("cur_porcen")>0
				porcodi=cur_porcen.porc_codi
				thisform.text20.value=cur_porcen.porc_desc
				thisform.text21.value=cur_porcen.porc_impo
			ELSE
				letrapor=0
			ENDIF
		else
			thisform.text21.value=0
			letrapor=0
			porodi=0
		endif
	ENDPROC


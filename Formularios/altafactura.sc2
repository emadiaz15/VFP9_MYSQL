		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		piepagina=allt(this.value)
		capslock(.F.)
		
	ENDPROC

	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
	ENDPROC

	PROCEDURE grid1.DblClick
		*** ActiveX Control Event ***
		local x,y,dtopie,ivaencol
		if nitem>0
			this.col=0
			aux=val(this.text)
			this.col=3
			dato1=val(this.text)
			this.col=1
			dato2=this.text
			this.col=4
			dato3=this.text
			this.col=5
			dato4=this.text
			this.col=6
			prtot=allt(this.text)
			this.col=2
			dato5=this.text
			this.col=7
			if allt(this.text)="SS"
				opcion=3
			else
				opcion=0
			endif
			this.col=9
			if allt(this.text)="NO"
				opcion2=6
			else
				opcion2=0
			endif
			if thisform.optiongroup2.value=1
				concepto="F"
			else
				concepto="N"
			endif
			auximpo=0
			auxiva=0
			frmaltafac= conectar_db(_screen.cn)
				SQLEXEC(frmaltafac,"select * from articulos where art_codi=?dato1;","cur_arti")
			desconectar_db(frmaltafac)
			do form modippreg with cond,opcion,opcion2,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		if borra=6
			with thisform
				if this.rows=2
					this.col=8
					do case
						case ConverNro(this.text)=impiva1
							ivaencol=1
						case ConverNro(this.text)=impiva2
							ivaencol=2
					endcase
					this.col=6
					prtot=STRTRAN(ALLTRIM(this.text),",",".")
					nitem=0
					this.rows=1
					thisform.acu=0
					impo1=0
					impo2=0
					acun1=0
					acun2=0
					acu1=0
					acu2=0
					.text8.value=0
					.text9.value=0
					.text10.value=0
					.text11.value=0
					.text17.value=0
					.text18.value=0
					.text19.value=0
				else
					this.col=8
					do case
						case ConverNro(this.text)=impiva1
							ivaencol=1
						case ConverNro(this.text)=impiva2
							ivaencol=2
					endcase
					this.col=6
					prtot=STRTRAN(ALLTRIM(this.text),",",".")
					thisform.acu=ROUND(thisform.acu-CAST(prtot as N(15,2)),2)
					nitem=nitem-1
					this.removeitem(this.row)
					this.col=2
					x=1
					y=0
					do while x<=this.rows-1
						this.row=x
						y=y+1
						this.col=0
						this.text=allt(str(y))
						x=x+1
					enddo
				endif
				thisform.text8.value=thisform.acu
				if this.rows=>2
					if thisform.text19.value>0
						dtopie=round((100-thisform.text19.value)/100,2)
						thisform.text17.value=thisform.acu*dtopie
						thisform.text18.value=thisform.acu-thisform.text17.value
						do case
							case ivaencol=1
								impo1=impo1-(CAST(prtot as N(15,2))*dtopie)
								if cond=2
									thisform.text9.value=thisform.text9.value-round((CAST(prtot as N(15,2))*dtopie)*impiva1/100,2)
								else
									auxacuneto=acun1
									acun1=acun1-((CAST(prtot as N(15,2))*dtopie)/(1+(impiva1/100)))
									acu1=acu1-(auxacuneto-acun1)*impiva1/100
								endif
							case ivaencol=2
								impo2=impo2-(CAST(prtot as N(15,2))*dtopie)
								if cond=2
									thisform.text11.value=thisform.text11.value-round((CAST(prtot as N(15,2))*dtopie)*impiva2/100,2)
								else
									auxacuneto=acun2
									acun2=acun2-((CAST(prtot as N(15,2))*dtopie)/(1+(impiva2/100)))
									acu2=acu2-(auxacuneto-acun2)*impiva2/100
								endif
						endcase
					else
						thisform.text18.value=thisform.acu
						do case
							case ivaencol=1
								impo1=impo1-CAST(prtot as N(15,2))
								if cond=2				
									thisform.text9.value=thisform.text9.value-round(CAST(prtot as N(15,2))*impiva1/100,2)
								else
									auxacuneto=acun1
									acun1=acun1-(CAST(prtot as N(15,2))/(1+(impiva1/100)))
									acu1=acu1-(auxacuneto-acun1)*impiva1/100
								endif
							case ivaencol=2
								impo2=impo2-CAST(prtot as N(15,2))
								if cond=2
									thisform.text11.value=thisform.text11.value-round(CAST(prtot as N(15,2))*impiva2/100,2)
								else
									auxacuneto=acun2
									acun2=acun2-(CAST(prtot as N(15,2))/(1+(impiva2/100)))
									acu2=acu2-(auxacuneto-acun2)*impiva2/100
								endif
						endcase
					endif
					thisform.text10.value=thisform.text18.value+thisform.text9.value+thisform.text11.value
				endif	
			endwith
			borra=0
			insertar=0
			preg=0
		endif
		if insertar=1 and codigo<>0
			with thisform
				this.col=0
				nro=this.row
				frmaltafac= conectar_db(_screen.cn)
					SQLEXEC(frmaltafac,"select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmaltafac)		
				if opcion=1
					cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
					this.additem(" "+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+cadena+chr(9)+descri+chr(9)+allt(pruni)+chr(9)+prtot,.grid1.row)
					if .check1.value=1
						.grid1.col=7
						.grid1.text="SS"
					ENDIF
					thisform.acu=ROUND(thisform.acu+CAST(STRTRAN(prtot,",",".") as N(15,2)),2)
					nitem=nitem+1
					muestro=0
					opcion=0
				endif
				.grid1.col=8
				do case
					case cur_arti.art_alicuota=1
						.grid1.text=allt(str(impiva1,10,2))
					case cur_arti.art_alicuota=2
						.grid1.text=allt(str(impiva2,10,2))
				endcase
				.grid1.col=1
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=6
				.grid1.col=2
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=8
				.grid1.col=8
				.grid1.cellfontname="Courier New"
				.grid1.cellfontsize=8
				.grid1.cellalignment=8
				thisform.text8.value=thisform.acu
				if thisform.text19.value>0
					dtopie=round((100-thisform.text19.value)/100,2)
					thisform.text17.value=thisform.acu*dtopie
					thisform.text18.value=thisform.acu-thisform.text17.value
					do case
						case cur_arti.art_alicuota=1
							impo1=impo1+(CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)
							if cond=2
								thisform.text9.value=thisform.text9.value+round((CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)*impiva1/100,2)
							else
								auxacuneto=acun1
								acun1=acun1+((CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)/(1+(impiva1/100)))
								acu1=acu1+(acun1-auxacuneto)*impiva1/100
							endif
						case cur_arti.art_alicuota=2
							impo2=impo2+(CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)
							if cond=2
								thisform.text11.value=thisform.text11.value+round((CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)*impiva2/100,2)
							else
								auxacuneto=acun2
								acun2=acun2+((ConverNro(prtot)*dtopie)/(1+(impiva2/100)))
								acu2=acu2+(acun2-auxacuneto)*impiva2/100
							endif
					endcase
				else
					thisform.text18.value=thisform.acu
					do case
						case cur_arti.art_alicuota=1
							impo1=impo1+CAST(STRTRAN(prtot,",",".") as N(15,2))
							if cond=2				
								thisform.text9.value=thisform.text9.value+round(CAST(STRTRAN(prtot,",",".") as N(15,2))*impiva1/100,2)
							else
								auxacuneto=acun1
								acun1=acun1+(CAST(STRTRAN(prtot,",",".") as N(15,2))/(1+(impiva1/100)))
								acu1=acu1+(acun1-auxacuneto)*impiva1/100
							endif
						case cur_arti.art_alicuota=2
							impo2=impo2+CAST(STRTRAN(prtot,",",".") as N(15,2))
							if cond=2
								thisform.text11.value=thisform.text11.value+round(CAST(STRTRAN(prtot,",",".") as N(15,2))*impiva2/100,2)
							else
								auxacuneto=acun2
								acun2=acun2+(CAST(STRTRAN(prtot,",",".") as N(15,2))/(1+(impiva2/100)))
								acu2=acu2+(acun2-auxacuneto)*impiva2/100
							endif
					endcase
				endif
				thisform.text10.value=thisform.text18.value+thisform.text9.value+thisform.text11.value
				x=1
				y=0
				filaux=this.row
				do while x<=this.rows-1
					this.row=x
					y=y+1
					this.col=0
					this.text=allt(str(y))
					.grid1.cellfontname="Courier New"
					.grid1.cellfontsize=8
					.grid1.cellalignment=3
					x=x+1
				enddo
				this.row=filaux
				insertar=0
			endwith
		endif
		do case
			case opcion=3
				this.col=7
				this.text="SS"
				localiz=0
				opcion=0
			case opcion=4
				this.col=7
				this.text=""
				localiz=0
				opcion=0
			case opcion=5
				this.col=4
				texto=allt(this.text)
				do form difedesc with texto
				this.col=4
				this.text=allt(texto)
				LOCAL cadebus
				cadebus1=ALLTRIM(STR(codicli))+ALLTRIM(STR(codigo))
				frmaltafac= conectar_db(_screen.cn)
					SQLEXEC(frmaltafac,"select * from articulos_clientes where CONCAT(TRIM(CAST(cli_codi as CHAR)),TRIM(CAST(art_codi as CHAR)))=?cadebus1;","cur_arcli")
				desconectar_db(frmaltafac)
				if RECCOUNT("cur_arcli")>0
					cadebus2=ALLTRIM(str(cur_arcli.artcli_codi))+allt(texto)
					frmaltafac= conectar_db(_screen.cn)
						SQLEXEC(frmaltafac,"select * from desc_articulos_clientes where CONCAT(TRIM(CAST(artcli_codi as CHAR)),TRIM(dac_desc))=?cadebus2;","cur_dac")
						if RECCOUNT("cur_dac")=0
							SQLEXEC(frmaltafac,"select MAX(dac_codi) as dac_codi from desc_articulos_clientes order by dac_codi;","cur_nvodif")
							IF RECCOUNT("cur_nvodif")>0
								c=cur_nvodif.dac_codi+1
							ELSE
								c=1	
							ENDIF
							SQLEXEC(frmaltafac,"insert into desc_articulos_clientes values(?c,?cur_arcli.artcli_codi,?texto);")
						ENDIF
					desconectar_db(frmaltafac)
				else
					frmaltafac= conectar_db(_screen.cn)
						SQLEXEC(frmaltafac,"select MAX(artcli_codi) as artcli_codi from articulos_clientes order by artcli_codi;","cur_nvoarc")
						IF RECCOUNT("cur_nvoarc")>0
							c=cur_nvoarc.artcli_codi+1
						ELSE
							c=1				
						ENDIF
						SQLEXEC(frmaltafac,"insert into articulos_clientes values(?c,?codigo,?codicli,?texto);")
						SQLEXEC(frmaltafac,"select * from articulos_clientes where artcli_codi=?c;","cur_retorno")
						
						SQLEXEC(frmaltafac,"select MAX(dac_codi) as dac_codi from desc_articulos_clientes order by dac_codi;","cur_nvodif")
						IF RECCOUNT("cur_nvodif")>0
							c=cur_nvodif.dac_codi+1
						ELSE
							c=1	
						ENDIF
						SQLEXEC(frmaltafac,"insert into desc_articulos_clientes values(?c,?cur_retorno.artcli_codi,?texto);")
					desconectar_db(frmaltafac)
				endif
			case opcion2=6
				this.col=9
				this.text="NO"
				if thisform.text19.value>0
					dtopie=round((100-thisform.text19.value)/100,2)
					do case
						case cur_arti.art_alicuota=1
							impo1=impo1-(CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)
							if cond=2
								thisform.text9.value=thisform.text9.value-round((CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)*impiva1/100,2)
							else
								auxacuneto=acun1
								acun1=acun1-((CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)/(1+(impiva1/100)))
								acu1=acu1-(auxacuneto-acun1)*impiva1/100
							endif
						case cur_arti.art_alicuota=2
							impo2=impo2-(CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)
							if cond=2
								thisform.text11.value=thisform.text11.value-round((CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)*impiva2/100,2)
							else
								auxacuneto=acun2
								acun2=acun2-((CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)/(1+(impiva2/100)))
								acu2=acu2-(auxacuneto-acun2)*impiva2/100
							endif
					endcase
				else
					do case
						case cur_arti.art_alicuota=1
							impo1=impo1-CAST(STRTRAN(prtot,",",".") as N(15,2))
							if cond=2				
								thisform.text9.value=thisform.text9.value-round(CAST(STRTRAN(prtot,",",".") as N(15,2))*impiva1/100,2)
							else
								auxacuneto=acun1
								acun1=acun1-(CAST(STRTRAN(prtot,",",".") as N(15,2))/(1+(impiva1/100)))
								acu1=acu1-(auxacuneto-acun1)*impiva1/100
							endif
						case cur_arti.art_alicuota=2
							impo2=impo2-CAST(STRTRAN(prtot,",",".") as N(15,2))
							if cond=2
								thisform.text11.value=thisform.text11.value-round(CAST(STRTRAN(prtot,",",".") as N(15,2))*impiva2/100,2)
							else
								auxacuneto=acun2
								acun2=acun2-(CAST(STRTRAN(prtot,",",".") as N(15,2))/(1+(impiva2/100)))
								acu2=acu2-(auxacuneto-acun2)*impiva2/100
							endif
					endcase
				endif
				thisform.text10.value=thisform.text18.value+thisform.text9.value+thisform.text11.value
				opcion2=0
				localiz=0
			case opcion2=7
				this.col=9
				this.text="SI"
				if thisform.text19.value>0
					dtopie=round((100-thisform.text19.value)/100,2)
					do case
						case cur_arti.art_alicuota=1
							impo1=impo1+(CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)
							if cond=2
								thisform.text9.value=thisform.text9.value+round((CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)*impiva1/100,2)
							else
								auxacuneto=acun1
								acun1=acun1+((CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)/(1+(impiva1/100)))
								acu1=acu1+(acun1-auxacuneto)*impiva1/100
							endif
						case cur_arti.art_alicuota=2
							impo2=impo2+(CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)
							if cond=2
								thisform.text11.value=thisform.text11.value+round((CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)*impiva2/100,2)
							else
								auxacuneto=acun2
								acun2=acun2+((CAST(STRTRAN(prtot,",",".") as N(15,2))*dtopie)/(1+(impiva2/100)))
								acu2=acu2+(acun2-auxacuneto)*impiva2/100
							endif
					endcase
				else
					do case
						case cur_arti.art_alicuota=1
							impo1=impo1+CAST(STRTRAN(prtot,",",".") as N(15,2))
							if cond=2				
								thisform.text9.value=thisform.text9.value+round(CAST(STRTRAN(prtot,",",".") as N(15,2))*impiva1/100,2)
							else
								auxacuneto=acun1
								acun1=acun1+(CAST(STRTRAN(prtot,",",".") as N(15,2))/(1+(impiva1/100)))
								acu1=acu1+(acun1-auxacuneto)*impiva1/100
							endif
						case cur_arti.art_alicuota=2
							impo2=impo2+CAST(STRTRAN(prtot,",",".") as N(15,2))
							if cond=2
								thisform.text11.value=thisform.text11.value+round(CAST(STRTRAN(prtot,",",".") as N(15,2))*impiva2/100,2)
							else
								auxacuneto=acun2
								acun2=acun2+(CAST(STRTRAN(prtot,",",".") as N(15,2))/(1+(impiva2/100)))
								acu2=acu2+(acun2-auxacuneto)*impiva2/100
							endif
					endcase
				endif
				thisform.text10.value=thisform.text18.value+thisform.text9.value+thisform.text11.value
				localiz=0
		endcase
		if nitem<27
			on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		else
			on key label INS messagebox("No puede ingresar más Items a la factura"+chr(13)+ ;
			                            "Haga click en Terminar para imprimir y luego"+chr(13)+ ;
			                            "registre una nueva factura",0+48,"Advertencia")
		endif
		
	ENDPROC

	PROCEDURE grid1.GotFocus
		if localiz=1
			if elimi=0 and nitem>0
				thisform.grid1.toprow=nitem
			else
				elimi=0
			endif
		endif
	ENDPROC


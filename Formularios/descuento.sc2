DEFINE CLASS descuento AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label4" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text4" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label6" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 200,221,201
		BorderStyle = 0
		Caption = "Descuento a Ingresar"
		DoCreate = .T.
		Height = 131
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "DESCUENTO"
		Width = 498
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Label3' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 200,221,201, ;
		Caption = "DESCRIPCIÓN", ;
		FontBold = .T., ;
		ForeColor = 0,0,0, ;
		Height = 17, ;
		Left = 50, ;
		Name = "Label3", ;
		TabIndex = 3, ;
		Top = 38, ;
		Width = 80
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label4' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 200,221,201, ;
		Caption = "PORCENTAJE", ;
		FontBold = .T., ;
		ForeColor = 0,0,0, ;
		Height = 17, ;
		Left = 368, ;
		Name = "Label4", ;
		TabIndex = 4, ;
		Top = 39, ;
		Width = 79
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label6' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 200,221,201, ;
		Caption = "        Detalle del Descuento       ", ;
		FontBold = .T., ;
		ForeColor = 0,0,0, ;
		Height = 17, ;
		Left = 61, ;
		Name = "Label6", ;
		TabIndex = 5, ;
		Top = 11, ;
		Width = 170
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackColor = 67,135,135, ;
		BackStyle = 0, ;
		Height = 94, ;
		Left = 24, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;
		Top = 18, ;
		Width = 447
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Text3' AS textbox WITH ;
		Format = "!K", ;
		Height = 23, ;
		Left = 47, ;
		Name = "Text3", ;
		TabIndex = 1, ;
		Top = 61, ;
		Width = 306
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text4' AS textbox WITH ;
		Alignment = 1, ;
		Format = "K", ;
		Height = 23, ;
		InputMask = "###.### %", ;
		Left = 364, ;
		Name = "Text4", ;
		TabIndex = 2, ;
		Top = 61, ;
		Width = 84
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		store 1 to localiz,muestro
	ENDPROC

	PROCEDURE Destroy
		if last()=27
			muestro=0
			alternati="N"
		endif
	ENDPROC

	PROCEDURE Init
		parameter descri,porcdto
		this.text4.value=0
		alternati="S"
		if paso=1
			with this
				.text3.value=descri
				.text4.value=porcdto
				.SetAll("Format", "K", "Textbox")
			endwith
		endif
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Unload
		return descri
		return porcdto
	ENDPROC

	PROCEDURE Text4.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			descri=allt(thisform.text3.value)
			porcdto=thisform.text4.value
			thisform.release
		endif
		
	ENDPROC

ENDDEFINE

DEFINE CLASS llistpendproxpro AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Command3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="List2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command2" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 164,196,213
		BorderStyle = 0
		Caption = "Listado de Ordenes de Compra Pendientes de Proveedores"
		DataSession = 2
		DoCreate = .T.
		Height = 263
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "llistpendproxpro"
		Width = 545
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Previsualizar", ;
		DisabledBackColor = 33,146,214, ;
		Enabled = .F., ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 232, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 223, ;
		Width = 110
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command2' AS commandbutton WITH ;
		BackColor = 87,87,87, ;
		Caption = "\<Imprimir Pendientes", ;
		DisabledBackColor = 87,87,87, ;
		Enabled = .F., ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 61, ;
		Name = "Command2", ;
		Themes = .F., ;
		Top = 223, ;
		Width = 143
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command3' AS commandbutton WITH ;
		BackColor = 227,68,34, ;
		Cancel = .T., ;
		Caption = "\<Salir", ;
		DisabledBackColor = 227,68,34, ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 366, ;
		Name = "Command3", ;
		TabIndex = 4, ;
		Themes = .F., ;
		Top = 223, ;
		Width = 108
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 164,196,213, ;
		Caption = "    Proveedores con Pendientes de Entrega    ", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 48, ;
		Name = "Label1", ;
		TabIndex = 5, ;
		Top = 9, ;
		Width = 254
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'List2' AS listbox WITH ;
		BoundColumn = 2, ;
		ColumnCount = 2, ;
		ColumnWidths = "450,50", ;
		FontBold = .T., ;
		Height = 163, ;
		Left = 36, ;
		Name = "List2", ;
		TabIndex = 1, ;
		Top = 33, ;
		Width = 468
		*< END OBJECT: BaseClass="listbox" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackColor = 167,177,150, ;
		BackStyle = 0, ;
		BorderStyle = 1, ;
		Height = 196, ;
		Left = 18, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;
		Top = 15, ;
		Width = 507
		*< END OBJECT: BaseClass="shape" />
	
	PROCEDURE Init
		public codicli
		codicli=0
		set date british
		set cent on
		set deleted on
		with thisform
			frmlstpend= conectar_db(_screen.cn)
				SQLEXEC(frmlstpend,"select distinct b.prov_nomb,b.prov_codi from compras a inner join proveedores b on a.prov_codi=b.prov_codi where a.cumplido<>'S' and a.anulado<>'S' order by b.prov_nomb;","propen")
			desconectar_db(frmlstpend)
			IF RECCOUNT("propen")>0
				.list2.rowsourcetype=3
				.list2.rowsource="select * from propen INTO CURSOR list2"
			ENDIF
		endwith
	ENDPROC

	PROCEDURE Command1.Click
		frmpxpro= conectar_db(_screen.cn)
			SQLEXEC(frmpxpro,"call usp_pendxpro(?codiprov);","curpendpro")
		desconectar_db(frmpxpro)
		go top
		report form pendtotprov preview noconsole
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command2.Click
		frmpxpro= conectar_db(_screen.cn)
			SQLEXEC(frmpxpro,"call usp_pendxpro(?codiprov);","curpendpro")
		desconectar_db(frmpxpro)
		go top
		report form pendtotprov to printer prompt noconsole
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .T.
		this.FontSize=10
	ENDPROC

	PROCEDURE List2.Click
		for i=1 to this.listcount
			if this.selected(i)
				codiprov=val(this.value)
				thisform.command1.enabled=.T.
				thisform.command2.enabled=.T.
			endif
		next
		
		
	ENDPROC

	PROCEDURE List2.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			codiprov=val(this.value)
			thisform.command1.enabled=.T.
			thisform.command2.enabled=.T.
		endif
	ENDPROC

ENDDEFINE

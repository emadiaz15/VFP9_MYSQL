DEFINE CLASS perselec AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="List1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtperload" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 206,218,205
		BorderStyle = 0
		Caption = "Seleccione Proveedor de Servicio"
		DoCreate = .T.
		Height = 240
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "PERSELEC"
		Width = 322
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Nuevo Proveedor", ;
		DisabledBackColor = 33,146,214, ;
		ForeColor = 255,255,255, ;
		Height = 23, ;
		Left = 94, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 209, ;
		Width = 134
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'List1' AS listbox WITH ;
		FontBold = .T., ;
		Height = 156, ;
		Left = 26, ;
		Name = "List1", ;
		RowSource = "''", ;
		RowSourceType = 2, ;
		Top = 46, ;
		Width = 268
		*< END OBJECT: BaseClass="listbox" />

	ADD OBJECT 'txtperload' AS textbox WITH ;
		BackColor = 255,255,255, ;
		FontBold = .T., ;
		Format = "!", ;
		Height = 23, ;
		Left = 26, ;
		Name = "txtperload", ;
		TabIndex = 1, ;
		Top = 20, ;
		Width = 269
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		parameter codiper
		public f
		f=1
		frmperlo= conectar_db(_screen.cn)
			SQLEXEC(frmperlo,"call usp_buscarper(0);","cur_per")
		desconectar_db(frmperlo)
		GO top
		thisform.list1.RowSource="cur_per"
		if prompt()="Proveedores de Servicios"
			this.command1.visible=.F.
			this.height=222
		endif
	ENDPROC

	PROCEDURE Unload
		return codiper
	ENDPROC

	PROCEDURE Command1.Click
		codiper=0
		do form altaper with codiper
		if codiper>0
			thisform.list1.requery
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE List1.Click
		if this.selected(this.listindex)
			codiper=cur_per.per_codi
			thisform.release
		endif
		
	ENDPROC

	PROCEDURE List1.GotFocus
		if last()=24 or last()=5
			thisform.txtperload.setfocus
		endif
	ENDPROC

	PROCEDURE List1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			if this.selected(this.listindex)
				codiper=cur_per.per_codi
				thisform.release
			endif
		endif
		if nkeycode=27
			codiper=0
		endif
	ENDPROC

	PROCEDURE txtperload.InteractiveChange
		local lc
		lc = allt(This.Value)
		if last()<>127 and last()<>7
			do while !eof()
				if lc=subst(cur_per.per_desc,1,len(lc))
					exit
				else
					skip
					f=f+1
					if eof()
						go top
						f=1
						exit
					endif
				endif
			enddo
		else
			do while lc=subst(cur_per.per_desc,1,len(lc)) and f>1
				if bof()
					exit
				endif
				skip-1
				if f>1
					f=f-1
				endif
				if lc<>subst(cur_per.per_desc,1,len(lc))
					skip
					f=f+1
					exit
				endif
			enddo				
		endif
		thisform.list1.selected(f)=.T.
		return
		
	ENDPROC

	PROCEDURE txtperload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
				codiper=cur_per.per_codi
				thisform.release
			case last()=5
				if f>1
					f=f-1
				endif
				thisform.list1.selected(f)=f
				this.value=thisform.list1.value
			case last()=24
				if f<thisform.list1.listcount
					f=f+1
				endif
				thisform.list1.selected(f)=f
				this.value=thisform.list1.value
			case last()=27
				codiper=0
				thisform.release
		endcase
	ENDPROC

ENDDEFINE

	PROCEDURE calc_historicos
		LOCAL fecdes,fechas,anodes,mesdes,diades,anohas,meshas,diahas
		
		anodes=YEAR(thisform.text1.Value)
		mesdes=MONTH(thisform.text1.Value)
		diades=DAY(thisform.text1.Value)
		
		anohas=YEAR(thisform.text2.Value)
		meshas=MONTH(thisform.text2.Value)
		diahas=DAY(thisform.text2.Value)
		
		fecdes=DATETIME(anodes,mesdes,diades,00,00,00)
		fechas=DATETIME(anohas,meshas,diahas,23,59,59)
		thisform.grid1.RecordSource=''
		thisform.grid1.Refresh()
		
		frmhistoc= conectar_db(_screen.cn)
			SQLEXEC(frmhistoc,"select * from parametros where param_codi=14;","cur_cotpar")
			SQLEXEC(frmhistoc,"select hiscot_fecha,hiscot_impo from histocoti where hiscot_fecha between ?fecdes and ?fechas order by hiscot_fecha desc;","cur_historico")
		desconectar_db(frmhistoc)
		
		IF RECCOUNT("cur_cotpar")>0
			thisform.lbll_ultic.Caption="ULTIMA ACTUALIZACIÓN "+TTOC(cur_cotpar.param_fechora)+" - (U$S 1 = $ "+ALLTRIM(STR(cur_cotpar.param_impo,14,2))+")"
		ENDIF
		
		IF RECCOUNT("cur_historico")>0
			GO top
			thisform.grid1.RecordSource="cur_historico"
			thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS fecin
		thisform.txt_fecha.Value=DATE()
		thisform.text1.value=fecin
		thisform.text2.value=date()
		
		thisform.calc_historicos()
		
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(205,205,205)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Command1.Click
		thisform.calc_historicos()
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.

	*< OBJECTDATA: ObjPath="btn_cancel" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="btn_cont" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: npres
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		BorderStyle = 0
		Caption = "Búsqueda Numérica de Presupuestos"
		Closable = .F.
		DoCreate = .T.
		Height = 211
		Icon = ..\imagen\vbe7_1251.ico
		MaxButton = .F.
		MinButton = .F.
		Name = "NUMPRESLOAD"
		npres = 0
		Width = 557
	*</PropValue>

	ADD OBJECT 'btn_cancel' AS commandbutton WITH ;
		BackColor = 227,68,34, ;
		Caption = "Ca\<ncelar", ;
		ForeColor = 255,255,255, ;
		Height = 30, ;
		Left = 154, ;
		Name = "btn_cancel", ;
		TabIndex = 7, ;
		Themes = .F., ;
		Top = 168, ;
		Width = 108
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'btn_cont' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "Con\<tinuar", ;
		DisabledBackColor = 33,146,214, ;
		Enabled = .F., ;
		ForeColor = 255,255,255, ;
		Height = 30, ;
		Left = 295, ;
		Name = "btn_cont", ;
		TabIndex = 8, ;
		Themes = .F., ;
		Top = 168, ;
		Width = 108
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;

		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'txt_cliente' AS textbox WITH ;
		FontBold = .T., ;
		FontSize = 11, ;
		Height = 24, ;
		Left = 90, ;
		Name = "txt_cliente", ;
		Style = 1, ;
		TabIndex = 6, ;
		Top = 127, ;
		Width = 443
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txt_fecha' AS textbox WITH ;
		Alignment = 2, ;
		DateFormat = 3, ;
		FontBold = .T., ;
		FontSize = 11, ;
		Height = 24, ;
		Left = 90, ;
		Name = "txt_fecha", ;
		Style = 1, ;
		TabIndex = 4, ;
		Top = 100, ;
		Width = 96
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txt_npres' AS textbox WITH ;
		FontBold = .T., ;
		FontSize = 17, ;
		Format = "LK", ;
		Height = 34, ;
		InputMask = "########", ;
		Left = 393, ;
		Name = "txt_npres", ;
		TabIndex = 2, ;
		Top = 21, ;
		Width = 141
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		SET NOTIFY off
		thisform.txt_npres.Value=0
		thisform.txt_fecha.Value=''
		thisform.txt_cliente.Value=''
	ENDPROC

	PROCEDURE btn_cancel.Click
		thisform.Release
		
	ENDPROC

	PROCEDURE btn_cancel.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE btn_cancel.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE btn_cont.Click
		thisform.txt_npres.SetFocus
		LOCAL xpres
		xpres = thisform.npres
		DO case
			CASE _screen.estapres=1
				DO FORM conspresup WITH xpres,cond
			CASE _screen.estapres=2
				frmnpres= conectar_db(_screen.cn)
					SQLEXEC(frmnpres,"select * from pedidos where presup_codi=?xpres;","cur_yaesta")
				desconectar_db(frmnpres)
				IF RECCOUNT("cur_yaesta")>0
					pregn=MESSAGEBOX("Este presupuesto ya fue confirmado por el Cliente total o parcialmente con el número "+ALLTRIM(STR(cur_yaesta.ped_codi))+" el día "+ALLTRIM(DTOC(cur_yaesta.ped_fech))+"."+CHR(13)+chr(13)+;
									 "¿Continúa Igualente?",4+48+256,"Aviso del Sistema")
					IF pregn=6
						do form selecitem with xpres,cond,codicli
						cerrar_cursor("cur_yaesta")
						thisform.release
					ELSE
						cerrar_cursor("cur_yaesta")
						KEYBOARD '{TAB}'+'{TAB}'
					ENDIF
				ELSE
					do form selecitem with xpres,cond,codicli
					cerrar_cursor("cur_yaesta")
					thisform.release
				ENDIF
			CASE _screen.estapres=3
				do form modipresup with xpres,cond
				thisform.release
		ENDCASE
		
	ENDPROC

	PROCEDURE btn_cont.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE btn_cont.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE txt_npres.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE txt_npres.Valid
		IF this.Value>0
			frmnpres= conectar_db(_screen.cn)
				SQLEXEC(frmnpres,"select a.*,b.cli_nomb,b.cond_codi from presupuestos a inner join clientes b on a.cli_codi=b.cli_codi where a.presup_codi=?this.value;","cur_presn")
			desconectar_db(frmnpres)
			IF RECCOUNT("cur_presn")>0
				thisform.txt_fecha.Value   =cur_presn.presup_fech
				thisform.txt_cliente.Value =cur_presn.cli_nomb
				thisform.npres=cur_presn.presup_codi
				cond=cur_presn.cond_codi
				codicli=cur_presn.cli_codi
				thisform.btn_cont.Enabled= .T.
				KEYBOARD '{TAB}'
			ELSE
				MESSAGEBOX("Presupuesto no se encuentra en archivo.",0+48,"Aviso del Sistema")
				thisform.btn_cont.Enabled= .F.
				this.Value=0
				return .F.
			ENDIF
		ENDIF
		
	ENDPROC

ENDDEFINE

		Style = 1, ;
		Top = 435, ;
		Width = 133
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		SET POINT TO thisformset.xpunto
		SET SEPARATOR TO thisformset.xsepa
	ENDPROC

	PROCEDURE Init
		PUBLIC dins
		
		SET DELETED ON
		thisformset.xpunto = SYS(2001,"point")
		thisformset.xsepa = SYS(2001,"separator")
		
		SET POINT TO
		SET SEPARATOR TO
		
		dins=1
		
		CREATE CURSOR insumos(insu_codi N(8),insu_desc C(45),insu_cant N(15,3),insu_costo N(15,3),insu_total N(15,3))
		
		frminsulo= conectar_db(_screen.cn)
			SQLEXEC(frminsulo,"select insu_codi,insu_desc,insu_unimed,insu_costo from insumos order by insu_desc;","cur_insu")
		desconectar_db(frminsulo)
		
		thisformset.frm_principal.txt_total.Refresh
		
		thisformset.frm_insuload.lstinsu.RowSource="cur_insu"
		thisformset.frm_insuload.lstinsu.Refresh
		
		Thisformset.frm_principal.grd_insumos.column4.DynamicInputMask = [('USD 999,999,999.999')]
		Thisformset.frm_principal.grd_insumos.column5.DynamicInputMask = [('USD 999,999,999.99')]
		
		thisformset.frm_principal.txt_codart.Value=0
		thisformset.frm_principal.txt_descart.Value=''
		thisformset.frm_insumos.txt_codinsu.Value=0
		thisformset.frm_insumos.txt_descinsu.Value=''
		thisformset.frm_insumos.txt_caninsu.Value=0
		
		thisformset.frm_principal.grd_insumos.RecordSource="insumos"
		thisformset.frm_principal.grd_insumos.Refresh
	ENDPROC

	PROCEDURE frm_insuload.lstinsu.Click
		thisformset.xcodinsu=cur_insu.insu_codi
		thisformset.xdescinsu=ALLTRIM(cur_insu.insu_desc)
		if last()!=24 AND last()!=5
			thisformset.frm_insumos.txt_codinsu.Value=thisformset.xcodinsu
			thisformset.frm_insumos.txt_descinsu.Value=thisformset.xdescinsu
			thisformset.frm_insumos.txt_caninsu.SetFocus
			thisformset.frm_insuload.AlwaysOnBottom= .T.
			thisformset.frm_insuload.Visible= .F.
			thisformset.frm_insumos.AlwaysOnBottom= .F.
			thisformset.frm_insumos.Enabled= .T.
		ENDIF
	ENDPROC

	PROCEDURE frm_insuload.lstinsu.GotFocus
		if last()=24 or last()=5
			thisform.txt_insuload.setfocus
		endif
	ENDPROC

	PROCEDURE frm_insuload.lstinsu.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		ENDIF
		IF nkeycode=13
			thisformset.xcodinsu=cur_insu.insu_codi
			thisformset.xdescinsu=ALLTRIM(cur_insu.insu_desc)
			thisformset.frm_insumos.txt_codinsu.Value=thisformset.xcodinsu
			thisformset.frm_insumos.txt_descinsu.Value=thisformset.xdescinsu
			thisformset.frm_insuload.txt_insuload.Value = ''
			thisformset.frm_insumos.txt_caninsu.SetFocus	
			thisformset.frm_insuload.AlwaysOnBottom= .T.
			thisformset.frm_insuload.Visible= .F.
			thisformset.frm_insumos.AlwaysOnBottom= .F.
			thisformset.frm_insumos.Enabled= .T.
		ENDIF
	ENDPROC

	PROCEDURE frm_insuload.txt_insuload.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE frm_insuload.txt_insuload.InteractiveChange
		if subst(allt(this.value),1,1)="?"
			SELECT cur_insu
			SET FILTER TO
		endif
		if subst(allt(this.value),1,1)!="?"
			SELECT cur_insu
			local lc
			lc = allt(This.Value)
			if last()<>127 and last()<>7
				do while !eof()
					if lc=subst(ALLTRIM(cur_insu.insu_desc),1,len(lc))
						exit
					else
						skip
						dins=dins+1
						if eof()
							go top
							dins=1
							exit
						endif
					endif
				enddo
			ELSE
				do while lc=subst(ALLTRIM(cur_insu.insu_desc),1,len(lc)) and dins>1
					if bof()
						exit
					endif
					skip-1
					if dins>1
						dins=dins-1
					endif
					if lc<>subst(ALLTRIM(cur_insu.insu_desc),1,len(lc))
						skip
						dins=dins+1
						exit
					endif
				enddo				
			endif
			thisform.lstinsu.selected(dins)=.T.
		endif
		return
		
	ENDPROC

	PROCEDURE frm_insuload.txt_insuload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
				if subst(allt(this.value),1,1)="?"
					cade=ALLTRIM(subst(allt(this.value),2,len(allt(this.value))))
					set filter to atcline(cade,ALLTRIM(cur_insu.insu_desc))!=0
				else
					thisformset.xcodinsu=cur_insu.insu_codi
					thisformset.xdescinsu=ALLTRIM(cur_insu.insu_desc)
					this.Value = ''
					thisformset.frm_insumos.txt_codinsu.Value=thisformset.xcodinsu
					thisformset.frm_insumos.txt_descinsu.Value=thisformset.xdescinsu
					thisformset.frm_insumos.txt_caninsu.SetFocus
					thisformset.frm_insuload.AlwaysOnBottom= .T.
					thisformset.frm_insuload.Visible= .F.
					thisformset.frm_insumos.AlwaysOnBottom= .F.
					thisformset.frm_insumos.Enabled= .T.
				endif
			case last()=5
				if dins>1
					dins=dins-1
				endif
				thisform.lstinsu.selected(dins)=dins
				this.value=thisform.lstinsu.value
			case last()=24
				if dins<thisform.lstinsu.listcount
					dins=dins+1
				endif
				thisform.lstinsu.selected(dins)=dins
				this.value=thisform.lstinsu.value
			case last()=27
				this.Value = ''
				thisformset.frm_insuload.AlwaysOnBottom= .T.
				thisformset.frm_insuload.Visible= .F.
				thisformset.frm_insumos.AlwaysOnBottom= .F.
				thisformset.frm_insumos.Enabled= .T.
		endcase
	ENDPROC

	PROCEDURE frm_insuload.txt_insuload.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE frm_insumos.Boton_return1.btn.Click
		thisformset.frm_insumos.AlwaysOnBottom= .T.
		thisformset.frm_insumos.Visible= .F.
		
		thisformset.frm_principal.AlwaysOnBottom= .F.
		thisformset.frm_principal.Enabled= .T.
		thisformset.frm_principal.txt_codart.SetFocus
	ENDPROC

	PROCEDURE frm_insumos.Command1.Click
		thisformset.xcodinsu=0
		thisformset.xdescinsu=''
		dins=1
		thisformset.frm_insuload.lstinsu.selected(dins)=.F.
		SELECT cur_insu
		SET FILTER TO
		GO TOP IN cur_insu
		thisformset.frm_insuload.lstinsu.Refresh
		thisformset.frm_insuload.lstinsu.SetFocus
		thisformset.frm_insuload.txt_insuload.SetFocus
		thisformset.frm_insumos.AlwaysOnBottom= .T.
		thisformset.frm_principal.AlwaysOnBottom= .T.
		thisformset.frm_insumos.Enabled= .F.
		thisformset.frm_principal.Enabled= .F.
		thisformset.frm_insuload.AlwaysOnBottom= .F.
		thisformset.frm_insuload.Visible= .T.
		thisformset.frm_insuload.txt_insuload.SetFocus
		
	ENDPROC

	PROCEDURE frm_insumos.Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE frm_insumos.Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE frm_insumos.txt_caninsu.Click
		this.setfocus
	ENDPROC

	PROCEDURE frm_insumos.txt_caninsu.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		&& insu_codi N(8),insu_desc C(45),insu_cant N(15,3),insu_costo N(15,3),insu_total N(15,3)
		
		IF nKeyCode = 13
			INSERT INTO insumos VALUES ;
				(cur_insu.insu_codi,cur_insu.insu_desc,this.Value,cur_insu.insu_costo,ROUND(this.Value*cur_insu.insu_costo,2))
			
			thisformset.xcostot = thisformset.xcostot + ROUND(this.Value*cur_insu.insu_costo,2)
			thisformset.frm_principal.txt_total.Refresh	
				
			thisform.txt_codinsu.Value=0
			thisform.txt_descinsu.Value=''
			thisform.txt_caninsu.Value=0
			
			thisformset.frm_insumos.AlwaysOnBottom= .T.
			thisformset.frm_insumos.Visible= .F.
		
			thisformset.frm_principal.AlwaysOnBottom= .F.
			thisformset.frm_principal.Enabled= .T.
			thisformset.frm_principal.grd_insumos.Refresh
			thisformset.frm_principal.grd_insumos.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE frm_insumos.txt_codinsu.Click
		this.setfocus
	ENDPROC

	PROCEDURE frm_insumos.txt_codinsu.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		CREATE CURSOR codaux(art_codi N(8))
		LOCAL xcc
		SET DECIMALS TO 3
		do case
			CASE nkeycode=13
				if this.value<>0
					xcc=this.value
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?this.value;","cur_arti")
					desconectar_db(frmcart)
					if RECCOUNT("cur_arti")>0
						if cur_arti.art_codi<>4 AND cur_arti.art_codi<>5
							with thisform
								.lbl_prov.caption=''
								.grd_costos.HighlightStyle= 1
								.grd_costos.recordsource=''
								.grd_costos.refresh()
								.text1.value=cur_arti.art_codi
								.text2.value=cur_arti.art_desc
								.text3.value=cur_arti.art_stock
								.text15.value=cur_arti.art_stmin
								.text16.value=iif(cur_arti.art_alicuota=1,impiva1,impiva2)
								.text4.value=cur_arti.pedidos
								.text5.value=cur_arti.pedprov
								.text6.value=cur_arti.art_stock+.text5.value-.text4.value
								do case
									case cur_arti.art_med="UN"
										.optiongroup1.value=1
									case cur_arti.art_med="MT"
										.optiongroup1.value=2
									case cur_arti.art_med="KG"
										.optiongroup1.value=3
								endcase
								.text7.value=cur_arti.art_precio
								.edit1.value=cur_arti.art_deta
								.edit2.value=cur_arti.art_detaofi
								thisform.verdetalles()
								.text8.value=ALLTRIM(STR(cur_arti.rub_codi))+" - "+ALLTRIM(cur_arti.rub_desc)
								.text13.value=cur_arti.costo_ultcpra
								SET DECIMALS TO 3
								frmcart= conectar_db(_screen.cn)
									SQLEXEC(frmcart,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
									IF RECCOUNT("provc")>0
										thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
									ENDIF
									IF thisform.chk_todos.Value=0
										SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
									ELSE
										SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
									ENDIF
								desconectar_db(frmcart)
								SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
								GO top
								IF RECCOUNT("tmpc")>0
									thisform.chk_todos.Enabled= .T.
								ENDIF
								.grd_costos.recordsource="tmpc"
								.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista,tmpc.cotiz)","Column")
								.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
								.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")
								SET DECIMALS TO
								.text9.enabled=.T.
								.text10.enabled=.T.
								.label17.caption=""
								.text11.value=0
								.text12.value=0
								.grid1.recordsource=""
								.grid1.refresh()
							endwith
						endif
					else
						messagebox("Artículo no está en archivo",0+48,"Advertencia")
						this.value=0
						return 0
					endif
				endif	
			case nkeycode=19 or nkeycode=24
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select art_codi from articulos where art_codi<?this.value and art_codi<>4 and art_codi<>5 order by art_codi desc limit 1;","cur_inter")
					IF RECCOUNT()>0
						INSERT INTO codaux values(cur_inter.art_codi)
					ENDIF
				desconectar_db(frmcart)
				SELECT codaux
				IF RECCOUNT()>0
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?codaux.art_codi;","cur_arti")
					desconectar_db(frmcart)													
					with thisform
						xcc=cur_arti.art_codi
						.lbl_prov.caption=''
						.grd_costos.HighlightStyle= 1
						.grd_costos.recordsource=""
						.grd_costos.refresh
						.text1.value=cur_arti.art_codi
						.text2.value=cur_arti.art_desc
						.text3.value=cur_arti.art_stock
						.text15.value=cur_arti.art_stmin
						.text16.value=iif(cur_arti.art_alicuota=1,impiva1,impiva2)
						.text4.value=cur_arti.pedidos
						.text5.value=cur_arti.pedprov
						.text6.value=cur_arti.art_stock+.text5.value-.text4.value
						do case
							case cur_arti.art_med="UN"
								.optiongroup1.value=1
							case cur_arti.art_med="MT"
								.optiongroup1.value=2
							case cur_arti.art_med="KG"
								.optiongroup1.value=3
						endcase
						.text7.value=cur_arti.art_precio
						.edit1.value=cur_arti.art_deta
						.edit2.value=cur_arti.art_detaofi
						thisform.verdetalles()
						.text8.value=ALLTRIM(STR(cur_arti.rub_codi))+" - "+ALLTRIM(cur_arti.rub_desc)
						.text13.value=cur_arti.costo_ultcpra
						SET DECIMALS TO 3
						frmcart= conectar_db(_screen.cn)
							SQLEXEC(frmcart,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
							IF RECCOUNT("provc")>0
								thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
							ENDIF				
							IF thisform.chk_todos.Value=0
								SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
							ELSE
								SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
							ENDIF
						desconectar_db(frmcart)
						SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
						GO top
						IF RECCOUNT("tmpc")>0
							thisform.chk_todos.Enabled= .T.
						ENDIF
						.grd_costos.recordsource="tmpc"
		*!*					.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista)","Column")
		*!*					.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
		*!*					.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")				
						SET DECIMALS TO
						.text9.enabled=.T.
						.text10.enabled=.T.
						.label17.caption=""
						.text11.value=0
						.text12.value=0
						.grid1.recordsource=""
					ENDWITH
					NODEFAULT
					this.Refresh()
					this.setfocus
				ENDIF
			case nkeycode=4 or nkeycode=5
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select art_codi from articulos where art_codi>?this.value order by art_codi limit 1;","cur_inter")
					IF RECCOUNT()>0
						INSERT INTO codaux values(cur_inter.art_codi)
					ENDIF
				desconectar_db(frmcart)
				SELECT codaux
				IF RECCOUNT()>0
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?codaux.art_codi;","cur_arti")
					desconectar_db(frmcart)				
					with thisform
						xcc=cur_arti.art_codi
						.lbl_prov.caption=''
						.grd_costos.HighlightStyle= 1
						.grd_costos.recordsource=""
						.grd_costos.refresh
						.text1.value=cur_arti.art_codi
						.text2.value=cur_arti.art_desc
						.text3.value=cur_arti.art_stock
						.text15.value=cur_arti.art_stmin
						.text16.value=iif(cur_arti.art_alicuota=1,impiva1,impiva2)
						.text4.value=cur_arti.pedidos
						.text5.value=cur_arti.pedprov
						.text6.value=cur_arti.art_stock+.text5.value-.text4.value
						do case
							case cur_arti.art_med="UN"
								.optiongroup1.value=1
							case cur_arti.art_med="MT"
								.optiongroup1.value=2
							case cur_arti.art_med="KG"
								.optiongroup1.value=3
						endcase
						.text7.value=cur_arti.art_precio
						.edit1.value=cur_arti.art_deta
						.edit2.value=cur_arti.art_detaofi
						thisform.verdetalles()
						.text8.value=ALLTRIM(STR(cur_arti.rub_codi))+" - "+ALLTRIM(cur_arti.rub_desc)
						.text13.value=cur_arti.costo_ultcpra
						SET DECIMALS TO 3
						frmcart= conectar_db(_screen.cn)
							SQLEXEC(frmcart,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
							IF RECCOUNT("provc")>0
								thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
							ENDIF				
							IF thisform.chk_todos.Value=0
								SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
							ELSE
								SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
							ENDIF
						desconectar_db(frmcart)
						SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
						GO top
						IF RECCOUNT("tmpc")>0
							thisform.chk_todos.Enabled= .T.
						ENDIF
						.grd_costos.recordsource="tmpc"
		*!*					.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista)","Column")
		*!*					.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
		*!*					.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")				
						SET DECIMALS TO
						.text9.enabled=.T.
						.text10.enabled=.T.
						.label17.caption=""
						.text11.value=0
						.text12.value=0
						.grid1.recordsource=""
						KEYBOARD '{TAB}'
					ENDWITH
					NODEFAULT
					this.Refresh()
					this.setfocus
				ELSE
					KEYBOARD '{TAB}'
				ENDIF
		ENDCASE
		SET DECIMALS TO
		
		
	ENDPROC

	PROCEDURE frm_principal.btn_add.img_add.Click
		thisformset.frm_principal.AlwaysOnBottom= .T.
		thisformset.frm_principal.Enabled= .F.
		
		thisformset.frm_insumos.AlwaysOnBottom= .F.
		thisformset.frm_insumos.Visible= .T.
	ENDPROC

	PROCEDURE frm_principal.btn_del.img_del.Click
		IF RECCOUNT("cur_insu")>0
			LOCAL xinsu,xcosto
			xinsu = insumos.insu_codi
			xcosto = insumos.insu_total
			DELETE FROM insumos WHERE insu_codi = xinsu
			thisformset.xcostot = thisformset.xcostot - xcosto
			thisform.grd_insumos.Refresh
			thisform.txt_total.Refresh
		ENDIF
		
	ENDPROC

	PROCEDURE frm_principal.btn_salir.Click
		thisformset.release
	ENDPROC

	PROCEDURE frm_principal.btn_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE frm_principal.btn_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE frm_principal.Command1.Click
		SET DECIMALS TO 3
		LOCAL xcc
		codigo=0
		thisform.txt_codart.value=0
		IF RECCOUNT("insumos")>0
			opins=MESSAGEBOX("Ya está en proceso la configuración de un artículo de producción, si busca otro artículo para configurar se perderan los datos hasta ahora consignados." +CHR(13)+CHR(13)+ ;
						     "¿Procede igualmente?",4+48+256,"Aviso del Sistema")
			IF opins=6
				DELETE FROM insumos
				thisform.txt_codart.Value=0
				thisform.txt_descart.Value=''
				thisform.txt_total.Value=0
				thisform.grd_insumos.Refresh
				do form artload with codigo
				if codigo>0
					with thisform
						frmcart= conectar_db(_screen.cn)
							SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?codigo;","cur_arti")
						desconectar_db(frmcart)
						thisform.txt_codart.Value=cur_arti.art_codi
						thisform.txt_descart.Value=cur_arti.art_desc
						thisform.btn_add.img_add.Enabled= .T.
						thisform.btn_del.img_del.Enabled= .T.
						thisform.grd_insumos.Enabled= .T.
					ENDWITH
				ELSE
					thisform.txt_codart.Value=0
					thisform.txt_descart.Value=''
					thisform.btn_add.img_add.Enabled= .F.
					thisform.btn_del.img_del.Enabled= .F.
					thisform.grd_insumos.RecordSource=''
					thisform.grd_insumos.Refresh
					thisform.grd_insumos.Enabled= .F.
				ENDIF
				SET DECIMALS TO
				thisform.txt_codart.setfocus
			ENDIF
		ELSE
			do form artload with codigo
			if codigo>0
				with thisform
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?codigo;","cur_arti")
					desconectar_db(frmcart)
					thisform.txt_codart.Value=cur_arti.art_codi
					thisform.txt_descart.Value=cur_arti.art_desc
					thisform.btn_add.img_add.Enabled= .T.
					thisform.btn_del.img_del.Enabled= .T.
					thisform.grd_insumos.Enabled= .T.
				ENDWITH
			ELSE
				thisform.txt_codart.Value=0
				thisform.txt_descart.Value=''
				thisform.btn_add.img_add.Enabled= .F.
				thisform.btn_del.img_del.Enabled= .F.
				thisform.grd_insumos.RecordSource=''
				thisform.grd_insumos.Refresh
				thisform.grd_insumos.Enabled= .F.
			ENDIF
			SET DECIMALS TO
			thisform.txt_codart.setfocus
		ENDIF
	ENDPROC

	PROCEDURE frm_principal.Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE frm_principal.Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE frm_principal.Command2.Click
		IF thisform.txt_total.Value>0
			LOCAL xfecha,xcodin,xcanins,xcade
			xfecha=DATETIME()
			SELECT insumos
			LOCATE
			SCAN
				xcodin =insumos.insu_codi
				xcanins=insumos.insu_cant
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(cn,"insert into insu_articulos values(null,?xcodin,?thisform.txt_codart.value,?xcanins,?xfecha,1);")
				desconectar_db(frmcart)
			ENDSCAN
			&& Ilumet código proveedor: 778
			xcade=ALLTRIM(STR(778))+ALLTRIM(STR(thisform.txt_codart.Value))
			frmcart= conectar_db(_screen.cn)
				SQLEXEC(frmcart,"select * from articulos_proveedores where CONCAT(TRIM(prov_codi),TRIM(art_codi))=?xcade;","cur_arprod")
			desconectar_db(frmcart)
			IF RECCOUNT("cur_arprod")>0
				&& insu_codi N(8),insu_desc C(45),insu_cant N(15,3),insu_costo N(15,3),insu_total N(15,3)
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"update articulos_proveedores set artpro_costo=?thisform.txt_total.Value,artpro_ctovta=?ROUND(thisform.txt_total.Value/0.95,3) where artpro_codi=?cur_arprod.artpro_codi;")
				desconectar_db(frmcart)
			ENDIF
			thisformset.Release
		ENDIF
		
	ENDPROC

	PROCEDURE frm_principal.Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE frm_principal.Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE frm_principal.txt_codart.Click
		this.setfocus
	ENDPROC

	PROCEDURE frm_principal.txt_codart.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		CREATE CURSOR codaux(art_codi N(8))
		LOCAL xcc
		SET DECIMALS TO 3
		do case
			CASE nkeycode=13
				if this.value<>0
					xcc=this.value
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?this.value;","cur_arti")
					desconectar_db(frmcart)
					if RECCOUNT("cur_arti")>0
						if cur_arti.art_codi<>4 AND cur_arti.art_codi<>5
							with thisform
								.lbl_prov.caption=''
								.grd_costos.HighlightStyle= 1
								.grd_costos.recordsource=''
								.grd_costos.refresh()
								.text1.value=cur_arti.art_codi
								.text2.value=cur_arti.art_desc
								.text3.value=cur_arti.art_stock
								.text15.value=cur_arti.art_stmin
								.text16.value=iif(cur_arti.art_alicuota=1,impiva1,impiva2)
								.text4.value=cur_arti.pedidos
								.text5.value=cur_arti.pedprov
								.text6.value=cur_arti.art_stock+.text5.value-.text4.value
								do case
									case cur_arti.art_med="UN"
										.optiongroup1.value=1
									case cur_arti.art_med="MT"
										.optiongroup1.value=2
									case cur_arti.art_med="KG"
										.optiongroup1.value=3
								endcase
								.text7.value=cur_arti.art_precio
								.edit1.value=cur_arti.art_deta
								.edit2.value=cur_arti.art_detaofi
								thisform.verdetalles()
								.text8.value=ALLTRIM(STR(cur_arti.rub_codi))+" - "+ALLTRIM(cur_arti.rub_desc)
								.text13.value=cur_arti.costo_ultcpra
								SET DECIMALS TO 3
								frmcart= conectar_db(_screen.cn)
									SQLEXEC(frmcart,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
									IF RECCOUNT("provc")>0
										thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
									ENDIF
									IF thisform.chk_todos.Value=0
										SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
									ELSE
										SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
									ENDIF
								desconectar_db(frmcart)
								SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
								GO top
								IF RECCOUNT("tmpc")>0
									thisform.chk_todos.Enabled= .T.
								ENDIF
								.grd_costos.recordsource="tmpc"
								.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista,tmpc.cotiz)","Column")
								.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
								.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")
								SET DECIMALS TO
								.text9.enabled=.T.
								.text10.enabled=.T.
								.label17.caption=""
								.text11.value=0
								.text12.value=0
								.grid1.recordsource=""
								.grid1.refresh()
							endwith
						endif
					else
						messagebox("Artículo no está en archivo",0+48,"Advertencia")
						this.value=0
						return 0
					endif
				endif	
			case nkeycode=19 or nkeycode=24
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select art_codi from articulos where art_codi<?this.value and art_codi<>4 and art_codi<>5 order by art_codi desc limit 1;","cur_inter")
					IF RECCOUNT()>0
						INSERT INTO codaux values(cur_inter.art_codi)
					ENDIF
				desconectar_db(frmcart)
				SELECT codaux
				IF RECCOUNT()>0
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?codaux.art_codi;","cur_arti")
					desconectar_db(frmcart)													
					with thisform
						xcc=cur_arti.art_codi
						.lbl_prov.caption=''
						.grd_costos.HighlightStyle= 1
						.grd_costos.recordsource=""
						.grd_costos.refresh
						.text1.value=cur_arti.art_codi
						.text2.value=cur_arti.art_desc
						.text3.value=cur_arti.art_stock
						.text15.value=cur_arti.art_stmin
						.text16.value=iif(cur_arti.art_alicuota=1,impiva1,impiva2)
						.text4.value=cur_arti.pedidos
						.text5.value=cur_arti.pedprov
						.text6.value=cur_arti.art_stock+.text5.value-.text4.value
						do case
							case cur_arti.art_med="UN"
								.optiongroup1.value=1
							case cur_arti.art_med="MT"
								.optiongroup1.value=2
							case cur_arti.art_med="KG"
								.optiongroup1.value=3
						endcase
						.text7.value=cur_arti.art_precio
						.edit1.value=cur_arti.art_deta
						.edit2.value=cur_arti.art_detaofi
						thisform.verdetalles()
						.text8.value=ALLTRIM(STR(cur_arti.rub_codi))+" - "+ALLTRIM(cur_arti.rub_desc)
						.text13.value=cur_arti.costo_ultcpra
						SET DECIMALS TO 3
						frmcart= conectar_db(_screen.cn)
							SQLEXEC(frmcart,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
							IF RECCOUNT("provc")>0
								thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
							ENDIF				
							IF thisform.chk_todos.Value=0
								SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
							ELSE
								SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
							ENDIF
						desconectar_db(frmcart)
						SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
						GO top
						IF RECCOUNT("tmpc")>0
							thisform.chk_todos.Enabled= .T.
						ENDIF
						.grd_costos.recordsource="tmpc"
		*!*					.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista)","Column")
		*!*					.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
		*!*					.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")				
						SET DECIMALS TO
						.text9.enabled=.T.
						.text10.enabled=.T.
						.label17.caption=""
						.text11.value=0
						.text12.value=0
						.grid1.recordsource=""
					ENDWITH
					NODEFAULT
					this.Refresh()
					this.setfocus
				ENDIF
			case nkeycode=4 or nkeycode=5
				frmcart= conectar_db(_screen.cn)
					SQLEXEC(frmcart,"select art_codi from articulos where art_codi>?this.value order by art_codi limit 1;","cur_inter")
					IF RECCOUNT()>0
						INSERT INTO codaux values(cur_inter.art_codi)
					ENDIF
				desconectar_db(frmcart)
				SELECT codaux
				IF RECCOUNT()>0
					frmcart= conectar_db(_screen.cn)
						SQLEXEC(frmcart,"select a.*,b.rub_desc from articulos as a inner join rubros as b on a.rub_codi=b.rub_codi where a.art_codi=?codaux.art_codi;","cur_arti")
					desconectar_db(frmcart)				
					with thisform
						xcc=cur_arti.art_codi
						.lbl_prov.caption=''
						.grd_costos.HighlightStyle= 1
						.grd_costos.recordsource=""
						.grd_costos.refresh
						.text1.value=cur_arti.art_codi
						.text2.value=cur_arti.art_desc
						.text3.value=cur_arti.art_stock
						.text15.value=cur_arti.art_stmin
						.text16.value=iif(cur_arti.art_alicuota=1,impiva1,impiva2)
						.text4.value=cur_arti.pedidos
						.text5.value=cur_arti.pedprov
						.text6.value=cur_arti.art_stock+.text5.value-.text4.value
						do case
							case cur_arti.art_med="UN"
								.optiongroup1.value=1
							case cur_arti.art_med="MT"
								.optiongroup1.value=2
							case cur_arti.art_med="KG"
								.optiongroup1.value=3
						endcase
						.text7.value=cur_arti.art_precio
						.edit1.value=cur_arti.art_deta
						.edit2.value=cur_arti.art_detaofi
						thisform.verdetalles()
						.text8.value=ALLTRIM(STR(cur_arti.rub_codi))+" - "+ALLTRIM(cur_arti.rub_desc)
						.text13.value=cur_arti.costo_ultcpra
						SET DECIMALS TO 3
						frmcart= conectar_db(_screen.cn)
							SQLEXEC(frmcart,"select c.prov_nomb from recepciones a inner join recepciones_articulos b on a.recep_codi=b.recep_codi inner join proveedores c on c.prov_codi=a.prov_codi where b.art_codi=?xcc and a.prov_codi<>46 and a.recep_conc='F' order by a.recep_fec desc limit 1;","provc")
							IF RECCOUNT("provc")>0
								thisform.lbl_prov.Caption=ALLTRIM(provc.prov_nomb)
							ENDIF				
							IF thisform.chk_todos.Value=0
								SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?.text1.value and a.otro=0 order by a.artpro_costo;","cur_costo")
							ELSE
								SQLEXEC(frmcart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costo")
							ENDIF
						desconectar_db(frmcart)
						SELECT * FROM cur_costo INTO CURSOR tmpc READWRITE
						GO top
						IF RECCOUNT("tmpc")>0
							thisform.chk_todos.Enabled= .T.
						ENDIF
						.grd_costos.recordsource="tmpc"
		*!*					.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(tmpc.lista)","Column")
		*!*					.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(tmpc.otro)","Column")
		*!*					.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(tmpc.otro)","Column")				
						SET DECIMALS TO
						.text9.enabled=.T.
						.text10.enabled=.T.
						.label17.caption=""
						.text11.value=0
						.text12.value=0
						.grid1.recordsource=""
						KEYBOARD '{TAB}'
					ENDWITH
					NODEFAULT
					this.Refresh()
					this.setfocus
				ELSE
					KEYBOARD '{TAB}'
				ENDIF
		ENDCASE
		SET DECIMALS TO
		
		
	ENDPROC

ENDDEFINE

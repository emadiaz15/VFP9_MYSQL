		Themes = .T., ;
		Top = 46, ;
		Width = 305
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		SET POINT TO thisform.puntodec
		SET SEPARATOR TO thisform.separador
	ENDPROC

	PROCEDURE Init
		thisform.puntodec  = SET("POINT")
		thisform.separador = SET("SEPARATOR")
		SET POINT TO ","
		SET SEPARATOR TO "."
		
		frmcontrol= conectar_db(_screen.cn)
			SQLEXEC(frmcontrol,"select * from rubros order by rub_desc;","cur_rubros")
		desconectar_db(frmcontrol)
		
		IF RECCOUNT("cur_rubros")>0
			LOCAL xrub
			LOCATE
			thisform.grd_rubros.RecordSource="cur_rubros"
			thisform.grd_rubros.Refresh()
			xrub=cur_rubros.rub_codi
			SET DECIMALS TO 3
			frmcontrol= conectar_db(_screen.cn)
				SQLEXEC(frmcontrol,"select art_codi,art_desc,art_stock from articulos where rub_codi = ?xrub order by art_codi;","cur_articulos")
			desconectar_db(frmcontrol)
			SET DECIMALS TO
			IF RECCOUNT("cur_articulos")>0
				LOCATE
				thisform.grd_articulos.RecordSource="cur_articulos"
				thisform.grd_articulos.Refresh()
				thisform.cmd_print.Enabled= .T.
			ELSE
				thisform.cmd_print.Enabled= .F.	
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Btn_buscar022.IMG_BUSCAR.Click
		LOCAL xrub
		
		IF RECCOUNT("cur_rubros")>0
			xcadena='%'+ALLTRIM(thisform.txt_loadrub.Value)+'%'
			thisform.grd_rubros.RecordSource=''
			thisform.grd_rubros.Refresh
			thisform.grd_articulos.RecordSource=''
			thisform.grd_articulos.Refresh
			frmcontrol= conectar_db(_screen.cn)
				SQLEXEC(frmcontrol,"select * from rubros where rub_desc like ?xcadena order by rub_desc;","cur_rubros")
			desconectar_db(frmcontrol)
			IF RECCOUNT("cur_rubros")>0
				LOCATE
				xrub=cur_rubros.rub_codi
				thisform.grd_rubros.RecordSource="cur_rubros"
				thisform.grd_rubros.Refresh()
				SET DECIMALS TO 3
				frmcontrol= conectar_db(_screen.cn)
					SQLEXEC(frmcontrol,"select art_codi,art_desc,art_stock from articulos where rub_codi = ?xrub order by art_codi;","cur_articulos")
				desconectar_db(frmcontrol)
				SET DECIMALS TO
				IF RECCOUNT("cur_articulos")>0
					LOCATE
					thisform.grd_articulos.RecordSource="cur_articulos"
					thisform.grd_articulos.Refresh()
					thisform.cmd_print.Enabled= .T.
				ELSE
					thisform.cmd_print.Enabled= .F.
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_print.Click
		DO case
			CASE thisform.chk_pant.Value=1
				REPORT FORM controlstock PREVIEW NOCONSOLE
			CASE thisform.chk_pant.Value=0
				REPORT FORM controlstock TO PRINTER PROMPT NOCONSOLE
		ENDCASE
	ENDPROC

	PROCEDURE cmd_print.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_print.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_print.OLEDrag
		LPARAMETERS lDetectDrag
		this.command1.enabled=.T.
	ENDPROC

	PROCEDURE cmd_salir.Click
		IF USED("cur_rubros")
			USE IN cur_rubros
		ENDIF
		IF USED("cur_articulos")
			USE IN cur_articulos
		ENDIF
		
		thisform.Release
	ENDPROC

	PROCEDURE cmd_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_salir.OLEDrag
		LPARAMETERS lDetectDrag
		this.command1.enabled=.T.
	ENDPROC

	PROCEDURE grd_rubros.AfterRowColChange
		LPARAMETERS nColIndex
		xrub=cur_rubros.rub_codi
		thisform.grd_articulos.RecordSource=''
		thisform.grd_articulos.Refresh()
		SET DECIMALS TO 3
		frmcontrol= conectar_db(_screen.cn)
			SQLEXEC(frmcontrol,"select art_codi,art_desc,art_stock from articulos where rub_codi = ?xrub order by art_codi;","cur_articulos")
		desconectar_db(frmcontrol)
		SET DECIMALS TO
		IF RECCOUNT("cur_articulos")>0
			LOCATE
			thisform.grd_articulos.RecordSource="cur_articulos"
			thisform.grd_articulos.Refresh()
			thisform.cmd_print.Enabled= .T.
		ELSE
			thisform.cmd_print.Enabled= .F.
		ENDIF
	ENDPROC

	PROCEDURE txt_loadrub.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE txt_loadrub.GotFocus
		this.BackColor= RGB(255,238,194)
		this.ForeColor= RGB(0,0,0)
		this.BorderColor= RGB(255,149,0)
	ENDPROC

	PROCEDURE txt_loadrub.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode=13 then
			thisform.btn_buscar022.img_buscar.Click
		ENDIF
		
	ENDPROC

	PROCEDURE txt_loadrub.LostFocus
		this.BackColor= RGB(124,136,151)
		this.ForeColor= RGB(255,255,0)
		this.BorderColor= RGB(141,178,227)
	ENDPROC

ENDDEFINE

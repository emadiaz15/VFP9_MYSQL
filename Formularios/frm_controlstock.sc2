	ADD OBJECT 'txt_loadrub' AS textbox WITH ;
		BackColor = 124,136,151, ;
		BorderColor = 141,178,227, ;
		FontBold = .T., ;
		ForeColor = 255,255,0, ;
		Format = "K!", ;
		Height = 23, ;
		Left = 69, ;
		Name = "txt_loadrub", ;

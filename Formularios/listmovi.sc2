	PROCEDURE Command4.Click
		sele ventascomp
		go top
		SCAN
			frmlistmov= conectar_db(_screen.cn)
				SQLEXEC(frmlistmov,"call usp_buscarcli(?ventascomp.codclipro);","cur_clixpro")
				SQLEXEC(frmlistmov,"select * from provincias where provi_codi=?cur_clixpro.provi_codi;","cur_provi")
			desconectar_db(frmlistmov)
			sele totales
			SEEK cur_clixpro.provi_codi
			if found()
				repla tot with iif(ventascomp.concepto="N",tot-ventascomp.grav,tot+ventascomp.grav)
			else
				if ventascomp.grav>0
					insert into totales(provi_nomb,tot,provi_codi) ;
						values(allt(cur_provi.provi_nomb),iif(ventascomp.concepto="N",-ventascomp.grav,ventascomp.grav),cur_clixpro.provi_codi)
				endif
			endif
			sele ventascomp
		endscan
		sele totales
		go top
		
		report form ventasxprovi TO PRINTER PROMPT noconsole
		sele ventascomp
	ENDPROC


	PROCEDURE Destroy
		&&Cerrar_cursores()
		set point to
		set separator to
	ENDPROC

	PROCEDURE GotFocus
		set point to ","
		set separator to "."
	ENDPROC

	PROCEDURE Init
		public acug,acung,acuiva,acupiva,acunimt,acuexc,cantreg,pagina,pregunta
		set point to ","
		set separator to "."
		
		this.text1.value=ctod("01/"+allt(str(month(date())))+"/"+allt(str(year(date()))))
		this.text2.value=date()
		
		create cursor ventas(mov_fech D,fac_conc C(1),fac_pto N(4),fac_nro N(8),cli_nomb C(45),mov_impo N(15,2),ng N(15,2),net1 N(15,2),net2 N(15,2), ;
							 mov_iva N(15,2),total N(15,2),anulado C(1),xclicod N(8),xivari N(15,2),xivarni N(15,2),xcodifac N(8),xccodi N(3))
		create cursor gas(mov_fech D,tipmov_codi N(8),gas_codi N(8),recep_codi N(8),rfc_codi N(8),mov_impo N(15,2),mov_impng N(15,2),mov_iva N(15,2),;
						  xtipf C(1),xccodi N(3),xpto N(4),xnfac N(8),xcuit N(11),xconc C(1),xpiva N(15,2),xpbtos N(15,2),xnet1 N(15,2),xnet2 N(15,2), ;
						  xivari N(15,2),xivarni N(15,2),xpcodi N(8),xnc N(1),xexe N(1),xpnomb C(45))
		create cursor compras(mov_fech D,tipmov_codi N(8),gas_codi N(8),recep_codi N(8),rfc_codi N(8),mov_impo N(15,2),mov_impng N(15,2),mov_iva N(15,2),;
							  xtipf C(1),xccodi N(3),xpto N(4),xnfac N(8),xcuit N(11),xconc C(1),xpiva N(15,2),xpbtos N(15,2),xnet1 N(15,2),xnet2 N(15,2), ;
							  xivari N(15,2),xivarni N(15,2),xpcodi N(8),xnc N(1),xexe N(1),xpnomb C(45))
		create cursor rfcpra(mov_fech D,tipmov_codi N(8),gas_codi N(8),recep_codi N(8),rfc_codi N(8),mov_impo N(15,2),mov_impng N(15,2),mov_iva N(15,2),;
							  xtipf C(1),xccodi N(3),xpto N(4),xnfac N(8),xcuit N(11),xconc C(1),xpiva N(15,2),xpbtos N(15,2),xnet1 N(15,2),xnet2 N(15,2), ;
							  xivari N(15,2),xivarni N(15,2),xpcodi N(8),xnc N(1),xexe N(1),xpnomb C(45))
		create cursor creditos(mov_fech D,tipmov_codi N(8),gas_codi N(8),recep_codi N(8),rfc_codi N(8),mov_impo N(15,2),mov_impng N(15,2),mov_iva N(15,2),;
							  xtipf C(1),xccodi N(3),xpto N(4),xnfac N(8),xcuit N(11),xconc C(1),xpiva N(15,2),xpbtos N(15,2),xnet1 N(15,2),xnet2 N(15,2), ;
							  xivari N(15,2),xivarni N(15,2),xpcodi N(8),xnc N(1),xexe N(1),xpnomb C(45))
		create cursor debitos(mov_fech D,tipmov_codi N(8),gas_codi N(8),recep_codi N(8),rfc_codi N(8),mov_impo N(15,2),mov_impng N(15,2),mov_iva N(15,2),;
							  xtipf C(1),xccodi N(3),xpto N(4),xnfac N(8),xcuit N(11),xconc C(1),xpiva N(15,2),xpbtos N(15,2),xnet1 N(15,2),xnet2 N(15,2), ;
							  xivari N(15,2),xivarni N(15,2),xpcodi N(8),xnc N(1),xexe N(1),xpnomb C(45))
		create cursor gascomp(mov_fech D,tipmov_codi N(8),gas_codi N(8),recep_codi N(8),rfc_codi N(8),mov_impo N(15,2),mov_impng N(15,2),mov_iva N(15,2),;
							  xtipf C(1),xccodi N(3),xpto N(4),xnfac N(8),xcuit N(11),xconc C(1),xpiva N(15,2),xpbtos N(15,2),xnet1 N(15,2),xnet2 N(15,2),xnet3 N(15,2), ;
							  xivari N(15,2),xivarni N(15,2),xiva3 N(15,2),xpcodi N(8),xnc N(1),xexe N(1),xpnomb C(45))
		create cursor ventascomp(fecha D,cbte C(6),nro C(15),cliprov C(30),grav N(15,2),nograv N(15,2),opexc N(15,2),iva N(15,2),nimt N(15,2),periva N(15,2), ;
		                         total N(15,2),codmov N(8),cuit N(11),concepto C(1),cli_codi N(8),net1 N(15,2),net2 N(15,2),net3 N(15,2),ivri N(15,2),ivrni N(15,2), ;
		                         xiva3 N(15,2),perbtos N(15,2),condiva N(8),codclipro N(8),tipmov_codi N(8))
		*create cursor ventascomp(fecha D,cbte C(6),pto C(4),nro C(10),cliprov C(17),grav N(10,2),nograv N(10,2),opexc N(10,2),iva N(10,2),nimt N(10,2),periva N(10,2),total N(10,2),cuit N(11),concepto C(1),cli_codi N(8))
		create cursor totxcli(cli_codi N(8),ven N(15,2))
		create cursor crexcli(cli_codi N(8),cre N(15,2))
		create cursor totales(provi_nomb C(20),tot N(15,2),provi_codi N(8))
		set safety off
		index on provi_codi to SYS(2015)
		set safety on
		pregunta=0
		pagina=0
		acug=0
		acunimt=0
		acung=0
		acuexc=0
		acuiva=0
		acupiva=0
		cantreg=0
	ENDPROC

	PROCEDURE LostFocus
		set point to
		set separator to
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(215,215,215)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Command1.Click
		local grav1,grav2,fecdes,fechas,cadeload
		store 0 to grav1,grav2
		sele ventascomp
		go top
		if reccount()>0
			set safety off
			zap
			set safety on
		endif
		acug=0
		acung=0
		acunimt=0
		acuexc=0
		acuiva=0
		acupiva=0
		cantreg=0
		fecdes=thisform.text1.Value
		fechas=thisform.text2.Value
		cadeload=''
		thisform.grid2.RecordSource=''
		thisform.grid2.Refresh()
		with thisform
			do case
				case .optiongroup1.value=1
					frmlistmov= conectar_db(_screen.cn)
						SQLEXEC(frmlistmov,"call usp_librosiva(1,1,?fecdes,?fechas);","gas")
						SQLEXEC(frmlistmov,"call usp_librosiva(1,2,?fecdes,?fechas);","rfcpra")
						SQLEXEC(frmlistmov,"call usp_librosiva(1,3,?fecdes,?fechas);","compras")
						SQLEXEC(frmlistmov,"call usp_librosiva(1,4,?fecdes,?fechas);","ccreditos")
						SQLEXEC(frmlistmov,"call usp_librosiva(1,5,?fecdes,?fechas);","debitos")
					desconectar_db(frmlistmov)
					select * from gas union (select * from rfcpra) union (select * from compras) union (select * from ccreditos) ;
						union (select * from debitos) into cursor gascomp
					sele gascomp
					if reccount()>0
						go top
						do while !eof()
							do case
								case recep_codi>0
									cadena=repl("0",4-len(allt(str(gascomp.xpto))))+allt(str(gascomp.xpto))+"-"+repl("0",8-len(allt(str(gascomp.xnfac))))+allt(str(gascomp.xnfac))
								case gas_codi>0
									cadena=repl("0",4-len(allt(str(gascomp.xpto))))+allt(str(gascomp.xpto))+"-"+repl("0",8-len(allt(str(gascomp.xnfac))))+allt(str(gascomp.xnfac))
								case rfc_codi>0
									cadena="0001-"+repl("0",8-len(allt(str(gascomp.xnfac))))+allt(str(gascomp.xnfac))							
							ENDCASE
							SELECT gascomp
							importe=mov_impo
							impong=mov_impng
							if recep_codi>0
								if gascomp.xtipf="A" or gascomp.xtipf="M" or gascomp.xtipf="B"
									if gascomp.xccodi=5
										impiva=0
									else
										impiva=mov_iva
									endif
								else
									impiva=0
								endif
							else
								if rfc_codi>0
									impiva=mov_iva
								endif
								if gascomp.xtipf="A" or gascomp.xtipf="M" or gascomp.xtipf="B" or gascomp.xtipf="L" or gascomp.xtipf="RB"
									if gascomp.xexe=1
										impiva=0
									else
										impiva=mov_iva
									endif
								else
									if rfc_codi=0
										impiva=0
									endif
								endif
							endif
							sele ventascomp
							appe blank
							repla fecha with gascomp.mov_fech
							repla nro with cadena
							do case
								case gascomp.rfc_codi>0
									repla cliprov with gascomp.xpnomb
									repla cuit with VAL(gascomp.xcuit)
									repla concepto with "N"
									if gascomp.xccodi=5
										repla nimt with importe
									ELSE
										repla grav with importe
									endif
									repla nograv with impong
									repla iva with impiva
									repla total with round(grav+nimt+nograv+iva,2)
									repla net1 with gascomp.xnet1
									repla net2 with gascomp.xnet2
									REPLACE net3 WITH gascomp.xnet3
									repla ivri with gascomp.xivari
									repla ivrni with gascomp.xivarni
									REPLACE xiva3 WITH gascomp.xiva3
									repla cbte with "RFC"
									REPLACE tipmov_codi WITH gascomp.tipmov_codi
									if gascomp.xccodi=5
										acunimt=acunimt-nimt
									else
										acug=acug-grav
									endif
									acung=acung-nograv
									acuiva=acuiva-iva
								case gascomp.recep_codi>0
									repla cuit with VAL(gascomp.xcuit)
									repla concepto with gascomp.xconc
									if gascomp.xtipf="A" or gascomp.xtipf="M" or gascomp.xtipf="B"
										if gascomp.xccodi=5 and (gascomp.xtipf="A" or gascomp.xtipf="M")
											repla opexc with importe
										ELSE
											repla opexc with 0
											repla grav with importe
										endif
									ELSE
										repla opexc with 0
										repla nimt with importe
									ENDIF
									repla nograv with impong
									repla iva with impiva
									if gascomp.xpiva>0
										repla periva with gascomp.xpiva
									endif
									if gascomp.xpbtos>0
										repla nograv with nograv+gascomp.xpbtos
										repla perbtos with gascomp.xpbtos
									ENDIF
									repla total with round(grav+nimt+nograv+opexc+iva+periva,2)
									repla net1 with gascomp.xnet1
									repla net2 with gascomp.xnet2
									REPLACE net3 WITH gascomp.xnet3
									repla ivri with gascomp.xivari
									repla ivrni with gascomp.xivarni
									REPLACE xiva3 WITH gascomp.xiva3
									REPLACE codmov WITH gascomp.recep_codi
									REPLACE condiva WITH gascomp.xccodi
									REPLACE codclipro WITH gascomp.xpcodi
									REPLACE tipmov_codi WITH gascomp.tipmov_codi
									do case
										case gascomp.tipmov_codi=6
											repla cbte with "F"+allt(gascomp.xtipf)
											if gascomp.xtipf="C"
												acunimt=acunimt+nimt
											else
												if gascomp.xccodi=5 and (gascomp.xtipf="A" or gascomp.xtipf="M")
													acuexc=acuexc+opexc
												else
													acug=acug+grav
												endif
											endif
											acung=acung+nograv
											acuiva=acuiva+iva
											acupiva=acupiva+periva
										case gascomp.tipmov_codi=9
											repla cbte with "NC"+allt(gascomp.xtipf)
											if gascomp.xtipf="C"
												acunimt=acunimt-nimt
											else
												if gascomp.xccodi=5 and (gascomp.xtipf="A" or gascomp.xtipf="M")
													acuexc=acuexc-opexc
												else
													acug=acug-grav
												endif
											endif
											acung=acung-nograv
											acuiva=acuiva-iva
											acupiva=acupiva-periva
										case gascomp.tipmov_codi=10
											repla cbte with "ND"+allt(gascomp.xtipf)
											if gascomp.xtipf="C"
												acunimt=acunimt+nimt
											else
												if gascomp.xccodi=5 and (gascomp.xtipf="A" or gascomp.xtipf="M")
													acuexc=acuexc+opexc
												else
													acug=acug+grav
												endif
											endif
											acung=acung+nograv
											acuiva=acuiva+iva
											acupiva=acupiva+periva
									ENDCASE
									repla cliprov with gascomp.xpnomb
								case gascomp.gas_codi>0
									repla concepto with iif(gascomp.xnc=1,"N","F")
									repla cuit with VAL(gascomp.xcuit)
									if gascomp.xtipf="A" or gascomp.xtipf="B" or gascomp.xtipf="M" or gascomp.xtipf="L" or gascomp.xtipf="RB" or gascomp.xtipf="LL"
										if gascomp.xexe=1 and (gascomp.xtipf="A" or gascomp.xtipf="M" or gascomp.xtipf="L" or gascomp.xtipf="LL" or gascomp.xtipf="RB")
											repla opexc with importe
										ELSE
											repla opexc with 0
											repla grav with importe
										endif
									ELSE
										repla opexc with 0
										repla nimt with importe
									endif
									if gascomp.xtipf="C"
										if gascomp.xnc=1
											acunimt=acunimt-nimt
										else
											acunimt=acunimt+nimt
										endif
									else
										if gascomp.xexe=1 and (gascomp.xtipf="A" or gascomp.xtipf="M" or gascomp.xtipf="L" or gascomp.xtipf="LL" or gascomp.xtipf="RB")
											if gascomp.xnc=1
												acuexc=acuexc-opexc
											else
												acuexc=acuexc+opexc
											endif
										else
											acug=acug+grav
										endif
									ENDIF
									repla net1 with gascomp.xnet1
									repla net2 with gascomp.xnet2
									REPLACE net3 WITH gascomp.xnet3
									repla ivri with gascomp.xivari
									repla ivrni with gascomp.xivarni
									REPLACE xiva3 WITH gascomp.xiva3
									repla nograv with impong+IIF(gascomp.xpbtos>0,gascomp.xpbtos,0)
									repla iva with impiva
									if gascomp.xpbtos>0
		*!*									repla nograv with nograv+gascomp.xpbtos
										repla perbtos with gascomp.xpbtos
									ENDIF							
									if gascomp.xpiva>0
										repla periva with gascomp.xpiva
									endif
									if gascomp.xnc=1
										acung=acung-nograv
										acuiva=acuiva-iva
										acupiva=acupiva-gascomp.xpiva
									else
										acung=acung+nograv
										acuiva=acuiva+iva
										acupiva=acupiva+gascomp.xpiva
									ENDIF
									REPLACE codmov WITH gascomp.gas_codi
									REPLACE tipmov_codi WITH gascomp.tipmov_codi
									repla total with round(grav+nimt+nograv+opexc+iva+gascomp.xpiva,2)
									if gascomp.xnc=1
										repla cbte with "NC"+allt(gascomp.xtipf)
									ELSE
										repla cbte with iif(gascomp.xtipf="L","LL",iif(gascomp.xtipf="RB","RB","F"+allt(gascomp.xtipf)))
									ENDIF
									repla cliprov with gascomp.xpnomb
							endcase
							sele gascomp
							skip
						enddo
					endif
				case .optiongroup1.value=2
					frmlistmov= conectar_db(_screen.cn)
						SQLEXEC(frmlistmov,"call usp_librosiva(2,0,?fecdes,?fechas);","ventas")
					desconectar_db(frmlistmov)
					sele ventas
					if reccount()>0
						go top
						do while !eof()
							cadena=repl("0",4-len(allt(str(ventas.fac_pto))))+allt(str(ventas.fac_pto))+"-"+repl("0",8-len(allt(str(ventas.fac_nro))))+allt(str(ventas.fac_nro))
							punto=allt(str(ventas.fac_pto))
							numero=ventas.fac_nro
							tipo=ventas.fac_tipo
							concep=ventas.fac_conc
							sele ventascomp
							appe blank
							if ventas.anulado<>"S"
								repla fecha with ventas.mov_fech
								repla nro with cadena
								repla cliprov with ventas.cli_nomb
								repla grav with ventas.net1+ventas.net2
								repla nograv with ventas.ng
								repla iva with ventas.mov_iva
								repla opexc with 0
								repla total with ventas.total
								cadeload=allt(punto)+alltrim(str(numero))+alltrim(tipo)+allt(concep)
								repla ventascomp.cuit with VAL(ventas.xcuit)
								repla ventascomp.concepto with ventas.fac_conc
								repla ventascomp.cli_codi with ventas.xclicod
								repla ventascomp.net1 with ventas.net1
								repla ventascomp.net2 with ventas.net2
								REPLACE ventascomp.net3 WITH 0
								repla ventascomp.ivri with ventas.xivari
								repla ventascomp.ivrni with ventas.xivarni
								REPLACE ventascomp.xiva3 WITH 0
								REPLACE ventascomp.codmov WITH ventas.xcodifac
								REPLACE ventascomp.condiva WITH ventas.xccodi
								REPLACE ventascomp.codclipro WITH ventas.xclicod
								sele ventascomp
							ELSE
								repla fecha with ventas.mov_fech
								repla nro with cadena
								repla cliprov with "ANULADA"
							endif
							do case
								case ventas.fac_conc="F"
										do case
											case ventas.fac_tipo="A"
												repla cbte with "FA"
											case ventas.fac_tipo="B"
												repla cbte with "FB"
										endcase
										if ventas.anulado<>"S"
											acug=acug+grav
											acuiva=acuiva+iva
										endif
								case ventas.fac_conc="N"
									repla cbte with iif(ventas.fac_tipo="B","NCB","NCA")
									if ventas.anulado<>"S"
											acug=acug-grav
											acung=acung-nograv
											acuiva=acuiva-iva
									endif
								case ventas.fac_conc="D"
									repla cbte with iif(ventas.fac_tipo="B","NDB","NDA")
									if ventas.anulado<>"S"
											acug=acug+grav
											acung=acung+nograv
											acuiva=acuiva+iva
									endif
							endcase
							sele ventas
							skip
						enddo
					endif
			endcase
			sele ventascomp
			GO top
		
			.grid2.recordsource="ventascomp"
			.grid2.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
			.text3.value=acug
			.text4.value=acung
			.text5.value=acuiva
			.text6.value=acupiva
			.text9.value=acuexc
			.text8.value=acunimt
			.text7.value=acug+acunimt+acung+acuiva+acupiva+acuexc
			acug=0
			acunimt=0
			acung=0
			acuexc=0
			acuiva=0
			acupiva=0
			.command3.enabled=.T.
			.command9.enabled=.T.
			if .optiongroup1.value=2
				frmlistmov= conectar_db(_screen.cn)
					SQLEXEC(frmlistmov,"select * from parametros where TRIM(param_desc)='ULTCIERVEN';","cur_cierre")
				desconectar_db(frmlistmov)
				if .text1.value<param_fec
					=messagebox("El ultimo cierre de Iva Ventas realizado fue el día "+dtoc(cur_cierre.param_fec)+chr(13)+;
								"solo podrá imprimir una consulta.",0+48,"Advertencia!"))
					.command5.enabled=.F.
				else
					.command5.enabled=.T.
				endif
				.command4.enabled=.T.
			ELSE
				frmlistmov= conectar_db(_screen.cn)
					SQLEXEC(frmlistmov,"select * from parametros where TRIM(param_desc)='ULTCIERCOM';","cur_cierre")
				desconectar_db(frmlistmov)
				if .text1.value<param_fec
					=messagebox("El ultimo cierre de Iva Compras realizado fue el día "+dtoc(cur_cierre.param_fec)+chr(13)+;
								"solo podrá imprimir una consulta.",0+48,"Advertencia!"))
					.command5.enabled=.F.
				else
					.command5.enabled=.T.
				endif
				.command4.enabled=.F.
			endif
		endwith
	ENDPROC


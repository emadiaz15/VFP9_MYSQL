		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command5.Click
		pregunta=messagebox("¿Confirma el cierre de IVA?. Verifique bien por favor",4+48+256,"Advertencia!")
		if pregunta=6
			LOCAL xfecha
			do case
				case listmovi.optiongroup1.value=1
					frmlistmov= conectar_db(_screen.cn)
						SQLEXEC(frmlistmov,"select * from parametros where TRIM(param_desc)='UPLCOM';","cur_pagc")
					desconectar_db(frmlistmov)
					if RECCOUNT("cur_pagc")>0
						pagina=cur_pagc.param_impo
					endif
				case listmovi.optiongroup1.value=2
					frmlistmov= conectar_db(_screen.cn)
						SQLEXEC(frmlistmov,"select * from parametros where TRIM(param_desc)='UPLVEN';","cur_pagv")
					desconectar_db(frmlistmov)
					if RECCOUNT("cur_pagv")>0
						pagina=cur_pagv.param_impo
					endif
			endcase
			sele ventascomp
			go top
			count all for !deleted() to cantreg
			xfecha=Mes_nombre(month(thisform.text2.value))+ ' de '+allt(str(year(thisform.text2.value)))
			report form librosiva to printer prompt noconsole
			do case
				case listmovi.optiongroup1.value=1
					frmlistmov= conectar_db(_screen.cn)
						SQLEXEC(frmlistmov,"select * from parametros where TRIM(param_desc)='UPLCOM';","cur_pagc")
						if RECCOUNT("cur_pagc")>0
							SQLEXEC(frmlistmov,"update parametros set param_impo=?_pageno+?pagina where param_codi=?cur_pagc.param_codi;")
		*!*						repla param_impo with _pageno+pagina
						ENDIF
						SQLEXEC(frmlistmov,"select * from parametros where TRIM(param_desc)='ULTCIERCOM';","cur_ciercom")
						if RECCOUNT("cur_ciercom")>0
							SQLEXEC(frmlistmov,"update parametros set param_fec=?thisform.text2.value where param_codi=?cur_ciercom.param_codi;")
		*!*						repla param_fec with thisform.text2.value
						ENDIF
					desconectar_db(frmlistmov)
				case listmovi.optiongroup1.value=2
					frmlistmov= conectar_db(_screen.cn)
						SQLEXEC(frmlistmov,"select * from parametros where TRIM(param_desc)='UPLVEN';","cur_pagv")
						if RECCOUNT("cur_pagv")>0
							SQLEXEC(frmlistmov,"update parametros set param_impo=?_pageno+?pagina where param_codi=?cur_pagv.param_codi;")
		*!*						repla param_impo with _pageno+pagina
						ENDIF
						SQLEXEC(frmlistmov,"select * from parametros where TRIM(param_desc)='ULTCIERVEN';","cur_cierven")
						if RECCOUNT("cur_cierven")>0
							SQLEXEC(frmlistmov,"update parametros set param_fec=?thisform.text2.value where param_codi=?cur_cierven.param_codi;")
		*!*						repla param_fec with thisform.text2.value
						ENDIF
					desconectar_db(frmlistmov)
			endcase
		endif
		this.enabled=.F.
		pregunta=0
	ENDPROC

	PROCEDURE Command5.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command5.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command9.Click
		local valcbte,letcbte,totalcbtes,totalng,pernograv,exc,piva,codope,cantali,xcali
		xcali=0
		CREATE CURSOR netos(imp_neto N(10,2))
		
		consulta=messagebox("¿GENERA ARCHIVOS DIGITALES?",4+48+256,"ARCHIVOS DIGITALES")
		
		if consulta=6
			do case
				case thisform.optiongroup1.value=1
					cadena='Compras_Cpr'+allt(str(year(thisform.text2.value)))+allt(str(month(thisform.text2.value)))+'.txt'
					archi=putfile('Guardar como',cadena,'txt')
					gnccFile = FCREATE(archi)  && De lo contrario, lo crea.
					IF gnccFile < 0     && Comprueba si hay error al abrir el archivo.
					   WAIT 'No se puede abrir o crear el archivo' WINDOW NOWAIT
					ELSE  && Si no hay error, escribe en el archivo.
						sele ventascomp
						go top
						scan
							fec=allt(str(year(fecha)))+iif(month(fecha)<10,"0","")+allt(str(month(fecha)))+iif(day(fecha)<10,"0","")+allt(str(day(fecha)))
							letcbte=allt(cbte)
							frmlistmov= conectar_db(_screen.cn)
								SQLEXEC(frmlistmov,"select * from tipcbteafip where TRIM(tipcbte_desc)=?letcbte;","cur_afip")
							desconectar_db(frmlistmov)
							valcbte=repl("0",3-len(allt(str(cur_afip.tipcbte_nro))))+allt(str(cur_afip.tipcbte_nro))
							sele ventascomp
							totalcbtes=repl("0",15-len(allt(str(total*100))))+allt(str(total*100))
							totalng=repl("0",15-len(allt(str(nograv*100))))+allt(str(nograv*100))
							exc=repl("0",15-len(allt(str(opexc*100))))+allt(str(opexc*100))
							if perbtos>0
								totalng=repl("0",15-len(allt(str((nograv-perbtos)*100))))+allt(str((nograv-perbtos)*100))
								bruto=repl("0",15-len(allt(str(perbtos*100))))+allt(str(perbtos*100))
							else
								bruto=repl("0",15)
							endif
							if inlist(cur_afip.tipcbte_nro,1,2,3,6,7,8,51,52,53)
								do case
									case inlist(cur_afip.tipcbte_nro,1,6,51) and grav=0 and opexc>0 and iva=0
										codope="E"
										cantali="1"
									case inlist(cur_afip.tipcbte_nro,1,6,51) and grav>0 and iva>0
										codope=" "
										INSERT INTO netos(imp_neto) values(ventascomp.net1)
										INSERT INTO netos(imp_neto) values(ventascomp.net2)
										INSERT INTO netos(imp_neto) values(ventascomp.net3)
										SELECT netos
										GO top
										COUNT FOR imp_neto>0 TO xcali
										cantali=ALLTRIM(STR(xcali))
										SET SAFETY off
										ZAP
										SET SAFETY on
										SELECT ventascomp
									case inlist(cur_afip.tipcbte_nro,2,3,7,8,52,53) and grav>0 and nograv=0 and iva>0
										codope=" "
										INSERT INTO netos(imp_neto) values(ventascomp.net1)
										INSERT INTO netos(imp_neto) values(ventascomp.net2)
										INSERT INTO netos(imp_neto) values(ventascomp.net3)
										SELECT netos
										GO top
										COUNT FOR imp_neto>0 TO xcali
										cantali=ALLTRIM(STR(xcali))
										SET SAFETY off
										ZAP
										SET SAFETY on
										SELECT ventascomp								
									case inlist(cur_afip.tipcbte_nro,2,3,7,8,52,53) and grav>0 and nograv>0
										if nograv>perbtos
											codope="0"
										else
											codope=" "
										endif
										INSERT INTO netos(imp_neto) values(ventascomp.net1)
										INSERT INTO netos(imp_neto) values(ventascomp.net2)
										INSERT INTO netos(imp_neto) values(ventascomp.net3)
										SELECT netos
										GO top
										COUNT FOR imp_neto>0 TO xcali
										cantali=ALLTRIM(STR(xcali))
										SET SAFETY off
										ZAP
										SET SAFETY on
										SELECT ventascomp
									case inlist(cur_afip.tipcbte_nro,2,3,7,8,52,53) and grav=0 and nograv>0
										codope="E"
										cantali="1"
								endcase
							else
								if cur_afip.tipcbte_nro=39
									codope=" "
									cantali="1"
								else
									codope=" "
									cantali="0"
								endif
							endif
							piva=iif(periva>0,repl("0",15-len(allt(str(periva*100))))+allt(str(periva*100)),repl("0",15))
							=FPUTS(gnccFile , fec+valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+repl(" ",16)+"80"+ ;
									repl("0",9)+allt(str(cuit,11))+subst(cliprov,1,30)+totalcbtes+iif(inlist(cur_afip.tipcbte_nro,11,12,13),repl("0",15),totalng)+exc+piva+repl("0",15)+ ;
									bruto+repl("0",15)+repl("0",15)+"PES"+"0001000000"+cantali+ ;
									codope+repl("0",15-len(allt(str(iva*100))))+allt(str(iva*100))+repl("0",26)+repl(" ",30)+repl("0",15))
						endscan
					ENDIF
					=FCLOSE(gnccFile )
					
					cadena='Compras_Alic'+allt(str(year(thisform.text2.value)))+allt(str(month(thisform.text2.value)))+'.txt'
					archi=putfile('Guardar como',cadena,'txt')
					gncaFile = FCREATE(archi)
					IF gncaFile < 0
						WAIT 'No se puede abrir o crear el archivo' WINDOW NOWAIT
					ELSE
						sele ventascomp
						go top
						scan
							letcbte=allt(cbte)
							frmlistmov= conectar_db(_screen.cn)
								SQLEXEC(frmlistmov,"select * from tipcbteafip where TRIM(tipcbte_desc)=?letcbte;","cur_afip")
							desconectar_db(frmlistmov)					
							valcbte=repl("0",3-len(allt(str(cur_afip.tipcbte_nro))))+allt(str(cur_afip.tipcbte_nro))
							sele ventascomp
							
							DO case
								case net1>0 and net2>0 AND net3>0 && FACTURA CON 3 ALÍCUOTAS DE IVA
									=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
											repl("0",15-len(allt(str(net1*100))))+allt(str(net1*100))+"0005"+repl("0",15-len(allt(str(ivri*100))))+allt(str(ivri*100)))
									=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
											repl("0",15-len(allt(str(net2*100))))+allt(str(net2*100))+"0004"+repl("0",15-len(allt(str(ivrni*100))))+allt(str(ivrni*100)))
									=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
											repl("0",15-len(allt(str(net3*100))))+allt(str(net3*100))+"0006"+repl("0",15-len(allt(str(xiva3*100))))+allt(str(xiva3*100)))
								CASE net1=0 and net2=0 AND net3=0 AND !inlist(cur_afip.tipcbte_nro,11,12,13)&& FACTURA SIN IVA Y QUE NO SON COMPRAS A MONOTRIBUTISTAS CON TIPO C
									do case
										case inlist(cur_afip.tipcbte_nro,2,3,7,8,52,53) and grav=0 and nograv>0 && NOTA CRÉDITO / DÉBITO CON IMPORTE NO GRAVADO
											=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
												repl("0",15-len(allt(str(grav*100))))+allt(str(grav*100))+"0003"+ ;
												repl("0",15-len(allt(str(iva*100))))+allt(str(iva*100)))
		*!*									case inlist(cur_afip.tipcbte_nro,1,2,3,6,7,8,51,52,53,39) and iva>0 && FACT / NC / ND / OTROS CON IVA???????????????????????
		*!*										=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
		*!*											repl("0",15-len(allt(str(grav*100))))+allt(str(grav*100))+iif(nograv-perbtos>0 and iva=0,"0001",iif(nograv-perbtos=0 and iva=0 and grav>0,"0003",iif(opexc>0,"0002","0005")))+ ;
		*!*											repl("0",15-len(allt(str(iva*100))))+allt(str(iva*100)))
										case inlist(cur_afip.tipcbte_nro,1,6,51,39) and nograv=0 and opexc>0 and iva=0 && FACT A/B/M/OTROS SIN IVA OPEXC > 0
											=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
												repl("0",15-len(allt(str(grav*100))))+allt(str(grav*100))+"0003"+repl("0",15))
										case inlist(cur_afip.tipcbte_nro,1,6,51,39) and nograv>0 and opexc=0 and iva=0 && FACT A/B/M/OTROS SIN IVA CON NETO GRAVADO OPEXC = 0
											=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
												repl("0",15-len(allt(str(grav*100))))+allt(str(grav*100))+"0003"+repl("0",15))
									endcase
								CASE net1>0 AND net2=0 AND net3=0 && FACTURA CON IVA 21%
									=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
											repl("0",15-len(allt(str(net1*100))))+allt(str(net1*100))+"0005"+repl("0",15-len(allt(str(ivri*100))))+allt(str(ivri*100)))
								CASE net1>0 AND net2>0 AND net3=0 && FACTURA CON IVA 21% E IVA 10,5%
									=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
											repl("0",15-len(allt(str(net1*100))))+allt(str(net1*100))+"0005"+repl("0",15-len(allt(str(ivri*100))))+allt(str(ivri*100)))
									=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
											repl("0",15-len(allt(str(net2*100))))+allt(str(net2*100))+"0004"+repl("0",15-len(allt(str(ivrni*100))))+allt(str(ivrni*100)))
								CASE net1>0 AND net2=0 AND net3>0 && FACTURA CON IVA 21% E IVA 27%
									=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
											repl("0",15-len(allt(str(net1*100))))+allt(str(net1*100))+"0005"+repl("0",15-len(allt(str(ivri*100))))+allt(str(ivri*100)))
									=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
											repl("0",15-len(allt(str(net3*100))))+allt(str(net3*100))+"0006"+repl("0",15-len(allt(str(xiva3*100))))+allt(str(xiva3*100)))
								CASE net1=0 AND net2>0 AND net3=0 && FACTURA CON IVA 10,5%
									=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
											repl("0",15-len(allt(str(net2*100))))+allt(str(net2*100))+"0004"+repl("0",15-len(allt(str(ivrni*100))))+allt(str(ivrni*100)))
								CASE net1=0 AND net2>0 AND net3>0 && FACTURA CON IVA 10,5% E IVA 27%
									=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
											repl("0",15-len(allt(str(net2*100))))+allt(str(net2*100))+"0004"+repl("0",15-len(allt(str(ivrni*100))))+allt(str(ivrni*100)))
									=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
											repl("0",15-len(allt(str(net3*100))))+allt(str(net3*100))+"0006"+repl("0",15-len(allt(str(xiva3*100))))+allt(str(xiva3*100)))
								CASE net1=0 AND net2=0 AND net3>0 && FACTURA CON IVA 27%
									=FPUTS(gncaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+"80"+repl("0",9)+allt(str(cuit,11))+ ;
											repl("0",15-len(allt(str(net3*100))))+allt(str(net3*100))+"0006"+repl("0",15-len(allt(str(xiva3*100))))+allt(str(xiva3*100)))
							ENDCASE
						endscan
					ENDIF
					=FCLOSE(gncaFile )
				case thisform.optiongroup1.value=2
					cadena='Ventas_Cpr'+allt(str(year(thisform.text2.value)))+allt(str(month(thisform.text2.value)))+'.txt'
					archi=putfile('Guardar como',cadena,'txt')
					gnvcFile = FCREATE(archi)  && De lo contrario, lo crea.
					IF gnvcFile < 0     && Comprueba si hay error al abrir el archivo.
					   WAIT 'No se puede abrir o crear el archivo' WINDOW NOWAIT
					ELSE  && Si no hay error, escribe en el archivo.
						sele ventascomp
						go top
						scan
							fec=allt(str(year(fecha)))+iif(month(fecha)<10,"0","")+allt(str(month(fecha)))+iif(day(fecha)<10,"0","")+allt(str(day(fecha)))
							letcbte=allt(cbte)
							totalng=repl("0",15)
							exc=repl("0",15)
							frmlistmov= conectar_db(_screen.cn)
								SQLEXEC(frmlistmov,"select * from tipcbteafip where TRIM(tipcbte_desc)=?letcbte;","cur_afip")
							desconectar_db(frmlistmov)	
							valcbte=repl("0",3-len(allt(str(cur_afip.tipcbte_nro))))+allt(str(cur_afip.tipcbte_nro))
							sele ventascomp
							totalcbtes=repl("0",15-len(allt(str(total*100))))+allt(str(total*100))
							if nograv>0 or opexc>0
								if nograv>0
									exc=repl("0",15-len(allt(str(nograv*100))))+allt(str(nograv*100))
								else
									exc=repl("0",15-len(allt(str(opexc*100))))+allt(str(opexc*100))
								endif
							endif			
							if perbtos>0
								if nograv>0 or opexc>0
									if nograv>0
										totalng=repl("0",15-len(allt(str((nograv-perbtos)*100))))+allt(str((nograv-perbtos)*100))
									else
										exc=repl("0",15-len(allt(str(opexc*100))))+allt(str(opexc*100))
									endif
								endif
								bruto=repl("0",15-len(allt(str(perbtos*100))))+allt(str(perbtos*100))
							else
								bruto=repl("0",15)
							endif
							if inlist(cur_afip.tipcbte_nro,1,2,3,6,7,8,51,52,53)
								do case
									case inlist(cur_afip.tipcbte_nro,1,6,51) and grav=0 and opexc>0 and iva=0
										codope="E"
										cantali="1"
									case inlist(cur_afip.tipcbte_nro,1,6,51) and grav>0 and iva>0
										codope=" "
										if net1>0 and net2>0 AND net3=0
											cantali="2"
										else
											cantali="1"
										endif
									case inlist(cur_afip.tipcbte_nro,2,3,7,8,52,53) and grav>0 and nograv=0 and iva>0
										codope=" "
										if net1>0 and net2>0 AND net3=0
											cantali="2"
										else
											cantali="1"
										endif
									case inlist(cur_afip.tipcbte_nro,2,3,7,8,52,53) and grav>0 and nograv>0
										codope="0"
										if net1>0 and net2>0 AND net3=0
											cantali="2"
										else
											cantali="1"
										endif
									case inlist(cur_afip.tipcbte_nro,2,3,7,8,52,53) and grav=0 and nograv>0
										codope="E"
										cantali="1"
								endcase
							else
								if cur_afip.tipcbte_nro=39
									cantali="1"
								else
									codope=" "
									cantali="0"
								endif
							endif
							piva=iif(periva>0,repl("0",15-len(allt(str(periva*100))))+allt(str(periva*100)),repl("0",15))
							=FPUTS(gnvcFile , fec+valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+repl("0",12)+subst(nro,6,8)+"80"+ ;
									repl("0",9)+allt(str(cuit,11))+subst(cliprov,1,30)+totalcbtes+totalng+repl("0",15)+exc+repl("0",15)+ ;
									bruto+repl("0",15)+repl("0",15)+"PES"+"0001000000"+cantali+ ;
									codope+repl("0",23))
						endscan
					ENDIF
					=FCLOSE(gnvcFile )
		
					cadena='Ventas_Alic'+allt(str(year(thisform.text2.value)))+allt(str(month(thisform.text2.value)))+'.txt'
					archi=putfile('Guardar como',cadena,'txt')
					gnvaFile = FCREATE(archi)
					IF gnvaFile < 0
						WAIT 'No se puede abrir o crear el archivo' WINDOW NOWAIT
					ELSE
						sele ventascomp
						go top
						scan
							letcbte=allt(cbte)
							frmlistmov= conectar_db(_screen.cn)
								SQLEXEC(frmlistmov,"select * from tipcbteafip where TRIM(tipcbte_desc)=?letcbte;","cur_afip")
							desconectar_db(frmlistmov)	
							valcbte=repl("0",3-len(allt(str(cur_afip.tipcbte_nro))))+allt(str(cur_afip.tipcbte_nro))
							sele ventascomp
							do case
								case net1>0 and net2>0 AND net3=0
									=FPUTS(gnvaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+ ;
											repl("0",15-len(allt(str(net1*100))))+allt(str(net1*100))+"0005"+repl("0",15-len(allt(str(ivri*100))))+allt(str(ivri*100)))
									=FPUTS(gnvaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+ ;
											repl("0",15-len(allt(str(net2*100))))+allt(str(net2*100))+"0004"+repl("0",15-len(allt(str(ivrni*100))))+allt(str(ivrni*100)))
							otherwise
								if net1>0
									=FPUTS(gnvaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+ ;
										repl("0",15-len(allt(str(net1*100))))+allt(str(net1*100))+"0005"+repl("0",15-len(allt(str(ivri*100))))+allt(str(ivri*100)))
								else
									if net2>0 AND net3=0
										=FPUTS(gnvaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+ ;
											repl("0",15-len(allt(str(net2*100))))+allt(str(net2*100))+"0004"+repl("0",15-len(allt(str(ivrni*100))))+allt(str(ivrni*100)))
									else
										=FPUTS(gnvaFile , valcbte+"0"+subst(nro,1,4)+repl("0",12)+subst(nro,6,8)+ ;
											repl("0",15-len(allt(str(net2*100))))+allt(str(net2*100))+"0003"+repl("0",15-len(allt(str(ivrni*100))))+allt(str(ivrni*100)))
									endif								
								endif
							endcase
						endscan
					ENDIF
					=FCLOSE(gnvaFile )
			endcase
		endif
	ENDPROC

	PROCEDURE Command9.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command9.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Ctn_banner1.Init
		this.Height=102
		this.left=0
		this.Width=this.Parent.Width
		
	ENDPROC

	PROCEDURE Grid2.Column1.Header1.Click
		IF USED("ventascomp")
			thisform.grid2.RecordSource=''
			IF thisform.hdfecha_estado = 0
				SELECT * FROM ventascomp ORDER BY fecha INTO CURSOR ventascomp
				thisform.hdfecha_estado = 1
			ELSE
				DO case
					CASE thisform.hdfecha_estado = 1
						SELECT * FROM ventascomp ORDER BY fecha DESC INTO CURSOR ventascomp
						thisform.hdfecha_estado = 2
					CASE thisform.hdfecha_estado = 2
						SELECT * FROM ventascomp ORDER BY fecha INTO CURSOR ventascomp
						thisform.hdfecha_estado = 1
				ENDCASE
			ENDIF
			thisform.grid2.RecordSource="ventascomp"
			thisform.grid2.Refresh()
		ENDIF
		
	ENDPROC


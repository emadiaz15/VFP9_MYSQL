	PROCEDURE Grid2.Column9.Header1.Click
		IF USED("ventascomp")
			thisform.grid2.RecordSource=''
			IF thisform.hdper_estado = 0
				SELECT * FROM ventascomp ORDER BY periva INTO CURSOR ventascomp
				thisform.hdper_estado = 1
			ELSE
				DO case
					CASE thisform.hdper_estado = 1
						SELECT * FROM ventascomp ORDER BY periva DESC INTO CURSOR ventascomp
						thisform.hdper_estado = 2
					CASE thisform.hdper_estado = 2
						SELECT * FROM ventascomp ORDER BY periva INTO CURSOR ventascomp
						thisform.hdper_estado = 1
				ENDCASE
			ENDIF
			thisform.grid2.RecordSource="ventascomp"
			thisform.grid2.Refresh()
		ENDIF
	ENDPROC

	PROCEDURE Grid2.DblClick
		DO case
			LOCAL xcond
			CASE thisform.optiongroup1.Value=1
				IF ventascomp.tipmov_codi=4
					DO FORM consgastos WITH ventascomp.codmov
				ELSE
					IF ventascomp.codmov>0
						pasrecep=1
						codr=ventascomp.codmov
						xcond=ventascomp.condiva
						if SUBSTR(ALLTRIM(ventascomp.cbte),1,1)="F"
							valorcadena="Recepciones (Mercadería Recibida)"
						else
							valorcadena="Notas de Crédito/Notas de Débito"
						endif
						frmlistmov= conectar_db(_screen.cn)
							SQLEXEC(frmlistmov,"call usp_buscarprov(?ventascomp.codclipro);","cur_prov")
						desconectar_db(frmlistmov)
						DO FORM consrecep WITH codr,xcond
					ENDIF
				ENDIF
			CASE thisform.optiongroup1.Value=2
				pasfac=1
				codicli=ventascomp.codclipro
				codifac=ventascomp.codmov
				xcond=ventascomp.condiva
				DO FORM consfactura WITH codifac,xcond
		endcase	
		*MESSAGEBOX(ALLTRIM(ventascomp.nro))
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.InteractiveChange
		thisform.text2.value=this.value
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

ENDDEFINE

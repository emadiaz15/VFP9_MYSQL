					endif
				else
					appe blank
					repla ped_codi with codp
					repla tran_codi with coditran1
					do case
						case .opcionflete1.value=1
							repla flete_cargo with "C"
						case .opcionflete1.value=2
							repla flete_cargo with "P"
					endcase
					if coditran2>0
						appe blank
						repla ped_codi with codp
						repla tran_codi with coditran2
						do case
							case .opcionflete2.value=1
								repla flete_cargo with "C"
							case .opcionflete2.value=2
								repla flete_cargo with "P"

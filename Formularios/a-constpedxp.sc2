							appe blank
							repla ped_codi with codped
							.grid1.col=3
							if val(.grid1.text)=4
								.grid1.col=4
								repla artped_dasc with .grid1.text
								.grid1.col=3
							endif
							repla art_codi with val(.grid1.text)
							articulo=val(.grid1.text)
							.grid1.col=4
							sele articulos

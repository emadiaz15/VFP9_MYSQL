	PROCEDURE Activate
		cond=auxcond
		on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		set exact on
		if codigo=0
			muestro=0
		endif
		if muestro=1
			with thisform
				sele articulos
				set order to art_codi
				seek codigo
				localiz=1
				if paso=1
					.grid1.col=0
					.grid1.text=allt(str(aux))
					.grid1.col=2
					.grid1.text=art_med
					.grid1.col=3
					articulo=val(.grid1.text)
					sele pedidos
					set order to ped_codi
					seek codped
					if found()
						if val(.grid1.text)<>codigo
							sele pedidos_articulos
							set order to pedart
							seek str(codped)+str(articulo)
							.grid1.col=1
							repla articulos.pedidos with articulos.pedidos-val(.grid1.text)
							.grid1.col=3
							if val(.grid1.text)=4
								.grid1.col=4
								if .grid1.text<>artped_dasc
									do while art_codi=4 and !eof()
										if .grid1.text=artped_dasc
											exit
										endif
										skip
									enddo
								endif
								if codigo>4
									repla artped_dasc with ""
								endif
							endif
							.grid1.col=3
							sele presupuestos_articulos
							set order to artpres
							seek str(codp)+str(articulo)
							if val(.grid1.text)=4
								if artpres_dasc<>pedidos_articulos.artped_dasc
									do while art_codi=4 and !eof()
										if artpres_dasc=pedidos_articulos.artped_dasc
											.grid1.col=1
											repla aceptados with aceptados-val(.grid1.text)
											exit
										endif
										skip
									enddo
								else
									.grid1.col=1
									repla aceptados with aceptados-val(.grid1.text)
								endif
							else
								.grid1.col=1
								repla aceptados with aceptados-val(.grid1.text)
							endif
						endif
					endif
					.grid1.col=3
					cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
					.grid1.text=cadena
					.grid1.col=1			
					.grid1.text=allt(cant)
					.grid1.col=4
					if codigo=4
						.grid1.text=allt(descrip)
					else
						.grid1.text=allt(descri)
					endif
					.grid1.col=5
					.grid1.text=allt(pruni)
					.grid1.col=6
					acu=acu-val(.grid1.text)
					.grid1.text=prtot
					acu=acu+val(prtot)
				else
					if insertar=0
						item=item+1
						cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
						.grid1.additem(alltrim(str(item))+chr(9)+trim(cant)+chr(9)+art_med+chr(9)+cadena+chr(9)+allt(descri)+chr(9)+allt(pruni)+chr(9)+prtot)
					endif
					acu=acu+val(prtot)
				endif
				if paso=1
					paso=0
				else
					.grid1.row=this.grid1.rows-1
				endif
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				endif
				.grid1.col=0
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellalignment=3
				.grid1.col=2
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellalignment=8		
				if .text19.value>0
					.text17.value=str(acu*.text19.value/100,10,2)
					.text18.value=str(acu-val(.text17.value),10,2)
					if cond=2
						.text9.value=str(val(.text18.value)*impiva1/100,10,2)
					endif
					.text10.value=str(val(.text18.value)+val(.text9.value)+val(.text11.value),10,2)
				endif	
				codigo=0
			endwith
		endif
		if localiz=1 and item>0
			with thisform
				acuaux=0
				auxiva=0
				ivadif=0
				ivaitem=0
				acu=0
				for i=1 to .grid1.rows-1
					.grid1.row=i
					.grid1.col=7
					if len(.grid1.text)>0
						ivaitem=val(.grid1.text)
						.grid1.col=6
						if .text19.value>0
							dto=val(.grid1.text)*.text19.value/100
							acuaux=acuaux+val(.grid1.text)-dto
							dto=val(.grid1.text)-dto
							ivaitem=dto*ivaitem/100
						else
							acuaux=acuaux+val(.grid1.text)
							ivaitem=val(.grid1.text)*ivaitem/100
						endif
						ivadif=ivadif+ivaitem
					else
						.grid1.col=6
						acu=acu+val(.grid1.text)
					endif
				next i
				.text8.value=str(acu+acuaux,10,2)
				if cond=2
					dto=0
					if .text19.value>0
						dto=(acu+acuaux)*.text19.value/100
					endif
					acutot=acu+acuaux
					dife=acutot-acuaux-dto
					auxiva=dife*impiva1/100
					.text9.value=str(auxiva+ivadif,10,2)
				endif
				.text17.value=str((acu+acuaux)*.text19.value/100,10,2)
				.text18.value=str(acu+acuaux-val(.text17.value),10,2)
				.text10.value=str(val(.text18.value)+val(.text9.value)+val(.text11.value),10,2)
				.grid1.toprow=.grid1.rows-1
			endwith
		endif
		store 0 to localiz
		
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 3 of Altas .F.
		on key label INS
		localiz=0
		item=0
	ENDPROC

	PROCEDURE Init
		parameter codp,cond,codicli
		public elimi,descrip,muestro,postal,locali,provi,opcion,x, ;
			   dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot,insertar, ;
			   impiva1,impiva2,borra,codiva,codped,transporte,coditran,coditran1,coditran2,auxcond,auxregis,localiz, ;
			   buscar,validez,plazo,condpag,lugent,observ,vcodi,letrapor,porcodi,item,acu,paso,aux
		set dele on
		aux=0
		item=0
		letrapor=""
		porcodi=0
		vcodi=0
		validez=" "
		plazo=" "
		condpag=" "
		lugent=" "
		observ=" "
		transporte=" "
		coditran=0
		paso=0
		acu=0
		elimi=0
		localiz=0
		muestro=0
		descrip=""
		opcion=0
		insertar=0
		borra=0
		codigo=0
		x=0
		codped=0
		auxregis=0
		buscar=1
		this.text13.value=date()
		this.text19.value=0
		this.text15.value=0
		this.text21.value=0
		sele iva
		go bott
		codiva=iva_codi
		impiva1=iva.iva_1
		impiva2=iva.iva_2
		thisform.label12.caption=allt(str(impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(impiva2,10,2))+"%"
		with thisform
			sele vendedores
			set order to ven_codi
			sele zonas
			set rela off into vendedores
			set rela to ven_codi into vendedores addi
			sele clientes
			set order to cli_codi
			seek codicli
			.text1.value=cli_nomb
			.text2.value=cli_domi
			.text3.value=codipostales.cp_nro
			.text4.value=localidades.loca_nomb
			.text5.value=provincias.provi_nomb
			.text6.value=condiva.cond_desc
			.text12.value=cli_cuit
			vcodi=zonas.ven_codi
			.text15.value=zonas.ven_codi
			.text16.value=vendedores.ven_nomb
		endwith					
		cond=clientes.cond_codi
		auxcond=cond
		set order to cli_codi
		sele presupuestos_articulos
		set order to presup_cod
		seek codp
		this.text19.value=presupuestos.presup_dto
		item=1
		for i=1 to selecitem.lstpresup.listcount
			if selecitem.lstpresup.selected(i)
				if art_codi<>val(selecitem.lstpresup.list(i,4))
					do while art_codi<>val(selecitem.lstpresup.list(i,4))
						if art_codi=val(selecitem.lstpresup.list(i,4)) or presup_codi<>codp
							exit
						endif
						skip
					enddo
				endif
				if art_codi=4
					if len(artpres_dasc)>0
						sele tempo
						set rela to art_codi into articulos
						go top
						locate for itempr=presupuestos_articulos.nro_it
						if found()
							if selecitem.lstpresup.list(i,3)="ALT"
								x=i
								do while selecitem.lstpresup.list(x,3)="ALT"
									x=x-1
								enddo
								cantidad=val(selecitem.lstpresup.list(x,2))
							else
								cantidad=val(selecitem.lstpresup.list(i,2))
							endif
							auxit=itempr
							do while itempr=auxit
								cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
								this.grid1.additem(allt(str(item))+chr(9)+allt(str(cantidad,10,2))+chr(9)+articulos.art_med+chr(9)+cadena+chr(9)+articulos.art_desc+chr(9)+str(precio,10,4)+chr(9)+str(cantidad*precio,10,2)+chr(9)+""+chr(9)+str(presupuestos_articulos.nro_regis))
								acu=acu+presupuestos_articulos.artpres_cant*precio
								skip
								item=item+1
							enddo
							sele presupuestos_articulos
						else
							sele presupuestos_articulos
							if selecitem.lstpresup.list(i,3)="ALT"
								x=i
								do while selecitem.lstpresup.list(x,3)="ALT"
									x=x-1
								enddo
								cantidad=val(selecitem.lstpresup.list(x,2))
							else
								cantidad=val(selecitem.lstpresup.list(i,2))
							endif
							cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
							this.grid1.additem(allt(str(item))+chr(9)+allt(str(cantidad,10,2))+chr(9)+articulos.art_med+chr(9)+cadena+chr(9)+artpres_dasc+chr(9)+str(artpres_precio,10,4)+chr(9)+str(cantidad*artpres_precio,10,2))
							acu=acu+artpres_cant*artpres_precio
							item=item+1
						endif
					endif
				else
					sele presupuestos_articulos
					if selecitem.lstpresup.list(i,3)="ALT"
						x=i
						do while selecitem.lstpresup.list(x,3)="ALT"
							x=x-1
						enddo
						cantidad=val(selecitem.lstpresup.list(x,2))
					else
						cantidad=val(selecitem.lstpresup.list(i,2))
					endif
					cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
					this.grid1.additem(allt(str(item))+chr(9)+allt(str(cantidad,10,2))+chr(9)+articulos.art_med+chr(9)+cadena+chr(9)+articulos.art_desc+chr(9)+str(artpres_precio,10,4)+chr(9)+str(cantidad*artpres_precio,10,2))
		*			if artcli_codi>0
		*				this.grid1.row=this.grid1.rows-1
		*				this.grid1.col=4
		*				this.grid1.text=allt(articulos_clientes.artcli_desc)
		*			endif
					if dac_codi>0
						this.grid1.row=this.grid1.rows-1
						this.grid1.col=4
						this.grid1.text=allt(desc_articulos_clientes.dac_desc)
					endif
					acu=acu+artpres_cant*artpres_precio
					item=item+1
				endif
				if alter_iva>0
					this.grid1.col=7
					this.grid1.row=this.grid1.rows-1
					this.grid1.text=str(alter_iva,6,2)
				endif
			endif
			this.grid1.row=this.grid1.rows-1
			this.grid1.col=4
			if len(allt(this.grid1.text))>47
				div=len(allt(this.grid1.text))/47
				if div>int(div)
					longdes=int(div)+1
				else
					longdes=div
				endif
				longdes=longdes*240
				this.grid1.rowheight(this.grid1.row)=longdes
			else
				this.grid1.rowheight(this.grid1.row)=270
			endif
			this.grid1.col=0
			this.grid1.cellalignment=3
			this.grid1.col=1
			this.grid1.cellalignment=3
			this.grid1.col=2
			this.grid1.cellalignment=3
			this.grid1.col=3
			this.grid1.cellalignment=3
			this.grid1.col=4
			this.grid1.cellalignment=0
			this.grid1.col=5
			this.grid1.cellalignment=8
			this.grid1.col=6
			this.grid1.cellalignment=8	
			skip
		next i
		if item>1
			item=item-1
		endif
		selecitem.release
		localiz=1
	ENDPROC

	PROCEDURE Load
		set skip of bar 3 of Altas .T.
	ENDPROC

	PROCEDURE LostFocus
		if valorcadena="Por Presupuesto"
			set skip of bar 3 of Altas .F.
			localiz=0
		*	item=0
		endif
	ENDPROC

	PROCEDURE Command1.Click
		if thisform.text21.value=0 and thisform.text15.value>0
			messagebox("Debe ingresar la comisión del vendedor para guardar el Pedido.",0+48,"Advertencia")
		else
		preg=messagebox("¿Confirma los datos del Pedido?",4+32+256,"Alta de Pedidos de Clientes")
		if preg=6
			with thisform
				sele presupuestos_articulos
				set order to presup_cod
				seek codp
				sele pedidos
				set order to ped_codi
				if codped=0
					go bott
					codped=ped_codi+1
					appe blank
					repla ped_codi with codped
				else
					seek codped
				endif
				repla ped_fech with .text13.value
				repla cli_codi with codicli
				repla ped_dto with .text19.value
				repla iva_codi with codiva
				repla presup_codi with codp
				if .text15.value>0
					repla ven_codi with .text15.value
				endif
				if allt(.text20.value)=""
					if thisform.text21.value>0
						repla otra_comi with .text21.value
					else
						repla porc_codi with 0
					endif
				else
					repla porc_codi with porcodi
				endif
				if coditran1>0
					sele pedidos_transportes
					set order to ped_codi
					seek codped
					if found()
						repla tran_codi with coditran1
						do case
							case .opcionflete1.value=1
								repla flete_cargo with "C"
							case .opcionflete1.value=2
								repla flete_cargo with "P"
						endcase
						skip
						if ped_codi=codped
							repla tran_codi with coditran2
							do case
								case .opcionflete2.value=1
									repla flete_cargo with "C"
								case .opcionflete2.value=2
									repla flete_cargo with "P"
							endcase
						endif
					else
						appe blank
						repla ped_codi with codped
						repla tran_codi with coditran1
						do case
							case .opcionflete1.value=1
								repla flete_cargo with "C"
							case .opcionflete1.value=2
								repla flete_cargo with "P"
						endcase
						if coditran2>0
							appe blank
							repla ped_codi with codped
							repla tran_codi with coditran2
							do case
								case .opcionflete2.value=1
									repla flete_cargo with "C"
								case .opcionflete2.value=2
									repla flete_cargo with "P"
							endcase
						endif
					endif
				endif
				sele pedidos_articulos
				set reprocess to automatic
				if flock()
					set order to ped_codi
					seek codped
					if !found()
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								appe blank
								repla ped_codi with codped
								.grid1.col=3
								if val(.grid1.text)=4
									.grid1.col=4
									repla artped_dasc with .grid1.text
									.grid1.col=3
								endif
								repla art_codi with val(.grid1.text)
								articulo=val(.grid1.text)
								.grid1.col=4
								sele articulos
								set order to art_codi
								seek articulo
								if articulo<>4 and allt(.grid1.text)<>allt(art_desc)
									sele articulos_clientes
									set order to artcli
									seek str(codicli)+str(articulo)
									if found()
										sele desc_articulos_clientes
										set order to dacartcli
										seek str(articulos_clientes.artcli_codi)+allt(.grid1.text)
										if found()
											repla pedidos_articulos.dac_codi with dac_codi
										endif
									endif
								else
									if pedidos_articulos.dac_codi>0
										repla pedidos_articulos.dac_codi with 0
									endif
								endif
								sele pedidos_articulos
								.grid1.col=1
								repla artped_cant with val(.grid1.text)
								if articulo<>4
									sele articulos
									set order to art_codi
									seek articulo
									.grid1.col=1
									repla pedidos with pedidos+pedidos_articulos.artped_cant
								endif
								sele pedidos_articulos
								.grid1.col=3
								repla art_codi with val(.grid1.text)
								.grid1.col=5
								repla artped_precio with val(.grid1.text)
								.grid1.col=7
								if len(.grid1.text)>0
									repla alter_iva with val(.grid1.text)
								else
									repla alter_iva with 0
								endif
							endif
						next fila
					else
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								if eof() or ped_codi<>codped
									appe blank
									repla ped_codi with codped
								else
									if fila>1
										skip
										if eof() or ped_codi<>codped
											appe blank
											repla ped_codi with codped
										endif
									endif
								endif
								.grid1.col=3
								if val(.grid1.text)=4
									.grid1.col=4
									repla artped_dasc with .grid1.text
									.grid1.col=3
								endif
								auxart=art_codi
								if val(.grid1.text)<>art_codi
									repla art_codi with val(.grid1.text)
								endif
								articulo=val(.grid1.text)
								.grid1.col=4
								sele articulos
								set order to art_codi
								seek articulo
								if articulo<>4 and allt(.grid1.text)<>allt(art_desc)
									sele articulos_clientes
									set order to artcli
									seek str(codicli)+str(articulo)
									if found()
										sele desc_articulos_clientes
										set order to dacartcli
										seek str(articulos_clientes.artcli_codi)+allt(.grid1.text)
										if found()
											repla pedidos_articulos.dac_codi with dac_codi
										endif
									endif
								else
									if pedidos_articulos.dac_codi>0
										repla pedidos_articulos.dac_codi with 0
									endif
								endif
								sele pedidos_articulos
								.grid1.col=1
								if articulo<>4
									do case
										case val(.grid1.text)>artped_cant
											dife=val(.grid1.text)-artped_cant
										case val(.grid1.text)<artped_cant
											dife=artped_cant-val(.grid1.text)
									endcase
									sele articulos
									set order to art_codi
									seek articulo
									.grid1.col=1
									do case
										case auxart<>pedidos_articulos.art_codi
											repla articulos.pedidos with articulos.pedidos+val(.grid1.text)
										case auxart=pedidos_articulos.art_codi and val(.grid1.text)>pedidos_articulos.artped_cant
											repla articulos.pedidos with articulos.pedidos+dife
										case auxart=pedidos_articulos.art_codi and val(.grid1.text)<pedidos_articulos.artped_cant
											repla articulos.pedidos with articulos.pedidos-dife
									endcase
								endif
								sele pedidos_articulos
								.grid1.col=1
								repla artped_cant with val(.grid1.text)
								.grid1.col=5
								repla artped_precio with val(.grid1.text)
								.grid1.col=7
								if len(.grid1.text)>0
									repla alter_iva with val(.grid1.text)
								else
									repla alter_iva with 0
								endif
							endif
						next fila
					endif
					if !eof()
						skip
					endif
				endif
				unlock
				ivari=val(.text9.value)
				ivarni=val(.text11.value)
				totalri=val(.text18.value)+val(.text9.value)
				totalrni=val(.text18.value)+val(.text9.value)+val(.text11.value)
				totsiva=val(.text18.value)
				if ped_codi=codped
					do while ped_codi=codped
						dele
						skip
					enddo
				endif
			endwith
			report form pedidocliente for pedidos.ped_codi=codped to printer prompt noconsole
			thisform.release
		endif
		endif
	ENDPROC

	PROCEDURE Command2.Click
		preg=messagebox("¿Seguro que desea Salir?",4+32+256,"Pedidos")
		if preg=6
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command3.Click
		with thisform

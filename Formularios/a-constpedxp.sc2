						if fila<.grid1.rows
							.grid1.row=fila
							if eof() or ped_codi<>codped
								appe blank
								repla ped_codi with codped
							else
								if fila>1
									skip
									if eof() or ped_codi<>codped
										appe blank
										repla ped_codi with codped
									endif
								endif
							endif
							.grid1.col=3
							if val(.grid1.text)=4
								.grid1.col=4
								repla artped_dasc with .grid1.text
								.grid1.col=3
							endif
							auxart=art_codi
							if val(.grid1.text)<>art_codi
								repla art_codi with val(.grid1.text)
							endif
							articulo=val(.grid1.text)
							.grid1.col=4
							sele articulos
							set order to art_codi
							seek articulo
							if articulo<>4 and allt(.grid1.text)<>allt(art_desc)
								sele articulos_clientes
								set order to artcli
								seek str(codicli)+str(articulo)
								if found()
									sele desc_articulos_clientes
									set order to dacartcli
									seek str(articulos_clientes.artcli_codi)+allt(.grid1.text)
									if found()
										repla pedidos_articulos.dac_codi with dac_codi
									endif
								endif
							else
								if pedidos_articulos.dac_codi>0
									repla pedidos_articulos.dac_codi with 0
								endif
							endif
							sele pedidos_articulos
							.grid1.col=1
							if articulo<>4
								do case
									case val(.grid1.text)>artped_cant
										dife=val(.grid1.text)-artped_cant
									case val(.grid1.text)<artped_cant
										dife=artped_cant-val(.grid1.text)
								endcase
								sele articulos
								set order to art_codi
								seek articulo
								.grid1.col=1
								do case
									case auxart<>pedidos_articulos.art_codi
										repla articulos.pedidos with articulos.pedidos+val(.grid1.text)
									case auxart=pedidos_articulos.art_codi and val(.grid1.text)>pedidos_articulos.artped_cant
										repla articulos.pedidos with articulos.pedidos+dife
									case auxart=pedidos_articulos.art_codi and val(.grid1.text)<pedidos_articulos.artped_cant
										repla articulos.pedidos with articulos.pedidos-dife
								endcase
							endif
							sele pedidos_articulos
							.grid1.col=1
							repla artped_cant with val(.grid1.text)
							.grid1.col=5
							repla artped_precio with val(.grid1.text)
							.grid1.col=7
							if len(.grid1.text)>0
								repla alter_iva with val(.grid1.text)
							else
								repla alter_iva with 0
							endif
						endif
					next fila
				endif
				if !eof()
					skip
				endif
				if ped_codi=codped
					do while ped_codi=codped
						dele
						skip
					enddo
				endif
			endif
			unlock
		endif
		endwith
	ENDPROC

	PROCEDURE Command4.Click
		aux=codp
		do form tranload with transporte,coditran
		coditran1=coditran
		if transporte<>" "
			thisform.text14.value=transporte
			codp=aux
			thisform.edit1.setfocus
		endif
	ENDPROC

	PROCEDURE Command5.Click
		sele presupuestos
		set order to presup_cod
		seek codp
		validez=allt(presup_ofer)
		plazo=allt(presup_plent)
		condpag=allt(presup_cond)
		lugent=allt(presup_lugent)
		observ=allt(presup_obser)
		do form piepresup with validez,plazo,condpag,lugent,observ
		
		
	ENDPROC

	PROCEDURE Command6.Click
		do form locavend with vcodi
		if vcodi>0
			sele vendedores
			set order to ven_codi
			seek vcodi
			thisform.text15.value=ven_codi
			thisform.text16.value=ven_nomb
		else
			thisform.text16.value=""
		endif
	ENDPROC

	PROCEDURE Command7.Click
		do form locapcom with letrapor
		if letrapor<>""
			sele porcencomi
			set order to porc_desc
			seek letrapor
			porcodi=porc_codi
			thisform.text20.value=porc_desc
			thisform.text21.value=porc_impo
		else
			thisform.text21.value=0
			porodi=0
		endif
	ENDPROC

	PROCEDURE Command8.Click
		aux=codp
		do form tranload with transporte,coditran
		coditran2=coditran
		if transporte<>" "
			thisform.text22.value=transporte
			codp=aux
			thisform.edit2.setfocus
		endif
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Edit2.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit2.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
		local x,y
		if item>0
			this.col=0
			aux=val(this.text)
			this.col=3
			dato1=val(this.text)
			this.col=1
			dato2=this.text
			this.col=4
			dato3=this.text
			this.col=5
			dato4=this.text
			this.col=6
			prtot=this.text
			this.col=2
			dato5=this.text
			do form modippreg with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		if borra=6
			with thisform
				this.col=6
				acu=acu-val(this.text)
				sele pedidos
				set order to ped_codi
				seek codped
				if found()
					sele pedidos_articulos
					set order to pedart
					seek str(codped)+str(dato1)
					.grid1.col=1
					repla articulos.pedidos with articulos.pedidos-val(.grid1.text)
					.grid1.col=3
					if val(.grid1.text)=4
						.grid1.col=4
						if .grid1.text<>artped_dasc
							do while art_codi=4 and !eof()
								if .grid1.text=artped_dasc
									exit
								endif
								skip
							enddo
						endif
					endif
					.grid1.col=3
		*			sele presupuestos_articulos
		*			set order to artpres
		*			seek str(codp)+str(dato1)
		*			if val(.grid1.text)=4
		*				if artpres_dasc<>pedidos_articulos.artped_dasc
		*					do while art_codi=4 and !eof()
		*						if artpres_dasc=pedidos_articulos.artped_dasc
		*							.grid1.col=1
		*							repla aceptados with aceptados-val(.grid1.text)
		*							exit
		*						endif
		*						skip
		*					enddo
		*				else
		*					.grid1.col=1
		*					repla aceptados with aceptados-val(.grid1.text)
		*				endif
		*			else
		*				.grid1.col=1
		*				repla aceptados with aceptados-val(.grid1.text)
		*			endif
				endif
				if this.rows=2
					item=item-1
					this.rows=1
					acu=0
					.text8.value=""
					.text9.value=""
					.text10.value=""
					.text11.value=""
					.text17.value=""
					.text18.value=""
					.text19.value=0
				else
					item=item-1
					this.removeitem(this.row)
					this.col=2
					x=1
					y=0
					do while x<=this.rows-1
						this.row=x
						y=y+1
						this.col=0
						this.text=allt(str(y))
						x=x+1
					enddo
				endif
			endwith
			borra=0
			insertar=0
		endif
		if insertar=1 and codigo<>0
			with thisform
				this.col=0
				nro=this.row
				if opcion=1
					sele articulos
					set order to art_codi
					seek codigo
					cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
					this.additem(" "+chr(9)+trim(cant)+chr(9)+articulos.art_med+chr(9)+allt(cadena)+chr(9)+descri+chr(9)+allt(pruni)+chr(9)+prtot,.grid1.row)
					acu=acu+val(prtot)
					item=item+1
					muestro=0
					opcion=0
				endif
				.grid1.row=nro
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				endif
				.grid1.col=0
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellalignment=3
				.grid1.col=2
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellalignment=8		
				x=1
				y=0
				filaux=this.row
				do while x<=this.rows-1
					this.row=x
					y=y+1
					this.col=0
					this.text=allt(str(y))
					x=x+1
				enddo
				this.row=filaux
				insertar=0
			endwith
		endif
	ENDPROC

	PROCEDURE grid1.GotFocus
		cond=clientes.cond_codi
		*on key label INS do form cualart with cond
		if localiz=1
			if elimi=0 and item>0
				thisform.grid1.toprow=item
			else
				elimi=0
			endif
		endif
	ENDPROC

	PROCEDURE Text1.GotFocus
		if localiz=1
			thisform.grid1.toprow=item
		endif
	ENDPROC

	PROCEDURE Text15.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text15.Valid
		if this.value>0
			sele vendedores
			set order to ven_codi
			seek this.value
			if found()
				thisform.text16.value=allt(ven_nomb)
			else
				=messagebox("Vendedor no está en archivo",0+48,"Advertencia!!!")
				this.value=0
				return 0
			endif
		else
			thisform.text16.value=""
		endif
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			local acuaux,auxiva,ivadif,ivaitem
			acuaux=0
			auxiva=0
			ivadif=0
			ivaitem=0
			for i=1 to .grid1.rows-1
				.grid1.row=i
				.grid1.col=7
				if len(.grid1.text)>0
					ivaitem=val(.grid1.text)
					.grid1.col=6
					dto=val(.grid1.text)*this.value/100
					acuaux=acuaux+val(.grid1.text)-dto
					dto=val(.grid1.text)-dto
					ivaitem=dto*ivaitem/100
					ivadif=ivadif+ivaitem
				endif
			next i
			dtotot=acu*this.value/100
			.text17.value=str(dtotot,10,2)
			.text18.value=str(acu-dtotot,10,2)
			if clientes.cond_codi=2
				dife=acu-dtotot-acuaux
				auxiva=dife*impiva1/100
				.text9.value=str(auxiva+ivadif,10,2)
			endif
			.text10.value=str(val(.text18.value)+val(.text9.value)+val(.text11.value),10,2)
		endwith
		
		
	ENDPROC

	PROCEDURE Text20.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text20.Valid
		if this.value<>""
			sele porcencomi
			set order to porc_desc
			seek allt(this.value)
			if found()
				porcodi=porc_codi
				thisform.text21.value=porc_impo
			else
				=messagebox("Porcentaje de Comisión no está en archivo",0+48,"Advertencia!!!")
				this.value=""
				return 0
			endif
		else
			thisform.text21.value=0
			porodi=0
		endif
	ENDPROC

	PROCEDURE Text21.Click
		this.setfocus
	ENDPROC

ENDDEFINE

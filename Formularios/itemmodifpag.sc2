DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 214,214,214
		BorderStyle = 0
		Caption = "Pagos de Clientes"
		DoCreate = .T.
		Height = 136
		Icon = imagen\litening.ico
		MaxButton = .F.
		Name = "Form1"
		ShowWindow = 1
		Width = 232
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		Caption = "\<Aceptar", ;
		Height = 26, ;
		Left = 69, ;
		Name = "Command1", ;
		Top = 83, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 214,214,214, ;
		Caption = "Item a Modificar: ", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 32, ;
		Name = "Label1", ;
		Top = 35, ;
		Width = 99
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Text1' AS textbox WITH ;
		Alignment = 1, ;
		ControlSource = "item", ;
		Format = "K", ;
		Height = 23, ;
		InputMask = "###", ;
		Left = 137, ;
		Name = "Text1", ;
		Top = 30, ;
		Width = 48
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		parameter nitem
	ENDPROC

	PROCEDURE Unload
		return nitem
	ENDPROC

	PROCEDURE Command1.Click
		if thisform.text1.value>0
			preg=messagebox("¿Confirma el Item a modificar?",4+32+256,"Pagos")
			if preg=6
				nitem=thisform.text1.value
				thisform.release
			endif
		endif
		
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			if this.value>0
				preg=messagebox("¿Confirma el Item a modificar?",4+32+256,"Pagos")
				if preg=6
					nitem=this.value
					thisform.release
				endif
			endif
		endif
					
	ENDPROC

ENDDEFINE

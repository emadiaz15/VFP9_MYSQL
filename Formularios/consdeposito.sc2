		CAPSLOCK(.T.)
	ENDPROC

	PROCEDURE edt_obser.LostFocus
		CAPSLOCK(.F.)
	ENDPROC

	PROCEDURE grd_cheques.AfterRowColChange
		LPARAMETERS nColIndex
	ENDPROC

	PROCEDURE grd_cheques.DblClick
		LOCAL xrpg,xtip
		
		xrpg=cur_valores.recpag_codi
		xtip=thisform.xtipo
		
		DO FORM conscheqrap WITH xrpg,xtip
	ENDPROC

	PROCEDURE txt_banco.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_fechadep.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_nbol.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_tipodep.Click
		this.SetFocus
	ENDPROC

ENDDEFINE


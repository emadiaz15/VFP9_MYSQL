	PROCEDURE Destroy
		SET POINT TO thisform.punto
		SET SEPARATOR TO thisform.separador
	ENDPROC

	PROCEDURE Init
		PARAMETERS xdepo
		
		thisform.xndepo = xdepo
		
		SET DELETED ON
		
		thisform.punto=SET("POINT")
		thisform.separador=SET("SEPARATOR")
		
		SET POINT TO ","
		SET SEPARATOR TO "."
		
		frmcondep= conectar_db(_screen.cn)
			SQLEXEC(frmcondep,"select a.*,b.banc_desc,b.banc_ncta from depositos a inner join bancos_caja b on a.banc_codi = b.banc_codi where a.dep_codi=?xdepo;;","cur_condep")
			SQLEXEC(frmcondep,"select a.chequenro,a.movtippag_fvto,DATE_ADD(a.movtippag_fvto,INTERVAL 30 DAY),b.ban_desc,a.movtippag_pza,a.movtippag_imp,a.recpag_codi,a.tippag_codi,a.dep_codi from recibos_pagos a inner join bancos b on a.ban_codi = b.ban_codi where a.dep_codi=?xdepo;","cur_valores")
		desconectar_db(frmcondep)
		
		IF RECCOUNT("cur_condep")>0
			SELECT cur_condep
			thisform.txt_banco.Value=ALLTRIM(cur_condep.banc_desc)
			thisform.txt_nbol.Value=ALLTRIM(cur_condep.dep_bolnro)
			thisform.txt_fechadep.Value=cur_condep.dep_fech
			IF LEN(ALLTRIM(cur_condep.banc_ncta))>0
				thisform.etq_cuenta.Caption="Número de Cuenta: "+ALLTRIM(cur_condep.banc_ncta)
			ENDIF
			thisform.edt_obser.Value=ALLTRIM(cur_condep.dep_obser)
			thisform.txt_total.Value=cur_condep.dep_importe
			IF RECCOUNT("cur_valores")>0
				SELECT cur_valores
				LOCATE
				DO case
					CASE cur_valores.tippag_codi = 3
						thisform.xtipo=1
						thisform.txt_tipodep.Value="CHEQUES FÍSICOS"
					CASE cur_valores.tippag_codi = 20
						thisform.xtipo=2
						thisform.txt_tipodep.Value="ECHEQS"
				ENDCASE
				thisform.grd_cheques.RecordSource="cur_valores"
				thisform.grd_cheques.Refresh()
			ENDIF
			LOCAL lcletra
			do monto2letra with thisform.txt_total.value,lcletra in ntoletra
		
			SELECT COUNT(*) cant FROM cur_valores INTO ARRAY ar_cntc
			
			thisform.lbl_cancheq.Caption=IIF(ar_cntc[1,1]>0,"Cantidad de "+PROPER(LOWER(ALLTRIM(thisform.txt_tipodep.Value)))+" Depositados "+ALLTRIM(STR(ar_cntc[1,1])),"")
			thisform.lbl_totletra.Caption=IIF(thisform.totaldep>0,PROPER(LOWER("SON EN TOTAL: "+ALLTRIM(lcletra))),"")	
		ENDIF
	ENDPROC

	PROCEDURE bnt_impirmir.Click
		IF USED("cur_valores")
			IF RECCOUNT("cur_valores") > 0
				SELECT cur_valores
				INDEX on dep_codi TO SYS(2015)
				SELECT cur_condep
				INDEX on dep_codi TO SYS(2015)
				SET RELATION TO dep_codi INTO cur_valores ADDITIVE
				SELECT cur_valores
				GO TOP
				REPORT FORM boletadep FOR cur_valores.dep_codi = thisform.xndepo TO PRINTER PROMPT NOCONSOLE
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE bnt_impirmir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE bnt_impirmir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE cmd_salir.Click
		thisform.Release
		
	ENDPROC

	PROCEDURE cmd_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE cmd_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Ctn_banner.Init
		this.Height=90
		this.left=0
		this.Width=this.Parent.Width
	ENDPROC


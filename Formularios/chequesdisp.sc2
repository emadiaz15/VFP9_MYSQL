	PROCEDURE Destroy
		_screen.deposito=.F.
		SET POINT TO thisform.punto
		SET SEPARATOR TO thisform.separador
	ENDPROC

	PROCEDURE Init
		parameters numero,banco,plaza,fechavto,valor,cuit,valorcheq,rpgcodi,rpgcodig,xtipo
		
		thisform.punto=SET("POINT")
		thisform.separador=SET("SEPARATOR")
		
		SET POINT TO ","
		SET SEPARATOR TO "."
		
		IF _screen.deposito=.T.
			thisform.label6.Caption="Depositado"
			thisform.label6.Left=35
		ENDIF
		
		DO case
			CASE xtipo = 1
				IF _screen.deposito = .T.
					this.Caption="Cheques Disponibles para Depositar"
					thisform.command1.Caption="\<Agregar Cheque al depósito"
				ELSE
					this.Caption="Cheques Disponibles para efecutar el Pago"
					thisform.command1.Caption="\<Efectuar pago con este cheque"
				ENDIF
			CASE xtipo = 2
				IF _screen.deposito = .T.
					this.Caption="Echeqs Disponibles para Depositar"
					thisform.command1.Caption="\<Agregar Echeq al depósito"
				ELSE
					this.Caption="Echeqs Disponibles para efecutar el Pago"
					thisform.command1.Caption="\<Efectuar pago con este echeq"
				ENDIF
				this.BackColor=RGB(41,75,100)
		ENDCASE
		
		sele cheq
		frmchqdis= conectar_db(_screen.cn)
			DO case
				CASE xtipo = 1
					SQLEXEC(frmchqdis,"call usp_cheqcar(1);","cur_chcar")
				CASE xtipo = 2
					SQLEXEC(frmchqdis,"call usp_cheqcar(2);","cur_chcar")
			ENDCASE
			IF RECCOUNT("cur_chcar")>0
				GO top
				SELECT * FROM cur_chcar WHERE recpag_codi not in (select * from cheq WHERE NOT DELETED()) into cursor cheques
				IF _screen.deposito=.F.
					ThisForm.grid1.SetAll("DynamicFontBold", "IIF(movtippag_imp<=valorcheq, (.T.),(.F.))", "Column")	
				ENDIF
				thisform.grid1.recordsourcetype=1
				thisform.grid1.recordsource="cheques"
				thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
				with thisform
					.text1.value=cheques.chequenro
					.text2.value=cheques.vencimiento
					.text3.value=cheques.cli_nomb
					.text4.value=cheques.ban_desc
					.text5.value=cheques.movtippag_imp
				endwith
			ENDIF
		desconectar_db(frmchqdis)
		
			  * and allt(a.movtippag_nro) not in (select * from cheq) ;
		ThisForm.grid1.SetAll("DynamicForeColor", "IIF(movtippag_imp<=valorcheq, RGB(225,0,113), RGB(0,0,0))", "Column")
		
		
		* and a.movtippag_fvto+30>=date()
		
		
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(215,215,215)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Unload
		return numero
		return banco
		return plaza
		return fechavto
		return valor
		return cuit
		DO CASE
			CASE _screen.tipopago = "mercaderia"
				return rpgcodi
			CASE _screen.tipopago = "gasto"
				return rpgcodig
		OTHERWISE
			RETURN rpgcodi
		ENDCASE
	ENDPROC

	PROCEDURE Command1.Click
		numero=cheques.chequenro &&Caracter
		banco=cheques.ban_desc &&Caracter
		plaza=cheques.movtippag_pza &&Caracter
		fechavto=cheques.movtippag_fvto &&Fecha
		valor=cheques.movtippag_imp &&Double
		cuit=VAL(cheques.cli_cuit) &&Caracter
		DO CASE
			CASE _screen.tipopago = "mercaderia"
				rpgcodi=cheques.recpag_codi &&Entero
			CASE _screen.tipopago = "gasto"
				rpgcodig=cheques.recpag_codi &&Entero
		OTHERWISE
			rpgcodi=cheques.recpag_codi
		ENDCASE
		idcheq=cheques.cheqid &&Caracter
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		numero=""
		banco=""
		plaza=""
		fechavto=ctod("  /  /    ")
		valor=0
		cuit=0
		DO CASE
			CASE _screen.tipopago = "mercaderia"
				rpgcodi=0
			CASE _screen.tipopago = "gasto"
				rpgcodig=0
		ENDCASE
		p=7
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		with thisform
			.text1.value=cheques.chequenro
			.text2.value=cheques.vencimiento
			.text3.value=cheques.cli_nomb
			.text4.value=cheques.ban_desc
			.text5.value=cheques.movtippag_imp
		endwith
	ENDPROC

ENDDEFINE


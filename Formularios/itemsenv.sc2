	PROCEDURE Activate
		SELECT cur_itemsped
		LOCATE
		
		thisform.grd_itped.RecordSource=''
		thisform.grd_itped.Refresh
		thisform.grd_itped.RecordSource="cur_itemsped"
		thisform.grd_itped.SetAll("DynamicBackColor","Thisform.Colorfila(cur_itemsped.selart)","Column")
		thisform.grd_itped.SetAll("DynamicForeColor","Thisform.Colorletra(cur_itemsped.selart,cur_itemsped.art_med)","Column")
		thisform.grd_itped.COLUMN1.DynamicBackColor='RGB(144,238,144)'
	ENDPROC

	PROCEDURE colorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = .T.
					lnColor = RGB(0,120,215)
				CASE tnsel = .F.
					lnColor = RGB(255,255,255)
			ENDCASE
		Return(lnColor)
		
		
	ENDPROC

	PROCEDURE colorletra
		LParameters tnsel,tnalt
		
		Local ltColor
		
			DO case
				CASE tnsel = .T. AND tnalt <> 'ALT'
					ltColor = RGB(255,255,255)
				CASE tnsel = .T. AND tnalt = 'ALT'
					ltColor = RGB(0,255,0)
				CASE tnsel = .F. AND tnalt <> 'ALT'
					ltColor = RGB(0,0,0)
				CASE tnsel = .F. AND tnalt = 'ALT'
					ltColor = RGB(255,0,0)
			ENDCASE
		Return(ltColor)
	ENDPROC

	PROCEDURE envifac
		LPARAMETERS lcodfa
		
		LOCAL ncade1,ncade2
		
		SET DECIMALS TO 3
		*!*	frmitrem= conectar_db(_screen.cn)
		*!*		SQLEXEC(frmitrem,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dac_desc,a.artped_codi from pedidos_articulos a INNER JOIN articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.ped_codi=?lcodp;","cur_carped")
		*!*	desconectar_db(frmitrem)
		frmitrem= conectar_db(_screen.cn)
			SQLEXEC(frmitrem,"select fac_tipo,fac_pto,fac_nro from facturas where fac_codi=?lcodfa;","cur_ffn")
			ncade1=REPLICATE("0",4-LEN(ALLTRIM(STR(cur_ffn.fac_pto))))+ALLTRIM(STR(cur_ffn.fac_pto))
			ncade2=REPLICATE("0",8-LEN(ALLTRIM(STR(cur_ffn.fac_nro))))+ALLTRIM(STR(cur_ffn.fac_nro))
			SQLEXEC(frmitrem,"call usp_itemsenv(?lcodfa);","cur_facarti")
		desconectar_db(frmitrem)
		SET DECIMALS TO
		cerrar_cursor("cur_ffn")
		this.caption="Envio de la factura  Nº "+ncade1+"-"+ncade2+" de "+ALLTRIM(cur_clie.cli_nomb)
		rta=0
		i=1
		item=1
		x=0
		y=0
		b=0
		con=0
		SELECT cur_facarti
		
		LOCATE
		*!*	con=RECCOUNT("cur_carped")
		*!*	COUNT FOR cur_carped.artped_ent>0 TO x
		*!*	COUNT FOR cur_carped.artped_ent>0 AND cur_carped.artped_ent<cur_carped.artped_cant TO y
		
		*!*	do case
		*!*		case x>0 and x=con and y>0
		*!*			messagebox("Este pedido ya fue enviado pero aún quedan items"+chr(13)+ ;
		*!*					   "con cantidades pendientes. Seleccione los items pendientes.",0+64,"Información importante")
		*!*		case x>0 and x=con and y=0
		*!*			messagebox("Este pedido ya fue enviado en su totalidad.",0+64,"Información importante")
		*!*			this.release
		*!*			do form pediload with lcodicli
		*!*		case x>0 and x<con
		*!*			messagebox("Este pedido ya fue enviado pero aún "+chr(13)+ ;
		*!*	                  "quedan items pendientes. Seleccione "+chr(13)+ ;
		*!*	                  "los items pendientes.",0+64,"Información importante")
		*!*	ENDCASE
		*selart L,nro_it N(5),artped_cant N(10,2),art_med C(3),art_codi N(8),art_desc M,dac_codi N(8),artped_codi N(8),artfac_sstock C(1)
		
		SELECT .F. as selart,00000 as nro_it,artfac_cant-IIF(ISNULL(farrer_cant),0,farrer_cant) as artped_cant,art_med,art_codi, ;
			   padr(left(IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artfac_dasc),len(IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artfac_dasc))),254," ") as art_desc, ;
			   dac_codi,artped_codi,artfac_sstock,far_codi FROM cur_facarti INTO CURSOR cur_itemsped readwrite
		LOCATE
		
		RETURN
		
	ENDPROC

	PROCEDURE enviped
		LPARAMETERS lcodp,lcodicli
		
		SET DECIMALS TO 3
		frmitrem= conectar_db(_screen.cn)
			SQLEXEC(frmitrem,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dac_desc,a.artped_codi from pedidos_articulos a INNER JOIN articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.ped_codi=?lcodp;","cur_carped")
		desconectar_db(frmitrem)
		SET DECIMALS TO
		this.caption="Envio del pedido  Nº "+allt(STR(lcodp))+" de "+ALLTRIM(cur_clie.cli_nomb)
		rta=0
		i=1
		item=1
		x=0
		y=0
		b=0
		con=0
		GO top
		con=RECCOUNT("cur_carped")
		COUNT FOR cur_carped.artped_ent>0 TO x
		COUNT FOR cur_carped.artped_ent>0 AND cur_carped.artped_ent<cur_carped.artped_cant TO y
		
		do case
			case x>0 and x=con and y>0
				messagebox("Este pedido ya fue enviado pero aún quedan items"+chr(13)+ ;
						   "con cantidades pendientes. Seleccione los items pendientes.",0+64,"Información importante")
			case x>0 and x=con and y=0
				messagebox("Este pedido ya fue enviado en su totalidad.",0+64,"Información importante")
				this.release
				do form pediload with lcodicli
			case x>0 and x<con
				messagebox("Este pedido ya fue enviado pero aún "+chr(13)+ ;
		                  "quedan items pendientes. Seleccione "+chr(13)+ ;
		                  "los items pendientes.",0+64,"Información importante")
		ENDCASE
		
		SELECT .F. as selart,00000 as nro_it,artped_cant-artped_ent as artped_cant,art_med,art_codi, ;
			   padr(left(IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artped_dasc),len(IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artped_dasc))),254," ") as art_desc, ;
			   dac_codi,artped_codi,'' as artfac_sstock,0 as far_codi FROM cur_carped WHERE artped_ent<artped_cant INTO CURSOR cur_itemsped readwrite
		GO top
		
		RETURN
		
	ENDPROC

	PROCEDURE Init
		parameter codp,codfa,cond,codicli
		public rta,f,b,x,con,y,localiz,elimi
		*!*	MESSAGEBOX("codp: "+ALLTRIM(STR(codp))+CHR(13)+ ;
		*!*			   "codfa: "+ALLTRIM(STR(codfa))+CHR(13)+ ;
		*!*			   "cond: "+ALLTRIM(STR(cond))+CHR(13)+ ;
		*!*			   "codicli: "+ALLTRIM(STR(codicli)),64,"Informes")
		CREATE CURSOR cur_itemsped(selart L,nro_it N(5),artped_cant N(10,2),art_med C(3),art_codi N(8),art_desc M,dac_codi N(8),artped_codi N(8),artfac_sstock C(1),far_codi N(10))
		localiz=0
		elimi=0
		
		DO case
			CASE codp>0
				thisform.enviped(codp,codicli)
			CASE codfa>0
				thisform.xcodfa=codfa
				thisform.envifac(codfa)
		ENDCASE
		
		LOCAL itp
		itp=1
		SCAN
			REPLACE nro_it WITH itp
			itp=itp+1
		ENDSCAN
		GO top
		
		cerrar_cursor("cur_carped")
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL xcodsel,xcodfa
		xcodsel=0
		SELECT cur_itemsped
		GO top
		
		rta=1
		
		SCAN FOR selart=.T.
			xcodsel=cur_itemsped.art_codi
			frmitrem= conectar_db(_screen.cn)
				SQLEXEC(frmitrem,"select * from articulos where art_codi=?xcodsel;","cur_arex")
			desconectar_db(frmitrem)
			xcodfa=thisform.xcodfa
			IF thisform.xcodfa>0
				IF cur_itemsped.artfac_sstock='S'
					if cur_arex.art_stock-cur_itemsped.artped_cant<0 and cur_arex.art_codi>5
						do form excedestenv with rta,xcodfa
						exit
					ENDIF
				ENDIF
			ELSE
				if cur_arex.art_stock-cur_itemsped.artped_cant<0 and cur_arex.art_codi>5
					do form excedestenv with rta,xcodfa
					exit
				ENDIF
			ENDIF
			SELECT cur_itemsped
		ENDSCAN
		if rta=1
			codiprov=0
			codifac=0
			do form altaremito with xcodfa,codp,codicli,codiprov
			thisform.hide
		ELSE
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command1.OLEDrag
		LPARAMETERS lDetectDrag
		this.command1.enabled=.T.
	ENDPROC

	PROCEDURE Command2.Click
		DO case
			CASE thisform.estadosel=0
				UPDATE cur_itemsped SET selart=.T.
				this.Caption="\<Deseleccionar Todos"
				thisform.command1.enabled=.T.
				thisform.estadosel=1
			CASE thisform.estadosel=1
				UPDATE cur_itemsped SET selart=.F.
				this.Caption="\<Seleccionar Todos"
				thisform.command1.enabled=.F.
				thisform.estadosel=0
		ENDCASE
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE grd_itped.Column1.Check1.Click
		LOCAL cantsel,ubireg
		cantsel=0
		ubireg=0
		
		SELECT cur_itemsped
		ubireg=RECNO()
		LOCATE
		COUNT ALL FOR selart=.T. TO cantsel
		GO ubireg
		
		IF cantsel>0
			thisform.command2.Caption="\<Deseleccionar Todos"
			thisform.command1.enabled=.T.
			thisform.estadosel=1
		ELSE
			thisform.command2.Caption="\<Seleccionar Todos"
			thisform.command1.enabled=.F.
			thisform.estadosel=0
		ENDIF
	ENDPROC

ENDDEFINE

	PROCEDURE Init
		SET NOTIFY off
		thisform.text1.Value=0
		thisform.txt_tipo.Value=''
		thisform.txt_pto.Value=0
		thisform.txt_cbte.Value=0
		thisform.txt_fecha.Value=''
		
	ENDPROC

	PROCEDURE btn_cancel.Click
		thisform.Release
		
	ENDPROC

	PROCEDURE btn_cancel.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE btn_cancel.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE btn_cont.Click
		thisform.txt_cbte.SetFocus
		pasrecep=1
		DO FORM consrecep WITH thisform.xcodire,thisform.xcond
	ENDPROC

	PROCEDURE btn_cont.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE btn_cont.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Combo1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Combo1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			LOCAL xdesc
			for i=1 to this.listcount
				if this.selected(i)
					frmnumrec= conectar_db(_screen.cn)
						xdesc=allt(this.list(i))
						SQLEXEC(frmnumrec,"select * from proveedores where TRIM(prov_nomb)=?xdesc order by prov_nomb;","cur_loprov")
					desconectar_db(frmnumrec)
					IF RECCOUNT("cur_loprov")>0
						thisform.xcond=cur_loprov.cond_codi
						thisform.text1.Value=cur_loprov.prov_codi
						thisform.txt_cuit.Value=VAL(cur_loprov.prov_cuit)
						thisform.txt_tipo.Value  =IIF(ISNULL(cur_loprov.prov_ultiletra),"",cur_loprov.prov_ultiletra)
						thisform.txt_pto.Value  =IIF(ISNULL(cur_loprov.prov_ultipto),0,cur_loprov.prov_ultipto)
						thisform.combo1.rowsource="select prov_nomb from cur_loprov into cursor combo1"
						thisform.combo1.value=thisform.combo1.list(1)
						thisform.txt_tipo.Enabled= .T.
						thisform.txt_pto.Enabled= .T.
						thisform.txt_cbte.Enabled= .T.				
					ENDIF
		*!*				cerrar_cursor("cur_per")
					KEYBOARD '{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE Combo1.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade='%'+subst(allt(this.text),2,len(allt(this.text)))+'%'
				frmnumrec= conectar_db(_screen.cn)
					SQLEXEC(frmnumrec,"select prov_nomb from proveedores where prov_nomb like ?cade order by prov_nomb;","cur_loprov")
				desconectar_db(frmnumrec)
				IF RECCOUNT("cur_loprov")>0
					this.rowsource="select prov_nomb from cur_loprov INTO CURSOR combo1"
					this.value=this.list(1)
					keyboard "{F4}"
				ELSE
					MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
					this.Value=""			
				ENDIF
				RETURN .F.
		*!*			cerrar_cursor("cur_per")
			else
				if len(allt(this.text))>0
					cade=ALLTRIM(this.text)+'%'
					frmnumrec= conectar_db(_screen.cn)
						SQLEXEC(frmnumrec,"select prov_nomb from proveedores where prov_nomb like ?cade order by prov_nomb;","cur_loprov")
					desconectar_db(frmnumrec)
					IF RECCOUNT("cur_loprov")>0
						this.rowsource="select prov_nomb from cur_loprov INTO CURSOR combo1"
						this.value=this.list(1)
							keyboard "{F4}"
					ELSE
						MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
						this.Value=""				
					ENDIF
					RETURN .F.
		*!*				cerrar_cursor("cur_per")
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Text1.Click
		this.value=0
		this.setfocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		*!*	thisform.combo1.rowsourcetype=3
	ENDPROC

	PROCEDURE Text1.Valid
		
		if this.value>0
			frmnumrec= conectar_db(_screen.cn)
				SQLEXEC(frmnumrec,"select * from proveedores where prov_codi=?this.value;","cur_loprov")
			desconectar_db(frmnumrec)
			if RECCOUNT("cur_loprov")>0
				thisform.xcond=cur_loprov.cond_codi
				thisform.txt_cuit.Value=VAL(cur_loprov.prov_cuit)
				thisform.txt_tipo.Value  =IIF(ISNULL(cur_loprov.prov_ultiletra),"",cur_loprov.prov_ultiletra)
				thisform.txt_pto.Value  =IIF(ISNULL(cur_loprov.prov_ultipto),0,cur_loprov.prov_ultipto)
				thisform.combo1.rowsource="select prov_nomb from cur_loprov into cursor combo1"
				thisform.combo1.value=thisform.combo1.list(1)
				thisform.txt_tipo.Enabled= .T.
				thisform.txt_pto.Enabled= .T.
				thisform.txt_cbte.Enabled= .T.
		*!*			cerrar_cursor("cur_per")		
				keyboard '{TAB}'
			else
				=messagebox("Proveedor no está en archivo",0+48,"Advertencia")
				this.value=0
				return .F.
			endif
		endif
	ENDPROC

	PROCEDURE txt_cbte.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE txt_cbte.Valid
		IF this.Value>0
			thisform.xcodire          =0
			thisform.txt_fecha.Value  =''
			thisform.txt_subt.Value   =0
			thisform.txt_ng.Value     =0
			thisform.txt_iva21.Value  =0
			thisform.txt_iva105.Value =0
			thisform.txt_percep.Value =0
			thisform.txt_total.Value  =0
			local xtip,xpto,xfac,xcadebus,xcodpro
			xcodpro=thisform.text1.Value
			xtip=allt(thisform.txt_tipo.value)
			xpto=allt(str(thisform.txt_pto.value))
			xfac=allt(str(this.value))
			xcadebus=ALLTRIM(STR(xcodpro))+xtip+'PTO'+xpto+'NRO'+xfac+'F'
			frmnumrec= conectar_db(_screen.cn)
				SQLEXEC(frmnumrec,"call usp_buscarprov(?xcodpro);","cur_prov")
				SQLEXEC(frmnumrec,"select * from recepciones where concat(CAST(prov_codi as char),TRIM(prov_tipfac),'PTO',TRIM(CAST(prov_pto as char)),'NRO',TRIM(CAST(prov_fac as char)),TRIM(recep_conc))=?xcadebus;","cur_recexis")
			desconectar_db(frmnumrec)
			IF RECCOUNT("cur_recexis")>0
				thisform.xcodire          =cur_recexis.recep_codi
				thisform.txt_fecha.Value  =cur_recexis.recep_fec
				thisform.txt_subt.Value   =cur_recexis.neto_1+cur_recexis.neto_2
				thisform.txt_ng.Value     =cur_recexis.recep_impng
				thisform.txt_iva21.Value  =cur_recexis.recep_ivari		
				thisform.txt_iva105.Value =cur_recexis.recep_ivarni
				thisform.txt_percep.Value =cur_recexis.perc_iva+cur_recexis.perc_btos
				thisform.txt_total.Value  =thisform.txt_subt.Value+thisform.txt_ng.Value+ ;
										   thisform.txt_iva21.Value+thisform.txt_iva105.Value+ ;
										   thisform.txt_percep.Value
				thisform.btn_cont.Enabled= .T.
				KEYBOARD '{TAB}'
			ELSE
				MESSAGEBOX("Comprobante no se encuentra en archivo.",0+48,"Aviso del Sistema")
				thisform.btn_cont.Enabled= .F.
				this.Value=0
				return .F.
			ENDIF
		ENDIF
		
		
		
		*!*	IF this.Value>0
		*!*		frmnpres= conectar_db(_screen.cn)
		*!*			SQLEXEC(frmnpres,"select a.*,b.cli_nomb,b.cond_codi from presupuestos a inner join clientes b on a.cli_codi=b.cli_codi where a.presup_codi=?this.value;","cur_presn")
		*!*		desconectar_db(frmnpres)
		*!*		IF RECCOUNT("cur_presn")>0
		*!*			thisform.txt_fecha.Value   =cur_presn.presup_fech
		*!*			thisform.txt_cliente.Value =cur_presn.cli_nomb
		*!*			thisform.npres=cur_presn.presup_codi
		*!*			cond=cur_presn.cond_codi
		*!*			codicli=cur_presn.cli_codi
		*!*			thisform.btn_cont.Enabled= .T.
		*!*			KEYBOARD '{TAB}'
		*!*		ELSE
		*!*			MESSAGEBOX("Presupuesto no se encuentra en archivo.",0+48,"Aviso del Sistema")
		*!*			thisform.btn_cont.Enabled= .F.
		*!*			this.Value=0
		*!*			return .F.
		*!*		ENDIF
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE txt_pto.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE txt_tipo.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

ENDDEFINE

	ENDPROC

	PROCEDURE Btn_money1.Image1.Click
		frmconpres= conectar_db(_screen.cn)
			SQLEXEC(frmconpres,"select * from histocoti where hiscot_fecha=?thisform.text13.value order by hiscot_fecha desc limit 1;","cur_cotdia")
			IF RECCOUNT("cur_cotdia")>0
				MESSAGEBOX("     DOLAR VIGENTE AL DÍA DEL PRESUPUESTO"+CHR(13)+CHR(13)+ ;
						   "U$S 1 = $ "+ALLTRIM(STR(cur_cotdia.hiscot_impo,14,2))+" - ACTUALIZ: "+ALLTRIM(TTOC(hiscot_fecha)),0+64,"COTIZACIONES MONEDA DOLAR")
			ELSE
				SQLEXEC(frmconpres,"select * from histocoti where hiscot_fecha<?thisform.text13.value order by hiscot_fecha desc limit 1;","cur_cotant")
				IF RECCOUNT("cur_cotant")>0
					MESSAGEBOX("     DOLAR VIGENTE AL DÍA DEL PRESUPUESTO"+CHR(13)+CHR(13)+ ;
							   "U$S 1 = $ "+ALLTRIM(STR(cur_cotant.hiscot_impo,14,2))+" - ACTUALIZ: "+ALLTRIM(TTOC(hiscot_fecha)),0+64,"COTIZACIONES MONEDA DOLAR")
				ENDIF
			ENDIF
		desconectar_db(frmconpres)
	ENDPROC


	PROCEDURE Command2.Click
		LOCAL opcodi, xcodp
		opcodi=''
		xcodp= thisform.xcodp
		frmpres = conectar_db(_screen.cn)
			SQLEXEC(frmpres,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dac_desc from presupuestos_articulos a INNER JOIN articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.presup_codi=?xcodp ORDER BY a.nro_regis;","cur_carpres")
		desconectar_db(frmpres)
		
		with thisform
			cantreg=RECCOUNT("cur_carpres")
			ivari=.text9.value
			ivarni=.text11.value
			totalri=.text18.value+.text9.value
			totalrni=.text18.value+.text9.value+.text11.value
			totsiva=.text18.value
		endwith
		
		SELECT cur_carpres
		GO top
		
		_screen.numepres = xcodp
		opcodi=''
		do form frm_imprimir with opcodi TO xopcodi
		
		DO case
			CASE xopcodi.prop01='I'
				set point to ","
				report form presupuesto for cur_carpres.presup_codi=xcodp TO PRINTER prompt noconsole
				SET POINT TO
			CASE xopcodi.prop01='E'
				thisform.excelautomatiz()
		ENDCASE
		
		
		
	ENDPROC


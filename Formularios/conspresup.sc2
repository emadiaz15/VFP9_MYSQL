	PROCEDURE gridart_config_colores_seguro
		=GridArt_ConfigurarColores(thisform)
		RETURN
	ENDPROC

	PROCEDURE gridart_refresh
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    thisform.gridart_setup()
		ELSE
		    =GridArt_RefrescarStockVisual(thisform)
		    thisform.gridart_config_colores_seguro()
		ENDIF
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockFormNative(thisform)
		ENDIF
		RETURN
	ENDPROC

	PROCEDURE gridart_setup
		SET PROCEDURE TO grid_articulos_ui ADDITIVE
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    =GridArt_BindNative(thisform, "grd_detalle", thisform.curarpres, "art_codi", "art_desc")
		    =GridArt_BindTooltipEvents(thisform)
		ENDIF
		=GridArt_RefrescarStockVisual(thisform)
		thisform.gridart_config_colores_seguro()
		thisform.gridart_sync_active_color()
		ON KEY LABEL ESC DO GridArt_OnEsc IN grid_articulos_ui
	ENDPROC

	PROCEDURE gridart_sync_active_color
		LPARAMETERS nColIndex
		LOCAL lnCol, loCol, lnBack, lnFore
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    RETURN
		ENDIF
		lnBack = GridArt_GetDynBack(thisform)
		lnFore = GridArt_GetDynFore(thisform)
		WITH thisform.grd_detalle
		    .HighlightStyle     = 0
		    .Highlight          = .F.
		    .HighlightBackColor = lnBack
		    .HighlightForeColor = lnFore
		    FOR lnCol = 1 TO 9
			    loCol = .Columns(lnCol)
			    IF PEMSTATUS(loCol, "Text1", 5)
			        loCol.Text1.BackColor  = lnBack
			        loCol.Text1.ForeColor  = lnFore
			        loCol.Text1.BorderStyle = 0
		        ENDIF
		    ENDFOR
		    .Refresh()
		ENDWITH
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockFormNative(thisform)
		ENDIF
		RETURN
	ENDPROC

	PROCEDURE grid_rightclick
		LOCAL lcShortcut, loRef
		m.loRef = THISFORM
		m.lcShortcut = SYS(2015)
		
		DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Ver Descripción Completa] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
		DEFINE BAR 2 OF (m.lcShortcut) PROMPT [\-]
		DEFINE BAR 3 OF (m.lcShortcut) PROMPT [Últimas Cotizaciones] PICTURE "C:\VFP9_MYSQL\imagen\img_buscar_01.png"
		=GridArt_AddStockMenuSeparator(m.lcShortcut, 4)
		=GridArt_AddStockMenuOption(m.lcShortcut, 5, m.loRef)
		=GridArt_AddListaComprasMenuOption(m.lcShortcut, 6)
		
		ON SELECTION BAR 1 OF (m.lcShortcut) m.loRef.Grid_ShowDesc()
		ON SELECTION BAR 3 OF (m.lcShortcut) m.loRef.Grid_ShowLastQuotes()
		
		ACTIVATE POPUP (m.lcShortcut)
		RELEASE POPUP (m.lcShortcut)
		
	ENDPROC

	PROCEDURE grid_showdesc
		
		IF USED((thisform.curarpres))
			IF VARTYPE(thisform.shp_datos)="U"
				SELECT (thisform.curarpres)
				thisform.AddObject("shp_datos","shape")
				WITH thisform.shp_datos
					.left    = 105
					.top     = 275
					.width   = 574
					.height  = 173
					.backcolor = RGB(140, 165, 176)
					.SpecialEffect = 0
					.Visible = .T.
				ENDWITH
					
				THISFORM. ADDOBJECT("edt_datos","EDITBOX")
				WITH THISform.edt_datos
					.left    = 117
					.top     = 288
					.width   = 550
					.height  = 125
					.disabledbackcolor = RGB(40,44,52)
					.forecolor = RGB(244,210,50)
					.fontsize  = 10
					.fontbold  = .T.
					.readonly  = .T.
					.value     = ALLTRIM(art_desc)
					.themes    = .F.
					.Visible   = .T.
				ENDWITH
				
				thisform.AddObject("cmd_datos","Commandbutton")
				WITH thisform.cmd_datos
					.left      = 333
					.top       = 416
					.width     = 108
					.height    = 27
					.themes    = .F.
					.forecolor = RGB(255,255,255)
					.backcolor = RGB(227,68,34)
					.alignment = 2
					.caption   = "\<Cerrar Ventana"
					.Visible   = .T.
					=BINDEVENT(ThisForm.cmd_datos, "Click", ThisForm, "datos_click")
					=BINDEVENT(ThisForm.cmd_datos, "MouseMove", ThisForm, "datos_mmove")
					=BINDEVENT(ThisForm.cmd_datos, "MouseLeave", ThisForm, "datos_mleave")
				ENDWITH
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE grid_showlastquotes
		THISFORM.AddProperty("oWait")
		
		IF TYPE("THISFORM.oWait") <> "O" OR ISNULL(THISFORM.oWait)   
			THISFORM.oWait = CREATEOBJECT("frmWait", "Procesando información...Espere...")
			THISFORM.oWait.Show()
			DOEVENTS
			INKEY(0.15) && 150 milisegundos para que pinte el label antes de ejecutar la query
			DOEVENTS
		ELSE
			THISFORM.oWait.SetMessage("Procesando información...Espere...")
		ENDIF
		
		LOCAL xarticulo, xcliente, xdescart
		LOCAL xresult, xcQuery
		LOCAL lcTmp, lcDbf
		LOCAL frmaltapr, xreaj, xdolar
		LOCAL xpunto, xsepar
		
		IF !USED(THISFORM.curarpres) OR RECCOUNT(THISFORM.curarpres) = 0
		    RETURN
		ENDIF
		
		SELECT (THISFORM.curarpres)
		xarticulo = art_codi
		xdescart  = LEFT(ALLTRIM(art_desc), 60)
		
		IF xarticulo <= 5
		    MESSAGEBOX("Este ítem no tiene historial de cotización." + CHR(13) + ;
		               "No es un artículo codificado.", 48, "Aviso del Sistema")
		    RETURN
		ENDIF
		
		xcliente = _screen.clienteconpres
		IF xcliente = 0
		    MESSAGEBOX("No hay cliente seleccionado para el presupuesto.", 48, "Aviso del Sistema")
		    RETURN
		ENDIF
		
		** Limpiar cursores anteriores
		IF USED("cur_ultcotiz")
		    USE IN cur_ultcotiz
		ENDIF
		
		** Obtener parámetro de reajuste
		frmaltapr = conectar_db(_screen.cn)
		SQLEXEC(frmaltapr, "SELECT param_impo FROM parametros WHERE param_codi = 11;", "cur_rjdolar")
		desconectar_db(frmaltapr)
		
		xreaj = (100 - cur_rjdolar.param_impo) / 100
		
		** Query con cálculo de utilidad igual que usp_conspres, Ver si se puede reutilizar!
		xpunto=SET("POINT")
		xsepar=SET("SEPARATOR")
		SET POINT TO "."
		SET SEPARATOR TO ","
		TEXT TO xcQuery NOSHOW TEXTMERGE
		SELECT 
		    d.presup_fech, 
		    d.presup_codi, 
		    a.artpres_cant, 
		    ROUND(a.artpres_precio, 3) AS artpres_precio,
		    ROUND(a.artpres_cant * a.artpres_precio, 2) AS total, 
		    d.moneda, 
		    d.cotiz_dolar,
		    IFNULL(ROUND(
		        CASE
		            WHEN (d.moneda = 'D' AND a.artpres_precio > 0) THEN
		                (SELECT ((((IF(f.cond_codi<>2, IF(b.art_alicuota=1, a.artpres_precio/((e.iva_1/100)+1), a.artpres_precio/((e.iva_2/100)+1)), a.artpres_precio) * 
		                    (d.cotiz_dolar * <<xreaj>>) / IF(his.moneda='P', his.histo_costo/d.cotiz_dolar, his.histo_costo)) / d.cotiz_dolar)-1)*100)
		                FROM histocosto his
		                INNER JOIN articulos_proveedores ap ON ap.artpro_codi = his.artpro_codi
		                WHERE ap.art_codi = a.art_codi AND ap.cotiz = 1
		                AND his.histo_costo > 0 
		                AND DATE(his.histo_fech) <= COALESCE(
		                    (SELECT MAX(DATE(h2.histo_fech)) 
		                     FROM histocosto h2 
		                     INNER JOIN articulos_proveedores ap2 ON ap2.artpro_codi = h2.artpro_codi
		                     WHERE ap2.art_codi = a.art_codi AND ap2.cotiz = 1 
		                     AND DATE(h2.histo_fech) <= IFNULL(d.presup_ultact, d.presup_fech)
		                     AND h2.histo_costo > 0),
		                    (SELECT MAX(DATE(h3.histo_fech)) 
		                     FROM histocosto h3 
		                     INNER JOIN articulos_proveedores ap3 ON ap3.artpro_codi = h3.artpro_codi
		                     WHERE ap3.art_codi = a.art_codi AND ap3.cotiz = 1
		                     AND h3.histo_costo > 0)
		                )
		                ORDER BY his.histo_fech DESC LIMIT 1)
		            WHEN (d.moneda = 'P' AND a.artpres_precio > 0) THEN
		                (SELECT ((((IF(his.moneda='D', IF(f.cond_codi<>2, IF(b.art_alicuota=1, a.artpres_precio/((e.iva_1/100)+1), a.artpres_precio/((e.iva_2/100)+1)), a.artpres_precio)
		                    / d.cotiz_dolar, IF(f.cond_codi<>2, IF(b.art_alicuota=1, a.artpres_precio/((e.iva_1/100)+1), a.artpres_precio/((e.iva_2/100)+1)), a.artpres_precio)) * <<xreaj>>) / his.histo_costo)-1)*100)
		                FROM histocosto his
		                INNER JOIN articulos_proveedores ap ON ap.artpro_codi = his.artpro_codi
		                WHERE ap.art_codi = a.art_codi AND ap.cotiz = 1
		                AND his.histo_costo > 0 
		                AND DATE(his.histo_fech) <= COALESCE(
		                    (SELECT MAX(DATE(h2.histo_fech)) 
		                     FROM histocosto h2 
		                     INNER JOIN articulos_proveedores ap2 ON ap2.artpro_codi = h2.artpro_codi
		                     WHERE ap2.art_codi = a.art_codi AND ap2.cotiz = 1 
		                     AND DATE(h2.histo_fech) <= IFNULL(d.presup_ultact, d.presup_fech)
		                     AND h2.histo_costo > 0),
		                    (SELECT MAX(DATE(h3.histo_fech)) 
		                     FROM histocosto h3 
		                     INNER JOIN articulos_proveedores ap3 ON ap3.artpro_codi = h3.artpro_codi
		                     WHERE ap3.art_codi = a.art_codi AND ap3.cotiz = 1
		                     AND h3.histo_costo > 0)
		                )
		                ORDER BY his.histo_fech DESC LIMIT 1)
		            ELSE 0
		        END, 3), 0) AS utilidad,
		        f.cond_codi
		FROM presupuestos_articulos a 
		INNER JOIN articulos b ON a.art_codi = b.art_codi 
		INNER JOIN presupuestos d ON a.presup_codi = d.presup_codi
		INNER JOIN iva e ON d.iva_codi = e.iva_codi
		INNER JOIN clientes f ON d.cli_codi = f.cli_codi
		WHERE d.cli_codi = <<xcliente>> 
		  AND a.art_codi = <<xarticulo>>
		ORDER BY d.presup_fech DESC, d.presup_codi DESC;
		ENDTEXT
		SET POINT TO &xpunto
		SET SEPARATOR TO &xsepar 
		  &&AND a.alternativa <> 'S'
		
		SET DECIMALS TO 3
		frmaltapr = conectar_db(_screen.cn)
			xresult = SQLEXEC(frmaltapr, xcQuery, "cur_ultcotiz")
		desconectar_db(frmaltapr)
		SET DECIMALS TO
		
		IF TYPE("THISFROM.oWait") <> "O" OR ISNULL(THISFORM.oWait)   
			THISFORM.oWait = CREATEOBJECT("frmWait", "Procesando información...Espere...")
			THISFORM.oWait.Show()
			DOEVENTS
		ELSE
			THISFORM.oWait.SetMessage("Procesando información...Espere...")
		ENDIF
		
		IF xresult < 0 OR !USED("cur_ultcotiz") OR RECCOUNT("cur_ultcotiz") = 0
		    MESSAGEBOX("No hay cotizaciones anteriores para este cliente" + CHR(13) + ;
		               "y este artículo (Cód: " + ALLTRIM(STR(xarticulo)) + ").", 64, "Historial de Cotizaciones")
		    IF USED("cur_ultcotiz")
		        USE IN cur_ultcotiz
		    ENDIF
			IF TYPE("THISFORM.oWait") = "O"
				thisform.oWait.Release
			ENDIF    
		    RETURN
		ENDIF
		
		** Guardar en DBF temporal
		lcTmp = SYS(2023)
		lcDbf = FORCEEXT(ADDBS(lcTmp) + "histo_" + SYS(2015), "dbf")
		
		SELECT cur_ultcotiz
		COPY TO (lcDbf)
		
		** Abrir formulario
		PUBLIC goHistoCotiz
		
		IF TYPE("goHistoCotiz") = "O" AND !ISNULL(goHistoCotiz)
		    goHistoCotiz.Release()
		ENDIF
		goHistoCotiz = .NULL.
		
		DO FORM frm_histocotiz NAME goHistoCotiz WITH cond LINKED
		
		IF TYPE("goHistoCotiz") <> "O" OR ISNULL(goHistoCotiz)
		    MESSAGEBOX("No se pudo abrir el formulario de historial.", 16, "Error")
			IF TYPE("THISFORM.oWait") = "O"
				thisform.oWait.Release
			ENDIF    
		    RETURN
		ENDIF
		
		=goHistoCotiz.ShowWithCursor(lcDbf, xarticulo, xdescart)
		
		IF TYPE("THISFORM.oWait") = "O"
			thisform.oWait.Release
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE Init
		parameter codp,cond
		public elimi,descrip,muestro,insertar, ;
			   codigo,cant,descri,pruni,prtot,alternati,borra,impiva1,impiva2,nro,dato1, ;
			   dato2,dato3,dato4,cant,descri,codiva,impiva,opcion,localiz,dife,nitemcp
		
		set deleted on
		set date british
		set cent on
		
		thisform.xcurcomp  = SYS(2015)
		thisform.curarpres = SYS(2015)
		
		CREATE CURSOR (thisform.xcurcomp)(cpbte C(20),tipcbte C(3),codbus N(10))
		
		thisform.xcodp = codp
		IF _screen.estapres=1
			thisform.command3.Visible= .F.
		ENDIF
		STORE 0 TO paso,thisform.acu,elimi,localiz,muestro,insertar,borra,nitemcp,opcion,codigo
		STORE "" TO descrip,prtot,prtot
		alternati="N"
		STORE 0 TO this.text8.Value, ;
				   this.text17.Value, ;
				   this.text18.Value, ;
				   this.text9.Value, ;
				   this.text11.Value, ;
		           this.text10.Value
		           
		frmconpres= conectar_db(_screen.cn)
			SQLEXEC(frmconpres,"select * from iva order by iva_codi desc limit 1;","cur_ivaact")
			codiva=cur_ivaact.iva_codi
			impiva=cur_ivaact.iva_1
			SQLEXEC(frmconpres,"select a.*,b.*,c.*,d.cond_desc from presupuestos a inner join clientes b on a.cli_codi=b.cli_codi inner join iva c on c.iva_codi=a.iva_codi inner join condiva d on b.cond_codi=d.cond_codi where presup_codi=?codp;","cur_conpres")
			SQLEXEC(frmconpres,"select a.loca_nomb,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on a.provi_codi=c.provi_codi where a.loca_codi=?cur_conpres.loca_codi;","cur_ubicli")
			SQLEXEC(frmconpres,"select param_impo from parametros where param_codi=11;","cur_rjdolar")
		desconectar_db(frmconpres)
		IF RECCOUNT("cur_conpres")>0
			LOCAL xreaj,xdolarb
			with thisform
				_screen.clienteconpres=cur_conpres.cli_codi
				IF cur_conpres.moneda = 'P'
					thisform.lbl_cotiz.Visible= .T.
					thisform.txt_cotiz.Visible= .T.
				ENDIF
				thisform.xdolar = cur_conpres.cotiz_dolar
				xreaj=(100-cur_rjdolar.param_impo)/100
				xdolarb=thisform.xdolar*xreaj
				thisform.lbl_actualizado.Caption=IIF(ISNULL(cur_conpres.presup_ultact),'','ÚLTIMA ACTUALIZACIÓN: '+ALLTRIM(DTOC(cur_conpres.presup_ultact))+'.-')
				.txt_cotiz.Value = thisform.xdolar
				.text1.value=cur_conpres.cli_nomb
				.text2.value=cur_conpres.cli_domi
				.text6.value=cur_conpres.cond_desc
				.text12.value=cur_conpres.cli_cuit
				.text14.value="0"+allt(cur_conpres.cli_cartel)+"-"+allt(cur_conpres.cli_tel1)
				.text3.value=cur_ubicli.cp_nro
				.text4.value=cur_ubicli.loca_nomb
				.text5.value=cur_ubicli.provi_nomb	
				.text7.value=cur_conpres.presup_codi
				.text13.value=cur_conpres.presup_fech
				.text20.value=cur_conpres.presup_ref
				.text19.value=cur_conpres.presup_dto
				thisform.validez=cur_conpres.presup_ofer
				thisform.plazo=cur_conpres.presup_plent
				thisform.condpag=cur_conpres.presup_cond
				thisform.lugent=cur_conpres.presup_lugent
				thisform.observ=cur_conpres.presup_obser
				if codiva<>cur_conpres.iva_codi and impiva<>cur_conpres.iva_1
					preg=messagebox("Los artículos de este presupuesto fueron cotizados con un IVA del "+chr(13)+ ;
									allt(str(cur_conpres.iva_1,10,2))+"% y un IVA RNI del "+allt(str(cur_conpres.iva_2,10,2))+"%."+chr(13)+ ;
									"¿Conserva estos importes de IVA?",4+32+256,"IVA Presupuestado")
					if preg=6
						impiva1=cur_conpres.iva_1
						impiva2=cur_conpres.iva_2
					else
						impiva1=cur_ivaact.iva_1
						impiva2=cuv_ivaact.iva_2
					endif
					.label12.caption=allt(str(impiva1,10,2))+"%"
					.label13.caption=allt(str(impiva2,10,2))+"%"
				else
					impiva1=cur_conpres.iva_1
					impiva2=cur_conpres.iva_2
					.label12.caption=allt(str(impiva1,10,2))+"%"
					.label13.caption=allt(str(impiva2,10,2))+"%"
				endif
			ENDWITH
			SET DECIMALS TO 3
			frmconpres= conectar_db(_screen.cn)
				SQLEXEC(frmconpres,"call usp_conspres(?thisform.xcodp,?thisform.xdolar,?xdolarb,?cur_conpres.moneda,?xreaj);",(thisform.curarpres))
			desconectar_db(frmconpres)
			SET DECIMALS TO
			IF RECCOUNT((thisform.curarpres)) > 0
				GO TOP IN (thisform.curarpres)
				thisform.grd_detalle.RecordSource=(thisform.curarpres)
				thisform.grd_detalle.column5.ControlSource="(art_desc)"
				IF cond = 2
					SELECT SUM(artpres_precio*ConverNro(artpres_cant)) FROM (thisform.curarpres) WHERE util <> 0 into array ar_totvcpr
				ELSE
					SELECT SUM((artpres_precio/((iva/100)+1))*ConverNro(artpres_cant)) FROM (thisform.curarpres) WHERE util <> 0 into array ar_totvcpr
				ENDIF
				SELECT SUM(costo*ConverNro(artpres_cant)) FROM (thisform.curarpres) WHERE util <> 0 into array ar_totccpr
				
				xutil=ROUND(((ar_totvcpr[1]/ar_totccpr[1])-1)*100,3)
				
				thisform.txt_util.Value=IIF(ISNULL(xutil),0,xutil)
				IF thisform.txt_util.Value>0
					thisform.txt_utilsf.Value=((((thisform.txt_util.Value/100)+1)*xreaj)-1)*100
				ELSE
					thisform.txt_utilsf.Value=0
				ENDIF
				
				SELECT ROUND(SUM(ConverNro(artpres_cant)*artpres_precio),2) FROM (thisform.curarpres) INTO ARRAY ar_acu
				thisform.acu=ar_acu[1]
			ENDIF
			this.text8.value=thisform.acu
			this.text17.value=iif(this.text19.value>0,round((thisform.acu*this.text19.value)/100,2),0)
			this.text18.value=this.text8.value-this.text17.value
		
				
			SELECT ROUND(SUM(IIF(presup_dto>0,(((ConverNro(artpres_cant)*artpres_precio)*((100-presup_dto)/100)) * iva)/100, ;
					(((ConverNro(artpres_cant)*artpres_precio)* iva)/100))),2) ;
					FROM (thisform.curarpres) WHERE alicuo = 1 AND cond_codi = 2 INTO ARRAY ar_iva1
			this.text9.value= IIF(ISNULL(ar_iva1[1]),0,ar_iva1[1])
			SELECT ROUND(SUM(IIF(presup_dto>0,(((ConverNro(artpres_cant)*artpres_precio)*((100-presup_dto)/100)) * iva)/100, ;
					(((ConverNro(artpres_cant)*artpres_precio)* iva)/100))),2) ;
					FROM (thisform.curarpres) WHERE alicuo = 2 AND cond_codi = 2 INTO ARRAY ar_iva2
			this.text11.value= IIF(ISNULL(ar_iva2[1]),0,ar_iva2[1])
							                  
			this.text10.value=this.text18.value+this.text9.value+this.text11.value
		
			*--------------------------------------------------------------------------------------*
			=BINDEVENT(ThisForm.grd_detalle, "RightClick", ThisForm, "Grid_RightClick")
			thisform.gridart_setup()
			BINDEVENT(Thisform.grd_detalle, "AfterRowColChange", Thisform, "gridart_sync_active_color")
			localiz=1
			*--------------------------------------------------------------------------------------*
		
			thisform.buscar_compasoc(thisform.xcodp)
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		set skip of bar 6 of Consultas .T.
	ENDPROC


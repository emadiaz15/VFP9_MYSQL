		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor2' AS cursor WITH ;
		Alias = "presupuestos_articulos", ;
		CursorSource = "presupuestos_articulos", ;
		Database = base - hp.dbc, ;
		Height = 234, ;
		Left = 205, ;
		Name = "Cursor2", ;
		Top = 20, ;
		Width = 111
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Relation1' AS relation WITH ;
		ChildAlias = "articulos", ;
		ChildOrder = "art_codi", ;
		Name = "Relation1", ;
		ParentAlias = "presupuestos_articulos", ;
		RelationalExpr = "art_codi"
		*< END OBJECT: BaseClass="relation" />

ENDDEFINE

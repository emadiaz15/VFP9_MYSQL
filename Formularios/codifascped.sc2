		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Text1' AS textbox WITH ;
		Enabled = .F., ;
		Format = "L", ;
		Height = 23, ;
		InputMask = "########", ;
		Left = 43, ;
		Name = "Text1", ;
		TabIndex = 2, ;
		Top = 245, ;
		Width = 96
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text3' AS textbox WITH ;
		Height = 23, ;
		Left = 148, ;
		Name = "Text3", ;
		ReadOnly = .T., ;
		TabIndex = 3, ;
		Top = 245, ;
		Width = 401
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text4' AS textbox WITH ;
		Enabled = .F., ;
		Format = "K", ;
		Height = 23, ;
		Left = 557, ;
		Name = "Text4", ;
		TabIndex = 4, ;
		Top = 245, ;
		Width = 84
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		if muestro=1
			sele articulos
			seek codigo
			thisform.text1.value=art_codi
			thisform.text3.value=art_desc
			thisform.text4.value=str(val(thisform.list1.list(i,3))-acu,10,2)
			muestro=0
			sele tempo
		endif
		if rta=1
			do form altafactura with codp,cond,codicli
		endif
	ENDPROC

	PROCEDURE Destroy
		sele articulos
		set order to art_codi
		
	ENDPROC

	PROCEDURE Init
		parameter codp,cond,codicli
		public paso,acu,repetir,x,preg,muestro
		muestro=0
		acu=0
		paso=0
		repetir=0
		this.text1.value=0
		x=0
		do case
			case prompt()="Por Presupuesto"
				for i=1 to selecitem.lstperesup.listcount
					if selecitem.lstpresup.selected(i)
						if val(selecitem.lstpresup.list(i,4))=4 and alltrim(selecitem.lstpresup.list(i,5))<>"NO COTIZADO"
							selecitem.lstpresup.boundcolumn=5
							x=x+1
							thisform.list1.addlistitem(selecitem.lstpresup.list(i,1),x,1)
							thisform.list1.addlistitem(selecitem.lstpresup.list(i,5),x,2)
							thisform.list1.addlistitem(selecitem.lstpresup.list(i,6),x,3)
							if val(selecitem.lstpresup.list(i,4))=4
								sele presupuestos_articulos
								set order to artpres
								seek str(codp)+str(4)
								if selecitem.lstpresup.list(i,5)=artpres_dasc
									thisform.list1.addlistitem(str(nro_regis),x,4)
								else
									do while art_codi=4
										if selecitem.lstpresup.list(i,5)=artpres_dasc
											thisform.list1.addlistitem(str(nro_regis),x,4)
											exit
										endif
										skip
									enddo
								endif
							endif
						endif
					endif
					selecitem.lstpresup.boundcolumn=4
				next i
			case prompt()="Por Pedido de Cliente"
				for i=1 to itemsfac.lstpedcli.listcount
					if itemsfac.lstpedcli.selected(i)
						if val(itemsfac.lstpedcli.list(i,4))=4
							itemsfac.lstpedcli.boundcolumn=5
							x=x+1
							thisform.list1.addlistitem(itemsfac.lstpedcli.list(i,1),x,1)
							thisform.list1.addlistitem(itemsfac.lstpedcli.list(i,5),x,2)
							thisform.list1.addlistitem(itemsfac.lstpedcli.list(i,6),x,3)
						endif
					endif
					itemsfac.lstpedcli.boundcolumn=4
				next i
		endcase	
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.Click
		sele tempo
		locate for itempr=val(thisform.list1.list(i,1))
		with thisform
			for g=1 to .olecontrol1.rows-1
				if g<.olecontrol1.rows
					.olecontrol1.row=g
				endif
				.olecontrol1.col=0
				if val(.olecontrol1.text)<>art_codi
					appe blank
				endif				
				repla art_codi with val(.olecontrol1.text)
				.olecontrol1.col=1
				repla art_nomb with .olecontrol1.text
				repla itempr with val(thisform.list1.list(i,1))
				.olecontrol1.col=2
				repla precio with val(.olecontrol1.text)
				do case
					case prompt()="Por Presupuesto"
						repla regis with val(thisform.list1.list(i,4))
					case prompt()="Por Pedido de Cliente"
						repla artdasc with thisform.list1.list(i,2)
				endcase
			next g
			.command7.enabled=.F.
			for x=1 to .olecontrol1.rows-1
				if x<.olecontrol1.rows
					.olecontrol1.row=x
				endif
				if .olecontrol1.rows=2
					.olecontrol1.col=0
					.olecontrol1.text=" "
					.olecontrol1.col=1
					.olecontrol1.text=" "
					.olecontrol1.col=2
					.olecontrol1.text=" "
					paso=1
					exit
				else
					.olecontrol1.removeitem(1)
				endif
			next x
		endwith
		thisform.text4.enabled=.F.
		do case
			case prompt()="Por Presupuesto"
				do form pediclixpresup with codp,cond,codicli
			case prompt()="Por Pedido de Cliente"
				sele tempo
				set order to art_codi
				set rela to art_codi into articulos addi
				i=1
				go top
				do while !eof()
					if val(itemsfac.lstpedcli.listitem(i,1))<>itempr
						do while itemsfac.lstpedcli.listitem(i,1)<>itempr
							i=i+1
						enddo
					endif
					if articulos.art_stock-val(itemsfac.lstpedcli.listitem(i,2))<0
						do form excedestock with rta
						b=1
						exit
					endif
					skip
					i=i+1
				enddo
				if b=0
					do form altafactura with codp,cond,codicli
				endif
		endcase	
		thisform.hide
		thisform.release
		
	ENDPROC

	PROCEDURE Command1.Init
		if prompt()="Por Pedido de Cliente"
			this.caption="Ingresar a \<Factura"
		endif
	ENDPROC

	PROCEDURE Command4.Click
		codigo=0
		do form artload with codigo
		if codigo>0
			thisform.text1.value=art_codi
			thisform.text3.value=art_desc
			thisform.text4.value=str(val(thisform.list1.list(i,3))-acu,10,2)
			thisform.command7.enabled=.T.
			thisform.command7.setfocus
			thisform.text4.setfocus
		else
			thisform.text1.setfocus
		endif
		
	ENDPROC

	PROCEDURE Command5.Click
		muestro=1
		do form altasart with codigo
		
	ENDPROC

	PROCEDURE Command7.Click
		preg=0
		with thisform
			if acu+val(.text4.value)>val(.list1.list(i,3))
				do case
					case prompt()="Por Presupuesto"
						preg=messagebox("Excede el precio cotizado, ¿Contínúa Igualmente?"+chr(13)+ ;
						                "Precio cotizado: "+"$ "+allt(.list1.list(i,3))+chr(13)+ ;
						                "Total a ingresar al pedido: "+"$ "+allt(str(acu+val(.text4.value),10,2)),4+48+256,"Advertencia!!!")
					case prompt()="Por Pedido de Cliente"				               
						preg=messagebox("Excede el precio pactado con el Cliente, ¿Contínúa Igualmente?"+chr(13)+ ;
						                "Precio pactado: "+"$ "+allt(.list1.list(i,3))+chr(13)+ ;
						                "Total a facturar: "+"$ "+allt(str(acu+val(.text4.value),10,2)),4+48+256,"Advertencia!!!")
				endcase				                
			endif
			if preg=7
				.text4.value=str(val(.list1.list(i,3))-acu,10,2)
				.text4.setfocus
			else
				if paso=1
					.olecontrol1.col=0
					.olecontrol1.text=str(articulos.art_codi)
					.olecontrol1.col=1
					.olecontrol1.text=articulos.art_desc
					.olecontrol1.col=2
					.olecontrol1.text=thisform.text4.value
					paso=0
				else
					.olecontrol1.additem(str(articulos.art_codi)+chr(9)+articulos.art_desc+chr(9)+allt(thisform.text4.value))
				endif
				.olecontrol1.col=2
				acu=0
				for c=1 to .olecontrol1.rows-1
					.olecontrol1.row=c
					acu=acu+val(.olecontrol1.text)
				next c
				if acu>=val(.list1.list(i,3))
					sele tempo
					for g=1 to .olecontrol1.rows-1
						if g<.olecontrol1.rows
							.olecontrol1.row=g
						endif
						appe blank
						.olecontrol1.col=0
						repla art_codi with val(.olecontrol1.text)
						.olecontrol1.col=1
						repla art_nomb with .olecontrol1.text
						repla itempr with val(thisform.list1.list(i,1))
						.olecontrol1.col=2
						repla precio with val(.olecontrol1.text)
						do case
							case prompt()="Por Presupuesto"
								repla regis with val(thisform.list1.list(i,4))
							case prompt()="Por Pedido de Cliente"
								repla artdasc with thisform.list1.list(i,2)
						endcase
					next g
					.command7.enabled=.F.
					for g=1 to .olecontrol1.rows-1
						if g<.olecontrol1.rows
							.olecontrol1.row=g
						endif
						if .olecontrol1.rows=2
							.olecontrol1.col=0
							.olecontrol1.text=" "
							.olecontrol1.col=1
							.olecontrol1.text=" "
							.olecontrol1.col=2
							.olecontrol1.text=" "
							paso=1
							exit
						else
							.olecontrol1.removeitem(1)
						endif
					next g
					.text1.value=0
					.text3.value=" "
					.text4.value=" "
					.text1.enabled=.F.
					.text3.enabled=.F.
					.text4.enabled=.F.
					.edit1.value=""
					.command4.enabled=.F.
					.command5.enabled=.F.
					this.enabled=.F.
					.list1.removeitem(i)
					acu=0
				else
					.text1.value=0
					.text3.value=" "
					.text4.value=" "
					.text1.setfocus
				endif
			endif
		endwith
	ENDPROC

	PROCEDURE List1.Click
		for i=1 to this.listcount
			if this.selected(i)
				thisform.edit1.value=this.list(i,2)
				exit
			endif
		next i
		with thisform
			.text1.enabled=.T.
			.text3.enabled=.T.
			.text4.enabled=.T.
			.command1.enabled=.T.
			.command4.enabled=.T.
			.command5.enabled=.T.
			.command7.enabled=.T.
			.text1.setfocus
		endwith
		
	ENDPROC

	PROCEDURE Text1.LostFocus
		if this.value<>0
			thisform.text3.value=art_desc
			thisform.text4.value=str(val(thisform.list1.list(i,3))-acu,10,2)
			thisform.command7.enabled=.T.
		endif
		thisform.text4.setfocus
	ENDPROC

	PROCEDURE Text1.Valid
		if this.value<>0
			sele articulos
			set order to art_codi
			seek this.value
			if found()
				if art_codi=4
					messagebox("No puede ingresar un artículo sin código en esta rutina",0+48,"Advertencia")
					this.value=0
					return 0
				endif
			else
				messagebox("Artículo no está en archivo",0+48,"Advertencia")
				this.value=0
				return 0
			endif
		endif
		
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="1" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Cursor1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Cursor2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Relation1" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCloseTables = .F.
		DataSource = .NULL.
		Height = 411
		Left = 1
		Name = "Dataenvironment"
		Top = 220
		Width = 792
	*</PropValue>

	ADD OBJECT 'Cursor1' AS cursor WITH ;
		Alias = "articulos", ;
		CursorSource = "articulos", ;
		Database = base - hp.dbc, ;
		Height = 164, ;

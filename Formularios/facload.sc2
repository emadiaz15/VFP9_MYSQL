	PROCEDURE Activate
		if codicli=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE buscarfacturasporarticulo
		LPARAMETERS tnArtCodi
		LOCAL frmpedlo
		
		IF EMPTY(tnArtCodi) OR tnArtCodi=0
			RETURN .F.
		ENDIF
		
		thisform.grid1.Rows=1
		thisform.command2.Enabled=.F.
		
		IF USED("cur_fl")
			USE IN cur_fl
		ENDIF
		
		frmfaclo = conectar_db(_screen.cn)
		
		IF valorcadena="Por Factura"
			thisform.Caption=ALLTRIM(thisform.Caption)+" (Muestra solo ítems sin remitar)"
			SQLEXEC(frmfaclo, ;
				"select distinct " + ;
				"CONCAT('  ',CAST(f.fac_pto AS CHAR)),CONCAT('  ',CAST(f.fac_nro AS CHAR)), " + ;
				"f.fac_fec,f.fac_codi,f.cli_codi " + ;
				"from facturas f " + ;
				"inner join facturas_articulos fa on f.fac_codi=fa.fac_codi " + ;
				"where f.cli_codi=?codicli and fa.art_codi=?tnArtCodi " + ;
				"and f.remitado=0 and f.fac_conc='F' "+ ;
				"order by f.fac_fec desc;", ;
				"cur_fl")
		ELSE
			SQLEXEC(frmfaclo, ;
				"select distinct " + ;
				"CONCAT('  ',CAST(f.fac_pto AS CHAR)),CONCAT('  ',CAST(f.fac_nro AS CHAR)), " + ;
				"f.fac_fec,f.fac_codi,f.cli_codi " + ;
				"from facturas f " + ;
				"inner join facturas_articulos fa on f.fac_codi=fa.fac_codi " + ;
				"where f.cli_codi=?codicli and fa.art_codi=?tnArtCodi " + ;
				"order by f.fac_fec desc;", ;
				"cur_fl")
		ENDIF
		
		desconectar_db(frmfaclo)
		
		IF USED("cur_fl") AND RECCOUNT("cur_fl")>0
			thisform.lst_faclo.RowSource="cur_fl"
			thisform.lst_faclo.Requery()
			thisform.lst_faclo.Selected(1)=.T.
			thisform.CargarDetalleFactura()
			thisform.command2.Enabled=.T.
		ELSE
			thisform.lst_faclo.RowSource=""
			thisform.grid1.Rows=1
			thisform.command2.Enabled=.F.
			MESSAGEBOX("No existen facturas del cliente con ese artículo.",48,"Aviso")
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargardetallefactura
		local paso, lnRowMatch
		
		lnRowMatch = 0
		paso=0
		
		thisform.grid1.rows=1
		
		IF !USED("cur_fl")
			RETURN
		ENDIF
		
		IF EOF("cur_fl")
			RETURN
		ENDIF
		
		frmfaclo= conectar_db(_screen.cn)
			SQLEXEC(frmfaclo,"select fac_conc from facturas where fac_codi=?cur_fl.fac_codi;","cur_conce")
			if valorcadena="Por Factura"
				SQLEXEC(frmfaclo,"select a.art_codi,b.art_desc,a.artfac_nd,a.artfac_dasc,a.artfac_ddesc,a.artfac_impo from facturas_articulos as a inner join articulos as b on a.art_codi=b.art_codi where a.fac_codi=?cur_fl.fac_codi and a.remitado=0;","cur_facalo")
			ELSE
				SQLEXEC(frmfaclo,"select a.art_codi,b.art_desc,a.artfac_nd,a.artfac_dasc,a.artfac_ddesc,a.artfac_impo from facturas_articulos as a inner join articulos as b on a.art_codi=b.art_codi where a.fac_codi=?cur_fl.fac_codi;","cur_facalo")
			ENDIF 
		desconectar_db(frmfaclo)
		
		IF RECCOUNT("cur_facalo")>0
			GO top
			SCAN
				cadena=repl("0",8-len(allt(str(cur_facalo.art_codi))))+allt(str(cur_facalo.art_codi))
				if cur_facalo.art_codi=4 OR cur_facalo.art_codi=5
					thisform.grid1.additem(cadena+chr(9)+iif(cur_conce.fac_conc="D",cur_facalo.artfac_nd,cur_facalo.artfac_dasc)+chr(9)+TRANSFORM(cur_facalo.artfac_impo, "$ 999,999,999.99"))
				else
					thisform.grid1.additem(cadena+chr(9)+cur_facalo.art_desc+chr(9)+TRANSFORM(cur_facalo.artfac_impo, "$ 999,999,999.99"))
					if LEN(ALLTRIM(cur_facalo.artfac_ddesc))>0
						thisform.grid1.col=1
						thisform.grid1.row=thisform.grid1.rows-1
						thisform.grid1.text=cur_facalo.artfac_ddesc
					endif
				endif
				WITH thisform
					.grid1.Row = .grid1.Rows-1
		
					.grid1.Col = 0
					.grid1.CellAlignment = 3
		
					.grid1.Col = 1
					.grid1.CellAlignment = 3
		
					.grid1.Col = 2
					.grid1.CellAlignment = 8
				ENDWITH
		
				* TEST DE MATCH
				IF PEMSTATUS(thisform,"xArtFiltro",5) AND thisform.xArtFiltro>0
					IF cur_facalo.art_codi = thisform.xArtFiltro
						lnRowMatch = thisform.grid1.Rows-1
					ENDIF
				ENDIF
				
			ENDSCAN
			thisform.command2.enabled=.T.
			*-----------------------------------------
			* Resaltar fila encontrada al final
			*-----------------------------------------
			IF lnRowMatch > 0
				WITH thisform
					.grid1.Row = lnRowMatch
		
					.grid1.Col = 0
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					.grid1.Col = 1
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					.grid1.Col = 2
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					.grid1.Col = 3
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					* Dejar posicionada la fila encontrada
					.grid1.Row = lnRowMatch
				ENDWITH
			ENDIF	
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		parameter codicli
		public cond,i,codifac,postal,provi,locali
		
		IF !PEMSTATUS(thisform,"xArtFiltro",5)
			thisform.AddProperty("xArtFiltro",0)
		ENDIF
		
		postal=0
		provi=""
		locali=""
		
		set date british
		set cent on
		set dele on
		with thisform
			if codicli=0
				do form cliload with codicli,postal,provi,locali
				cond=cond_codi
				.text1.value=cur_clie.cli_nomb
				.text2.value=cur_clie.cli_domi
				.text6.value=cur_clie.cond_desc
				.text12.value=cur_clie.cli_cuit
				.text3.value=cur_clie.cp_nro
				.text4.value=cur_clie.loca_nomb
				.text5.value=cur_clie.provi_nomb
			ELSE
				frmfaclo= conectar_db(_screen.cn)
					SQLEXEC(frmfaclo,"call usp_buscarcli(?codicli);","cur_clie")
				desconectar_db(frmfaclo)
				.text1.value=cur_clie.cli_nomb
				.text2.value=cur_clie.cli_domi
				.text6.value=cur_clie.cond_desc
				.text12.value=cur_clie.cli_cuit
				.text3.value=cur_clie.cp_nro
				.text4.value=cur_clie.loca_nomb
				.text5.value=cur_clie.provi_nomb
			ENDIF
			this.text7.Value=0
			frmfaclo= conectar_db(_screen.cn)
				if valorcadena="Por Factura"
					thisform.Caption=ALLTRIM(thisform.Caption)+" (Muestra solo ítems sin remitar)"
					SQLEXEC(frmfaclo,"select CONCAT('  ',CAST(fac_pto AS CHAR)),CONCAT('  ',CAST(fac_nro AS CHAR)),fac_fec,fac_codi,cli_codi from facturas where cli_codi=?codicli and remitado=0 and fac_conc='F' order by fac_fec desc;","cur_fl")
				ELSE
					SQLEXEC(frmfaclo,"select CONCAT('  ',CAST(fac_pto AS CHAR)),CONCAT('  ',CAST(fac_nro AS CHAR)),fac_fec,fac_codi,cli_codi from facturas where cli_codi=?codicli order by fac_fec desc;","cur_fl") 
				ENDIF
			desconectar_db(frmfaclo)
			IF RECCOUNT("cur_fl")>0
				thisform.lst_faclo.RowSource="cur_fl"
				thisform.lst_faclo.Selected(1)=.T.
				thisform.command2.enabled=.T.
				thisform.CargarDetalleFactura()
			ENDIF
		endwith
		
		
	ENDPROC

	PROCEDURE recargarfacturascliente
		thisform.grid1.Rows = 1
		thisform.xArtFiltro = 0
		thisform.label8.Caption = ""
		thisform.text7.Value = 0
		
		frmfaclo= conectar_db(_screen.cn)
			if valorcadena="Por Factura"
				thisform.Caption=ALLTRIM(thisform.Caption)+" (Muestra solo ítems sin remitar)"
				SQLEXEC(frmfaclo,"select CONCAT('  ',CAST(fac_pto AS CHAR)),CONCAT('  ',CAST(fac_nro AS CHAR)),fac_fec,fac_codi,cli_codi from facturas where cli_codi=?codicli and remitado=0 and fac_conc='F' order by fac_fec desc;","cur_fl")
			ELSE
				SQLEXEC(frmfaclo,"select CONCAT('  ',CAST(fac_pto AS CHAR)),CONCAT('  ',CAST(fac_nro AS CHAR)),fac_fec,fac_codi,cli_codi from facturas where cli_codi=?codicli order by fac_fec desc;","cur_fl") 
			ENDIF
		desconectar_db(frmfaclo)
		
		IF RECCOUNT("cur_fl")>0
			thisform.lst_faclo.RowSource = "cur_fl"
			thisform.lst_faclo.Selected(1)=.T.
			thisform.command2.Enabled=.T.
			thisform.CargarDetalleFactura()
		ELSE
			thisform.lst_faclo.RowSource = ""
			thisform.command2.Enabled=.F.
		ENDIF
	ENDPROC

	PROCEDURE Command1.Click
		local paso
		paso=0
		thisform.grid1.rows=1
		do form cliload with codicli
		WITH thisform
			.text1.value=cur_clie.cli_nomb
			.text2.value=cur_clie.cli_domi
			.text6.value=cur_clie.cond_desc
			.text12.value=cur_clie.cli_cuit
			.text3.value=cur_clie.cp_nro
			.text4.value=cur_clie.loca_nomb
			.text5.value=cur_clie.provi_nomb
			frmfaclo= conectar_db(_screen.cn)
				if valorcadena="Por Factura"
					thisform.Caption=ALLTRIM(thisform.Caption)+" (Muestra solo ítems sin remitar)"
					SQLEXEC(frmfaclo,"select CONCAT('  ',CAST(fac_pto AS CHAR)),CONCAT('  ',CAST(fac_nro AS CHAR)),fac_fec,fac_codi,cli_codi from facturas where cli_codi=?codicli and remitado=0 and fac_conc='F' order by fac_fec desc;","cur_fl")
				ELSE
					SQLEXEC(frmfaclo,"select CONCAT('  ',CAST(fac_pto AS CHAR)),CONCAT('  ',CAST(fac_nro AS CHAR)),fac_fec,fac_codi,cli_codi from facturas where cli_codi=?codicli order by fac_fec desc;","cur_fl") 
				ENDIF
			desconectar_db(frmfaclo)
			IF RECCOUNT()>0
				thisform.lst_faclo.RowSource="cur_fl"
				thisform.lst_faclo.Selected(1)=.T.
				thisform.command2.enabled=.T.
				thisform.CargarDetalleFactura()
			ENDIF
		ENDWITH
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command2.Click
		LOCAL vendn
		vendn=UPPER(substr(sys(0),ATC("#",sys(0))+2))
		frmfaclo= conectar_db(_screen.cn)
			SQLEXEC(frmfaclo,"select * from vendedores where ven_nomb=?vendn;","cur_ven")
		desconectar_db(frmfaclo)
		
		if RECCOUNT("cur_ven")>0
			codifac=cur_fl.fac_codi
			cond=cur_clie.cond_codi
			do form consfactura with codifac,cond
		else
			do case
				case valorcadena="Por Cliente"
					codifac=cur_fl.fac_codi
					cond=cur_clie.cond_codi
					do form consfactura with codifac,cond
				case valorcadena="Por Factura"
					codifac=cur_fl.fac_codi
					cond=cur_clie.cond_codi
					codp=0
					codiprov=0
					&& codiprov=0
					DO FORM itemsenv WITH codp,codifac,cond,codicli
					&& do form altaremito with codifac,codp,codicli,codiprov
			endcase
		endif
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command4.Click
		LOCAL frmpe, lcNombre
		
		codigo = 0
		lcNombre = ""
		
		DO FORM artload WITH codigo
		
		IF codigo>0
			thisform.xArtFiltro = codigo
			thisform.text7.Value = codigo
		
			frmfa = conectar_db(_screen.cn)
			SQLEXEC(frmfa,"select art_desc from articulos where art_codi=?codigo;","cur_artbus")
			desconectar_db(frmfa)
		
			IF USED("cur_artbus") AND RECCOUNT("cur_artbus")>0
				thisform.label8.Caption = ALLTRIM(cur_artbus.art_desc)
			ELSE
				thisform.label8.Caption = ""
			ENDIF
		
			thisform.BuscarFacturasPorArticulo(codigo)
		ENDIF
	ENDPROC

	PROCEDURE Command4.GotFocus
		RETURN
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE lst_faclo.Click
		thisform.CargarDetalleFactura()
	ENDPROC

	PROCEDURE lst_faclo.KeyPress
		&& facload.lst_faclo.keypress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = 13
			THISFORM.CargarDetalleFactura()
		
			IF THISFORM.Command2.Enabled
				THISFORM.Command2.Click()
			ENDIF
		
			NODEFAULT
		ENDIF
	ENDPROC

	PROCEDURE Text7.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text7.InteractiveChange
		LOCAL lccadena
		lccadena = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lccadena) OR lccadena="0"
			thisform.RecargarFacturasCliente()
		ENDIF
	ENDPROC

	PROCEDURE Text7.LostFocus
		RETURN
	ENDPROC

	PROCEDURE Text7.Valid
		LOCAL lncodigoart, lccadena, frmpedlo
		
		lccadena = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lccadena) OR lccadena="0"
			thisform.RecargarFacturasCliente()
			RETURN .T.
		ENDIF
		
		lncodigoart = VAL(lccadena)
		
		IF lncodigoart<=0
			thisform.xArtFiltro = 0
			thisform.label8.Caption = ""
			RETURN .T.
		ENDIF
		
		frmfaclo = conectar_db(_screen.cn)
		SQLEXEC(frmfaclo,"select art_desc from articulos where art_codi=?lncodigoart;","cur_artbus")
		desconectar_db(frmfaclo)
		
		IF USED("cur_artbus") AND RECCOUNT("cur_artbus")>0
			thisform.xArtFiltro = lncodigoart
			thisform.label8.Caption = ALLTRIM(cur_artbus.art_desc)
			thisform.BuscarFacturasPorArticulo(lncodigoart)
		ELSE
			thisform.xArtFiltro = 0
			thisform.label8.Caption = ""
			MESSAGEBOX("No existe un artículo con ese código.",48,"Aviso")
		ENDIF
		
		RETURN .T.
	ENDPROC

ENDDEFINE

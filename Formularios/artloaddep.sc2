	ADD OBJECT 'lstart' AS listbox WITH ;
		BoundColumn = 2, ;
		ColumnCount = 2, ;
		ColumnWidths = "102,300", ;
		FontBold = .T., ;
		Height = 183, ;
		ItemBackColor = 220,220,220, ;
		ItemTips = .T., ;
		Left = 46, ;
		Name = "lstart", ;
		RowSource = '"      "+repl("0",8-len(allt(str(articulos.art_codi))))+allt(str(articulos.art_codi)),art_desc', ;
		RowSourceType = 2, ;
		TabIndex = 2, ;

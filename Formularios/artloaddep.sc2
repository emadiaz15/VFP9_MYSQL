		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'txtartload' AS textbox WITH ;
		BackColor = 220,220,220, ;
		FontBold = .T., ;
		Height = 23, ;
		Left = 47, ;
		Name = "txtartload", ;
		SelectOnEntry = .T., ;
		TabIndex = 1, ;
		Top = 40, ;
		Width = 418
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		public d
		d=1
		
	ENDPROC

	PROCEDURE GotFocus
		this.lstart.setfocus
		this.txtartload.setfocus
	ENDPROC

	PROCEDURE Init
		parameter codigo,nombre
	ENDPROC

	PROCEDURE Unload
		return codigo
		return nombre
	ENDPROC

	PROCEDURE lstart.Click
		sele articulos
		codigo=art_codi
		nombre=art_desc
		thisform.release
	ENDPROC

	PROCEDURE lstart.GotFocus
		if last()=24 or last()=5
			thisform.txtartload.setfocus
		endif
	ENDPROC

	PROCEDURE lstart.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE txtartload.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE txtartload.InteractiveChange
		local lc
		lc = allt(This.Value)
		if last()<>127 and last()<>7
			do while !eof()
				if lc=subst(articulos.art_desc,1,len(lc))
					exit
				else
					skip
					d=d+1
					if eof()
						go top
						d=1
						exit
					endif
				endif
			enddo
		else
			do while lc=subst(articulos.art_desc,1,len(lc)) and d>1
				if bof()
					exit
				endif
				skip-1
				if d>1
					d=d-1
				endif
				if lc<>subst(articulos.art_desc,1,len(lc))
					skip
					d=d+1
					exit
				endif
			enddo				
		endif
		thisform.lstart.selected(d)=.T.
		return
		
	ENDPROC

	PROCEDURE txtartload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
					codigo=art_codi
					nombre=art_desc
					thisform.release
			case last()=5
				if d>1
					d=d-1
				endif
				thisform.lstart.selected(d)=d
				this.value=thisform.lstart.value
			case last()=24
				if d<thisform.lstart.listcount
					d=d+1
				endif
				thisform.lstart.selected(d)=d
				this.value=thisform.lstart.value
			case last()=27
				thisform.release
		endcase
	ENDPROC

	PROCEDURE txtartload.LostFocus
		capslock(.F.)
	ENDPROC

ENDDEFINE


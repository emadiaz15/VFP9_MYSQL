DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="oexplorador" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txt_url" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />

	*<PropValue>
		Caption = "Form1"
		DoCreate = .T.
		Height = 460
		Left = 1
		Name = "Form1"
		Top = 0
		Width = 790
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		Caption = "Ir!", ;
		Height = 37, ;
		Left = 712, ;
		Name = "Command1", ;
		TabIndex = 3, ;
		Top = 7, ;
		Width = 49
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'oexplorador' AS olecontrol WITH ;
		Height = 372, ;
		Left = 12, ;
		Name = "oexplorador", ;
		TabIndex = 2, ;
		Top = 60, ;
		Width = 768
		*< END OBJECT: BaseClass="olecontrol" OLEObject="c:\windows\syswow64\ieframe.dll" Value="" />

	ADD OBJECT 'txt_url' AS textbox WITH ;
		Height = 25, ;
		Left = 12, ;
		Name = "txt_url", ;
		TabIndex = 1, ;
		Top = 14, ;
		Width = 685
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Command1.Click
		Lc_URL    =    ALLTRIM(THISFORM.Txt_URL.Value)    && Obtenemos la dirección a donde navegar 
		THISFORM.oExplorador.Navigate(Lc_URL) && Navegamos a la dirección.. 
		
	ENDPROC

	PROCEDURE oexplorador.Refresh
		*** ActiveX Control Method ***
		NODEFAULT
	ENDPROC

	PROCEDURE txt_url.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			thisform.command1.click()
		endif
	ENDPROC

ENDDEFINE

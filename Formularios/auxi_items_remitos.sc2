		*< END OBJECT: BaseClass="shape" />
	
	PROCEDURE Activate
		do case
			case rta=1
				codiprov=0
				codifac=0
				do form altaremito with codifac,codp,codicli,codiprov
			case rta=2
				thisform.release
		endcase
		if x>0 and x=con and y=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE Init
		parameter codp,cond,codicli
		public rta,f,b,x,con,y,localiz,elimi
		localiz=0
		elimi=0
		frmitenv= conectar_db(_screen.cn)
			SQLEXEC(frmitenv,"select a.*,b.*,c.dac_desc from pedidos_articulos a inner join articulos b on a.art_codi=b.art_codi left outer join desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.ped_codi=?codp;","cur_artenv")
		desconectar_db(frmitenv)
		this.caption="Envio del pedido  Nº "+allt(STR(codp))+" de "+ALLTRIM(cur_clie.cli_nomb)
		rta=0
		*!*	sele pedidos_articulos
		*!*	set order to ped_codi
		i=1
		item=1
		x=0
		y=0
		b=0
		con=0
		*!*	seek codp
		SELECT cur_artenv
		GO top
		SCAN
			con=con+1
			if cur_artenv.artped_ent>0
				x=x+1
				if cur_artenv.artped_ent<cur_artenv.artped_cant
					y=y+1
				endif
			endif
		ENDSCAN
		do case
			case x>0 and x=con and y>0
				messagebox("Este pedido ya fue enviado en su totalidad pero aún "+chr(13)+ ;
						   "quedan items con cantidades pendientes. Seleccione "+chr(13)+ ;
						   "los item pendientes.",0+64,"Información importante")
			case x>0 and x=con and y=0
				messagebox("Este pedido ya fue enviado en su totalidad.",0+64,"Información importante")
				this.release
				do form pediload with codicli
			case x>0 and x<con
				messagebox("Este pedido ya fue enviado pero aún "+chr(13)+ ;
		                  "quedan items pendientes. Seleccione "+chr(13)+ ;
		                  "los items pendientes.",0+64,"Información importante")
		endcase
		GO top
		SCAN
			do case
				case cur_artenv.artped_ent<cur_artenv.artped_cant
					this.lstpedcli.AddListItem(str(item,5), i,1)
					this.lstpedcli.AddListItem(str(cur_artenv.artped_cant-cur_artenv.artped_ent,10,2), i,2)
					this.lstpedcli.AddListItem("  "+cur_artenv.art_med, i,3)
					item=item+1
					cadena="   "+repl("0",8-len(allt(str(cur_artenv.art_codi))))+allt(str(cur_artenv.art_codi))
					this.lstpedcli.AddListItem(cadena, i,4)
					if cur_artenv.art_codi=4 OR cur_artenv.art_codi=5
						this.lstpedcli.AddListItem(cur_artenv.artped_dasc, i,5)
					else
						if dac_codi=0
							this.lstpedcli.AddListItem(cur_artenv.art_desc, i,5)
						else
							this.lstpedcli.AddListItem(cur_artenv.dac_desc, i,5)
						endif
					ENDIF
					this.lstpedcli.AddListItem(ALLTRIM(STR(cur_artenv.dac_codi)), i,6)
					this.lstpedcli.AddListItem(ALLTRIM(STR(cur_artenv.artped_codi)), i,7)
			endcase
			i=i+1
		ENDSCAN
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL arenv
		arenv=0
		for i=1 to thisform.lstpedcli.listcount
			if thisform.lstpedcli.selected(i)
				arenv=val(thisform.lstpedcli.list(i,4))
				frmitenv= conectar_db(_screen.cn)
					SQLEXEC(frmitenv,"select * from articulos where art_codi=?arenv;","cur_verst")
				desconectar_db(frmitenv)
				if cur_verst.art_stock-ConverNro(thisform.lstpedcli.list(i,2))<0
					if cur_verst.art_codi>5
						do form excedestenv with rta
						b=1
					endif                      
					exit
				endif
			endif
		next i
		if b=0
			codiprov=0
			codifac=0
			do form altaremito with codifac,codp,codicli,codiprov
			thisform.hide
		endif
		
	ENDPROC

	PROCEDURE Command1.OLEDrag
		LPARAMETERS lDetectDrag
		this.command1.enabled=.T.
	ENDPROC

	PROCEDURE Command2.Click
		for i=1 to thisform.lstpedcli.listcount
			thisform.lstpedcli.selected(i)=.T.
		next i
		thisform.command1.enabled=.T.
		
	ENDPROC

	PROCEDURE lstpedcli.Click
		x=0
		y=0
		for i=1 to thisform.lstpedcli.listcount
			if thisform.lstpedcli.selected(i)
				thisform.command1.enabled=.T.
				exit
			else
				thisform.command1.enabled=.F.
			endif
		next i
		
		
	ENDPROC

	PROCEDURE lstpedcli.MouseDown
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.command1.enabled=.T.
	ENDPROC

	PROCEDURE lstpedcli.MouseUp
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.command1.enabled=.T.
	ENDPROC

ENDDEFINE

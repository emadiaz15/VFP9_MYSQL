		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text2' AS textbox WITH ;
		Format = "KL", ;
		Height = 23, ;
		InputMask = "99999999", ;
		Left = 114, ;
		Name = "Text2", ;
		TabIndex = 3, ;
		Top = 105, ;
		Width = 100
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text3' AS textbox WITH ;
		Format = "KL", ;
		Height = 23, ;
		InputMask = "99999999", ;
		Left = 114, ;
		Name = "Text3", ;
		TabIndex = 1, ;
		Top = 15, ;
		Width = 100
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text4' AS textbox WITH ;
		Format = "!", ;
		Height = 23, ;
		Left = 114, ;
		Name = "Text4", ;
		TabIndex = 4, ;
		Top = 135, ;
		Width = 303
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		parameter codiban,codisuc
		
		thisform.xcodiban=codiban
		thisform.xcodisuc=codisuc
		
		if thisform.xcodiban>0
			frmaltasuc= conectar_db(_screen.cn)
				SQLEXEC(frmaltasuc,"select ban_desc,ban_codi,ban_cuit from bancos where ban_codi=?thisform.xcodiban;","cur_banco")
			desconectar_db(frmaltasuc)
			if RECCOUNT("cur_banco")>0
				this.text3.value=cur_banco.ban_codi
				thisform.combo1.rowsource="cur_banco"
				thisform.combo1.value=thisform.combo1.list(1)
				this.combo1.readonly=.T.
				this.text2.value=thisform.xcodisuc
				this.text2.setfocus
			endif
		else
			this.text3.value=0
		endif
	ENDPROC

	PROCEDURE Unload
		codiban = thisform.xcodiban
		codisuc = thisform.xcodisuc
		return codiban
		return codisuc
	ENDPROC

	PROCEDURE Combo1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Combo1.Destroy
		set notify on
	ENDPROC

	PROCEDURE Combo1.GotFocus
		set notify off
	ENDPROC

	PROCEDURE Combo1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			LOCAL nban
			nban=''
			for i=1 to this.listcount
				if this.selected(i)
					nban=allt(this.list(i))
					frmaltasuc= conectar_db(_screen.cn)
						SQLEXEC(frmaltasuc,"select * from bancos where TRIM(ban_desc)=?nban;","cur_bn")
					desconectar_db(frmaltasuc)
					this.value=cur_bn.ban_desc
					thisform.text3.value=cur_bn.ban_codi
					KEYBOARD '{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE Combo1.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade="%"+subst(allt(this.text),2,len(allt(this.text)))+"%"
				frmaltasuc= conectar_db(_screen.cn)
					SQLEXEC(frmaltasuc,"select ban_desc from bancos where ban_desc like ?cade order by ban_desc;","cur_bnn")
				desconectar_db(frmaltasuc)
				this.rowsource="cur_bnn"
				this.value=this.list(1)
				keyboard "{F4}"
				return .F.
			else
				if len(allt(this.text))>0
					frmaltasuc= conectar_db(_screen.cn)
						SQLEXEC(frmaltasuc,"select ban_desc from bancos where ban_desc=?allt(this.text) order by ban_desc;","cur_bnn")
					desconectar_db(frmaltasuc)
					this.rowsource="cur_bnn"
					this.value=this.list(1)
					keyboard "{F4}"
					return .F.
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			if .text3.value>0 and len(allt(.combo1.text))>0 and len(allt(.text4.value))>0
		*!*		if .text2.value>0 and .text3.value>0 and len(allt(.combo1.text))>0 and len(allt(.text4.value))>0
				LOCAL xnoms,xdoms,xbs
				thisform.xcodisuc=.text2.value
				xnoms=allt(.text4.value)
				xdoms=allt(.text1.value)
				xbs=repl("0",3-len(allt(str(thisform.xcodiban))))+allt(str(thisform.xcodiban))+repl("0",3-len(allt(str(thisform.xcodisuc))))+allt(str(thisform.xcodisuc))
				frmaltasuc= conectar_db(_screen.cn)
					SQLEXEC(frmaltasuc,"insert into sucbancos values(?thisform.xcodisuc,?xnoms,?xdoms,?thisform.xcodiban,?xbs);")
				desconectar_db(frmaltasuc)
				thisform.release
				&&Cerrar_cursores()
		*!*			thisform.setall("value","","Textbox")
		*!*			thisform.text1.setfocus
			endif
		endwith
		
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Text2.LostFocus
		LOCAL xsuc
		xsuc=repl("0",3-len(allt(str(thisform.xcodiban))))+allt(str(thisform.xcodiban))+repl("0",3-len(allt(str(this.value))))+allt(str(this.value))
		frmaltasuc= conectar_db(_screen.cn)
			SQLEXEC(frmaltasuc,"select * from sucbancos where TRIM(suc_bansuc)=?xsuc;","cur_suc")
		desconectar_db(frmaltasuc)
		IF RECCOUNT("cur_suc")>0
			messagebox("Sucursal ya está en archivo, se encontró "+allt(cur_suc.suc_nomb)+", imposible ingresar este código de sucursal.",0+48,"Advertencia")
			this.Value=0
			this.setfocus
			nodefault
		ENDIF
		
	ENDPROC

	PROCEDURE Text3.LostFocus
		if this.value>0
			frmaltasuc= conectar_db(_screen.cn)
				SQLEXEC(frmaltasuc,"select ban_desc,ban_codi,ban_cuit from bancos where ban_codi=?this.value;","cur_bco")
			desconectar_db(frmaltasuc)
			if RECCOUNT("cur_bco")>0
				codiban=cur_bco.ban_codi
				thisform.combo1.rowsource="cur_bco"
				thisform.combo1.value=thisform.combo1.list(1)
				thisform.text2.value=0
				keyboard '{TAB}'
			else
				if this.value>0
					=messagebox("Banco no está en archivo",0+48,"Advertencia")
					this.value=0
					nodefault
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Text4.LostFocus
		with thisform
			if .text3.value>0 and len(allt(.combo1.text))>0 and len(allt(this.value))>0
				.command1.enabled=.T.
			endif
		*!*		if .text2.value>0 and .text3.value>0 and len(allt(.combo1.text))>0 and len(allt(this.value))>0
		*!*			.command1.enabled=.T.
		*!*		endif
		endwith
	ENDPROC

ENDDEFINE


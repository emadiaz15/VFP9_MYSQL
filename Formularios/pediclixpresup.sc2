		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		if thisform.codicli>0
			impiva1=thisform.impiva1
			impiva2=thisform.impiva2
			cond=thisform.xcond
			valorcadena=thisform.valorcadena
			on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		set exact on
		if codigo=0
			muestro=0
		endif
		if muestro=1
			SET POINT TO ","
			SET DECIMALS TO 3
			with thisform
				frmaltapxp= conectar_db(_screen.cn)
					SQLEXEC(frmaltapxp, "select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmaltapxp)
				localiz=1
				if paso=1
					.grid1.col=0
					.grid1.text=allt(str(aux))
					.grid1.col=1
					.grid1.text=allt(cant)
					.grid1.col=2
					.grid1.text=cur_arti.art_med
					.grid1.col=3
					cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
					.grid1.text=cadena
					.grid1.col=4
					if codigo=4
						.grid1.text=allt(descrip)
					else
						.grid1.text=allt(descri)
					endif
					.grid1.col=5
					.grid1.text=allt(pruni)
					.grid1.col=6
					thisform.acu=thisform.acu-ConverNro(.grid1.text)
					.grid1.text=prtot
					.grid1.col=8
					arpc= val(.grid1.text)			
					if .text19.value>0
						auxiva=auxiva-(auxiva*.text19.value/100)
						auximpo=auximpo-(auximpo*.text19.value/100)
					ENDIF
					do case
						case art_alicuota=1
							if thisform.xcond=2
								if auxali=1
									thisform.impo1=thisform.impo1-auximpo
								else
									thisform.impo2=thisform.impo2-auximpo
								endif
							else
								if auxali=1
									thisform.acun1=thisform.acun1-auximpo
								else
									thisform.acun2=thisform.acun2-auximpo
								endif
							endif
						case art_alicuota=2
							if thisform.xcond=2
								if auxali=2
									thisform.impo2=thisform.impo2-auximpo
								else
									thisform.impo1=thisform.impo1-auximpo
								endif
							else
								if auxali=2
									thisform.acun2=thisform.acun2-auximpo
								else
									thisform.acun1=thisform.acun1-auximpo
								endif
							endif
					ENDCASE
					thisform.acu=thisform.acu+ConverNro(prtot)
					IF USED("cur_pend")
						IF dato1<>codigo
		*!*						IF !USED("cur_modic")
		*!*							CREATE CURSOR cur_modic(m_artcod N(8),m_artcan N(15,3))
		*!*						ENDIF
		*!*						INSERT INTO cur_modic values(dato1, ConverNro(dato2))
							UPDATE cur_pend SET art_codi = codigo, ant_pend = 0, act_pend = ConverNro(cant) ;
								 WHERE art_codi = dato1 AND artped_codi = arpc
							IF dato1 > 5
								Campo_ped(dato1)
							ENDIF
						ELSE
							UPDATE cur_pend SET act_pend = ConverNro(cant) WHERE art_codi = codigo AND artped_codi = arpc
						ENDIF
					ENDIF
				ELSE
					if insertar=0
						nitemapp=nitemapp+1
						cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
						.grid1.additem(alltrim(str(nitemapp))+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+cadena+chr(9)+allt(descri)+chr(9)+allt(pruni)+chr(9)+prtot)
					ENDIF
					thisform.acu=thisform.acu+ConverNro(prtot)
				endif
				if paso=1
					paso=0
				else
					.grid1.row=this.grid1.rows-1
				endif
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				ENDIF
				.grid1.col=7
				do case
					case cur_arti.art_alicuota=1
						.grid1.text=allt(str(thisform.impiva1,10,2))
					case cur_arti.art_alicuota=2
						.grid1.text=allt(str(thisform.impiva2,10,2))
				ENDCASE
				.grid1.col=0
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellalignment=3
				.grid1.col=2
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellalignment=8
				.grid1.col=7
				.grid1.cellalignment=8
			ENDWITH
			SET DECIMALS TO 
			codigo=0
			localiz=1
		ENDIF
		SET POINT TO ","
		if localiz=1 and nitemapp>0
			with thisform
				.text8.value=thisform.acu
				.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
				.text18.value=.text8.value-.text17.value
				if .text19.value>0
					do case
						case cur_arti.art_alicuota=1
							if thisform.xcond=2
								thisform.impo1=thisform.impo1+(ConverNro(prtot)*((100-.text19.value)/100))
								if auxali=2
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								endif
								.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							else
								thisform.acun1=thisform.acun1+round(((ConverNro(prtot)*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
								if auxali=2
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
						case cur_arti.art_alicuota=2
							if thisform.xcond=2
								thisform.impo2=thisform.impo2+(ConverNro(prtot)*((100-.text19.value)/100))
								if auxali=1
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								endif
								.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							else
								thisform.acun2=thisform.acun2+round(((ConverNro(prtot)*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
								if auxali=1
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
					endcase
				else
					do case
						case cur_arti.art_alicuota=1
							if thisform.xcond=2
								thisform.impo1=thisform.impo1+ConverNro(prtot)
								if auxali=2
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								endif
								.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							else
								thisform.acun1=thisform.acun1+round((ConverNro(prtot)/(1+(thisform.impiva1/100))),3)
								if auxali=2
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
						case cur_arti.art_alicuota=2
							if thisform.xcond=2
								thisform.impo2=thisform.impo2+ConverNro(prtot)
								if auxali=1
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								endif
								.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							else
								thisform.acun2=thisform.acun2+round((ConverNro(prtot)/(1+(thisform.impiva2/100))),3)
								if auxali=1
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
					endcase
				endif
				.text10.value=.text18.value+.text9.value+.text11.value
			endwith
		ENDIF
		SET POINT TO
		&& === Colorear grid por stock ===
		IF muestro = 1
		    thisform.gridart_refresh()
		ENDIF
		&& ================================
		store 0 to localiz,muestro
		*------------------------------------------------------*
		on key label ESC do GridArt_OnEsc in grid_articulos_ui
		*------------------------------------------------------*
	ENDPROC

	PROCEDURE buscar_pedido
		LPARAMETERS xcodp
		
		SET DECIMALS TO 3
		frmaltapxp= conectar_db(_screen.cn)
			SQLEXEC(frmaltapxp,"call usp_conspmod(?xcodp);","cur_arped")
		desconectar_db(frmaltapxp)
		SET DECIMALS TO
		SELECT art_codi, artped_codi, artped_cant ant_pend, CAST("0" as numeric(15,3)) act_pend FROM cur_arped INTO CURSOR cur_pend READWRITE
		
		&& === Colorear grid por stock ====
		thisform.gridart_refresh()
		&& ================================
		
		RETURN
	ENDPROC

	PROCEDURE Destroy
		&& === Limpieza grid_articulos_ui ===
		IF PEMSTATUS(thisform, "xGridArtBound", 5)
		    =GridArt_Unbind(thisform)
		ENDIF
		ON KEY LABEL ESC
		&& === Fin limpieza ===
		
		set skip of bar 3 of Altas .F.
		_screen.xopvta=""
		on key label INS
		localiz=0
		
	ENDPROC

	PROCEDURE gridart_menu
		LOCAL lcShortcut
		
		IF thisform.grid1.Rows <= 1
		    RETURN
		ENDIF
		
		lcShortcut = SYS(2015)
		DEFINE POPUP (lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		=GridArt_AddStockMenuOption(lcShortcut, 1, thisform)
		=GridArt_AddStockMenuSeparator(lcShortcut, 2)
		=GridArt_AddListaComprasMenuOption(lcShortcut, 3)
		ACTIVATE POPUP (lcShortcut)
		RELEASE POPUP (lcShortcut)
		
		RETURN
	ENDPROC

	PROCEDURE gridart_refresh
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    thisform.gridart_setup()
		ELSE
		    =GridArt_ColorearGridActivex(thisform)
		ENDIF
		
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockForm(thisform)
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE gridart_setup
		SET PROCEDURE TO grid_articulos_ui ADDITIVE
		
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    =GridArt_BindActiveX(thisform, "grid1", 3, 4)
		    =GridArt_BindTooltipEvents(thisform)
		ENDIF
		
		=GridArt_ColorearGridActivex(thisform)
		ON KEY LABEL ESC DO GridArt_OnEsc IN grid_articulos_ui
		
		RETURN
		
	ENDPROC

	PROCEDURE Init
		parameter xpres,cond,codicli
		public elimi,descrip,muestro,postal,locali,provi,opcion,x, ;
			   dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot,insertar, ;
			   impiva1,impiva2,borra,codiva,codped,transporte,coditran,coditran1,coditran2,auxcond,auxregis,localiz, ;
			   buscar,validez,plazo,condpag,lugent,observ,vcodi,letrapor,porcodi,nitemapp,acu,paso,aux,obser,auxiva,auximpo,auxali
		
		STORE 0 TO auxiva,auximpo,auxali,aux,nitemapp,letrapor,porcodi,vcodi,coditran1,coditran2,paso,thisform.acu, ;
				   elimi,localiz,muestro,opcion,insertar,borra,codigo,x,codped,auxregis
		
		STORE "" TO obser,validez,plazo,condpag,lugent,observ,transporte,descrip
		
		CREATE CURSOR delitems(artped_codi N(8))
		
		_screen.xopvta="PE"
		
		buscar=1
		
		thisform.codicli=codicli
		thisform.xcond=cond
		
		set dele on
		
		SET TALK OFF
		SET CONSOLE OFF
		SET NOTIFY OFF
		SET STATUS BAR OFF
		
		this.text13.value=date()
		thisform.valorcadena=valorcadena
		STORE 0 TO this.text19.value, ;
				   this.text15.value, ;
				   this.text21.value, ;
				   this.text8.Value, ;
				   this.text17.Value, ;
				   this.text18.Value, ;
				   this.text9.Value, ;
				   this.text11.Value, ;
		           this.text10.Value
		frmaltapxp= conectar_db(_screen.cn)
			SQLEXEC(frmaltapxp,"select * from iva order by iva_codi desc limit 1;","cur_iva")
		desconectar_db(frmaltapxp)
		go bott
		codiva=cur_iva.iva_codi
		thisform.impiva1=cur_iva.iva_1
		thisform.impiva2=cur_iva.iva_2
		thisform.label12.caption=allt(str(thisform.impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(thisform.impiva2,10,2))+"%"
		frmaltapxp= conectar_db(_screen.cn)
			IF USED("cur_porc")
				USE IN cur_porc
			ENDIF
			SQLEXEC(frmaltapxp,"select concat('   ',TRIM(CAST(porc_codi as char))) as porc_codi,concat('   ',TRIM(porc_desc)) as porc_desc,porc_impo from porcencomi order by porc_codi;","cur_porc")
		desconectar_db(frmaltapxp)
		
		with thisform
			frmaltapxp= conectar_db(_screen.cn)
				SQLEXEC(frmaltapxp,"call usp_buscarcli(?thisform.codicli);","cur_clie")
			desconectar_db(frmaltapxp)
			.text1.value=cur_clie.cli_nomb
			.text2.value=cur_clie.cli_domi
			.text3.value=cur_clie.cp_nro
			.text4.value=cur_clie.loca_nomb
			.text5.value=cur_clie.provi_nomb
			.text6.value=cur_clie.cond_desc
			.text12.value=VAL(cur_clie.cli_cuit)
			IF USED("cur_vendedor")
				USE IN cur_vendedor
			ENDIF
			frmaltapxp= conectar_db(_screen.cn)
				SQLEXEC(frmaltapxp,"select a.*,b.* from zonas a inner join vendedores b on a.ven_codi=b.ven_codi where a.zona_codi=?cur_clie.zona_codi;","cur_vendedor")
			desconectar_db(frmaltapxp)
			vcodi=cur_vendedor.ven_codi
			.text15.value=cur_vendedor.ven_codi
			.text16.value=cur_vendedor.ven_nomb
			frmaltapxp= conectar_db(_screen.cn)
				SQLEXEC(frmaltapxp,"select param_impo from parametros where param_codi = 14;","cur_dolar")
			desconectar_db(frmaltapxp)
			.txt_cotiz.Value= cur_dolar.param_impo
			thisform.xcotiz=.txt_cotiz.Value
			cerrar_cursor("cur_dolar")
		endwith					
		thisform.xcond=cur_clie.cond_codi
		auxcond=thisform.xcond
		frmaltapxp= conectar_db(_screen.cn)
			SQLEXEC(frmaltapxp,"select * from presupuestos where presup_codi=?xpres;","cur_pres")
		desconectar_db(frmaltapxp)
		this.text19.value=cur_pres.presup_dto
		SELECT cur_itemsped
		LOCATE
		LOCAL cant_aped,pre_aped,med_aped,nreg,desc_sc
		SET POINT TO ","
		SET DECIMALS TO 3
		SCAN
			cant_aped=0
			pre_aped=0
			med_aped=''
			IF cur_itemsped.art_codi <= 5
				nreg= cur_itemsped.nro_regis
				frmaltapxp= conectar_db(_screen.cn)
					SQLEXEC(frmaltapxp,"select artpres_dasc from presupuestos_articulos where presup_codi = ?cur_itemsped.presup_codi and nro_regis = ?nreg;","cur_descsc")
				desconectar_db(frmaltapxp)
				IF RECCOUNT("cur_descsc") > 0
					desc_sc = ALLTRIM(cur_descsc.artpres_dasc)
					cerrar_cursor("cur_descsc")
				ENDIF
			ELSE
				desc_sc = ALLTRIM(cur_itemsped.art_desc)
			ENDIF
			IF cur_itemsped.selpres=.T.
				cadena=repl("0",8-len(allt(str(cur_itemsped.art_codi))))+allt(str(cur_itemsped.art_codi))
				if ALLTRIM(cur_itemsped.art_med)="ALT" AND cur_itemsped.selpres=.T.
					LOCAL ubireg
					ubireg=RECNO("cur_itemsped")
					DO WHILE ALLTRIM(cur_itemsped.art_med)="ALT" AND !BOF()
						skip-1
					ENDDO
					cant_aped=cur_itemsped.artpres_cant
					med_aped=cur_itemsped.art_med
					GO ubireg
					pre_aped=cur_itemsped.artpres_precio
					nitemapp=nitemapp+1
					thisform.grid1.additem(ALLTRIM(STR(nitemapp))+chr(9)+ALLTRIM(STR(cant_aped,10,3))+chr(9)+ALLTRIM(med_aped)+chr(9)+ ;
										   cadena+chr(9)+ALLTRIM(desc_sc)+chr(9)+str(cur_itemsped.artpres_precio,15,3)+CHR(9)+str(cur_itemsped.artpres_precio*cant_aped,15,2))
					thisform.acu=thisform.acu+cant_aped*pre_aped
				ELSE
					nitemapp=nitemapp+1
					thisform.grid1.additem(ALLTRIM(STR(nitemapp))+chr(9)+ALLTRIM(STR(cur_itemsped.artpres_cant,10,3))+chr(9)+ALLTRIM(cur_itemsped.art_med)+chr(9)+ ;
										   cadena+chr(9)+ALLTRIM(desc_sc)+chr(9)+str(cur_itemsped.artpres_precio,15,3)+CHR(9)+str(cur_itemsped.artpres_precio*cur_itemsped.artpres_cant,15,2))
					thisform.acu=thisform.acu+cur_itemsped.artpres_cant*cur_itemsped.artpres_precio
				endif
				this.grid1.row=this.grid1.rows-1
				thisform.grid1.col=7
				do case
					case cur_itemsped.art_alicuota=1
						thisform.grid1.text=allt(str(thisform.impiva1,10,2))
					case cur_itemsped.art_alicuota=2
						thisform.grid1.text=allt(str(thisform.impiva2,10,2))
				ENDCASE
				this.grid1.col=4
				if len(allt(this.grid1.text))>47
					div=len(allt(this.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					this.grid1.rowheight(this.grid1.row)=longdes
				else
					this.grid1.rowheight(this.grid1.row)=270
				endif
				this.grid1.col=0
				this.grid1.cellalignment=3
				this.grid1.col=1
				this.grid1.cellalignment=3
				this.grid1.col=2
				this.grid1.cellalignment=3
				this.grid1.col=3
				this.grid1.cellalignment=3
				this.grid1.col=4
				this.grid1.cellalignment=0
				this.grid1.col=5
				this.grid1.cellalignment=8
				this.grid1.col=6
				this.grid1.cellalignment=8
				this.grid1.col=7
				this.grid1.cellalignment=8
				this.text8.value=thisform.acu
				this.text17.value=iif(this.text19.value>0,round((thisform.acu*this.text19.value)/100,2),0)
				this.text18.value=this.text8.value-this.text17.value
				if this.text19.value>0
					do case
						case cur_itemsped.art_alicuota=1
							if thisform.xcond=2
								thisform.impo1=thisform.impo1+((IIF(cant_aped>0,cant_aped,cur_itemsped.artpres_cant)*IIF(pre_aped>0,pre_aped,cur_itemsped.artpres_precio))*((100-this.text19.value)/100))
								this.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							else
								thisform.acun1=thisform.acun1+round((((IIF(cant_aped>0,cant_aped,cur_itemsped.artpres_cant)*IIF(pre_aped>0,pre_aped,cur_itemsped.artpres_precio))*((100-this.text19.value)/100))/(1+(thisform.impiva1/100))),3)
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
						case cur_itemsped.art_alicuota=2
							if thisform.xcond=2
								thisform.impo2=thisform.impo2+((IIF(cant_aped>0,cant_aped,cur_itemsped.artpres_cant)*IIF(pre_aped>0,pre_aped,cur_itemsped.artpres_precio))*((100-this.text19.value)/100))
								this.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							else
								thisform.acun2=thisform.acun2+round((((IIF(cant_aped>0,cant_aped,cur_itemsped.artpres_cant)*IIF(pre_aped>0,pre_aped,cur_itemsped.artpres_precio))*((100-this.text19.value)/100))/(1+(thisform.impiva2/100))),3)
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
					endcase
				else
					do case
						case cur_itemsped.art_alicuota=1
							if thisform.xcond=2
								thisform.impo1=thisform.impo1+(IIF(cant_aped>0,cant_aped,cur_itemsped.artpres_cant)*IIF(pre_aped>0,pre_aped,cur_itemsped.artpres_precio))
								this.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
							else
								thisform.acun1=thisform.acun1+round(((IIF(cant_aped>0,cant_aped,cur_itemsped.artpres_cant)*IIF(pre_aped>0,pre_aped,cur_itemsped.artpres_precio))/(1+(thisform.impiva1/100))),3)
								thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
							endif
						case cur_itemsped.art_alicuota=2
							if thisform.xcond=2
								thisform.impo2=thisform.impo2+(IIF(cant_aped>0,cant_aped,cur_itemsped.artpres_cant)*IIF(pre_aped>0,pre_aped,cur_itemsped.artpres_precio))
								this.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
							else
								thisform.acun2=thisform.acun2+round(((IIF(cant_aped>0,cant_aped,cur_itemsped.artpres_cant)*IIF(pre_aped>0,pre_aped,cur_itemsped.artpres_precio))/(1+(thisform.impiva2/100))),3)
								thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
							endif
					endcase
				endif
				this.text10.value=this.text18.value+this.text9.value+this.text11.value
			ENDIF
		ENDSCAN
		
		SET POINT TO
		SET DECIMALS TO
		
		selecitem.release
		
		&& === Integracion grid_articulos_ui ===
		thisform.gridart_setup()
		&& === Fin integracion grid_articulos_ui ===
	ENDPROC

	PROCEDURE Load
		set skip of bar 3 of Altas .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if valorcadena="Por Presupuesto"
		*!*		set skip of bar 3 of Altas .F.
		*!*		localiz=0
		*!*	*	item=0
		*!*	endif
	ENDPROC

	PROCEDURE moneda_obser
		IF AT('PRECIOS EX',obser) > 0
			DO CASE
				CASE AT('DOLARES',obser) > 0 AND thisform.ctn_moneda.chk_pesos.Value = 1
					obser = STRTRAN(obser,'DOLARES','PESOS')
				CASE AT('PESOS',obser) > 0 AND thisform.ctn_moneda.chk_dolares.Value = 1
					obser = STRTRAN(obser,'PESOS','DOLARES')
				CASE thisform.ctn_moneda.chk_dolares.Value = 0 AND thisform.ctn_moneda.chk_pesos.Value = 0
					DO CASE
						CASE AT('DOLARES',obser) > 0
							obser = LEFT(obser,AT('PRECIOS EX',obser)-1) + RIGHT(obser,LEN(obser)-(AT('PRECIOS EX',obser)+32))
						CASE AT('PESOS',obser) > 0
							obser = LEFT(obser,AT('PRECIOS EX',obser)-1) + RIGHT(obser,LEN(obser)-(AT('PRECIOS EX',obser)+30))
					ENDCASE
			ENDCASE
		ELSE
			IF LEN(ALLTRIM(obser)) = 0
				DO case
					CASE thisform.ctn_moneda.chk_pesos.Value = 1
						obser = 'PRECIOS EXPRESADOS EN PESOS'
					CASE thisform.ctn_moneda.chk_dolares.Value = 1
						obser = 'PRECIOS EXPRESADOS EN DOLARES'
				ENDCASE
			ELSE
				DO case
					CASE thisform.ctn_moneda.chk_pesos.Value = 1
						obser = 'PRECIOS EXPRESADOS EN PESOS'+ CHR(13) + CHR(10)+ CHR(10) + ALLTRIM(obser)
					CASE thisform.ctn_moneda.chk_dolares.Value = 1
						obser = 'PRECIOS EXPRESADOS EN DOLARES'+ CHR(13) + CHR(10)+ CHR(10) + ALLTRIM(obser)
				ENDCASE		
			ENDIF
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE btn_deta.Click
		IF LEN(ALLTRIM(cur_clie.cli_deta)) > 0
			MESSAGEBOX(ALLTRIM(cur_clie.cli_deta),64,"Detalles Adicionales del Cliente")
		ELSE
			MESSAGEBOX("No hay detalles ingresados para este cliente",48,"Detalles Adicionales del Cliente")
		ENDIF
		
	ENDPROC

	PROCEDURE Check1.Click
		IF this.Value=1
			coditran1=0
			thisform.text14.Value=''
			thisform.edit1.Value=''
			thisform.opcionflete1.Value=0
		ELSE
			IF coditran1=0
				this.Value=1
			endif
		endif
		
	ENDPROC

	PROCEDURE Check2.Click
		IF this.Value=1
			coditran2=0
			thisform.text22.Value=''
			thisform.edit2.Value=''
			thisform.opcionflete2.Value=0
		ELSE
			IF coditran2=0
				this.Value=1
			endif
		endif
	ENDPROC

	PROCEDURE Command1.Click
		do case
		case nitemapp=0
			messagebox("Aún no ha ingresado ningún artículo al Pedido, imposible Terminar"+chr(13)+ ;
					   "Ingrese algún artículo presionando la tecla INSERT. Si desea salir de la"+chr(13)+ ; 
					   "rutina utilize el botón Salir o presione la tecla ESC",48,"Advertencia")
			RETURN
		case letrapor=0 and thisform.text15.value>0
			messagebox("Debe ingresar la comisión del vendedor para guardar el Pedido",0+48,"Advertencia")
			RETURN
		CASE coditran1=0 AND coditran2>0
			MESSAGEBOX("Si seleccionó Transporte de Redespacho no puede guardar el pedido sin antes seleccionar un Transporte de Orígen.",0+48,"Advertencia")	
			RETURN
		CASE thisform.ctn_moneda.chk_dolares.Value = 0 AND thisform.ctn_moneda.chk_pesos.Value = 0
			MESSAGEBOX("Para continuar debe especificar la moneda para el pedido.",48,"Aviso del Sistema")
			RETURN
		CASE thisform.ctn_moneda.chk_pesos.Value = 1 AND thisform.txt_cotiz.Value = 0
			MESSAGEBOX("Usted ha optado por la moneda PESOS, por lo tanto, debe especificar un importe de cotización de dolar mayor a 0.-",48,"Aviso del Sistema")
			thisform.txt_cotiz.SetFocus
			RETURN
		otherwise
			preg=messagebox("¿Confirma los datos del Pedido?",4+32+256,"Alta de Pedidos de Clientes")
			if preg=6
				with thisform
					LOCAL xcodip,xfecha,xhora,xdto,npres,xnped,xcodiven,xotracomi,xdasc,xarti,xdac,xcant,xprec,xlug,xcar,xarpc,xmoneda,xcoti,xit,lnLock
					lnLock = 0
					xfecha=.text13.value
					xhora = IIF(.text13.value < DATE(),'23:59:59',TTOC(DATETIME(),2))
					xdto=.text19.value
					xnped=0
					xcodiven=.text15.value
					npres=cur_pres.presup_codi
					xotracomi=IIF(LEN(ALLTRIM(.text20.value))=0 and .text21.value>0,.text21.value,0)
					IF thisform.npedi=0
						xcodip=0
		*!*					frmaltapxp= conectar_db(_screen.cn)
		*!*						SQLEXEC(frmaltapxp,"select cast(ped_codi+1 as DECIMAL(8,0)) as ped_codi from pedidos order by ped_codi desc limit 1;","cur_nvo")
		*!*					desconectar_db(frmaltapxp)
		*!*					thisform.npedi=cur_nvo.ped_codi
		*!*					xcodip=thisform.npedi
						frmaltapxp= conectar_db(_screen.cn)
							DO CASE
								CASE thisform.ctn_moneda.chk_dolares.Value = 1
									xmoneda = 'D'
									xcoti = thisform.xcotiz
								CASE thisform.ctn_moneda.chk_pesos.Value = 1
									xmoneda = 'P'
									xcoti = thisform.txt_cotiz.Value
							ENDCASE
							lnLock = MySQL_LockTables("LOCK", "pedidos WRITE", frmaltapxp)
							SQLEXEC(frmaltapxp,"call usp_guardaped(1,?xcodip,?xfecha,?xhora,?thisform.codicli,?xdto,?codiva,?npres,?xnped,?xcodiven,?porcodi,?xotracomi,?obser,?xmoneda,?xcoti);","cur_nvo")
							lnLock = MySQL_LockTables("UNLOCK", "", frmaltapxp)
							thisform.npedi=cur_nvo.ped_codi
							xcodip=thisform.npedi
							IF coditran1>0
								xlug=ALLTRIM(thisform.edit1.value)
								DO case
									CASE thisform.opcionflete1.Value=1
										xcar='C'
									CASE thisform.opcionflete1.Value=2
										xcar='P'
								ENDCASE
								SQLEXEC(frmaltapxp,"select CAST(pedtran_codi+1 as DECIMAL(8,0)) as pedtran_codi from pedidos_transportes order by pedtran_codi desc limit 1;","cur_ptnvo")
								SQLEXEC(frmaltapxp,"insert into pedidos_transportes values(?cur_ptnvo.pedtran_codi,?xcodip,?coditran1,?xlug,?xcar);")
							endif
							IF coditran2>0
								xlug=ALLTRIM(thisform.edit2.value)
								DO case
									CASE thisform.opcionflete2.Value=1
										xcar='C'
									CASE thisform.opcionflete2.Value=2
										xcar='P'
								ENDCASE
								SQLEXEC(frmaltapxp,"select CAST(pedtran_codi+1 as DECIMAL(8,0)) as pedtran_codi from pedidos_transportes order by pedtran_codi desc limit 1;","cur_ptnvo")
								SQLEXEC(frmaltapxp,"insert into pedidos_transportes values(?cur_ptnvo.pedtran_codi,?xcodip,?coditran2,?xlug,?xcar);")
							ENDIF
						desconectar_db(frmaltapxp)
						nitemapp=0
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								.grid1.col=3
								if val(.grid1.text)=4 OR val(.grid1.text)=5
									.grid1.col=4
									xdasc=ALLTRIM(.grid1.text)
								else
									xdasc=""
								endif
								.grid1.col=3
								xarti=val(.grid1.text)
								.grid1.col=4
								frmaltapxp= conectar_db(_screen.cn)
									SQLEXEC(frmaltapxp,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
								desconectar_db(frmaltapxp)
								if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
									frmaltapxp= conectar_db(_screen.cn)
										SQLEXEC(frmaltapxp,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
									desconectar_db(frmaltapxp)
									IF RECCOUNT("cur_artcli")>0
										LOCAL xcadena
										xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(.grid1.text)
										frmaltapxp= conectar_db(_screen.cn)
											SQLEXEC(frmaltapxp,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
										desconectar_db(frmaltapxp)
										IF RECCOUNT("cur_ddes")>0
											xdac=cur_ddes.dac_codi
										endif
									endif
								else
									xdac=0
								ENDIF
								.grid1.col=0
								xit=VAL(.grid1.text)
								.grid1.col=1
								xcant=ConverNro(.grid1.text)			
								.grid1.col=5
								xprec=ConverNro(.grid1.text)
								frmaltapxp= conectar_db(_screen.cn)
									lnLock = MySQL_LockTables("LOCK", "pedidos_articulos WRITE", frmaltapxp)
									SQLEXEC(frmaltapxp,"select cast(artped_codi+1 as DECIMAL(8,0)) as artped_codi from pedidos_articulos order by artped_codi desc limit 1;","cur_pednvo")
									SQLEXEC(frmaltapxp,"insert into pedidos_articulos values(?cur_pednvo.artped_codi,?xcodip,?xarti,?xcant,?xprec,0,0,?xdasc,?xdac,?xit);")
									lnLock = MySQL_LockTables("UNLOCK", "", frmaltapxp)
		*!*								SQLEXEC(frmaltapxp,"update articulos set pedidos = pedidos + ?xcant where art_codi = ?xarti;")
								desconectar_db(frmaltapxp)
								.grid1.col=8
								.grid1.text=ALLTRIM(STR(cur_pednvo.artped_codi))
								IF xarti > 5
									Campo_ped(xarti)
								ENDIF
							ENDIF
							nitemapp=nitemapp+1
						next fila
						thisform.buscar_pedido(xcodip)
						cerrar_cursor("cur_arped")
						nitemapp=nitemapp-1
					ELSE
						DO CASE
							CASE thisform.ctn_moneda.chk_dolares.Value = 1
								xmoneda = 'D'
								xcoti = thisform.xcotiz
							CASE thisform.ctn_moneda.chk_pesos.Value = 1
								xmoneda = 'P'
								xcoti = thisform.txt_cotiz.Value
						ENDCASE
						xcodip=thisform.npedi
						frmaltapxp= conectar_db(_screen.cn)
							SQLEXEC(frmaltapxp,"call usp_guardaped(2,?xcodip,?xfecha,?xhora,?thisform.codicli,?xdto,?codiva,?npres,?xnped,?xcodiven,?porcodi,?xotracomi,?obser,?xmoneda,?xcoti);")
							IF coditran1>0
								SQLEXEC(frmaltapxp,"select * from pedidos_transportes where ped_codi=?xcodip;","cur_tra")
								IF RECCOUNT("cur_tra")>0
									GO top
									xlug=ALLTRIM(thisform.edit1.value)
									DO case
										CASE thisform.opcionflete1.Value=1
											xcar='C'
										CASE thisform.opcionflete1.Value=2
											xcar='P'
									ENDCASE
									SQLEXEC(frmaltapxp,"update pedidos_transportes set tran_codi=?coditran1,flete_lugent=?xlug,flete_cargo=?xcar where pedtran_codi=?cur_tra.pedtran_codi;")
									IF RECCOUNT("cur_tra")>1
										GO bott
										xlug=ALLTRIM(thisform.edit2.value)
										DO case
											CASE thisform.opcionflete2.Value=1
												xcar='C'
											CASE thisform.opcionflete2.Value=2
												xcar='P'
										ENDCASE
										SQLEXEC(frmaltapxp,"update pedidos_transportes set tran_codi=?coditran2,flete_lugent=?xlug,flete_cargo=?xcar where pedtran_codi=?cur_tra.pedtran_codi;")
									ENDIF
								ELSE
									xlug=ALLTRIM(thisform.edit1.value)
									DO case
										CASE thisform.opcionflete1.Value=1
											xcar='C'
										CASE thisform.opcionflete1.Value=2
											xcar='P'
									ENDCASE
									SQLEXEC(frmaltapxp,"select CAST(pedtran_codi+1 as DECIMAL(8,0)) as pedtran_codi from pedidos_transportes order by pedtran_codi desc limit 1;","cur_ptnvo")
									SQLEXEC(frmaltapxp,"insert into pedidos_transportes values(?cur_ptnvo.pedtran_codi,?xcodip,?coditran1,?xlug,?xcar);")
									IF coditran2>0
										xlug=ALLTRIM(thisform.edit2.value)
										DO case
											CASE thisform.opcionflete2.Value=1
												xcar='C'
											CASE thisform.opcionflete2.Value=2
												xcar='P'
										ENDCASE
										SQLEXEC(frmaltapxp,"select CAST(pedtran_codi+1 as DECIMAL(8,0)) as pedtran_codi from pedidos_transportes order by pedtran_codi desc limit 1;","cur_ptnvo")
										SQLEXEC(frmaltapxp,"insert into pedidos_transportes values(?cur_ptnvo.pedtran_codi,?xcodip,?coditran2,?xlug,?xcar);")
									ENDIF
								ENDIF
							ELSE
								SQLEXEC(frmaltapxp,"select * from pedidos_transportes where ped_codi=?xcodip;","cur_tra")
								IF RECCOUNT("cur_tra")>0
									SQLEXEC(frmaltapxp,"delete from pedidos_transportes where ped_codi=?xcodip;")
								ENDIF
							ENDIF
						desconectar_db(frmaltapxp)
						IF USED("delitems")
							SELECT delitems
							LOCATE
							LOCAL xap
							SCAN
								xap= delitems.artped_codi
								frmaltapxp = conectar_db(_screen.cn)
		*!*								IF delitems.art_codi > 5
		*!*									SQLEXEC(frmaltapxp,"update articulos set pedidos = pedidos - ?delitems.artped_cant where art_codi = ?delitems.art_codi;")
		*!*								ENDIF
									SQLEXEC(frmaltapxp, "delete from pedidos_articulos where artped_codi = ?xap;")
								desconectar_db(frmaltapxp)
								SELECT delitems
								IF delitems.art_codi > 5
									Campo_ped(delitems.art_codi)
								ENDIF
							ENDSCAN
							cerrar_cursor("delitems")
						ENDIF
						nitemapp=0
						for fila=1 to .grid1.rows
							if fila<.grid1.rows
								.grid1.row=fila
								.grid1.col=3
								if val(.grid1.text)=4 OR val(.grid1.text)=5
									.grid1.col=4
									xdasc=ALLTRIM(.grid1.text)
								else
									xdasc=""
								endif
								.grid1.col=3
								xarti=val(.grid1.text)
								.grid1.col=4
								frmaltapxp= conectar_db(_screen.cn)
									SQLEXEC(frmaltapxp,"select TRIM(art_desc) as art_desc from articulos where art_codi=?xarti;","cur_desc")
								desconectar_db(frmaltapxp)
								if xarti>5 and allt(.grid1.text)<>allt(cur_desc.art_desc)
									frmaltapxp= conectar_db(_screen.cn)
										SQLEXEC(frmaltapxp,"select * from articulos_clientes where cli_codi=?thisform.codicli and art_codi=?xarti;","cur_artcli")
									desconectar_db(frmaltapxp)
									IF RECCOUNT("cur_artcli")>0
										LOCAL xcadena
										xcadena=ALLTRIM(STR(cur_artcli.artcli_codi))+ALLTRIM(.grid1.text)
										frmaltapxp= conectar_db(_screen.cn)
											SQLEXEC(frmaltapxp,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
										desconectar_db(frmaltapxp)
										IF RECCOUNT("cur_ddes")>0
											xdac=cur_ddes.dac_codi
										endif
									endif
								else
									xdac=0
								ENDIF
								.grid1.col=0
								xit=VAL(.grid1.text)
								.grid1.col=1
								xcant=ConverNro(.grid1.text)			
								.grid1.col=5
								xprec=ConverNro(.grid1.text)
								.grid1.col=8
								xarpc=VAL(.grid1.text)
								frmaltapxp= conectar_db(_screen.cn)
									IF xarpc>0
		*!*									IF USED("cur_modic")
		*!*										SELECT cur_modic
		*!*										LOCATE
		*!*										SCAN
		*!*											artmodi = cur_modic.m_artcod
		*!*											canmodi = cur_modic.m_artcan
		*!*											SQLEXEC(frmaltapxp,"update articulos set pedidos = pedidos - ?canmodi where art_codi = ?artmodi;")
		*!*										ENDSCAN
		*!*										cerrar_cursor("cur_modic")
		*!*									ENDIF							
										SELECT act_pend FROM cur_pend WHERE artped_codi = xarpc INTO ARRAY ar_xactp
										SELECT ROUND(act_pend - ant_pend,3) fpend FROM cur_pend WHERE artped_codi = xarpc INTO ARRAY ar_xpendi
										xdelpend = ar_xpendi[1,1]
										SQLEXEC(frmaltapxp,"update pedidos_articulos set art_codi=?xarti,artped_cant=?xcant,artped_precio=?xprec,artped_dasc=?xdasc,dac_codi=?xdac,artped_it=?xit where artped_codi=?VAL(ALLTRIM(.grid1.text));")
		*!*									IF ar_xactp[1,1] <> 0
		*!*										SQLEXEC(frmaltapxp,"update articulos set pedidos = pedidos + ?xdelpend where art_codi = ?xarti;")
		*!*									ENDIF								
									ELSE
										lnLock = MySQL_LockTables("LOCK", "pedidos_articulos WRITE", frmaltapxp)
										SQLEXEC(frmaltapxp,"select cast(artped_codi+1 as DECIMAL(8,0)) as artped_codi from pedidos_articulos order by artped_codi desc limit 1;","cur_pednvo")
										IF RECCOUNT("cur_pednvo")>0
											xarpc=cur_pednvo.artped_codi
										ELSE
											xarpc=1
										ENDIF
										SQLEXEC(frmaltapxp,"insert into pedidos_articulos values(?cur_pednvo.artped_codi,?xcodip,?xarti,?xcant,?xprec,0,0,?xdasc,?xdac,?xit);")
		*!*									SQLEXEC(frmaltapxp,"update articulos set pedidos = pedidos + ?xcant where art_codi = ?xarti;")								
										lnLock = MySQL_LockTables("UNLOCK", "", frmaltapxp)
										.grid1.col=8
										.grid1.text=ALLTRIM(STR(cur_pednvo.artped_codi))
									ENDIF
								desconectar_db(frmaltapxp)
								IF xarti > 5
									Campo_ped(xarti)
								ENDIF
							ENDIF
							nitemapp=nitemapp+1
						next fila
						cerrar_cursor("cur_pend")
						nitemapp=nitemapp-1
					ENDIF
					ivari=.text9.value
					ivarni=.text11.value
					totalri=.text18.value+.text9.value
					totalrni=.text18.value+.text9.value+.text11.value
					totsiva=.text18.value
					DIMENSION tra[2,3]
					store "" to tra
					IF coditran1>0
						frmaltapxp= conectar_db(_screen.cn)
							SQLEXEC(frmaltapxp,"select * from transportes where tran_codi=?coditran1;","cur_tra")
						desconectar_db(frmaltapxp)
						if RECCOUNT("cur_tra")>0
							tra[1,1]=allt(cur_tra.tran_nomb)
						endif
						tra[1,2]=allt(.edit1.value)
						tra[1,3]=iif(.opcionflete1.value=1,"C",iif(.opcionflete1.value=2,"P",""))
						if coditran2>0
							frmaltapxp= conectar_db(_screen.cn)
								SQLEXEC(frmaltapxp,"select * from transportes where tran_codi=?coditran2;","cur_tra2")
							desconectar_db(frmaltapxp)
							if RECCOUNT("cur_tra2")>0
								tra[2,1]=allt(cur_tra2.tran_nomb)
							endif
							tra[2,2]=allt(.edit2.value)
							tra[2,3]=iif(.opcionflete2.value=1,"C",iif(.opcionflete2.value=2,"P",""))
						ENDIF
					ENDIF
					SET DECIMALS TO 4
					frmaltapxp= conectar_db(_screen.cn)
						SQLEXEC(frmaltapxp,"select b.*,c.*,d.cond_desc from pedidos a inner join iva b on a.iva_codi=b.iva_codi inner join clientes c on c.cli_codi=a.cli_codi inner join condiva d on c.cond_codi=d.cond_codi where a.ped_codi=?xcodip;","cur_datvar")
						SQLEXEC(frmaltapxp,"select a.*,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on c.provi_codi=a.provi_codi where a.loca_codi=?cur_datvar.loca_codi;","cur_ubic")
						SQLEXEC(frmaltapxp,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dac_desc from pedidos_articulos a inner join articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.ped_codi=?xcodip order by a.artped_it;","cur_arped")
						SQLEXEC(frmaltapxp,"select * from pedidos where ped_codi=?xcodip;","cur_pedido")
						IF USED("cur_vendedor")
							USE IN cur_vendedor
						ENDIF
						SQLEXEC(frmaltapxp,"select a.*,b.* from zonas a inner join vendedores b on a.ven_codi=b.ven_codi where a.zona_codi=?cur_clie.zona_codi;","cur_vendedor")
					desconectar_db(frmaltapxp)
					SET DECIMALS TO
					SET POINT TO ","
					SET SEPARATOR TO "."
					SELECT cur_arped
					GO top
					GO TOP IN cur_pedido
					report form pedidocliente for cur_pedido.ped_codi=xcodip TO PRINTER PROMPT noconsole
					SET POINT TO
					SET SEPARATOR TO
					thisform.release
				endwith
			endif
		endcase
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=8
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command10.Click
		with thisform
			.shape5.visible=.T.
			.optiongroup1.visible=.T.
			.label25.visible=.T.
			.text24.visible=.T.
			.command11.visible=.T.
			.label25.caption=""
			.text24.value=0
			.optiongroup1.value=0
		endwith
	ENDPROC

	PROCEDURE Command10.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command10.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command11.Click
		coe=messagebox("¿Confirma aplicar el coeficiente indicado?",4+32+256,"Precios")
		if coe=6
			with thisform
				LOCAL ivaencol
				STORE 0 TO thisform.acu,auxiva,auximpo,auxali
				STORE 0 TO thisform.impo1, ;
						   thisform.impo2, ;
						   thisform.acu1, ;
						   thisform.acu2, ;
						   thisform.acun1, ;
						   thisform.acun2
				STORE 0 TO .text8.value, ;
					       .text9.value, ;
				           .text10.value, ;
				           .text11.value, ;
				           .text17.value, ;
		 		           .text18.value
				SET POINT TO ","
				SET DECIMALS TO 3
				for i=1 to .grid1.rows-1
					.grid1.row=i
					.grid1.col=1
					valor1=ConverNro(.grid1.text)
					.grid1.col=5
					if .optiongroup1.value=1
						valor2=ConverNro(.grid1.text)*.text24.value
					else
						valor2=round(ConverNro(.grid1.text)/.text24.value,3)
					endif
					.grid1.text=allt(str(valor2,10,3))
					.grid1.col=6
					.grid1.text=allt(str(valor1*valor2,10,2))
					thisform.acu=thisform.acu+ConverNro(.grid1.text)
					********************COMIENZA CALCULO DE IVA*********************
					SET DECIMALS TO
					.grid1.col=2
					.text8.value=thisform.acu
					.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
					.text18.value=.text8.value-.text17.value
					.grid1.col=7
					do case
						case ConverNro(.grid1.text)=thisform.impiva1
							ivaencol=1
						case ConverNro(.grid1.text)=thisform.impiva2
							ivaencol=2
					ENDCASE
					.grid1.col=6
					if .text19.value>0
						do case
							case ivaencol=1
								if thisform.xcond=2
									thisform.impo1=thisform.impo1+(ConverNro(.grid1.text)*((100-.text19.value)/100))
									if auxali=2
										.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
									endif
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								else
									thisform.acun1=thisform.acun1+round(((ConverNro(.grid1.text)*((100-.text19.value)/100))/(1+(thisform.impiva1/100))),3)
									if auxali=2
										thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
									endif
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
							case ivaencol=2
								if thisform.xcond=2
									thisform.impo2=thisform.impo2+(ConverNro(.grid1.text)*((100-.text19.value)/100))
									if auxali=1
										.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
									endif
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								else
									thisform.acun2=thisform.acun2+round(((ConverNro(.grid1.text)*((100-.text19.value)/100))/(1+(thisform.impiva2/100))),3)
									if auxali=1
										thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
									endif
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
						endcase
					else
						do case
							case ivaencol=1
								if thisform.xcond=2
									thisform.impo1=thisform.impo1+ConverNro(.grid1.text)
									if auxali=2
										.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
									endif
									.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
								else
									thisform.acun1=thisform.acun1+round((ConverNro(.grid1.text)/(1+(thisform.impiva1/100))),3)
									if auxali=2
										thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
									endif
									thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
								endif
							case ivaencol=2
								if thisform.xcond=2
									thisform.impo2=thisform.impo2+ConverNro(.grid1.text)
									if auxali=1
										.text9.value=round((thisform.impo1*thisform.impiva1)/100,2)
									endif
									.text11.value=round((thisform.impo2*thisform.impiva2)/100,2)
								else
									thisform.acun2=thisform.acun2+round((ConverNro(.grid1.text)/(1+(thisform.impiva2/100))),3)
									if auxali=1
										thisform.acu1=round((thisform.acun1*thisform.impiva1)/100,2)
									endif
									thisform.acu2=round((thisform.acun2*thisform.impiva2)/100,2)
								endif
						endcase
					endif
					.text10.value=.text18.value+.text9.value+.text11.value
				next i
				SET POINT TO
				if paso>0
					paso=0
				endif
				.shape5.visible=.F.
				.optiongroup1.visible=.F.
				.label25.visible=.F.
				.text24.visible=.F.
				this.visible=.F.
			endwith
		else
			.text24.value=0
			.shape5.visible=.F.
			.optiongroup1.visible=.F.
			.label25.visible=.F.
			.text24.visible=.F.
			this.visible=.F.
		endif
	ENDPROC


	PROCEDURE Command5.Click
		validez=allt(cur_pres.presup_ofer)
		plazo=allt(cur_pres.presup_plent)
		condpag=allt(cur_pres.presup_cond)
		lugent=allt(cur_pres.presup_lugent)
		observ=allt(cur_pres.presup_obser)
		*!*	do form piepresup with validez,plazo,condpag,lugent,observ
		
		MESSAGEBOX("Validez Oferta      : "+ALLTRIM(validez)+CHR(13)+ ;
		           "Plazo Entrega       : "+ALLTRIM(plazo)+CHR(13)+ ;
		           "Condic. de Pago   : "+ALLTRIM(condpag)+CHR(13)+ ;
		           "Lugar de Entrega  : "+ALLTRIM(lugent)+CHR(13)+ ;
		           "Observaciones       : "+ALLTRIM(observ),"Pie del Presupuesto")
	ENDPROC


	PROCEDURE ctn_moneda.chk_dolares.Click
		IF this.Value=1 AND this.Parent.chk_pesos.Value=1
			this.Parent.chk_pesos.Value=0
		*!*		thisform.ctn_moneda.Top=26
			thisform.lbl_cotiz.Visible= .F.
			thisform.txt_cotiz.Visible= .F.
		*!*		thisform.txt_cotiz.Value=0
		ENDIF
	ENDPROC

	PROCEDURE ctn_moneda.chk_dolares.InteractiveChange
		thisform.moneda_obser()
	ENDPROC

	PROCEDURE ctn_moneda.chk_pesos.Click
		&&IF this.Value=1 AND this.Parent.chk_dolares.Value=1
		IF this.Value=1
			this.Parent.chk_dolares.Value=0
		*!*		thisform.ctn_moneda.Top=3
			thisform.lbl_cotiz.Visible= .T.
			thisform.txt_cotiz.Visible= .T.
		*!*		thisform.txt_cotiz.Value=0
			thisform.txt_cotiz.SetFocus
		ELSE
		*!*		thisform.ctn_moneda.Top=26
			thisform.lbl_cotiz.Visible= .F.
			thisform.txt_cotiz.Visible= .F.
		*!*		thisform.txt_cotiz.Value=0
		ENDIF
	ENDPROC

	PROCEDURE ctn_moneda.chk_pesos.InteractiveChange
		thisform.moneda_obser()
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Edit2.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit2.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockForm(thisform)
		ENDIF
	ENDPROC

	PROCEDURE grid1.DblClick
		*** ActiveX Control Event ***
		local x,y,dtopie,ivaencol
		ivaencol=0
		if nitemapp>0
			this.col=0
			aux=val(this.text)
			this.col=3
			dato1=val(this.text)
			this.col=1
			dato2=this.text
			this.col=4
			dato3=this.text
			this.col=5
			dato4=this.text
			this.col=6
			prtot=this.text
			this.col=2
			dato5=this.text
			auxiva=0
			auximpo=0
			frmaltapxp= conectar_db(_screen.cn)
				SQLEXEC(frmaltapxp,"select * from articulos where art_codi=?dato1;","cur_arti")
			desconectar_db(frmaltapxp)
			impiva1=thisform.impiva1
			impiva2=thisform.impiva2
			cond=thisform.xcond
			do form modippreg with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		if borra=6
			with thisform
				LOCAL xdelarp,xdelart,xdelcant
				this.col=8
				xdelarp=VAL(this.text)
				this.col=3
				xdelart=VAL(this.text)
				this.col=1
				xdelcant=ConverNro(this.text)
				IF xdelarp > 0
					IF !USED("delitems")
						CREATE CURSOR delitems(artped_codi N(8),art_codi N(8),artped_cant N(10,3))
					ENDIF
					INSERT INTO delitems values(xdelarp,xdelart,xdelcant)
				ENDIF	
				if this.rows=2
					this.col=7
					do case
						case ConverNro(this.text)=thisform.impiva1
							ivaencol=1
						case ConverNro(this.text)=thisform.impiva2
							ivaencol=2
					endcase
					this.col=6
					prtot=this.text
					this.rows=1
					STORE 0 TO nitemapp,thisform.acu,thisform.impo1,thisform.impo2,thisform.acun1,thisform.acun2, ;
						       thisform.acu1,thisform.acu2,.text8.value,.text9.value,.text10.value, ;
						       .text11.value,.text17.value,.text18.value,.text19.value
				else
					this.col=7
					do case
						case ConverNro(this.text)=thisform.impiva1
							ivaencol=1
						case ConverNro(this.text)=thisform.impiva2
							ivaencol=2
					endcase
					this.col=6
					prtot=this.text
					thisform.acu=thisform.acu-ConverNro(this.text)
					nitemapp=nitemapp-1
					this.removeitem(this.row)
					this.col=2
					x=1
					y=0
					do while x<=this.rows-1
						this.row=x
						y=y+1
						this.col=0
						this.text=allt(str(y))
						x=x+1
					enddo
				endif
				thisform.text8.value=thisform.acu
				if this.rows=>2
					if thisform.text19.value>0
						dtopie=round((100-thisform.text19.value)/100,2)
						thisform.text17.value=thisform.acu*dtopie
						thisform.text18.value=thisform.acu-thisform.text17.value
						do case
							case ivaencol=1
								thisform.impo1=thisform.impo1-(ConverNro(prtot)*dtopie)
								if thisform.xcond=2
									thisform.text9.value=thisform.text9.value-round((ConverNro(prtot)*dtopie)*thisform.impiva1/100,2)
								else
									auxacuneto=thisform.acun1
									thisform.acun1=thisform.acun1-((ConverNro(prtot)*dtopie)/(1+(thisform.impiva1/100)))
									thisform.acu1=thisform.acu1-(auxacuneto-thisform.acun1)*thisform.impiva1/100
								endif
							case ivaencol=2
								thisform.impo2=thisform.impo2-(ConverNro(prtot)*dtopie)
								if thisform.xcond=2
									thisform.text11.value=thisform.text11.value-round((ConverNro(prtot)*dtopie)*thisform.impiva2/100,2)
								else
									auxacuneto=thisform.acun2
									thisform.acun2=thisform.acun2-((ConverNro(prtot)*dtopie)/(1+(thisform.impiva2/100)))
									thisform.acu2=thisform.acu2-(auxacuneto-thisform.acun2)*thisform.impiva2/100
								endif
						endcase
					else
						thisform.text18.value=thisform.acu
						do case
							case ivaencol=1
								thisform.impo1=thisform.impo1-ConverNro(prtot)
								if thisform.xcond=2				
									thisform.text9.value=thisform.text9.value-round(ConverNro(prtot)*thisform.impiva1/100,2)
								else
									auxacuneto=thisform.acun1
									thisform.acun1=thisform.acun1-(ConverNro(prtot)/(1+(thisform.impiva1/100)))
									thisform.acu1=thisform.acu1-(auxacuneto-thisform.acun1)*thisform.impiva1/100
								endif
							case ivaencol=2
								thisform.impo2=thisform.impo2-ConverNro(prtot)
								if thisform.xcond=2
									thisform.text11.value=thisform.text11.value-round(ConverNro(prtot)*thisform.impiva2/100,2)
								else
									auxacuneto=thisform.acun2
									thisform.acun2=thisform.acun2-(ConverNro(prtot)/(1+(thisform.impiva2/100)))
									thisform.acu2=thisform.acu2-(auxacuneto-thisform.acun2)*thisform.impiva2/100
								endif
						endcase
					endif
					thisform.text10.value=thisform.text18.value+thisform.text9.value+thisform.text11.value
				endif	
			ENDWITH
			STORE 0 TO borra,insertar,preg
		endif
		if insertar=1 and codigo<>0
			SET POINT TO ","
			SET DECIMALS TO 3
			with thisform
				this.col=0
				nro=this.row
				frmaltapxp= conectar_db(_screen.cn)
					SQLEXEC(frmaltapxp,"select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmaltapxp)
				cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
				this.additem(" "+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+allt(cadena)+chr(9)+descri+chr(9)+allt(pruni)+chr(9)+prtot,.grid1.row)
				thisform.acu=thisform.acu+ConverNro(prtot)
				this.col=7
				do case
					case cur_arti.art_alicuota=1
						this.text=allt(str(impiva1,10,2))
					case cur_arti.art_alicuota=2
						this.text=allt(str(impiva2,10,2))
				ENDCASE
				nitemapp=nitemapp+1
				muestro=0
				localiz=1
				.grid1.row=nro
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				endif
				.grid1.col=0
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellalignment=3
				.grid1.col=2
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellalignment=8
				.grid1.col=7
				.grid1.cellalignment=8
				x=1
				y=0
				do while x<=this.rows-1
					this.row=x
					y=y+1
					this.col=0
					this.text=allt(str(y))
					x=x+1
				enddo
				insertar=0
			ENDWITH
			SET POINT TO
			SET DECIMALS TO
		ENDIF
		
		thisform.gridart_refresh()
	ENDPROC

	PROCEDURE grid1.GotFocus
		*!*	cond=clientes.cond_codi
		cond=thisform.xcond
		valorcadena=thisform.valorcadena
		on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		if localiz=1
		*!*		if elimi=0 and nitemapp>0
		*!*			thisform.grid1.toprow=nitemapp
		*!*		else
				elimi=0
		*!*		endif
		endif
	ENDPROC

	PROCEDURE grid1.MouseDown
		*** ActiveX Control Event ***
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		IF nButton = 2
		    thisform.gridart_menu()
		    RETURN
		ENDIF
		
		IF nButton = 1
		    IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		        =GridArt_RefrescarStockForm(thisform)
		    ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Optiongroup1.Option1.Click
		thisform.label25.caption="*"
		thisform.label25.top=540
		thisform.text24.setfocus
	ENDPROC

	PROCEDURE Optiongroup1.Option2.Click
		thisform.label25.caption=":"
		thisform.label25.top=531
		thisform.text24.setfocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		*!*	if localiz=1
		*!*		thisform.grid1.toprow=nitemapp
		*!*	endif
	ENDPROC

	PROCEDURE Text15.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text15.Valid
		if this.value>0
			IF USED("cur_vendedor")
				USE IN cur_vendedor
			ENDIF
			frmaltapxp= conectar_db(_screen.cn)
				SQLEXEC(frmaltapxp,"select * from vendedores where ven_codi=?this.value;","cur_vendedor")
			desconectar_db(frmaltapxp)
			IF RECCOUNT("cur_vendedor")>0
				thisform.text16.value=allt(cur_vendedor.ven_nomb)
			else
				=messagebox("Vendedor no está en archivo",0+48,"Advertencia!!!")
				this.value=0
				return 0
			endif
		else
			thisform.text16.value=""
		endif
	ENDPROC

	PROCEDURE Text19.GotFocus
		public valdto
		valdto=this.value
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			if this.value<>valdto
				do case
					case this.value=0
						.text17.value=""
						.text18.value=.text8.value
						thisform.impo1=thisform.impo1/((100-valdto)/100)
						thisform.impo2=thisform.impo2/((100-valdto)/100)
						thisform.acun1=thisform.acun1/((100-valdto)/100)
						thisform.acun2=thisform.acun2/((100-valdto)/100)
						thisform.acu1=thisform.acu1/((100-valdto)/100)
						thisform.acu2=thisform.acu2/((100-valdto)/100)
						if thisform.xcond=2
							.text9.value=.text9.value/((100-valdto)/100)
							.text11.value=.text11.value/((100-valdto)/100)
						endif
					otherwise
						.text17.value=.text8.value*this.value/100
						.text18.value=.text8.value-.text17.value
						if thisform.xcond=2
							if valdto>0
								.text9.value=.text9.value/((100-valdto)/100)
								.text11.value=.text11.value/((100-valdto)/100)
							endif
							.text9.value=.text9.value*((100-this.value)/100)
							.text11.value=.text11.value*((100-this.value)/100)
						endif
						if valdto>0
							thisform.impo1=thisform.impo1/((100-valdto)/100)
							thisform.impo2=thisform.impo2/((100-valdto)/100)
							thisform.acun1=thisform.acun1/((100-valdto)/100)
							thisform.acun2=thisform.acun2/((100-valdto)/100)
							thisform.acu1=thisform.acu1/((100-valdto)/100)
							thisform.acu2=thisform.acu2/((100-valdto)/100)
						endif
						thisform.impo1=thisform.impo1*((100-this.value)/100)
						thisform.impo2=thisform.impo2*((100-this.value)/100)
						thisform.acun1=thisform.acun1*((100-this.value)/100)
						thisform.acun2=thisform.acun2*((100-this.value)/100)
						thisform.acu1=thisform.acu1*((100-this.value)/100)
						thisform.acu2=thisform.acu2*((100-this.value)/100)
				endcase 
				.text10.value=.text18.value+.text9.value+.text11.value
			endif
		endwith
		
	ENDPROC

	PROCEDURE Text20.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text20.Valid
		if this.value<>""
			sele porcencomi
			set order to porc_desc
			seek allt(this.value)
			frmaltapxp= conectar_db(_screen.cn)
				SQLEXEC(frmaltapxp,"select * from porcencomi where porc_desc=?this.value;","cur_porc")
			desconectar_db(frmaltapxp)
			IF RECCOUNT("cur_porc")>0
				porcodi=cur_porc.porc_codi
				thisform.text21.value=cur_porc.porc_impo
			else
				=messagebox("Porcentaje de Comisión no está en archivo",0+48,"Advertencia!!!")
				this.value=""
				return 0
			endif
		else
			thisform.text21.value=0
			porodi=0
		endif
	ENDPROC

	PROCEDURE Text21.Click
		this.setfocus
	ENDPROC

	PROCEDURE txt_cotiz.Click
		this.SetFocus
		
	ENDPROC

ENDDEFINE

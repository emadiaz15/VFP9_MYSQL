	ADD OBJECT 'txt_cotiz' AS textbox WITH ;
		Format = "$RK", ;
		Height = 23, ;
		InputMask = "999,999.999", ;
		Left = 573, ;
		Name = "txt_cotiz", ;
		Top = 104, ;

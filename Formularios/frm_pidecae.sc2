	PROCEDURE Activate
		
		SELECT COUNT(*) FROM cur_facturas WHERE fac_fec < DATE() INTO ARRAY canvie
		
		IF TYPE("canvie") = "N"
			IF canvie[1]>0
				xcad1=ICASE(canvie[1]=0,"Se encontró 1 comprobante ",canvie[1]>0,"Se encontraron "+ALLTRIM(STR(canvie[1]))+" comprobantes ")
				xcad2=ICASE(canvie[1]=0,"del comprobante ",canvie[1]>0,"de todos los comprobantes ")
				xcaf=MESSAGEBOX(xcad1+"con fecha vencida. Deberá actualizar la fecha al día de hoy para solicitar el CAE."+CHR(13)+CHR(13)+ ;
					            "¿Actualiza la fecha "+xcad2+"ahora?",4+48+256,"Solicitud de CAE")
				IF xcaf = 6
					thisform.grd_facturas.RecordSource=''
					SELECT cur_facturas
					LOCATE
					SCAN FOR fac_fec < DATE()
						xfecact = DATE()
						frmpedcae = conectar_db(_screen.cn)
							SQLEXEC(frmpedcae,"update facturas set fac_fec = ?xfecact where fac_codi = ?cur_facturas.fac_codi;")
						desconectar_db(frmpedcae)
						SELECT cur_facturas
					ENDSCAN
					
					USE IN fac_cae
					
					frmpedcae = conectar_db(_screen.cn)
						SQLEXEC(frmpedcae,"call usp_pedcae();","cur_facturas")
					desconectar_db(frmpedcae)
					LOCATE
					
					SELECT fac_fec,tipo,cli_nomb fc_cliente,cli_cuit,cp_nro,loca_nomb fc_loca,provi_nomb,importe,.F. fc_pide,RECNO() fc_regis, ;
						   fac_codi fc_fcodi,cli_domi fc_domi,cond_codi fc_cond,.F. fc_esta,0 fc_err FROM cur_facturas INTO CURSOR fac_cae readwrite		
						   
					thisform.grd_facturas.RecordSource="fac_cae"
					thisform.grd_facturas.Refresh()
				ELSE
					MESSAGEBOX("Puede actualizar la fecha haciendo click derecho en cada ítem",0+64,"Solucitud de CAE")
				ENDIF
			ENDIF
		ENDIF
		
		SELECT cur_facturas
		LOCATE
	ENDPROC

	PROCEDURE actu_fech
		LPARAMETERS xfcodi
		
		LOCAL xhoy
		
		xhoy = DATE()
		
		frmpedcae = conectar_db(_screen.cn)
			SQLEXEC(frmpedcae,"update facturas set fac_fec = ?xhoy where fac_codi = ?xfcodi;")
		desconectar_db(frmpedcae)
		
		thisform.grd_facturas.RecordSource=''
		
		frmpedcae = conectar_db(_screen.cn)
			SQLEXEC(frmpedcae,"call usp_pedcae();","cur_facturas")
		desconectar_db(frmpedcae)
		
		LOCATE
		SELECT fac_fec,tipo,cli_nomb fc_cliente,cli_cuit,cp_nro,loca_nomb fc_loca,provi_nomb,importe,.F. fc_pide,RECNO() fc_regis, ;
			   fac_codi fc_fcodi,cli_domi fc_domi,cond_codi fc_cond,.F. fc_esta,0 fc_err FROM cur_facturas INTO CURSOR fac_cae readwrite
		
		thisform.grd_facturas.RecordSource="fac_cae"
		
		thisform.grd_facturas.Refresh()
		
		RETURN
		
	ENDPROC

	PROCEDURE colorfila
		LParameters tnsel, tnfec
		
		Local lnColor
		
		DO case
			CASE tnsel = .T.
				lnColor = RGB(0,120,215)
			CASE tnsel = .F.
				IF tnfec = DATE()
					lnColor = RGB(255,255,255)
				ELSE
					lnColor = RGB(255,230,153)
				ENDIF
		ENDCASE
			
		Return(lnColor)
		
		
	ENDPROC

	PROCEDURE colorletra
		LParameters tnsel, tnerr
		
		Local ltColor
		
		DO case
			CASE tnsel = .T.
				ltColor = RGB(255,255,255)
			CASE tnsel = .F.
				IF tnerr = 0	
					ltColor = RGB(0,0,0)
				ELSE
					ltColor = RGB(255,0,0)
				ENDIF
		ENDCASE
		
		Return(ltColor)
	ENDPROC

	PROCEDURE grid_rightclick
		IF USED("fac_cae")
			LOCAL lcShortcut, loRef
			m.loRef = this
			m.lcShortcut = SYS(2015)
		
			DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
			DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Actualizar Fecha del Comprobamte] PICTURE "C:\VFP9_MYSQL\imagen\VBE7_1251.ico"
			DEFINE BAR 2 OF (m.lcShortcut) PROMPT [\-]
			DEFINE BAR 3 OF (m.lcShortcut) PROMPT [Marcar como Comprobante sin CAE] PICTURE "C:\VFP9_MYSQL\imagen\CANCEL_ICON-ICONS.COM_73703.bmp"
		
			ON SELECTION BAR 1 OF (m.lcShortcut) m.loRef.Actu_Fech(fac_cae.fc_fcodi)
			ON SELECTION BAR 3 OF (m.lcShortcut) m.loRef.Sin_Cae(fac_cae.fc_fcodi)
		*!*		
		*!*		IF cur_planp.estado <> 4
		*!*			SET SKIP OF BAR 2 OF (m.lcShortcut) .T.
		*!*		ELSE
		*!*			SET SKIP OF BAR 2 OF (m.lcShortcut) .F.
		*!*		ENDIF
		*!*		IF cur_planp.estado = 5 OR cur_planp.estado = 3
		*!*			SET SKIP OF BAR 3 OF (m.lcShortcut) .T.
		*!*		ENDIF
		*!*		IF cur_planp.cumplido = 'S'
		*!*			SET SKIP OF BAR 1 OF (m.lcShortcut) .T.
		*!*		ENDIF
			ACTIVATE POPUP (m.lcShortcut)
			RELEASE POPUP (m.lcShortcut)
		ENDIF
	ENDPROC

	PROCEDURE Init
		SET DELETED ON
		
		LOCAL xfecact
		
		IF USED("fe_cabez")
			USE IN fe_cabez
		ENDIF
		IF USED("fe_detal")
			USE IN fe_detal
		ENDIF
		
		CREATE CURSOR fac_cae(fc_fec D,fc_tipo C(3), fc_cliente C(45),fc_cuit N(11),fc_cpnro N(4),fc_loca C(45),fc_provi C(20),fc_impo N(15,2),fc_pide L,fc_regis N(5),fc_fcodi N(8),fc_domi C(45),fc_cond N(8),fc_esta L,fc_err N(1))
		
		
		frmpedcae = conectar_db(_screen.cn)
			SQLEXEC(frmpedcae,"call usp_pedcae();","cur_facturas")
		desconectar_db(frmpedcae)
		
		IF RECCOUNT("cur_facturas")>0
			LOCATE
		
			SELECT fac_fec,tipo,cli_nomb fc_cliente,cli_cuit,cp_nro,loca_nomb fc_loca,provi_nomb,importe,.F. fc_pide,RECNO() fc_regis, ;
				   fac_codi fc_fcodi,cli_domi fc_domi,cond_codi fc_cond,.F. fc_esta,0 fc_err FROM cur_facturas INTO CURSOR fac_cae readwrite
		
			thisform.grd_facturas.RecordSource="fac_cae"
			Thisform.grd_facturas.column7.DynamicInputMask = [('$ 999,999,999.99')]
			thisform.grd_facturas.SetAll("DynamicBackColor","Thisform.Colorfila(fac_cae.fc_pide,fac_cae.fac_fec)","Column")
			thisform.grd_facturas.SetAll("DynamicForeColor","Thisform.Colorletra(fac_cae.fc_pide,fac_cae.fc_err)","Column")
			thisform.grd_facturas.column8.DynamicBackColor='RGB(144,238,144)'
			thisform.grd_facturas.Refresh()
		
			FOR ncol=1 TO 7
				xsource="Thisform.grd_facturas.column"+ALLTRIM(STR(ncol))+".text1"
				BINDEVENT(&xsource,"RightClick",Thisform,"Grid_RightClick")
			NEXT ncol
			BINDEVENT(Thisform.grd_facturas.column9.Text1,"RightClick",Thisform,"Grid_RightClick")
		ELSE
			MESSAGEBOX("NO EXISTEN COMPROBANTES DE VENTA SIN CAE ASIGNADO.",0+64,"Solicitud Manual de CAE")
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE negritaerror
		LParameters tnsel
		
		Local ltneg
		
		DO case
			CASE tnsel = 1
				ltneg = .T.
			CASE tnsel = 0
				ltneg = .F.
		ENDCASE
			
		Return(ltneg)
	ENDPROC

	PROCEDURE pedircae
		LPARAMETERS xcodifac,xnomb,xdomi,xloca,xcond,xregi
		
		LOCAL nfelec,pfelec,cfelec,ffelec,bfelec,xcadecom,xpto,xnro,xnomcli
		xnomcli=fac_cae.fc_cliente
		
		frmpedcae = conectar_db(_screen.cn)
			SQLEXEC(frmpedcae,"select a.*,b.iva_1,b.iva_2 from facturas a inner join iva b on a.iva_codi = b.iva_codi where a.fac_codi = ?xcodifac;","cur_facpcae")
		desconectar_db(frmpedcae)
		SELECT cur_facpcae
		
		************//////////// COMIENZA FACTURA ELECTRÓNICA \\\\\\\\\\\\\**********
		with thisform
			tipo = ICASE(cur_facpcae.fac_conc="F","FC",cur_facpcae.fac_conc="N","NC",cur_facpcae.fac_conc="D","ND")
		
			do case
				case fac_cae.fc_cond=1
					tsiva="F"
					letra_abc="B"
				case fac_cae.fc_cond=2
					tsiva="I"
					letra_abc="A"
				case fac_cae.fc_cond=4
					tsiva="M"
					letra_abc="B"
				case fac_cae.fc_cond=5
					tsiva="E"
					letra_abc="B"
			endcase
			dtipo=tipo
		
			sele 0
			use "c:\sistema srl\factelec\fe_cabez"
			set reprocess to automatic
			if flock()
				repla estado with "0"
				repla previa with "1"
				repla destino with "1"
				repla tipo with dtipo
				repla letra with letra_abc
				repla puesto with cur_facpcae.fac_pto&&0
				repla numero with cur_facpcae.fac_nro&&0
				repla fe_emi with cur_facpcae.fac_fec
				repla razon with fac_cae.fc_cliente
				repla domic with fac_cae.fc_domi
				repla local with fac_cae.fc_loca
				if tsiva="I" or tsiva="E" or tsiva="M"
					repla cuit with allt(fac_cae.cli_cuit)
				else
					repla cuit with subst(allt(fac_cae.cli_cuit),3,8)
				endif
				repla siva with tsiva
				repla ibru with space(15)
				repla condi with iif(tipo = "FC", "CTA. CTE. [VTO.:"+dtoc(cur_facpcae.fac_fec+30)+"]","CONTADO")+IIF(LEN(ALLTRIM(cur_facpcae.fac_pie))>0,"   - OBSER: "+ALLTRIM(cur_facpcae.fac_pie),"")
				repla otros with ""
				repla total with cur_facpcae.neto_1+cur_facpcae.neto_2+cur_facpcae.fac_ivari+cur_facpcae.fac_ivarni+cur_facpcae.fac_ng
				repla neto210 with cur_facpcae.neto_1
				repla neto105 with cur_facpcae.neto_2
				repla neto270 with 0
				repla iva_210 with cur_facpcae.fac_ivari
				repla iva_105 with cur_facpcae.fac_ivarni
				repla iva_270 with 0
				repla exento with cur_facpcae.fac_ng
				repla nograb with 0
				repla iminte with 0
				repla subtotal with cur_facpcae.neto_1+cur_facpcae.neto_2+cur_facpcae.fac_ng
				repla descuento with ((cur_facpcae.neto_1+cur_facpcae.neto_2+cur_facpcae.fac_ng)*cur_facpcae.fac_dto)/100
				repla porcentaje with cur_facpcae.fac_dto
				repla cae WITH cur_facpcae.cae &&space(30)
				repla fvtocae WITH cur_facpcae.fvtocae &&ctod("  /  /  ")
				repla observ with space(100)
				IF cur_facpcae.fac_conc="N" OR cur_facpcae.fac_conc="D"
					REPLACE barra WITH REPLICATE("0",8-LEN(ALLTRIM(STR(cur_facpcae.fac_compas))))+ALLTRIM(STR(cur_facpcae.fac_compas))
				ELSE
					repla barra WITH cur_facpcae.barra &&space(40)
				ENDIF
			ENDIF
		
			sele 0
			use "c:\sistema srl\factelec\fe_detal" exclusive
			set reprocess to automatic
			if flock()
				set safety off
				zap
				set safety on
				use in fe_detal
				sele 0
				use "c:\sistema srl\factelec\fe_detal"
				SET DECIMALS TO 3
				frmpedcae= conectar_db(_screen.cn)
					SQLEXEC(frmpedcae,"select a.*,b.art_desc,b.art_alicuota,c.dac_desc from facturas_articulos a inner join articulos b on a.art_codi=b.art_codi left outer join desc_articulos_clientes c on c.dac_codi=a.dac_codi where fac_codi=?xcodifac;","cur_facfel")
				desconectar_db(frmpedcae)
				SET DECIMALS TO
				GO top
				scan
					sele fe_detal
					appe blan
					repla codigo with allt(str(cur_facfel.art_codi,8))
					if cur_facfel.art_codi<=5
						if len(allt(cur_facfel.artfac_dasc))>44
							posin=1
							poscar=44
							contcar=44
							do while contcar<=len(allt(cur_facfel.artfac_dasc))
								if !inlist(subst(allt(cur_facfel.artfac_dasc),contcar,1)," ",".","-","_")
									do while !inlist(subst(allt(cur_facfel.artfac_dasc),contcar,1)," ",".","-","_")
										poscar=poscar-1
										contcar=contcar-1
									enddo
								endif
								if posin>1
									appe blank
								endif
								if posin=1
									repla codigo with allt(str(cur_facfel.art_codi,8))
									repla cantid with cur_facfel.artfac_cant
								endif
								repla descri with subst(allt(cur_facfel.artfac_dasc),posin,poscar)
		   						contcar=contcar+1
								posin=contcar
								restcar=len(allt(cur_facfel.artfac_dasc))-(contcar-1)
								if restcar<=44
									if posin>1
										appe blank
									endif
									if posin=1
										repla codigo with allt(str(cur_facfel.art_codi,8))
										repla cantid with cur_facfel.artfac_cant
									endif
									repla descri with subst(allt(cur_facfel.artfac_dasc),posin,poscar)
									exit
								else
									contcar=contcar+44
									poscar=44
								endif
							enddo
						else
							repla cantid with cur_facfel.artfac_cant
							repla descri with allt(cur_facfel.artfac_dasc)
						endif						
					else
						repla cantid with cur_facfel.artfac_cant
						repla descri with IIF(cur_facfel.dac_codi>0,ALLTRIM(cur_facfel.dac_desc),ALLTRIM(cur_facfel.art_desc))
					endif
					repla observ with space(49)
					repla prlist with cur_facfel.artfac_impo
					repla bonifi with 0
					repla prunit with cur_facfel.artfac_impo
					do case
						case cur_facfel.calciva="SI"
							repla iva with iif(cur_facfel.art_alicuota=1,cur_facpcae.iva_1,cur_facpcae.iva_2)
						case cur_facfel.calciva="NO"
							repla iva with 0
					endcase
					repla inter with 0
					repla total with cur_facfel.artfac_cant*cur_facfel.artfac_impo
					sele cur_facfel
				endscan
			ENDIF
		ENDWITH
		
		******************COMIENZA SOLICITUD DE CAE**************************************
		cdir=sys(5)+sys(2003)
		oWsh = CREATEOBJECT ("wscript.shell")
		set defa to "c:\sistema srl\factelec\"
		USE IN fe_cabez
		USE IN fe_detal
		oWsh.Run ("felec.exe", 3, .T.)
		set defa to (cdir)
		
		*******************FIN SOLICITUD CAE********************************************
		*!*	*******************VALIDA CAE***************************************************
		thisform.xfce = fac_cae.fc_fcodi
		sele 0
		use "c:\sistema srl\factelec\fe_cabez"
		go top
		nfelec=numero
		pfelec=puesto
		cfelec=cae
		ffelec=fvtocae
		bfelec=ALLTRIM(barra)
		xpto     =REPLICATE("0",4-LEN(ALLTRIM(STR(puesto))))+ALLTRIM(STR(puesto))
		xnro     =REPLICATE("0",8-LEN(ALLTRIM(STR(numero))))+ALLTRIM(STR(numero))
		xcadecom =ALLTRIM(cur_facpcae.fac_conc)+IIF(cur_facpcae.fac_conc="F","C","")+ALLTRIM(cur_facpcae.fac_tipo)+"_"+ALLTRIM(xpto)+"-"+ALLTRIM(xnro)+" -- "+ALLTRIM(xnomcli)
		if estado!="A"
			DO case
				CASE LEN(ALLTRIM(bfelec))>0
					thisform.error_ws = ALLTRIM(bfelec)
				CASE LEN(ALLTRIM(fe_cabez.observ))>0
					thisform.error_ws = ALLTRIM(fe_cabez.observ)
			ENDCASE
			thisform.estado_cae = 0
		ELSE
			frmpedcae= conectar_db(_screen.cn)
				SQLEXEC(frmpedcae,"update facturas set fac_nro=?nfelec,fac_pto=?pfelec,cae=?cfelec,fvtocae=?ffelec,barra=?bfelec where fac_codi=?thisform.xfce;")
				SQLEXEC(frmpedcae,"update histostock set hs_obser=?xcadecom where fac_codi = ?thisform.xfce;")
			desconectar_db(frmpedcae)
		endif
		use in fe_cabez
		
		***************************FIN VALIDACIÓN DE CAE*************************************
		************//////////// FIN FACTURA ELECTRÓNICA \\\\\\\\\\\\\***********************
		
		RETURN
	ENDPROC

	PROCEDURE registrahistostock
		LPARAMETERS xcodifac
		
		LOCAL xnomcli,xcodicli
		
		xnombcli=cur_facturas.fc_cliente
		
		frmaltafac= conectar_db(_screen.cn)
			SQLEXEC(frmaltafac,"select a.*,b.fac_conc,b.fac_tipo,b.fac_pto,b.fac_nro,b.fac_pie from facturas_articulos a inner join facturas b on a.fac_codi = b.fac_codi where a.fac_codi = ?xcodifac;","cur_farhis")
		desconectar_db(frmaltafac)
		
		IF RECCOUNT("cur_farhis")>0
			SELECT COUNT(*) css FROM cur_farhis WHERE ALLTRIM(artfac_sstock)="S" INTO ARRAY ar_ss
			IF TYPE("ar_ss")="N"
				IF ar_as[1,1]<RECCOUNT("cur_farhis")
					LOCAL xarti,xcantf,xsstock,xpie,xcadecom,xpto,xnro
					SELECT cur_farhis
					LOCATE
					SCAN
						xarti    =cur_farhis.art_codi
						xcantf   =cur_farhis.artfac_cant
						xsstock  =cur_farhis.artfac_sstock
						xpie     =ALLTRIM(cur_farhis.fac_pie)
						xpto     =REPLICATE("0",4-LEN(ALLTRIM(STR(cur_farhis.fac_pto))))+ALLTRIM(STR(cur_farhis.fac_pto))
						xnro     =REPLICATE("0",8-LEN(ALLTRIM(STR(cur_farhis.fac_nro))))+ALLTRIM(STR(cur_farhis.fac_nro))
						xcadecom =ALLTRIM(cur_farhis.fac_conc)+IIF(cur_farhis.fac_conc="F","C","")+ALLTRIM(cur_farhis.fac_tipo)+"_"+ALLTRIM(xpto)+"-"+ALLTRIM(xnro)+" -- "+ALLTRIM(xnombcli)
						if xarti>5 and ALLTRIM(xsstock)<>"S"
							LOCAL stact,saldst
							frmaltafac= conectar_db(_screen.cn)
								do case
									case ALLTRIM(cur_farhis.fac_conc)="F"
										SQLEXEC(frmaltafac,"select art_stock from articulos where art_codi=?xarti;","cur_stac")
										stact=cur_stac.art_stock
										saldst=stact-xcantf
										SQLEXEC(frmaltafac,"insert into histostock values(null,?xarti,current_date(),current_time(),'S',?stact,-?xcantf,?saldst,?xcadecom,?xpie,0,0,?xcodifac,0);")
									case ALLTRIM(cur_farhis.fac_conc)="N"
										SQLEXEC(frmaltafac,"select art_stock from articulos where art_codi=?xarti;","cur_stac")
										stact=cur_stac.art_stock
										saldst=stact+xcantf
										SQLEXEC(frmaltafac,"insert into histostock values(null,?xarti,?DATE(),?TTOC(DATETIME(),2),'S',?stact,?xcantf,?saldst,?xcadecom,?xpie,0,0,?xcodifac,0);")
								ENDCASE
								cerrar_cursor("cur_stac")
							desconectar_db(frmaltafac)
						ENDIF
						SELECT cur_farhis
					ENDSCAN
				ENDIF
			ENDIF
		ENDIF
		
		RETURN
		
		
	ENDPROC

	PROCEDURE sin_cae
		LPARAMETERS xfcodi
		
		frmpedcae = conectar_db(_screen.cn)
			SQLEXEC(frmpedcae,"update facturas set fac_pcae = 0 where fac_codi = ?xfcodi;")
		desconectar_db(frmpedcae)
		
		DELETE FROM fac_cae WHERE fc_fcodi = xfcodi
		
		GO TOP IN fac_cae
		
		thisform.grd_facturas.Refresh()
		
		RETURN
		
	ENDPROC

	PROCEDURE btn_salir.Click
		thisform.release
	ENDPROC

	PROCEDURE btn_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE btn_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL xcodsel, xreg, xsigue, xint
		STORE 0 TO xcodsel,xsigue,xint
		
		SELECT fac_cae
		GO top
		DO WHILE !EOF()
			IF fac_cae.fc_pide=.T.
				xreg = fc_regis
				thisform.pedircae(fac_cae.fc_fcodi,fac_cae.fc_cliente, ;
					     fac_cae.fc_domi,fac_cae.fc_loca,fac_cae.fc_cond,xreg)
				SELECT fac_cae
				IF thisform.estado_cae = 0
					IF xint<3
						xsigue = MESSAGEBOX(ALLTRIM(thisform.error_ws)+CHR(13)+CHR(13)+ ;
											"Se ha producido un error al solicitar el CAE para "+ALLTRIM(fac_cae.fc_cliente)+CHR(13)+ ;
							                "¿Intenta nuevamente?",3+48+256,"Solicitud de CAE")
						DO case
							CASE xsigue = 7
								EXIT
							CASE xsigue = 6
								thisform.estado_cae = 1
								xint = xint + 1
								LOOP
							CASE xsigue = 2
								UPDATE fac_cae SET fc_pide = .F.
								EXIT
						ENDCASE
					ELSE
						xsigue = MESSAGEBOX("Ha intentado demasiadas veces la solicitud de CAE para este comprobante"+CHR(13)+ ;
				                            "¿Desea saltear este comprobante?",3+48+256,"Solicitud de CAE")
				        DO case
				        	CASE xsigue = 6
								thisform.grd_facturas.SetAll("DynamicFontBold","Thisform.Negritaerror(fac_cae.fc_err)","Column")	        	
				        		thisform.estado_cae = 1
				        		REPLACE fc_pide WITH .F.
				        		REPLACE fc_err  WITH 1
					        	xint = 0
				        	CASE xsigue = 7
				        		EXIT
				        	CASE xsigue = 2
					        	UPDATE fac_cae SET fc_pide = .F.
					        	EXIT
						ENDCASE
					ENDIF
				ELSE
					REPLACE fc_esta WITH .T. IN fac_cae
				ENDIF
				SKIP
			ELSE
				SKIP
			ENDIF
		ENDDO
		
		DELETE FROM fac_cae WHERE fc_esta = .T.
		
		GO TOP IN fac_cae
		
		thisform.grd_facturas.SetFocus
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command1.OLEDrag
		LPARAMETERS lDetectDrag
		this.command1.enabled=.T.
	ENDPROC

	PROCEDURE Command2.Click
		DO case
			CASE thisform.estadosel=0
				UPDATE fac_cae SET fc_pide=.T.
				this.Caption="\<Deseleccionar Todos"
				thisform.command1.enabled=.T.
				thisform.estadosel=1
			CASE thisform.estadosel=1
				UPDATE fac_cae SET fc_pide=.F.
				this.Caption="\<Seleccionar Todos"
				thisform.command1.enabled=.F.
				thisform.estadosel=0
		ENDCASE
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE grd_facturas.Column8.Check1.Click
		LOCAL cantsel,ubireg
		cantsel=0
		ubireg=0
		
		SELECT fac_cae
		ubireg=RECNO()
		LOCATE
		COUNT ALL FOR fc_pide=.T. TO cantsel
		GO ubireg
		
		IF cantsel>0
			thisform.command2.Caption="\<Deseleccionar Todos"
			thisform.command1.enabled=.T.
			thisform.estadosel=1
		ELSE
			thisform.command2.Caption="\<Seleccionar Todos"
			thisform.command1.enabled=.F.
			thisform.estadosel=0
		ENDIF
	ENDPROC

ENDDEFINE

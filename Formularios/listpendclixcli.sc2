DEFINE CLASS listpendclixcli AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Command3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="List2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command2" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 158,207,207
		BorderStyle = 0
		Caption = "Listado de Pedidos Pendientes de Clientes"
		DataSession = 2
		DoCreate = .T.
		Height = 263
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "listpendclixcli"
		Width = 545
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Previsualizar", ;
		DisabledBackColor = 33,146,214, ;
		Enabled = .F., ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 232, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 223, ;
		Width = 110
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command2' AS commandbutton WITH ;
		BackColor = 87,87,87, ;
		Caption = "\<Imprimir Pendientes", ;
		DisabledBackColor = 87,87,87, ;
		Enabled = .F., ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 61, ;
		Name = "Command2", ;
		Themes = .F., ;
		Top = 223, ;
		Width = 143
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command3' AS commandbutton WITH ;
		BackColor = 227,68,34, ;
		Cancel = .T., ;
		Caption = "\<Salir", ;
		DisabledBackColor = 227,68,34, ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 366, ;
		Name = "Command3", ;
		TabIndex = 4, ;
		Themes = .F., ;
		Top = 223, ;
		Width = 108
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackColor = 158,207,207, ;
		Caption = "    Clientes con Pedidos Pendientes    ", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 48, ;
		Name = "Label1", ;
		TabIndex = 5, ;
		Top = 9, ;
		Width = 212
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'List2' AS listbox WITH ;
		BoundColumn = 2, ;
		ColumnCount = 2, ;
		ColumnWidths = "450,50", ;
		FontBold = .T., ;
		Height = 163, ;
		Left = 36, ;
		Name = "List2", ;
		TabIndex = 1, ;
		Top = 33, ;
		Width = 468
		*< END OBJECT: BaseClass="listbox" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackColor = 167,177,150, ;
		BackStyle = 0, ;
		BorderStyle = 1, ;
		Height = 196, ;
		Left = 18, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;
		Top = 15, ;
		Width = 507
		*< END OBJECT: BaseClass="shape" />
	
	PROCEDURE Init
		public codicli
		local ven,vendn
		codicli=0
		ven=0
		vendn=''
		set date british
		set cent on
		set deleted on
		with thisform
			.list2.rowsourcetype=3
			vendn=UPPER(substr(sys(0),ATC("#",sys(0))+2))
			frmlstpend= conectar_db(_screen.cn)
				SQLEXEC(frmlstpend,"select * from vendedores where TRIM(ven_nomb)=?vendn;","cur_vendp")
			desconectar_db(frmlstpend)
			if RECCOUNT("cur_vendp")>0
				ven=cur_vendp.ven_codi
			else
				ven=0
			endif
			if ven>0
				frmlstpend= conectar_db(_screen.cn)
					SQLEXEC(frmlstpend,"select distinct b.cli_nomb,b.cli_codi from pedidos a inner join clientes b on a.cli_codi=b.cli_codi where a.cumplido<>'S' and b.zona_codi = ANY (select zona_codi from zonas where ven_codi=?ven) order by b.cli_nomb;","clipen")
				desconectar_db(frmlstpend)
				IF RECCOUNT("clipen")>0
					GO top
					.list2.rowsource="select * from clipen INTO CURSOR list2"
				ENDIF
			ELSE
				frmlstpend= conectar_db(_screen.cn)
					SQLEXEC(frmlstpend,"select distinct b.cli_nomb,b.cli_codi from pedidos a inner join clientes as b on a.cli_codi=b.cli_codi where a.cumplido<>'S' order by b.cli_nomb;","clipen")
				desconectar_db(frmlstpend)
				.list2.rowsource="select * from clipen INTO CURSOR list2"
			endif
		endwith
	ENDPROC

	PROCEDURE Command1.Click
		frmlstpend= conectar_db(_screen.cn)
			SQLEXEC(frmlstpend,"call usp_pendxcli(?codicli);","curpendcli")
		desconectar_db(frmlstpend)
		go top
		report form pendxcli preview noconsole
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		frmlstpend= conectar_db(_screen.cn)
			SQLEXEC(frmlstpend,"call usp_pendxcli(?codicli);","curpendcli")
		desconectar_db(frmlstpend)
		go top
		report form pendxcli to printer prompt noconsole
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE List2.Click
		for i=1 to this.listcount
			if this.selected(i)
				codicli=val(this.value)
				thisform.command1.enabled=.T.
				thisform.command2.enabled=.T.
			endif
		next
		
		
	ENDPROC

	PROCEDURE List2.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			codicli=val(this.value)
			thisform.command1.enabled=.T.
			thisform.command2.enabled=.T.
		endif
	ENDPROC

ENDDEFINE

	PROCEDURE Activate
		set exact on
		
		IF estadoasoc=.F.
			nroasoc=0
			thisform.Release
		ENDIF
	ENDPROC

	PROCEDURE Init
		public impiva1,impiva2,codicli,nrofac,acu,cond,codifac,codiva,nrorem,valor,preg,acuiri,acuirni,acun1,acun2,acung
		set dele on
		create cursor detalles(art N(8),deta M,importe N(11,3),civa L)
		create cursor factu(cod N(8),nro N(8),pto N(4))
		acu=0
		codicli=0
		nrofac=0
		codifac=0
		nrorem=0
		valor=0
		preg=0
		store 0 to acuiri,acuirni,acun1,acun2,acung
		thisform.text14.value=acu
		do form cliload with codicli
		this.text13.value=date()
		this.text19.value=0
		frmaltand= conectar_db(_screen.cn)
			SQLEXEC(frmaltand,"select * from iva order by iva_codi desc limit 1;","cur_iva")
		desconectar_db(frmaltand)
		codiva=cur_iva.iva_codi
		impiva1=cur_iva.iva_1
		impiva2=cur_iva.iva_2
		thisform.label12.caption=allt(str(impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(impiva2,10,2))+"%"
		with thisform
			frmaltand= conectar_db(_screen.cn)
				SQLEXEC(frmaltand,"call usp_buscarcli(?codicli);","cur_clie")
			desconectar_db(frmaltand)
			.text1.value=cur_clie.cli_nomb
			.text2.value=cur_clie.cli_domi
			.text3.value=cur_clie.cp_nro
			.text4.value=cur_clie.loca_nomb
			.text5.value=cur_clie.provi_nomb
			.text6.value=cur_clie.cond_desc
			.text12.value=VAL(cur_clie.cli_cuit)
		endwith				
		cond=cur_clie.cond_codi
		do case
			case cond=2
				this.optiongroup1.value=1
				this.optiongroup1.option1.enabled=.T.
				this.optiongroup1.option2.enabled=.F.
		otherwise
			this.optiongroup1.value=2
			this.optiongroup1.option1.enabled=.F.
			this.optiongroup1.option2.enabled=.T.
		ENDCASE
		DO FORM numfacasoc WITH codicli
		thisform.lbl_asoc.Caption=thisform.lbl_asoc.Caption+" "+REPLICATE("0",8-LEN(ALLTRIM(STR(nroasoc))))+ALLTRIM(STR(nroasoc))
		thisform.lbl_asoc.Visible=.T.
		*if last()<>27
		*	if cond=2
		*		select max(fac_codi) as "cod",fac_nro as "nro",fac_pto as "pto" from facturas where fac_tipo="A" into cursor factu
		*		if factu.nro=0
		*			do form inifac with cond,nrofac
		*		else
		*			nrofac=factu.nro+1
		*		endif
		*	else
		*		thisform.optiongroup1.value=2
		*		select max(fac_codi) as "cod",fac_nro as "nro",fac_pto as "pto" from facturas where fac_tipo="B" into cursor factu
		*		if factu.nro=0
		*			do form inifac with cond,nrofac
		*		else
		*			nrofac=factu.nro+1
		*		endif
		*	endif
		*	this.text16.value=factu.pto
		*endif
		auxcond=cond
		*this.text15.value=nrofac
		
	ENDPROC

	PROCEDURE btn_deta.Click
		IF LEN(ALLTRIM(cur_clie.cli_deta)) > 0
			MESSAGEBOX(ALLTRIM(cur_clie.cli_deta),64,"Detalles Adicionales del Cliente")
		ELSE
			MESSAGEBOX("No hay detalles ingresados para este cliente",48,"Detalles Adicionales del Cliente")
		ENDIF
		
	ENDPROC

	PROCEDURE chk_pcae.Click
		IF this.Value = 0
			MESSAGEBOX("SI ELIGE NO SOLICITAR CAE PARA ESTA NOTA DE DÉBITO, EL COMPROBANTE QUEDARÁ GRABADO EN LA BASE DE DATOS SIN NÚMERO. DEBERÁ MODIFICARLO EN EL MENÚ MANTENIMIENTO DE COMPROBANTES.",0+48,"Alta Nota de Débito")
		ENDIF
		
	ENDPROC

	PROCEDURE Command1.Click
		local tsiva,letra_abc,dtipo,tipo
		
		local nfelec,pfelec,cfelec,ffelec,bfelec,xcompas,xfar
		tsiva=""
		letra_abc=""
		dtipo=""
		tipo=""
		xfar = 0
		preg=messagebox("¿Confirma los datos de la Nota de Débito?",4+32+256,"Notas de Débito")
		if preg=6
			LOCAL xtipo,xfecha,xcodicli,xcodiva,xdto,xcodp,xconc,xng,xnet1,xnet2,xivari,xivarni,xftot,xpie,xvend,xporc,xotcom, ;
				  xart,xcant,ximpo,xdasc,xdc,xddesc,xnd,xciva
			STORE '' TO xtipo,xconc,xpie,xdasc,xddesc,xnd,xciva
			STORE 0  TO xcodicli,xcodiva,xdto,xcodp,xng,xnet1,xnet2,xivari,xivarni,xftot,xvend,xporc,xotcom, ;
						xart,xcant,ximpo,xdc
			sele detalles
			go bott
			with thisform
				do case
					case .optiongroup1.value=1
						xtipo="A"
					case .optiongroup1.value=2
						xtipo="B"
				endcase
				xfecha=.text13.value
				xcodicli=codicli
				xcodiva=codiva
				xdto=.text19.value
				xftot=acung+acun1+acun2
				xivari=acuiri
				xivarni=acuirni
				xnet1=acun1
				xnet2=acun2
				xng=acung
				xconc="D"
				xcompas=nroasoc
				frmaltand= conectar_db(_screen.cn)
					SQLEXEC(frmaltand,"call usp_guardarfac(?xtipo,?xfecha,?xcompas,?xcodicli,?xcodiva,?xdto,?xcodp,?xconc,?xng,?xnet1,?xnet2,?xivari,?xivarni,?xftot,?xpie,?xvend,?xporc,?xotcom,0);","cur_codind")
					SQLEXEC(frmaltand,"update clientes set cli_saldo=cli_saldo+(?acung+?acun1+?acun2+?acuiri+?acuirni) where cli_codi=?xcodicli;")
				desconectar_db(frmaltand)
				codifac=cur_codind.ncodi
				sele detalles
				go top
				SCAN
					STORE 0 TO xart,xcant,ximpo,xdc,xfar
					STORE '' TO xdasc,xddesc,xnd,xciva
					xart=detalles.art
					xcant=1
					ximpo=detalles.importe
					xnd=detalles.deta
					if detalles.civa=.T.
						xciva="SI"
					else
						xciva="NO"
					ENDIF
					frmaltand= conectar_db(_screen.cn)
						SQLEXEC(frmaltand,"select cast(far_codi+1 as DECIMAL(8,0)) as far_codi from facturas_articulos order by far_codi desc limit 1;","cur_farnvo")
					desconectar_db(frmaltand)
					IF RECCOUNT("cur_farnvo")>0
						xfar=cur_farnvo.far_codi
					ENDIF
					
					frmaltand= conectar_db(_screen.cn)
						SQLEXEC(frmaltand,"insert into facturas_articulos values(?xfar,?codifac,?xart,?xcant,?ximpo,?xdasc,?xdc,?xddesc,?xnd,'',?xciva,0,0);")
					desconectar_db(frmaltand)
					sele detalles
				endscan
		
				
				IF thisform.chk_pcae.Value = 1
					************//////////// COMIENZA FACTURA ELECTRÓNICA \\\\\\\\\\\\\**********
					with thisform
						tipo="ND"
						do case
							case cond=1
								tsiva="F"
								letra_abc="B"
							case cond=2
								tsiva="I"
								letra_abc="A"
							case cond=4
								tsiva="M"
								letra_abc="B"
							case cond=5
								tsiva="E"
								letra_abc="B"
						endcase
						dtipo=tipo
						sele 0
						use "c:\sistema srl\factelec\fe_cabez"
						set reprocess to automatic
						if flock()
							repla estado with "0"
							repla previa with "1"
							repla destino with "1"
							repla tipo with dtipo
							repla letra with letra_abc
							repla puesto with 0
							repla numero with 0
							repla fe_emi with .text13.value
							repla razon with cur_clie.cli_nomb
							repla domic with cur_clie.cli_domi
							repla local with cur_clie.loca_nomb
							if tsiva="I" or tsiva="E"
								repla cuit with allt(cur_clie.cli_cuit)
							else
								repla cuit with subst(allt(cur_clie.cli_cuit),3,8)
							endif
							repla siva with tsiva
							repla ibru with space(15)
							repla condi with iif(tipo = "FC", "CTA. CTE. [VTO.:"+dtoc(.text13.value+30)+"]","CONTADO")
							repla otros with space(50)
							repla total with ConverNro(.text10.value)
							repla neto210 with xnet1
							repla neto105 with xnet2
							repla neto270 with 0
							repla iva_210 with xivari
							repla iva_105 with xivarni
							repla iva_270 with 0
							repla exento with xng
							repla nograb with 0
							repla iminte with 0
							repla subtotal with xnet1+xnet2+xng
							repla descuento with ((xnet1+xnet2+xng)*xdto)/100
							repla porcentaje with xdto
							repla cae with space(30)
							repla fvtocae with ctod("  /  /  ")
							repla observ with space(100)
							repla barra with REPLICATE("0",8-LEN(ALLTRIM(STR(nroasoc))))+ALLTRIM(STR(nroasoc))
			*!*					repla cartel1 with space(40)
			*!*					repla cartel2 with space(40)
			*!*					repla cartel3 with space(40)
						endif
						sele 0
						use "c:\sistema srl\factelec\fe_detal" exclusive
						set reprocess to automatic
						if flock()
							set safety off
							zap
							set safety on
							use in fe_detal
							sele 0
							use "c:\sistema srl\factelec\fe_detal"
							SET DECIMALS TO 3
							frmaltand= conectar_db(_screen.cn)
								SQLEXEC(frmaltand,"select a.*,b.art_desc,b.art_alicuota,c.dac_desc from facturas_articulos a inner join articulos b on a.art_codi=b.art_codi left outer join desc_articulos_clientes c on c.dac_codi=a.dac_codi where fac_codi=?codifac;","cur_facfel")
							desconectar_db(frmaltand)
							SET DECIMALS TO
							GO top
							scan
								sele fe_detal
								appe blan
								repla codigo with allt(str(cur_facfel.art_codi,8))
								if len(allt(cur_facfel.artfac_nd))>44
									posin=1
									poscar=44
									contcar=44
									do while contcar<=len(allt(cur_facfel.artfac_nd))
										if !inlist(subst(allt(cur_facfel.artfac_nd),contcar,1)," ",".","-","_")
											do while !inlist(subst(allt(cur_facfel.artfac_nd),contcar,1)," ",".","-","_")
												poscar=poscar-1
												contcar=contcar-1
											enddo
										endif
										if posin>1
											appe blank
										endif
										repla descri with subst(allt(cur_facfel.artfac_nd),posin,poscar)
										if posin=1
											repla codigo with allt(str(cur_facfel.art_codi,8))
											repla cantid with cur_facfel.artfac_cant
										endif
										contcar=contcar+1
										posin=contcar
										restcar=len(allt(cur_facfel.artfac_nd))-(contcar-1)
										if restcar<=44
											if posin>1
												appe blank
											endif
											repla descri with subst(allt(cur_facfel.artfac_nd),posin,poscar)
											if posin=1
												repla codigo with allt(str(cur_facfel.art_codi,8))
												repla cantid with cur_facfel.artfac_cant
											endif
											exit
										else
											contcar=contcar+44
											poscar=44
										endif
									enddo
								else
									repla cantid with cur_facfel.artfac_cant
									repla descri with cur_facfel.artfac_nd
								endif
								repla observ with space(49)
								repla prlist with cur_facfel.artfac_impo
								repla bonifi with 0
								repla prunit with cur_facfel.artfac_impo
								do case
									case cur_facfel.calciva="SI"
										repla iva with iif(cur_facfel.art_codi=4,impiva1,impiva2)
									case cur_facfel.calciva="NO"
										repla iva with 0
								endcase
								repla inter with 0
								repla total with cur_facfel.artfac_cant*cur_facfel.artfac_impo
								sele cur_facfel
							endscan
						endif
					endwith
					******************COMIENZA SOLICITUD DE CAE**************************************
					cdir=sys(5)+sys(2003)
					oWsh = CREATEOBJECT ("wscript.shell")
					set defa to "c:\sistema srl\factelec\"
					oWsh.Run ("felec.exe", 3, .T.)
					set defa to (cdir)
					*******************FIN SOLICITUD CAE********************************************
					*******************VALIDA CAE***************************************************
					sele fe_cabez
					go top
					nfelec=numero
					pfelec=puesto
					cfelec=cae
					ffelec=fvtocae
					bfelec=barra
					if estado!="A"
						DO case
							CASE LEN(ALLTRIM(bfelec))>0
								messagebox(ALLTRIM(bfelec),0+48,"Mensaje de Webservice AFIP")
							CASE LEN(ALLTRIM(fe_cabez.observ))>0
								messagebox(ALLTRIM(fe_cabez.observ),0+48,"Mensaje de Webservice AFIP")
						ENDCASE
					else
						frmaltand= conectar_db(_screen.cn)
							SQLEXEC(frmaltand,"update facturas set fac_nro=?nfelec,fac_pto=?pfelec,cae=?cfelec,fvtocae=?ffelec,barra=?bfelec where fac_codi=?codifac;")
						desconectar_db(frmaltand)
					endif
					use in fe_cabez
					use in fe_detal
					*******************FIN VALIDACIÓN DE CAE*************************************
				ELSE
					frmaltand= conectar_db(_screen.cn)
						SQLEXEC(frmaltand,"update facturas set fac_pcae=0 where fac_codi=?codifac;")
					desconectar_db(frmaltand)		
				ENDIF
				estadoasoc=.F.
				nroasoc=0
				.release
			endwith
		endif
		
	ENDPROC


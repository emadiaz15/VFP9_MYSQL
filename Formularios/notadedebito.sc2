	PROCEDURE Command3.Click
		=messagebox("No Gravado: "+allt(str(acung,10,2))+chr(13)+ ;
					"Neto 1: "+allt(str(acun1,10,2))+chr(13)+ ;
					"Neto 2: "+allt(str(acun2,10,2))+chr(13)+ ;
					"ivari: "+allt(str(acuiri,10,2))+chr(13)+ ;
					"ivarni: "+allt(str(acuirni,10,2)))
		
		sele detalles
		go top
		brow			
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Text13.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text14.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text14.LostFocus
		*if this.value=0
		*	valor=this.value
		*	acu=acu+valor
		*else
		*	do case
		*		case this.value<valor
		*			d=valor-this.value
		*			acu=acu-d
		*		case this.value>valor
		*			d=this.value-valor
		*			acu=acu+d
		*		case this.value=valor
		*			acu=this.value
		*	endcase
		*	valor=this.value
		*endif
		preg=0
		acu=acu+this.value
		if acu>0
			do case
				case cond=2
					with thisform
						.text8.value=str(acu,10,2)
						dto=0
						if .text19.value>0
							dto=acu*.text19.value/100
						endif
						dife=this.value-dto
						preg=messagebox("¿Calcula IVA para este Item?",4+48+256,"Advertencia!!!")
						if preg=6
							do form alicuo with aliiva
							auxiva=dife*aliiva/100
							do case
								case aliiva=impiva1
									acuiri=acuiri+auxiva
									acun1=acun1+dife
									.text9.value=str(CAST(STRTRAN(.text9.value,",",".") as N(15,2))+auxiva,10,2)
								case aliiva=impiva2
									acuirni=acuirni+auxiva
									acun2=acun2+dife
									.text11.value=str(CAST(STRTRAN(.text11.value,",",".") as N(15,2))+auxiva,10,2)
							endcase
						else
							acung=acung+dife
						endif
						.text17.value=str(acu*.text19.value/100,10,2)
						.text18.value=str(acu-CAST(STRTRAN(.text17.value,",",".") as N(15,2)),10,2)
						.text10.value=str(CAST(STRTRAN(.text18.value,",",".") as N(15,2))+ ;
									      CAST(STRTRAN(.text9.value,",",".") as N(15,2))+ ;
									      CAST(STRTRAN(.text11.value,",",".") as N(15,2)),10,2)
					endwith
			otherwise
				with thisform
					.text8.value=str(acu,10,2)
					dto=0
					if .text19.value>0
						dto=acu*.text19.value/100
					endif
					dife=this.value-dto
					preg=messagebox("¿Calcula IVA para este Item?",4+48+256,"Advertencia!!!")
					if preg=6
						do form alicuo with aliiva
						auxiva=round((round(dife/(1+(aliiva/100)),2))*aliiva/100,2)
						do case
							case aliiva=impiva1
								acuiri=acuiri+auxiva
								acun1=acun1+round(dife/(1+(aliiva/100)),2)
								.text9.value=str(CAST(STRTRAN(.text9.value,",",".") as N(15,2))+auxiva,10,2)
							case aliiva=impiva2
								acuirni=acuirni+auxiva
								acun2=acun2+round(dife/(1+(aliiva/100)),2)
								.text11.value=str(CAST(STRTRAN(.text11.value,",",".") as N(15,2))+auxiva,10,2)
						endcase
					else
						acung=acung+dife
					endif
					.text9.value=""
					.text11.value=""
					.text17.value=str(acu*.text19.value/100,10,2)
					.text18.value=str(acu-CAST(STRTRAN(.text17.value,",",".") as N(15,2)),10,2)
					.text10.value=.text18.value
				endwith
			endcase
			sele detalles
			appe blank
			if preg=6
				do case
					case aliiva=impiva1
						repla art with 4
					case aliiva=impiva2
						repla art with 5
				endcase
			else
				repla art with 4
			endif
			repla deta with thisform.edit1.value
			repla importe with thisform.text14.value
			if preg=6
				repla civa with .T.
			else
				repla civa with .F.
			endif
			preg=messagebox("¿Ingresa nuevo detalle?",4+48+256,"Advertencia")
			if preg=6
				thisform.edit1.value=""
				thisform.text14.value=0
				thisform.edit1.setfocus	
			else
				thisform.command1.enabled=.T.
				thisform.command1.setfocus
			endif
		endif
		
	ENDPROC

	PROCEDURE Text15.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text16.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text16.LostFocus
		if this.value<>factu.pto
			preg=messagebox("Se ha ingresado un punto de venta diferente"+chr(13)+ ;
							"todos los formularios de este tipo van a "+chr(13)+ ;
							"pasar a ser punto de venta "+allt(str(this.value))+"."+chr(13)+chr(13)+ ;
							"¿Confirma el cambio de punto de venta?",4+32+256,"Puntos de Venta")
			if preg=6
				nrofac=1
				thisform.text15.value=nrofac
			else
				this.value=factu.pto
			endif
		else
			nrofac=factu.nro+1
		endif
	ENDPROC

	PROCEDURE Text19.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text19.GotFocus
		public valdto
		valdto=this.value
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			if this.value<>valdto
				do case
					case this.value=0
						.text17.value=""
						.text18.value=.text8.value
						acung=acung/((100-valdto)/100)
						acun1=acun1/((100-valdto)/100)
						acun2=acun2/((100-valdto)/100)
						acuiri=acuiri/((100-valdto)/100)
						acuirni=acuirni/((100-valdto)/100)
						if cond=2
							.text9.value=str(CAST(STRTRAN(.text9.value,",",".") as N(15,2))/((100-valdto)/100),10,2)
							.text11.value=str(CAST(STRTRAN(.text11.value,",",".") as N(15,2))/((100-valdto)/100),10,2)
						endif
					otherwise
						.text17.value=str((CAST(STRTRAN(.text8.value,",",".") as N(15,2)))*this.value/100,10,2)
						.text18.value=str((CAST(STRTRAN(.text8.value,",",".") as N(15,2)))- ;
							               CAST(STRTRAN(.text17.value,",",".") as N(15,2)),10,2)
						if cond=2
							if valdto>0
								acung=acung/((100-valdto)/100)
								acun1=acun1/((100-valdto)/100)
								acun2=acun2/((100-valdto)/100)
								acuiri=acuiri/((100-valdto)/100)
								acuirni=acuirni/((100-valdto)/100)
								.text9.value=str(CAST(STRTRAN(.text9.value,",",".") as N(15,2))/((100-valdto)/100),10,2)
								.text11.value=str(CAST(STRTRAN(.text11.value,",",".") as N(15,2))/((100-valdto)/100),10,2)
							endif
							acung=acung*((100-this.value)/100)
							acun1=acun1*((100-this.value)/100)
							acun2=acun2*((100-this.value)/100)
							acuiri=acuiri*((100-this.value)/100)
							acuirni=acuirni*((100-this.value)/100)
							.text9.value=str(CAST(STRTRAN(.text9.value,",",".") as N(15,2))*((100-this.value)/100),10,2)
							.text11.value=str(CAST(STRTRAN(.text11.value,",",".") as N(15,2))*((100-this.value)/100),10,2)
						endif
				endcase 
				.text10.value=str(CAST(STRTRAN(.text18.value,",",".") as N(15,2))+ ;
				                  CAST(STRTRAN(.text9.value,",",".") as N(15,2))+ ;
				                  CAST(STRTRAN(.text11.value,",",".") as N(15,2)),10,2)
			endif
		endwith
		
		
	ENDPROC

ENDDEFINE

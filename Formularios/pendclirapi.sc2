		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		parameter codigo,descri
		set dele on
		dimension tot[1,1]
		this.caption="Pedidos Pendientes de "+descri
		xcodigo=codigo
		xvend=0
		valorcadena=PROMPT()
		frmpendc= conectar_db(_screen.cn)
			SQLEXEC(frmpendc,"call usp_penclirap(?xcodigo,?xvend);","cur_pendc")
		desconectar_db(frmpendc)
		IF RECCOUNT("cur_pendc")>0
			this.lstpendc.rowsourcetype=3
			this.lstpendc.rowsource="select distinct nombre from cur_pendc into cursor lstpendc"
		ELSE
			MESSAGEBOX("Artículo no tiene pendientes de entrega a Clientes",48,"Aviso del sistema")
			KEYBOARD '{ESC}'
		endif
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if last()=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		
	ENDPROC

	PROCEDURE Grid1.DblClick
		LOCAL xcodp,xcond
		xcodp=pedipend.ped_codi
		xcond=pedipend.cond_codi
		DO FORM conspedicli WITH xcodp,xcond
	ENDPROC

	PROCEDURE lstpendc.Click
		with thisform
			for x=1 to this.listcount
				if this.selected(x)
					thisform.grid1.RecordSource=''
					thisform.grid1.Refresh()
					.grid1.SetAll("DynamicForeColor", "IIF(notaped_nro>0, RGB(225,0,113), RGB(0,0,0))", "Column")
					select IIF(notaped_nro>0,notaped_nro,ped_codi) as pedido,fecha,ent,pend,notaped_nro,ped_codi,cond_codi;
					   from cur_pendc where nombre=allt(this.list(x,1)) into CURSOR pedipend
					.grid1.recordsource="pedipend"
					.grid1.forecolor=0
					select sum(pend) from cur_pendc where nombre=allt(this.list(x,1)) into array tot
					.text3.value=tot[1,1]
					.label4.caption=allt(cur_pendc.art_med)
				endif
			next x
		endwith
	ENDPROC

ENDDEFINE

	PROCEDURE Init
		parameter codirem,nrorem,nrofac,lugent1,lugent2,observ,flete1,flete2,coditran1,coditran2
		this.caption="Datos importantes para el remito Nº "+allt(str(nrorem))
		this.text1.value=0
		this.text2.value=0
		sele transportes
		set order to tran_codi
		seek coditran1
		if found()
			this.text4.value=allt(tran_nomb)
		endif
		seek coditran2
		if found()
			this.text5.value=allt(tran_nomb)
		endif
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			sele remitos
			seek codirem
			repla rem_observ with allt(.edit2.value)
			repla flete_peso with .text1.value
			repla flete_valor with .text2.value
			sele remitos_transportes
			if coditran1>0
				appe blank
				repla rem_codi with codirem
				repla tran_codi with coditran1
				do case
					case .optiongroup1.value=1
						repla flete_cargo with "P"
					case .optiongroup1.value=2
						repla flete_cargo with "C"
				endcase
				repla flete_lugent with allt(.edit1.value)
			endif
			if coditran2>0
				appe blank
				repla rem_codi with codirem
				repla tran_codi with coditran2
				do case
					case .optiongroup2.value=1
						repla flete_cargo with "P"
					case .optiongroup2.value=2
						repla flete_cargo with "C"
				endcase
				repla flete_lugent with allt(.edit3.value)
			endif
			.release
		endwith
	ENDPROC

	PROCEDURE Command2.Click
		transporte=""
		coditran=0
		do form tranload with transporte,coditran
		if transporte<>" "
			coditran1=coditran
			thisform.text4.value=transporte
			thisform.edit1.setfocus
		endif
	ENDPROC

	PROCEDURE Command3.Click
		transporte=""
		coditran=0
		do form tranload with transporte,coditran
		if transporte<>" "
			coditran2=coditran
			thisform.text5.value=transporte
			thisform.edit3.setfocus
		endif
	ENDPROC

	PROCEDURE Command4.Click
		thisform.release
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Edit2.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit2.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Edit3.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit3.LostFocus
		capslock(.F.)
	ENDPROC

ENDDEFINE

	PROCEDURE Init
		public acu
		acu=0
		this.text2.value=0
		this.text4.value="A"
		this.text19.value=0
		sele facturas
		set order to fac_codi
		go bott
		this.text5.value=fac_pto
	ENDPROC

	PROCEDURE Command1.Click
		preg=0
		sele facturas
		set order to factipo
		codiped=ped_codi
		with thisform
			seek ALLT(STR(.text5.value))+ALLTRIM(STR(.text2.value))+ALLTRIM(.text4.value)
			do case
				case fac_conc="F"
					texto="Factura"
				case fac_conc="N"
					texto="Nota de Crédito"
				case fac_conc="D"
					texto="Nota de Débito"
			endcase	
			do case
				case anulado="S"
					messagebox("Esta "+texto+" ya ha sido anulada.",0+48,"Advertencia")
				case pagado="S"
					messagebox("Esta "+texto+" ha sido abonada por el Cliente en su totalidad"+chr(13)+ ;
							   "Imposible anular, deberá efectuar Nota de Crédito.",0+48,"Advertencia")
				case pagado<>"S" and imp_pag>0
					messagebox("Esta "+texto+" ha sido abonada parcialmente por el Cliente."+chr(13)+ ;
							   "Imposible anular. Deberá efectuar Nota de Crédito.",0+48,"Advertencia")
			other case
				preg=messagebox("¿Confirma la anulación de la "+texto+" ?",4+32+256,"Anulación")
				sele facturas_articulos
				set order to fac_codi
				seek facturas.fac_codi
				if preg=6
					repla facturas.anulado with "S"
					if facturas.ped_codi>0
						sele pedidos_articulos
						set order to pedart
						for i=1 to .grid1.rows-1
							.grid1.col=0
							.grid1.row=i
							articulo=val(.grid1.text)
							seek str(codiped)+str(articulo)
							if found()
								if articulo=4
									.grid1.col=3
									do while allt(pedidos_articulos.artped_dasc)<>allt(.grid1.text)
										skip
									enddo
								endif
								do case
									case facturas.fac_conc="F"
										.grid1.col=1
										repla artped_ent with artped_ent-val(.grid1.text)
										repla articulos.pedidos with articulos.pedidos+val(.grid1.text)
									case facturas.fac_conc="N"
										.grid1.col=1
										repla artped_ent with artped_ent+val(.grid1.text)
										repla articulos.pedidos with articulos.pedidos-val(.grid1.text)
								endcase							
								.grid1.col=6
								if allt(.grid1.text)<>"S"
									.grid1.col=1
									do case
										case facturas.fac_conc="F"
											repla articulos.art_stock with articulos.art_stock+val(.grid1.text)
										case facturas.fac_conc="N"
											repla articulos.art_stock with articulos.art_stock-val(.grid1.text)
									endcase
								endif
							else
								.grid1.col=0
								sele articulos
								set order to art_codi
								seek val(.grid1.text)
								.grid1.col=6
								if allt(.grid1.text)<>"S"
									.grid1.col=1
									do case
										case facturas.fac_conc="F"
											repla art_stock with art_stock+val(.grid1.text)
										case facturas.fac_conc="N"
											repla art_stock with art_stock-val(.grid1.text)
									endcase
								endif
							endif					
						next i
						dimension ca[1,1]
						dimension tot[1,1]
						ca[1,1]=0
						tot[1,1]=0
						sele pedidos_articulos
						count all for ped_codi=codiped to ca[1,1]
						count all for ped_codi=codiped and artped_ent>=artped_cant to tot[1,1]
						if tot[1,1]<>ca[1,1]
							sele pedidos
							set order to ped_codi
							seek codiped
							repla cumplido with ""
						endif
						sele pedidos_articulos
					else
						for i=1 to .grid1.rows-1
							.grid1.row=i
							.grid1.col=6
							if allt(.grid1.text)<>"S"
								.grid1.col=1
								do case
									case facturas.fac_conc="F"
										repla articulos.art_stock with articulos.art_stock+val(.grid1.text)
									case facturas.fac_conc="N"
										repla articulos.art_stock with articulos.art_stock-val(.grid1.text)
								endcase
							endif
							if !eof()
								SKIP
							endif
						next i
					endif
					sele clientes
					do case
						case facturas.fac_conc="F"
							repla cli_saldo with cli_saldo-val(thisform.text10.value)
						case facturas.fac_conc="N"
							repla cli_saldo with cli_saldo+val(thisform.text10.value)
						case facturas.fac_conc="D"
							repla cli_saldo with cli_saldo-val(thisform.text10.value)
					endcase
				endif
			endcase
			thisform.setall("Value","","Textbox")
			thisform.grid1.rows=1
			acu=0
			thisform.text4.value="A"
			thisform.text2.value=0
			thisform.text19.value=0
			thisform.text4.setfocus
		endwith
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Text19.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			dtotot=acu*this.value/100
			.text17.value=str(dtotot,10,2)
			.text18.value=str(acu-dtotot,10,2)
			if cond=2
				dife=acu-dtotot
				auxiva=dife*impiva1/100
				.text9.value=str(auxiva,10,2)
			endif
			.text10.value=str(val(.text18.value)+val(.text9.value)+val(.text11.value),10,2)
		endwith
		
		
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.LostFocus
		with thisform
			.grid1.rows=1
			sele facturas
			set order to factipo
			seek ALLT(STR(.text5.value))+ALLTRIM(STR(this.value))+ALLTRIM(.text4.value)
			do case
				case fac_conc="F" and anulado="S"
					.label5.visible=.T.
					.label5.caption="ANULADA"
				case fac_conc="F" and anulado<>"S"
					.label5.visible=.F.
				case fac_conc="N"
					.label5.visible=.T.
					.label5.caption="NOTA DE CRÉDITO"
				case fac_conc="D"
					.label5.visible=.T.
					.label5.caption="NOTA DE DÉBITO"
			endcase	
			if found()
				.text1.value=clientes.cli_nomb
				.text6.value=condiva.cond_desc
				.text12.value=clientes.cli_cuit
				.text3.value=facturas.fac_fec
				if altiva_1>0
					.label12.caption=allt(str(altiva_1,10,2))+"%"
					.label13.caption=allt(str(altiva_2,10,2))+"%"
					impiva1=altiva_1
					impiva2=altiva_2
				else
					.label12.caption=allt(str(iva.iva_1,10,2))+"%"
					.label13.caption=allt(str(iva.iva_2,10,2))+"%"
					impiva1=iva.iva_1
					impiva2=iva.iva_2
				endif
				sele facturas_articulos
				do while fac_codi=facturas.fac_codi and !eof()
					cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
					.grid1.additem(cadena+chr(9)+allt(str(artfac_cant,10,2))+chr(9)+articulos.art_med+chr(9)+articulos.art_desc+chr(9)+allt(str(artfac_impo,10,3))+chr(9)+allt(str(artfac_cant*artfac_impo,10,2)))
					if art_codi=4
						.grid1.row=.grid1.rows-1
						.grid1.col=3
						.grid1.text=iif(facturas.fac_conc="D",allt(artfac_nd),allt(artfac_dasc))
					endif
					.grid1.col=6
					if artfac_sstock="S"
						.grid1.row=.grid1.rows-1
						.grid1.text=artfac_sstock
					endif
					acu=acu+(artfac_cant*artfac_impo)
					skip
				enddo
				.text8.value=str(acu,10,2)
				if .text19.value=0
					.text17.value=0.00
				else
					.text17.value=str((acu*.text19.value)/100,10,2)
				endif
				if clientes.cond_codi=2
					.text18.value=str(acu-.text17.value,10,2)
					.text9.value=iif(facturas.fac_conc="D",str(facturas.ivand,10,2),str((val(.text18.value)*impiva1)/100,10,2))
					.text10.value=str(val(.text18.value)+val(.text9.value),10,2)
				else
					.text18.value=val(.text8.value)-.text17.value
					.text10.value=str(.text18.value,10,2)
				endif
				acu=0
			else
				messagebox("Factura no está en archivo",0+48,"Anulación de Facturas")
			endif
			.text4.setfocus
		endwith
	ENDPROC

	PROCEDURE Text4.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text5.Click
		this.setfocus
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="1" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Cursor1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Cursor2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Cursor3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Cursor4" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Cursor5" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Cursor6" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Cursor7" UniqueID="" Timestamp="" />

	*< OBJECTDATA: ObjPath="Cursor8" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Relation7" UniqueID="" Timestamp="" />

	*<PropValue>
		DataSource = .NULL.
		Height = 447
		Left = 1
		Name = "Dataenvironment"
		Top = 134
		Width = 792
	*</PropValue>

	ADD OBJECT 'Cursor1' AS cursor WITH ;

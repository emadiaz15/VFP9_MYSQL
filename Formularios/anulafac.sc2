		Top = 0, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor3' AS cursor WITH ;
		Alias = "facturas", ;
		CursorSource = "facturas", ;
		Database = ..\base - hp.dbc, ;
		Height = 242, ;
		Left = 147, ;
		Name = "Cursor3", ;
		Top = 128, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor4' AS cursor WITH ;
		Alias = "facturas_articulos", ;
		CursorSource = "facturas_articulos", ;
		Database = ..\base - hp.dbc, ;
		Height = 163, ;
		Left = 280, ;

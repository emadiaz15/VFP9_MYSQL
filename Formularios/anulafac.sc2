		Name = "Relation3", ;
		ParentAlias = "facturas_articulos", ;
		RelationalExpr = "art_codi"
		*< END OBJECT: BaseClass="relation" />

	ADD OBJECT 'Relation4' AS relation WITH ;
		ChildAlias = "condiva", ;
		ChildOrder = "cond_codi", ;
		Name = "Relation4", ;
		ParentAlias = "clientes", ;
		RelationalExpr = "cond_codi"

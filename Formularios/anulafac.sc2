		Top = 11, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor5' AS cursor WITH ;
		Alias = "condiva", ;
		CursorSource = "condiva", ;
		Database = ..\base - hp.dbc, ;
		Height = 90, ;
		Left = 152, ;
		Name = "Cursor5", ;
		Top = 8, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor6' AS cursor WITH ;
		Alias = "iva", ;
		CursorSource = "iva", ;
		Database = ..\base - hp.dbc, ;
		Height = 126, ;
		Left = 291, ;
		Name = "Cursor6", ;
		Top = 203, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor7' AS cursor WITH ;
		Alias = "pedidos_articulos", ;
		CursorSource = "pedidos_articulos", ;
		Database = ..\base - hp.dbc, ;
		Height = 189, ;
		Left = 552, ;
		Name = "Cursor7", ;
		Top = 17, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor8' AS cursor WITH ;
		Alias = "pedidos", ;
		CursorSource = "pedidos", ;
		Database = ..\base - hp.dbc, ;
		Height = 253, ;
		Left = 671, ;
		Name = "Cursor8", ;
		Top = 109, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Relation1' AS relation WITH ;
		ChildAlias = "clientes", ;
		ChildOrder = "cli_codi", ;
		Name = "Relation1", ;
		ParentAlias = "facturas", ;
		RelationalExpr = "cli_codi"
		*< END OBJECT: BaseClass="relation" />

	ADD OBJECT 'Relation2' AS relation WITH ;
		ChildAlias = "iva", ;
		ChildOrder = "iva_codi", ;
		Name = "Relation2", ;
		ParentAlias = "facturas", ;
		RelationalExpr = "iva_codi"

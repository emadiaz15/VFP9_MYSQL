	PROCEDURE Text2.Valid
		if this.value>0
			frmplgas= conectar_db(_screen.cn)
				SQLEXEC(frmplgas,"select * from tiposgastos where tipgas_codi=?this.value;","cur_tipgp")
			desconectar_db(frmplgas)
			if RECCOUNT("cur_tipgp")>0
				thisform.codigas=cur_tipgp.tipgas_codi
				thisform.combo2.rowsource="SELECT tipgas_desc FROM cur_tipgp INTO CURSOR combo1"
				thisform.combo2.value=thisform.combo2.list(1)

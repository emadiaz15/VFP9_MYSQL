		SET NOTIFY off
		SET TALK OFF
		
		STORE 0 TO thisform.text2.Value, ;
				   thisform.text6.Value
		
		STORE 0 TO thisform.txt_neto.Value , ;
				   thisform.txt_ng.Value , ;
				   thisform.txt_piva.Value , ;
				   thisform.txt_pbtos.Value , ;
				   thisform.txt_iva.value , ;
				   thisform.txt_total.Value
		
		thisform.text3.value=ctod("01"+"/"+"01"+"/"+allt(str(year(date()))))
		thisform.text4.value=date()
		
		frmplgas= conectar_db(_screen.cn)
			SQLEXEC(frmplgas,"select param_fec from parametros where param_codi = 8;","cur_fechier")
		desconectar_db(frmplgas)
		
		IF RECCOUNT("cur_fechier") > 0
			thisform.xfechcier = cur_fechier.param_fec
			cerrar_cursor("cur_fechier")
		ENDIF
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(215,215,215)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Check1.Click
		IF this.Value=1
			thisform.codiper=0
			thisform.text6.value=0
			thisform.combo1.value=''
			thisform.combo1.RowSource=''
		*!*		thisform.cmd_act.click
			thisform.cmd_act.setfocus
		ELSE
			thisform.codiper=0
			thisform.text6.SetFocus
		endif
	ENDPROC

	PROCEDURE Check2.Click
		IF this.Value=1
			thisform.codigas=0
			thisform.text2.value=0
			thisform.combo2.value=''
			thisform.combo2.RowSource=''
		*!*		thisform.cmd_act.click
			thisform.cmd_act.setfocus
		ELSE
			thisform.codigas=0
			thisform.text2.SetFocus
		endif
	ENDPROC

	PROCEDURE cmd_act.Click
		thisform.grid1.recordsource=""
		thisform.grid1.Refresh()
		
		frmplgas= conectar_db(_screen.cn)
			LOCAL xfecdes,xfechas
			xfecdes=thisform.text3.Value
			xfechas=thisform.text4.Value
			SQLEXEC(frmplgas,"call usp_planigas(?thisform.codiper,?thisform.codigas,?xfecdes,?xfechas);","cur_planilla")
		desconectar_db(frmplgas)
		
		IF RECCOUNT("cur_planilla")>0
			GO top
			thisform.grid1.RecordSource="cur_planilla"
			thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
			CALCULATE SUM(IIF(gas_conc="N",-neto,neto))      TO thisform.txt_neto.Value
			CALCULATE SUM(IIF(gas_conc="N",-gas_impng,gas_impng)) TO thisform.txt_ng.Value
			CALCULATE SUM(IIF(gas_conc="N",-piva,piva))      TO thisform.txt_piva.Value
			CALCULATE SUM(IIF(gas_conc="N",-pbtos,pbtos))     TO thisform.txt_pbtos.value
			CALCULATE SUM(IIF(gas_conc="N",-iva,iva))       TO thisform.txt_iva.value
			CALCULATE SUM(IIF(gas_conc="N",-importe,importe))   TO thisform.txt_total.Value
			thisform.cmd_eli.Enabled= .F.
			thisform.cmd_modi.Enabled= .F.
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_act.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_act.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_eli.Click
		LOCAL tbc,xgas,carac
		
		IF cur_planilla.gas_fech <= thisform.xfechcier
			MESSAGEBOX("El comprobante que desea eliminar ya fue presentado en un cierre de IVA. Imposible eliminar.",48,"Aviso del Sistema")
		ELSE
			tbc= ICASE(cur_planilla.gas_conc="F","Factura Nº ",cur_planilla.gas_conc="N","Nota de Crédito Nº ",cur_planilla.gas_conc="D","Nota de Débito Nº ")
		
		
			preli= MESSAGEBOX("Se dispone a eliminar la "+tbc+SUBSTR(cur_planilla.factura,5,13)+" de "+ALLTRIM(cur_planilla.per_desc)+"."+CHR(13)+CHR(13)+ ;
							  "¿Confirma la Elminiación?",4+48+256,"Aviso del Sistema")
			IF preli=6
				xgas = cur_planilla.gas_codi
				frmplgas= conectar_db(_screen.cn)
					SQLEXEC(frmplgas,"select CAST(COUNT(*) AS DECIMAL(10,0)) cant from pagosgas_gastos where gas_codi = ?xgas;","cur_pagada")
				desconectar_db(frmplgas)
				IF cur_pagada.cant>0
					MESSAGEBOX("Imposible eliminar."+CHR(13)+CHR(13)+ ;
							   "Este comprobante ya fue incluído en un pago al Proveedor, para quitarlo de la cuenta corriente deberá previamente anular la Orden de Pago",0+48,"Aviso del Sistema")
				ELSE
					
					frmplgas= conectar_db(_screen.cn)
						SQLEXEC(frmplgas,"delete from gastos where gas_codi=?xgas;")
						SQLEXEC(frmplgas,"delete from gastos_articulos where gas_codi=?xgas;")
					desconectar_db(frmplgas)
		
					thisform.cmd_act.Click()
					
					carac=LEN(tbc)-3
					tbc=SUBSTR(tbc,1,carac)
					MESSAGEBOX("La "+tbc+" fue eliminada con éxito",64,"Aviso del Sistema")
					
					thisform.cmd_act.SetFocus
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_eli.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_eli.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE cmd_modi.Click
		LOCAL xgas, xcoef
		
		xgas  = cur_planilla.gas_codi
		
		IF cur_planilla.gas_fech <= thisform.xfechcier
			MESSAGEBOX("El comprobante que desea modificar ya fue presentado en un cierre de IVA. Imposible modificar.",48,"Aviso del Sistema")
			DO CASE
				CASE cur_planilla.cc = 0
					prg = MESSAGEBOX("Este coprobante no está asentado en nuestra cuenta corriente en el Proveedor"+CHR(13)+CHR(13)+ ;
								     "¿Desea asentarla en la cuenta corriente ahora?",4+32+256,"Aviso del Sistema")
					IF prg = 6
						IF cur_planilla.gas_conc = "N"
							xcoef = -1
						ELSE
							xcoef = 1
						ENDIF
						frmplgas= conectar_db(_screen.cn)
							SQLEXEC(frmplgas,"update gastos set imp_pag=0, pagado = '',cc = 1 where gas_codi = ?xgas;")
							SQLEXEC(frmplgas,"update personas set per_saldo = per_saldo + (?cur_planilla.importe * ?xcoef) where per_codi = ?cur_planilla.per_codi;")
						desconectar_db(frmplgas)
						MESSAGEBOX("El comprobante ha sido asentado en la cuenta corriente",0+64,"Aviso del Sistema")
						thisform.cmd_act.Click()
						LOCATE FOR gas_codi = xgas
					ENDIF
				CASE cur_planilla.cc = 1
					prg = MESSAGEBOX("Este coprobante está asentado en nuestra cuenta corriente en el Proveedor"+CHR(13)+CHR(13)+ ;
								     "¿Desea quitarla de la cuenta corriente ahora?",4+16+256,"Aviso del Sistema")
					IF prg = 6
						frmplgas= conectar_db(_screen.cn)
							SQLEXEC(frmplgas,"select CAST(COUNT(*) AS DECIMAL(10,0)) cant from pagosgas_gastos where gas_codi = ?xgas;","cur_pagada")
						desconectar_db(frmplgas)
						IF cur_pagada.cant>0
							MESSAGEBOX("Imposible quitar de la cuenta corriente."+CHR(13)+CHR(13)+ ;
									   "Este comprobante ya fue incluído en un pago al Proveedor, para quitarlo de la cuenta corriente deberá previamente anular la Orden de Pago",0+48,"Aviso del Sistema")
						ELSE
							IF cur_planilla.gas_conc = "N"
								xcoef = 1
							ELSE
								xcoef = -1
							ENDIF
							frmplgas= conectar_db(_screen.cn)
								SQLEXEC(frmplgas,"update gastos set imp_pag=?cur_planilla.importe, pagado = 'S',cc = 0 where gas_codi = ?xgas;")
								SQLEXEC(frmplgas,"update personas set per_saldo = per_saldo + (?cur_planilla.importe * ?xcoef) where per_codi = ?cur_planilla.per_codi;")
							desconectar_db(frmplgas)
							MESSAGEBOX("El comprobante ha sido quitado de la cuenta corriente",0+64,"Aviso del Sistema")
							thisform.cmd_act.Click()
							LOCATE FOR gas_codi = xgas
						ENDIF
					ENDIF
			ENDCASE
		ELSE
			DO FORM modigastos WITH xgas
		
			thisform.cmd_act.Click()
		
			LOCATE FOR gas_codi = xgas
		ENDIF
		
		thisform.cmd_eli.Enabled= .T.
		this.Enabled= .T.
		
		thisform.grid1.SetFocus
		
		
	ENDPROC


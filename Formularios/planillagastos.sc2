			IF RECCOUNT("cur_planilla")>0
				thisform.cmd_modi.Enabled= .T.
				thisform.cmd_eli.Enabled= .T.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Grid1.Column1.Header1.Click
		IF USED("cur_planilla")
			thisform.grid1.RecordSource=''
			IF thisform.hdfecha_estado = 0
				SELECT * FROM cur_planilla ORDER BY gas_fech INTO CURSOR cur_planilla
				thisform.hdfecha_estado = 1
			ELSE
				DO case
					CASE thisform.hdfecha_estado = 1
						SELECT * FROM cur_planilla ORDER BY gas_fech DESC INTO CURSOR cur_planilla
						thisform.hdfecha_estado = 2
					CASE thisform.hdfecha_estado = 2
						SELECT * FROM cur_planilla ORDER BY gas_fech INTO CURSOR cur_planilla
						thisform.hdfecha_estado = 1
				ENDCASE
			ENDIF
			thisform.grid1.RecordSource="cur_planilla"
			thisform.grid1.Refresh()
		ENDIF
		
	ENDPROC


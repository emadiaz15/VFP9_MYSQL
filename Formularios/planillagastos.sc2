	PROCEDURE Combo1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					frmplgas= conectar_db(_screen.cn)
						xdesc=allt(this.list(i))
						SQLEXEC(frmplgas,"select * from personas where TRIM(per_desc)=?xdesc;","cur_perp")
					desconectar_db(frmplgas)
					thisform.text6.value=cur_perp.per_codi
					thisform.codiper=cur_perp.per_codi
					thisform.check1.Value=0
					keyboard '{TAB}'+'{TAB}'+'{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE Combo1.LostFocus
		*!*	IF thisform.codiper>0
		*!*		thisform.cmd_act.Click
		*!*	endif
	ENDPROC

	PROCEDURE Combo1.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade="%"+subst(allt(this.text),2,len(allt(this.text)))+"%"
				frmplgas= conectar_db(_screen.cn)
					SQLEXEC(frmplgas,"select * from personas where per_desc like ?cade order by per_desc;","cur_perp")
				desconectar_db(frmplgas)
				IF RECCOUNT("cur_perp")>0
					this.rowsource="select per_desc from cur_perp INTO CURSOR combo1"
					this.value=this.list(1)
					keyboard "{F4}"
				ELSE
					MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
					this.Value=""
				ENDIF
				RETURN .F.
			else
				if len(allt(this.text))>0
					cade=ALLTRIM(this.text)+"%"
					frmplgas= conectar_db(_screen.cn)
						SQLEXEC(frmplgas,"select * from personas where per_desc like ?cade;","cur_perp")
					desconectar_db(frmplgas)
					IF RECCOUNT("cur_perp")>0
						this.rowsource="select per_desc from cur_perp INTO CURSOR combo1"
						this.value=this.list(1)
						keyboard "{F4}"
					ELSE
						MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
						this.Value=""				
					ENDIF
					RETURN .F.
				ENDIF
			endif
		endif
	ENDPROC


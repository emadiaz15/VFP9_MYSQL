		Picture = ..\imagen\w95mbx02.ico, ;
		Stretch = 2, ;
		Top = 29, ;
		Width = 33
		*< END OBJECT: BaseClass="image" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackStyle = 0, ;
		Caption = "¿Qué desea hacer?", ;
		FontSize = 10, ;
		Height = 18, ;
		Left = 171, ;
		Name = "Label1", ;
		Top = 38, ;
		Width = 116
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Activate
		*store 1 to localiz
	ENDPROC

	PROCEDURE Init
		parameter cond,opcion,opcion2,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		do case
			case valorcadena="Ordenes de Compra" or valorcadena="Ordenes Compra"
				this.caption="Ordenes de Compra"
				this.command3.caption="\<Insertar Item"
				this.command1.Left=80
				this.command2.Left=250
				this.command3.Visible= .F.
				this.Height=120
			case valorcadena="Por Presupuesto"
			***or valorcadena="Por Número"
			***or valorcadena="Por Nota de Pedido"
				public dto
				this.caption="Pedidos de Clientes"
				this.command1.Left=80
				this.command2.Left=250
				this.command3.Visible= .F.
				this.Height=120
			case valorcadena="Recepciones" or valorcadena="Por Artículo" or valorcadena="Por Orden de Compra" OR valorcadena="Notas de Crédito/Notas de Débito"
				public dto
				IF valorcadena="Notas de Crédito/Notas de Débito"
					this.Caption="Notas de Crédito/Notas de Débito"
				ELSE
					this.caption="Recepciones"
				ENDIF
		*!*			this.command3.caption="\<Insertar Descuento"
				this.command1.Left=80
				this.command2.Left=250
				this.command3.Visible= .F.
				this.command6.Visible= .F.
				do case
					case opcion=1
						this.command1.caption="\<Modificar Desc."
					case opcion=2
		                this.command1.caption="\<Modificar Cargo"
		            other case
		            	this.command1.caption="\<Modificar Item"
		        endcase
		        this.command5.visible=.T.
		        if opcion=3
					this.command5.caption=IIF(valorcadena="Notas de Crédito/Notas de Débito","Mo\<viendo Stock","\<Recepcionar moviendo Stock")
				else
					this.command5.caption=IIF(valorcadena="Notas de Crédito/Notas de Débito","Sin mo\<ver Stock","\<Recepcionar sin mover Stock")
				endif
				this.command6.visible=.F.
		*		this.height=130
			case valorcadena="Por Artículos" or valorcadena="Por Pedido de Cliente" or valorcadena="Notas de Crédito" OR valorcadena="Por Nota de Pedido" or valorcadena="Por Cliente" ;
								or valorcadena="Por Número" or valorcadena="Pedidos Clientes" OR valorcadena="Por Nombre de Cliente"
		
				IF valorcadena<>"Por Artículos" AND valorcadena<>"Por Pedido de Cliente" AND valorcadena<>"Nota de Crédito"
					IF valorcadena="Por Cliente" OR valorcadena="Pedidos Clientes" OR valorcadena="Por Nota de Pedido" or valorcadena="Por Número"
						IF _screen.estapres<>3
							this.caption="Pedidos de Clientes"
							this.command3.caption="\<Insertar Item"
						ENDIF
					ENDIF
					this.Height=120
				ELSE
					public dto
					do case
						case concepto="F"
							this.caption="Facturas"
						case concepto="N"
							this.caption="Notas de Crédito"
							if opcion2=6
								this.command7.caption="\<Calcular Con Iva"
							else
								this.command7.caption="\<Calcular Sin Iva"
							endif
							this.height=195
					ENDCASE		
					this.command3.caption="\<Insertar Item"
				ENDIF
				this.command5.visible=.T.
				this.command5.left=225
				this.command6.visible=.T.
				if opcion=3
					this.command5.caption="\<Facturar moviendo Stock"
				ENDIF
		OTHERWISE
		*!*		this.command3.caption="\<Insertar Item"
			this.Height=120
		endcase
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			this.release
		endif
	ENDPROC

	PROCEDURE Unload
		return cond
		return opcion
		return opcion2
	ENDPROC

	PROCEDURE Command1.Click
		paso=1
		if dato5="ALT"
			do form alternapresup with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		else
			if valorcadena="Por Orden de Compra" or valorcadena="Ordenes Compra" or valorcadena="Ordenes de Compra" or valorcadena="Por Artículo" or valorcadena="Recepciones" or valorcadena="Notas de Crédito/Notas de Débito"
				do case
					case opcion=1
						pruni=substr(pruni,1,len(pruni)-1)
						porcdto=ConverNro(pruni)
						do form descuento with descri,porcdto
					case opcion=2
						pruni=substr(pruni,1,len(pruni)-1)
						porccar=ConverNro(pruni)
						do form cargo with descri,porccar
					other case
						descri=dato3
						auxali=cur_arti.art_alicuota
						do case
							case auxali=1
								auximpo=iif(cond=2,ConverNro(prtot),ConverNro(prtot)/(1+(impiva1/100)))
								auxiva=iif(cond=2,(ConverNro(prtot)*impiva1)/100,(auximpo*impiva1)/100)
							case auxali=2
								auximpo=iif(cond=2,ConverNro(prtot),ConverNro(prtot)/(1+(impiva2/100)))
								auxiva=iif(cond=2,(ConverNro(prtot)*impiva2)/100,(auximpo*impiva2)/100)
						ENDCASE
						do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
				endcase
			else
				descri=dato3
				auxali=cur_arti.art_alicuota
				do case
					case auxali=1
						auximpo=iif(cond=2,ConverNro(prtot),ConverNro(prtot)/(1+(impiva1/100)))
						auxiva=iif(cond=2,(ConverNro(prtot)*impiva1)/100,(auximpo*impiva1)/100)
					case auxali=2
						auximpo=iif(cond=2,ConverNro(prtot),ConverNro(prtot)/(1+(impiva2/100)))
						auxiva=iif(cond=2,(ConverNro(prtot)*impiva2)/100,(auximpo*impiva2)/100)
				ENDCASE
				do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
			endif
		endif
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		borra=messagebox("¿Seguro que desea eliminar este Ítem?",4+32+256,"Presupuestos")
		localiz=0
		thisform.release
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		insertar=1
		do case
			case valorcadena="Pedidos Clientes" OR valorcadena="Por Artículos" OR valorcadena="Por Presupuesto" or valorcadena="Por Nota de Pedido" ;
					OR valorcadena="Por Cliente" OR valorcadena="Notas de Crédito" OR valorcadena="Por Pedido de Cliente" OR valorcadena="Por Número"
				IF _screen.estapres<>3
					opcion=1
					do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
				ELSE
					do form itemoalter with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
				ENDIF
			case valorcadena="Ordenes de Compra" or valorcadena="Ordenes Compra"
				opcion=1
				do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
			case valorcadena="Por Orden de Compra" or valorcadena="Recepciones"
				opcion=1
				do form descuento with descri,porcdto
		other case
			do form itemoalter with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endcase
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command5.Click
		do case
			case opcion=0
				opcion=3
			case opcion=3
				opcion=4
		endcase
		thisform.release
	ENDPROC

	PROCEDURE Command5.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command5.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command6.Click
		opcion=5
		thisform.release
	ENDPROC

	PROCEDURE Command6.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command6.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command7.Click
		do case
			case opcion2=0
				preg=messagebox("¿Confirma que calcula Sin Iva este item?",4+48+256,"Notas de Crédito")
				if preg=6
					opcion2=6
				endif
			case opcion2=6
				preg=messagebox("¿Confirma que calcula Con Iva este item?",4+48+256,"Notas de Crédito")
				if preg=6
					opcion2=7
				endif
		endcase
		thisform.release
	ENDPROC

ENDDEFINE

	PROCEDURE Activate
		if codicli=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE buscarpedidosporarticulo
		LPARAMETERS tnArtCodi
		LOCAL frmpedlo
		
		IF EMPTY(tnArtCodi) OR tnArtCodi=0
			RETURN .F.
		ENDIF
		
		thisform.grid1.Rows=1
		thisform.command2.Enabled=.F.
		
		IF USED("cur_pl")
			USE IN cur_pl
		ENDIF
		
		frmpedlo = conectar_db(_screen.cn)
		
		IF valorcadena="Por Pedido" OR valorcadena="Por Pedido de Cliente"
			SQLEXEC(frmpedlo, ;
				"select distinct " + ;
				"if(p.notaped_nro>0,concat('NP',trim(cast(p.notaped_nro as char))),p.ped_codi), " + ;
				"p.ped_fech, p.ped_codi " + ;
				"from pedidos p " + ;
				"inner join pedidos_articulos pa on p.ped_codi=pa.ped_codi " + ;
				"where p.cli_codi=?codicli and p.cumplido<>'S' and pa.art_codi=?tnArtCodi " + ;
				"order by p.ped_fech desc;", ;
				"cur_pl")
		ELSE
			SQLEXEC(frmpedlo, ;
				"select distinct " + ;
				"if(p.notaped_nro>0,concat('NP',trim(cast(p.notaped_nro as char))),p.ped_codi), " + ;
				"p.ped_fech, p.ped_codi " + ;
				"from pedidos p " + ;
				"inner join pedidos_articulos pa on p.ped_codi=pa.ped_codi " + ;
				"where p.cli_codi=?codicli and pa.art_codi=?tnArtCodi " + ;
				"order by p.ped_fech desc;", ;
				"cur_pl")
		ENDIF
		
		desconectar_db(frmpedlo)
		
		IF USED("cur_pl") AND RECCOUNT("cur_pl")>0
			thisform.lst_pedlo.RowSource="cur_pl"
			thisform.lst_pedlo.Requery()
			thisform.lst_pedlo.Selected(1)=.T.
			thisform.CargarDetallePedido()
			thisform.command2.Enabled=.T.
		ELSE
			thisform.lst_pedlo.RowSource=""
			thisform.grid1.Rows=1
			thisform.command2.Enabled=.F.
			MESSAGEBOX("No existen pedidos del cliente con ese artículo.",48,"Aviso")
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargardetallepedido
		LOCAL contador, frmpedlo, cadena, div, longdes, lnRowMatch
		LOCAL lcDescri,lcMask
		
		contador = 1
		lnRowMatch = 0
		
		thisform.grid1.Rows = 1
		
		IF !USED("cur_pl")
			RETURN
		ENDIF
		
		IF EOF("cur_pl")
			RETURN
		ENDIF
		
		SET DECIMALS TO 3
		
		frmpedlo = conectar_db(_screen.cn)
		SQLEXEC(frmpedlo, ;
			"select a.art_codi,b.art_desc,a.artped_dasc,a.artped_precio from pedidos_articulos a inner join articulos b on a.art_codi=b.art_codi where ped_codi=?cur_pl.ped_codi;", ;
			"cur_pedalo")
		desconectar_db(frmpedlo)
		
		SET DECIMALS TO
		
		IF RECCOUNT("cur_pedalo")>0
			SELECT cur_pedalo
			GO TOP
		
			SCAN
				cadena = REPL("0",8-LEN(ALLT(STR(cur_pedalo.art_codi)))) + ALLT(STR(cur_pedalo.art_codi))
		
				IF cur_pedalo.art_codi=4 OR cur_pedalo.art_codi=5
					lcDescri = cur_pedalo.artped_dasc
				ELSE
					lcDescri = cur_pedalo.art_desc
				ENDIF
				lcMask= ICASE(cur_pl.moneda="D","USD 999,999,999.99",cur_pl.moneda="P","$ 999,999,999.99")
				
				thisform.grid1.AddItem(ALLT(STR(contador))+CHR(9)+cadena+CHR(9)+lcDescri+CHR(9)+TRANSFORM(cur_pedalo.artped_precio, lcMask))
		
				WITH thisform
					.grid1.Row = .grid1.Rows-1
		
					.grid1.Col = 0
					.grid1.CellAlignment = 3
		
					.grid1.Col = 1
					.grid1.CellAlignment = 3
		
					.grid1.Col = 2
					.grid1.CellAlignment = 0
		
					.grid1.Col = 3
					.grid1.CellAlignment = 8
				ENDWITH
		
				* TEST DE MATCH
				IF PEMSTATUS(thisform,"xArtFiltro",5) AND thisform.xArtFiltro>0
					IF cur_pedalo.art_codi = thisform.xArtFiltro
						lnRowMatch = thisform.grid1.Rows-1
					ENDIF
				ENDIF
		
				contador = contador + 1
			ENDSCAN
		
			thisform.command2.Enabled = .T.
		
			*-----------------------------------------
			* Resaltar fila encontrada al final
			*-----------------------------------------
			IF lnRowMatch > 0
				WITH thisform
					.grid1.Row = lnRowMatch
		
					.grid1.Col = 0
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					.grid1.Col = 1
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					.grid1.Col = 2
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					.grid1.Col = 3
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					* Dejar posicionada la fila encontrada
					.grid1.Row = lnRowMatch
				ENDWITH
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE copiapedido
		LPARAMETERS ncodp
		
		LOCAL xcodp,xcond
		
		xcodp    = ncodp
		xcond    = cur_clie.cond_codi
		
		DO FORM pedxped WITH xcodp,xcond
		
		RETURN
	ENDPROC

	PROCEDURE Init
		PARAMETER codicli
		PUBLIC i
		
		
		IF !PEMSTATUS(thisform,"xArtFiltro",5)
			thisform.AddProperty("xArtFiltro",0)
		ENDIF
		
		LOCAL contador
		contador=1
		
		SET DATE BRITISH
		SET CENT ON
		SET DELETED ON
		
		WITH thisform
			IF codicli=0
				DO FORM cliload WITH codicli
				cond=cond_codi
				.text1.Value=cur_clie.cli_nomb
				.text2.Value=cur_clie.cli_domi
				.text6.Value=cur_clie.cond_desc
				.text12.Value=cur_clie.cli_cuit
				.text3.Value=cur_clie.cp_nro
				.text4.Value=cur_clie.loca_nomb
				.text5.Value=cur_clie.provi_nomb
			ELSE
				frmpedlo=conectar_db(_screen.cn)
				SQLEXEC(frmpedlo,"call usp_buscarcli(?codicli);","cur_clie")
				desconectar_db(frmpedlo)
		
				.text1.Value=cur_clie.cli_nomb
				.text2.Value=cur_clie.cli_domi
				.text6.Value=cur_clie.cond_desc
				.text12.Value=cur_clie.cli_cuit
				.text3.Value=cur_clie.cp_nro
				.text4.Value=cur_clie.loca_nomb
				.text5.Value=cur_clie.provi_nomb
			ENDIF
			this.text7.Value=0
			frmpedlo=conectar_db(_screen.cn)
			IF valorcadena="Por Pedido" OR valorcadena="Por Pedido de Cliente"
				SQLEXEC(frmpedlo,"select if(notaped_nro>0,concat('NP',trim(cast(notaped_nro as char))),ped_codi),ped_fech,ped_codi,moneda from pedidos where cli_codi=?codicli and cumplido<>'S' order by ped_fech desc;","cur_pl")
			ELSE
				SQLEXEC(frmpedlo,"select if(notaped_nro>0,concat('NP',trim(cast(notaped_nro as char))),ped_codi),ped_fech,ped_codi,moneda from pedidos where cli_codi=?codicli ORDER BY ped_fech DESC;","cur_pl")
			ENDIF
			desconectar_db(frmpedlo)
		
			IF RECCOUNT("cur_pl")>0
				.lst_pedlo.RowSource="cur_pl"
				.lst_pedlo.Selected(1)=.T.
				.command2.Enabled=.T.
				thisform.CargarDetallePedido()
			ENDIF
		ENDWITH
	ENDPROC

	PROCEDURE modificaped
		LOCAL xpedcod
		
		xpedcod = cur_pl.ped_codi
		
		DO FORM modipedicli WITH xpedcodi,cur_clie.cond_codi
		
		LOCATE FOR cur_pl.ped_codi = xpedcod
		
		RETURN
		
	ENDPROC

	PROCEDURE recargarpedidoscliente
		thisform.grid1.Rows = 1
		thisform.xArtFiltro = 0
		thisform.label8.Caption = ""
		thisform.text7.Value = 0
		
		frmpedlo = conectar_db(_screen.cn)
		IF valorcadena="Por Pedido" OR valorcadena="Por Pedido de Cliente"
			SQLEXEC(frmpedlo,"select if(notaped_nro>0,concat('NP',trim(cast(notaped_nro as char))),ped_codi),ped_fech,ped_codi from pedidos where cli_codi=?codicli and cumplido<>'S' order by ped_fech desc;","cur_pl")
		ELSE
			SQLEXEC(frmpedlo,"select if(notaped_nro>0,concat('NP',trim(cast(notaped_nro as char))),ped_codi),ped_fech,ped_codi from pedidos where cli_codi=?codicli ORDER BY ped_fech DESC;","cur_pl")
		ENDIF
		desconectar_db(frmpedlo)
		
		IF RECCOUNT("cur_pl")>0
			thisform.lst_pedlo.RowSource = "cur_pl"
			thisform.lst_pedlo.Selected(1)=.T.
			thisform.command2.Enabled=.T.
			thisform.CargarDetallePedido()
		ELSE
			thisform.lst_pedlo.RowSource = ""
			thisform.command2.Enabled=.F.
		ENDIF
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL paso,contador
		paso=0
		contador=1
		thisform.grid1.Rows=1
		
		DO FORM cliload WITH codicli
		cond=cond_codi
		
		WITH thisform
			.xArtFiltro = 0
			.text7.Value = ""
			.label8.Caption = ""
			.text1.Value=cur_clie.cli_nomb
			.text2.Value=cur_clie.cli_domi
			.text6.Value=cur_clie.cond_desc
			.text12.Value=cur_clie.cli_cuit
			.text3.Value=cur_clie.cp_nro
			.text4.Value=cur_clie.loca_nomb
			.text5.Value=cur_clie.provi_nomb
		
			frmpedlo=conectar_db(_screen.cn)
			IF valorcadena="Por Pedido" OR valorcadena="Por Pedido de Cliente"
				SQLEXEC(frmpedlo,"select if(notaped_nro>0,concat('NP',trim(cast(notaped_nro as char))),ped_codi),ped_fech,ped_codi,moneda from pedidos where cli_codi=?codicli and cumplido<>'S' order by ped_fech desc;","cur_pl")
			ELSE
				SQLEXEC(frmpedlo,"select if(notaped_nro>0,concat('NP',trim(cast(notaped_nro as char))),ped_codi),ped_fech,ped_codi,moneda from pedidos where cli_codi=?codicli ORDER BY ped_fech DESC;","cur_pl")
			ENDIF
			desconectar_db(frmpedlo)
		
			IF RECCOUNT("cur_pl")>0
				.lst_pedlo.RowSource="cur_pl"
				.lst_pedlo.Selected(1)=.T.
				.command2.Enabled=.T.
				thisform.CargarDetallePedido()
			ELSE
				.lst_pedlo.RowSource=""
				.command2.Enabled=.F.
			ENDIF
		ENDWITH
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command2.Click
		&& pediload.command2.click
		
		DO CASE
			CASE valorcadena = "Por Pedido de Cliente"
				LOCAL codre
				codp = cur_pl.ped_codi
				cond = cur_clie.cond_codi
				codre = 0
				DO FORM itemsfac WITH codp, codre, cond, codicli
				THISFORM.Release
		
			CASE valorcadena = "Pedidos Clientes"
				codped = cur_pl.ped_codi
				cond = cur_clie.cond_codi
				DO FORM modipedicli WITH codped, cond
				THISFORM.Release
		
			CASE valorcadena = "Pedidos por Cliente"
				codped = cur_pl.ped_codi
				cond = cur_clie.cond_codi
				DO FORM conspedicli WITH codped, cond
				THISFORM.Release
		
			CASE valorcadena = "Por Pedido"
				LOCAL codfa
				codfa = 0
				codp = cur_pl.ped_codi
				cond = cur_clie.cond_codi
				DO FORM itemsenv WITH codp, codfa, cond, codicli
				THISFORM.Release
		ENDCASE
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command4.Click
		LOCAL frmpe, lcNombre
		
		codigo = 0
		lcNombre = ""
		
		DO FORM artload WITH codigo
		
		IF codigo>0
			thisform.xArtFiltro = codigo
			thisform.text7.Value = codigo
		
			frmpe = conectar_db(_screen.cn)
			SQLEXEC(frmpe,"select art_desc from articulos where art_codi=?codigo;","cur_artbus")
			desconectar_db(frmpe)
		
			IF USED("cur_artbus") AND RECCOUNT("cur_artbus")>0
				thisform.label8.Caption = ALLTRIM(cur_artbus.art_desc)
			ELSE
				thisform.label8.Caption = ""
			ENDIF
		
			thisform.BuscarPedidosPorArticulo(codigo)
		ENDIF
	ENDPROC

	PROCEDURE Command4.GotFocus
		RETURN
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE lst_pedlo.Click
		thisform.CargarDetallePedido()
	ENDPROC

	PROCEDURE lst_pedlo.KeyPress
		&& pediload.lst_pedlo.keypress
		
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		* Enter sobre la lista de pedidos = mismo comportamiento que botón Aceptar
		IF nKeyCode = 13
		
			* Evita que VFP procese el Enter por su cuenta
			NODEFAULT
		
			* Validaciones defensivas
			IF !USED("cur_pl") OR RECCOUNT("cur_pl") = 0
				RETURN
			ENDIF
		
			IF EOF("cur_pl") OR BOF("cur_pl")
				RETURN
			ENDIF
		
			IF PEMSTATUS(THISFORM, "Command2", 5)
				IF THISFORM.Command2.Enabled
					THISFORM.Command2.Click()
				ENDIF
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE lst_pedlo.RightClick
		IF USED("cur_pl")
			LOCAL lcShortcut, loRef
			m.loRef = thisform
			m.lcShortcut = SYS(2015)
		
			DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
			DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Consultar Pedido] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
			DEFINE BAR 2 OF (m.lcShortcut) PROMPT [Copiar Pedido] PICTURE "C:\VFP9_MYSQL\imagen\facxped.png"
			DEFINE BAR 3 OF (m.lcShortcut) PROMPT [Modificar Pedido] PICTURE "C:\VFP9_MYSQL\imagen\misc_1_911.ico"
			
			ON SELECTION BAR 1 OF (m.lcShortcut) DO FORM conspedicli WITH cur_pl.ped_codi,cur_clie.cond_codi
			ON SELECTION BAR 2 OF (m.lcShortcut) m.loRef.copiapedido(cur_pl.ped_codi)
			ON SELECTION BAR 3 OF (m.lcShortcut) m.loRef.modificaped()
				
			ACTIVATE POPUP (m.lcShortcut)
			RELEASE POPUP (m.lcShortcut)
		
		ENDIF
	ENDPROC

	PROCEDURE Text7.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text7.InteractiveChange
		LOCAL lccadena
		lccadena = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lccadena) OR lccadena="0"
			thisform.RecargarPedidosCliente()
		ENDIF
	ENDPROC

	PROCEDURE Text7.LostFocus
		RETURN
	ENDPROC

	PROCEDURE Text7.Valid
		LOCAL lncodigoart, lccadena, frmpedlo
		
		lccadena = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lccadena) OR lccadena="0"
			thisform.RecargarPedidosCliente()
			RETURN .T.
		ENDIF
		
		lncodigoart = VAL(lccadena)
		
		IF lncodigoart<=0
			thisform.xArtFiltro = 0
			thisform.label8.Caption = ""
			RETURN .T.
		ENDIF
		
		frmpedlo = conectar_db(_screen.cn)
		SQLEXEC(frmpedlo,"select art_desc from articulos where art_codi=?lncodigoart;","cur_artbus")
		desconectar_db(frmpedlo)
		
		IF USED("cur_artbus") AND RECCOUNT("cur_artbus")>0
			thisform.xArtFiltro = lncodigoart
			thisform.label8.Caption = ALLTRIM(cur_artbus.art_desc)
			thisform.BuscarPedidosPorArticulo(lncodigoart)
		ELSE
			thisform.xArtFiltro = 0
			thisform.label8.Caption = ""
			MESSAGEBOX("No existe un artículo con ese código.",48,"Aviso")
		ENDIF
		
		RETURN .T.
	ENDPROC

ENDDEFINE

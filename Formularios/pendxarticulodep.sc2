	PROCEDURE Init
		public codigo
		codigo=0
		create cursor cli(pedido N(8),fecha D,nombre C(45),ent N(10,2),pend N(10,2))
		dimension tot[1,1]
		this.text1.value=0
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			codigo=0
			.text1.value=0
			do form artloaddep with codigo
			if codigo>0
				sele articulos
				set order to art_codi
				seek codigo
				.text1.value=codigo
				.text2.value=art_desc
				select iif(a.notaped_nro>0,a.notaped_nro,a.ped_codi) as "pedido", ;
					a.ped_fech as "fecha",c.cli_nomb as "nombre", ;
					b.artped_ent as "ent",b.artped_cant-b.artped_ent as "pend" ;
					from pedidos as a inner join pedidos_articulos as b on ;
					a.ped_codi=b.ped_codi,clientes as c where c.cli_codi=a.cli_codi ;
					and b.art_codi=.text1.value and b.artped_ent<b.artped_cant ;
					order by a.ped_fech into cursor cli
				.list1.rowsourcetype=3
				.list1.rowsource="select distinct nombre from cli into cursor list1"
			endif
			.text1.setfocus
		endwith
		
	ENDPROC

	PROCEDURE Command1.GotFocus
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Command2.GotFocus
		if last()=24 or last()=19 or last()=4 or last()=5
			thisform.text1.setfocus
		endif
	ENDPROC

	PROCEDURE List1.Click
		with thisform
			for x=1 to this.listcount
				if this.selected(x)
					.grid1.recordsourcetype=4
					.grid1.recordsource="select pedido,fecha,ent,pend from cli where nombre=allt(this.list(x,1)) into cursor grid1"
					.grid1.forecolor=0
					select sum(pend) from cli where nombre=allt(this.list(x,1)) into array tot
					.text3.value=tot[1,1]
					.label4.caption=allt(articulos.art_med)
				endif
			next x
		endwith
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		with thisform
			.grid1.forecolor=16777215
			.text3.value=""
			.label4.caption=""
		endwith
		
	ENDPROC

	PROCEDURE Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		with thisform
		do case
			case nkeycode=19 or nkeycode=24
				for x=1 to .list1.listcount
					if .list1.selected(x)
						.list1.selected(x)=.F.
					endif
				next x
				sele articulos
				set order to art_codi
				if this.value=0
					go bott
				else
					seek this.value
					if found() and !bof()
						skip-1
					else
						go bott
					endif
				endif
				if art_codi<>4
					this.value=art_codi
					.text2.value=art_desc
					select iif(a.notaped_nro>0,a.notaped_nro,a.ped_codi) as "pedido", ;
						a.ped_fech as "fecha",c.cli_nomb as "nombre", ;
						b.artped_ent as "ent",b.artped_cant-b.artped_ent as "pend" ;
						from pedidos as a inner join pedidos_articulos as b on ;
						a.ped_codi=b.ped_codi,clientes as c where c.cli_codi=a.cli_codi ;
						and b.art_codi=this.value and b.artped_ent<b.artped_cant ;
						order by a.ped_fech into cursor cli
					.list1.rowsourcetype=3
					.list1.rowsource="select distinct nombre from cli into cursor list1"
				endif
			case nkeycode=4 or nkeycode=5
				for x=1 to .list1.listcount
					if .list1.selected(x)
						.list1.selected(x)=.F.
					endif
				next x
				sele articulos
				set order to art_codi
				if this.value=0
					go top
					skip
				else
					seek this.value
					if found() and !eof()
						skip
					else
						go top
					endif
				endif
				if art_codi<>4
					this.value=art_codi
					.text2.value=art_desc
					select iif(a.notaped_nro>0,a.notaped_nro,a.ped_codi) as "pedido", ;
						a.ped_fech as "fecha",c.cli_nomb as "nombre", ;
						b.artped_ent as "ent",b.artped_cant-b.artped_ent as "pend" ;
						from pedidos as a inner join pedidos_articulos as b on ;
						a.ped_codi=b.ped_codi,clientes as c where c.cli_codi=a.cli_codi ;
						and b.art_codi=this.value and b.artped_ent<b.artped_cant ;
						order by a.ped_fech into cursor cli
					.list1.rowsourcetype=3
					.list1.rowsource="select distinct nombre from cli into cursor list1"
				endif
		endcase
		endwith
		
	ENDPROC

	PROCEDURE Text1.Valid
		with thisform
			for x=1 to .list1.listcount
				if .list1.selected(x)
					.list1.selected(x)=.F.
				endif
			next x
			if this.value>0
				sele articulos
				set order to art_codi
				seek this.value
				if found()
					.text2.value=art_desc
					select iif(a.notaped_nro>0,a.notaped_nro,a.ped_codi) as "pedido", ;
						a.ped_fech as "fecha",c.cli_nomb as "nombre", ;
						b.artped_ent as "ent",b.artped_cant-b.artped_ent as "pend" ;
						from pedidos as a inner join pedidos_articulos as b on ;
						a.ped_codi=b.ped_codi,clientes as c where c.cli_codi=a.cli_codi ;
						and b.art_codi=this.value and b.artped_ent<b.artped_cant ;
						order by a.ped_fech into cursor cli
					.list1.rowsourcetype=3
					.list1.rowsource="select distinct nombre from cli into cursor list1"
				else
					=messagebox("Artículo no está en archivo",0+48,"Advertencia")
					this.value=0
					return 0
				endif
			endif
		endwith
		
	ENDPROC

ENDDEFINE

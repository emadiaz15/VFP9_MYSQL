	PROCEDURE Init
		parameter codi
		local codr
		PUBLIC xcodigo
		xcodigo=codi
		xfdesde=CTOD("01"+"/"+ALLTRIM(STR(MONTH(GOMONTH(DATE(),-6))))+"/"+ALLTRIM(STR(YEAR(GOMONTH(DATE(),-6)))))
		xfhasta=DATE()
		this.text1.Value=xfdesde
		this.text2.Value=xfhasta
		SET DECIMALS TO 3
		frmrapc= conectar_db(_screen.cn)
			SQLEXEC(frmrapc,"call usp_conrapcos(?xcodigo,?xfdesde,?xfhasta);","auxi")
		desconectar_db(frmrapc)
		SET DECIMALS to
		go top
		
		this.grd_costos.RecordSource="auxi"
		
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if last()=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.Click
		thisform.grd_costos.RecordSource=''
		thisform.grd_costos.Refresh
		
		xfdesde=thisform.text1.Value
		xfhasta=thisform.text2.Value
		SET DECIMALS TO 3
		frmrapc= conectar_db(_screen.cn)
			SQLEXEC(frmrapc,"call usp_conrapcos(?xcodigo,?xfdesde,?xfhasta);","auxi")
		desconectar_db(frmrapc)
		SET DECIMALS to
		go top
		
		thisFORM.grd_costos.RecordSource="auxi"
		
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE grd_costos.DblClick
		LOCAL xcodiprov
		this.HighlightStyle=0
		this.SetAll("Sparse", .T., "Column")
		
		if auxi.recep_conc="F"
			valorcadena="Recepciones (Mercadería Recibida)"
		else
			valorcadena="Notas de Crédito/Notas de Débito"
		endif
		pasrecep=1
		cond=auxi.cond_codi
		codr=auxi.recep_codi
		xcodiprov=auxi.prov_codi
		
		frmrapc= conectar_db(_screen.cn)
			SQLEXEC(frmrapc,"call usp_buscarprov(?xcodiprov);","cur_prov")
		desconectar_db(frmrapc)
		
		do form consrecep with codr,cond
		
		
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

ENDDEFINE

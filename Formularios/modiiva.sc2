		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text3' AS textbox WITH ;
		Alignment = 2, ;
		DateFormat = 3, ;
		DisabledBackColor = 255,255,255, ;
		FontBold = .T., ;
		Height = 23, ;
		Left = 244, ;

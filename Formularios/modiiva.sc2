		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Text4' AS textbox WITH ;
		FontBold = .T., ;
		Height = 23, ;
		InputMask = "% ##.##", ;
		Left = 155, ;
		Name = "Text4", ;
		SelectOnEntry = .T., ;
		TabIndex = 3, ;
		Top = 118, ;
		Width = 87
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		set skip of bar 13 of Modificaci .F.
	ENDPROC

	PROCEDURE Init
		frmmodiva= conectar_db(_screen.cn)
			SQLEXEC(frmmodiva,"select * from iva order by iva_codi desc limit 1;","cur_miva")
		desconectar_db(frmmodiva)
		thisform.text3.value=date()
		
		IF RECCOUNT("cur_miva")>0
			thisform.text1.value=cur_miva.iva_1
			thisform.text2.value=cur_miva.iva_2
			thisform.text4.value=cur_miva.iva_3
		ENDIF
	ENDPROC

	PROCEDURE Load
		set skip of bar 13 of Modificaci .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if prompt()<>"Porcentajes de IVA"
		*!*		set skip of bar 13 of Modificaci .F.
		*!*		thisform.hide
		*!*	endif
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL ivcod,fec
		ivcod=1
		if thisform.text1.value<>cur_miva.iva_1 or thisform.text2.value<>cur_miva.iva_2
			preg=messagebox("¿Confirma los Importes ingresados?",4+32+256,"Importes de IVA")
			if preg=6
				frmmodiva= conectar_db(_screen.cn)
					SQLEXEC(frmmodiva,"select CAST(iva_codi+1 as decimal(8,0)) as iva_codi from iva order by iva_codi desc limit 1;","cur_ivan")
					IF RECCOUNT("cur_ivan")>0
						ivcod=cur_ivan.iva_codi
					ENDIF
					SQLEXEC(frmmodiva,"insert into iva values(?ivcod,?thisform.text3.value,?thisform.text1.value,?thisform.text2.value,?thisform.text4.value);")
				desconectar_db(frmmodiva)
			endif
		endif
		thisform.release
	ENDPROC

	PROCEDURE Command1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Text1.InteractiveChange
		thisform.command1.enabled=.T.
	ENDPROC

	PROCEDURE Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Text1.LostFocus
		thisform.text2.value=this.value/2
	ENDPROC

	PROCEDURE Text2.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Text4.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

ENDDEFINE

	PROCEDURE Activate
		if codiprov=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE buscarremitosporarticulo
		LPARAMETERS tnArtCodi
		LOCAL frmpedlo
		
		IF EMPTY(tnArtCodi) OR tnArtCodi=0
			RETURN .F.
		ENDIF
		
		thisform.grid1.Rows=1
		thisform.command2.Enabled=.F.
		
		IF USED("cur_rl")
			USE IN cur_rl
		ENDIF
		
		frmremlo = conectar_db(_screen.cn)
		
			SQLEXEC(frmremlo, ;
				"select distinct " + ;
				"CONCAT('   ',CAST(r.rem_pto as char)),CONCAT(' ',CAST(r.rem_nro as char)), " + ;
				"r.rem_fech,r.rem_codi,r.cli_codi " + ;
				"from remitos r " + ;
				"inner join remitos_articulos ra on r.rem_codi=ra.rem_codi " + ;
				"where r.prov_codi=?codiprov and ra.art_codi=?tnArtCodi " + ;
				"order by r.rem_fech desc;", ;
				"cur_rl")
		
		desconectar_db(frmremlo)
		
		IF USED("cur_rl") AND RECCOUNT("cur_rl")>0
			thisform.lst_remlo.RowSource="cur_rl"
			thisform.lst_remlo.Requery()
			thisform.lst_remlo.Selected(1)=.T.
			thisform.CargarDetalleRemito()
			thisform.command2.Enabled=.T.
		ELSE
			thisform.lst_remlo.RowSource=""
			thisform.grid1.Rows=1
			thisform.command2.Enabled=.F.
			MESSAGEBOX("No existen remitos del proveedor con ese artículo.",48,"Aviso")
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE cargardetalleremito
		local lnRowMatch
		
		lnRowMatch = 0
		
		thisform.grid1.rows=1
		
		IF !USED("cur_rl")
			RETURN
		ENDIF
		
		IF EOF("cur_rl")
			RETURN
		ENDIF
		
		codirem=cur_rl.rem_codi
		frmremlo= conectar_db(_screen.cn)
			SQLEXEC(frmremlo,"select a.art_codi,b.art_desc,a.artrem_dasc,a.artrem_ddesc,a.dac_codi from remitos_articulos as a inner join articulos as b on a.art_codi=b.art_codi where rem_codi=?codirem;","cur_remalo")
		desconectar_db(frmremlo)
		IF RECCOUNT("cur_remalo")>0
			GO top
			SCAN
				cadena=repl("0",8-len(allt(str(cur_remalo.art_codi))))+allt(str(cur_remalo.art_codi))
				if cur_remalo.art_codi=4 OR cur_remalo.art_codi=5
					thisform.grid1.additem(cadena+chr(9)+ALLTRIM(cur_remalo.artrem_dasc))
				ELSE
					thisform.grid1.additem(cadena+chr(9)+ALLTRIM(cur_remalo.art_desc))
					if LEN(ALLTRIM(cur_remalo.artrem_ddesc))>0
						thisform.grid1.col=1
						thisform.grid1.row=thisform.grid1.rows-1
						thisform.grid1.text=cur_remalo.artrem_ddesc
					endif
				endif
				WITH thisform
					.grid1.Row = .grid1.Rows-1
		
					.grid1.Col = 0
					.grid1.CellAlignment = 3
		
					.grid1.Col = 1
					.grid1.CellAlignment = 0
				ENDWITH
				
				* TEST DE MATCH
				IF PEMSTATUS(thisform,"xArtFiltro",5) AND thisform.xArtFiltro>0
					IF cur_remalo.art_codi = thisform.xArtFiltro
						lnRowMatch = thisform.grid1.Rows-1
					ENDIF
				ENDIF	
			ENDSCAN
			*-----------------------------------------
			* Resaltar fila encontrada al final
			*-----------------------------------------
			IF lnRowMatch > 0
				WITH thisform
					.grid1.Row = lnRowMatch
		
					.grid1.Col = 0
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					.grid1.Col = 1
					.grid1.CellBackColor = RGB(227,68,34)
					.grid1.CellForeColor = RGB(255,255,255)
		
					* Dejar posicionada la fila encontrada
					.grid1.Row = lnRowMatch
				ENDWITH
			ENDIF		
		endif
	ENDPROC

	PROCEDURE Destroy
		codiprov=0
	ENDPROC

	PROCEDURE Init
		parameter proveedor,codiprov
		public cond,i,nrorem,postal,provi,locali,codirem
		
		IF !PEMSTATUS(thisform,"xArtFiltro",5)
			thisform.AddProperty("xArtFiltro",0)
		ENDIF
		
		STORE 0 TO codirem, postal
		STORE "" TO provi, locali
		
		set date british
		set cent on
		set dele on
		with thisform
			if codiprov=0
				do form provload with proveedor,codiprov
				cond=cond_codi
				.text1.value=cur_prov.prov_nomb
				.text2.value=cur_prov.prov_domi
				.text6.value=cur_prov.cond_desc
				.text12.value=cur_prov.prov_cuit
				.text3.value=cur_prov.cp_nro
				.text4.value=cur_prov.loca_nomb
				.text5.value=cur_prov.provi_nomb
			ELSE
				frmremlo= conectar_db(_screen.cn)
					SQLEXEC(frmremlo,"call usp_buscarprov(?codiprov);","cur_prov")
				desconectar_db(frmremlo)
				.text1.value=cur_prov.prov_nomb
				.text2.value=cur_prov.prov_domi
				.text6.value=cur_prov.cond_desc
				.text12.value=cur_prov.prov_cuit
				.text3.value=cur_prov.cp_nro
				.text4.value=cur_prov.loca_nomb
				.text5.value=cur_prov.provi_nomb
			ENDIF
			this.text7.Value=0
			frmremlo= conectar_db(_screen.cn)
				SQLEXEC(frmremlo,"select CONCAT('  ',CAST(rem_pto AS CHAR)),CONCAT('  ',CAST(rem_nro AS CHAR)),rem_fech,rem_codi,prov_codi from remitos where prov_codi=?codiprov order by rem_fech desc;","cur_rl")
			desconectar_db(frmremlo)
			IF RECCOUNT("cur_rl")>0
				thisform.lst_remlo.RowSource="cur_rl"
				thisform.lst_remlo.Selected(1)=.T.
				thisform.command2.enabled=.T.
				thisform.CargarDetalleRemito()		
			ENDIF
		endwith
	ENDPROC

	PROCEDURE recargarremitosproveedor
		thisform.grid1.Rows = 1
		thisform.xArtFiltro = 0
		thisform.label8.Caption = ""
		thisform.text7.Value = 0
		
		frmremlo= conectar_db(_screen.cn)
			SQLEXEC(frmremlo,"select CONCAT('   ',CAST(rem_pto as char)),CONCAT(' ',CAST(rem_nro as char)),rem_fech,rem_codi,prov_codi from remitos where prov_codi=?codiprov order by rem_fech desc;","cur_rl") 
		desconectar_db(frmremlo)
		
		IF RECCOUNT("cur_rl")>0
			thisform.lst_remlo.RowSource = "cur_rl"
			thisform.lst_remlo.Selected(1)=.T.
			thisform.command2.Enabled=.T.
			thisform.CargarDetalleRemito()
		ELSE
			thisform.lst_remlo.RowSource = ""
			thisform.command2.Enabled=.F.
		ENDIF
	ENDPROC

	PROCEDURE Command1.Click
		local paso
		paso=0
		thisform.grid1.rows=1
		do form provload with codiprov
		WITH thisform
			.text1.value=cur_prov.prov_nomb
			.text2.value=cur_prov.prov_domi
			.text6.value=cur_prov.cond_desc
			.text12.value=cur_prov.prov_cuit
			.text3.value=cur_prov.cp_nro
			.text4.value=cur_prov.loca_nomb
			.text5.value=cur_prov.provi_nomb
			frmremlo= conectar_db(_screen.cn)
				SQLEXEC(frmremlo,"select CONCAT('  ',CAST(rem_pto AS CHAR)),CONCAT('  ',CAST(rem_nro AS CHAR)),rem_fech,rem_codi,prov_codi from remitos where prov_codi=?codiprov order by rem_fech desc;","cur_rl")
			desconectar_db(frmremlo)
			IF RECCOUNT()>0
				thisform.lst_remlo.RowSource="cur_rl"
				codirem=cur_rl.rem_codi
				frmremlo= conectar_db(_screen.cn)
					SQLEXEC(frmremlo,"select a.art_codi,b.art_desc,a.artrem_dasc,a.artrem_ddesc,a.dac_codi from remitos_articulos as a inner join articulos as b on a.art_codi=b.art_codi where rem_codi=?codirem;","cur_remalo")
				desconectar_db(frmremlo)
				GO top
				IF RECCOUNT()>0
					SCAN
						cadena=repl("0",8-len(allt(str(cur_remalo.art_codi))))+allt(str(cur_remalo.art_codi))
						if cur_remalo.art_codi=4 OR cur_remalo.art_codi=5
							thisform.grid1.additem(cadena+chr(9)+ALLTRIM(cur_remalo.artrem_dasc))
						ELSE
							thisform.grid1.additem(cadena+chr(9)+ALLTRIM(cur_remalo.art_desc))
							if LEN(ALLTRIM(cur_remalo.artrem_ddesc))>0
								thisform.grid1.col=1
								thisform.grid1.row=thisform.grid1.rows-1
								thisform.grid1.text=cur_remalo.artrem_ddesc
							endif
						endif
						with thisform
							.grid1.row=.grid1.rows-1
							.grid1.col=1
							if len(allt(.grid1.text))>47
								div=len(allt(.grid1.text))/47
								if div>int(div)
									longdes=int(div)+1
								else
									longdes=div
								endif
								longdes=longdes*250
								.grid1.rowheight(.grid1.row)=longdes
							else
								.grid1.rowheight(.grid1.row)=270
							endif
							.grid1.col=0
							.grid1.cellalignment=3
							.grid1.col=1
							.grid1.cellalignment=0
						endwith		
					ENDSCAN
				endif
				thisform.lst_remlo.Selected(1)=.T.
				thisform.command2.enabled=.T.
				thisform.lst_remlo.SetFocus
			ENDIF	
		ENDWITH
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command2.Click
		codirem=cur_rl.rem_codi
		do form consremito with codirem
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command4.Click
		LOCAL frmpe, lcNombre
		
		codigo = 0
		lcNombre = ""
		
		DO FORM artload WITH codigo
		
		IF codigo>0
			thisform.xArtFiltro = codigo
			thisform.text7.Value = codigo
		
			frmfa = conectar_db(_screen.cn)
			SQLEXEC(frmfa,"select art_desc from articulos where art_codi=?codigo;","cur_artbus")
			desconectar_db(frmfa)
		
			IF USED("cur_artbus") AND RECCOUNT("cur_artbus")>0
				thisform.label8.Caption = ALLTRIM(cur_artbus.art_desc)
			ELSE
				thisform.label8.Caption = ""
			ENDIF
		
			thisform.BuscarRemitosPorArticulo(codigo)
		ENDIF
	ENDPROC

	PROCEDURE Command4.GotFocus
		RETURN
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE lst_remlo.Click
		thisform.CargarDetalleRemito()
	ENDPROC

	PROCEDURE Text7.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text7.InteractiveChange
		LOCAL lccadena
		lccadena = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lccadena) OR lccadena="0"
			thisform.RecargarRemitosProveedor()
		ENDIF
	ENDPROC

	PROCEDURE Text7.LostFocus
		RETURN
	ENDPROC

	PROCEDURE Text7.Valid
		LOCAL lncodigoart, lccadena, frmpedlo
		
		lccadena = ALLTRIM(TRANSFORM(THIS.Value))
		
		IF EMPTY(lccadena) OR lccadena="0"
			thisform.RecargarRemitosProveedor()
			RETURN .T.
		ENDIF
		
		lncodigoart = VAL(lccadena)
		
		IF lncodigoart<=0
			thisform.xArtFiltro = 0
			thisform.label8.Caption = ""
			RETURN .T.
		ENDIF
		
		frmremlo = conectar_db(_screen.cn)
		SQLEXEC(frmremlo,"select art_desc from articulos where art_codi=?lncodigoart;","cur_artbus")
		desconectar_db(frmremlo)
		
		IF USED("cur_artbus") AND RECCOUNT("cur_artbus")>0
			thisform.xArtFiltro = lncodigoart
			thisform.label8.Caption = ALLTRIM(cur_artbus.art_desc)
			thisform.BuscarRemitosPorArticulo(lncodigoart)
		ELSE
			thisform.xArtFiltro = 0
			thisform.label8.Caption = ""
			MESSAGEBOX("No existe un artículo con ese código.",48,"Aviso")
		ENDIF
		
		RETURN .T.
	ENDPROC

ENDDEFINE

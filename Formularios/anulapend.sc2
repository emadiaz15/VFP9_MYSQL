	PROCEDURE colorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = .T.
					lnColor = RGB(0,120,215)
				CASE tnsel = .F.
					lnColor = RGB(255,255,255)
			ENDCASE
		Return(lnColor)
		
		
	ENDPROC

	PROCEDURE colorletra
		LParameters tnsel
		
		Local ltColor
		
		if tnsel = .T.
			ltColor = RGB(255,255,255)
		ELSE
			ltColor = RGB(0,0,0)
		ENDIF
		
		Return(ltColor)
	ENDPROC

	PROCEDURE Init
		parameter codp, xesta
		
		IF xesta = 4
			=MESSAGEBOX("Este pedido tiene cantidades entregadas SIN FACTURAR. Se anularán el resto de los pendientes.",48,"Aviso del Sistema")
		ENDIF
		
		thisform.xcodpe = codp
		
		SET DECIMALS TO 3
		frmanulapen= conectar_db(_screen.cn)
			SQLEXEC(frmanulapen,"select moneda,cotiz_dolar from pedidos where ped_codi = ?codp;","cur_datp")
			SQLEXEC(frmanulapen,"call usp_consped(?codp,?cur_datp.cotiz_dolar,?cur_datp.moneda,2);","cur_pp")
		desconectar_db(frmanulapen)
		SET DECIMALS TO
		
		IF RECCOUNT("cur_pp") > 0
			SELECT .F. selart,item,artped_cant,0.000 cananu,art_codi,art_med,art_desc,artped_codi FROM cur_pp WHERE artped_cant>0 INTO CURSOR cur_anula READWRITE
		ENDIF
		
		GO TOP IN cur_anula
		thisform.grd_itped.RecordSource="cur_anula"
		thisform.grd_itped.column7.ControlSource="(art_desc)"
		thisform.grd_itped.SetAll("DynamicBackColor","Thisform.Colorfila(cur_anula.selart)","Column")
		thisform.grd_itped.SetAll("DynamicForeColor","Thisform.Colorletra(cur_anula.selart)","Column")
		thisform.grd_itped.COLUMN1.DynamicBackColor='RGB(144,238,144)'
		
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL nada,arpc,xcant,xarti
		STORE 0 TO nada,arpc,xcant
		
		SELECT COUNT(*) FROM cur_anula WHERE cananu = artped_cant INTO ARRAY ar_cananu
		
		DO case
			CASE ar_cananu[1,1] = RECCOUNT("cur_anula")
				mes = "¿Confirma la anulación del total de los pendientes?"
			CASE ar_cananu[1,1] > 0 AND ar_cananu[1,1] < RECCOUNT("cur_anula")
				mes = "¿Confirma la anulación de los pendientes indicados?"
			CASE ar_cananu[1,1] = 0
				SELECT COUNT(*) FROM cur_anula WHERE cananu > 0 AND cananu < artped_cant INTO ARRAY ar_anupar
				IF ar_anupar[1,1] > 0
					mes = "¿Confirma la anulación de los pendientes indicados?"
				ELSE
					mes = "¿Confirma salir sin anular pendientes?"
					nada = 1
				ENDIF
		ENDCASE
		anu = MESSAGEBOX(mes,4+48,"Aviso del Sistema")
		
		IF anu = 6
			IF nada = 1
				thisform.Release
			ELSE
				SELECT cur_anula
				LOCATE
				SCAN
					xarti = cur_anula.art_codi
					arpc  = cur_anula.artped_codi
					xcant = cur_anula.cananu
					frmanulapen= conectar_db(_screen.cn)
						SQLEXEC(frmanulapen,"update pedidos_articulos set artped_ent = artped_ent + ?xcant where artped_codi = ?arpc;")
		*!*					IF xarti > 5
		*!*						SQLEXEC(frmanulapen,"update articulos set pedidos = pedidos - ?xcant where art_codi = ?xarti;")
		*!*					ENDIF
					desconectar_db(frmanulapen)
					IF xarti > 5
						Campo_ped(xarti)
					ENDIF
				ENDSCAN
				DO cumplido WITH thisform.xcodpe
				MESSAGEBOX("Los pendientes se anularon correctamente. Actualice la planilla de pedidos para que los cambios tengan efecto",64,"Aviso del Sistema")
				thisform.Release
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command1.OLEDrag
		LPARAMETERS lDetectDrag
		*!*	this.command1.enabled=.T.
	ENDPROC

	PROCEDURE Command2.Click
		thisform.grd_itped.RecordSource=""
		thisform.grd_itped.Refresh()
		DO case
			CASE thisform.estadosel=0
				UPDATE cur_anula SET selart=.T.
				UPDATE cur_anula SET cananu = artped_cant
				GO TOP IN cur_anula
				thisform.grd_itped.RecordSource="cur_anula"		
				this.Caption="\<Deshacer"
				thisform.estadosel=1
			CASE thisform.estadosel=1
				UPDATE cur_anula SET selart=.F.
				UPDATE cur_anula SET cananu = 0
				GO TOP IN cur_anula
				thisform.grd_itped.RecordSource="cur_anula"
				this.Caption="A\<nular Todos"
				thisform.estadosel=0
		ENDCASE
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE grd_itped.Column1.Check1.Click
		LOCAL ubireg,arpc
		*!*	cantsel,
		*!*	cantsel=0
		ubireg=0
		
		*!*	SELECT cur_anula
		ubireg=RECNO()
		arpc = artped_codi
		IF this.Value = .T.
			UPDATE cur_anula SET cananu = artped_cant WHERE artped_codi = arpc
			GO ubireg
		ELSE
			UPDATE cur_anula SET cananu = 0 WHERE artped_codi = arpc
			GO ubireg
		ENDIF
		*!*	ubireg=RECNO()
		*!*	LOCATE
		*!*	COUNT ALL FOR selart=.T. TO cantsel
		*!*	GO ubireg
		
		SELECT COUNT(*) FROM cur_anula WHERE selart=.T. INTO ARRAY cantsel
		
		IF cantsel[1,1]=RECCOUNT("cur_anula")
			thisform.command2.Caption="\<Deshacer"
		*!*		thisform.command1.enabled=.T.
			thisform.estadosel=1
		ELSE
			thisform.command2.Caption="A\<nular Todos"
		*!*		thisform.command1.enabled=.F.
			thisform.estadosel=0
		ENDIF
	ENDPROC

	PROCEDURE grd_itped.COLUMN4.Text1.Click
		this.SetFocus
	ENDPROC

	PROCEDURE grd_itped.COLUMN4.Text1.Valid
		LOCAL arpc
		arpc = cur_anula.artped_codi
		IF cur_anula.selart=.F.
			IF this.Value > cur_anula.artped_cant
				this.Value = cur_anula.artped_cant
				UPDATE cur_anula SET selart = .T. WHERE artped_codi = arpc
			ENDIF
		ELSE
			IF this.Value < cur_anula.artped_cant
				UPDATE cur_anula SET selart = .F. WHERE artped_codi = arpc
			ENDIF
		ENDIF
		
		
	ENDPROC

ENDDEFINE


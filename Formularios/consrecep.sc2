	PROCEDURE Activate
		*!*	if localiz=1 and item>0
		*!*		with thisform
		*!*			.text8.value=str(acu,10,2)
		*!*			.text17.value=str(acu*.text19.value/100,10,2)
		*!*			.text18.value=str(acu-val(.text17.value),10,2)
		*!*			.text24.value=str(val(.text18.value)*.text25.value/100,10,2)
		*!*			if cond=2
		*!*				.text9.value=iif(recepciones.recep_conc="D",str(recepciones.ivand,10,2),iif(recepciones.recep_conc="N",str(recepciones.ivanc,10,2),str(val(.text18.value)*impiva1/100,10,2)))
		*!*			endif
		*!*			if .text16.value>0
		*!*				.text15.value=val(str((val(.text18.value)*.text16.value)/100,10,2))
		*!*				.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+val(.text11.value),10,2)
		*!*			else
		*!*				.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+val(.text11.value),10,2)
		*!*			endif
		*!*			if .text21.value>0
		*!*				.text20.value=val(str((val(.text18.value)*.text21.value)/100,10,2))
		*!*				.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+.text20.value+val(.text11.value),10,2)
		*!*			else
		*!*				.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+val(.text11.value),10,2)
		*!*			endif			
		*!*		endwith
		*!*	*!*		thisform.grid1.toprow=item
		*!*	endif
		*!*	store 0 to localiz,muestro
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 7 of Consultas .F.
		localiz=0
		nitem=0
		on key label INS
	ENDPROC

	PROCEDURE Init
		parameter codr,xcond
		thisform.xcond=xcond
		public elimi,aux,descrip,muestro,insertar,observ,cantreg, ;
		       impiva1,impiva2,codiva,opcion,dato1,dato2,dato3,dato4,cant,descri, ;
			   pruni,prtot,opcion,borra,alternati,localiz,ivaant,ivaact,iva,codiprov,dato1, ;
			   totalaux,descuentoxpago,nitem,haydescuento,haycargo,porcdto,porccar, ;
			   filaux,incremento,auxiva,dife,paso
		set deleted on
		set date british
		set cent on
		observ=" "
		STORE 0 TO paso,thisform.acu,elimi,aux,insertar,cantreg,borra,codigo,codiprov, ;
			       porcdto,porccar,filaux,incremento,auxiva,dife
		descrip=""
		prtot=""
		pruni=""
		alternati="N"
		haydescuento="N"
		haycargo="N"
		if pasrecep=1
			this.command3.visible=.F.
		ENDIF
		
		frmcrecep= conectar_db(_screen.cn)
			SQLEXEC(frmcrecep,"select a.*,b.iva_1,b.iva_2 from recepciones as a inner join iva as b on a.iva_codi=b.iva_codi where a.iva_codi=b.iva_codi and a.recep_codi=?codr;","cur_recep")
		desconectar_db(frmcrecep)
		
		&& if valorcadena="Notas de Crédito/Notas de Débito"
		DO case
			CASE INLIST(cur_recep.recep_conc,'N','D')
				this.optiongroup1.visible=.T.
				if cur_recep.recep_conc="N"
					this.caption="Consulta de Notas de Crédito de Proveedores"
					this.label5.caption="N.Crédito Nº"
					this.optiongroup1.value=1
				ELSE
					this.caption="Consulta Notas de Débito de Proveedores"
					this.label5.caption="N.Débito Nº"
					this.optiongroup1.value=2
				endif
				this.command3.width=240
				this.command3.left=60
				this.command3.caption="Otra Nota de Crédito/Nota de Débito"
				this.shape4.visible=.F.
				this.label14.visible=.F.
				this.text14.visible=.F.
			CASE cur_recep.recep_conc = 'F'
				this.label5.caption="Factura Nº"
		ENDCASE
		nitem=1
		with thisform
			codiva=cur_recep.iva_codi
			impiva1=cur_recep.iva_1
			impiva2=cur_recep.iva_2
			.label12.caption=allt(str(impiva1,10,2))+"%"
			.label13.caption=allt(str(impiva2,10,2))+"%"
			.text1.value=cur_prov.prov_nomb
			.text2.value=cur_prov.prov_domi
			.text3.value=cur_prov.cp_nro
			.text4.value=cur_prov.loca_nomb
			.text5.value=cur_prov.provi_nomb
			.text6.value=cur_prov.cond_desc
			.text12.value=SUBSTR(ALLTRIM(cur_prov.prov_cuit),1,2)+"-"+SUBSTR(ALLTRIM(cur_prov.prov_cuit),3,8)+"-"+SUBSTR(ALLTRIM(cur_prov.prov_cuit),11,1)
			.text26.value="0"+allt(cur_prov.prov_cartel)+"-"+allt(cur_prov.prov_tel1)
			IF cur_prov.percepcion="S"
				.label18.enabled=.T.
				.label19.enabled=.T.
				.text15.enabled=.T.
				.text20.enabled=.T.
				.text16.enabled=.T.
				.text21.enabled=.T.
		*!*			.text16.value=cur_recep.perc_iva
		*!*			.text21.value=cur_recep.perc_btos
			else
				.label18.enabled=.F.
				.label19.enabled=.F.
				.text15.enabled=.F.
				.text20.enabled=.F.
				.text16.enabled=.F.
				.text21.enabled=.F.
				.text16.value=0
				.text21.value=0
			endif
			.text13.value=cur_recep.recep_fec
			.text7.value=repl("0",4-len(allt(str(cur_recep.prov_pto))))+allt(str(cur_recep.prov_pto))+"-"+ ;
						 repl("0",8-len(allt(str(cur_recep.prov_fac))))+allt(str(cur_recep.prov_fac))
			.text22.value=cur_recep.prov_tipfac
			.text14.value=cur_recep.prov_rto
			.text19.value=cur_recep.recep_dto
			.edit1.value=cur_recep.recep_obser
			.text23.value=cur_recep.cotiz_dolar
		*!*			.text25.value=round((recepciones.recep_impng/recepciones.recep_tot)*100,3)
			.text15.value=0
			.text20.value=0
			codiprov=cur_recep.prov_codi
			if cur_prov.dtoxpago>0
				descuentoxpago=cur_prov.dtoxpago
			else
				descuentoxpago=0
			endif
			con=0
			SET DECIMALS TO 4
			frmcrecep= conectar_db(_screen.cn)
				SQLEXEC(frmcrecep,"select a.*,b.art_desc,b.art_med,b.art_alicuota from recepciones_articulos a inner join articulos b on a.art_codi=b.art_codi where a.recep_codi=?codr;","cur_recart")
			desconectar_db(frmcrecep)
			SET DECIMALS TO
			GO TOP IN cur_recart
			SCAN
				do case
					case cur_recart.concepto="D"
						.grid1.additem(" "+chr(9)+" "+chr(9)+"DTO"+chr(9)+" "+chr(9)+allt(cur_recart.artrecep_dasc)+chr(9)+allt(str(cur_recart.artrecep_prec,15,4))+"%")
						.grid1.col=6
						.grid1.row=.grid1.rows-1
		      			.grid1.text="-"+allt(str(thisform.acu*cur_recart.artrecep_prec/100,10,2))
						thisform.acu=thisform.acu+ConverNro(.grid1.text)
						haydescuento="S"
					case cur_recart.concepto="C"
						.grid1.additem(" "+chr(9)+" "+chr(9)+"CARGO"+chr(9)+" "+chr(9)+allt(cur_recart.artrecep_dasc)+chr(9)+allt(str(cur_recart.artrecep_prec,15,4))+"%")
						.grid1.col=6
						.grid1.row=.grid1.rows-1
		      			.grid1.text=allt(str(thisform.acu*cur_recart.artrecep_prec/100,10,2))
						thisform.acu=thisform.acu+ConverNro(.grid1.text)
						fila=.grid1.rows-1
						haycargo="S"
						on key label INS do advertencia with fila
					other case
						cadena=repl("0",8-len(allt(str(cur_recart.art_codi))))+allt(str(cur_recart.art_codi))
						.grid1.additem(allt(str(nitem))+chr(9)+allt(str(cur_recart.artrecep_cant,10,3))+chr(9)+allt(cur_recart.art_med)+chr(9)+cadena+chr(9)+ ;
									   allt(cur_recart.art_desc)+chr(9)+allt(str(cur_recart.artrecep_prec,15,4))+chr(9)+allt(str(cur_recart.artrecep_cant*cur_recart.artrecep_prec,10,2))+chr(9)+ ;
									   ""+chr(9)+ALLTRIM(STR(cur_recart.orden_codi))+chr(9)+allt(cur_recart.recep_sstock))
						.grid1.row=.grid1.rows-1
						if cur_recart.art_codi=4 or cur_recart.art_codi=5
							.grid1.col=4
							.grid1.row=nitem
							.grid1.text=ALLTRIM(cur_recart.artrecep_dasc)
						endif
						.grid1.col=7
						do case
							case cur_recart.art_alicuota=1
								.grid1.text=allt(str(impiva1,10,2))
							case cur_recart.art_alicuota=2
								.grid1.text=allt(str(impiva2,10,2))
						ENDCASE
						IF cur_recart.dap_codi>0
							.grid1.col=4
							.grid1.row=nitem
							frmcrecep= conectar_db(_screen.cn)
								SQLEXEC(frmcrecep,"select * from desc_articulos_proveedores where dap_codi=?cur_recart.dap_codi;","cur_dap")
							desconectar_db(frmcrecep)
							.grid1.text=ALLTRIM(cur_dap.dap_desc)
						ENDIF
						if cur_recart.recep_sstock="S"
							con=con+1
						endif
						thisform.acu=thisform.acu+(cur_recart.artrecep_cant*cur_recart.artrecep_prec)
						nitem=nitem+1
				ENDCASE
		 		.grid1.row=.grid1.rows-1
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*250
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				ENDIF		
				this.grid1.row=this.grid1.rows-1
				this.grid1.col=0
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=1
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=6
				this.grid1.col=2
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=3
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=3
				this.grid1.col=4
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=0
				this.grid1.col=5
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				this.grid1.col=6
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				prtot=allt(this.grid1.text)
				this.grid1.col=7
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				this.grid1.col=8
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
				this.grid1.col=9
				this.grid1.cellfontname="Courier New"
				this.grid1.cellfontsize=8
				this.grid1.cellalignment=8
			ENDSCAN
		endwith
		if nitem>1
			nitem=nitem-1
		endif
		with thisform
			.text8.value=iif(cur_recep.recep_dto>0,((cur_recep.neto_1+cur_recep.neto_2)/((100-cur_recep.recep_dto)/100)),cur_recep.neto_1+cur_recep.neto_2)+IIF(thisform.xcond=1,cur_recep.recep_ivari+cur_recep.recep_ivarni,0)
			.text17.value=iif(cur_recep.recep_dto>0,(.text8.value-(cur_recep.neto_1+cur_recep.neto_2+IIF(thisform.xcond=1,cur_recep.recep_ivari+cur_recep.recep_ivarni,0))),0)
			.text18.value=.text8.value-.text17.value
			.text24.value=cur_recep.recep_impng
			if thisform.xcond=2
				.text9.value=cur_recep.recep_ivari
				.text11.value=cur_recep.recep_ivarni
			else
				.text9.value=0
				.text11.value=0
			ENDIF
			.text16.value=IIF(.text18.value>0,(cur_recep.perc_iva/.text18.value)*100,0)
			.text15.value=cur_recep.perc_iva
			.text21.value=IIF(.text18.value>0,(cur_recep.perc_btos/.text18.value)*100,0)
			.text20.value=cur_recep.perc_btos
			.text10.value=.text18.value+.text24.value+.text9.value+.text11.value+.text15.value+.text20.value
		endwith
		
	ENDPROC

	PROCEDURE Load
		set skip of bar 7 of Consulta .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if valorcadena<>"Mercadería Recibida"
		*!*		set skip of bar 7 of Consultas .F.
		*!*		thisform.hide
		*!*		localiz=0
		*!*		nitem=0
		*!*	endif
	ENDPROC

	PROCEDURE Btn_money1.Image1.Click
		LOCAL textrec
		
		IF valorcadena="Notas de Crédito/Notas de Débito"
			DO case
				CASE thisform.optiongroup1.Value=1
					textrec="DE LA NOTA DE CRÉDITO"
				CASE thisform.optiongroup1.Value=2
					textrec="DE LA NOTA DE DÉBITO"
			ENDCASE
		ELSE
			textrec="DE LA RECEPCIÓN"
		ENDIF
		
		frmcrecep= conectar_db(_screen.cn)
			SQLEXEC(frmcrecep,"select * from histocoti where hiscot_fecha=?thisform.text13.value order by hiscot_fecha desc limit 1;","cur_cotdia")
			IF RECCOUNT("cur_cotdia")>0
				MESSAGEBOX("   DOLAR VIGENTE AL DÍA "+textrec+CHR(13)+CHR(13)+ ;
						   "U$S 1 = $ "+ALLTRIM(STR(cur_cotdia.hiscot_impo,14,2))+" - ACTUALIZ: "+ALLTRIM(TTOC(hiscot_fecha)),0+64,"COTIZACIONES MONEDA DOLAR")
			ELSE
				SQLEXEC(frmcrecep,"select * from histocoti where hiscot_fecha<?thisform.text13.value order by hiscot_fecha desc limit 1;","cur_cotant")
				IF RECCOUNT("cur_cotant")>0
					MESSAGEBOX("   DOLAR VIGENTE AL DÍA "+textrec+CHR(13)+CHR(13)+ ;
							   "U$S 1 = $ "+ALLTRIM(STR(cur_cotant.hiscot_impo,14,2))+" - ACTUALIZ: "+ALLTRIM(TTOC(hiscot_fecha)),0+64,"COTIZACIONES MONEDA DOLAR")
				ENDIF
			ENDIF
		desconectar_db(frmcrecep)
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command3.Click
		proveedor=cur_prov.prov_nomb
		codiprov=cur_prov.prov_codi
		do form recepload with proveedor,codiprov
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Text13.GotFocus
		codigo=0
		opcion=0
		*!*	on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		if localiz=1
			if elimi=0
				thisform.grid1.toprow=nitem
			else
				elimi=0
			endif
		endif
	ENDPROC

	PROCEDURE Text14.Valid
		sele recepciones
		set order to recep_codi
		seek codr
		if found()
			if this.value<>prov_rto
				factura=messagebox("Seguro que desea modificar el Número de Remito, por favor verifique con sumo cuidado",4+48+256,"Advertencia")
				if factura=7
					this.value=prov_rto
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Text22.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text23.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text27.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.Valid
		sele recepciones
		set order to facprov
		seek str(codiprov)+str(this.value)
		if found()
			messagebox("La factura Nº: "+allt(str(this.value))+" de "+allt(proveedores.prov_nomb)+" ya esta en archivo. No puede ingresar mas de una vez las facturas de los proveedores, duplicaría stock inexistente",0+48,"Advertencia")
			this.value=0
			return 0
		endif
	ENDPROC

ENDDEFINE


		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE colorfila
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(237,243,253)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Init
		public proveedor,codiprov
		
		proveedor=""
		codiprov=0
		codigo=0
		histcod=0
		do form provload with proveedor,codiprov
		thisform.codiprov=codiprov
		thisform.banner.Height=72
		if thisform.codiprov>0
			thisform.txt_prov.value=cur_prov.prov_nomb
			SET DECIMALS TO 3
			frmhis= conectar_db(_screen.cn)
				SQLEXEC(frmhis,"select a.art_codi,b.art_desc,a.artpro_costo,a.artpro_ctovta,a.moneda,a.artpro_codi from articulos_proveedores a inner join articulos b on a.art_codi=b.art_codi where a.prov_codi=?thisform.codiprov and a.art_codi>5 order by a.art_codi;","cur_cosprov")
			desconectar_db(frmhis)
			SET DECIMALS TO
			
			IF RECCOUNT("cur_cosprov")>0
				GO TOP IN cur_cosprov
				thisform.grd_costos.RecordSource="cur_cosprov"
				thisform.grd_costos.SetAll("DynamicBackColor","thisform.colorfila(RECNO())","Column")
				thisform.grd_costos.Refresh()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE btn_salir.Click
		prsal= MESSAGEBOX("¿Confirma salir sin actualizar los históricos de los costos?",4+48+256,"Aviso del Sistema")
		
		IF prsal=6
			thisform.release
		ENDIF
		
	ENDPROC

	PROCEDURE btn_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE btn_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command3.Click
		pract= MESSAGEBOX("¿Confirma actualizar los históricos de los costos al día de hoy?",4+48+256,"Aviso del Sistema")
		
		IF pract=6
			LOCAL xfecha,cto,ctov,arpc,xmon,lnCantidadDatos,lnI,lnPorcentaje,lnLock,lnLock2,conexterna
			lnLock = 0
			lnI=1
			lnCantidadDatos=RECCOUNT("cur_cosprov")
			
			SELECT cur_cosprov
			LOCATE
			thisform.progreso.Visible= .T.
			FOR lnI = 1 TO lnCantidadDatos
				xfecha=DATETIME()
				cto  =cur_cosprov.artpro_costo
				ctov =cur_cosprov.artpro_ctovta
				arpc =cur_cosprov.artpro_codi
				xmon =cur_cosprov.moneda
				frmhis= conectar_db(_screen.cn)
					lnLock = MySQL_LockTables("LOCK", "histocosto WRITE", frmhis)
					SQLEXEC(frmhis,"select CAST(histo_codi+1 as decimal(8,0)) as histo_codi from histocosto order by histo_codi desc limit 1;","cur_hisnvo")
					SQLEXEC(frmhis,"insert into histocosto values(?cur_hisnvo.histo_codi,?xfecha,?cto,?ctov,?arpc,?xmon);")
					lnLock = MySQL_LockTables("UNLOCK", "", frmhis)
				desconectar_db(frmhis)
				******************** SE CONECTA AL SERVIDOR ILUMET Y ACTUALIZA HISTORICO *******************************
				conexterna = conectar_db(_screen.xconext)
				lnLock2 = 0
				IF VARTYPE(conexterna)="N" AND conexterna>0
					lnLock2 = MySQL_LockTables("LOCK", "histocosto WRITE", conexterna)
					SQLEXEC(conexterna,"select CAST(histo_codi+1 as decimal(8,0)) as histo_codi from histocosto order by histo_codi desc limit 1;","cur_hisnvo2")
					SQLEXEC(conexterna,"insert into histocosto values(?cur_hisnvo2.histo_codi,?xfecha,?cto,?ctov,?arpc,?xmon);")
					lnLock2 = MySQL_LockTables("UNLOCK", "", conexterna)
					desconectar_db(conexterna)
				ENDIF
				********************* FIN PROCESO SERVIDOR ILUMET *********************************			
				lnPorcentaje             = lnI * 100 / lnCantidadDatos
			    ThisForm.Progreso.Value = lnPorcentaje
			    SELECT cur_cosprov
			    skip
			ENDFOR
			MESSAGEBOX("Los históricos de costos fueron actualizados correctamente al día de hoy",64,"Aviso del Sistema")
			thisform.Release
		ENDIF
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

ENDDEFINE

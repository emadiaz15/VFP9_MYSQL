	PROCEDURE Activate
		if codiprov=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE Init
		public codiprov,proveedor,i,filas,articulo,compra
		codiprov=0
		proveedor=" "
		filas=0
		articulo=0
		compra=0
		descri=""
		auxprompt=''
		do form provload with proveedor,codiprov
		if codiprov>0
			menusel=ALLTRIM(valorcadena)
			this.caption="Recepción por Ordenes de Compra de "+ALLTRIM(cur_prov.prov_nomb)
			frmitrec= conectar_db(_screen.cn)
				SQLEXEC(frmitrec,"select orden_codi,orden_fech from compras where prov_codi=?codiprov and cumplido<>'S' and anulado<>'S' order by orden_fech;","tempc")
			desconectar_db(frmitrec)
			IF RECCOUNT("tempc")>0
				i=1
				scan
					thisform.list1.addlistitem(str(tempc.orden_codi),i,1)
					thisform.list1.addlistitem(dtoc(tempc.orden_fech),i,2)
					i=i+1
				ENDSCAN
			ELSE
				menusel=''
			ENDIF
		ELSE
			thisform.release
		endif
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.Click
		do form altarecep with cond,codiprov
		thisform.hide
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command1.OLEDrag
		LPARAMETERS lDetectDrag
		this.command1.enabled=.T.
	ENDPROC

	PROCEDURE Command2.Click
		do while thisform.list2.listcount>0
			thisform.lstorden.addlistitem(thisform.list2.list(1,1),thisform.lstorden.listcount+1,1)
			thisform.lstorden.addlistitem(thisform.list2.list(1,2),thisform.lstorden.listcount,2)
			SELECT cur_cpl
			GO top
			LOCATE FOR cur_cpl.artord_codi=val(thisform.list2.list(1,5))
			IF cur_cpl.art_codi>5
				thisform.lstorden.addlistitem(cur_cpl.art_med,thisform.lstorden.listcount,3)
			endif
			thisform.lstorden.addlistitem(allt(thisform.list2.list(1,3)),thisform.lstorden.listcount,4)
			thisform.lstorden.addlistitem(thisform.list2.list(1,4),thisform.lstorden.listcount,5)
			thisform.lstorden.addlistitem(str(cur_cpl.orden_codi),thisform.lstorden.listcount,6)
			thisform.lstorden.addlistitem(str(cur_cpl.artord_codi),thisform.lstorden.listcount,7)
			thisform.list2.removeitem(1)
		enddo
		for i=1 to thisform.list1.listcount
			if thisform.list1.selected(i)=.T.
				thisform.list1.selected(i)=.F.
				thisform.list1.removeitem(i)
				exit
			endif
		next
		thisform.command1.enabled=.T.
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		local auxi1,auxi2,con
		local x
		filas=thisform.lstorden.listcount+1
		auxi1=0
		auxi2=0
		for i=1 to thisform.list2.listcount
			if thisform.list2.selected(i)=.T.
				if auxi1=0
					auxi1=i
				endif
				thisform.lstorden.addlistitem(thisform.list2.list(i,1),filas,1)
				thisform.lstorden.addlistitem(thisform.list2.list(i,2),filas,2)
				SELECT cur_cpl
				GO top
				LOCATE FOR cur_cpl.artord_codi=val(thisform.list2.list(i,5))
				if cur_cpl.art_codi>5
					thisform.lstorden.addlistitem(cur_cpl.art_med,filas,3)
				ENDIF
				thisform.lstorden.addlistitem(allt(thisform.list2.list(i,3)),filas,4)
				thisform.lstorden.addlistitem(thisform.list2.list(i,4),filas,5)
				thisform.lstorden.addlistitem(str(cur_cpl.orden_codi),filas,6)
				thisform.lstorden.addlistitem(str(cur_cpl.artord_codi),filas,7)
				filas=filas+1
			endif
		next
		auxi2=thisform.list2.listindex
		con=0
		do while con<=(auxi2-auxi1)
			thisform.list2.removeitem(auxi1)
			con=con+1
		enddo
		if thisform.list2.listcount=0
			for i=1 to thisform.list1.listcount
				if thisform.list1.selected(i)
					thisform.list1.removeitem(i)
					thisform.list1.selected(i)=.F.
				endif
			next
		endif
		this.enabled=.F.
		thisform.command1.enabled=.T.
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE List1.Click
		IF this.Selected(this.listindex)=.T.
			local i
			thisform.command3.enabled=.F.
			if thisform.list2.listcount>0
				for i=1 to thisform.list2.listcount
					thisform.list2.removeitem(1)
				next
			ENDIF
			frmitrec= conectar_db(_screen.cn)
				SQLEXEC(frmitrec,"select a.*,b.*,c.orden_fech,c.orden_dto from compras_articulos a inner join articulos b on a.art_codi=b.art_codi inner join compras c on c.orden_codi=a.orden_codi where a.orden_codi=?VAL(this.value);","cur_cpl")
			desconectar_db(frmitrec)
			if RECCOUNT("cur_cpl")>0
				GO top
				i=1
				scan
					if cur_cpl.artord_ent<cur_cpl.artord_cant
						if thisform.lstorden.listcount>0
							for v=1 to thisform.lstorden.listcount
								IF cur_cpl.artord_codi=VAL(thisform.lstorden.list(v,7))
									skip
									loop
								endif
							next
						endif
						if cur_cpl.artord_ent>=cur_cpl.artord_cant
							skip
							loop
						endif
						cadena=repli("0",8-len(allt(str(cur_cpl.art_codi))))+allt(str(cur_cpl.art_codi))
						thisform.list2.addlistitem(cadena, i,1)
						thisform.list2.addlistitem(str(cur_cpl.artord_cant-cur_cpl.artord_ent,10,3), i,2)
						thisform.list2.addlistitem(iif(cur_cpl.art_codi=4 or cur_cpl.art_codi=5,cur_cpl.artord_dasc,cur_cpl.art_desc), i,3)
						thisform.list2.addlistitem(str(cur_cpl.artord_precio,10,3), i,4)
						thisform.list2.AddListItem(STR(cur_cpl.artord_codi), i,5)
					endif
					i=i+1
				endscan
			ENDIF
		endif
	ENDPROC

	PROCEDURE List2.Click
		for f=1 to thisform.list2.listcount
			if thisform.list2.selected(f)
				thisform.command3.enabled=.T.
				exit
			else
				thisform.command3.enabled=.F.
			endif
		next i
	ENDPROC

	PROCEDURE List2.DblClick
		local x
		filas=thisform.lstorden.listcount+1
		thisform.lstorden.addlistitem(this.list(this.listindex,1),filas,1)
		thisform.lstorden.addlistitem(this.list(this.listindex,2),filas,2)
		SELECT cur_cpl
		GO top
		LOCATE FOR cur_cpl.artord_codi=val(this.list(this.listindex,5))
		if cur_cpl.art_codi>5
			thisform.lstorden.addlistitem(cur_cpl.art_med,filas,3)
		endif
		thisform.lstorden.addlistitem(allt(this.list(this.listindex,3)),filas,4)
		thisform.lstorden.addlistitem(this.list(this.listindex,4),filas,5)
		thisform.lstorden.addlistitem(str(cur_cpl.orden_codi),filas,6)
		thisform.lstorden.addlistitem(str(cur_cpl.artord_codi),filas,7)
		this.removeitem(this.listindex)
		if this.listcount=0
			x=thisform.list1.listindex
			for i=1 to thisform.list1.listcount
				if thisform.list1.selected(i)
					thisform.list1.selected(i)=.F.
				endif
			next
			thisform.list1.removeitem(x)
			thisform.command3.enabled=.F.
		endif
		thisform.command3.enabled=.F.
		thisform.command1.enabled=.T.
	ENDPROC

	PROCEDURE List2.MouseDown
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.command3.enabled=.T.
		
	ENDPROC

	PROCEDURE List2.MouseUp
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.command3.enabled=.T.
		
	ENDPROC

	PROCEDURE lstorden.DblClick
		if thisform.list2.listcount>0
			for i=1 to thisform.list2.listcount
				thisform.list2.removeitem(1)
			next
		endif
		articulo=val(this.list(this.listindex,1))
		if articulo=4 or articulo=5
			descri=allt(this.list(this.listindex,4))
		endif
		compra=val(this.list(this.listindex,6))
		SELECT cur_cpl
		GO top
		for i=1 to thisform.list1.listcount
			do case
				case val(thisform.list1.list(i,1))=compra
					thisform.list1.selected(i)=.T.
					exit
				case val(thisform.list1.list(i,1))>compra
					thisform.list1.additem(str(compra),i,1)
					thisform.list1.addlistitem(dtoc(cur_cpl.orden_fech),i,2)
					thisform.list1.selected(i)=.T.
					exit
				case i=thisform.list1.listcount
					thisform.list1.additem(str(cur_cpl.orden_codi),i+1,1)
					thisform.list1.addlistitem(dtoc(cur_cpl.orden_fech),i+1,2)
					thisform.list1.selected(i+1)=.T.
					exit
			endcase
		next
		i=1
		do while cur_cpl.orden_codi=compra and !eof()
			if cur_cpl.artord_ent<cur_cpl.artord_cant
				cadena=repli("0",8-len(allt(str(cur_cpl.art_codi))))+allt(str(cur_cpl.art_codi))
				thisform.list2.addlistitem(cadena, i,1)
				thisform.list2.addlistitem(str(cur_cpl.artord_cant-cur_cpl.artord_ent,10,3), i,2)
				thisform.list2.addlistitem(iif(cur_cpl.art_codi=4 or cur_cpl.art_codi=5,cur_cpl.artord_dasc,cur_cpl.art_desc), i,3)
				thisform.list2.addlistitem(str(cur_cpl.artord_precio,10,3), i,4)
				thisform.list2.addlistitem(str(cur_cpl.artord_codi), i,5)
			endif
			skip
			i=i+1
		enddo
		this.removeitem(this.listindex)
		
	ENDPROC

ENDDEFINE

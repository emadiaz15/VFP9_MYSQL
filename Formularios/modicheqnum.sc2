	PROCEDURE Destroy
		set point to
		set separator to
	ENDPROC

	PROCEDURE Init
		PARAMETERS xnroval, xtipval
		
		public rpgc,sucbcc,codiban,codisuc
		STORE 0 TO rpgc
		
		set point to ","
		set separator to "."
		
		this.cmb_tipo.additem("CHEQUE",1)
		this.cmb_tipo.additem("ECHEQ",2)
		
		IF xtipval>0
			this.xtipo=xtipval
			this.cmb_tipo.Value=IIF(xtipval=1,"CHEQUE","ECHEQ")
			this.cmb_tipo.Enabled= .F.
			DO case
				CASE xtipval=1
					thisform.text1.Format = "R"
					thisform.text1.Value=""
					thisform.text1.InputMask = "999-999-99999999"
					thisform.text5.Value=""
					thisform.text5.Format="R"
					thisform.text5.InputMask = "999-999-99999999"
					thisform.xtipo = 1
		*!*				thisform.text1.Enabled= .T.
		*!*				thisform.text1.SetFocus		
				CASE xtipval=2
					thisform.text1.Value=""
					thisform.text1.Format = ""
					thisform.text1.InputMask = ""
					thisform.text5.Format = ""
					thisform.text5.InputMask = ""		
					thisform.xtipo = 2
					thisform.text11.Enabled= .F.
		*!*				thisform.text1.Enabled= .T.
		*!*				thisform.text1.SetFocus
			ENDCASE
			thisform.lbl_datos.Caption="Datos del "+iif(thisform.xtipo=1,"Cheque ","Echeq ")+"a modificar"
			thisform.lbl_datos.Visible= .T.
			this.text1.Value= ALLTRIM(xnroval)
			thisform.btn_cons.Click()
			thisform.btn_cons.Enabled= .F.
		ENDIF
		
		frmconch= conectar_db(_screen.cn)
			SQLEXEC(frmconch,"select ban_desc,ban_codi from bancos order by ban_desc;","cur_bce")
		desconectar_db(frmconch)
		IF RECCOUNT("cur_bce")>0
			LOCATE
			thisform.lstincremental1.pcursor="cur_bce"
			thisform.lstincremental1.pcampo="ban_desc"
			thisform.lstincremental1.pcampo2="ban_codi"
		ENDIF
	ENDPROC

	PROCEDURE btn_cons.Click
		LOCAL xcadecheq,chnro,xcheqid,xcadeid,xrpc
		xrpc=0
		xcheqid='0001'
		
		if len(ALLTRIM(thisform.text1.value))>0
			LOCAL xtip
			xtip = IIF(thisform.xtipo=1,3,20)
			chnro=ALLTRIM(thisform.text1.value)
			xcadecheq=allt(subst(chnro,1,3))+allt(subst(chnro,4,3))
			frmconch= conectar_db(_screen.cn)
				DO case
					CASE xtip = 3
						SQLEXEC(frmconch,"select a.*,b.ban_desc,b.ban_cuit from recibos_pagos a inner join bancos b on a.ban_codi=b.ban_codi where TRIM(a.chequenro)=?ALLTRIM(chnro) and tippag_codi = 3;","cur_cheq")
					CASE xtip = 20
						SQLEXEC(frmconch,"select a.*,b.ban_desc,b.ban_cuit from recibos_pagos a inner join bancos b on a.ban_codi=b.ban_codi where TRIM(a.movtippag_nro)=?ALLTRIM(chnro) and a.tippag_codi = 20;","cur_cheq")
				ENDCASE
			desconectar_db(frmconch)
			if RECCOUNT("cur_cheq")>0
				thisform.nroant  =chnro
				thisform.bcoant  =cur_cheq.ban_codi
				thisform.sucuant =cur_cheq.suc_codi
				thisform.cuitant =VAL(cur_cheq.cuit_lib)
				thisform.fecant  =cur_cheq.movtippag_fvto
				IF RECCOUNT("cur_cheq")>1
					DO form consmascheq WITH chnro,xcheqid,xtip to varret
					xcheqid=IIF(thisform.xtipo=1,varret.prop2,'0001')
					xcadeid=chnro+xcheqid
					xrpc=varret.Prop3
					frmconch= conectar_db(_screen.cn)
						SQLEXEC(frmconch,"select a.*,b.ban_desc,b.ban_cuit from recibos_pagos a inner join bancos b on a.ban_codi=b.ban_codi where a.recpag_codi=?xrpc;","cur_cheq")
					desconectar_db(frmconch)
				ENDIF
				IF LEN(ALLTRIM(xcheqid))=0
					thisform.SetAll("Value",'',"Textbox")
					thisform.text1.SetFocus
				ELSE
					frmconch= conectar_db(_screen.cn)
						SQLEXEC(frmconch,"select a.rec_tipo,a.rec_nro,a.rec_fec,b.cli_nomb,b.cond_codi,a.cli_codi from recibos a inner join clientes b on a.cli_codi=b.cli_codi where rec_codi=?cur_cheq.rec_codi;","recicli")
						SQLEXEC(frmconch,"select a.pag_fech,b.prov_nomb from pagosprov a inner join proveedores b on a.prov_codi=b.prov_codi where pag_codi=?cur_cheq.pag_codi;","cur_pago")
						SQLEXEC(frmconch,"select suc_nomb from sucbancos where TRIM(suc_bansuc)=?xcadecheq;","sucu")
					desconectar_db(frmconch)
					with thisform
						rpgc=cur_cheq.recpag_codi
						thisform.xcheqact=chnro
						.text5.value=chnro
						.text2.value=allt(cur_cheq.ban_desc)
						.text3.value=cur_cheq.movtippag_imp
						.text4.value=cur_cheq.movtippag_fvto
						.text12.value=VAL(cur_cheq.cuit_lib)
						.text11.value=sucu.suc_nomb
						thisform.codiban=cur_cheq.ban_codi
						thisform.codisuc=cur_cheq.suc_codi
						sucbcc=IIF(thisform.xtipo=1,sucu.suc_nomb,'')
						.cmd_guardar.enabled=.T.
					ENDWITH
				ENDIF
				IF thisform.xtipo=1
					thisform.btn_edit.Visible= .F.
				ELSE
					thisform.btn_edit.Visible= .T.
				ENDIF
			else
				=messagebox("Cheque no se encuentra en archivo",0+48,"Advertencia!!!")
				thisform.SetAll("Value",'',"Textbox")
				thisform.text1.SetFocus
			endif
		endif
	ENDPROC

	PROCEDURE btn_cons.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE btn_cons.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Btn_edit.img_edit.Click
		thisform.codiban=0
		thisform.text2.Visible= .F.
		thisform.Clstextinput1.Visible= .T.
		thisform.cmd_newbank.Visible= .T.
		thisform.clstextinput1.ZOrder(0)
		thisform.cmd_newbank.ZOrder(0)
		thisform.lstincremental1.ZOrder(0)
		thisform.clstextinput1.txtInput.SetFocus
		this.Parent.Visible= .F.
	ENDPROC

	PROCEDURE Clstextinput1.txtInput.InteractiveChange
		n = LEN(ALLTRIM(this.Value))
		IF n >= this.Parent.penterchar
			thisform.lstincremental1.pinput = ALLTRIM(this.Value)
			thisform.lstincremental1.listcursor()
			thisform.lstincremental1.Visible= .T.
			IF USED("crlistincremental")
				IF RECCOUNT("crlistincremental")=0
					thisform.lstincremental1.Visible= .F.
				ENDIF
			ENDIF
		ELSE
			thisform.lstincremental1.Visible   = .F.
			thisform.lstincremental1.RowSource = ""
			IF USED("crlistincremental")
				USE IN crlistincremental
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Clstextinput1.txtInput.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode=13
			IF thisform.codiban=0
				MESSAGEBOX("No se ha podido seleccionar el banco, debe seleccionar alguna opción desde la lista desplegable."+CHR(13)+;
						   "Si no se ha desplegado ninguna opción debe hacer click en el boton de Alta de Nuevo Banco.",48,"Aviso del Sistema")
			ELSE
				this.Parent.Visible= .F.
				thisform.lstincremental1.Visible= .F.
				thisform.cmd_newbank.Visible= .F.
				thisform.btn_edit.Visible= .T.
				thisform.text2.Visible= .T.
				thisform.lbl_confirmar.Visible= .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmb_tipo.Click
		DO case
			CASE this.ListIndex = 1
				thisform.text1.Format = "R"
				thisform.text1.Value=""
				thisform.text1.InputMask = "999-999-99999999"
				thisform.text5.Value=""
				thisform.text5.Format="R"
				thisform.text5.InputMask = "999-999-99999999"
				thisform.xtipo = 1
				thisform.text1.Enabled= .T.
				thisform.text1.SetFocus
			CASE this.ListIndex = 2
				thisform.text1.Value=""
				thisform.text1.Format = ""
				thisform.text1.InputMask = ""
				thisform.text5.Format = ""
				thisform.text5.InputMask = ""		
				thisform.xtipo = 2
				thisform.text11.Enabled= .F.
				thisform.text1.Enabled= .T.
				thisform.text1.SetFocus		
		ENDCASE
		thisform.lbl_datos.Caption="Datos del "+iif(thisform.xtipo=1,"Cheque ","Echeq ")+"a modificar"
		thisform.lbl_datos.Visible= .T.
		
	ENDPROC

	PROCEDURE cmd_guardar.Click
		IF ALLTRIM(thisform.text5.value)=ALLTRIM(thisform.nroant) AND ;
				 thisform.codiban=thisform.bcoant and thisform.codisuc=thisform.sucuant AND ;
				 thisform.text12.Value=thisform.cuitant and thisform.text4.Value=thisform.fecant
			MESSAGEBOX("No se han efectuado cambios",64,"Aviso del Sistema")
		ELSE
			chech=MESSAGEBOX("¿Confirma los cambios efectuados?",4+32,"Aviso del Sistema")
			IF chech=6
				frmconch= conectar_db(_screen.cn)
					SQLEXEC(frmconch,"update recibos_pagos set movtippag_nro=?ALLTRIM(thisform.text5.value) where recpag_codi = ?cur_cheq.recpag_codi;")
					SQLEXEC(frmconch,"update recibos_pagos set chequenro=?ALLTRIM(thisform.text5.value) where recpag_codi = ?cur_cheq.recpag_codi;")
					SQLEXEC(frmconch,"update recibos_pagos set ban_codi=?thisform.codiban where recpag_codi = ?cur_cheq.recpag_codi;")
					SQLEXEC(frmconch,"update recibos_pagos set suc_codi=?thisform.codisuc where recpag_codi = ?cur_cheq.recpag_codi;")
					SQLEXEC(frmconch,"update recibos_pagos set cuit_lib=?thisform.text12.Value where recpag_codi = ?cur_cheq.recpag_codi;")
					SQLEXEC(frmconch,"update recibos_pagos set movtippag_fvto=?thisform.text4.Value where recpag_codi = ?cur_cheq.recpag_codi;")
					SQLEXEC(frmconch,"update recibos_pagos set movtippag_pza=?ALLTRIM(thisform.text11.Value) where recpag_codi = ?cur_cheq.recpag_codi;")
				desconectar_db(frmconch)
				thisform.nroant  =.F.
				thisform.bcoant  =.F.
				thisform.cuitant =.F.
				thisform.fecant  =.F.
				thisform.cmb_tipo.Value=''
				thisform.text1.Value=''
				thisform.text5.Value=''
				thisform.text2.Value=''
				thisform.clstextinput1.txtInput.Value=''
				thisform.text11.Value=''
				thisform.text3.value=''
				thisform.text12.Value=''
				thisform.text4.Value=''
				thisform.btn_edit.Visible= .F.
				thisform.codiban=0
				thisform.codisuc=0
				thisform.cmb_tipo.Value=0
				thisform.cmb_tipo.SetFocus
				MESSAGEBOX("Datos modificados correctamente.",64,"Aviso del Sistema")
				IF thisform.cmb_tipo.Enabled= .F.
					thisform.Release
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmd_guardar.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE cmd_guardar.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE cmd_newbank.Click
		IF thisform.codiban=0
			thisform.clstextinput1.txtInput.Value=''
			thisform.lstincremental1.RowSource=""
			thisform.lstincremental1.Visible= .F.
		ENDIF
		
		codiban=0
		codisuc=0
		do form altabanco with codiban,codisuc,2
		
		IF codiban > 0
			frmdatpag= conectar_db(_screen.cn)
				SQLEXEC(frmdatpag,"select * from bancos where ban_codi = ?codiban;","cur_nvoban")
			desconectar_db(frmdatpag)
			IF RECCOUNT("cur_nvoban")>0
				thisform.clstextinput1.txtInput.Value=cur_nvoban.ban_desc
				thisform.text2.Value=cur_nvoban.ban_desc
				thisform.codiban=cur_nvoban.ban_codi
				thisform.lbl_confirmar.Visible= .T.
				thisform.clstextinput1.txtInput.SetFocus
			ELSE
				thisform.clstextinput1.txtInput.Value=''
				thisform.clstextinput1.txtInput.SetFocus
			ENDIF
		ELSE
			thisform.clstextinput1.txtInput.Value=''
			thisform.clstextinput1.txtInput.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_salir.Click
		thisform.xtipo=0
		thisform.release
	ENDPROC

	PROCEDURE cmd_salir.GotFocus
		thisform.xtipo=0
		thisform.release
	ENDPROC

	PROCEDURE cmd_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE cmd_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Lstincremental1.Click
		IF this.ListCount>0
			IF USED("crlistincremental")
				SELECT crlistincremental
				thisform.clstextinput1.txtInput.Value=crlistincremental.ban_desc
				thisform.text2.Value=crlistincremental.ban_desc
				thisform.codiban = crlistincremental.ban_codi
				this.Visible = .F.
				thisform.clstextinput1.txtInput.SetFocus
				thisform.lbl_confirmar.Visible= .T.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Text1.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE Text12.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text4.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text5.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE Text5.LostFocus
		IF thisform.xtipo = 1
				local texban,texsuc
				IF LEN(ALLT(this.value))<14
					MESSAGEBOX("Número de cheque incorrecto. Verifique bien por favor.",0+48,"Aviso del Sistema")
					RETURN 0
				ELSE
					frmconch= conectar_db(_screen.cn)
						SQLEXEC(frmconch,"select * from recibos_pagos where chequenro=?ALLTRIM(this.value);","cur_ch")
					desconectar_db(frmconch)
						if RECCOUNT("cur_ch")>2
							xcheque=ALLTRIM(this.value)
							DO FORM habiacheq WITH xcheque,xconf TO xvar1
							IF xvar1.prop2='S'
								thisform.ncheqid=RIGHT('0000'+ALLTRIM(STR((RECCOUNT("cur_ch"))+1)),4)
								modifica='S'
							ELSE
								this.Value = ALLTRIM(thisform.nroant)
								RETURN 0
							ENDIF
						ELSE
							modifica='S'
						ENDIF
						LOCAL cadesuc
						cadesuc=allt(subst(this.value,1,3))+allt(subst(this.value,4,3))
						frmconch= conectar_db(_screen.cn)
							SQLEXEC(frmconch,"select a.*,b.ban_desc from sucbancos a inner join bancos b on a.ban_codi=b.ban_codi where suc_bansuc=?cadesuc;","cur_suc")
						desconectar_db(frmconch)
						if RECCOUNT("cur_suc")>0
							thisform.text2.value=cur_suc.ban_desc
							thisform.codiban=cur_suc.ban_codi
							thisform.text11.value=cur_suc.suc_nomb
							thisform.codisuc=cur_suc.suc_codi
						ELSE
							LOCAL codb
							codb=0
							codb=val(subst(allt(this.value),1,3))
							frmconch= conectar_db(_screen.cn)
								SQLEXEC(frmconch,"select * from bancos where ban_codi=?codb;","cur_ban")
							desconectar_db(frmconch)
							if RECCOUNT("cur_ban")>0
								pregunta=messagebox("Sucursal Nº: "+subst(allt(this.value),4,3)+" de "+allt(cur_ban.ban_desc)+" no está en archivo. ¿Ingresa nueva Sucursal?",4+32+256,"Aviso del Sistema")
								if pregunta=6
									LOCAL cadbansuc
									thisform.codiban=cur_ban.ban_codi
									thisform.codisuc=VAL(subst(allt(this.value),4,3))
									do form altasuc with thisform.codiban,thisform.codisuc
									thisform.text2.value=cur_ban.ban_desc
									cadbansuc=allt(str(thisform.codiban))+allt(str(thisform.codisuc))
									frmconch= conectar_db(_screen.cn)
										SQLEXEC(frmconch,"select * from sucbancos where CONCAT(TRIM(CAST(ban_codi as char)),TRIM(CAST(suc_codi as char)))=?cadbansuc;","cur_suc")
									desconectar_db(frmconch)
									thisform.text11.value=allt(cur_suc.suc_nomb)
								else
									RETURN 0
									this.setfocus
								endif
							else
								pregunta=messagebox("Banco Nº: "+subst(allt(this.value),1,3)+" no está en archivo. ¿Ingresa nuevo Banco?",4+32+256,"Aviso del Sistema")
								if pregunta=6
									thisform.codiban=0
									thisform.codisuc=0
									do form altabanco with thisform.codiban,thisform.codisuc,1
									if thisform.codiban>0
										frmconch= conectar_db(_screen.cn)
											SQLEXEC(frmconch,"select * from bancos where ban_codi=?thisform.codiban;","cur_ban")
										desconectar_db(frmconch)
										if RECCOUNT("cur_ban")>0
											LOCAL cadbansuc
											cadbansuc=allt(str(thisform.codiban))+allt(str(thisform.codisuc))
											frmdatpag= conectar_db(_screen.cn)
												SQLEXEC(frmdatpag,"select a.*,b.ban_desc from sucbancos a inner join bancos b on a.ban_codi=b.ban_codi where CONCAT(TRIM(CAST(a.ban_codi as char)),TRIM(CAST(a.suc_codi as char)))=?cadbansuc;","cur_suc")
											desconectar_db(frmdatpag)
											if RECCOUNT("cur_suc")>0
												thisform.text2.value=cur_suc.ban_desc
												thisform.codiban=cur_suc.ban_codi
												thisform.text11.value=allt(cur_suc.suc_nomb)
												thisform.codisuc=cur_suc.suc_codi
											else
												pregunta=messagebox("Aún no ha ingresado ninguna sucursal para "+allt(cur_ban.ban_desc)+". ¿Ingresa nueva Sucursal?",4+32+256,"Aviso del Sistema")
												if pregunta=6
													do form altasuc with thisform.codiban,thisform.codisuc
													thisform.text2.value=cur_ban.ban_desc
													cadbansuc=allt(str(thisform.codiban))+allt(str(thisform.codisuc))
													frmdatpag= conectar_db(_screen.cn)
														SQLEXEC(frmdatpag,"select a.*,b.ban_desc from sucbancos a inner join bancos b on a.ban_codi=b.ban_codi where CONCAT(TRIM(CAST(ban_codi as char)),TRIM(CAST(suc_codi as char)))=?cadbansuc;","cur_suc")
													desconectar_db(frmdatpag)														
													thisform.text11.value=allt(cur_suc.suc_nomb)
												else
													RETURN 0
													this.setfocus
												endif
											endif
										endif
									else
										RETURN 0
										this.setfocus
									endif
								else
									RETURN 0
									this.setfocus
								endif				
							endif					
						ENDIF
					ENDIF
		*!*			ENDIF
		*!*		ENDIF
		ENDIF
		
	ENDPROC

ENDDEFINE

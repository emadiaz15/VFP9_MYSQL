	PROCEDURE Btn_actualizar.btn.Click
		LOCAL fecdes,fechas,predes,prehas,ardes,arhas
		imposf = 0
		DIMENSION cantsf[1,1]
		cantsf[1,1] = 0
		thisform.limpiartotales(.T.)
		thisform.grd_planpres.RecordSource = ''
		thisform.grd_planpres.Refresh
		
		IF thisform.txt_fecdes.Value<>thisform.fecdes OR thisform.txt_fechas.Value<>thisform.fechas ;
			OR thisform.txt_predes.Value<>thisform.predes OR thisform.txt_prehas.Value<>thisform.prehas ;
			OR thisform.txt_artdes.Value<>thisform.ardes OR thisform.txt_arthas.Value<>thisform.arhas OR !USED("cur_planpres")
			fecdes = thisform.txt_fecdes.Value
			thisform.fecdes=fecdes
			fechas = thisform.txt_fechas.Value
			thisform.fechas=fechas
			predes = thisform.txt_predes.Value
			thisform.predes=predes
			prehas = thisform.txt_prehas.Value
			thisform.prehas=prehas
			ardes  = thisform.txt_artdes.Value
			thisform.ardes=ardes
			arhas  = thisform.txt_arthas.Value
			thisform.arhas=arhas
		
			SET DECIMALS TO 3
			frmplanp = conectar_db(_screen.cn)
				SQLEXEC(frmplanp, "call usp_planipre(?fecdes, ?fechas, ?predes, ?prehas, ?ardes, ?arhas);","cur_detapres")
			desconectar_db(frmplanp)
			SET DECIMALS TO
		ENDIF
		
		
		IF RECCOUNT("cur_detapres") > 0	
			SELECT DISTINCT fecha,prescodi,cliente,vendedor, ;
							CAST(STRTRAN(canitems,",",".") as numeric(15,0)) canitems, ;
							CAST(STRTRAN(cancump,",",".") as numeric(15,0)) cancump, ;
							impotot,ven_codi,cli_codi,cond_codi,estado,moneda,cotiz_dolar,impoadj ;
							FROM cur_detapres INTO CURSOR cur_planpres
			IF thisform.xcodicli <> 99999999 OR thisform.xcodiven <> 99999999
				DO case
					CASE thisform.xcodicli <> 99999999 AND thisform.xcodiven <> 99999999
						SELECT * FROM cur_planpres WHERE cli_codi = thisform.xcodicli AND ven_codi = thisform.xcodiven INTO CURSOR cur_planpres 
					CASE thisform.xcodicli <> 99999999 AND thisform.xcodiven = 99999999
						SELECT * FROM cur_planpres WHERE cli_codi = thisform.xcodicli INTO CURSOR cur_planpres 
					CASE thisform.xcodicli = 99999999 AND thisform.xcodiven <> 99999999
						SELECT * FROM cur_planpres WHERE ven_codi = thisform.xcodiven INTO CURSOR cur_planpres 
					CASE thisform.xcodicli = 99999999 AND thisform.xcodiven = 0
						SELECT * FROM cur_planpres WHERE ven_codi = 0 INTO CURSOR cur_planpres 
					CASE thisform.xcodicli <> 99999999 AND thisform.xcodiven = 0
						SELECT * FROM cur_planpres WHERE cli_codi = thisform.xcodicli AND ven_codi = 0 INTO CURSOR cur_planpres 
				ENDCASE
			ENDIF
			IF !(thisform.chk_sinad.Value = 1 AND thisform.chk_conad.Value = 1)
				DO case
					CASE thisform.chk_sinad.Value = 1 AND thisform.chk_conad.Value = 0 &&(No Adjudicados)
						SELECT * FROM cur_planpres WHERE estado = 1 INTO CURSOR cur_planpres 
					CASE thisform.chk_sinad.Value = 0 AND thisform.chk_conad.Value = 1 &&(Adjudicados)
						SELECT * FROM cur_planpres WHERE estado = 2 OR estado = 3 INTO CURSOR cur_planpres 
				ENDCASE
			ENDIF
			LOCATE
				
			IF thisform.chk_sinad.Value = 0 AND thisform.chk_conad.Value = 0
				thisform.estafiltros=0
				IF USED("cur_planpres")
					SELECT cur_planpres
					USE
				ENDIF
				IF USED("cur_detapres")
					SELECT cur_detapres
					USE
				ENDIF
				thisform.grd_planpres.RecordSource = ''
				thisform.grd_planpres.Refresh
				thisform.limpiartotales(.T.)
			ELSE
				thisform.estafiltros=1
				thisform.limpiartotales(.T.)
				thisform.grd_planpres.RecordSource = "cur_planpres"
			
		*!*			Thisform.grd_planpres.column6.DynamicInputMask = [('USD999,999,999.99')]
				&& [IIF(cur_planpres.moneda = 'D',('USD999,999,999.99'),('$999,999,999.99'))]
				Thisform.grd_planpres.column7.DynamicInputMask = [('USD999,999,999.99')]
				&& [IIF(cur_planpres.moneda = 'D',('USD999,999,999.99'),('$999,999,999.99'))]
				thisform.grd_planpres.SetAll("DynamicBackcolor","thisform.obtenercolor(cur_planpres.estado)","Column")
		*!*			thisform.grd_planpres.SetAll("DynamicForecolor","thisform.obtenercolortex(cur_planpres.estado)","Column")
				thisform.grd_planpres.SetAll("DynamicFontbold","iif(cur_planpres.estado=4,.T.,.F.)","Column")
				thisform.cuentapresup()
				thisform.calculartotales()
				frmplanp= conectar_db(_screen.cn)
					SQLEXEC(frmplanp,"select TRIM(presup_obser) presup_obser from presupuestos where presup_codi = ?cur_planpres.prescodi;","cur_obser")
				desconectar_db(frmplanp)
				IF RECCOUNT("cur_obser") > 0
					IF LEN(ALLTRIM(cur_obser.presup_obser)) > 0
						thisform.pgf_resum.page2.edt_obser.Value = ALLTRIM(cur_obser.presup_obser)
					ELSE
						thisform.pgf_resum.page2.edt_obser.Value = ""
					ENDIF
					cerrar_cursor("cur_obser")
				ENDIF
				thisform.grd_planpres.SetFocus
			ENDIF
			_screen.callplanipre=0
		ELSE
			thisform.limpiartotales(.T.)
		ENDIF
	ENDPROC


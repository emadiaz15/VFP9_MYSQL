		this.left=0
		this.Width=this.Parent.Width
		
	ENDPROC

	PROCEDURE grd_planpres.Column1.Header1.Click
		IF USED("cur_planpres")
			thisform.grd_planpres.RecordSource=''
			IF thisform.hdfecha_estado = 0
				SELECT * FROM cur_detapres ORDER BY fecha INTO CURSOR cur_detapres
				SELECT * FROM cur_planpres ORDER BY fecha INTO CURSOR cur_planpres
				thisform.hdfecha_estado = 1
			ELSE
				DO case
					CASE thisform.hdfecha_estado = 1
						SELECT * FROM cur_detapres ORDER BY fecha DESC INTO CURSOR cur_detapres
						SELECT * FROM cur_planpres ORDER BY fecha DESC INTO CURSOR cur_planpres
						thisform.hdfecha_estado = 2
					CASE thisform.hdfecha_estado = 2
						SELECT * FROM cur_detapres ORDER BY fecha INTO CURSOR cur_detapres
						SELECT * FROM cur_planpres ORDER BY fecha INTO CURSOR cur_planpres
						thisform.hdfecha_estado = 1
				ENDCASE
			ENDIF
			thisform.grd_planpres.RecordSource="cur_planpres"
			thisform.grd_planpres.Refresh()
		ENDIF
		
	ENDPROC


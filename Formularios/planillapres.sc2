	PROCEDURE grd_planpres.Column4.Header1.Click
		IF USED("cur_planpres")
			thisform.grd_planpres.RecordSource=''
			IF thisform.hdvend_estado = 0
				SELECT * FROM cur_detapres ORDER BY vendedor INTO CURSOR cur_detapres
				SELECT * FROM cur_planpres ORDER BY vendedor INTO CURSOR cur_planpres
				thisform.hdvend_estado = 1
			ELSE
				DO case
					CASE thisform.hdvend_estado = 1
						SELECT * FROM cur_detapres ORDER BY vendedor DESC INTO CURSOR cur_detapres
						SELECT * FROM cur_planpres ORDER BY vendedor DESC INTO CURSOR cur_planpres
						thisform.hdvend_estado = 2
					CASE thisform.hdvend_estado = 2
						SELECT * FROM cur_detapres ORDER BY vendedor INTO CURSOR cur_detapres
						SELECT * FROM cur_planpres ORDER BY vendedor INTO CURSOR cur_planpres
						thisform.hdvend_estado = 1
				ENDCASE
			ENDIF
			thisform.grd_planpres.RecordSource="cur_planpres"
			thisform.grd_planpres.Refresh()
		ENDIF
		
	ENDPROC

	PROCEDURE grd_planpres.Column4.Text1.Click
		frmplanp= conectar_db(_screen.cn)
			SQLEXEC(frmplanp,"select TRIM(presup_obser) presup_obser from presupuestos where presup_codi = ?cur_planpres.prescodi;","cur_obser")
		desconectar_db(frmplanp)
		
		IF RECCOUNT("cur_obser") > 0
			IF LEN(ALLTRIM(cur_obser.presup_obser)) > 0
				thisform.pgf_resum.page2.edt_obser.Value = ALLTRIM(cur_obser.presup_obser)
			ELSE
				thisform.pgf_resum.page2.edt_obser.Value = ""
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE grd_planpres.Column4.Text1.DblClick
		LOCAL xcodpres, xcond
		
		xcodpres = cur_planpres.prescodi
		xcond    = cur_planpres.cond_codi
		valorcadena = ''
		_screen.estapres=1
		DO FORM conspresup WITH xcodpres,xcond
	ENDPROC

	PROCEDURE grd_planpres.Column4.Text1.When
		thisform.recorrer(LASTKEY())
	ENDPROC


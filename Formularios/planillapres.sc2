	PROCEDURE Init
		*!*	PUBLIC valorcadena, codigo, nombre
		SET POINT TO ","
		SET SEPARATOR TO "."
		*!*	SET DATE BRITISH
		*!*	SET CENTURY ON
		
		IF USED("cur_planpres")
			cerrar_cursor("cur_planpres")
		ENDIF
		IF USED("cur_detapres")
			cerrar_cursor("cur_detapres")
		ENDIF
		
		this.txt_fecdes.Value= DATE()
		this.txt_fechas.Value= DATE()
		
		frmplanp = conectar_db(_screen.cn)
			SQLEXEC(frmplanp,"select param_fec from parametros where param_codi = 4;","cur_primfec")
		desconectar_db(frmplanp)
		
		IF RECCOUNT("cur_primfec") > 0
			thisform.xprimefec = cur_primfec.param_fec
			cerrar_cursor("cur_primfec")
		ENDIF
		
		frmplanp = conectar_db(_screen.cn)
			SQLEXEC(frmplanp,"select * from vendedores order by ven_nomb;","cur_venp")
		desconectar_db(frmplanp)
		
		IF RECCOUNT("cur_venp") > 0
			LOCAL convp
			convp = 1
			LOCATE
			SCAN FOR convp <= RECCOUNT("cur_venp")
				thisform.cmb_vendedor.AddItem(ALLTRIM(cur_venp.ven_nomb), convp)
				convp = convp + 1
			ENDSCAN
			thisform.cmb_vendedor.AddItem("VENTAS SIN VENDEDOR", RECCOUNT("cur_venp") + 1)
			cerrar_cursor("cur_venp")
		ENDIF
		
		frmplanp= conectar_db(_screen.cn)
			SQLEXEC(frmplanp,"select param_desc from parametros where param_codi = 13;","cur_emp")
		desconectar_db(frmplanp)
		
		IF RECCOUNT("cur_emp") > 0
			thisform.empresa=ALLTRIM(cur_emp.param_desc)
			cerrar_cursor("cur_emp")
		ENDIF
		
		FOR ncol=1 TO 7
			xsource="Thisform.grd_planpres.column"+ALLTRIM(STR(ncol))+".text1"
			BINDEVENT(&xsource,"RightClick",Thisform,"Grid_RightClick")
		*!*		BINDEVENT(&xsource,"DblClick",Thisform,"Grid_DobleClick")
		NEXT ncol
		
		thisform.fecdes={  /  /    }
		thisform.fechas={  /  /    }
		thisform.predes=0
		thisform.prehas=0
		
		this.btn_actualizar.SetFocus
	ENDPROC

	PROCEDURE limpiartotales
		LPARAMETERS xopcion
		
		IF xopcion = .T.
			thisform.pgf_resum.page1.etq_cantnoad.Caption  = ''
			thisform.pgf_resum.page1.etq_cantadj.Caption  = ''
			thisform.pgf_resum.page1.etq_totcan.Caption  = ''
			thisform.pgf_resum.page1.etq_mtot.Caption = ''
			thisform.pgf_resum.page1.etq_mon.Visible= .F.
			thisform.pgf_resum.page1.etq_totad.Caption = ''
			thisform.pgf_resum.page1.etq_mon2.Visible= .F.
			thisform.pgf_resum.page1.etq_porc.Caption = ''
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS nEstado
		
		LOCAL lnColor
		
		DO case
			CASE nEstado = 1
				lnColor = RGB(190, 220, 240)
				** lnColor = RGB(247,201,168)
			CASE nEstado = 2
				lnColor = RGB(180,180,180)
				** lnColor = RGB(144,238,144)
		    CASE nEstado = 3
		    	lnColor = RGB(255,140,140)
		    	** lnColor = RGB(173,216,230)
		*!*		CASE nEstado = 4
		*!*			lnColor = RGB(0,255,255)
		ENDCASE
		
		return(lnColor)
	ENDPROC

	PROCEDURE recorrer
		LPARAMETERS xkeycode
		
		IF xkeycode = 5 OR xkeycode = 24
			frmplanp= conectar_db(_screen.cn)
				SQLEXEC(frmplanp,"select presup_obser from presupuestos where presup_codi = ?cur_planpres.prescodi","cur_obser")
			desconectar_db(frmplanp)
			
			IF RECCOUNT("cur_obser") > 0
				IF LEN(ALLTRIM(cur_obser.presup_obser)) > 0
					thisform.pgf_resum.page2.edt_obser.Value = ALLTRIM(cur_obser.presup_obser)
				ELSE
					thisform.pgf_resum.page2.edt_obser.Value = ''
				ENDIF
				cerrar_cursor("cur_obser")
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE tomarpedido
		LPARAMETERS xpres
		
		frmplanp= conectar_db(_screen.cn)
			SQLEXEC(frmplanp,"select * from pedidos where presup_codi=?xpres;","cur_yaesta")
		desconectar_db(frmplanp)
		IF RECCOUNT("cur_yaesta")>0
			pregn=MESSAGEBOX("Este presupuesto ya fue confirmado por el Cliente total o parcialmente con el número "+ALLTRIM(STR(cur_yaesta.ped_codi))+" el día "+ALLTRIM(DTOC(cur_yaesta.ped_fech))+"."+CHR(13)+chr(13)+;
							 "¿Continúa Igualente?",4+48+256,"Aviso del Sistema")
			IF pregn=6
				do form selecitem with xpres,cond,codicli
				cerrar_cursor("cur_yaesta")
				STORE .F. TO thisform.fecdes,thisform.fechas,thisform.predes,thisform.prehas,thisform.ardes,thisform.arhas
		
				thisform.btn_actualizar.btn.Click()
			ELSE
				cerrar_cursor("cur_yaesta")
				KEYBOARD '{TAB}'+'{TAB}'
			ENDIF
		ELSE
			codicli=cur_planpres.cli_codi
			do form selecitem with xpres,cur_planpres.cond_codi,cur_planpres.cli_codi
			cerrar_cursor("cur_yaesta")
			STORE .F. TO thisform.fecdes,thisform.fechas,thisform.predes,thisform.prehas,thisform.ardes,thisform.arhas
		
			thisform.btn_actualizar.btn.Click()
		ENDIF
	ENDPROC

	PROCEDURE totalizadores
		
		LOCAL descmax,descmin
		
		SELECT art_codi,COUNT(*) cantidad FROM cur_detapres WHERE art_codi > 5 GROUP BY art_codi ORDER BY cantidad DESC INTO ARRAY ar_mayor
		SELECT art_codi,COUNT(*) cantidad FROM cur_detapres WHERE art_codi > 5 GROUP BY art_codi ORDER BY cantidad INTO ARRAY ar_menor
		
		frmplanp = conectar_db(_screen.cn)
			SQLEXEC(frmplanp,"select TRIM(art_desc) art_desc from articulos where art_codi = ?ar_mayor[1,1];","cur_armax")
			SQLEXEC(frmplanp,"select TRIM(art_desc) art_desc from articulos where art_codi = ?ar_menor[1,1];","cur_armin")
		desconectar_db(frmplanp)
		
		thisform.pgf_resum.page1.lbl_max.Caption="Artículo mas cotizado: "+ALLTRIM(cur_armax.art_desc)+" con "+ALLTRIM(STR(ar_mayor[1,2]))+IIF(ar_mayor[1,2]>1," veces."," vez.")
		
		thisform.pgf_resum.page1.lbl_min.Caption="Artículo menos cotizado: "+ALLTRIM(cur_armin.art_desc)+" con "+ALLTRIM(STR(ar_menor[1,2]))+IIF(ar_menor[1,2]>1," veces."," vez.")
		
		cerrar_cursor("cur_armax")
		cerrar_cursor("cur_armin")
		
		SELECT cur_planpres
		
		RETURN
		
	ENDPROC

	PROCEDURE bnt_impirmir.Click
		IF USED("cur_planpres")
			IF RECCOUNT("cur_planpres") > 0
				IF thisform.chk_deta.Value=1 then
					SELECT cur_detapres
					LOCATE
					INDEX on prescodi TO SYS(2015)
					SELECT cur_planpres
					LOCATE
					INDEX on prescodi TO SYS(2015)
					SET RELATION TO
					SET RELATION TO prescodi INTO cur_detapres addi
		
					SELECT cur_detapres
					LOCATE
					SELECT cur_planpres
					LOCATE
		
					IF thisform.chk_pant.Value=1
						REPORT FORM planipres_2 PREVIEW NOCONSOLE
					ELSE
						REPORT FORM planipres_2 TO PRINTER PROMPT NOCONSOLE
					ENDIF
				ELSE
					SELECT cur_planpres
					LOCATE
					IF thisform.chk_pant.Value=1
						REPORT FORM planipres_1 PREVIEW NOCONSOLE
					ELSE
						REPORT FORM planipres_1 TO PRINTER PROMPT NOCONSOLE
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC


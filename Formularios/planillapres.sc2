	PROCEDURE chk_articulo.Click
		IF this.Value = 1
			thisform.txt_artdes.Value = 0
			thisform.txt_arthas.Value = 99999999
		ELSE
			thisform.txt_artdes.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE chk_cliente.Click
		IF this.Value=1
			thisform.xcodicli = 99999999
			thisform.cmb_cliente.value=''
			thisform.cmb_cliente.RowSource=''
			thisform.btn_actualizar.SetFocus
		ELSE
			thisform.xcodicli = 99999999
			thisform.cmb_cliente.SetFocus
		endif
	ENDPROC

	PROCEDURE chk_fechas.Click
		IF this.Value=1
			thisform.txt_fecdes.value=thisform.xprimefec
			thisform.txt_fechas.value=DATE()
			thisform.btn_actualizar.setfocus
		ELSE
			thisform.txt_fecdes.value=DATE()
			thisform.txt_fechas.value=DATE()
			thisform.btn_actualizar.SetFocus
		endif
	ENDPROC

	PROCEDURE chk_pedcod.Click
		IF this.Value = 1
			thisform.txt_predes.Value = 0
			thisform.txt_prehas.Value = 99999999
		ELSE
			thisform.txt_predes.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE chk_vend.Click
		IF this.Value = 0
			thisform.cmb_vendedor.SetFocus
			keyboard "{F4}"
		ELSE
			thisform.cmb_vendedor.Value = ''
			thisform.xcodiven = 99999999
			thisform.btn_actualizar.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE cmb_cliente.Click
		this.setfocus
	ENDPROC

	PROCEDURE cmb_cliente.Destroy
		set notify on
	ENDPROC

	PROCEDURE cmb_cliente.GotFocus
		set notify off
		
		
	ENDPROC

	PROCEDURE cmb_cliente.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					frmplanp= conectar_db(_screen.cn)
						xdesc=allt(this.list(i))
						SQLEXEC(frmplanp,"select * from clientes where TRIM(cli_nomb)=?xdesc;","cur_cli")
					desconectar_db(frmplanp)
					thisform.xcodicli=cur_cli.cli_codi
					thisform.chk_cliente.Value=0
					keyboard '{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE cmb_cliente.LostFocus
		IF LEN(ALLTRIM(this.Value)) = 0
			thisform.chk_cliente.Value = 1
			thisform.xcodicli = 99999999
		ENDIF
		
	ENDPROC

	PROCEDURE cmb_cliente.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade="%"+subst(allt(this.text),2,len(allt(this.text)))+"%"
				frmplanp= conectar_db(_screen.cn)
					SQLEXEC(frmplanp,"select * from clientes where cli_nomb like ?cade order by cli_nomb;","cur_cli")
				desconectar_db(frmplanp)
				IF RECCOUNT("cur_cli")>0
					this.rowsource="select cli_nomb from cur_cli INTO CURSOR cmb_cliente"
					this.value=this.list(1)
					keyboard "{F4}"
				ELSE
					MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
					this.Value=""			
				ENDIF
				RETURN .F.
			else
				if len(allt(this.text))>0
					cade=ALLTRIM(this.text)+"%"
					frmplanp= conectar_db(_screen.cn)
						SQLEXEC(frmplanp,"select * from clientes where cli_nomb like ?cade;","cur_cli")
					desconectar_db(frmplanp)
					IF RECCOUNT("cur_cli")>0
						this.rowsource="select cli_nomb from cur_cli INTO CURSOR cmb_cliente"
						this.value=this.list(1)
						keyboard "{F4}"
					ELSE
						MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
						this.Value=""				
					ENDIF
					RETURN .F.
				ENDIF
			endif
		endif
	ENDPROC

	PROCEDURE cmb_vendedor.Click
		IF LEN(ALLTRIM(this.Value)) > 0
			IF ALLTRIM(this.Value) = "VENTAS SIN VENDEDOR"
				thisform.xcodiven = 0
			ELSE
				frmplanp = conectar_db(_screen.cn)
					SQLEXEC(frmplanp ,"select ven_codi from vendedores where TRIM(ven_nomb) = ?ALLTRIM(this.Value);","cur_codv")
				desconectar_db(frmplanp )
				IF RECCOUNT("cur_codv") > 0
					thisform.xcodiven = cur_codv.ven_codi	
				ENDIF
			ENDIF
			thisform.chk_vend.Value = 0
		ENDIF
		
		thisform.btn_actualizar.SetFocus
		
	ENDPROC

	PROCEDURE Command2.Click
		codigo=0
		nombre=''
		
		DO FORM artload WITH codigo, nombre
		
		IF codigo > 0
			thisform.txt_artdes.Value= codigo
			thisform.txt_arthas.Value= codigo
			thisform.chk_articulo.Value = 0
		ENDIF
	ENDPROC

	PROCEDURE Command3.Click
		codigo=0
		nombre=''
		
		DO FORM artload WITH codigo, nombre
		
		IF codigo > 0
			IF thisform.txt_artdes.Value > codigo
				thisform.txt_artdes.Value = codigo
			ENDIF
			thisform.txt_arthas.Value= codigo
			thisform.chk_articulo.Value = 0
		ENDIF
	ENDPROC

	PROCEDURE Command4.Click
		IF USED("cur_planpres")
			IF RECCOUNT("cur_planpres") > 0
				SELECT cur_planpres
				LOCATE
				local Fila,fpag,pagina,empresa,lnCantidadDatos,lnI,lnPorcentaje
		
				wait'Espere Un Momento Exportando Datos' window nowait
				_screen.mousepointer=11
				TmpSheet=GetObject('','Excel.Sheet')
				XLApp=TmpSheet.Application
		*!*			xlapp.visible=.t.
				XLApp.workbooks.add()
				XLSheet=XLApp.ActiveSheet
				with XLSheet.PageSetup
					.Orientation = 1
					.LeftMargin = XLApp.InchesToPoints(0)
					.RightMargin = XLApp.InchesToPoints(0)
				    .TopMargin = XLApp.InchesToPoints(0)
				    .BottomMargin = XLApp.InchesToPoints(0)
				    .HeaderMargin = XLApp.InchesToPoints(0)
				    .FooterMargin = XLApp.InchesToPoints(0)
				    .Zoom=85
				ENDWITH
				XLSheet.Columns("A:A").ColumnWidth = 3.71
				XLSheet.Columns("B:B").ColumnWidth = 10.71
				XLSheet.Columns("C:C").ColumnWidth = 10.71
				XLSheet.Columns("D:D").ColumnWidth = 31.57
				XLSheet.Columns("E:E").ColumnWidth = 13.00
				XLSheet.Columns("F:F").ColumnWidth = 12.00
				XLSheet.Columns("G:G").ColumnWidth = 12.00
				XLSheet.Columns("H:H").ColumnWidth = 16.43
		
				thisform.excelencabezado()
		
				sele cur_planpres
				go top
				lnCantidadDatos=RECCOUNT("cur_planpres")
				Fila=15
				thisform.progreso.Visible= .T.
				FOR lnI = 1 TO lnCantidadDatos
				   	xini = "B"+ALLTRIM(STR(Fila))
				   	xfin = "H"+ALLTRIM(STR(Fila))
				   	rango= '"'+xini+':'+xfin+'"'
				   	XLSheet.range(&rango).Font.Size = "10"
				   	DO case
				   		CASE cur_planpres.estado = 1
				   			XLSheet.range(&rango).Interior.Color= thisform.obtenercolor(cur_planpres.estado)
				   		CASE cur_planpres.estado = 2
				   			XLSheet.range(&rango).Interior.Color= thisform.obtenercolor(cur_planpres.estado)
				   		CASE cur_planpres.estado = 3
				   			XLSheet.range(&rango).Interior.Color= thisform.obtenercolor(cur_planpres.estado)
				   	ENDCASE 
				   	WITH XLSheet.RANGE(&rango)
					    .Borders(1).LineStyle = 1
					    .Borders(1).Weight = 1
					    .Borders(1).Color = RGB(185,185,185)
					    .Borders(2).LineStyle = 1
					    .Borders(2).Weight = 1
					    .Borders(2).Color = RGB(185,185,185)
					    .Borders(3).LineStyle = 1
					    .Borders(3).Weight = 1
					    .Borders(3).Color = RGB(185,185,185)
					    .Borders(4).LineStyle = 1
					    .Borders(4).Weight = 1
					    .Borders(4).Color = RGB(185,185,185)
					ENDWITH
					XLSheet.Cells(Fila,2)=cur_planpres.fecha
				   	XLSheet.Cells(Fila,2).HorizontalAlignment=-4108
				   	XLSheet.Cells(Fila,3)=cur_planpres.prescodi
				   	XLSheet.Cells(Fila,3).HorizontalAlignment=-4108
				   	XLSheet.Cells(Fila,4)=cur_planpres.cliente
				   	XLSheet.Cells(Fila,5)=cur_planpres.vendedor
				   	XLSheet.Cells(Fila,6)=cur_planpres.canitems
				   	XLSheet.Cells(Fila,6).HorizontalAlignment=-4108
				   	XLSheet.Cells(Fila,7)=cur_planpres.cancump
				   	XLSheet.Cells(Fila,7).HorizontalAlignment=-4108
				  	XLSheet.Cells(Fila,8)=cur_planpres.impotot
		  			XLSheet.Cells(Fila,8).NUMBERFORMAT="_-[$USD] * #,##0.00"
				   	Fila=Fila+1
					lnPorcentaje            = lnI * 100 / lnCantidadDatos
				    ThisForm.Progreso.Value = lnPorcentaje
				    skip		   	
				ENDFOR
		
				thisform.excelfooter(Fila)
				thisform.progreso.Visible= .F.
				XLApp.visible=.T.
				XLApp.WindowState = -4137
				DECLARE LONG BringWindowToTop IN "user32" LONG HWND
				BringWindowToTop(XLApp.HWND)
				_screen.mousepointer=0
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Ctn_banner1.Init

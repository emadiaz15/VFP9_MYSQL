	PROCEDURE Activate
		DO CASE
			CASE _screen.estamodipres=1
		*!*			STORE .F. TO thisform.fecdes,thisform.fechas,thisform.predes,thisform.prehas,thisform.ardes,thisform.arhas
		
				thisform.btn_actualizar.btn.Click()
				_screen.estamodipres=0
			CASE _screen.copypresplan=.T.
		*!*			STORE .F. TO thisform.fecdes,thisform.fechas,thisform.predes,thisform.prehas,thisform.ardes,thisform.arhas
		
				thisform.btn_actualizar.btn.Click()
				_screen.copypresplan=.T.
		ENDCASE
		
	ENDPROC

	PROCEDURE calculartotales
		IF USED("cur_planpres")
			LOCAL xporc
			xporc = 0
			LOCATE
			DO case
				CASE thisform.chk_conad.value=1 AND thisform.chk_sinad.Value=1
					SELECT SUM(impotot) FROM cur_planpres INTO ARRAY ar_montot
				CASE thisform.chk_conad.value=1 AND thisform.chk_sinad.Value=0
					SELECT SUM(impotot) FROM cur_planpres WHERE estado = 2 OR estado = 3 INTO ARRAY ar_montot
				CASE thisform.chk_conad.value=0 AND thisform.chk_sinad.Value=1
					SELECT SUM(impotot) FROM cur_planpres WHERE estado = 1 OR estado = 5 INTO ARRAY ar_montot
			ENDCASE
			SELECT SUM(impoadj) impoadj FROM cur_planpres INTO ARRAY ar_adju
			thisform.pgf_resum.page1.etq_mon.Visible= .T.
			thisform.pgf_resum.page1.etq_mtot.Caption = ALLTRIM(STR(IIF(ISNULL(ar_montot),0,ar_montot),15,2))
			thisform.pgf_resum.page1.etq_mon2.Visible= .T.
			thisform.pgf_resum.page1.etq_totad.Caption = ALLTRIM(STR(IIF(ISNULL(ar_adju),0,ar_adju),15,2))
			xporc = ROUND((ar_adju/ar_montot)*100,3)
			thisform.pgf_resum.page1.etq_porc.Caption = ALLTRIM(STR(IIF(ISNULL(xporc),0,xporc),15,3))+" %"
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE copiapresup
		LPARAMETERS ncodp
		
		LOCAL xcodp,xcond,xmoneda,xcodicli
		
		xcodp    = ncodp
		xcond    = cur_planpres.cond_codi
		xmoneda  = cur_planpres.moneda
		xcodicli = cur_planpres.cli_codi
		
		DO FORM presxpres WITH xcodp,xcond,xmoneda,xcodicli
		
		*!*	STORE .F. TO thisform.fecdes,thisform.fechas,thisform.predes,thisform.prehas,thisform.ardes,thisform.arhas
		
		_screen.copypresplan = .T.
		
		RETURN
	ENDPROC

	PROCEDURE cuentapresup
		IF USED("cur_planpres")
			LOCATE
			SELECT COUNT(*) FROM cur_planpres WHERE estado = 1 INTO ARRAY ar_cantnad
			SELECT COUNT(*) FROM cur_planpres WHERE estado = 2 OR estado = 3 INTO ARRAY ar_cantad
			thisform.pgf_resum.page1.etq_cantadj.Caption  = ALLTRIM(STR(ar_cantad))
			thisform.pgf_resum.page1.etq_cantnoad.Caption  = ALLTRIM(STR(ar_cantnad))
			thisform.pgf_resum.page1.etq_totcan.Caption  = ALLTRIM(STR(ar_cantad + ar_cantnad))
		ENDIF
	ENDPROC

	PROCEDURE datos_click
		
		thisform.RemoveObject("shp_datos")
		thisform.RemoveObject("edt_datos")
		thisform.RemoveObject("cmd_datos")
	ENDPROC

	PROCEDURE datos_mleave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.F.
		thisform.cmd_datos.FontSize=9
	ENDPROC

	PROCEDURE datos_mmove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.T.
		thisform.cmd_datos.FontSize=10
	ENDPROC

	PROCEDURE Destroy
		SET POINT TO
		SET SEPARATOR TO
	ENDPROC

	PROCEDURE excelcuadrofooter
		LPARAMETERS nFila
		
		fotfil = nFila
		
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,8)).Borders(1).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,8)).Borders(1).Weight=3
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,8)).Borders(2).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,8)).Borders(2).Weight=3
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,8)).Borders(3).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,8)).Borders(3).Weight=3
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,8)).Borders(4).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,8)).Borders(4).Weight=3
		
		RETURN
		
		
	ENDPROC

	PROCEDURE excelencabezado
		Xlsheet.cells(1,8)=ALLTRIM(thisform.empresa)
		XLSheet.Cells(1,8).font.bold=.T.
		XLSheet.Cells(1,8).font.size="12"
		XLSheet.Cells(1,8).font.name="Courier New"
		XLSheet.Cells(1,8).HorizontalAlignment=-4152
		
		Xlsheet.cells(3,8)='Fecha Actual: '+ALLTRIM(DTOC(DATE()))
		XLSheet.Cells(3,8).font.bold=.T.
		XLSheet.Cells(3,8).font.size="11"
		XLSheet.Cells(3,8).font.name="Courier New"
		XLSheet.Cells(3,8).HorizontalAlignment=-4152
		
		Xlsheet.range("D4:F4").merge
		Xlsheet.cells(4,4)="PLANILLA DE PRESUPUESTOS"
		XLSheet.Cells(4,4).font.bold=.T.
		XLSheet.Cells(4,4).font.underline=.T.
		XLSheet.Cells(4,4).font.size="13"
		XLSheet.Cells(4,4).font.name="Cooper Black"
		XLSheet.range("D4:F4").HorizontalAlignment=7
		
		XLSheet.range("B8:C8").merge
		XLSheet.range("B9:C9").merge
		XLSheet.range("B10:C10").merge
		XLSheet.range("B11:C11").merge
		*!*	XLSheet.range("B12:C12").merge
		XLSheet.range("B8:C11").HorizontalAlignment=7
		XLSheet.range("B8:C11").Borders.LineStyle=1
		XLSheet.range("B8:C11").Borders.Weight=3
		XLSheet.Cells(8,2)="Referencias:"
		XLSheet.Cells(8,2).font.bold=.T.
		XLSheet.Cells(9,2)="Adjudicados"
		XLSheet.Cells(9,2).interior.color=thisform.obtenercolor(2)
		*!*	XLSheet.Cells(9,2).font.color=thisform.obtenercolortex(1)
		XLSheet.Cells(10,2)="No Adjudicados"
		XLSheet.Cells(10,2).interior.color=thisform.obtenercolor(1)
		*!*	XLSheet.Cells(10,2).font.color=thisform.obtenercolortex(2)
		XLSheet.Cells(11,2)="Adjudic. Parcial"
		XLSheet.Cells(11,2).interior.color=thisform.obtenercolor(3)

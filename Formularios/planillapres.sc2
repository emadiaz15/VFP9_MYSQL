	PROCEDURE excelfooter
		LPARAMETERS xInifil
		
		LOCAL fotfil
		
		fotfil = xInifil
		
		XLSheet.Rows(fotfil).RowHeight = 10
		fotfil = fotfil + 1
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,7)).Merge
		Xlsheet.cells(fotfil,6).HorizontalAlignment=-4152
		Xlsheet.cells(fotfil,6)='TOTAL COTIZADO'
		XLSheet.Cells(fotfil,8)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_mtot.caption))
		XLSheet.Cells(fotfil,8).NUMBERFORMAT="_-[$USD] * #,##0.00"
		WITH Xlsheet.range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8))
			.font.bold=.T.
			.HorizontalAlignment=-4108
		ENDWITH
		
		thisform.excelcuadrofooter(fotfil)
		
		fotfil = fotfil + 1
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,7)).Merge
		Xlsheet.cells(fotfil,6).HorizontalAlignment=-4152
		Xlsheet.cells(fotfil,6)='TOTAL ADJUDICADO'
		XLSheet.Cells(fotfil,8)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_totad.caption))
		XLSheet.Cells(fotfil,8).NUMBERFORMAT="_-[$USD] * #,##0.00"
		WITH Xlsheet.range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8))
			.font.bold=.T.
			.HorizontalAlignment=-4108
		ENDWITH
		
		thisform.excelcuadrofooter(fotfil)
		
		fotfil = fotfil + 1
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil,7)).Merge
		Xlsheet.cells(fotfil,6).HorizontalAlignment=-4152
		Xlsheet.cells(fotfil,6)='PORCENT. ADJUDICACIÓN'
		XLSheet.Cells(fotfil,8).NUMBERFORMAT="@"
		XLSheet.Cells(fotfil,8)=ALLTRIM(thisform.pgf_resum.page1.etq_porc.caption)
		WITH Xlsheet.range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8))
			.font.bold=.T.
			.HorizontalAlignment=-4108
		ENDWITH
		
		thisform.excelcuadrofooter(fotfil)
		
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,8)='Adjudicados ('+ALLTRIM(thisform.pgf_resum.page1.etq_cantadj.Caption)+' presupuestos)'
		Xlsheet.cells(fotfil,8).HorizontalAlignment=-4152
		fotfil = fotfil + 1
		XLSheet.Rows(fotfil).RowHeight = 10
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,8)='No Adjudicados ('+ALLTRIM(thisform.pgf_resum.page1.etq_cantnoad.Caption)+' presupuestos)'
		Xlsheet.cells(fotfil,8).HorizontalAlignment=-4152
		
		fotfil = fotfil + 1
		XLSheet.Rows(fotfil).RowHeight = 10
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,8)='Total de Presupuestos ('+ALLTRIM(thisform.pgf_resum.page1.etq_totcan.Caption)+' presupuestos)'
		Xlsheet.cells(fotfil,8).HorizontalAlignment=-4152
		
		fotfil = fotfil - 1
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil+1,8)).font.bold= .T.
		fotfil = xInifil + 1
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil+11,6)).font.bold= .T.
		
		RETURN
		
		
		
		
		
		
	ENDPROC

	PROCEDURE grid_rightclick
		IF USED("cur_planpres")
			LOCAL lcShortcut, loRef, xcodpres, xcond
			_screen.callplanipre=1
			xcodpres = cur_planpres.prescodi
			xcond    = cur_planpres.cond_codi
			valorcadena = ''
			_screen.estapres=1
			
			m.loRef = this
			m.lcShortcut = SYS(2015)
		
			DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
			DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Consultar Presupuesto] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
			DEFINE BAR 2 OF (m.lcShortcut) PROMPT [Modificar Presupuesto] PICTURE "C:\VFP9_MYSQL\imagen\misc_1_911.ico"
			DEFINE BAR 3 OF (m.lcShortcut) PROMPT [Copiar Presupuesto] PICTURE "C:\VFP9_MYSQL\imagen\facxped.png"
			DEFINE BAR 4 OF (m.lcShortcut) PROMPT [Tomar Pedido] PICTURE "C:\VFP9_MYSQL\imagen\VBE7_1251.ico"
				
		
			ON SELECTION BAR 1 OF (m.lcShortcut) DO FORM conspresup WITH xcodpres,xcond
			ON SELECTION BAR 2 OF (m.lcShortcut) DO FORM modipresup WITH xcodpres,xcond
			ON SELECTION BAR 3 OF (m.lcShortcut) m.loRef.copiapresup(cur_planpres.prescodi)
			ON SELECTION BAR 4 OF (m.lcShortcut) m.loRef.tomarpedido(xcodpres)
		
			ACTIVATE POPUP (m.lcShortcut)
			RELEASE POPUP (m.lcShortcut)
		ENDIF
	ENDPROC


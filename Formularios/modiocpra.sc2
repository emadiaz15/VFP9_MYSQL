	PROCEDURE ctn_moneda.chk_dolares.Click
		IF this.Value=1
			IF thisform.nitem > 0
				prmon= MESSAGEBOX("¿Dolariza el total de los ítems de la orden de compra?",4+64+256,"Aviso del Sistema")
				IF prmon=6
					thisform.pesifica_dolariza(1)
				ELSE
					MESSAGEBOX("Debe modificar manualmente cada ítem.",48,"Aviso del Sistema")
				ENDIF
			ENDIF
		*!*		thisform.letramon='D'
			_screen.moneocpra='D'
			LOCAL posicar,posicarp
			STORE 0 TO posicar,posicarp
			posicar=AT("PRECIOS EXPRESADOS",thisform.edit1.Value,1)
			IF posicar>0
				posicarp=AT("PESOS",thisform.edit1.Value,1)
				IF posicarp > 0
					thisform.edit1.Value=SUBSTR(thisform.edit1.Value,28)
				ENDIF
			ENDIF
			thisform.edit1.Value='PRECIOS EXPRESADOS EN DOLARES'+thisform.edit1.Value
		ENDIF
		IF this.Value=1 AND this.Parent.chk_pesos.Value=1
			this.Parent.chk_pesos.Value=0
		ENDIF
		
	ENDPROC

	PROCEDURE ctn_moneda.chk_pesos.Click
		IF this.Value = 1
			IF thisform.nitem > 0
				prmon= MESSAGEBOX("¿Pesifica todos los ítems de la orden de compra?",4+32+256,"Aviso del Sistema")
				IF prmon=6
					thisform.pesifica_dolariza(2)
				ELSE
					MESSAGEBOX("Debe modificar manualmente cada ítem.",48,"Aviso del Sistema")
				ENDIF
			ENDIF
		*!*		thisform.letramon='P'
			_screen.moneocpra='P'
			LOCAL posicar,posicard
			STORE 0 TO posicar,posicard
			posicar=AT("PRECIOS EXPRESADOS",thisform.edit1.Value,1)
			IF posicar>0
				posicard=AT("DOLARES",thisform.edit1.Value,1)
				IF posicard > 0
					thisform.edit1.Value=SUBSTR(thisform.edit1.Value,30)
				ENDIF
			ENDIF
			thisform.edit1.Value='PRECIOS EXPRESADOS EN PESOS'+thisform.edit1.Value
		ENDIF
		IF this.Value=1 AND this.Parent.chk_dolares.Value=1
			this.Parent.chk_dolares.Value=0
		ENDIF
	ENDPROC


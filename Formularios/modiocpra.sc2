	PROCEDURE Activate
		LOCAL auxmon,xpen
		auxmon=''
		opcion=0
		if thisform.codiprov>0
			_screen.xopcpra="CO"
			impiva1=thisform.impiva1
			impiva2=thisform.impiva2
			valorcadena=thisform.valorcadena
			codiprov=thisform.codiprov
			on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		set exact on
		if codigo=0
			muestro=0
		endif
		if muestro=1
			with thisform
				frmaltac= conectar_db(_screen.cn)
				
		*!*		*---------------------ANTES-----------------------------------*
		*!*		SQLEXEC(frmaltac, "select * from articulos where art_codi=?codigo;","cur_arti")
		*!*	    *-------------------------------------------------------------*
				
				*---------------------DESPUES-----------------------------------*
				SQLEXEC(frmaltac, ;
				"SELECT a.*, IFNULL(m.estado, 1) AS estado_metricas " + ;
				"FROM articulos a " + ;
				"LEFT JOIN art_metricas m ON m.art_codi = a.art_codi " + ;
				"WHERE a.art_codi = ?codigo;", ;
				"cur_arti")
				desconectar_db(frmaltac)
				*=========================================================
				* BLOQUE CONTROL ESTADO COMPRA - art_metricas.estado
				* Solo aplica para artículos reales: art_codi > 5
				*
				* MsgBoxEx devuelve:
				*   1 = Cancelar
				*   2 = Agregar y Activar
				*   3 = Ignorar
				*=========================================================
				LOCAL lnEstadoCompra, lnRespEstado, lnArtEstado
				LOCAL conhp, conilu
				lnArtEstado = codigo
				lnEstadoCompra = 1
				IF lnArtEstado > 5
					IF USED("cur_arti") AND RECCOUNT("cur_arti") > 0
						lnEstadoCompra = VAL(TRANSFORM(cur_arti.estado_metricas))
					ENDIF
					IF lnEstadoCompra = 0
						lnRespEstado = MsgBoxEx( ;
							"El artículo está INACTIVO para compras." + CHR(13) + CHR(13) + ;
							"Cancelar = No agregar" + CHR(13) + ;
							"Activar  = Activar artículo y agregar" + CHR(13) + ;
							"Ignorar  = Agregar igual y mantener INACTIVO", ;
							"!", ;
							"Artículo inactivo para compras", ;
							"Cancelar,Activar,Ignorar")
						DO CASE
							*-----------------------------------------------------
							* CANCELAR
							* No agrega el artículo al grid
							*-----------------------------------------------------
							CASE lnRespEstado = 1
								codigo = 0
								muestro = 0
								RETURN
							*-----------------------------------------------------
							* AGREGAR Y ACTIVAR
							* Primero confirma activación.
							* Si confirma, actualiza art_metricas.estado = 1
							* en HP + ILUMET y deja continuar el alta.
							*-----------------------------------------------------
							CASE lnRespEstado = 2
								IF MsgBoxEx( ;
									"¿Confirma activar este artículo para compras?", ;
									"?", ;
									"Confirmar activación", ;
									"No,Sí") <> 2
									
									codigo = 0
									muestro = 0
									RETURN
		
								ENDIF
								*=================================================
								* BLOQUE HP ELECTRICIDAD - DB PRINCIPAL
								*=================================================
								conhp = conectar_db(_screen.cn)
		
								IF VARTYPE(conhp) = "N" AND conhp > 0
		
									SQLEXEC(conhp, ;
										"INSERT INTO art_metricas (art_codi, estado) " + ;
										"VALUES (?lnArtEstado, 1) " + ;
										"ON DUPLICATE KEY UPDATE estado = 1;")
		
									desconectar_db(conhp)
								ENDIF
								*=================================================
								* BLOQUE ILUMET - DB EXTERNA
								*=================================================
								conilu = conectar_db(_screen.xconext)
								IF VARTYPE(conilu) = "N" AND conilu > 0
									SQLEXEC(conilu, ;
										"INSERT INTO art_metricas (art_codi, estado) " + ;
										"VALUES (?lnArtEstado, 1) " + ;
										"ON DUPLICATE KEY UPDATE estado = 1;")
									desconectar_db(conilu)
								ENDIF
							*-----------------------------------------------------
							* IGNORAR
							* Agrega igual y mantiene art_metricas.estado = 0
							* No toca la DB.
							*-----------------------------------------------------
							CASE lnRespEstado = 3
								* Sigue normal
						ENDCASE
					ENDIF
				ENDIF
				*-------------------------NUEVO HASTA AQUI-----------------------------------------*
				localiz=1
				SET POINT TO "."
				.grid1.col=8
				xaroc = val(.grid1.text)			
				.grid1.col=9
				xpen = ConverNro(.grid1.text)		
				if paso=1
					if dato1<>codigo AND xpen > 0
						MESSAGEBOX("El código que intenta cambiar ya fue recibido total o parcialmente."+CHR(13)+CHR(13)+ ;
		   						   "Imposible modificar",0+48,"Aviso del Sistema")
		   				thisform.modisi=0
		   			ELSE
		   				thisform.modisi=1
			   		ENDIF
					IF thisform.modisi=1
						.grid1.col=0
						.grid1.text=allt(str(aux))
						.grid1.col=1
						.grid1.text=allt(cant)
						.grid1.col=2
						.grid1.text=cur_arti.art_med
						.grid1.col=3
						cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
						.grid1.text=cadena
						.grid1.col=4
						if codigo<=5
							.grid1.text=allt(descrip)
						else
							.grid1.text=allt(descri)
						endif
						.grid1.col=5
						.grid1.text=allt(pruni)
						.grid1.col=6
						thisform.acu=thisform.acu-ConverNro(.grid1.text)
						.grid1.text=prtot
						if .text19.value>0
							auxiva=auxiva-(auxiva*.text19.value/100)
							auximpo=auximpo-(auximpo*.text19.value/100)
						ENDIF
						do case
							case cur_arti.art_alicuota=1
								if thisform.xcond=2
									if auxali=1
										thisform.impo1=thisform.impo1-auximpo
									else
										thisform.impo2=thisform.impo2-auximpo
									endif
								else
									if auxali=1
										thisform.acun1=thisform.acun1-auximpo
									else
										thisform.acun2=thisform.acun2-auximpo
									endif
								endif
							case cur_arti.art_alicuota=2
								if thisform.xcond=2
									if auxali=2
										thisform.impo2=thisform.impo2-auximpo
									else
										thisform.impo1=thisform.impo1-auximpo
									endif
								else
									if auxali=2
										thisform.acun2=thisform.acun2-auximpo
									else
										thisform.acun1=thisform.acun1-auximpo
									endif
								endif
						endcase
						thisform.acu=thisform.acu+ConverNro(prtot)
						.grid1.col=4
						if len(allt(.grid1.text))>47
							div=len(allt(.grid1.text))/47
							if div>int(div)
								longdes=int(div)+1
							else
								longdes=div
							endif
							longdes=longdes*240
							.grid1.rowheight(.grid1.row)=longdes
						else
							.grid1.rowheight(.grid1.row)=270
						ENDIF
						.grid1.col=7
						do case
							case cur_arti.art_alicuota=1
								.grid1.text=allt(str(thisform.impiva1,10,2))
							case cur_arti.art_alicuota=2
								.grid1.text=allt(str(thisform.impiva2,10,2))
						ENDCASE
						thisform.format_cells()
						IF dato1<>codigo
		*!*						IF !USED("cur_modic")
		*!*							CREATE CURSOR cur_modic(m_artcod N(8),m_artcan N(15,3))
		*!*						ENDIF
		*!*						INSERT INTO cur_modic values(dato1, ConverNro(dato2))
							UPDATE cur_penp SET art_codi = codigo, ant_pend = 0, act_pend = ConverNro(cant), actu = 1 ;
								 WHERE art_codi = dato1 AND artord_codi = xaroc
							IF dato1 > 5
								Campo_ppr(dato1)
							ENDIF
						ELSE
							UPDATE cur_penp SET act_pend = ConverNro(cant) - xpen, actu = 1 WHERE art_codi = codigo AND artord_codi = xaroc
						ENDIF
						codigo=0
						localiz=1
						paso=0			
					ENDIF
				ELSE
					if insertar=0
						thisform.nitem=thisform.nitem+1
						cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
						.grid1.additem(alltrim(str(thisform.nitem))+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+cadena+chr(9)+allt(descri)+chr(9)+allt(pruni)+chr(9)+prtot)
						.grid1.row=this.grid1.rows-1
						.grid1.col=4
						if len(allt(.grid1.text))>47
							div=len(allt(.grid1.text))/47
							if div>int(div)
								longdes=int(div)+1
							else
								longdes=div
							endif
							longdes=longdes*240
							.grid1.rowheight(.grid1.row)=longdes
						else
							.grid1.rowheight(.grid1.row)=270
						ENDIF
						.grid1.col=7
						do case
							case cur_arti.art_alicuota=1
								.grid1.text=allt(str(thisform.impiva1,10,2))
							case cur_arti.art_alicuota=2
								.grid1.text=allt(str(thisform.impiva2,10,2))
						ENDCASE
						thisform.format_cells()
						thisform.acu=thisform.acu+ConverNro(prtot)
						codigo=0
						localiz=1				
					endif
				ENDIF
				SET POINT TO 
			endwith
		endif
		if localiz=1 and thisform.nitem>0
		    thisform.totales(prtot,cur_arti.art_alicuota)
		    thisform.gridart_refresh()
		endif
		store 0 to localiz,muestro
		
	ENDPROC

	PROCEDURE buscar_pend
		LPARAMETERS xocpra
		
		frmaltac= conectar_db(_screen.cn)
			SQLEXEC(frmaltac,"SELECT art_codi, artord_codi, artord_cant-artord_ent ant_pend FROM compras_articulos where orden_codi = ?xocpra;","cur_cp")
		desconectar_db(frmaltac)
		
		SELECT art_codi, artord_codi, ant_pend, CAST("0" as numeric(15,3)) act_pend,0 actu FROM cur_cp INTO CURSOR cur_penp READWRITE
		cerrar_cursor("cur_cp")
		
		RETURN
		
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 8 of Modificaci .F.
		localiz=0
		thisform.nitem=0
		_screen.xopcpra=""
		
		IF PEMSTATUS(thisform, "xGridArtBound", 5)
		    =GridArt_Unbind(thisform)
		ENDIF
		
		on key label INS
	ENDPROC

	PROCEDURE format_cells
		WITH thisform
			.grid1.col=0
			.grid1.cellfontname="Courier New"
			.grid1.cellfontsize=8
			.grid1.cellalignment=3
			.grid1.col=1
			.grid1.cellfontname="Courier New"
			.grid1.cellfontsize=8
			.grid1.cellalignment=6
			.grid1.col=2
			.grid1.cellfontname="Courier New"
			.grid1.cellfontsize=8
			.grid1.cellalignment=3
			.grid1.col=3
			.grid1.cellfontname="Courier New"
			.grid1.cellfontsize=8
			.grid1.cellalignment=3
			.grid1.col=4
			.grid1.cellfontname="Courier New"
			.grid1.cellfontsize=8
			.grid1.cellalignment=0
			.grid1.col=5
			.grid1.cellfontname="Courier New"
			.grid1.cellfontsize=8
			.grid1.cellalignment=8
			.grid1.col=6
			.grid1.cellfontname="Courier New"
			.grid1.cellfontsize=8
			.grid1.cellalignment=8
			.grid1.col=7
			.grid1.cellfontname="Courier New"
			.grid1.cellfontsize=8
			.grid1.cellalignment=8
		ENDWITH
		
		RETURN
		
		
	ENDPROC

	PROCEDURE gridart_menu
		LOCAL lcShortcut
		IF thisform.grid1.Rows <= 1
		    RETURN
		ENDIF
		lcShortcut = SYS(2015)
		DEFINE POPUP (lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		=GridArt_AddStockMenuOption(lcShortcut, 1, thisform)
		=GridArt_AddStockMenuSeparator(lcShortcut, 2)
		=GridArt_AddListaComprasMenuOption(lcShortcut, 3)
		ACTIVATE POPUP (lcShortcut)
		RELEASE POPUP (lcShortcut)
		RETURN
	ENDPROC

	PROCEDURE gridart_refresh
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    thisform.gridart_setup()
		ELSE
		    =GridArt_ColorearGridActivex(thisform)
		ENDIF
		
		IF PEMSTATUS(thisform, "oStockPopForm", 5) AND VARTYPE(thisform.oStockPopForm) = "O"
		    =GridArt_RefrescarStockForm(thisform)
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE gridart_setup
		SET PROCEDURE TO grid_articulos_ui ADDITIVE
		
		IF !PEMSTATUS(thisform, "xGridArtBound", 5) OR !thisform.xGridArtBound
		    =GridArt_BindActiveX(thisform, "grid1", 3, 4)
		    =GridArt_BindTooltipEvents(thisform)
		ENDIF
		
		=GridArt_ColorearGridActivex(thisform)
		
		ON KEY LABEL ESC DO GridArt_OnEsc IN grid_articulos_ui
		
		RETURN
	ENDPROC

	PROCEDURE Init
		parameter codc,cond
		public elimi,aux,descrip,muestro,insertar,obser,cantreg,coditran,transporte, ;
		    	impiva1,impiva2,codiva,opcion,dato1,dato2,dato3,dato4,cant,descri, ;
				pruni,prtot,borra,alternati,localiz,ivaant,ivaact,iva,dato1, ;
				buscar,proveedor,paso,acu,lg,nitem
		set deleted on
		
		PUBLIC auximpo,auxiva,auxali
		LOCAL xmoneda
		
		store 0 to auxiva,auxali
		STORE 0 TO thisform.text8.value, ;
			       thisform.text9.value, ;
		           thisform.text10.value, ;
		           thisform.text11.value, ;
		           thisform.text17.value, ;
		 		   thisform.text18.value, ;
		 		   thisform.text19.value
		
		set deleted on
		thisform.xcond=cond
		thisform.nocpra=codc
		thisform.valorcadena=valorcadena
		
		STORE 0 TO acuaux, auxiva, ivadif, ivaitem, coditran, paso, thisform.acu, elimi, aux, insertar, ;
				   cantreg, borra, codigo
		
		STORE "" TO transporte, obser, descrip, prtot, pruni, proveedor
		
		frmmodicom= conectar_db(_screen.cn)
			SQLEXEC(frmmodicom,"select b.*,c.*,d.cond_desc from compras a inner join iva b on a.iva_codi=b.iva_codi inner join proveedores c on c.prov_codi=a.prov_codi inner join condiva d on c.cond_codi=d.cond_codi where a.orden_codi=?thisform.nocpra;","cur_datvar")
			SQLEXEC(frmmodicom,"select a.*,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on c.provi_codi=a.provi_codi where a.loca_codi=?cur_datvar.loca_codi;","cur_ubic")
		desconectar_db(frmmodicom)
		thisform.impiva1=cur_datvar.iva_1
		thisform.impiva2=cur_datvar.iva_2
		codiva=cur_datvar.iva_codi
		thisform.label12.caption=allt(str(thisform.impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(thisform.impiva2,10,2))+"%"
		
		SET DECIMALS TO 4
		frmmodicom= conectar_db(_screen.cn)
			SQLEXEC(frmmodicom,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dap_desc from compras_articulos a inner join articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_proveedores c on c.dap_codi=a.dap_codi where a.orden_codi=?thisform.nocpra order by a.artord_codi;","cur_arcom")
			SQLEXEC(frmmodicom,"select * from compras where orden_codi=?thisform.nocpra;","cur_cpra")
		desconectar_db(frmmodicom)
		SET DECIMALS TO
		
		thisform.buscar_pend(thisform.nocpra)
		
		thisform.nitem=1
		with thisform
			.text1.value=cur_datvar.prov_nomb
			.text2.value=cur_datvar.prov_domi
			auxcond=cur_datvar.cond_codi
			thisform.xcond=auxcond
			thisform.codiprov=cur_cpra.prov_codi
			.text3.value=cur_ubic.cp_nro
			.text4.value=cur_ubic.loca_nomb
			.text5.value=cur_ubic.provi_nomb
			.text6.value=cur_datvar.cond_desc
			.text12.value=VAL(cur_datvar.prov_cuit)
			.text13.value=cur_cpra.orden_fech
			.text19.value=cur_cpra.orden_dto
			.text20.value=cur_cpra.orden_ref
			.edit1.value=ALLTRIM(cur_cpra.orden_obser)
			thisform.xdolar=cur_cpra.cotiz_dolar
			coditran=cur_cpra.tran_codi
			xmoneda=cur_cpra.moneda
			DO case
				CASE UPPER(xmoneda) = 'D'
					thisform.ctn_moneda.chk_dolares.Value = 1
		*!*				thisform.letramon='D'
					_screen.moneocpra='D'
				CASE UPPER(xmoneda) = 'P'
					thisform.ctn_moneda.chk_pesos.Value=1
		*!*				thisform.letramon='P'
					_screen.moneocpra='P'
			ENDCASE
			frmmodicom= conectar_db(_screen.cn)
				SQLEXEC(frmmodicom,"select * from transportes where tran_codi=?coditran;","cur_tra")
			desconectar_db(frmmodicom)
			IF RECCOUNT("cur_tra")>0
				.text14.value=tran_nomb
			ENDIF
		
			SELECT cur_arcom
			GO top
			SCAN
				cadena=repl("0",8-len(allt(str(cur_arcom.art_codi))))+allt(str(cur_arcom.art_codi))
				if cur_arcom.art_codi<=5
					.grid1.additem(allt(str(thisform.nitem))+chr(9)+allt(str(cur_arcom.artord_cant,10,3))+chr(9)+ ;
					               allt(cur_arcom.art_med)+chr(9)+cadena+chr(9)+allt(cur_arcom.artord_dasc)+chr(9)+ ;
					               allt(str(cur_arcom.artord_precio,10,4))+chr(9)+ ;
							       allt(str(cur_arcom.artord_cant*cur_arcom.artord_precio,10,2))+CHR(9)+""+CHR(9)+ ;
							       ALLTRIM(STR(cur_arcom.artord_codi))+CHR(9)+STR(cur_arcom.artord_ent,10,3))
					.grid1.row=this.grid1.rows-1
					this.grid1.col=7
					do case
						case cur_arcom.art_alicuota=1
							this.grid1.text=allt(str(thisform.impiva1,10,2))
						case cur_arcom.art_alicuota=2
							this.grid1.text=allt(str(thisform.impiva2,10,2))
					endcase
				else
					.grid1.additem(allt(str(thisform.nitem))+chr(9)+allt(str(cur_arcom.artord_cant,10,3))+chr(9)+ ;
								   allt(cur_arcom.art_med)+chr(9)+cadena+chr(9)+allt(cur_arcom.art_desc)+chr(9)+ ;
								   allt(str(cur_arcom.artord_precio,10,4))+chr(9)+ ;
								   allt(str(cur_arcom.artord_cant*cur_arcom.artord_precio,10,2))+CHR(9)+""+CHR(9)+ ;
								   ALLTRIM(STR(cur_arcom.artord_codi))+CHR(9)+STR(cur_arcom.artord_ent,10,3))
					if cur_arcom.dap_codi>0
						.grid1.col=4
						.grid1.row=thisform.nitem
						.grid1.text=allt(cur_arcom.dap_desc)
					ENDIF
					.grid1.row=this.grid1.rows-1
					this.grid1.col=7
					do case
						case cur_arcom.art_alicuota=1
							this.grid1.text=allt(str(thisform.impiva1,10,2))
						case cur_arcom.art_alicuota=2
							this.grid1.text=allt(str(thisform.impiva2,10,2))
					endcase
				ENDIF
				.grid1.row=this.grid1.rows-1
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					cantreg=cantreg+longdes
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				ELSE
					cantreg=cantreg+1
					.grid1.rowheight(.grid1.row)=270
				endif		
				prtot=allt(str(cur_arcom.artord_cant*cur_arcom.artord_precio,10,2))
				thisform.format_cells()
				thisform.acu=thisform.acu+(cur_arcom.artord_cant*cur_arcom.artord_precio)
				thisform.totales(prtot,cur_arcom.art_alicuota)
				thisform.nitem=thisform.nitem+1		
			ENDSCAN
		endwith
		if thisform.nitem>1
			thisform.nitem=thisform.nitem-1
		ENDIF
		
		thisform.gridart_setup()
	ENDPROC

	PROCEDURE Load
		set skip of bar 8 of Modificaci .T.
	ENDPROC

	PROCEDURE LostFocus
		*if valorcadena<>"Ordenes Compra"
		*	set skip of bar 8 of Modificaci .F.
		*	thisform.hide
		*	localiz=0
		*	item=0
		*endif
	ENDPROC

	PROCEDURE pesifica_dolariza
		LPARAMETERS xopcmon
		
		SET POINT TO ","
		with thisform
			LOCAL ivaencol,xmone,xcotiz,xcanti,xcodpd
			STORE 0 TO thisform.acu,auxiva,auximpo,auxali
			STORE 0 TO thisform.impo1, ;
					   thisform.impo2, ;
					   thisform.acu1, ;
					   thisform.acu2, ;
					   thisform.acun1, ;
					   thisform.acun2
			STORE 0 TO .text8.value, ;
				       .text9.value, ;
			           .text10.value, ;
			           .text11.value, ;
			           .text17.value, ;
			           .text18.value
		
			xcotiz= thisform.xdolar
		
			FOR n=1 TO .grid1.rows-1
				.grid1.row=n
				.grid1.col=3
				xcodpd=VAL(.grid1.text)
				frmaltac= conectar_db(_screen.cn)
					SQLEXEC(frmaltac,"select * from articulos where art_codi = ?xcodpd;","cur_arti")
				desconectar_db(frmaltac)
				.grid1.col=1
				xcanti=ConverNro(.grid1.text)
				.grid1.col=5
				valor1=ConverNro(.grid1.text)
				valor2=ROUND(ICASE(xopcmon=1,valor1/xcotiz,xopcmon=2,valor1*xcotiz),3)
				.grid1.text=ALLTRIM(STR(valor2,15,3))
				xtotal = (xcanti*valor2)
				.grid1.col=6
				.grid1.text=ALLTRIM(STR(xtotal,15,2))
				thisform.acu=thisform.acu+xtotal
				thisform.totales(STR(xtotal,15,3), cur_arti.art_alicuota)
			NEXT n
			if paso>0
				paso=0
			endif
		ENDWITH
		SET POINT TO
	ENDPROC

	PROCEDURE totales
		LPARAMETERS ximpo, xalicuo
		
		WITH thisform
			.text8.value=ROUND(thisform.acu,2)
			.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
			.text18.value=ROUND(.text8.value-.text17.value,2)
			if .text19.value>0
				do case
					case xalicuo=1
						.grid1.col=6
						thisform.impo1=thisform.impo1+(ConverNro(ximpo)*((100-.text19.value)/100))
						if thisform.xcond=2
							IF auxiva>0
								.text9.value=.text9.value-auxiva
							ENDIF
							.text9.value=ROUND(.text9.value+(ConverNro(ximpo)*((100-.text19.value)/100)*thisform.impiva1/100),2)
						endif
					case xalicuo=2
						.grid1.col=6
						thisform.impo2=thisform.impo2+(ConverNro(ximpo)*((100-.text19.value)/100))
						if thisform.xcond=2
							IF auxiva>0
								.text11.value=.text11.value-auxiva
							ENDIF
							.text11.value=ROUND(.text11.value+(ConverNro(ximpo)*((100-.text19.value)/100)*thisform.impiva2/100),2)
						endif
				endcase
			else
				do case
					case xalicuo=1
						.grid1.col=6
						thisform.impo1=thisform.impo1+ConverNro(ximpo)
						if thisform.xcond=2
							IF auxiva>0
								.text9.value=.text9.value-auxiva
							ENDIF
							.text9.value=ROUND(.text9.value+((ConverNro(ximpo))*thisform.impiva1/100),2)
						endif
					case xalicuo=2
						.grid1.col=6
						thisform.impo2=thisform.impo2+ConverNro(ximpo)
						if thisform.xcond=2
							IF auxiva>0
								.text11.value=.text11.value-auxiva
							ENDIF
							.text11.value=ROUND(.text11.value+((ConverNro(ximpo))*thisform.impiva2/100),2)
						endif
				endcase
			endif
			.text10.value=ROUND(.text18.value+.text9.value+.text11.value,2)
			auxiva=0
			auximpo=0
		ENDWITH
		
		RETURN
		
	ENDPROC

	PROCEDURE btn_deta.Click
		IF LEN(ALLTRIM(cur_prov.prov_deta)) > 0
			MESSAGEBOX(ALLTRIM(cur_prov.prov_deta),64,"Detalles Adicionales del Proveedor")
		ELSE
			MESSAGEBOX("No hay detalles ingresados para este proveedor",48,"Detalles Adicionales del Proveedor")
		ENDIF
		
	ENDPROC

	PROCEDURE Check1.Click
		IF this.Value=1
			coditran=0
			thisform.text14.Value=''
		ELSE
			IF coditran=0
				this.Value=1
			endif
		endif
		
	ENDPROC

	PROCEDURE cmd_modiprov.Click
		prem=MESSAGEBOX("¿MODIFICA PROVEEDOR PARA ESTA ORDEN DE COMPRA?",4+48+256,"Aviso del Sistema")
		IF prem=6
			codiprov=thisform.codiprov
			DO FORM provload WITH proveedor,codiprov
			IF codiprov>0
				thisform.codiprov=codiprov
				auxcond=cur_datvar.cond_codi
				UPDATE cur_datvar SET prov_codi   =cur_prov.prov_codi, ;
									  prov_nomb   =cur_prov.prov_nomb, ;
									  prov_domi   =cur_prov.prov_domi, ;
									  prov_cuit   =cur_prov.prov_cuit, ;
									  prov_cartel =cur_prov.prov_cartel, ;
									  prov_tel1   =cur_prov.prov_tel1, ;
									  prov_tel2   =cur_prov.prov_tel2, ;
									  prov_cel    =cur_prov.prov_cel, ;
									  prov_email  =cur_prov.prov_email, ;
									  loca_codi   =cur_prov.loca_codi, ;
									  cond_codi   =cur_prov.cond_codi, ;
									  cond_desc   =cur_prov.cond_desc
				frmmodicom= conectar_db(_screen.cn)
					SQLEXEC(frmmodicom,"select a.*,b.cp_nro,c.provi_nomb from localidades a inner join codipostales b on a.cp_codi=b.cp_codi inner join provincias c on c.provi_codi=a.provi_codi where a.loca_codi=?cur_datvar.loca_codi;","cur_ubic")
				desconectar_db(frmmodicom)
				codiva=cur_datvar.iva_codi
				WITH thisform
					.text1.value=cur_datvar.prov_nomb
					.text2.value=cur_datvar.prov_domi
					cond=cur_datvar.cond_codi
					thisform.xcond=cond
					.text3.value=cur_ubic.cp_nro
					.text4.value=cur_ubic.loca_nomb
					.text5.value=cur_ubic.provi_nomb
					.text6.value=cur_datvar.cond_desc
					.text12.value=VAL(cur_datvar.prov_cuit)
					LOCAL itgrid,ivgrilla,cangrilla,pru
					itgrid=thisform.grid1.rows-1
					ivgrilla=0
					pru=0
					IF auxcond<>cond
						STORE 0 TO thisform.acu,auxiva,auximpo,auxali
						STORE 0 TO thisform.impo1, ;
								   thisform.impo2, ;
								   thisform.acu1, ;
								   thisform.acu2, ;
								   thisform.acun1, ;
								   thisform.acun2
						STORE 0 TO thisform.text8.value, ;
							       thisform.text9.value, ;
						           thisform.text10.value, ;
						           thisform.text11.value, ;
						           thisform.text17.value, ;
				 		           thisform.text18.value
				 		thisform.text8.ForeColor=RGB(255,255,255)
				 		thisform.text9.ForeColor=RGB(255,255,255)
				 		thisform.text10.ForeColor=RGB(255,255,255)
				 		thisform.text11.ForeColor=RGB(255,255,255)
				 		thisform.text17.ForeColor=RGB(255,255,255)
				 		thisform.text18.ForeColor=RGB(255,255,255)
						IF thisform.xcond=2
							thisform.acu=0
							FOR i=1 TO itgrid
								.grid1.row=i
								.grid1.col=3
								frmmodicom= conectar_db(_screen.cn)
									SQLEXEC(frmmodicom,"select art_alicuota from articulos where art_codi=?VAL(.grid1.text);","cur_ali")
								desconectar_db(frmmodicom)
								.grid1.col=1
								cangrilla=ConverNro(.grid1.text)
								.grid1.col=7
								ivgrilla=ConverNro(.grid1.text)
								.grid1.col=5
								.grid1.text=STR(ConverNro(.grid1.text)/(1+(ivgrilla/100)),10,3)
								pru=cangrilla*ConverNro(.grid1.text)
								.grid1.col=6
								.grid1.text=STR(pru,10,2)
								thisform.acu=thisform.acu+pru
								.text8.value=thisform.acu
								.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
								.text18.value=.text8.value-.text17.value
								thisform.totales(pru, cur_ali.art_alicuota)
								.text10.value=.text18.value+.text9.value+.text11.value							
							NEXT i
						ELSE
							thisform.acu=0
							FOR i=1 TO itgrid
								.grid1.row=i
								.grid1.col=3
								frmmodicom= conectar_db(_screen.cn)
									SQLEXEC(frmmodicom,"select art_alicuota from articulos where art_codi=?VAL(.grid1.text);","cur_ali")
								desconectar_db(frmmodicom)
								.grid1.col=1
								cangrilla=ConverNro(.grid1.text)
								.grid1.col=7
								ivgrilla=ConverNro(.grid1.text)
								.grid1.col=5
								.grid1.text=STR(ConverNro(.grid1.text)*(1+(ivgrilla/100)),10,3)
								pru=cangrilla*ConverNro(.grid1.text)
								.grid1.col=6
								.grid1.text=STR(pru,10,2)
								thisform.acu=thisform.acu+pru
								.text8.value=thisform.acu
								.text17.value=iif(.text19.value>0,round((thisform.acu*.text19.value)/100,2),0)
								.text18.value=.text8.value-.text17.value
								thisform.totales(pru, cur_ali.art_alicuota)
								.text10.value=.text18.value+.text9.value+.text11.value				
							NEXT i				
						ENDIF
					ENDIF
				ENDWITH
			ENDIF
			thisform.text8.ForeColor=RGB(0,0,0)
			thisform.text9.ForeColor=RGB(0,0,0)
			thisform.text10.ForeColor=RGB(0,0,0)
			thisform.text11.ForeColor=RGB(0,0,0)
			thisform.text17.ForeColor=RGB(0,0,0)
			thisform.text18.ForeColor=RGB(0,0,0)
		ENDIF
		
	ENDPROC


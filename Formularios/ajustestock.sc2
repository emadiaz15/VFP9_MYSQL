	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		public codigo,nombre
		set dele on
		codigo=0
		nombre=""
		this.text1.value=0
		this.text3.value=0
	ENDPROC

	PROCEDURE Command1.Click
		do form artload with codigo,nombre
		with thisform
			if codigo>0
				.text1.value=codigo
				.text2.value=nombre
				.text3.readonly=.F.
				.text3.setfocus
			else
				.text1.setfocus
			endif
		endwith
	ENDPROC

	PROCEDURE Command2.Click
		do case
			case thisform.olecontrol1.rows=1
				messagebox("Aún no ha ingresado ningún artículo",0+48,"Advertencia")
				thisform.text1.setfocus
			case thisform.optiongroup1.value=0
				messagebox("Debe indicar si es una Entrada o una Salida",0+48,"Advertencia")
			other case
				LOCAL ajunro, lnLock
				STORE 0 TO ajunro, lnLock
				with thisform
					frmaju= conectar_db(_screen.cn)
					    lnLock = MySQL_LockTables("LOCK", "ajustes WRITE", frmaju)
						SQLEXEC(frmaju,"select MAX(aju_codi) as aju_codi from ajustes order by aju_codi;","cur_naju")
					desconectar_db(frmaju)
					IF ISNULL(cur_naju.aju_codi)
						ajunro=1
					ELSE
						ajunro=cur_naju.aju_codi+1
					ENDIF
					LOCAL xconc,xobs
					do case
						case .optiongroup1.value=1
							xconc="E"
						case .optiongroup1.value=2
							xconc="S"
					ENDCASE
					xobs=ALLTRIM(.edit1.value)
					frmaju= conectar_db(_screen.cn)
						SQLEXEC(frmaju,"insert into ajustes values(?ajunro,?DATE(),?xconc,?xobs);")
						lnLock = MySQL_LockTables("UNLOCK", "", frmaju)
					desconectar_db(frmaju)
					LOCAL xcodi,xcanti,stact,saldst
					for x=1 to .olecontrol1.rows-1
						.olecontrol1.row=x
						.olecontrol1.col=0
						xcodi=val(.olecontrol1.text)
						.olecontrol1.col=2
						xcanti=ConverNro(.olecontrol1.text)
						frmaju= conectar_db(_screen.cn)
							SQLEXEC(frmaju,"insert into ajustes_articulos values(?ajunro,?xcodi,?xcanti);")
						desconectar_db(frmaju)
						do case
							case .optiongroup1.value=1
								SET DECIMALS TO 3
								frmaju= conectar_db(_screen.cn)
									SQLEXEC(frmaju,"select art_stock from articulos where art_codi = ?xcodi;","cur_stact")
									stact=cur_stact.art_stock
									saldst=stact+xcanti
									SQLEXEC(frmaju,"update articulos set art_stock=art_stock+?xcanti where art_codi=?xcodi")
									SQLEXEC(frmaju,"insert into histostock values(null,?xcodi,current_date(),current_time(),'E',?stact,?xcanti,?saldst,'AJUSTE DE STOCK',?xobs,?ajunro,0,0,0,0,0,0);")
								desconectar_db(frmaju)
								**************************** SE CONECTA AL SERVIDOR ILUMET Y SI EXISTE EL ARTICULO MODIFICA STOCK E HISTORICO **********************************
								conexterna= conectar_db(_screen.xconext)
								IF VARTYPE(conexterna) = "N" AND conexterna> 0
									SQLEXEC(conexterna,"select * from articulos where art_codi = ?xcodi;","cur_artext")
									IF USED("cur_artext")
										IF RECCOUNT("cur_artext") > 0
											SQLEXEC(conexterna,"select art_stock from articulos where art_codi = ?xcodi;","cur_stact")
											stact=cur_stact.art_stock
											saldst=stact+xcanti
											SQLEXEC(conexterna,"update articulos set art_stock=art_stock+?xcanti where art_codi=?xcodi")
											SQLEXEC(conexterna,"insert into histostock values(null,?xcodi,current_date(),current_time(),'E',?stact,?xcanti,?saldst,'AJUSTE DE STOCK HP',?xobs,?ajunro,0,0,0,0,0,0);")
										ENDIF
										cerrar_cursor("cur_artext")
									ENDIF
									desconectar_db(conexterna)
								ENDIF
								*************************** FIN PROCESO SERVIDOR ILUMET *****************************************
								SET DECIMALS TO
								cerrar_cursor("cur_stact")
							case .optiongroup1.value=2
								SET DECIMALS TO 3
								frmaju= conectar_db(_screen.cn)
									SQLEXEC(frmaju,"select art_stock from articulos where art_codi = ?xcodi;","cur_stact")
									stact=cur_stact.art_stock
									saldst=stact-xcanti
									SQLEXEC(frmaju,"update articulos set art_stock=art_stock-?xcanti where art_codi=?xcodi;")
									SQLEXEC(frmaju,"insert into histostock values(null,?xcodi,current_date(),current_time(),'S',?stact,-?xcanti,?saldst,'AJUSTE DE STOCK',?xobs,?ajunro,0,0,0,0,0,0);")
								desconectar_db(frmaju)
								**************************** SE CONECTA AL SERVIDOR ILUMET Y SI EXISTE EL ARTICULO MODIFICA STOCK E HISTORICO **********************************
								conexterna= conectar_db(_screen.xconext)
								IF VARTYPE(conexterna) = "N" AND conexterna> 0
									SQLEXEC(conexterna,"select * from articulos where art_codi = ?xcodi;","cur_artext")
									IF USED("cur_artext")
										IF RECCOUNT("cur_artext") > 0
											SQLEXEC(conexterna,"select art_stock from articulos where art_codi = ?xcodi;","cur_stact")
											stact=cur_stact.art_stock
											saldst=stact-xcanti
											SQLEXEC(conexterna,"update articulos set art_stock=art_stock-?xcanti where art_codi=?xcodi;")
											SQLEXEC(conexterna,"insert into histostock values(null,?xcodi,current_date(),current_time(),'S',?stact,-?xcanti,?saldst,'AJUSTE DE STOCK HP',?xobs,?ajunro,0,0,0,0,0,0);")
										ENDIF
										cerrar_cursor("cur_artext")
									ENDIF
									desconectar_db(conexterna)
								ENDIF
								*************************** FIN PROCESO SERVIDOR ILUMET *****************************************
								SET DECIMALS TO
								cerrar_cursor("cur_stact")
						ENDCASE
					next x
					.optiongroup1.value=0
					.text1.value=0
					.text2.value=""
					.text3.value=0
					.edit1.value=""
					.olecontrol1.rows=1
					.text1.setfocus
				endwith
		ENDCASE
		cerrar_cursor("cur_araj")
		cerrar_cursor("cur_naju")
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Olecontrol1.DblClick
		*** ActiveX Control Event ***
		
		lnOption = MsgboxEx(;
		   "Qué desea hacer con el ítem seleccionado?", ;
		   "?", ;
		   "Ajustes de Stock", ;
		   "&Modificar,&Eiminar,&Cancelar")
		DO case
			CASE lnOption = 1
				this.col=0
				thisform.text1.value = VAL(this.text)
				this.col=1
				thisform.text2.Value = ALLTRIM(this.text)
				this.col=2
				thisform.text3.Value = ConverNro(this.text)
				thisform.estamodif=1
				thisform.text1.SetFocus
			CASE lnOption = 2
				LOCAL xarti,xdesc,fdel,xopaju
				this.col=0
				xarti=ALLTRIM(this.text)
				this.col=1
				xdesc=ALLTRIM(this.text)
				xopaju=MESSAGEBOX("¿Confirma la eliminación del artículo "+xdesc+" código "+xarti+"?",4+48+256,"Aviso del Sistema")
				IF xopaju=6
					fdel=this.row
					IF this.rows=2
						this.rows = 1
					ELSE
						thisform.olecontrol1.removeItem(fdel)
					ENDIF
				ENDIF
				thisform.text1.SetFocus
		ENDCASE
		
	ENDPROC

	PROCEDURE Optiongroup1.Click
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.Valid
		if this.value>0
			frmaju= conectar_db(_screen.cn)
				SQLEXEC(frmaju,"select * from articulos where art_codi=?this.value;","cur_araj")
			desconectar_db(frmaju)
			if RECCOUNT("cur_araj")>0
				thisform.text2.value=cur_araj.art_desc
				thisform.text3.readonly=.F.
			else
				messagebox("Artículo no está en archivo",0+48,"Advertencia")
				return 0
			endif
		endif
	ENDPROC

	PROCEDURE Text3.LostFocus
		if this.value>0
			with thisform
				cadena=repl("0",8-len(allt(str(.text1.value))))+allt(str(.text1.value))
				IF thisform.estamodif=1
					.olecontrol1.col=0
					.olecontrol1.text=cadena
					.olecontrol1.col=1
					.olecontrol1.text=allt(.text2.value)
					.olecontrol1.col=2
					.olecontrol1.text=str(this.value,15,3)
					thisform.estamodif=0
					IF (thisform.olecontrol1.rows-1)>1
						thisform.olecontrol1.toprow=thisform.olecontrol1.rows-1
					ENDIF			
				ELSE
					IF (thisform.olecontrol1.rows-1)>1
						thisform.olecontrol1.toprow=thisform.olecontrol1.rows-1
					ENDIF
					.olecontrol1.additem(cadena+chr(9)+allt(.text2.value)+chr(9)+str(this.value,15,3))
				ENDIF
				.text1.value=0
				.text2.value=""
				this.value=0
				this.readonly=.T.
				.text1.setfocus
			endwith
		else
			thisform.text1.setfocus
		endif
		
	ENDPROC

ENDDEFINE

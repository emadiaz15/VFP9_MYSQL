DEFINE CLASS recepreg AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Image1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command3" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BorderStyle = 0
		Caption = "Recepciones"
		DoCreate = .T.
		Height = 134
		Icon = imagen\litening.ico
		MaxButton = .F.
		Name = "RECEPREG"
		ShowWindow = 1
		Width = 444
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		Caption = "\<Modificar Item", ;
		Height = 25, ;
		Left = 34, ;
		Name = "Command1", ;
		Top = 85, ;
		Width = 109
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command2' AS commandbutton WITH ;
		Caption = "\<Eliminar Item", ;
		Height = 25, ;
		Left = 154, ;
		Name = "Command2", ;
		Top = 85, ;
		Width = 121
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command3' AS commandbutton WITH ;
		Caption = "\<Insertar Item", ;
		Height = 25, ;
		Left = 287, ;
		Name = "Command3", ;
		Top = 85, ;
		Width = 121
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Image1' AS image WITH ;
		BorderStyle = 1, ;
		Height = 33, ;
		Left = 115, ;
		Name = "Image1", ;
		Picture = imagen\w95mbx02.ico, ;
		Stretch = 2, ;
		Top = 29, ;
		Width = 33
		*< END OBJECT: BaseClass="image" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		Caption = "¿Qué desea hacer?", ;
		FontSize = 10, ;
		Height = 18, ;
		Left = 171, ;
		Name = "Label1", ;
		Top = 38, ;
		Width = 116
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Activate
		if prompt()="Presupuestos de Clientes" or prompt()="Presupuestos Clientes"
			this.caption="Presupuestos"
		endif
	ENDPROC

	PROCEDURE Command1.Click
		do case
			case prompt()="Recepciones"
				with altarecep
					.grid1.col=0
					.text2.value=alltrim(.grid1.text)
					.grid1.col=1
					.text3.value=.grid1.text
					.grid1.col=2
					.text4.value=.grid1.text
					.text4.setfocus
					.grid1.visible=.F.
					.cmdguar.enabled=.F.
					.cmdload.enabled=.T.
					.label4.visible=.F.
					.setall("Format",'RK',"Textbox")
				endwith
			case prompt()="Presupuestos de Clientes"
				with altapresup
					.grid1.col=0
					aux=val(.grid1.text)
					.grid1.col=3
					dato1=val(.grid1.text)
					.grid1.col=1
					dato2=.grid1.text
					.grid1.col=4
					dato3=.grid1.text
					.grid1.col=5
					dato4=.grid1.text
					.grid1.col=2
				endwith
				paso=1
				descrip=dato3
				if altapresup.grid1.text="ALTERN"
					do form alternapresup with dato1,dato3,dato4
				else
					do form cualart with dato1,dato2,dato3,dato4
				endif
			case prompt()="Presupuestos Clientes"
				with modipresup
					.grid1.col=0
					aux=val(.grid1.text)
					.grid1.col=3
					dato1=val(.grid1.text)
					.grid1.col=1
					dato2=.grid1.text
					.grid1.col=4
					dato3=.grid1.text
					.grid1.col=5
					dato4=.grid1.text
					.grid1.col=2
				endwith
				paso=1
				descrip=dato3
				if modipresup.grid1.text="ALTERN"
					do form alternapresup with dato1,dato3,dato4
				else
					do form cualart with dato1,dato2,dato3,dato4
				endif
			case prompt()="Pedidos de Clientes"
				with pedicli
					.grid1.col=0
					aux=val(.grid1.text)
					.grid1.col=3
					dato1=val(.grid1.text)
					.grid1.col=1
					dato2=.grid1.text
					.grid1.col=4
					dato3=.grid1.text
					.grid1.col=5
					dato4=.grid1.text
				endwith
				paso=1
				do form cualart with dato1,dato2,dato3,dato4
		endcase
		thisform.release
		
		
		
	ENDPROC

	PROCEDURE Command2.Click
		do case
			case prompt()="Recepciones"
				with altarecep
					if .grid1.rows=2
						.grid1.col=0
						.grid1.text=""
						.grid1.col=1
						.grid1.text=""
						.grid1.col=2
						.grid1.text=""
						paso=0
					else
						altarecep.grid1.removeitem(altarecep.grid1.row)
					endif
				endwith
			case prompt()="Presupuestos de Clientes"
				borra=messagebox("¿Seguro que desea eliminar este Ítem?",4+32+256,"Presupuestos")
				if borra=6
				with altapresup
					.grid1.col=0
					if item>1
						item=item-1
					endif
					nro=val(.grid1.text)
					.grid1.col=3
					select presupuestos_articulos
					use presupuestos_articulos exclusive
					set order to artpres
					seek allt(str(.text7.value))+allt(.grid1.text)
					if found()
						dele
						pack
					endif
					.grid1.col=6
					acu=acu-val(.grid1.text)
					if nro=1 and .grid1.rows=2
						.grid1.col=0
						.grid1.text=""
						.grid1.col=1
						.grid1.text=""
						.grid1.col=2
						.grid1.text=""
						.grid1.col=3
						.grid1.text=""
						.grid1.col=4
						.grid1.text=""
						.grid1.col=5
						.grid1.text=""
						.grid1.col=6
						.grid1.text=""
						item=0
						elimi=1
					else
						.grid1.removeitem(nro)
						do while nro<=item
							.grid1.row=str(nro)
							.grid1.col=0
							.grid1.text=nro
							nro=nro+1
						enddo
					endif
				endwith
				else
					thisform.release
				endif
			case prompt()="Pedidos de Clientes"
				with pedicli
					.grid1.col=0
					if item>1
						item=item-1
					endif
					nro=val(.grid1.text)
					.grid1.col=6
					acu=acu-val(.grid1.text)
					if nro=1 and .grid1.rows=2
						.grid1.col=0
						.grid1.text=""
						.grid1.col=1
						.grid1.text=""
						.grid1.col=2
						.grid1.text=""
						.grid1.col=3
						.grid1.text=""
						.grid1.col=4
						.grid1.text=""
						.grid1.col=5
						.grid1.text=""
						.grid1.col=6
						.grid1.text=""
						item=0
						elimi=1
					else
						.grid1.removeitem(nro)
						do while nro<=item
							.grid1.row=str(nro)
							.grid1.col=0
							.grid1.text=nro
							nro=nro+1
						enddo
					endif
				endwith
		endcase
		thisform.release
	ENDPROC

	PROCEDURE Command3.Click
		do case
		*	case prompt()="Recepciones"
		*		with altarecep
		*			if .grid1.rows=2
		*				.grid1.col=0
		*				.grid1.text=""
		*				.grid1.col=1
		*				.grid1.text=""
		*				.grid1.col=2
		*				.grid1.text=""
		*				paso=0
		*			else
		*				altarecep.grid1.removeitem(altarecep.grid1.row)
		*			endif
		*		endwith
			case prompt()="Presupuestos de Clientes"
				with altapresup
					insertar=1
					.grid1.col=0
					nro=val(.grid1.text)
					do form cualart
					do while nro<=item
						.grid1.row=str(nro)
						.grid1.col=0
						.grid1.text=nro
						nro=nro+1
					enddo
				endwith
			case prompt()="Pedidos de Clientes"
				with pedicli
					.grid1.col=0
					if item>1
						item=item-1
					endif
					nro=val(.grid1.text)
					.grid1.col=6
					acu=acu-val(.grid1.text)
					if nro=1 and .grid1.rows=2
						.grid1.col=0
						.grid1.text=""
						.grid1.col=1
						.grid1.text=""
						.grid1.col=2
						.grid1.text=""
						.grid1.col=3
						.grid1.text=""
						.grid1.col=4
						.grid1.text=""
						.grid1.col=5
						.grid1.text=""
						.grid1.col=6
						.grid1.text=""
						item=0
						elimi=1
					else
						.grid1.removeitem(nro)
						do while nro<=item
							.grid1.row=str(nro)
							.grid1.col=0
							.grid1.text=nro
							nro=nro+1
						enddo
					endif
				endwith
		endcase
		thisform.release
	ENDPROC

ENDDEFINE

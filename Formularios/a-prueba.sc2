DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Tree" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdExpandAll" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCollapseAll" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Imagelist" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		Caption = "Plan de Cuentas"
		DoCreate = .T.
		Height = 630
		Icon = ..\imagen\vbe7_1251.ico
		Name = "Form1"
		ShowTips = .T.
		Width = 582
	*</PropValue>

	ADD OBJECT 'cmdCollapseAll' AS commandbutton WITH ;
		Caption = "-", ;
		FontBold = .F., ;
		FontName = "Courier New", ;
		FontSize = 11, ;
		Height = 18, ;
		Left = 512, ;
		Name = "cmdCollapseAll", ;
		TabIndex = 3, ;
		ToolTipText = "Colapsar Todos", ;
		Top = 23, ;
		Width = 15
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdExpandAll' AS commandbutton WITH ;
		Caption = "+", ;
		FontBold = .F., ;
		FontName = "Courier New", ;
		FontSize = 11, ;
		Height = 18, ;
		Left = 495, ;
		Name = "cmdExpandAll", ;
		TabIndex = 2, ;
		ToolTipText = "Expandir Todos", ;
		Top = 23, ;
		Width = 15
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Imagelist' AS olecontrol WITH ;
		Height = 100, ;
		Left = 0, ;
		Name = "Imagelist", ;
		Top = 588, ;
		Width = 100
		*< END OBJECT: BaseClass="olecontrol" OLEObject="c:\windows\syswow64\mscomctl.ocx" Value="" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackColor = 255,255,255, ;
		Height = 592, ;
		Left = 36, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;
		Top = 19, ;
		Width = 509
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Tree' AS olecontrol WITH ;
		Height = 552, ;
		Left = 51, ;
		Name = "Tree", ;
		TabIndex = 1, ;
		Top = 45, ;
		Width = 478
		*< END OBJECT: BaseClass="olecontrol" OLEObject="c:\windows\syswow64\mscomctl.ocx" Value="" />
	
	PROCEDURE Init
		thisform.tree.Object.ImageList = thisform.ImageList.Object
		
		IF  fontmetric(1, 'MS Sans Serif', 8, '') # 13 OR ;
			fontmetric(4, 'MS Sans Serif', 8, '') # 2 OR ;
			fontmetric(6, 'MS Sans Serif', 8, '') # 5 OR ;
			fontmetric(7, 'MS Sans Serif', 8, '') # 11
			this.setall('fontname', 'Tahoma')  
		ELSE
			this.setall('fontname','MS Sans Serif')
		ENDIF
		this.setall('fontsize',8)
		
		frmtree= conectar_db(_screen.cn)
			SQLEXEC(frmtree,"select * from plan_cuentas;","cur_cuentas")
		desconectar_db(frmtree)
		o = thisform.tree.Object
		
		GO top
		SCAN
			IF cur_cuentas.pc_impu <> 'SI'
				oNode = o.nodes.add(,1,ALLTRIM(cur_cuentas.pc_cuenta),ALLTRIM(cur_cuentas.pc_cuenta)+ALLTRIM(cur_cuentas.pc_desc),1,1)
				oNode.Bold = .T.
			ELSE
				oNode = o.nodes.add(ALLTRIM(cur_cuentas.pc_ctamad),4,ALLTRIM(cur_cuentas.pc_cuenta), ALLTRIM(cur_cuentas.pc_cuenta)+ALLTRIM(cur_cuentas.pc_desc),1,1)
			ENDIF
		ENDSCAN
		o.Sorted = .T.
		this.cmdexpandAll.Click()
	ENDPROC

	PROCEDURE cmdCollapseAll.Click
		o = THISFORM.Tree
		
		thisform.lockscreen = .t.
		o.visible = .f.
		
		FOR i = 1 TO o.Nodes.Count
			o.Nodes(i).Expanded = .F.
		ENDFOR
		
		o.visible = .t.
		thisform.lockscreen = .f.
		o.Sorted = .T.
	ENDPROC

	PROCEDURE cmdExpandAll.Click
		LOCAL lnIndex
		o = THISFORM.Tree
		thisform.lockscreen = .t.
		o.visible = .f.
		
		FOR i = 1 TO o.Nodes.Count
			o.Nodes(i).Expanded = .T.
		ENDFOR
		
		o.visible = .t.
		thisform.lockscreen = .f.
		
		lnIndex=1
		IF TYPE("THISFORM.Tree.SelectedItem.Index")="N"
			lnIndex = THISFORM.Tree.SelectedItem.Index
			THISFORM.Tree.SelectedItem =;
				 THISFORM.Tree.Nodes(1)
		ENDIF
		THISFORM.Tree.SelectedItem =;
		 THISFORM.Tree.Nodes(lnIndex)
		o.Sorted = .T.
	ENDPROC

	PROCEDURE Tree.DblClick
		*** ActiveX Control Event ***
		*!*	IF THISFORM.cmdRun.Enabled
		*!*		THISFORM.cmdRun.SetFocus
		*!*		THISFORM.cmdRun.Click
		*!*	ENDIF
	ENDPROC

	PROCEDURE Tree.GotFocus
		*!*	ON KEY LABEL F1 HELP ID _SCREEN.ActiveForm.HelpContextID
	ENDPROC

	PROCEDURE Tree.LostFocus
		*!*	ON KEY LABEL F1
	ENDPROC

	PROCEDURE Tree.NodeClick
		*** ActiveX Control Event ***
		LPARAMETERS node
		*!*	SELECT cur_cuentas
		*!*	LOCATE FOR pc_cuenta = node.pc_cuenta
		*!*	IF EMPTY(file)
		*!*		THISFORM.cmdRun.Enabled = .F.
		*!*		THISFORM.cmdSee.Enabled = .F.
		*!*	ELSE
		*!*		THISFORM.cmdRun.Enabled = .T.
		*!*		THISFORM.cmdSee.Enabled = .T.
		*!*	ENDIF
		*!*	THISFORM.Refresh
	ENDPROC

ENDDEFINE

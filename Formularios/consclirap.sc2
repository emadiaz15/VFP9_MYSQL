	PROCEDURE Destroy
		set skip of bar 9 of Consultas .F.
		set point to
		set separator to
	ENDPROC

	PROCEDURE GotFocus
		set point to ","
		set separator to "."
	ENDPROC

	PROCEDURE Init
		parameter codicli
		*public localiz,postal,locali,provi,op,codloca,cp,codicli
		set dele on
		*localiz=0
		*postal=0
		*locali=""
		*provi=""
		*codloca=0
		*op=0
		*codicli=0
		set point to ","
		set separator to "."
		*thisform.text12.value=cli_saldo
		frmconcr= conectar_db(_screen.cn)
			SQLEXEC(frmconcr,"call usp_buscarcli(?codicli);","cur_clie")
			SQLEXEC(frmconcr,"select * from zonas where zona_codi=?cur_clie.zona_codi;","cur_zon")
		desconectar_db(frmconcr)
		
		this.text11.inputmask=repl("9",1+len(allt(cur_clie.cli_cartel)))
		this.text14.Value    =ALLTRIM(cur_zon.zona_desc)
		this.text12.Value    =cur_clie.cli_saldo-cur_clie.cli_favor
		
		IF LEN(ALLTRIM(cur_clie.cli_deta))>0
			this.Height=558
			thisform.command1.Top = 517
			this.label16.Visible= .T.
			this.shape2.Visible= .T.
			this.edt_deta.Visible= .T.
			this.command1.SetFocus
		ELSE
			this.Height=430
			thisform.command1.Top = 391
			this.label16.Visible= .F.
			this.shape2.Visible= .F.
			this.edt_deta.Visible= .F.
		ENDIF
		thisform.AutoCenter= .T.
			
	ENDPROC

	PROCEDURE Load
		set skip of bar 9 of Consultas .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if prompt()<>"Datos Clientes"
		*!*		set skip of bar 9 of Consultas .F.
		*!*		thisform.hide
		*!*	endif
		
		set point to
		set separator to
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE edt_deta.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE edt_deta.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Text4.LostFocus
		if this.value<>" "
			sele provincias
			set order to provi_nomb
			seek allt(this.value)
			if !found()
				set order to provi_codi
				go bott
				pro=provi_codi+1
				appe blank
				repla provi_codi with pro
				repla provi_nomb with allt(this.value)
				sele localidades
				repla provi_codi with pro
			else
				sele localidades
				repla provi_codi with provincias.provi_codi
				sele provincias
				set order to provi_codi
			endif
		endif
	ENDPROC

	PROCEDURE Text4.Valid
		if this.value=" " and last()<>-4
			messagebox("Debe ingresar la Provincia",0+48,"Advertencia!!!")
			return 0
		endif
	ENDPROC

ENDDEFINE


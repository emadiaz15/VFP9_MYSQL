	PROCEDURE Activate
		SET POINT TO
		SET SEPARATOR to
		
	ENDPROC

	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		public proveedor,codigo,histcod
		SET POINT TO
		SET SEPARATOR to
		proveedor=""
		codiprov=0
		codigo=0
		histcod=0
		do form provload with proveedor,codiprov
		thisform.codiprov=codiprov
		if thisform.codiprov>0
			this.text1.value=cur_prov.prov_nomb
		ENDIF
		this.text2.value=0
		this.text4.value=0
		this.text5.value=0
		frmaltacos= conectar_db(_screen.cn)
			SQLEXEC(frmaltacos,"select param_impo from parametros where param_codi=10;","cur_dtoadi")
		desconectar_db(frmaltacos)
		this.text2.setfocus
		
	ENDPROC

	PROCEDURE chk_cotiz.Click
		IF this.Value=1
			thisform.artpro_cos=0
			frmaltacos= conectar_db(_screen.cn)
				SQLEXEC(frmaltacos,"select a.*,b.prov_nomb from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.cotiz=1 and a.art_codi=?thisform.text2.value;","cur_haycos")
			desconectar_db(frmaltacos)
			IF RECCOUNT("cur_haycos")>0
				prg= MESSAGEBOX("Este artículo ya tiene asignado el costo "+ALLTRIM(STR(cur_haycos.artpro_ctovta,10,3))+ ;
				                " del Proveedor "+ALLTRIM(cur_haycos.prov_nomb)+" para la Cotizaciones."+CHR(13)+CHR(13)+ ;
				                "¿Confirma asignar este nuevo costo para las Cotizaciones?",4+48+256,"Aviso del Sistema")
				IF prg=6
					thisform.artpro_cos=cur_haycos.artpro_codi
					thisform.estadocos=1
					thisform.xselcot=1
				ELSE
					thisform.estadocos=0
					this.Value=0
					thisform.xselcot=0
				ENDIF
			ELSE
				thisform.estadocos=0
				thisform.xselcot=1
			ENDIF
			cerrar_cursor("cur_haycos")
		ELSE
			thisform.estadocos=0
			thisform.xselcot=0
		ENDIF
	ENDPROC

	PROCEDURE chk_lista.Click
		IF this.Value=1
			thisform.artpro_lis=0
			frmaltacos= conectar_db(_screen.cn)
				SQLEXEC(frmaltacos,"select a.*,b.prov_nomb from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.lista=1 and a.art_codi=?thisform.text2.value;","cur_haycos")
			desconectar_db(frmaltacos)
			IF RECCOUNT("cur_haycos")>0
				prg= MESSAGEBOX("Este artículo ya tiene asignado el costo "+ALLTRIM(STR(cur_haycos.artpro_ctovta,10,3))+ ;
				                " del Proveedor "+ALLTRIM(cur_haycos.prov_nomb)+" para las Listas de Precios."+CHR(13)+CHR(13)+ ;
				                "¿Confirma asignar este nuevo costo para las listas de precios?",4+48+256,"Aviso del Sistema")
				IF prg=6
					thisform.artpro_lis=cur_haycos.artpro_codi
					thisform.estadolis=1
					thisform.xselprec=1
				ELSE
					thisform.estadolis=0
					this.Value=0
					thisform.xselprec=0
				ENDIF
			ELSE
				thisform.estadolis=0
				thisform.xselprec=1
			ENDIF
			cerrar_cursor("cur_haycos")
		ELSE
			thisform.estadolis=0
			thisform.xselprec=0
		ENDIF
	ENDPROC

	PROCEDURE cmd_guarcos.Click
		IF thisform.text4.value>0
			SET DECIMALS TO 3
			******************** ESTABLECE PRIMERO LA CONEXIÓN AL SERVIDOR ILUMET Y ACTIVA BLOQUEO DE TABLA **********************
			LOCAL lnLock2, conexterna
			conexterna= conectar_db(_screen.xconext)
			lnLock2 = MySQL_LockTables("LOCK", "articulos_proveedores WRITE, histocosto WRITE", conexterna)
			************************ FIN PROCESO SERVIDOR ILUMET ********************************	
			frmaltacos= conectar_db(_screen.cn)
				LOCAL mon,xcot,xlis, lnLock
				lnLock = 0
				mon=''
				STORE 0 TO xcot,xlis
				lnLock = MySQL_LockTables("LOCK", "articulos_proveedores WRITE, histocosto WRITE", frmaltacos)
				SQLEXEC(frmaltacos,"select * from articulos_proveedores where prov_codi=?thisform.codiprov and art_codi=?thisform.text2.value;","cur_arpro")
				if RECCOUNT("cur_arpro")>0
					xlis=thisform.xselprec
					xcot=thisform.xselcot
					do case
						case thisform.optiongroup1.value=1
							mon='P'
							SQLEXEC(frmaltacos,"update articulos_proveedores set moneda='P',lista=?xlis,cotiz=?xcot where artpro_codi=?cur_arpro.artpro_codi;")
							************************* ACTUALIZA LA MONEDA EN EL SERVIDOR ILUMET *****************
							IF VARTYPE(conexterna)="N" AND conexterna>0
								SQLEXEC(conexterna,"update articulos_proveedores set moneda='P',lista=?xlis,cotiz=?xcot where artpro_codi=?cur_arpro.artpro_codi;")
							ENDIF
							************************ FIN PROCESO SERVIDOR ILUMET ******************************					
						case thisform.optiongroup1.value=2
							mon='D'
							SQLEXEC(frmaltacos,"update articulos_proveedores set moneda='D',lista=?xlis,cotiz=?xcot where artpro_codi=?cur_arpro.artpro_codi;")
							************************* ACTUALIZA LA MONEDA EN EL SERVIDOR ILUMET *****************
							IF VARTYPE(conexterna)="N" AND conexterna>0
								SQLEXEC(conexterna,"update articulos_proveedores set moneda='D',lista=?xlis,cotiz=?xcot where artpro_codi=?cur_arpro.artpro_codi;")
							ENDIF
							************************ FIN PROCESO SERVIDOR ILUMET ******************************					
					ENDCASE
					if thisform.text4.value<>cur_arpro.artpro_costo
						SQLEXEC(frmaltacos,"update articulos_proveedores set artpro_costo=?thisform.text4.value,artpro_ctovta=?thisform.text5.value,lista=?xlis,cotiz=?xcot where artpro_codi=?cur_arpro.artpro_codi;")
						SQLEXEC(frmaltacos,"select CAST(histo_codi+1 as decimal(8,0)) as histo_codi from histocosto order by histo_codi desc limit 1;","cur_nuehis")
						thisform.nhisto=cur_nuehis.histo_codi
						SQLEXEC(frmaltacos,"insert into histocosto values(?cur_nuehis.histo_codi,?DATETIME(),?thisform.text4.value,?thisform.text5.value,?cur_arpro.artpro_codi,?mon);")
						************************* ACTUALIZA COSTO E INGRESA NUEVO HISTORICO DE COSTO EN SERVIDOR ILUMET *****************
						IF VARTYPE(conexterna)="N" AND conexterna>0
							SQLEXEC(conexterna,"update articulos_proveedores set artpro_costo=?thisform.text4.value,artpro_ctovta=?thisform.text5.value,lista=?xlis,cotiz=?xcot where artpro_codi=?cur_arpro.artpro_codi;")
							SQLEXEC(conexterna,"select CAST(histo_codi+1 as decimal(8,0)) as histo_codi from histocosto order by histo_codi desc limit 1;","cur_nuehis2")
							SQLEXEC(conexterna,"insert into histocosto values(?cur_nuehis2.histo_codi,?DATETIME(),?thisform.text4.value,?thisform.text5.value,?cur_arpro.artpro_codi,?mon);")
						ENDIF
						************************ FIN PROCESO SERVIDOR ILUMET ******************************					
					endif
				ELSE
					IF thisform.estadolis=1
						SQLEXEC(frmaltacos,"update articulos_proveedores set lista=0 where artpro_codi=?thisform.artpro_lis;")
						************************* ACTUALIZA CAMPO LISTA EN SERVIDOR ILUMET **********************
						IF VARTYPE(conexterna)="N" AND conexterna>0
							SQLEXEC(conexterna,"update articulos_proveedores set lista=0 where artpro_codi=?thisform.artpro_lis;")
						ENDIF
						************************* FIN PROCESO SERVIDOR ILUMET ***********************************
					ENDIF
					IF thisform.estadocos=1
						SQLEXEC(frmaltacos,"update articulos_proveedores set cotiz=0 where artpro_codi=?thisform.artpro_cos;")
						************************* ACTUALIZA CAMPO COTIZ EN SERVIDOR ILUMET **********************
						IF VARTYPE(conexterna)="N" AND conexterna>0
							SQLEXEC(conexterna,"update articulos_proveedores set cotiz=0 where artpro_codi=?thisform.artpro_cos;")
						ENDIF
						************************* FIN PROCESO SERVIDOR ILUMET *****************************				
					ENDIF
					xlis=thisform.xselprec
					xcot=thisform.xselcot
					do case
						case thisform.optiongroup1.value=1
							mon="P"
						case thisform.optiongroup1.value=2
							mon="D"
					ENDCASE
					SQLEXEC(frmaltacos,"select CAST(artpro_codi+1 as decimal(8,0)) as artpro_codi from articulos_proveedores order by artpro_codi desc limit 1;","cur_nuear")
					SQLEXEC(frmaltacos,"insert into articulos_proveedores values(?cur_nuear.artpro_codi,?thisform.text2.value,?thisform.codiprov,?thisform.text4.value,?thisform.text5.value,'',?mon,?xlis,0,?xcot);")
					SQLEXEC(frmaltacos,"select CAST(histo_codi+1 as decimal(8,0)) as histo_codi from histocosto order by histo_codi desc limit 1;","cur_nuehis")
					thisform.nhisto=cur_nuehis.histo_codi
					SQLEXEC(frmaltacos,"insert into histocosto values(?cur_nuehis.histo_codi,?DATETIME(),?thisform.text4.value,?thisform.text5.value,?cur_nuear.artpro_codi,?mon);")
					SQLEXEC(frmaltacos,"select * from articulos_proveedores where prov_codi=?thisform.codiprov and art_codi=?thisform.text2.value;","cur_arpro")
					***************************** AGREGA NUEVO COSTO E HISTÓRICO DE COSTO EN SERVIDOR ILUMET ***************************
						IF VARTYPE(conexterna)="N" AND conexterna>0
							SQLEXEC(conexterna,"select CAST(artpro_codi+1 as decimal(8,0)) as artpro_codi from articulos_proveedores order by artpro_codi desc limit 1;","cur_nuear2")
							SQLEXEC(conexterna,"insert into articulos_proveedores values(?cur_nuear2.artpro_codi,?thisform.text2.value,?thisform.codiprov,?thisform.text4.value,?thisform.text5.value,'',?mon,?xlis,0,?xcot);")
							SQLEXEC(conexterna,"select CAST(histo_codi+1 as decimal(8,0)) as histo_codi from histocosto order by histo_codi desc limit 1;","cur_nuehis2")
							SQLEXEC(conexterna,"insert into histocosto values(?cur_nuehis2.histo_codi,?DATETIME(),?thisform.text4.value,?thisform.text5.value,?cur_nuear2.artpro_codi,?mon);")
						ENDIF
					***************************** FIN PROCESO SERVIDOR ILUMET *********************************************************
				ENDIF
				lnLock = MySQL_LockTables("UNLOCK", "", frmaltacos)
			desconectar_db(frmaltacos)
		
			********************** DESACTIVA BLOQUEO DE TABLA EN SERVIDOR ILUMET Y CIERRA LA CONEXIÓN ********************************
			IF VARTYPE(conexterna)="N" AND conexterna>0
				lnLock2 = MySQL_LockTables("UNLOCK", "", conexterna)
				desconectar_db(conexterna)
			ENDIF
			************************ FIN DE PROCESO SERVIDOR ILUMET *******************************************
			
			SET DECIMALS TO
			STORE 0 TO thisform.text4.Value,thisform.text5.Value,thisform.optiongroup1.Value,thisform.chk_lista.Value,thisform.chk_cotiz.Value,thisform.text2.Value
			thisform.text3.Value=''
			thisform.text2.SetFocus
			STORE 0 TO thisform.artpro_cos,thisform.artpro_lis,thisform.estadocos,thisform.estadolis,thisform.xselcot,thisform.xselprec
			this.Enabled= .F.
			thisform.chk_lista.Enabled= .F.
			thisform.chk_cotiz.Enabled= .F.
			thisform.command2.Enabled= .T.
		endif
	ENDPROC

	PROCEDURE cmd_guarcos.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE cmd_guarcos.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command1.Click
		codigo=0
		do form artload with codigo
		if codigo>0
			SET DECIMALS TO 3
			frmaltacos= conectar_db(_screen.cn)
				SQLEXEC(frmaltacos,"select * from articulos_proveedores where prov_codi=?codiprov and art_codi=?codigo;","cur_arpro")
			desconectar_db(frmaltacos)
			SET DECIMALS TO
			if RECCOUNT("cur_arpro")>0
				with thisform
					.text2.value=cur_arpro.art_codi
					.text3.value=cur_art.art_desc
					.text4.value=cur_arpro.artpro_costo
					.text5.value=cur_arpro.artpro_ctovta
				endwith
			else
				with thisform
					.text2.value=cur_art.art_codi
					.text3.value=cur_art.art_desc
					.text4.value=0
				endwith
			endif
			thisform.text4.setfocus
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		proveedor=""
		codiprov=0
		do form provload with proveedor,codiprov
		
		thisform.codiprov=codiprov
		with thisform
			if thisform.codiprov>0
				.text1.value=cur_prov.prov_nomb
			endif
			.text2.setfocus
		endwith
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.GotFocus
		if last()=4 or last()=5 or last()=19 or last()=24
			thisform.text2.setfocus
		endif
		
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Optiongroup1.Option1.Click
		thisform.text4.setfocus
	ENDPROC

	PROCEDURE Optiongroup1.Option1.GotFocus
		if last()=4 or last()=5 or last()=19 or last()=24
			thisform.text2.setfocus
		endif
		
	ENDPROC

	PROCEDURE Optiongroup1.Option2.Click
		thisform.text4.setfocus
	ENDPROC

	PROCEDURE Optiongroup1.Option2.GotFocus
		if last()=4 or last()=5 or last()=19 or last()=24
			thisform.text2.setfocus
		endif
		
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.KeyPress
		PARAMETERS nKeyCode, nShiftAltCtrl
		*!*	do case
		*!*		case nkeycode=19 or nkeycode=24
		*!*			sele articulos
		*!*			set order to art_codi
		*!*			if this.value=0
		*!*				go bott
		*!*			else
		*!*				seek this.value
		*!*				if found() and !bof()
		*!*					skip-1
		*!*				else
		*!*					go bott
		*!*				endif
		*!*			endif
		*!*			with thisform
		*!*				this.value=art_codi
		*!*				.text3.value=art_desc
		*!*				sele articulos_proveedores
		*!*				set order to artprov
		*!*				seek str(codiprov)+str(this.value)
		*!*				if found()
		*!*					.text4.value=artpro_costo
		*!*					do case
		*!*						case moneda="P"
		*!*							.optiongroup1.value=1
		*!*						case moneda="D"
		*!*							.optiongroup1.value=2
		*!*						other case
		*!*							.optiongroup1.value=0
		*!*					endcase
		*!*				else
		*!*					.text4.value=0
		*!*				endif
		*!*			endwith
		*!*		case nkeycode=4 or nkeycode=5
		*!*			sele articulos
		*!*			set order to art_codi
		*!*			if this.value=0
		*!*				go top
		*!*			else
		*!*				seek this.value
		*!*				if found() and !eof()
		*!*					skip
		*!*				else
		*!*					go top
		*!*				endif
		*!*			endif
		*!*			with thisform
		*!*				this.value=art_codi
		*!*				.text3.value=art_desc
		*!*				sele articulos_proveedores
		*!*				set order to artprov
		*!*				seek str(codiprov)+str(this.value)
		*!*				if found()
		*!*					.text4.value=artpro_costo
		*!*					do case
		*!*						case moneda="P"
		*!*							.optiongroup1.value=1
		*!*						case moneda="D"
		*!*							.optiongroup1.value=2
		*!*						other case
		*!*							.optiongroup1.value=0
		*!*					endcase
		*!*				else
		*!*					.text4.value=0
		*!*				endif
		*!*			endwith		
		*!*	endcase
		
	ENDPROC

	PROCEDURE Text2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
	ENDPROC

	PROCEDURE Text2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
	ENDPROC

	PROCEDURE Text2.Valid
		if this.value>0
			SET DECIMALS TO 3
			frmaltacos= conectar_db(_screen.cn)
				SQLEXEC(frmaltacos,"select a.*,b.art_desc from articulos_proveedores a inner join articulos b on a.art_codi=b.art_codi where a.prov_codi=?thisform.codiprov and a.art_codi=?this.value;","cur_arpro")
			desconectar_db(frmaltacos)
			SET DECIMALS TO
			if RECCOUNT("cur_arpro")>0
				with thisform
					.text2.value=cur_arpro.art_codi
					.text3.value=cur_arpro.art_desc
					.text4.value=cur_arpro.artpro_costo
					.text5.value=cur_arpro.artpro_ctovta
					do case
						case moneda="P"
							.optiongroup1.value=1
						case moneda="D"
							.optiongroup1.value=2
						other case
							.optiongroup1.value=0
					endcase
				endwith
			else
				frmaltacos= conectar_db(_screen.cn)
					SQLEXEC(frmaltacos,"select * from articulos where art_codi=?this.value;","cur_art")
				desconectar_db(frmaltacos)
				if RECCOUNT("cur_art")>0
					with thisform
						.text2.value=cur_art.art_codi
						.text3.value=cur_art.art_desc
						.text4.value=0
					endwith
				else
					messagebox("Artículo no está en archivo",0+48,"Advertencia")
					this.value=0
					return 0
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Text4.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text4.LostFocus
		if this.value>0
			thisform.text5.Value=this.value/((100-cur_dtoadi.param_impo)/100)
			thisform.cmd_guarcos.Enabled= .T.
			thisform.command2.Enabled= .F.
			thisform.chk_lista.Enabled= .T.
			thisform.chk_cotiz.Enabled= .T.
		ENDIF
	ENDPROC

	PROCEDURE Text5.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text5.LostFocus
		*!*	if this.value>0
		*!*		SET DECIMALS TO 3
		*!*		frmaltacos= conectar_db(_screen.cn)
		*!*			LOCAL mon
		*!*			mon=''
		*!*			do case
		*!*				case thisform.optiongroup1.value=1
		*!*					mon='P'
		*!*					SQLEXEC(frmaltacos,"update articulos_proveedores set moneda='P' where artpro_codi=?cur_arpro.artpro_codi;")
		*!*				case thisform.optiongroup1.value=2
		*!*					mon='D'
		*!*					SQLEXEC(frmaltacos,"update articulos_proveedores set moneda='D' where artpro_codi=?cur_arpro.artpro_codi;")
		*!*			endcase
		*!*			if this.value<>cur_arpro.artpro_ctovta
		*!*				SQLEXEC(frmaltacos,"update articulos_proveedores set artpro_ctovta=?this.value where artpro_codi=?cur_arpro.artpro_codi;")
		*!*				SQLEXEC(frmaltacos,"update histocosto set histo_ctovta=?this.value,moneda=?mon where histo_codi=?thisform.nhisto;")
		*!*			endif
		*!*		desconectar_db(frmaltacos)
		*!*		STORE 0 TO thisform.text4.Value, ;
		*!*				   thisform.text5.Value, ;
		*!*				   thisform.text2.Value
		*!*		thisform.text3.Value=''
		*!*		thisform.optiongroup1.value=0
		*!*		SET DECIMALS TO
		*!*		thisform.text2.setfocus
		*!*	ELSE
		*!*		thisform.text2.setfocus
		*!*	endif
	ENDPROC

ENDDEFINE


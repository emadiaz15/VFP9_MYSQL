	PROCEDURE Activate
		if localiz=1
			with thisform
				acuaux=0
				auxiva=0
				ivadif=0
				ivaitem=0
				acu=0
				for i=1 to .grid1.rows-1
					.grid1.row=i
					.grid1.col=7
					if len(.grid1.text)>0
						ivaitem=val(.grid1.text)
						.grid1.col=6
						if .text19.value>0
							dto=val(.grid1.text)*.text19.value/100
							acuaux=acuaux+val(.grid1.text)-dto
							dto=val(.grid1.text)-dto
							ivaitem=dto*ivaitem/100
						else
							acuaux=acuaux+val(.grid1.text)
							ivaitem=val(.grid1.text)*ivaitem/100
						endif
						ivadif=ivadif+ivaitem
					else
						.grid1.col=6
						acu=acu+val(.grid1.text)
					endif
				next i
				.text8.value=str(acu+acuaux,10,2)
				if cond=2
					dto=0
					if .text19.value>0
						dto=(acu+acuaux)*.text19.value/100
					endif
					acutot=acu+acuaux
					dife=acutot-acuaux-dto
					auxiva=dife*impiva1/100
					.text9.value=str(auxiva+ivadif,10,2)
				endif
				.text17.value=str((acu+acuaux)*.text19.value/100,10,2)
				.text18.value=str(acu+acuaux-val(.text17.value),10,2)
				.text10.value=str(val(.text18.value)+val(.text9.value)+val(.text11.value),10,2)
			endwith
		endif
		store 0 to localiz
		thisform.grid1.toprow=1
		
	ENDPROC

	PROCEDURE Destroy
		set skip of bar 5 of Consultas .F.
		on key label INS
		localiz=0
		item=0
	ENDPROC

	PROCEDURE Init
		parameter codped,cond
		public elimi,descrip,muestro,opcion,transporte,dato1,dato2,dato3, ;
		       dato4,codigo,cant,descri,pruni,prtot,insertar,impiva1,impiva2, ;
		       borra,codicli,codiva,codp,coditran1,coditran2,auxcond,localiz
		set deleted on
		transporte=" "
		coditran1=0
		coditran2=0
		codp=0
		paso=0
		acu=0
		elimi=0
		localiz=0
		muestro=0
		descrip=""
		opcion=0
		insertar=0
		borra=0
		codicli=0
		codigo=0
		this.text19.value=0
		sele iva
		go bott
		impiva1=iva_1
		impiva2=iva_2
		codiva=iva_codi
		thisform.label12.caption=allt(str(impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(impiva2,10,2))+"%"
		sele pedidos_articulos
		set order to ped_codi
		seek codped
		item=1
		with thisform
			.text1.value=clientes.cli_nomb
			.text2.value=clientes.cli_domi
			auxcond=clientes.cond_codi
			.text3.value=codipostales.cp_nro
			.text4.value=localidades.loca_nomb
			.text5.value=provincias.provi_nomb
			.text6.value=condiva.cond_desc
			.text12.value=clientes.cli_cuit
			.text23.value="0"+allt(str(clientes.cli_cartel))+"-"+allt(str(clientes.cli_tel1))
			.text13.value=pedidos.ped_fech
			.text19.value=pedidos.ped_dto
			if pedidos.presup_codi>0
				.label5.caption="Corresp.Presup.Nº"
				.text7.value=pedidos.presup_codi
				codp=pedidos.presup_codi
			else
				.text7.value=pedidos.notaped_nro
			endif
			.text15.value=ped_codi
			sele pedidos_transportes
			if ped_codi=codped
				coditran1=tran_codi
				.text14.value=transportes.tran_nomb
				do case
					case flete_cargo="C"
						.opcionflete1.value=1
					case flete_cargo="P"
						.opcionflete1.value=2
				endcase
				.edit1.value=flete_lugent
				skip
				if ped_codi=codped
					coditran2=tran_codi
					.text24.value=transportes.tran_nomb
					do case
						case flete_cargo="C"
							.opcionflete2.value=1
						case flete_cargo="P"
							.opcionflete2.value=2
					endcase
					.edit2.value=flete_lugent
				endif
			endif
			sele pedidos_articulos
			.text16.value=vendedores.ven_codi
			.text20.value=vendedores.ven_nomb
			if pedidos.porc_codi>0
				.text21.value=porcencomi.porc_desc
				.text22.value=porcencomi.porc_impo
			else
				.text22.value=pedidos.otra_comi
			endif
			do while ped_codi=codped
				cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
				if art_codi=4
					.grid1.additem(allt(str(item))+chr(9)+allt(str(artped_cant,10,2))+chr(9)+allt(articulos.art_med)+chr(9)+cadena+chr(9)+allt(artped_dasc)+chr(9)+allt(str(artped_precio,10,3))+chr(9)+allt(str(artped_cant*artped_precio,10,2)))
				else
					.grid1.additem(allt(str(item))+chr(9)+allt(str(artped_cant,10,2))+chr(9)+allt(articulos.art_med)+chr(9)+cadena+chr(9)+allt(articulos.art_desc)+chr(9)+allt(str(artped_precio,10,3))+chr(9)+allt(str(artped_cant*artped_precio,10,2)))
					if dac_codi>0
						.grid1.col=4
						.grid1.row=item
						.grid1.text=allt(desc_articulos_clientes.dac_desc)
					endif
				endif
				if alter_iva>0
					.grid1.col=7
					.grid1.row=item
					.grid1.text=allt(str(alter_iva,5,2))
				endif
				.grid1.row=this.grid1.rows-1
				.grid1.col=4
				if len(allt(.grid1.text))>47
					div=len(allt(.grid1.text))/47
					if div>int(div)
						longdes=int(div)+1
					else
						longdes=div
					endif
					longdes=longdes*240
					.grid1.rowheight(.grid1.row)=longdes
				else
					.grid1.rowheight(.grid1.row)=270
				endif
				.grid1.col=0
				.grid1.cellalignment=3
				.grid1.col=1
				.grid1.cellalignment=3
				.grid1.col=2
				.grid1.cellalignment=3
				.grid1.col=3
				.grid1.cellalignment=3
				.grid1.col=4
				.grid1.cellalignment=0
				.grid1.col=5
				.grid1.cellalignment=8
				.grid1.col=6
				.grid1.cellalignment=8		
				acu=acu+(artped_cant*artped_precio)
				item=item+1			
				skip
			enddo
		endwith
		if item>1
			item=item-1
		endif
		localiz=1
	ENDPROC

	PROCEDURE Load
		set skip of bar 5 of Consultas .T.
	ENDPROC

	PROCEDURE LostFocus
		if valorcadena<>"Pedidos por Cliente"
			set skip of bar 5 of Consultas .F.
			thisform.hide
			localiz=0
			item=0
		endif
	ENDPROC

	PROCEDURE Command1.Click
		DIMENSION tra[2,3]
		store "" to tra
		sele transportes
		set order to tran_nomb
		seek allt(thisform.text14.value)
		if found()
			tra[1,1]=allt(tran_nomb)
		endif
		with thisform
			tra[1,2]=allt(.edit1.value)
			tra[1,3]=iif(.opcionflete1.value=1,"C",iif(.opcionflete1.value=2,"P",""))
			sele transportes
			seek allt(thisform.text24.value)
			if found()
				tra[2,1]=allt(tran_nomb)
			endif
			tra[2,2]=allt(.edit2.value)
			tra[2,3]=iif(.opcionflete2.value=1,"C",iif(.opcionflete2.value=2,"P",""))
		endwith
		sele pedidos
		set order to ped_codi
		seek codped
		if pedidos.notaped_nro>0
			preg=messagebox("Este pedido fue dado de alta por Nota de Pedido."+chr(13)+ ;
							"¿Imprime igualmente?",4+48+256,"Advertencia")
			if preg=6
				with thisform
					ivari=val(.text9.value)
					ivarni=val(.text11.value)
					totalri=val(.text18.value)+val(.text9.value)
					totalrni=val(.text18.value)+val(.text9.value)+val(.text11.value)
					totsiva=val(.text18.value)
				endwith
				report form a-pedidocliente for pedidos.ped_codi=codped preview noconsole
			endif
		else
			with thisform
				ivari=val(.text9.value)
				ivarni=val(.text11.value)
				totalri=val(.text18.value)+val(.text9.value)
				totalrni=val(.text18.value)+val(.text9.value)+val(.text11.value)
				totsiva=val(.text18.value)
			endwith
			report form a-pedidocliente for pedidos.ped_codi=codped preview noconsole
		endif
		
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.Click
		sele pedidos_articulos
		set order to ped_codi
		seek codped
		codicli=clientes.cli_codi
		do form pediload with codicli
		thisform.release
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Edit2.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit2.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Text1.GotFocus
		*if localiz<>1
		*	if muestro=0
		*		sele clientes
		*		set order to cli_nomb
		*		do form cliload with codicli
		*		with pedicli
		*			.text1.value=clientes.cli_nomb
		*			.text2.value=clientes.cli_domi
		*			.text3.value=postal
		*			.text4.value=locali
		*			.text5.value=provi
		*			.text6.value=condiva.cond_desc
		*			.text12.value=clientes.cli_cuit
		*		endwith					
		*		cond=cond_codi
		*		set order to cli_codi
		*	endif
		*endif
		if localiz=1
			thisform.grid1.toprow=item
		endif
	ENDPROC

	PROCEDURE Text16.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text16.Valid
		if this.value>0
			sele vendedores
			set order to ven_codi
			seek this.value
			if found()
				thisform.text16.value=allt(ven_nomb)
			else
				=messagebox("Vendedor no está en archivo",0+48,"Advertencia!!!")
				this.value=0
				return 0
			endif
		else
			thisform.text16.value=""
		endif
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			local acuaux,auxiva,ivadif,ivaitem
			acuaux=0
			auxiva=0
			ivadif=0
			ivaitem=0
			for i=1 to .grid1.rows-1
				.grid1.row=i
				.grid1.col=7
				if len(.grid1.text)>0
					ivaitem=val(.grid1.text)
					.grid1.col=6
					dto=val(.grid1.text)*this.value/100
					acuaux=acuaux+val(.grid1.text)-dto
					dto=val(.grid1.text)-dto
					ivaitem=dto*ivaitem/100
					ivadif=ivadif+ivaitem
				endif
			next i
			dtotot=acu*this.value/100
			.text17.value=str(dtotot,10,2)
			.text18.value=str(acu-dtotot,10,2)
			if clientes.cond_codi=2
				dife=acu-dtotot-acuaux
				auxiva=dife*impiva1/100
				.text9.value=str(auxiva+ivadif,10,2)
			endif
			.text10.value=str(val(.text18.value)+val(.text9.value)+val(.text11.value),10,2)
		endwith
		
		
	ENDPROC

	PROCEDURE Text21.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text21.Valid
		if this.value<>""
			sele porcencomi
			set order to porc_desc
			seek allt(this.value)
			if found()
				porcodi=porc_codi
				thisform.text21.value=porc_impo
			else
				=messagebox("Porcentaje de Comisión no está en archivo",0+48,"Advertencia!!!")
				this.value=""
				return 0
			endif
		else
			thisform.text21.value=0
			porodi=0
		endif
	ENDPROC

	PROCEDURE Text22.Click
		this.setfocus
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="1" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Cursor1" UniqueID="" Timestamp="" />

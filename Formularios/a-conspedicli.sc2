	*</PropValue>

	ADD OBJECT 'Cursor1' AS cursor WITH ;
		Alias = "articulos", ;
		CursorSource = "articulos", ;
		Database = base - hp.dbc, ;
		Height = 168, ;
		Left = 295, ;

		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor10' AS cursor WITH ;
		Alias = "codipostales", ;
		CursorSource = "codipostales", ;
		Database = base - hp.dbc, ;
		Height = 90, ;
		Left = 616, ;
		Name = "Cursor10", ;
		Top = 341, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor11' AS cursor WITH ;
		Alias = "provincias", ;
		CursorSource = "provincias", ;

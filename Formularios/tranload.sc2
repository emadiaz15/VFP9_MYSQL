		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'txttranload' AS textbox WITH ;
		BackColor = 232,232,232, ;
		FontBold = .T., ;
		Format = "!", ;
		Height = 23, ;
		Left = 43, ;
		Name = "txttranload", ;
		TabIndex = 1, ;
		Top = 50, ;
		Width = 674
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		*!*	public f
		ft=1
		*!*	sele transportes
		*!*	set order to tran_nomb
		*!*	go top
		thisform.lsttran.requery
		thisform.txttranload.setfocus
		
	ENDPROC

	PROCEDURE Init
		parameter transporte,coditran
		set exact off
		
		public cade,ft
		cade=""
		
		LOCAL xcoditran
		xcoditran=0
		
		frmtranlo= conectar_db(_screen.cn)
			SQLEXEC(frmtranlo,"call usp_buscartran(?xcoditran);","cur_tran")
		desconectar_db(frmtranlo)
		 
		thisform.lsttran.RowSource="cur_tran"
	ENDPROC

	PROCEDURE LostFocus
		set skip of bar 4 of Altas .T.
	ENDPROC

	PROCEDURE Unload
		return transporte
		return coditran
	ENDPROC

	PROCEDURE Command1.Click
		do form altatrans
	ENDPROC

	PROCEDURE Command1.GotFocus
		if last()=24 or last()=5
			thisform.txttranload.setfocus
		endif
	ENDPROC

	PROCEDURE lsttran.Click
		transporte=cur_tran.tran_nomb
		coditran=cur_tran.tran_codi
		cond=cur_tran.cond_codi
		locali=cur_tran.loca_nomb
		provi=cur_tran.provi_nomb
		postal=cur_tran.cp_nro
		if last()!=24 AND last()!=5
			thisform.release
		ENDIF
	ENDPROC

	PROCEDURE lsttran.GotFocus
		if last()=24 or last()=5
			thisform.txttranload.setfocus
		endif
	ENDPROC

	PROCEDURE lsttran.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nkeycode=13
			transporte=cur_tran.tran_nomb
			coditran=cur_tran.tran_codi
			cond=cur_tran.cond_codi
			locali=cur_tran.loca_nomb
			provi=cur_tran.provi_nomb
			postal=cur_tran.cp_nro
			thisform.release
		ENDIF
	ENDPROC

	PROCEDURE txttranload.InteractiveChange
		if subst(allt(this.value),1,1)="?"
			SELECT cur_tran
			SET FILTER TO
		endif
		if subst(allt(this.value),1,1)!="?"
			local lc
			lc = allt(This.Value)
			SELECT cur_tran
			if last()<>127 and last()<>7
				do while !eof()
					if lc=subst(cur_tran.tran_nomb,1,len(lc))
						exit
					else
						skip
						ft=ft+1
						if eof()
							go top
							ft=1
							exit
						endif
					endif
				enddo
			ELSE
				do while lc=subst(cur_tran.tran_nomb,1,len(lc)) and ft>1
					if bof()
						exit
					endif
					skip-1
					if ft>1
						ft=ft-1
					endif
					if lc<>subst(cur_tran.tran_nomb,1,len(lc))
						skip
						ft=ft+1
						exit
					endif
				enddo				
			ENDIF
			thisform.lsttran.selected(ft)=.T.
			return
		endif
		
	ENDPROC

	PROCEDURE txttranload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
				if subst(allt(this.value),1,1)="?"
					cade=subst(allt(this.value),2,len(allt(this.value)))
					sele cur_tran
					set filter to atcline(cade,tran_nomb)!=0
				else	
					transporte=cur_tran.tran_nomb
					coditran=cur_tran.tran_codi
					cond=cur_tran.cond_codi
					locali=cur_tran.loca_nomb
					provi=cur_tran.provi_nomb
					postal=cur_tran.cp_nro
					thisform.release
				endif
			case last()=5
				if ft>1
					ft=ft-1
				endif
				thisform.lsttran.selected(ft)=ft
				this.value=thisform.lsttran.value
			case last()=24
				if ft<thisform.lsttran.listcount
					ft=ft+1
				endif
				thisform.lsttran.selected(ft)=ft
				this.value=thisform.lsttran.value
			case last()=27
				thisform.release
		endcase
	ENDPROC

ENDDEFINE

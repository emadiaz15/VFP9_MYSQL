	PROCEDURE Command4.Click
		if cantrendi>0
			=messagebox("Verifique que hay "+allt(str(cantrendi))+iif(cantrendi>1," facturas"," factura")+" ya "+iif(cantrendi>1,"rendidas","rendida")+chr(13)+ ;
						"efectúe la consulta nuevamente por favor."+chr(13)+ ;
						"Imposible Registrar la Comisión",0+48,"Advertencia!!!")
			this.enabled=.F.
		else
			preg=messagebox("¿Confirma el registro de la Comisión?",4+48+256,"Advertencia!!!")
			if preg=6
				frmcomi= conectar_db(_screen.cn)
					SQLEXEC(frmcomi,"select com_codi from comisiones order by com_codi desc limit 1;","cur_nuecom")
				desconectar_db(frmcomi)
				IF RECCOUNT("cur_nuecom")>0
					comi=cur_nuecom.com_codi+1
					LOCAL xfecha,xvend,xcantv,xcomi
					xfecha=DATE()
					xvend=thisform.text1.value
					xcantv=thisform.text5.Value
					xcomi=thisform.text6.Value
					frmcomi= conectar_db(_screen.cn)
						SQLEXEC(frmcomi,"insert into comisiones values(?comi,?xfecha,?xvend,?xcantv,?xcomi,null,null);")
						sele fac
						go top
						SQLEXEC(frmcomi,"update comisiones set com_perdes=?fac.fac_fec where com_codi=?comi;")
						go bott
						SQLEXEC(frmcomi,"update comisiones set com_perhas=?fac.fac_fec where com_codi=?comi;")
						go top
						SCAN
							SQLEXEC(frmcomi,"update facturas set com_codi=?comi where fac_codi=?fac.fac_codi;")
						ENDSCAN
					desconectar_db(frmcomi)
					sele comitemp
					go top
					ThisForm.grid1.SetAll("DynamicForeColor", "RGB(225,0,113)", "Column")
					ThisForm.grid1.SetAll("DynamicFontBold", "(.T.)", "Column")	
					thisform.grid1.recordsourcetype=1
					thisform.grid1.recordsource="comitemp"
					this.enabled=.F.
				ENDIF
			endif
		endif
	ENDPROC


	PROCEDURE Destroy
		set point to
		
	ENDPROC

	PROCEDURE excelencabezado
		Xlsheet.cells(1,9)=ALLTRIM(thisform.empresa)
		XLSheet.Cells(1,9).font.bold=.T.
		XLSheet.Cells(1,9).font.size="12"
		XLSheet.Cells(1,9).font.name="Courier New"
		XLSheet.Cells(1,9).HorizontalAlignment=-4152
		
		Xlsheet.cells(3,9)='Fecha Actual: '+ALLTRIM(DTOC(DATE()))
		XLSheet.Cells(3,9).font.bold=.T.
		XLSheet.Cells(3,9).font.size="11"
		XLSheet.Cells(3,9).font.name="Courier New"
		XLSheet.Cells(3,9).HorizontalAlignment=-4152
		
		Xlsheet.range("E5:G5").merge
		Xlsheet.cells(5,5)="CONSULTA DE COMISIONES"
		XLSheet.Cells(5,5).font.bold=.T.
		XLSheet.Cells(5,5).font.underline=.T.
		XLSheet.Cells(5,5).font.size="13"
		XLSheet.Cells(5,5).font.name="Cooper Black"
		XLSheet.range("E5:G5").HorizontalAlignment=7
		
		Xlsheet.cells(8,2)='Vendedor: '+ALLTRIM(STR(thisform.text1.Value))+' - '+ALLTRIM(thisform.text2.Value)
		XLSheet.Cells(8,2).font.bold=.T.
		XLSheet.Cells(8,2).font.size="11"
		XLSheet.Cells(8,2).font.name="Courier New"
		XLSheet.Cells(8,2).HorizontalAlignment=-4131
		
		Xlsheet.cells(10,2)='Período desde: '+ALLTRIM(DTOC(thisform.text3.Value))+' Hasta: '+ALLTRIM(DTOC(thisform.text4.Value))
		XLSheet.Cells(10,2).font.bold=.T.
		XLSheet.Cells(10,2).font.size="11"
		XLSheet.Cells(10,2).font.name="Courier New"
		XLSheet.Cells(10,2).HorizontalAlignment=-4131
		
		
		XLSheet.Cells(12,2)="FECHA"
		XLSheet.Cells(12,2).font.bold=.T.
		XLSheet.Cells(12,2).font.size="11"
		XLSheet.Cells(12,2).font.name="Courier New"
		XLSheet.range("B12:B12").HorizontalAlignment=-4108
		XLSheet.Cells(12,3)="CTE."
		XLSheet.Cells(12,3).font.bold=.T.
		XLSheet.Cells(12,3).font.size="11"
		XLSheet.Cells(12,3).font.name="Courier New"
		XLSheet.range("C12:C12").HorizontalAlignment=-4108
		XLSheet.Cells(12,4)="PV."
		XLSheet.Cells(12,4).font.bold=.T.
		XLSheet.Cells(12,4).font.size="11"
		XLSheet.Cells(12,4).font.name="Courier New"
		XLSheet.range("D12:D12").HorizontalAlignment=-4108
		XLSheet.Cells(12,5)="NÚMERO"
		XLSheet.Cells(12,5).font.bold=.T.
		XLSheet.Cells(12,5).font.size="11"
		XLSheet.Cells(12,5).font.name="Courier New"
		XLSheet.range("E12:E12").HorizontalAlignment=-4108
		XLSheet.Cells(12,6)="CLIENTE"
		XLSheet.Cells(12,6).font.bold=.T.
		XLSheet.Cells(12,6).font.size="11"
		XLSheet.Cells(12,6).font.name="Courier New"
		XLSheet.range("F12:F12").HorizontalAlignment=-4108
		XLSheet.Cells(12,7)="IMP.FACT."
		XLSheet.Cells(12,7).font.bold=.T.
		XLSheet.Cells(12,7).font.size="11"
		XLSheet.Cells(12,7).font.name="Courier New"
		XLSheet.range("G12:G12").HorizontalAlignment=-4108
		XLSheet.Cells(12,8)="% COM."
		XLSheet.Cells(12,8).font.bold=.T.
		XLSheet.Cells(12,8).font.size="11"
		XLSheet.Cells(12,8).font.name="Courier New"
		XLSheet.range("H12:H12").HorizontalAlignment=-4108
		XLSheet.Cells(12,9)="IMP.COMI."
		XLSheet.Cells(12,9).font.bold=.T.
		XLSheet.Cells(12,9).font.size="11"
		XLSheet.Cells(12,9).font.name="Courier New"
		XLSheet.range("I12:I12").HorizontalAlignment=-4108
		
		XLSheet.Range(XLSheet.Cells(12,2),XLSheet.Cells(12,9)).Borders.LineStyle=1
		XLSheet.Range(XLSheet.Cells(12,2),XLSheet.Cells(12,9)).Borders.Weight=2
		XLSheet.Range(XLSheet.Cells(12,2),XLSheet.Cells(12,9)).Interior.Color= RGB(192,192,192)
		XLSheet.Range(XLSheet.Cells(12,2),XLSheet.Cells(12,9)).AutoFilter
		
		return
	ENDPROC

	PROCEDURE excelfooter
		LPARAMETERS xInifil
		
		LOCAL fotfil
		
		WITH Xlsheet.range(XLSheet.Cells(xInifil,2),XLSheet.Cells(xInifil,9))
		    .Borders(4).LineStyle = 1
		    .Borders(4).Weight = 2
		ENDWITH
		
		fotfil = xInifil
		XLSheet.Rows(fotfil).RowHeight = 5
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,6)='MONTOS TOTALES'
		Xlsheet.cells(fotfil,6).HorizontalAlignment=-4152
		Xlsheet.cells(fotfil,6).font.bold=.T.
		WITH Xlsheet.range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,9))
			.font.bold=.T.
			.HorizontalAlignment=-4108
		ENDWITH
		XLSheet.Cells(fotfil,7).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		XLSheet.Cells(fotfil,9).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		LOCAL rangosum1, rangosum2
		
		rangosum1 = 'G13'+':'+'G'+ALLTRIM(STR(fotfil-2))
		rangosum2 = 'I13'+':'+'I'+ALLTRIM(STR(fotfil-2))
		
		XLSheet.Cells(fotfil,7).FormulaLocal="=SUMA(&rangosum1)"
		XLSheet.Cells(fotfil,9).FormulaLocal="=SUMA(&rangosum2)"
		*!*	fotfil = fotfil - 1
		*!*	XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil+1,8)).font.bold= .T.
		*!*	fotfil = xInifil + 1
		*!*	XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil+11,6)).font.bold= .T.
		
		
		RETURN
		
		
		
		
		
		
	ENDPROC

	PROCEDURE GotFocus
		set point to ","
	ENDPROC

	PROCEDURE Init
		public vcodi,acufac,acucom,cantrendi,comi
		set dele on
		set point to ","
		vcodi=0
		acufac=0
		acucom=0
		cantrendi=0
		comi=0
		this.text1.value=0
		this.text3.value=ctod("01/"+allt(str(month(date())))+"/"+allt(str(year(date()))))
		this.text4.value=date()
		this.text5.value=0
		this.text6.value=0
		create cursor fac(fac_fec D,fac_pto N(8),fac_nro N(8),ped_codi N(8),fac_conc C(1),fac_tipo C(1),fac_tot N(15,2),fac_codi N(8))
		create cursor comitemp(fecha D,cbte C(5),pto N(8),nro N(8),cli C(30),factot N(15,2),porcom N(15,3),impo N(15,2),fac_codi N(8),cond_codi N(8))
		LOCAL xven
		xven=UPPER(substr(sys(0),ATC("#",sys(0))+2))
		frmcomi= conectar_db(_screen.cn)
			SQLEXEC(frmcomi,"select * from vendedores where TRIM(ven_nomb)=?xven;","cur_vendedor")
		desconectar_db(frmcomi)
		if RECCOUNT("cur_vendedor")>0
			this.command1.enabled=.F.
			this.text1.value=cur_vendedor.ven_codi
			this.text2.value=cur_vendedor.ven_nomb
			this.text1.style=1
			this.command4.visible=.F.
			this.command3.left=330
			this.text3.setfocus
		ENDIF
		
		frmcomi= conectar_db(_screen.cn)
			SQLEXEC(frmcomi,"select param_desc from parametros where param_codi = 13;","cur_emp")
		desconectar_db(frmcomi)
		
		IF RECCOUNT("cur_emp") > 0
			thisform.empresa=ALLTRIM(cur_emp.param_desc)
			cerrar_cursor("cur_emp")
		ENDIF
	ENDPROC

	PROCEDURE LostFocus
		set point to
		
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(205,205,205)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Command1.Click
		vcodi=0
		do form locavend with vcodi
		if vcodi>0
			thisform.text1.value=ven_codi
			thisform.text2.value=ven_nomb
			thisform.text3.setfocus
		else
			thisform.text1.value=0
			thisform.text2.value=""
			thisform.text1.setfocus
		endif
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize= 10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE Command2.Click
		LOCAL xfecdes,xfechas,xcodiven
		if thisform.text1.value>0
			thisform.grid1.RecordSource=''
			thisform.grid1.Refresh
			acufac=0
			acucom=0
			cantrendi=0
			sele comitemp
			SET SAFETY off
			ZAP
			SET SAFETY on
			xfecdes=thisform.text3.value
			xfechas=thisform.text4.value
			xcodiven=thisform.text1.value
			frmcomi= conectar_db(_screen.cn)
				SQLEXEC(frmcomi,"select * from facturas where ven_codi=?xcodiven and fac_fec between ?xfecdes and ?xfechas and anulado<>'S' and com_codi=0 order by fac_fec,fac_nro;","fac")
			desconectar_db(frmcomi)
			IF RECCOUNT("fac")>0
				go top
				scan
					sele comitemp
					appe blank
					repla fecha with fac.fac_fec
					do case
						case fac.fac_conc="F"
							repla cbte with "F"+allt(fac.fac_tipo)
						case fac.fac_conc="N"
							repla cbte with "NC"+allt(fac.fac_tipo)
						case fac.fac_conc="D"
							repla cbte with "ND"+allt(fac.fac_tipo)
					endcase
					repla pto with fac.fac_pto
					repla nro with fac.fac_nro
					frmcomi= conectar_db(_screen.cn)
						SQLEXEC(frmcomi,"select * from clientes where cli_codi=?fac.cli_codi;","cur_cli")
					desconectar_db(frmcomi)
					SELECT comitemp
					repla cli with cur_cli.cli_nomb
					REPLACE cond_codi WITH cur_cli.cond_codi
					repla factot with iif(fac.fac_conc="N",ConverNro("-"+allt(str(fac.fac_ng+fac.neto_1+fac.neto_2,15,2))),fac.fac_ng+fac.neto_1+fac.neto_2)
					acufac=acufac+factot
					if fac.porc_codi>0
						frmcomi= conectar_db(_screen.cn)
							SQLEXEC(frmcomi,"select * from porcencomi where porc_codi=?fac.porc_codi;","cur_porc")
						desconectar_db(frmcomi)
						SELECT comitemp
						repla porcom with cur_porc.porc_impo
					else
						repla porcom with fac.otra_comi
					endif
					repla impo with round((factot*porcom)/100,2)
					REPLACE fac_codi WITH fac.fac_codi
					acucom=acucom+impo
					sele fac
				endscan
				sele comitemp
				go top
		*!*			ThisForm.grid1.SetAll("DynamicForeColor", "RGB(0,0,0)", "Column")
		*!*			ThisForm.grid1.SetAll("DynamicFontBold", "(.F.)", "Column")	
				thisform.grid1.recordsourcetype=1
				thisform.grid1.recordsource="comitemp"
				thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
				thisform.text5.value=acufac
				thisform.text6.value=acucom
				thisform.command4.enabled=.T.
			ELSE
				MESSAGEBOX("No existen facturas sin comisión rendida para este vendedor y en el período de fechas indicadas",48,"Aviso del Sistema")		
			ENDIF
		else
			=messagebox("No ha indicado el vendedor imposible efectuar la consulta",0+48,"Advertencia!!!")
			thisform.text1.setfocus
		endif	
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC


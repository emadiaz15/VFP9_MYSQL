		pasfac=1
		DO FORM consfactura WITH comitemp.fac_codi,comitemp.cond_codi
	ENDPROC

	PROCEDURE Grid1.Init
		
		
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.Valid
		if this.value>0
			frmcomi= conectar_db(_screen.cn)
				SQLEXEC(frmcomi,"select * from vendedores where ven_codi=?this.value;","cur_vendedor")
			desconectar_db(frmcomi)
			if RECCOUNT("cur_vendedor")>0
				thisform.text2.value=cur_vendedor.ven_nomb
			else
				=messagebox("Vendedor no está en Archivo",0+48,"Advertencia")
				this.value=0
				thisform.text2.value=""
				return 0
			endif
		endif
	ENDPROC


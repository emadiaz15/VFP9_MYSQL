	ENDPROC

	PROCEDURE Olecontrol1.DblClick
		*** ActiveX Control Event ***
		prpp=MESSAGEBOX("¿Elimina éste ítem para modificar el detalle del pago?",4+48+256,"Aviso del Sistema")
		IF prpp=6
			WITH thisform
				local auxcoditipag,auxnumero,auxcuit,auxbanco,auxplaza,auxfechavto,auxvalor,contfil,hayefvo
				contfil=1
				hayefvo=0
				thisform.command4.enabled=.F.
				if this.rows>1
					this.col=0
					frmpagcli= conectar_db(_screen.cn)
						SQLEXEC(frmpagcli,"select * from tipospago where TRIM(tippag_desc)=?ALLTRIM(this.text);","cur_tipp")
					desconectar_db(frmpagcli)
					coditipag=cur_tipp.tippag_codi	
					this.col=1
					numero=allt(this.text)
					this.col=2
					cuit=val(substr(allt(this.text),1,2)+substr(allt(this.text),4,8)+substr(allt(this.text),13,1))
					this.col=3
					banco=allt(this.text)
					this.col=4
					plaza=allt(this.text)
					this.col=5
					fechavto=ctod(this.text)
					this.col=6
					valor=ConverNro(this.text)
					totval=totval-valor
					this.removeitem(this.row)
					confirma="N"
					do while confirma="N"
						set point to "."
						do form datospago with coditipag,numero,banco,plaza,fechavto,valor,totval,impotot,cuit
						if confirma="S"
							if cancelado="S"
								.height=336
				               if .olecontrol1.rows>1
									x=1
									do while .olecontrol1.rows>2
										.olecontrol1.removeitem(x)
									enddo
									.olecontrol1.col=0
									.olecontrol1.text=" "
									.olecontrol1.col=1
									.olecontrol1.text=" "
									.olecontrol1.col=2
									.olecontrol1.text=" "
									.olecontrol1.col=3
									.olecontrol1.text=" "
									.olecontrol1.col=4
									.olecontrol1.text=" "
									.olecontrol1.col=5
									.olecontrol1.text=" "
									.olecontrol1.col=6
									.olecontrol1.text=" "
									confirma="N"
									cancelado="N"
									totval=0
									paso=1
								endif
							else
								.text2.value=totval
								.text3.value=.text14.value-.text2.value
								.shape4.visible=.T.
								.label3.visible=.T.
								.label4.visible=.T.
								.text2.visible=.T.
								.text3.visible=.T.
								.autocenter=.T.
								.command4.enabled=.T.
							endif
							exit
						endif
						set point to ","
						if last()=27
							thisform.command1.click()
							exit
						endif
						frmpagcli= conectar_db(_screen.cn)
							SQLEXEC(frmpagcli,"select * from tipospago where tippag_codi=?coditipag;","cur_tpp")
						desconectar_db(frmpagcli)
						if coditipag=3
							cadenacuit=subst(STR(cuit,11),1,2)+"-"+subst(STR(cuit,11),3,8)+"-"+right(STR(cuit,11),1)
						else
							cadenacuit=""
						ENDIF
						IF coditipag=1
							FOR contfil=1 TO .olecontrol1.rows-1
								.olecontrol1.row=contfil
								.olecontrol1.col=0
								IF ALLTRIM(.olecontrol1.text)="EFECTIVO"
									hayefvo=1
									exit
								ENDIF
							NEXT contfil
						ENDIF
						IF hayefvo=1
							.olecontrol1.row=contfil
							.olecontrol1.col=6
							.olecontrol1.text=ALLTRIM(STR(ConverNro(.olecontrol1.text)+valor,10,2))
							hayefvo=0
						ELSE
							.olecontrol1.additem(allt(subst(cur_tpp.tippag_desc,1,13))+chr(9)+allt(numero)+chr(9)+allt(cadenacuit)+chr(9)+allt(banco)+chr(9)+allt(plaza)+chr(9)+dtoc(fechavto)+chr(9)+allt(str(valor,10,2))+chr(9)+iif(nalo=.T.,"N",""))
						ENDIF
						.olecontrol1.row=.olecontrol1.rows-1
						.olecontrol1.col=0
						.olecontrol1.cellfontname="Courier New"
						.olecontrol1.cellfontsize=9
						.olecontrol1.cellfontbold=.T.
						.olecontrol1.cellalignment=0
						.olecontrol1.col=1
						.olecontrol1.cellfontname="Courier New"
						.olecontrol1.cellfontsize=9
						.olecontrol1.cellfontbold=.T.
						.olecontrol1.cellalignment=0
						.olecontrol1.col=2
						.olecontrol1.cellfontname="Courier New"
						.olecontrol1.cellfontsize=9
						.olecontrol1.cellfontbold=.T.
						.olecontrol1.cellalignment=0
						.olecontrol1.col=3
						.olecontrol1.cellfontname="Courier New"
						.olecontrol1.cellfontsize=9
						.olecontrol1.cellfontbold=.T.
						.olecontrol1.cellalignment=0
						.olecontrol1.col=4
						.olecontrol1.cellfontname="Courier New"
						.olecontrol1.cellfontsize=9
						.olecontrol1.cellfontbold=.T.
						.olecontrol1.cellalignment=0
						.olecontrol1.col=5
						.olecontrol1.cellfontname="Courier New"
						.olecontrol1.cellfontsize=9
						.olecontrol1.cellfontbold=.T.
						.olecontrol1.cellalignment=0
						.olecontrol1.col=6
						.olecontrol1.cellfontname="Courier New"
						.olecontrol1.cellfontsize=9
						.olecontrol1.cellfontbold=.T.
						.olecontrol1.cellalignment=8
						.olecontrol1.col=7
						.olecontrol1.cellfontname="Courier New"
						.olecontrol1.cellfontsize=9
						.olecontrol1.cellfontbold=.T.
						.olecontrol1.cellalignment=0
					enddo
				ENDIF
			ENDWITH
		ENDIF
		
		*!*	if paso=1
		*!*		IF totval<impotot
		*!*			confirma="N"
		*!*			thisform.command3.Click
		*!*		ENDIF
		*!*		this.col=0
		*!*		sele tipospago
		*!*		set order to tippag_cod
		*!*		seek coditipag
		*!*		this.text=allt(subst(tippag_desc,1,13))
		*!*		this.col=1
		*!*		this.text=allt(numero)
		*!*		this.col=2
		*!*		if coditipag=3
		*!*			cadenacuit=subst(str(cuit,11),1,2)+"-"+subst(str(cuit,11),3,8)+"-"+right(str(cuit,11),1)
		*!*		else
		*!*			cadenacuit=""
		*!*		endif
		*!*		this.text=cadenacuit
		*!*		this.col=3
		*!*		this.text=allt(banco)
		*!*		this.col=4
		*!*		this.text=allt(plaza)
		*!*		this.col=5
		*!*		this.text=dtoc(fechavto)
		*!*		this.col=6
		*!*		this.text=allt(str(valor,10,2))
		*!*		if auxvalor<>valor
		*!*			totval=totval+valor
		*!*		endif
		*!*	endif
		*!*	if borra=6
		*!*		this.col=5
		*!*		totval=totval-val(this.text)
		*!*		this.removeitem(this.row)
		*!*		thisform.command3.click()
		*!*	endif
		*!*	if paso=1 or borra=6
		*!*		paso=0
		*!*		borra=0
		*!*		do while totval<thisform.text7.value
		*!*			do form datospago with coditipag,numero,banco,plaza,fechavto,valor,totval,impotot
		*!*			if coditipag=0
		*!*				thisform.command1.click()
		*!*				exit
		*!*			endif
		*!*			sele tipospago
		*!*			set order to tippag_cod
		*!*			seek coditipag
		*!*			if coditipag=3
		*!*				cadenacuit=subst(str(cuit,11),1,2)+"-"+subst(str(cuit,11),3,8)+"-"+right(str(cuit,11),1)
		*!*			else
		*!*				cadenacuit=""
		*!*			endif
		*!*			thisform.olecontrol1.additem(allt(subst(tippag_desc,1,13))+chr(9)+allt(numero)+chr(9)+allt(cadenacuit)+chr(9)+allt(banco)+chr(9)+allt(plaza)+chr(9)+dtoc(fechavto)+chr(9)+allt(str(valor,10,2))+chr(9)+iif(nalo=.T.,"N",""))
		*!*		enddo
		*!*		if totval=thisform.text7.value
		*!*			thisform.command4.enabled=.T.
		*!*		endif
		*!*	endif
	ENDPROC

	PROCEDURE Olecontrol1.Refresh
		*** ActiveX Control Method ***
		
	ENDPROC

	PROCEDURE Text10.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text10.Valid
		if this.value>0
			frmpagcli= conectar_db(_screen.cn)
				SQLEXEC(frmpagcli,"select * from recibos where rec_tipo=1 and rec_nro=?this.value;","cur_rrp")
			desconectar_db(frmpagcli)
			if RECCOUNT("cur_rrp")>0
				=messagebox("Recibo ya existe en archivo",0+48,"Advertencia")
				return 0
			endif
		endif
	ENDPROC

	PROCEDURE Text17.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text17.LostFocus
		with thisform
			if this.value=2
				.text10.visible=.F.
				.shape6.visible=.F.
				.label16.visible=.F.
			else
				.text10.visible=.T.
				.shape6.visible=.T.
				.label16.visible=.T.
			endif
		endwith
	ENDPROC

	PROCEDURE Text17.Valid
		if !between(this.value,1,2)
			=messagebox("Solo puede ingresar Código 1 y 2"+chr(13)+chr(13)+;
					"1- Recibo Manuscrito"+chr(13)+ ;
					"2- Recibo Interno",0+48,"Advertencia")
			return 0
		endif
	ENDPROC

	PROCEDURE Text22.Click
		if this.value=0
			this.value=thisform.text21.value
		endif
		this.setfocus
	ENDPROC

	PROCEDURE Text22.GotFocus
		set point to
		
	ENDPROC

	PROCEDURE Text22.LostFocus
		do case
			case this.value>cur_clie.cli_favor
				=messagebox("No puede ingresar un valor mayor al saldo a favor del cliente",0+48,"Cobranzas")
				nodefault
			case this.value=0
				pp=messagebox("Quedará el total del saldo a favor del cliente. ¿Continúa igualmente?",4+48+256,"Cobranzas")
				if pp=7
					this.value=thisform.text21.value
					nodefault
				else
					thisform.text16.value=-this.value
					thisform.text14.value=thisform.text7.value+thisform.text16.value
					thisform.command9.enabled=.F.
				endif
			case this.value<thisform.text21.value and this.value>0
				pp=messagebox("Quedará aún saldo a favor del cliente. ¿Continúa igualmente?",4+48+256,"Cobranzas")
				if pp=7
					this.value=cur_clie.cli_favor
					nodefault
				else
					thisform.text16.value=-this.value
					thisform.text14.value=thisform.text7.value+thisform.text16.value
					thisform.command9.enabled=.F.
				endif
			case this.value<0
				=messagebox("Imposible ingresar un valor negativo",0+48,"Cobranzas")
				this.value=thisform.text21.value
				nodefault
			otherwise
				thisform.text16.value=-this.value
				thisform.text14.value=thisform.text7.value+thisform.text16.value
				thisform.command9.enabled=.F.
		endcase
		set point to ","
		
	ENDPROC

ENDDEFINE

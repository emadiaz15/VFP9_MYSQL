	PROCEDURE Activate
		IF pasoc=0
			thisform.Release
		endif
	ENDPROC

	PROCEDURE Destroy
		SET POINT TO thisform.xpoint
		SET SEPARATOR TO thisform.xsepar
	ENDPROC

	PROCEDURE grid_dblclick
		LOCAL codif
		codif=0
		
		IF cur_compro.comp_codi>0
			DO CASE
				CASE ALLTRIM(cur_compro.comp_cbte)="DIV"
					pasdiv=1
					debintcli=cur_compro.comp_codi
					DO FORM consdebintcli with debintcli
				CASE ALLTRIM(cur_compro.comp_cbte)="CIV"
					pasdiv=1
					creintcli=cur_compro.comp_codi
					DO FORM conscreintcli with creintcli
			OTHERWISE
				pasfac=1
				codif=cur_compro.comp_codi
				do form consfactura with codif,cond
			ENDCASE
		ENDIF
	ENDPROC

	PROCEDURE grid_rightclick
		local par,nregis,xsalant,xreco
		par=7
		do case
			case ALLTRIM(cur_compro.comp_cbte)="NCA" or ALLTRIM(cur_compro.comp_cbte)="NCB" or ALLTRIM(cur_compro.comp_cbte)="CIV"
				par=messagebox("¿Descuento parcial de este comprobante?",4+32+256,"Pagos")
		otherwise
			par=messagebox("¿Cobro parcial de este comprobante?",4+32+256,"Pagos")
		endcase
		if par=6
			nregis=cur_compro.comp_regis
			impcbte=comp_deu
			thisform.xpoint = SYS(2001,"point")
			thisform.xsepar = SYS(2001,"separator")
			do form parcob with impcbte
			SET POINT TO thisform.xpoint
			SET SEPARATOR TO thisform.xsepar
			SELECT cur_compro
			do case
				case impcbte=comp_deu
					thisform.insercbte(impcbte)
					DELETE FROM cur_compro WHERE comp_regis = nregis
				case impcbte<comp_deu
					thisform.insercbte(impcbte)
					REPLACE comp_pag WITH comp_pag+impcbte
					REPLACE comp_deu WITH comp_deu-impcbte
					SELECT cur_compro
					GO top
					xreco=1
					SCAN
						IF xreco=1
							REPLACE comp_sal WITH comp_deu
						ELSE
							SKIP -1
							xsalant=comp_sal
							SKIP
							REPLACE comp_sal WITH xsalant+comp_deu
						ENDIF
						xreco=xreco+1
					ENDSCAN
					GO nregis
				case impcbte<0 and impcbte>comp_deu
					thisform.insercbte(impcbte)
					REPLACE comp_pag WITH comp_pag+impcbte
					REPLACE comp_deu WITH comp_deu-impcbte
		*!*				this.selected(n)=.F.
					SELECT cur_compro
					GO top
					xreco=1
					SCAN
						IF xreco=1
							REPLACE comp_sal WITH comp_deu
						ELSE
							SKIP -1
							xsalant=comp_sal
							SKIP
							REPLACE comp_sal WITH xsalant+comp_deu
						ENDIF
						xreco=xreco+1
					ENDSCAN
					GO nregis
			endcase
			parcial=.F.
			thisform.grd_cbtes.Refresh
		endif
		sele totalcbtes
		go top
		if reccount()>0 and thisform.text7.value=0
			thisform.command4.enabled=.T.
		ENDIF
	ENDPROC

	PROCEDURE Init
		public codicli,coditipag,numero,banco,plaza,fechavto,valor,totval,cond, ;
		       valoriva,borra,impotot,codrec,paso,importe,vuelto,totalfac,confirma, ;
		       totcred,totdeb,totsiv,pregsaldo,cuit,codrecpag,auxiliar,coef,coefc,paso,reini,obser,hayfac,parcial,s,cancelado,difesaf,pasoc,nalo, ;
		       idcheq
		set dele on
		thisform.xpoint = SYS(2001,"point")
		thisform.xsepar = SYS(2001,"separator")
		SET POINT TO ","
		SET SEPARATOR TO "."
		set exact off
		set date british
		set cent on
		CREATE CURSOR cur_compro(comp_fec D,comp_cbte C(3),comp_pv N(3),comp_nro N(8),comp_tot N(15,2),comp_pag N(15,2),comp_deu N(15,2),comp_sal N(15,2),comp_sel L,comp_codi N(8),comp_regis N(5))
		create cursor fac(fac_fec D,fac_codi N(8),fac_tipo C(1),fac_pto N(4),fac_nro N(8),imp_pag N(15,2),fac_conc C(1),total N(15,2))
		create cursor siv(sini_fech D,sini_cod N(8),cli_sal N(15,2),sini_pag N(15,2))
		create cursor div(debv_fech D,debv_codi N(8),debv_tot N(15,2),debv_impag N(15,2))
		create cursor civ(crev_fech D,crev_codi N(8),crev_tot N(15,2),crev_impag N(15,2))
		create cursor facsiv(fac_codi N(8),sini_cod N(8),debv_codi N(8),crev_codi N(8),facsiv_fec D)
		
		create cursor totalcbtes(conc C(3),punto N(4),numero N(8),impabona N(15,2),parcial L)
		create cursor totregis(instancia N(2),rec_nro N(8),fac_codi N(8),sini_cod N(8),debv_codi N(8),crev_codi N(8),sa C(1),pagfac_impo N(15,2),pag_fech D, ;
		                       cli_codi N(8),rec_dtosaf N(15,2),rec_antic N(15,2),rec_restsaf N(15,2),recfac_codi N(8),recsini_cod N(8), ;
		                       recdebi_cod N(8),reccrei_cod N(8),fac_conc C(1),fac_pto N(4),fac_nro N(8),fac_fec D,sini_fech D,debv_fech D,crev_fech D,recfac_parci N(1), ;
		                       recsini_parci N(1),recdebi_parci N(1),reccrei_parci N(1),recpag_codi N(8),tippag_codi N(8),tippag_desc C(25),movtippag_nro C(14), ;
		                       ban_codi N(8),ban_desc C(45),ban_cuit N(11),movtippag_pza C(25),movtippag_fvto D null,movtippag_imp N(15,2), ;
		                       cuit_lib N(11),parcial N(1))
		                     
		index on instancia to SYS(2015)
		STORE 0 TO pasoc,coef,vuelto,codicli,coditipag,valor,totval,borra,importe,totalfac,totcred,totdeb,totsiv, ;
				   pregsaldo,cuit,codrecpag,auxiliar,paso,difesaf
		STORE "" TO idcheq,numero,banco,plaza,obser
		STORE .F. TO reini,parcial,nalo
		s=1                   
		fechavto=ctod("  /  /    ")
		hayfac="S"
		confirma="N"
		cancelado="N"
		with this
			.text7.value=0
			.text16.value=0
			frmpagcli= conectar_db(_screen.cn)
				SQLEXEC(frmpagcli,"select * from recibos order by rec_codi desc limit 1;","cur_prirec")
			desconectar_db(frmpagcli)
			IF RECCOUNT("cur_prirec")>0
				.text17.value=cur_prirec.rec_tipo
			ELSE
				.text17.value=0
			ENDIF
		endwith
		
		do form cliload with codicli
		IF codicli<>0
			pasoc=1
			with thisform
				.text13.value=date()
				.text10.value=0
				.text7.value=0
				.text14.value=0
				.text1.value=cur_clie.cli_nomb
				cuit=VAL(cur_clie.cli_cuit)
				cond=cur_clie.cond_codi
		
				frmpagcli= conectar_db(_screen.cn)
					SQLEXEC(frmpagcli,"SELECT fac_fec,fac_codi,fac_tipo,fac_pto,fac_nro,imp_pag,fac_conc,fac_ng+neto_1+neto_2+fac_ivari+fac_ivarni as total FROM facturas WHERE pagado<>'S' AND anulado<>'S' AND cli_codi=?codicli order by fac_codi;","fac")
					index on fac_codi to SYS(2015)
		
					SQLEXEC(frmpagcli,"SELECT sini_fech,sini_cod,cli_sal,sini_pag FROM saldosiniciales WHERE pagado<>'S' AND anulado<>'S' AND cli_codi=?codicli order by sini_cod;","siv")
					index on sini_cod to SYS(2015)
		
					SQLEXEC(frmpagcli,"SELECT debv_fech,debv_codi,debv_tot,debv_impag FROM debintv WHERE pagado<>'S' AND cli_codi=?codicli order by debv_codi;","div")
					index on debv_codi to SYS(2015)
		
					SQLEXEC(frmpagcli,"SELECT crev_fech,crev_codi,crev_tot,crev_impag FROM creintv WHERE pagado<>'S' AND cli_codi=?codicli order by crev_codi;","civ")
					index on crev_codi to SYS(2015)			
				desconectar_db(frmpagcli)
				
				sele fac
				go top
				scan
					insert into facsiv(fac_codi,sini_cod,debv_codi,crev_codi,facsiv_fec) ;
								values(fac.fac_codi,0,0,0,fac.fac_fec)
				endscan
				sele siv
				go top
				scan
					insert into facsiv(fac_codi,sini_cod,debv_codi,crev_codi,facsiv_fec) ;
								values(0,siv.sini_cod,0,0,siv.sini_fech)
				ENDSCAN
				sele div
				go top
				scan
					insert into facsiv(fac_codi,sini_cod,debv_codi,crev_codi,facsiv_fec) ;
								values(0,0,div.debv_codi,0,div.debv_fech)
				ENDSCAN
				sele civ
				go top
				scan
					insert into facsiv(fac_codi,sini_cod,debv_codi,crev_codi,facsiv_fec) ;
								values(0,0,0,civ.crev_codi,civ.crev_fech)
				endscan		
				sele facsiv
				index on facsiv_fec to SYS(2015)
				set rela to fac_codi into fac addi
				set rela to sini_cod into siv addi
				set rela to debv_codi into div addi
				set rela to crev_codi into civ addi
				
				sele fac
				go top
				sele siv
				go top
				sele div
				go top
				sele civ
				go top
				sele facsiv
				go top
				i=1
				LOCAL xfec,xcbte,xpv,xnro,xtot,xpag,xdeu,xsal,xcodc,xregis
				xregis=1
				scan
					xfec=facsiv_fec
					if fac_codi>0
						do case
							case fac.fac_conc="F"
								xcbte=iif(fac.fac_tipo="A","FA","FB")
							case fac.fac_conc="N"
								xcbte=iif(fac.fac_tipo="A","NCA","NCB")
							case fac.fac_conc="D"
								xcbte=iif(fac.fac_tipo="A","NDA","NDB")
						endcase
					ELSE
						DO case
							CASE sini_cod>0
								xcbte="SIV"
							CASE debv_codi>0
								xcbte="DIV"
							CASE crev_codi>0
								xcbte="CIV"
						ENDCASE
					ENDIF
					xpv=iif(fac_codi>0,fac.fac_pto,0)
					xnro=iif(fac_codi>0,fac.fac_nro,IIF(sini_cod>0,siv.sini_cod,IIF(div.debv_codi>0,div.debv_codi,civ.crev_codi)))
					xtot=iif(fac_codi>0,fac.total,IIF(sini_cod>0,siv.cli_sal,IIF(div.debv_codi>0,div.debv_tot,civ.crev_tot)))
					xpag=iif(fac_codi>0,fac.imp_pag,IIF(sini_cod>0,siv.sini_pag,IIF(div.debv_codi>0,div.debv_impag,civ.crev_impag)))
					xdeu=iif(fac_codi>0,fac.total-fac.imp_pag,IIF(sini_cod>0,siv.cli_sal-siv.sini_pag,IIF(div.debv_codi>0,div.debv_tot-div.debv_impag,civ.crev_tot-civ.crev_impag)))
					if fac.fac_conc="N" OR facsiv.crev_codi>0
						xtot=xtot*(-1)
						xpag=xpag*(-1)
						xdeu=xdeu*(-1)
					ENDIF
					if i=1
						xsal=xdeu
					else
						xsal=xsal+xdeu
					ENDIF
					xcodc=IIF(fac_codi>0,fac_codi,IIF(debv_codi>0,debv_codi,crev_codi))
					INSERT INTO cur_compro values(xfec,xcbte,xpv,xnro,xtot,xpag,xdeu,xsal,.F.,xcodc,xregis)
					xregis=xregis+1
					i=i+1
				ENDSCAN
				GO TOP IN cur_compro
				thisform.grd_cbtes.RecordSource="cur_compro"
				thisform.grd_cbtes.SetAll("DynamicForeColor", ;
						                  "iif(cur_compro.comp_deu<0,iif(cur_compro.comp_sel=.T.,RGB(0,255,0),RGB(255,0,0)),iif(cur_compro.comp_sel=.T.,RGB(255,255,255),RGB(0,0,0)))", ;
						                  "Column")
				thisform.grd_cbtes.SetAll("DynamicBackColor","iif(cur_compro.comp_sel=.T.,RGB(0,120,215),RGB(255,255,255))","Column")
				thisform.grd_cbtes.COLUMN9.DynamicBackColor='RGB(118,157,173)'
				GO BOTTOM in cur_compro
				.text18.value= cur_compro.comp_sal
				GO TOP IN cur_compro
				.text19.value=cur_clie.cli_favor
				.text20.value=.text18.value-.text19.value
				.text21.value=cur_clie.cli_favor
				.text22.value=cur_clie.cli_favor
				if cur_clie.cli_favor=0
					.text22.enabled=.F.
				else
					.command9.enabled=.T.
				endif
				if RECCOUNT("cur_compro") > 0
					thisform.command5.enabled=.T.
				ENDIF
			ENDWITH
		
			FOR ncol=1 TO 8
				xsource="Thisform.grd_cbtes.column"+ALLTRIM(STR(ncol))+".text1"
				BINDEVENT(&xsource,"DblClick",Thisform,"Grid_DblClick")
				BINDEVENT(&xsource,"RightClick",Thisform,"Grid_RightClick")
			NEXT ncol
		endif
	ENDPROC

	PROCEDURE insercbte
		LPARAMETERS nvalcob
		
		LOCAL regact
		
		sele totalcbtes
		locate for ALLTRIM(conc)+ALLTRIM(STR(numero))=ALLTRIM(cur_compro.comp_cbte)+ALLTRIM(STR(cur_compro.comp_nro))
		if found()
			regact=RECNO("totalcbtes")
			update totalcbtes set impabona=impabona+nvalcob WHERE ;
					ALLTRIM(cur_compro.comp_cbte)+ALLTRIM(STR(cur_compro.comp_nro))=ALLTRIM(conc)+ALLTRIM(STR(numero))
			GO regact
		ELSE
			insert into totalcbtes(conc,punto,numero,impabona) ;
			  values(allt(cur_compro.comp_cbte),cur_compro.comp_pv,cur_compro.comp_nro, ;
			  		 nvalcob)	  		 
		ENDIF
		
		if nvalcob=cur_compro.comp_deu
			update totalcbtes set parcial=.F. where ;
					ALLTRIM(cur_compro.comp_cbte)+ALLTRIM(STR(cur_compro.comp_nro))=ALLTRIM(conc)+ALLTRIM(STR(numero))
		ELSE
			update totalcbtes set parcial=.T. where ;
					ALLTRIM(cur_compro.comp_cbte)+ALLTRIM(STR(cur_compro.comp_nro))=ALLTRIM(conc)+ALLTRIM(STR(numero))
		endif
		
		thisform.text7.value=thisform.text7.value+nvalcob
		thisform.text14.value=thisform.text7.value+thisform.text16.value
		
		SELECT cur_compro
		
		RETURN
	ENDPROC

	PROCEDURE Command1.Click
		pregunta=messagebox("¿Seguro que desea salir?",4+48+256,"Advertencia")
		do case
			case pregunta=6
				thisform.release
			case pregunta=7
				if totval<thisform.text14.value
					thisform.command3.click()
				endif
		endcase
	ENDPROC


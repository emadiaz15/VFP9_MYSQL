	PROCEDURE Command2.Click
		LOCAL regact,xreco
		thisform.grd_cbtes.RecordSource=''
		thisform.grd_cbtes.Refresh
		with thisform
			SELECT cur_compro
			GO top
			SCAN
				IF comp_sel = .T.
					thisform.insercbte(comp_deu)
				ENDIF
			ENDSCAN
			DELETE FROM cur_compro WHERE comp_sel=.T.
			GO top
			xreco=1
			SCAN
				IF xreco=1
					REPLACE comp_sal WITH comp_deu
				ELSE
					SKIP -1
					xsalant=comp_sal
					SKIP
					REPLACE comp_sal WITH xsalant+comp_deu
				ENDIF
				xreco=xreco+1
			ENDSCAN
			GO TOP IN cur_compro
			thisform.grd_cbtes.RecordSource="cur_compro"
			thisform.grd_cbtes.Refresh
			this.Enabled=.F.
			sele totalcbtes
			go top
			if reccount()>0 and .text7.value=0
				.command4.enabled=.T.
			ENDIF
		endwith
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		with thisform
			.command2.enabled=.F.
			.command5.enabled=.F.
			thisform.grd_cbtes.Enabled= .F.
			valor=.text14.value
			impotot=valor
			do while confirma="N"
				set point to "."
				do form datospago with coditipag,numero,banco,plaza,fechavto,valor,totval,impotot,cuit
				if confirma="S"
					if cancelado="S"
						.height=336
		               if .olecontrol1.rows>1
							x=1
							do while .olecontrol1.rows>2
								.olecontrol1.removeitem(x)
							enddo
							.olecontrol1.col=0
							.olecontrol1.text=" "
							.olecontrol1.col=1
							.olecontrol1.text=" "
							.olecontrol1.col=2
							.olecontrol1.text=" "
							.olecontrol1.col=3
							.olecontrol1.text=" "
							.olecontrol1.col=4
							.olecontrol1.text=" "
							.olecontrol1.col=5
							.olecontrol1.text=" "
							.olecontrol1.col=6
							.olecontrol1.text=" "
							.olecontrol1.col=7
							.olecontrol1.text=" "
							.olecontrol1.col=8
							.olecontrol1.text=" "					
							confirma="N"
							cancelado="N"
							totval=0
							paso=1
						endif
					else
						.text2.value=totval
						.text3.value=.text14.value-.text2.value
						.shape4.visible=.T.
						.label3.visible=.T.
						.label4.visible=.T.
						.text2.visible=.T.
						.text3.visible=.T.
						.autocenter=.T.
						.command4.enabled=.T.
						IF .text3.value<0
							MESSAGEBOX("El detalle de pagos ingresados es mayor al total de los comprobantes, ésto generará un saldo a favor del Cliente, verfique si ésta información es correcta",0+64,"Aviso del Sistema")
						ENDIF
					ENDIF
					exit
				endif
				set point to ","
				if last()=27
					thisform.command1.click()
					exit
				endif
				frmpagcli= conectar_db(_screen.cn)
					SQLEXEC(frmpagcli,"select * from tipospago where tippag_codi=?coditipag;","cur_tpp")
				desconectar_db(frmpagcli)
				if coditipag=3 OR coditipag=20
					cadenacuit=subst(STR(cuit,11),1,2)+"-"+subst(STR(cuit,11),3,8)+"-"+right(STR(cuit,11),1)
				else
					cadenacuit=""
				ENDIF
				.olecontrol1.additem(allt(cur_tpp.tippag_desc)+chr(9)+allt(numero)+chr(9)+allt(cadenacuit)+chr(9)+allt(banco)+chr(9)+allt(plaza)+chr(9)+dtoc(fechavto)+chr(9)+allt(str(valor,15,2))+chr(9)+iif(nalo=.T.,"N","")+CHR(9)+idcheq)
				.olecontrol1.row=.olecontrol1.rows-1
				.olecontrol1.col=0
				.olecontrol1.cellfontname="Courier New"
				.olecontrol1.cellfontsize=9
				.olecontrol1.cellfontbold=.T.
				.olecontrol1.cellalignment=0
				.olecontrol1.col=1
				.olecontrol1.cellfontname="Courier New"
				.olecontrol1.cellfontsize=9
				.olecontrol1.cellfontbold=.T.
				.olecontrol1.cellalignment=0
				.olecontrol1.col=2
				.olecontrol1.cellfontname="Courier New"
				.olecontrol1.cellfontsize=9
				.olecontrol1.cellfontbold=.T.
				.olecontrol1.cellalignment=0
				.olecontrol1.col=3
				.olecontrol1.cellfontname="Courier New"
				.olecontrol1.cellfontsize=9
				.olecontrol1.cellfontbold=.T.
				.olecontrol1.cellalignment=0
				.olecontrol1.col=4
				.olecontrol1.cellfontname="Courier New"
				.olecontrol1.cellfontsize=9
				.olecontrol1.cellfontbold=.T.
				.olecontrol1.cellalignment=0
				.olecontrol1.col=5
				.olecontrol1.cellfontname="Courier New"
				.olecontrol1.cellfontsize=9
				.olecontrol1.cellfontbold=.T.
				.olecontrol1.cellalignment=0
				.olecontrol1.col=6
				.olecontrol1.cellfontname="Courier New"
				.olecontrol1.cellfontsize=9
				.olecontrol1.cellfontbold=.T.
				.olecontrol1.cellalignment=8
				.olecontrol1.col=7
				.olecontrol1.cellfontname="Courier New"
				.olecontrol1.cellfontsize=9
				.olecontrol1.cellfontbold=.T.
				.olecontrol1.cellalignment=0
				thisform.lbl_totval.Caption='Total de Valores Ingresados: $ '+ALLTRIM(STR(totval,15,2))
			enddo
			.height=550
			.autocenter=.T.
		endwith
	ENDPROC


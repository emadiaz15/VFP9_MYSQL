	PROCEDURE grd_cbtes.Column9.Check1.Click
		LOCAL cantsel,ubireg
		cantsel=0
		ubireg=0
		
		SELECT cur_compro
		ubireg=RECNO()
		LOCATE
		COUNT ALL FOR comp_sel=.T. TO cantsel
		GO ubireg
		
		IF cantsel>0
			thisform.command2.Enabled= .T.
		*!*		thisform.estadosel=1
		ELSE
			thisform.command2.Enabled= .F.
		*!*		thisform.estadosel=0
		ENDIF
	ENDPROC


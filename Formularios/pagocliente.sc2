	PROCEDURE Command4.Click
		local cc,cs,lcletra,letra,cadenanro
		
		if thisform.text17.value=1 and thisform.text10.value=0
			messagebox("Debe ingresar el Número de Recibo.-",0+48,"Advertencia")
			thisform.text10.setfocus
		else
		pregunta=messagebox("¿Confirma la cobranza ingresada?",4+32+256,"Pagos de Clientes")
		if pregunta=6
			with thisform
				LOCAL xnro,xfec,ximpo,xtipo,xobser,xdtos,xrests,xantic, ;
					  xtpagc,xban,xsuc,xpagnro,xncheq,xpza,xfvto,xpagimp, ;
					  xfvto,xcuitl,xnalo,xchid,xacti,xbandes,xbancuit,xfecha
				STORE 0 TO xnro,ximpo,xtipo,xdtos,xrests,xantic,xbancuit
				STORE '' TO xobser,xbandes,xchid
				if .text17.value=2
					frmpagcli= conectar_db(_screen.cn)
						SQLEXEC(frmpagcli,"SELECT * FROM recibos where rec_tipo=2 order by rec_codi desc limit 1;","cur_tipo")
					desconectar_db(frmpagcli)
					IF ISNULL(cur_tipo.rec_codi)
						.text10.value=1
					else
						.text10.value=rec_nro+1
					endif
				ENDIF
				frmpagcli= conectar_db(_screen.cn)
					SQLEXEC(frmpagcli,"select MAX(rec_codi) as rec_codi from recibos order by rec_codi;","cur_nrec")
				desconectar_db(frmpagcli)
				IF ISNULL(cur_nrec.rec_codi)
					codrec=1
				ELSE
					codrec=cur_nrec.rec_codi+1
				ENDIF
				xnro=.text10.value
				xfec=.text13.value
				if .text3.value<0 and .text7.value=0
					ximpo=0
				else
					ximpo=.text14.value
				endif
				xtipo=.text17.value
				xobser=obser
				if .text3.value<0
					xantic=abs(.text3.value)
				endif	
				if .text16.value<0
					xdtos=abs(.text16.value)
					xrests=.text21.value+.text16.value
				endif
				frmpagcli= conectar_db(_screen.cn)
					SQLEXEC(frmpagcli,"insert into recibos values(?codrec,?xnro,?xfec,?ximpo,?codicli,?xtipo,?xantic,?xobser,?xdtos,?xrests);")
				desconectar_db(frmpagcli)
		
				insert into totregis(instancia,rec_nro,pag_fech,cli_codi);
					values(1,xnro,.text13.value,codicli)			
				acu=0
				LOCAL xcod,ximp,ximpabs,xparci,cadfac,xvalpag,xrfimp,xrfparci
				sele totalcbtes
				go top
				scan
					do case
						case allt(conc)="SIV"
							STORE 0 TO xcod,ximp,xparci
							frmpagcli= conectar_db(_screen.cn)
								SQLEXEC(frmpagcli,"select MAX(recsini_cod) as recsini_cod from recibos_saldosiniciales order by recsini_cod;","cur_rs")
								IF ISNULL(cur_rs.recsini_cod)
									cs=1
								else
									cs=cur_rs.recsini_cod+1
								ENDIF
								xcod=totalcbtes.numero
								ximp=totalcbtes.impabona
								SQLEXEC(frmpagcli,"update saldosiniciales set sini_pag=sini_pag+?totalcbtes.impabona where sini_cod=?xcod;")
								SQLEXEC(frmpagcli,"select * from saldosiniciales where sini_cod=?xcod;","cur_sini")
								if hayfac="S"
									if totalcbtes.parcial=.T.
										xparci=1
										sele totregis
										repla recsini_cod with cs
									ENDIF
									SQLEXEC(frmpagcli,"insert into recibos_saldosiniciales values(?cs,?codrec,?xcod,?ximp,?xparci);")
									insert into totregis(instancia,sini_cod,sini_fech,recsini_cod,pagfac_impo,recsini_parci) ;
											values(1,xcod,cur_sini.sini_fech,cs,totalcbtes.impabona,IIF(totalcbtes.parcial=.T.,1,0))
								ENDIF
								IF RECCOUNT("cur_sini")>0
									do case
										case cur_sini.cli_sal>0
											if cur_sini.sini_pag>=cur_sini.cli_sal
												SQLEXEC(frmpagcli,"update saldosinicales set pagado='S' where sini_cod=?xcod;")
											endif
										case cur_sini.cli_sal<0
											if abs(cur_sini.sini_pag)>=abs(cur_sini.cli_sal)
												SQLEXEC(frmpagcli,"update saldosinicales set pagado='S' where sini_cod=?xcod;")
											endif
									ENDCASE
								ENDIF
							desconectar_db(frmpagcli)
						case allt(conc)="DIV"
							STORE 0 TO xcod,ximp,xparci
							frmpagcli= conectar_db(_screen.cn)
								SQLEXEC(frmpagcli,"select MAX(recdebi_cod) as recdebi_cod from recibos_debintv order by recdebi_cod;","cur_rd")
								IF ISNULL(cur_rd.recdebi_cod)
									cs=1
								else
									cs=cur_rd.recdebi_cod+1
								ENDIF
								xcod=totalcbtes.numero
								ximp=totalcbtes.impabona
								SQLEXEC(frmpagcli,"update debintv set debv_impag=debv_impag+?ximp where debv_codi=?xcod;")
								SQLEXEC(frmpagcli,"select * from debintv where debv_codi=?xcod;","cur_debv")
								if hayfac="S"
									if totalcbtes.parcial=.T.
										xparci=1
										sele totregis
										repla recdebi_cod with cs
									ENDIF
									SQLEXEC(frmpagcli,"insert into recibos_debintv values(?cs,?codrec,?xcod,?ximp,?xparci);")
									insert into totregis(instancia,debv_codi,debv_fech,recdebi_cod,pagfac_impo,recdebi_parci) ;
											values(1,xcod,cur_debv.debv_fech,cs,totalcbtes.impabona,IIF(totalcbtes.parcial=.T.,1,0))
								ENDIF
								
								IF RECCOUNT("cur_debv")>0
									if cur_debv.debv_impag>=cur_debv.debv_tot
										SQLEXEC(frmpagcli,"update debintv set pagado='S' where debv_codi=?xcod;")
									endif
								ENDIF
							desconectar_db(frmpagcli)
						case allt(conc)="CIV"
							STORE 0 TO xcod,ximp,xparci
							frmpagcli= conectar_db(_screen.cn)
								SQLEXEC(frmpagcli,"select MAX(reccrei_cod) as reccrei_cod from recibos_creintv order by reccrei_cod;","cur_rc")
								IF ISNULL(cur_rc.reccrei_cod)
									cs=1
								else
									cs=cur_rc.reccrei_cod+1
								ENDIF
								xcod=totalcbtes.numero
								ximp=totalcbtes.impabona
								ximpabs=ABS(totalcbtes.impabona)
								SQLEXEC(frmpagcli,"update creintv set crev_impag=crev_impag+?ximpabs where crev_codi=?xcod;")
								SQLEXEC(frmpagcli,"select * from creintv where crev_codi=?xcod;","cur_crev")
								if hayfac="S"
									if totalcbtes.parcial=.T.
										xparci=1
										sele totregis
										repla recdebi_cod with cs
									ENDIF
									SQLEXEC(frmpagcli,"insert into recibos_creintv values(?cs,?codrec,?xcod,?ximp,?xparci);")
									insert into totregis(instancia,crev_codi,crev_fech,reccrei_cod,pagfac_impo,reccrei_parci) ;
											values(1,xcod,cur_crev.crev_fech,cs,totalcbtes.impabona,IIF(totalcbtes.parcial=.T.,1,0))
								ENDIF
								
								IF RECCOUNT("cur_crev")>0
									if cur_crev.crev_impag>=cur_crev.crev_tot
										SQLEXEC(frmpagcli,"update creintv set pagado='S' where crev_codi=?xcod;")
									endif
								ENDIF
							desconectar_db(frmpagcli)					
					OTHERWISE
						cadfac=''
						STORE 0 TO xvalpag,xrfimp,xrfparci
						do case
							case subst(allt(totalcbtes.conc),1,1)="F"
								letra="F"
							case subst(allt(totalcbtes.conc),1,2)="NC"
								letra="N"
							case subst(allt(totalcbtes.conc),1,2)="ND"
								letra="D"
						endcase
						frmpagcli= conectar_db(_screen.cn)
							cadfac=allt(str(totalcbtes.punto))+allt(str(totalcbtes.numero))+iif(cond=2,"A","B")+letra
							xvalpag=iif(subst(allt(totalcbtes.conc),1,2)="NC",abs(totalcbtes.impabona),totalcbtes.impabona)
							SQLEXEC(frmpagcli,"update facturas set imp_pag=imp_pag+?xvalpag where CONCAT(TRIM(CAST(fac_pto as char)),TRIM(CAST(fac_nro as char)),TRIM(fac_tipo),TRIM(fac_conc))=?cadfac;")
							SQLEXEC(frmpagcli,"select * from facturas where CONCAT(TRIM(CAST(fac_pto as char)),TRIM(CAST(fac_nro as char)),TRIM(fac_tipo),TRIM(fac_conc))=?cadfac;","cur_fac")
							if cur_fac.imp_pag>=cur_fac.fac_ng+cur_fac.neto_1+cur_fac.neto_2+cur_fac.fac_ivari+cur_fac.fac_ivarni
								SQLEXEC(frmpagcli,"update facturas set pagado='S' where CONCAT(TRIM(CAST(fac_pto as char)),TRIM(CAST(fac_nro as char)),TRIM(fac_tipo),TRIM(fac_conc))=?cadfac;")
							endif
		
							SQLEXEC(frmpagcli,"select MAX(recfac_codi) as recfac_codi from recibos_facturas order by recfac_codi;","cur_nrf")
							IF ISNULL(cur_nrf.recfac_codi)
								cc=1
							ELSE
								cc=cur_nrf.recfac_codi+1
							ENDIF
							xrfimp=totalcbtes.impabona
							if hayfac="S"
								insert into totregis(instancia,fac_codi,fac_fec,fac_pto,fac_nro,fac_conc,pagfac_impo,recfac_parci) ;
										values(1,cur_fac.fac_codi,cur_fac.fac_fec,cur_fac.fac_pto,cur_fac.fac_nro,cur_fac.fac_conc,totalcbtes.impabona,IIF(totalcbtes.parcial=.T.,1,0))
								if totalcbtes.parcial=.T.
									xrfparci=1
									sele totregis
									repla recfac_codi with cc
								ENDIF
								SQLEXEC(frmpagcli,"insert into recibos_facturas values(?cc,?codrec,?cur_fac.fac_codi,?xrfimp,?xrfparci);")
							ENDIF
						desconectar_db(frmpagcli)
					endcase
					sele totalcbtes
				endscan
				frmpagcli= conectar_db(_screen.cn)
					SQLEXEC(frmpagcli,"update clientes set cli_saldo=cli_saldo-?.text7.value where cli_codi=?codicli;")
					if .text3.value<0
						SQLEXEC(frmpagcli,"update clientes set cli_favor=cli_favor+?abs(.text3.value) where cli_codi=?codicli;")
					endif
					if .text16.value<0
						SQLEXEC(frmpagcli,"update clientes set cli_favor=cli_favor-?abs(.text16.value) where cli_codi=?codicli;")
					endif
		
					for i=1 to .olecontrol1.rows-1
						STORE 0 TO xtpagc,xban,xsuc,xpagimp,xcuitl,xnalo
						STORE '' TO xpagnro,xncheq,xpza,xacti
						.olecontrol1.row=i
						.olecontrol1.col=0
						SQLEXEC(frmpagcli,"select * from tipospago where TRIM(tippag_desc)=?ALLTRIM(.olecontrol1.text);","cur_tpp")
						xtpagc=cur_tpp.tippag_codi
						.olecontrol1.col=1
						if cur_tpp.tippag_codi=3 OR cur_tpp.tippag_codi=20
							IF cur_tpp.tippag_codi=20
								.olecontrol1.col=1
								xpagnro=allt(.olecontrol1.text)
								cadenanro=allt(.olecontrol1.text)
								xncheq=ALLTRIM(.olecontrol1.text)
								.olecontrol1.col=8
								xban=val(allt(.olecontrol1.text))
		*!*							xncheq=ALLTRIM(.olecontrol1.text)+ALLTRIM(xncheq)
							ELSE
								xsuc=val(subst(allt(.olecontrol1.text),4,3))
								xpagnro=subst(allt(.olecontrol1.text),7,8)
								xncheq=allt(.olecontrol1.text)
								cadenanro=allt(.olecontrol1.text)					
								xban=val(subst(allt(.olecontrol1.text),1,3))
							ENDIF
							xacti='S'
							SQLEXEC(frmpagcli,"select * from bancos where ban_codi=?xban;","cur_bco")
							IF RECCOUNT("cur_bco")>0
								xbandes=ALLTRIM(cur_bco.ban_desc)
								xbancuit=VAL(cur_bco.ban_cuit)
							ENDIF
						ELSE
							xpagnro=allt(.olecontrol1.text)
							cadenanro=allt(.olecontrol1.text)
							xbandes='' 
							xbancuit=0
						endif
						.olecontrol1.col=2
						if cur_tpp.tippag_codi=3 OR cur_tpp.tippag_codi=20
							if len(allt(.olecontrol1.text))>0
								xcuitl=val(subst(allt(.olecontrol1.text),1,2)+subst(allt(.olecontrol1.text),4,8)+right(allt(.olecontrol1.text),1))
							else
								xcuitl=0
							endif
						ENDIF
						.olecontrol1.col=4
						xpza=allt(.olecontrol1.text)
						.olecontrol1.col=5
						xfvto=IIF(LEN(ALLTRIM(.olecontrol1.text))>4,ctod(.olecontrol1.text),null)
						.olecontrol1.col=6
						set point to ","
						xpagimp=ConverNro(.olecontrol1.text)
						set point to
						.olecontrol1.col=7
						if allt(.olecontrol1.text)="N"
							xnalo=1
						ENDIF
						.olecontrol1.col=8
						xchid=IIF(cur_tpp.tippag_codi=20,'',ALLTRIM(.olecontrol1.text))
						SQLEXEC(frmpagcli,"select MAX(recpag_codi) as recpag_codi from recibos_pagos order by recpag_codi;","cur_npag")
						IF ISNULL(cur_npag.recpag_codi)
							codrecpag=1
						ELSE
							codrecpag=cur_npag.recpag_codi+1
						ENDIF
						SQLEXEC(frmpagcli,"insert into recibos_pagos values(?codrecpag,?codrec,?xtpagc,?xban,?xsuc,?xpagnro,?xncheq,?xchid,?xpza,?xfvto,?xpagimp,?xcuitl,0,0,0,?xnalo,0,?xacti);")
						insert into totregis(instancia,recpag_codi,tippag_codi,tippag_desc,movtippag_nro,ban_codi,ban_desc,ban_cuit, ;
		         							 movtippag_pza,movtippag_fvto,movtippag_imp,cuit_lib);
									  values(2,codrecpag,cur_tpp.tippag_codi,cur_tpp.tippag_desc,cadenanro,xban,xbandes,xbancuit,;
											 xpza,xfvto,xpagimp,xcuitl)
					next i
				desconectar_db(frmpagcli)
			endwith
			if thisform.text17.value=2
				frmpagcli= conectar_db(_screen.cn)
					SQLEXEC(frmpagcli,"select * from recibos where rec_codi=?codrec;","cur_reci")
				desconectar_db(frmpagcli)
				sele totregis
				go top
				xfecha="Río Cuarto, "+Dia_nombre(dow(totregis.pag_fech)) +" "+ allt(str(DAY(totregis.pag_fech)))+ ' de ' +Mes_nombre(month(totregis.pag_fech))+ ' de '+allt(str(year(totregis.pag_fech)))
				do monto2letra with thisform.text2.value,lcletra in ntoletra
				for m=1 to 2
					do case
						case m=1
							comprobante="Original"
						case m=2
							comprobante="Duplicado"
					endcase
					report form recibo to printer prompt noconsole
				next
			endif
			thisform.release
		endif
		endif
	ENDPROC


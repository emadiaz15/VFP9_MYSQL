	PROCEDURE Destroy
		SET POINT TO
		SET SEPARATOR TO
		
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE Init
		set talk off
		set date british
		set cent on
		set dele on
		set near on
		SET POINT TO ","
		SET SEPARATOR TO "."
		
		this.text1.value=0
		this.text2.value=99999999
		*!*	frmarcot =conectar_db(_screen.cn)
		*!*		SQLEXEC(frmarcot,"select param_fec from parametros where param_desc='PRIMEFEC';","cur_para")
		*!*	desconectar_db(frmarcot)
		this.text3.value=ctod("01/01/"+allt(str(year(date()))))
		this.text4.value=date()
		this.text6.Value=0
		STORE 0 TO thisform.txt_totcan.Value,thisform.txt_totimp.value
		
		create cursor coti(presup_fec D,presup_codi N(8),cli_nomb C(25),art_codi N(8),art_desc C(45),artpres_cant N(10,3),artpres_precio N(10,3))
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(215,215,215)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Check1.Click
		IF this.Value=1
			thisform.xcliente=0
			thisform.text6.value=0
			thisform.combo1.value=''
			thisform.combo1.RowSource=''
			thisform.command1.click
			thisform.command1.setfocus
		ELSE
			thisform.xcliente=0
			thisform.text6.SetFocus
		endif
	ENDPROC

	PROCEDURE cmd_costos.Click
		local fecha,articulo
		fecha=coti.presup_fec
		articulo=coti.art_codi
		do form vraphistocosto with fecha,articulo
	ENDPROC

	PROCEDURE cmd_costos.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE cmd_costos.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Combo1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Combo1.Destroy
		set notify on
	ENDPROC

	PROCEDURE Combo1.GotFocus
		set notify off
		
		
	ENDPROC

	PROCEDURE Combo1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					frmfacar= conectar_db(_screen.cn)
						xdesc=allt(this.list(i))
						SQLEXEC(frmfacar,"select * from clientes where TRIM(cli_nomb)=?xdesc;","cur_cli")
					desconectar_db(frmfacar)
					thisform.text6.value=cur_cli.cli_codi
					thisform.xcliente=cur_cli.cli_codi
					thisform.check1.Value=0
					keyboard '{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE Combo1.LostFocus
		IF thisform.xcliente>0
			thisform.command1.Click
		endif
	ENDPROC

	PROCEDURE Combo1.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade="%"+subst(allt(this.text),2,len(allt(this.text)))+"%"
				frmfacar= conectar_db(_screen.cn)
					SQLEXEC(frmfacar,"select * from clientes where cli_nomb like ?cade order by cli_nomb;","cur_cli")
				desconectar_db(frmfacar)
				IF RECCOUNT("cur_cli")>0
					this.rowsource="select cli_nomb from cur_cli INTO CURSOR combo1"
					this.value=this.list(1)
					keyboard "{F4}"
				ELSE
					MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
					this.Value=""			
				ENDIF
				RETURN .F.
			else
				if len(allt(this.text))>0
					cade=ALLTRIM(this.text)+"%"
					frmfacar= conectar_db(_screen.cn)
						SQLEXEC(frmfacar,"select * from clientes where cli_nomb like ?cade;","cur_cli")
					desconectar_db(frmfacar)
					IF RECCOUNT("cur_cli")>0
						this.rowsource="select cli_nomb from cur_cli INTO CURSOR combo1"
						this.value=this.list(1)
						keyboard "{F4}"
					ELSE
						MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
						this.Value=""				
					ENDIF
					RETURN .F.
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Command1.Click
		DIMENSION totcan[1,1]
		DIMENSION totimpo[1,1]
		STORE 0 TO totcan,totimpo
		sele coti
		go top
		if reccount()>0
			SET SAFETY off
			ZAP
			SET SAFETY on
		ENDIF
		LOCAL xcodides,xcodihas,xfecdes,xfechas,xcodicli
		xcodides=thisform.text1.Value
		xcodihas=thisform.text2.Value
		xfecdes=thisform.text3.Value
		xfechas=thisform.text4.value
		xcodicli=thisform.xcliente
		
		SET DECIMALS TO 3
		frmarcot= conectar_db(_screen.cn)
			SQLEXEC(frmarcot,"call usp_artcotiz(?xcodides,?xcodihas,?xfecdes,?xfechas,?xcodicli);","presup")
		desconectar_db(frmarcot)
		SET DECIMALS TO
		
		thisform.grid1.recordsource=''
		scan
			insert into coti(presup_fec,presup_codi,cli_nomb,art_codi,art_desc,artpres_cant,artpres_precio) ;
				values(presup.presup_fech,presup.presup_codi,presup.cli_nomb,presup.art_codi,presup.art_desc,presup.artpres_cant,presup.artpres_precio)
		endscan
		sele coti
		go top
		SELECT SUM(artpres_cant) FROM coti INTO ARRAY totcan
		SELECT SUM(artpres_cant*artpres_precio) FROM coti INTO ARRAY totimpo
		thisform.txt_totcan.Value=IIF(ISNULL(totcan[1,1]),'',totcan[1,1])
		thisform.txt_totimp.Value=IIF(ISNULL(totimpo[1,1]),'',totimpo[1,1])
		sele coti
		go top
		thisform.grid1.recordsource="coti"
		thisform.grid1.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
		thisform.grid1.forecolor=0
		thisform.cmd_costos.Enabled=.F.
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.fontsize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.fontsize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command2.Click
		codigo=0
		do form artload with codigo
		if codigo>0
			thisform.text1.value=codigo
			thisform.text2.value=codigo
			thisform.text2.setfocus
		endif
	ENDPROC

	PROCEDURE Command3.Click
		codigo=0
		do form artload with codigo
		if codigo>0
			thisform.text2.value=codigo
			thisform.text3.setfocus
		endif
	ENDPROC

	PROCEDURE Command4.Click
		preg=messagebox("¿Confirma que desea abandonar esta rutina?",4+48+256,"Advertencia")
		if preg=6
			thisform.release
		else
			thisform.text1.setfocus
		endif
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.fontsize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.fontsize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Ctn_banner1.Init
		this.Height=120
		this.left=0
		this.Width=this.Parent.Width
		
	ENDPROC

	PROCEDURE Grid1.Click
		IF RECCOUNT("coti")>0
			thisform.cmd_costos.Enabled=.T.
		ELSE
			thisform.cmd_costos.Enabled=.F.
		endif
	ENDPROC

	PROCEDURE Grid1.DblClick
		IF RECCOUNT("coti")>0
			frmarcot= conectar_db(_screen.cn)
				SQLEXEC(frmarcot,"select b.cond_codi from presupuestos a inner join clientes b on a.cli_codi=b.cli_codi where a.presup_codi=?coti.presup_codi;","cur_condi")
			desconectar_db(frmarcot)
			IF RECCOUNT("cur_condi")>0
				DO FORM conspresup WITH coti.presup_codi,cur_condi.cond_codi
			endif
		endif
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.LostFocus
		if this.value>0
			thisform.text2.value=this.value
		endif
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.Valid
		if this.value<thisform.text1.value
			messagebox("El Código Hasta no puede ser menor que el Código Desde",0+48,"Error de Código")
			this.value=thisform.text1.value
			return 0
		endif
	ENDPROC

	PROCEDURE Text3.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text4.Click
		this.setfocus
		
	ENDPROC

	PROCEDURE Text6.Click
		this.value=0
		this.setfocus
	ENDPROC

	PROCEDURE Text6.GotFocus
		set notify off
		thisform.combo1.rowsourcetype=3
	ENDPROC

	PROCEDURE Text6.LostFocus
		set notify on
	ENDPROC

	PROCEDURE Text6.Valid
		if this.value>0
			frmfacar= conectar_db(_screen.cn)
				SQLEXEC(frmfacar,"select * from clientes where cli_codi=?this.value;","cur_cli")
			desconectar_db(frmfacar)
			if RECCOUNT("cur_cli")>0
				thisform.xcliente=cli_codi
				thisform.combo1.rowsource="SELECT cli_nomb FROM cur_cli INTO CURSOR combo1"
				thisform.combo1.value=thisform.combo1.list(1)
				thisform.check1.Value=0
				thisform.command1.Click
				KEYBOARD '{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'
			else
				=messagebox("Cliente no está en archivo",0+48,"Advertencia")
				thisform.xcliente=0
				this.value=0
				return .F.
			endif
		endif
	ENDPROC


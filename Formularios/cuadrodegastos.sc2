	PROCEDURE Destroy
		set point to
	ENDPROC

	PROCEDURE GotFocus
		set point to ","
	ENDPROC

	PROCEDURE Init
		set dele on
		set point to ","
		set dele on
		SET NOTIFY off
		
		this.text1.value=ctod("01/"+"01"+"/"+allt(str(year(date()))))
		this.text2.value=date()
		create cursor cuadro(gas_nomb C(35),m1 N(15,2),m2 N(15,2),m3 N(15,2),m4 N(15,2),m5 N(15,2),m6 N(15,2),m7 N(15,2),m8 N(15,2),m9 N(15,2),m10 N(15,2),m11 N(15,2),m12 N(15,2),total N(15,2),tipgas_codi N(8))
	ENDPROC

	PROCEDURE LostFocus
		set point to
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(215,215,205)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE chk_inmo.Click
		IF this.Value=1
			thisform.grid1.LockColumns=1
		ELSE
			thisform.grid1.LockColumns=0
		ENDIF
		
	ENDPROC

	PROCEDURE Command1.Click
		sele cuadro
		go top
		IF RECCOUNT("cuadro")>0
			DO case
				CASE thisform.chk_pant.Value=0
					report form proygastos to printer prompt noconsole
				CASE thisform.chk_pant.Value=1
					report form proygastos preview noconsole	
			ENDCASE
		ENDIF
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command3.Click
		local codgas,acum1,acum2,acum3,acum4,acum5,acum6,acum7,acum8,acum9,acum10,acum11,acum12
		store 0 to acum1,acum2,acum3,acum4,acum5,acum6,acum7,acum8,acum9,acum10,acum11,acum12
		codgas=0
		
		DIMENSION totalg[1,1]
		DIMENSION totalnc[1,1]
		totalg=0
		totalnc=0
		
		sele cuadro
		go top
		if reccount()>0
			dele all
		endif
		frmcuadg= conectar_db(_screen.cn)
			SQLEXEC(frmcuadg,"select * from tiposgastos;","cur_tipg")
			GO top
		desconectar_db(frmcuadg)
		scan
			insert into cuadro(gas_nomb,tipgas_codi) ;
				 values(allt(str(cur_tipg.tipgas_codi))+" - "+allt(cur_tipg.tipgas_desc),cur_tipg.tipgas_codi)
		endscan
		insert into cuadro(gas_nomb,tipgas_codi) ;
			 values("TOTAL MENSUAL",0)
		
		frmcuadg= conectar_db(_screen.cn)
			SQLEXEC(frmcuadg,"select * from gastos where gas_fech between ?thisform.text1.value and ?thisform.text2.value and tipgas_codi>0;","cur_paqgas")
		desconectar_db(frmcuadg)
		
		IF RECCOUNT("cur_paqgas")>0
			GO top
			sele cuadro
			go top
			set talk off
			scan
				codgas=tipgas_codi
				for x=month(thisform.text1.value) to month(thisform.text2.value)
					select SUM(gas_impo+gas_impo2+gas_impo3+gas_impng) from cur_paqgas where tipgas_codi=?codgas and ;
						    month(gas_fech)=?x and year(gas_fech)=?year(thisform.text1.value) and TRIM(gas_conc)<>'N' INTO ARRAY totalg
		
					select SUM(gas_impo+gas_impo2+gas_impo3+gas_impng) from cur_paqgas where tipgas_codi=?codgas and ;
							month(gas_fech)=?x and year(gas_fech)=?year(thisform.text1.value) and TRIM(gas_conc)='N' INTO ARRAY totalnc
					sele cuadro
					if ISNULL(totalg[1,1])
						totalg[1,1]=0
					endif
					if ISNULL(totalnc[1,1])
						totalnc[1,1]=0
					endif
					
					do case
						case x=1
							repla m1 with totalg-totalnc
							acum1=acum1+m1
						case x=2
							repla m2 with totalg-totalnc
							acum2=acum2+m2
						case x=3
							repla m3 with totalg-totalnc
							acum3=acum3+m3
						case x=4
							repla m4 with totalg-totalnc
							acum4=acum4+m4
						case x=5
							repla m5 with totalg-totalnc
							acum5=acum5+m5
						case x=6
							repla m6 with totalg-totalnc
							acum6=acum6+m6
						case x=7
							repla m7 with totalg-totalnc
							acum7=acum7+m7
						case x=8
							repla m8 with totalg-totalnc
							acum8=acum8+m8
						case x=9
							repla m9 with totalg-totalnc
							acum9=acum9+m9
						case x=10
							repla m10 with totalg-totalnc
							acum10=acum10+m10
						case x=11
							repla m11 with totalg-totalnc
							acum11=acum11+m11
						case x=12
							repla m12 with totalg-totalnc
							acum12=acum12+m12
					endcase
				next x
				sele cuadro
				repla total with m1+m2+m3+m4+m5+m6+m7+m8+m9+m10+m11+m12
			endscan
			go bott
			for x=month(thisform.text1.value) to month(thisform.text2.value)
				do case
					case x=1 
						if acum1>0
							repla m1 with acum1
						endif
					case x=2
						if acum2>0
							repla m2 with acum2
						endif
					case x=3
						if acum3>0
							repla m3 with acum3
						endif
					case x=4
						if acum4>0
							repla m4 with acum4
						endif
					case x=5
						if acum5>0
							repla m5 with acum5
						endif
					case x=6
						if acum6>0
							repla m6 with acum6
						endif
					case x=7
						if acum7>0
							repla m7 with acum7
						endif
					case x=8
						if acum8>0
							repla m8 with acum8
						endif
					case x=9
						if acum9>0
							repla m9 with acum9
						endif
					case x=10
						if acum10>0
							repla m10 with acum10
						endif
					case x=11
						if acum11>0
							repla m11 with acum11
						endif
					case x=12
						if acum12>0
							repla m12 with acum12
						endif
				endcase
			next x
			repla total with acum1+acum2+acum3+acum4+acum5+acum6+acum7+acum8+acum9+ ;
							 acum10+acum11+acum12
			sele cuadro
			go top
			thisform.grid1.recordsource="cuadro"
		
			IF thisform.chk_inmo.Value=1
				thisform.grid1.LockColumns=1
			ELSE
				thisform.grid1.LockColumns=0
			ENDIF
		
			thisform.grid1.SetAll("DynamicBackcolor", "IIF(gas_nomb='TOTAL MENSUAL',RGB(255,255,0),thisform.obtenercolor(RECNO()))", "Column")
			thisform.grid1.SetAll("DynamicForecolor", "IIF(gas_nomb='TOTAL MENSUAL',RGB(255,0,0),RGB(0,0,0))", "Column")
		ELSE
			MESSAGEBOX("SIN GASTOS EN EL PERÍODO INDICADO",64,"Aviso del Sistema")
		ENDIF
		thisform.text1.setfocus
		
		
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
		
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="1" />

	*<PropValue>
		DataSource = .NULL.
		Height = 566
		Left = 1
		Name = "Dataenvironment"
		Top = 220
		Width = 1016
	*</PropValue>

ENDDEFINE

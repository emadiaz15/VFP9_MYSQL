		*m: showwithcursor
		*p: xcondcli
	*</DefinedPropArrayMethod>

	*<PropValue>
		BackColor = 30,35,45
		BorderStyle = 2
		Caption = "Historial de Cotizaciones"
		DoCreate = .T.
		Height = 344
		Icon = ..\imagen\vbe7_1251.ico
		Left = 0
		MaxButton = .F.
		MinButton = .F.
		Name = "frm_histocotiz"
		Top = 0
		Width = 697
		xcondcli = .F.
	*</PropValue>

	ADD OBJECT 'cmd_cerrar' AS commandbutton WITH ;
		Caption = "CERRAR", ;
		Height = 25, ;
		Left = 276, ;
		Name = "cmd_cerrar", ;
		Top = 310, ;
		Width = 169
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grd_hist' AS grid WITH ;
		ColumnCount = 8, ;
		Height = 288, ;
		Left = 12, ;
		Name = "grd_hist", ;
		RecordSource = "", ;
		ScrollBars = 2, ;
		Top = 12, ;
		Width = 672, ;
		Column1.ControlSource = "", ;
		Column1.Name = "Column1", ;
		Column2.ControlSource = "", ;
		Column2.Name = "Column2", ;
		Column3.ControlSource = "", ;
		Column3.Name = "Column3", ;
		Column4.ControlSource = "", ;
		Column4.Name = "Column4", ;
		Column5.ControlSource = "", ;
		Column5.Name = "Column5", ;
		Column6.ControlSource = "", ;
		Column6.Name = "Column6", ;
		Column7.ControlSource = "", ;
		Column7.Name = "Column7", ;
		Column8.ControlSource = "", ;
		Column8.Name = "Column8"
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'grd_hist.Column1.Header1' AS header WITH ;
		Caption = "FECHA", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grd_hist.Column1.Text1' AS textbox WITH ;
		BackColor = 255,255,255, ;

		BorderStyle = 0, ;
		ForeColor = 0,0,0, ;
		Margin = 0, ;
		Name = "Text1"
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grd_hist.Column8.Header1' AS header WITH ;
		Caption = "% UTIL", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grd_hist.Column8.Text1' AS textbox WITH ;
		BackColor = 255,255,255, ;

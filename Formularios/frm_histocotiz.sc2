		ForeColor = 0,0,0, ;
		Margin = 0, ;
		Name = "Text1"
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		&& frm_histocotiz.Activate
		
		IF VARTYPE(thisform.grd_hist) <> "U"
		    thisform.grd_hist.SetFocus()
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE Destroy
		&& frm_histocotiz.Destroy
		
		IF USED("cur_histo")
		    USE IN cur_histo
		ENDIF
		
		thisform.Release()
		
		RETURN
	ENDPROC

	PROCEDURE doclose
		&& frm_histocotiz.DoClose
		
		IF USED("cur_histo")
		    USE IN cur_histo
		ENDIF
		
		thisform.Release()
		
		RETURN
	ENDPROC

	PROCEDURE grid_dblclick
		&& frm_histocotiz.Grid_DblClick
		LOCAL lnPresupCodi, lnCondCodi, lnRes, hConn
		
		IF !USED("cur_histo") OR RECCOUNT("cur_histo") = 0
		    RETURN
		ENDIF
		
		SELECT cur_histo
		lnPresupCodi = presup_cod
		IF EMPTY(lnPresupCodi)
		    RETURN
		ENDIF
		
		* Desconectar grid del cursor antes de tocarlo
		*!*	THISFORM.grd_hist.RecordSource = ""
		*!*	THISFORM.grd_hist.Refresh
		
		* Cerrar historial (ya desconectado)
		*!*	IF USED("cur_histo")
		*!*	    USE IN cur_histo
		*!*	ENDIF
		
		*!*	THISFORM.Visible = .F.
		
		DO FORM conspresup WITH lnPresupCodi, thisform.xcondcli
		*!*	THISFORM.Release()
		
		RETURN
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS xcondi
		
		thisform.xcondcli = xcondi
		
		&& frm_histocotiz.Init
		
		THIS.Caption     = "Historial de Cotizaciones"
		*!*	THIS.ShowWindow  = 1
		THIS.BorderStyle = 2
		THIS.Movable     = .T.
		*!*	THIS.AlwaysOnTop = .T.
		THIS.AutoCenter  = .T.
		THIS.Themes      = .F.
		THIS.BackColor   = RGB(45, 52, 65)
		THIS.Width       = 680
		THIS.Height      = 420
		THIS.MaxButton   = .F.
		THIS.MinButton   = .F.
		
		RETURN .T.
	ENDPROC

	PROCEDURE showwithcursor
		&& frm_histocotiz.ShowWithCursor
		LPARAMETERS tcDbfPath, tnArtCodi, tcDesc
		
		LOCAL lcAlias, lnRegs, lnAnchoGrid, lnAnchoForm
		LOCAL i, loTxt
		
		lcAlias = "cur_histo"
		
		*-- Cerrar si está abierto
		IF USED(lcAlias)
		    USE IN (lcAlias)
		ENDIF
		
		*-- Validar archivo
		IF VARTYPE(tcDbfPath) <> "C" OR EMPTY(tcDbfPath) OR !FILE(tcDbfPath)
		    MESSAGEBOX("No se encontró el archivo de historial.", 16, "Error")
		    THISFORM.Release()
		    RETURN .F.
		ENDIF
		
		*-- Abrir DBF
		USE (tcDbfPath) IN 0 ALIAS (lcAlias)
		SELECT (lcAlias)
		lnRegs = RECCOUNT(lcAlias)
		
		*=========================================================
		* Limpio objetos anteriores (SIN ERROR)
		*=========================================================
		IF PEMSTATUS(THISFORM, "lbl_titulo", 5)
		    THISFORM.RemoveObject("lbl_titulo")
		ENDIF
		IF PEMSTATUS(THISFORM, "lbl_cont", 5)
		    THISFORM.RemoveObject("lbl_cont")
		ENDIF
		IF PEMSTATUS(THISFORM, "lbl_info", 5)
		    THISFORM.RemoveObject("lbl_info")
		ENDIF
		IF PEMSTATUS(THISFORM, "grd_hist", 5)
		    THISFORM.RemoveObject("grd_hist")
		ENDIF
		IF PEMSTATUS(THISFORM, "cmd_cerrar", 5)
		    THISFORM.RemoveObject("cmd_cerrar")
		ENDIF
		
		*=========================================================
		* Medidas
		*=========================================================
		lnAnchoGrid = 78 + 72 + 80 + 88 + 95 + 42 + 80 + 70 + 18
		lnAnchoForm = 15 + lnAnchoGrid + 15
		
		THISFORM.Width  = lnAnchoForm
		THISFORM.Height = 420
		
		*=========================================================
		* Título
		*=========================================================
		THISFORM.AddObject("lbl_titulo", "label")
		WITH THISFORM.lbl_titulo
		    .Left      = 15
		    .Top       = 12
		    .Width     = lnAnchoForm - 110
		    .Height    = 22
		    .Caption   = "Historial de Cotizaciones - Art: " + TRANSFORM(tnArtCodi) + " - " + LEFT(ALLTRIM(tcDesc), 40)
		    .ForeColor = RGB(255, 255, 255)
		    .BackStyle = 0
		    .FontSize  = 10
		    .FontBold  = .T.
		    .Visible   = .T.
		ENDWITH
		
		*=========================================================
		* Contador
		*=========================================================
		THISFORM.AddObject("lbl_cont", "label")
		WITH THISFORM.lbl_cont
		    .Left      = lnAnchoForm - 95
		    .Top       = 12
		    .Width     = 80
		    .Height    = 22
		    .Caption   = ALLTRIM(STR(lnRegs)) + " reg."
		    .ForeColor = RGB(144, 238, 144)
		    .BackStyle = 0
		    .FontSize  = 9
		    .FontBold  = .T.
		    .Alignment = 1
		    .Visible   = .T.
		ENDWITH
		
		*=========================================================
		* Grid
		*=========================================================
		THISFORM.AddObject("grd_hist", "grid")
		WITH THISFORM.grd_hist
		    .Left         = 15
		    .Top          = 40
		    .Width        = lnAnchoGrid
		    .Height       = 300
		    .RecordSource = lcAlias
		    .ColumnCount  = 8
		    .ReadOnly     = .T.
		    .DeleteMark   = .F.
		    .RecordMark   = .F.
		    .ScrollBars   = 2
		    .GridLines    = 0
		    .FontSize     = 9
		    .BackColor    = RGB(40, 44, 52)
		    .ForeColor    = RGB(220, 220, 220)
		    .HeaderHeight = 25
		    .RowHeight    = 22
		    .Themes       = .F.
		    .HighlightRow = .T.
		    .HighlightBackColor = RGB(70, 130, 180)
		    .HighlightForeColor = RGB(255, 255, 255)
		    .AllowCellSelection = .F.
		
		    * Col 1 - Fecha
		    .Column1.Header1.Caption   = "Fecha"
		*!*	    .Column1.ControlSource     = lcAlias + ".presup_fech"
		    .Column1.Width             = 78
		
		    * Col 2 - Nº Presupuesto
		    .Column2.Header1.Caption   = "N° Presup"
		*!*	    .Column2.ControlSource     = lcAlias + ".presup_codi"
		    .Column2.Width             = 72
		
		    * Col 3 - Cantidad
		    .Column3.Header1.Caption   = "Cantidad"
		*!*	    .Column3.ControlSource     = lcAlias + ".artpres_cant"
		    .Column3.Width             = 80
		
		    * Col 4 - Precio Unitario
		    .Column4.Header1.Caption   = "Pr.Unit."
		*!*	    .Column4.ControlSource     = lcAlias + ".artpres_precio"
		    .Column4.Width             = 88
		
		    * Col 5 - Total
		    .Column5.Header1.Caption   = "Total"
		*!*	    .Column5.ControlSource     = lcAlias + ".total"
		    .Column5.Width             = 95
		
		    * Col 6 - Moneda
		*!*	    .Column6.Header1.Caption   = "Mon"
		    .Column6.ControlSource     = lcAlias + ".moneda"
		*!*	    .Column6.Width             = 42
		    .Column6.Alignment         = 2
		
		    * Col 7 - Cotización Dólar
		    .Column7.Header1.Caption   = "$ Cotiz"
		*!*	    .Column7.ControlSource     = lcAlias + ".cotiz_dolar"
		    .Column7.Width             = 80
		    .Column7.Alignment         = 1
		
		    * Col 8 - Utilidad
		    .Column8.Header1.Caption   = "% Util"
		*!*	    .Column8.ControlSource     = lcAlias + ".utilidad"
		    .Column8.Width             = 70
		    .Column8.Alignment         = 1
		
		    .Visible = .T.
		ENDWITH
		
		*-- Estilo headers (si querés color uniforme)
		FOR i = 1 TO THISFORM.grd_hist.ColumnCount
		    THISFORM.grd_hist.Columns(i).Header1.BackColor = RGB(70, 130, 180)
		    THISFORM.grd_hist.Columns(i).Header1.ForeColor = RGB(255, 255, 255)
		    THISFORM.grd_hist.Columns(i).Header1.FontBold  = .T.
		NEXT
		
		*=========================================================
		* ? Doble click REAL: bind al grid
		*=========================================================
		=BINDEVENT(THISFORM.grd_hist, "DblClick", THISFORM, "Grid_DblClick")
		
		*=========================================================
		* Label informativo
		*=========================================================
		THISFORM.AddObject("lbl_info", "label")
		WITH THISFORM.lbl_info
		    .Left       = 15
		    .Top        = 345
		    .Width      = lnAnchoGrid
		    .Height     = 18
		    .Caption    = "Doble clic en un registro para ver el presupuesto completo"
		    .ForeColor  = RGB(180, 180, 180)
		    .BackStyle  = 0
		    .FontSize   = 8
		    .FontItalic = .T.
		    .Alignment  = 2
		    .Visible    = .T.
		ENDWITH
		
		*=========================================================
		* Botón Cerrar (SIN método extra)
		*=========================================================
		THISFORM.AddObject("cmd_cerrar", "commandbutton")
		WITH THISFORM.cmd_cerrar
		    .Width     = 110
		    .Height    = 28
		    .Left      = INT((THISFORM.Width - .Width) / 2)
		    .Top       = 370
		    .Caption   = "\<Cerrar"
		    .ForeColor = RGB(255, 255, 255)
		    .BackColor = RGB(227, 68, 34)
		    .Themes    = .F.
		    .Cancel    = .T.
		    .Visible   = .T.
		ENDWITH
		
		=BINDEVENT(THISFORM.cmd_cerrar, "Click", THISFORM, "DoClose")
		
		*-- Foco al grid
		THISFORM.grd_hist.SetFocus()
		
		THISFORM.grd_hist.Refresh
		THISFORM.Show()
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE cmd_cerrar.Click
		thisform.Release
	ENDPROC

	PROCEDURE grd_hist.Column2.Text1.DblClick
		
		
	ENDPROC

	PROCEDURE grd_hist.Column3.Text1.DblClick
		
		
	ENDPROC

	PROCEDURE grd_hist.Column6.Text1.DblClick
		
		
	ENDPROC

	PROCEDURE grd_hist.Column7.Text1.DblClick
		
		
	ENDPROC

ENDDEFINE

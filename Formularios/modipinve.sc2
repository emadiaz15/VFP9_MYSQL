		MaxButton = .F.
		Name = "MODIPINVE"
		Width = 315
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		Caption = "\<Modificar Item", ;
		Height = 25, ;
		Left = 34, ;
		Name = "Command1", ;
		Top = 85, ;
		Width = 109
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command2' AS commandbutton WITH ;

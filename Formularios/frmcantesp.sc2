DEFINE CLASS frmcantesp AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="lbl_ingrese" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="spn_cant" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command2" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		Caption = "Espacios a incorporar al rubro"
		Closable = .F.
		DoCreate = .T.
		Height = 140
		Icon = ..\imagen\iconos\access_041.ico
		MaxButton = .F.
		MinButton = .F.
		Name = "frmcantesp"
		Width = 486
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Aceptar", ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 257, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 96, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command2' AS commandbutton WITH ;
		BackColor = 227,68,34, ;
		Caption = "\<Cancelar", ;
		ForeColor = 255,255,255, ;
		Height = 27, ;
		Left = 146, ;
		Name = "Command2", ;
		Themes = .F., ;
		Top = 97, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'lbl_ingrese' AS label WITH ;
		AutoSize = .T., ;
		BackStyle = 0, ;
		Caption = "Ingrese la cantidad de espacios a adicionar al rubro:", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 33, ;
		Name = "lbl_ingrese", ;
		Top = 53, ;
		Width = 298
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'spn_cant' AS spinner WITH ;
		Format = "LK", ;
		Height = 25, ;
		InputMask = "99999999", ;
		Left = 336, ;
		Name = "spn_cant", ;
		Top = 47, ;
		Width = 117
		*< END OBJECT: BaseClass="spinner" />
	
	PROCEDURE Destroy
		RELEASE xtot
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS cantesp,xcantot
		
		PUBLIC xtot
		
		xtot=xcantot
		
		
		thisform.spn_cant.value=1
		thisform.spn_cant.spinnerlowvalue=1
		thisform.spn_cant.spinnerhighvalue=99999999
		
		THISFORM.AddProperty("oRet")
		THISFORM.oRet = CREATEOBJECT("Empty")
		
	ENDPROC

	PROCEDURE Unload
		RETURN thisform.oRet
	ENDPROC

	PROCEDURE Command1.Click
		IF thisform.spn_cant.Value+xtot>=99999999
			MESSAGEBOX("La cantidad ingresada supera la cantidad de articulos disponibles, consulte con el administrador del sistema",48,"Aviso del Sistema")
			RETURN 0
			thisform.spn_cant.SetFocus
		else
			ADDPROPERTY(thisform.oRet, "Cantr", thisform.spn_cant.value)
		ENDIF
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .F.
		this.FontSize= 9
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .T.
		this.FontSize= 10
	ENDPROC

	PROCEDURE Command2.Click
		ADDPROPERTY(thisform.oRet, "Cantr", 0)
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .F.
		this.FontSize= 9
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold= .T.
		this.FontSize= 10
	ENDPROC

	PROCEDURE spn_cant.Click
		this.SetFocus
		
	ENDPROC

ENDDEFINE

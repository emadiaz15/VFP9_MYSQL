	PROCEDURE Command5.Click
		local tsiva,letra_abc,dtipo,tipo
		************//////////// COMIENZA FACTURA ELECTRÓNICA \\\\\\\\\\\\\**********
		with thisform
			do case
				case .combo1.value="FACTURA"
					tipo="FC"
				case .combo1.value="N.CREDITO"
					tipo="NC"
				case .combo1.value="N.DEBITO"
					tipo="ND"
			endcase
			do case
				case cur_nomcli.cond_codi=1
					tsiva="F"
					letra_abc="B"
				case cur_nomcli.cond_codi=2
					tsiva="I"
					letra_abc="A"
				case cur_nomcli.cond_codi=4
					tsiva="M"
					letra_abc="B"
				case cur_nomcli.cond_codi=5
					tsiva="E"
					letra_abc="B"
			ENDCASE
			dtipo=tipo
			sele 0
			use "C:\Sistema Srl\Factelec\fe_cabez.dbf"
			set reprocess to automatic
			if flock()
				repla estado with "A"
				repla previa with "1"
				repla destino with "1"
				repla tipo with dtipo
				repla letra with letra_abc
				repla puesto with cur_confac.fac_pto
				repla numero with cur_confac.fac_nro
				repla fe_emi with .text3.value
				repla razon with cur_nomcli.cli_nomb
				repla domic with cur_nomcli.cli_domi
				repla local with cur_nomcli.loca_nomb
				if tsiva="I" or tsiva="E" or tsiva="M"
					repla cuit with allt(cur_nomcli.cli_cuit)
				else
					repla cuit with subst(allt(cur_nomcli.cli_cuit),3,8)
				endif		
				repla siva with tsiva
				repla ibru with space(15)
				repla condi with iif(tipo = "FC", "CTA. CTE. [VTO.:"+dtoc(.text3.value+30)+"]","CONTADO")+IIF(LEN(ALLTRIM(cur_confac.fac_pie))>0,"   - OBSER: "+ALLTRIM(cur_confac.fac_pie),"")
				repla otros with ""
				repla total with .text10.value
				repla neto210 with cur_confac.neto_1
				repla neto105 with cur_confac.neto_2
				repla neto270 with 0
				repla iva_210 with cur_confac.fac_ivari
				repla iva_105 with cur_confac.fac_ivarni
				repla iva_270 with 0
				repla exento with cur_confac.fac_ng
				repla nograb with 0
				repla iminte with 0
				repla subtotal with cur_confac.neto_1+cur_confac.neto_2+cur_confac.fac_ng
				repla descuento with ((cur_confac.neto_1+cur_confac.neto_2+cur_confac.fac_ng)*cur_confac.fac_dto)/100
				repla porcentaje with cur_confac.fac_dto
				repla cae with cur_confac.cae
				repla fvtocae with cur_confac.fvtocae
				repla observ with space(100)
				repla barra with cur_confac.barra
			endif
			sele 0
			use "C:\Sistema Srl\Factelec\fe_detal.dbf" exclusive
			set reprocess to automatic
			if flock()
				set safety off
				zap
				set safety on
				use in fe_detal
				use "C:\Sistema Srl\Factelec\fe_detal.dbf" exclusive
				SELECT cur_facart
				GO top
				LOCAL cCodigo
				scan
					sele fe_detal
					appe blan
					cCodigo = allt(cur_facart.art_codi)
					repla codigo with SUBSTR(cCodigo,AT(SUBSTR(STRTRAN(cCodigo,"0"),1,1),cCodigo))
					if VAL(cur_facart.art_codi)<=5
						if len(allt(cur_facart.artfac_desc))>44
							posin=1
							poscar=44
							contcar=44
							do while contcar<=len(allt(cur_facart.artfac_desc))
								if !inlist(subst(allt(cur_facart.artfac_desc),contcar,1)," ",".","-","_")
									do while !inlist(subst(allt(cur_facart.artfac_desc),contcar,1)," ",".","-","_")
										poscar=poscar-1
										contcar=contcar-1
									enddo
								endif
								if posin>1
									appe blank
								endif
								if posin=1
									cCodigo = allt(cur_facart.art_codi)
									repla codigo with SUBSTR(cCodigo,AT(SUBSTR(STRTRAN(cCodigo,"0"),1,1),cCodigo))
									repla cantid with cur_facart.artfac_cant
								endif
								repla descri with subst(allt(cur_facart.artfac_desc),posin,poscar)
								contcar=contcar+1
								posin=contcar
								restcar=len(allt(cur_facart.artfac_desc))-(contcar-1)
								if restcar<=44
									if posin>1
										appe blank
									endif
									if posin=1
										cCodigo = allt(cur_facart.art_codi)
										repla codigo with SUBSTR(cCodigo,AT(SUBSTR(STRTRAN(cCodigo,"0"),1,1),cCodigo))
										repla cantid with cur_facart.artfac_cant
									endif
									repla descri with subst(allt(cur_facart.artfac_desc),posin,poscar)
									exit
								else
									contcar=contcar+44
									poscar=44
								endif
							enddo
						else
							repla cantid with cur_facart.artfac_cant
							repla descri with allt(cur_facart.artfac_desc)
						endif						
					else
						repla cantid with cur_facart.artfac_cant
						repla descri with allt(cur_facart.artfac_desc)
					endif
					repla observ with space(49)
					repla prlist with cur_facart.artfac_impo
					repla bonifi with 0
					repla prunit with cur_facart.artfac_impo
					do case
						case cur_facart.calciva="SI"
							repla iva with iif(cur_facart.art_alicuota=1,cur_confac.iva_1,cur_confac.iva_2)
						case cur_facart.calciva="NO"
							repla iva with 0
					endcase
					repla inter with 0
					repla total with cur_facart.artfac_cant*cur_facart.artfac_impo
					sele cur_facart
				endscan
			endif
		ENDWITH
		cdir=sys(5)+sys(2003)
		oWsh = CREATEOBJECT ("wscript.shell")
		set defa to "C:\Sistema Srl\Factelec\"
		use in fe_cabez
		use in fe_detal
		oWsh.Run ("felec.exe", 3, .T.)
		set defa to (cdir)
		*******************FIN FACTURA ELECTRÓNICA********************************************
	ENDPROC


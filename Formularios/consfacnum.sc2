	PROCEDURE buscar_compasoc
		LPARAMETERS _xCodf
		
		LOCAL xpto,xfac,xtip,xcadeb,xtex,xnump,xpedtex
		***************************************BUSCA PEDIDO*********************************************
		IF thisform.xcodp>0
			frmconsfac= conectar_db(_screen.cn)
				SQLEXEC(frmconsfac,"select * from pedidos where ped_codi= ?thisform.xcodp;","cur_ped")
			desconectar_db(frmconsfac)
			IF RECCOUNT("cur_ped") > 0
				xnump  = IIF(cur_ped.notaped_nro>0 , cur_ped.notaped_nro, cur_ped.ped_codi)
				xpedtex= IIF(cur_ped.notaped_nro>0 , 'NPED_', 'PED_')
				xcade  = REPLICATE("0",8-LEN(ALLTRIM(STR(xnump ))))+ALLTRIM(STR(xnump ))
				INSERT INTO (thisform.xcurcomp) values(ALLTRIM(xpedtex+'0000'+'-'+xcade),'PED',cur_ped.ped_codi)
			ENDIF
		ENDIF
		
		cerrar_cursor("cur_ped")
		************************************************************************************************
		***************************************BUSCA REMITOS********************************************
		frmconsfac= conectar_db(_screen.cn)
			SQLEXEC(frmconsfac,"call usp_loadrem(?_xCodf);","cur_remi")
		desconectar_db(frmconsfac)
		
		IF RECCOUNT("cur_remi") > 0
			LOCATE
			SCAN
				xcade1 = REPLICATE("0",4-LEN(ALLTRIM(STR(cur_remi.rem_pto))))+ALLTRIM(STR(cur_remi.rem_pto))
				xcade2 = REPLICATE("0",8-LEN(ALLTRIM(STR(cur_remi.rem_nro))))+ALLTRIM(STR(cur_remi.rem_nro))
				INSERT INTO (thisform.xcurcomp) values(ALLTRIM('REM_'+xcade1+'-'+xcade2),'REM',cur_remi.rem_codi)		
			ENDSCAN
		ENDIF
		
		cerrar_cursor("cur_remi")
		************************************************************************************************
		******************************BUSCA CPBTE ASOC POR FAC / NC / ND********************************
		frmconsfac= conectar_db(_screen.cn)
			SQLEXEC(frmconsfac,"select * from facturas where fac_codi = ?_xCodf;","cur_lcomp")
		desconectar_db(frmconsfac)
		
		IF RECCOUNT("cur_lcomp") > 0
			LOCATE
			xtip   = ALLTRIM(cur_lcomp.fac_tipo)
			xpto   = ALLTRIM(STR(cur_lcomp.fac_pto))
			IF cur_lcomp.fac_compas > 0
				xfac = ALLTRIM(STR(cur_lcomp.fac_compas))
			ELSE
				xfac = ALLTRIM(STR(cur_lcomp.fac_nro))
			ENDIF
			xcadeb =  xtip + xpto + xfac
			frmconsfac= conectar_db(_screen.cn)
				IF cur_lcomp.fac_compas > 0
					SQLEXEC(frmconsfac,"select * from facturas where concat(TRIM(fac_tipo),TRIM(CAST(fac_pto as char)),TRIM(CAST(fac_nro as char))) = ?xcadeb;","cur_factu")
				ELSE
					SQLEXEC(frmconsfac,"select * from facturas where concat(TRIM(fac_tipo),TRIM(CAST(fac_pto as char)),TRIM(CAST(fac_compas as char))) = ?xcadeb;","cur_factu")
				ENDIF
			desconectar_db(frmconsfac)
			IF RECCOUNT("cur_factu") > 0
				LOCATE
				SCAN
					xcade1 = REPLICATE("0",4-LEN(ALLTRIM(STR(cur_factu.fac_pto))))+ALLTRIM(STR(cur_factu.fac_pto))
					xcade2 = REPLICATE("0",8-LEN(ALLTRIM(STR(cur_factu.fac_nro))))+ALLTRIM(STR(cur_factu.fac_nro))
					xtex = ICASE(cur_factu.fac_conc='F','FAC',cur_factu.fac_conc='N','NC',cur_factu.fac_conc='D','ND')
					INSERT INTO (thisform.xcurcomp) values(ALLTRIM(xtex+'_'+xcade1+'-'+xcade2),xtex,cur_factu.fac_codi)
				ENDSCAN
			ENDIF
		ENDIF
		
		cerrar_cursor("cur_lcomp")
		cerrar_cursor("cur_factu")
		************************************************************************************************
		****************************************BUSCA RECIBOS*******************************************
		frmconsfac= conectar_db(_screen.cn)
			SQLEXEC(frmconsfac,"select b.* from recibos_facturas a inner join recibos b on a.rec_codi = b.rec_codi where a.fac_codi=?_xCodf order by b.rec_codi;","cur_reci")
		desconectar_db(frmconsfac)
		
		IF RECCOUNT("cur_reci") > 0
			LOCATE
			SCAN
				xcade1 = REPLICATE("0",4-LEN(ALLTRIM(STR(cur_reci.rec_tipo))))+ALLTRIM(STR(cur_reci.rec_tipo))
				xcade2 = REPLICATE("0",8-LEN(ALLTRIM(STR(cur_reci.rec_nro))))+ALLTRIM(STR(cur_reci.rec_nro))
				INSERT INTO (thisform.xcurcomp) values(ALLTRIM('REC'+'_'+xcade1+'-'+xcade2),'REC',cur_reci.rec_codi)
			ENDSCAN	
		ENDIF
		
		cerrar_cursor("cur_reci")
		************************************************************************************************
		SELECT (thisform.xcurcomp)
		LOCATE
		
		thisform.comp_asoc.cmb_comp.RowSource = (thisform.xcurcomp)
		thisform.comp_asoc.cmb_comp.value = cpbte
	ENDPROC

	PROCEDURE datos_click
		
		thisform.RemoveObject("shp_datos")
		thisform.RemoveObject("edt_datos")
		thisform.RemoveObject("cmd_datos")
	ENDPROC

	PROCEDURE datos_mleave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.F.
		thisform.cmd_datos.FontSize=9
	ENDPROC

	PROCEDURE datos_mmove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.T.
		thisform.cmd_datos.FontSize=10
	ENDPROC

	PROCEDURE Destroy
		SET POINT TO
		SET SEPARATOR TO
		&&Cerrar_cursores()
		
	ENDPROC

	PROCEDURE grid_rightclick
		LOCAL lcShortcut, loRef
		m.loRef = this
		m.lcShortcut = SYS(2015)
		
		DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
		DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Ver Descripción Completa] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
		
		ON SELECTION BAR 1 OF (m.lcShortcut) m.loRef.Grid_ShowDesc()
		*!*	SET MARK OF BAR 1 OF (m.lcShortcut) TO m.loRef.lExpanded
		
		ACTIVATE POPUP (m.lcShortcut)
		RELEASE POPUP (m.lcShortcut)
		
	ENDPROC

	PROCEDURE grid_showdesc
		
		IF USED("cur_facart")
			IF VARTYPE(thisform.shp_datos)="U"
				thisform.AddObject("shp_datos","shape")
				WITH thisform.shp_datos
					.left    = 105
					.top     = 218
					.width   = 574
					.height  = 173
					.backcolor = RGB(140, 165, 176)
					.SpecialEffect = 0
					.Visible = .T.
				ENDWITH
					
				THISFORM. ADDOBJECT("edt_datos","EDITBOX")
				WITH THISform.edt_datos
					.left    = 117
					.top     = 231
					.width   = 550
					.height  = 125
					.disabledbackcolor = RGB(40,44,52)
					.forecolor = RGB(244,210,50)
					.fontsize  = 10
					.fontbold  = .T.
					.readonly  = .T.
					.value     = ALLTRIM(cur_facart.artfac_desc)
					.themes    = .F.
					.Visible   = .T.
				ENDWITH
				
				thisform.AddObject("cmd_datos","Commandbutton")
				WITH thisform.cmd_datos
					.left      = 333
					.top       = 359
					.width     = 108
					.height    = 27
					.themes    = .F.
					.forecolor = RGB(255,255,255)
					.backcolor = RGB(227,68,34)
					.alignment = 2
					.caption   = "\<Cerrar Ventana"
					.Visible   = .T.
					=BINDEVENT(ThisForm.cmd_datos, "Click", ThisForm, "datos_click")
					=BINDEVENT(ThisForm.cmd_datos, "MouseMove", ThisForm, "datos_mmove")
					=BINDEVENT(ThisForm.cmd_datos, "MouseLeave", ThisForm, "datos_mleave")
				ENDWITH
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		public acu,codifac
		set dele on
		SET DATE BRITISH
		SET CENTURY on
		SET POINT TO ","
		SET SEPARATOR TO "."
		acu=0
		
		thisform.xcurcomp = SYS(2015)
		CREATE CURSOR (thisform.xcurcomp)(cpbte C(20),tipcbte C(3),codbus N(10))
		
		frmconsfac= conectar_db(_screen.cn)
			SQLEXEC(frmconsfac,"select * from facturas order by fac_codi desc limit 1;","cur_facp")
		desconectar_db(frmconsfac)
		this.text5.value=cur_facp.fac_pto
		this.text2.value=0
		this.text4.value="A"
		this.text19.value=0
		
		this.combo1.additem("FACTURA",1)
		this.combo1.additem("N.CREDITO",2)
		this.combo1.additem("N.DEBITO",3)
		this.combo1.value="FACTURA"
		
		=BINDEVENT(ThisForm.grd_articulos, "RightClick", ThisForm, "Grid_RightClick")
	ENDPROC


	PROCEDURE Text2.LostFocus
		*!*	local dfac,letconc,fnro,fpto,ftip
		*!*	*!*	CREATE CURSOR detafac(nro_it N(8),nro_ar C(8),cant N(10,2),med C(2),artdes C(44),desclar M,impo N(10,3),imptot N(10,2),st C(2),ali N(10,2))
		*!*	with thisform
		*!*		.grid1.rows=1
		*!*		fpto=.text5.value
		*!*		fnro=this.Value
		*!*		ftip=ALLTRIM(.text4.value)
		*!*		DO case
		*!*			CASE ALLTRIM(.combo1.value)="FACTURA"
		*!*				letconc="F"
		*!*			CASE ALLTRIM(.combo1.value)="N.CREDITO"
		*!*				letconc="N"
		*!*		OTHERWISE
		*!*			letconc="D"
		*!*		ENDCASE
		*!*		frmconsfac= conectar_db(_screen.cn)
		*!*			SQLEXEC(frmconsfac,"select a.*,b.iva_1,b.iva_2 from facturas as a inner join iva as b on a.iva_codi=b.iva_codi where a.fac_pto=?fpto and a.fac_nro=?fnro and a.fac_tipo=?ftip and a.fac_conc=?letconc;","cur_confac")
		*!*		desconectar_db(frmconsfac)
		*!*		if reccount("cur_confac")>0
		*!*			codifac=cur_confac.fac_codi
		*!*			codicli=cur_confac.cli_codi
		*!*			frmconsfac= conectar_db(_screen.cn)
		*!*				SQLEXEC(frmconsfac,"call usp_buscarcli(?codicli);","cur_nomcli")
		*!*				LOCAL vendn
		*!*				vendn="JUAN ORIGLIA" && ALLTRIM(UPPER(substr(sys(0),ATC("#",sys(0))+2)))
		*!*				SQLEXEC(frmconsfac,"select * from vendedores where ven_nomb=?vendn;","cur_ven")
		*!*				IF RECCOUNT("cur_ven")>0
		*!*					SQLEXEC(frmconsfac,"select * from zonas where ven_codi=?cur_ven.ven_codi and zona_codi=?cur_nomcli.zona_codi;","cur_zoncli")
		*!*					IF RECCOUNT("cur_zoncli")>0
		*!*						thisform.estado_muestra=1
		*!*					ELSE
		*!*						MESSAGEBOX("La factura consultada no corresponde a ningun Cliente perteneciente a las zonas asignadas al vendedor "+ALLTRIM(cur_ven.ven_nomb)+".",48,"Aviso del Sistema")
		*!*						RETURN .F.
		*!*					ENDIF
		*!*				ELSE
		*!*					thisform.estado_muestra=1
		*!*				ENDIF
		*!*			desconectar_db(frmconsfac)
		*!*			IF thisform.estado_muestra=1
		*!*				do case
		*!*					case cur_confac.fac_conc="F" and cur_confac.anulado="S"
		*!*						.label5.visible=.T.
		*!*						.label5.caption="ANULADA"
		*!*					case cur_confac.fac_conc="F" and cur_confac.anulado<>"S"
		*!*						.label5.visible=.F.
		*!*					case cur_confac.fac_conc="N"
		*!*						.label5.visible=.T.
		*!*						.label5.caption="NOTA DE CRÉDITO"
		*!*					case cur_confac.fac_conc="D"
		*!*						.label5.visible=.T.
		*!*						.label5.caption="NOTA DE DÉBITO"
		*!*				endcase
		*!*				.text1.value=cur_nomcli.cli_nomb
		*!*				.text6.value=cur_nomcli.cond_desc
		*!*				.text12.value=SUBSTR(ALLTRIM(cur_nomcli.cli_cuit),1,2)+"-"+SUBSTR(ALLTRIM(cur_nomcli.cli_cuit),3,8)+"-"+SUBST(ALLTRIM(cur_nomcli.cli_cuit),11,1)
		*!*				.text7.value="0"+allt(cur_nomcli.cli_cartel)+"-"+allt(cur_nomcli.cli_tel1)
		*!*				.text3.value=cur_confac.fac_fec
		*!*				frmconsfac= conectar_db(_screen.cn)
		*!*					SQLEXEC(frmconsfac,"select rem_codi,rem_pto,rem_nro from remitos where fac_codi=?codifac;","cur_rem")
		*!*				desconectar_db(frmconsfac)
		*!*				if RECCOUNT()>0
		*!*					.text14.value=repl("0",4-len(allt(str(cur_rem.rem_pto))))+allt(str(cur_rem.rem_pto))+" - "+repl("0",8-len(allt(str(cur_rem.rem_nro))))+allt(str(cur_rem.rem_nro))
		*!*					.command4.enabled=.T.
		*!*				else

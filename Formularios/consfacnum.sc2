		*!*					.command4.enabled=.F.
		*!*				ENDIF
		*!*				.label12.caption=allt(str(cur_confac.iva_1,10,2))+"%"
		*!*				.label13.caption=allt(str(cur_confac.iva_2,10,2))+"%"
		*!*				.label21.caption=allt(cur_confac.cae)
		*!*				if len(allt(cur_confac.cae))>0 and cur_confac.anulado<>"S"
		*!*					.command5.enabled=.T.
		*!*				ELSE
		*!*					.command5.enabled=.F.
		*!*				endif
		*!*				impiva1=cur_confac.iva_1
		*!*				impiva2=cur_confac.iva_2
		*!*				.text19.value=cur_confac.fac_dto
		*!*				frmconsfac= conectar_db(_screen.cn)
		*!*					SQLEXEC(frmconsfac,"Select a.art_codi,b.art_desc,a.artfac_cant,b.art_med,a.artfac_impo,b.art_alicuota,a.calciva,a.artfac_sstock,a.artfac_dasc,a.artfac_nd,a.dac_codi from facturas_articulos as a inner join articulos as b on a.art_codi=b.art_codi where a.fac_codi=?codifac;","cur_facart")
		*!*				desconectar_db(frmconsfac)
		*!*				fila=1
		*!*				GO top
		*!*				SCAN
		*!*					cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
		*!*								   
		*!*					.grid1.additem(allt(str(fila))+chr(9)+cadena+chr(9)+allt(str(artfac_cant,10,2))+chr(9)+ ;
		*!*								   art_med+chr(9)+art_desc+chr(9)+allt(str(artfac_impo,10,3))+chr(9)+ ;
		*!*								   allt(str(artfac_cant*artfac_impo,10,2))+chr(9)+""+chr(9)+ ;
		*!*								   iif(calciva="NO","",allt(str(iif(art_alicuota=1,impiva1,impiva2),10,2))))
		*!*					if artfac_sstock="S"
		*!*						.grid1.col=7
		*!*						.grid1.row=fila
		*!*						.grid1.text="SS"
		*!*					endif
		*!*					if dac_codi>0
		*!*						.grid1.col=4
		*!*						.grid1.row=fila
		*!*						dc=dac_codi
		*!*						frmconsfac= conectar_db(_screen.cn)
		*!*							SQLEXEC(frmconsfac,"select * from desc_articulos_clientes where dac_codi=?dc;","cur_dac")
		*!*						desconectar_db(frmconsfac)
		*!*						IF RECCOUNT()>0
		*!*							.grid1.text=ALLTRIM(cur_dac.dac_desc)
		*!*							INSERT INTO auxdac(dac_codi,dac_desc);
		*!*										values(cur_dac.dac_codi,cur_dac.dac_desc)
		*!*						ENDIF				
		*!*					endif				
		*!*					if cur_facart.art_codi=4 OR cur_facart.art_codi=5
		*!*						.grid1.col=4
		*!*						.grid1.row=fila
		*!*						if cur_confac.fac_conc="D"
		*!*							.grid1.text=ALLTRIM(cur_facart.artfac_nd)
		*!*						ELSE
		*!*							.grid1.text=ALLTRIM(cur_facart.artfac_dasc)
		*!*						endif
		*!*					ENDIF
		*!*					.grid1.row=.grid1.rows-1
		*!*					.grid1.col=4
		*!*					if len(allt(.grid1.text))>44
		*!*						div=len(allt(.grid1.text))/44
		*!*						if div>int(div)
		*!*							longdes=int(div)+1
		*!*						else

		*!*					acu=acu+round((cur_facart.artfac_cant*cur_facart.artfac_impo),2)
		*!*					fila=fila+1
		*!*				ENDSCAN
		*!*				SELECT cur_facart
		*!*				SET RELATION TO dac_codi INTO auxdac addi
		*!*				if .text19.value>0
		*!*					dfac=round((100-.text19.value)/100,3)
		*!*					.text8.value=round((cur_confac.fac_ng+cur_confac.neto_1+cur_confac.neto_2)/dfac,2)
		*!*					.text17.value=round((.text8.value*.text19.value)/100,2)
		*!*				else
		*!*					.text8.value=cur_confac.fac_ng+cur_confac.neto_1+cur_confac.neto_2
		*!*				endif
		*!*				.text18.value=cur_confac.fac_ng+cur_confac.neto_1+cur_confac.neto_2
		*!*				.text9.value=cur_confac.fac_ivari
		*!*				.text11.value=cur_confac.fac_ivarni
		*!*				.text10.value=.text18.value+.text9.value+.text11.value
		*!*				acu=0
		*!*				thisform.estado_muestra=0
		*!*			ENDIF
		*!*		else
		*!*			messagebox("Factura no está en archivo",0+48,"Consulta de Facturas")
		*!*		endif
		*!*		if empty(cur_confac.fac_pie)
		*!*			.command1.enabled=.F.
		*!*		else
		*!*			.command1.enabled=.T.
		*!*		endif
		*!*		if empty(cur_confac.nc_texto)
		*!*			.command3.enabled=.F.
		*!*		else
		*!*			.command3.enabled=.T.
		*!*		ENDIF
		*!*		.text4.setfocus
		*!*	endwith
		
	ENDPROC

	PROCEDURE Text2.Valid
		local dfac,letconc,fnro,fpto,ftip,xvend,xporc
		IF RECCOUNT((thisform.xcurcomp)) > 0
			DELETE ALL
		ENDIF
		with thisform
			thisform.grd_articulos.RecordSource=''
			thisform.grd_articulos.Refresh
			fpto=.text5.value
			fnro=this.Value
			ftip=ALLTRIM(.text4.value)
			DO case
				CASE ALLTRIM(.combo1.value)="FACTURA"
					letconc="F"
				CASE ALLTRIM(.combo1.value)="N.CREDITO"
					letconc="N"
			OTHERWISE
				letconc="D"
			ENDCASE
			frmconsfac= conectar_db(_screen.cn)
				SQLEXEC(frmconsfac,"select a.*,b.iva_1,b.iva_2 from facturas as a inner join iva as b on a.iva_codi=b.iva_codi where a.fac_pto=?fpto and a.fac_nro=?fnro and a.fac_tipo=?ftip and a.fac_conc=?letconc;","cur_confac")
			desconectar_db(frmconsfac)
			if reccount("cur_confac")>0
				IF cur_confac.cotiz_dolar>0
					thisform.xdolar=cur_confac.cotiz_dolar
					thisform.btn_money.Visible= .T.
				ELSE
					thisform.xdolar=0
					thisform.btn_money.Visible= .F.
				ENDIF
				codifac=cur_confac.fac_codi
				codicli=cur_confac.cli_codi
				thisform.xcodp = cur_confac.ped_codi
				frmconsfac= conectar_db(_screen.cn)
					SQLEXEC(frmconsfac,"call usp_buscarcli(?codicli);","cur_nomcli")
					LOCAL vendn
					vendn=ALLTRIM(UPPER(substr(sys(0),ATC("#",sys(0))+2)))
					SQLEXEC(frmconsfac,"select * from vendedores where ven_nomb=?vendn;","cur_ven")
					IF RECCOUNT("cur_ven")>0
						SQLEXEC(frmconsfac,"select * from zonas where ven_codi=?cur_ven.ven_codi and zona_codi=?cur_nomcli.zona_codi;","cur_zoncli")
						IF RECCOUNT("cur_zoncli")>0
							thisform.estado_muestra=1
						ELSE
							MESSAGEBOX("La factura consultada no corresponde a ningun Cliente perteneciente a las zonas asignadas al vendedor "+ALLTRIM(cur_ven.ven_nomb)+".",48,"Aviso del Sistema")
							RETURN .F.
						ENDIF
					ELSE
						thisform.estado_muestra=1
					ENDIF
				desconectar_db(frmconsfac)
				IF thisform.estado_muestra=1
					thisform.ncondcli = cur_nomcli.cond_codi
					.text1.value=cur_nomcli.cli_nomb
					.text6.value=cur_nomcli.cond_desc
					.text12.value=SUBSTR(ALLTRIM(cur_nomcli.cli_cuit),1,2)+"-"+SUBSTR(ALLTRIM(cur_nomcli.cli_cuit),3,8)+"-"+SUBST(ALLTRIM(cur_nomcli.cli_cuit),11,1)
					.text7.value="0"+allt(cur_nomcli.cli_cartel)+"-"+allt(cur_nomcli.cli_tel1)
					.text3.value=cur_confac.fac_fec
					.label12.caption=allt(str(cur_confac.iva_1,10,2))+"%"
					.label13.caption=allt(str(cur_confac.iva_2,10,2))+"%"
					.label21.caption=allt(cur_confac.cae)
					if len(allt(cur_confac.cae))>0 and cur_confac.anulado<>"S"
						.command5.enabled=.T.
					ELSE
						.command5.enabled=.F.
					endif
					impiva1=cur_confac.iva_1
					impiva2=cur_confac.iva_2
					.text19.value=cur_confac.fac_dto
					IF cur_confac.ven_codi>0
						xvend=cur_confac.ven_codi
						frmconsfac= conectar_db(_screen.cn)
							SQLEXEC(frmconsfac,"select * from vendedores where ven_codi = ?xvend;","cur_vendcf")
						desconectar_db(frmconsfac)
						IF RECCOUNT("cur_vendcf") > 0
							thisform.ctn_vendedor.lbl_vend.Caption=ALLTRIM(cur_vendcf.ven_nomb)
						ENDIF
						IF cur_confac.otra_comi > 0
							thisform.ctn_vendedor.lbl_comi.Caption=ALLTRIM(STR(cur_confac.otra_comi))+"%"
						ELSE
							IF cur_confac.porc_codi>0
								xporc = cur_confac.porc_codi
								frmconsfac= conectar_db(_screen.cn)
									SQLEXEC(frmconsfac,"select * from porcencomi where porc_codi = ?xporc;","cur_porcf")
								desconectar_db(frmconsfac)
								IF RECCOUNT("cur_porcf") > 0
									thisform.ctn_vendedor.lbl_comi.Caption='"'+ALLTRIM(cur_porcf.porc_desc)+'"'+' '+ALLTRIM(STR(cur_porcf.porc_impo,8,3))+'%'
								ENDIF
							ENDIF
						ENDIF
						IF USED("cur_vendcf")
							cerrar_cursor("cur_vendcf")
						ENDIF
						IF USED("cur_porcf")
							cerrar_cursor("cur_porcf")
						ENDIF
					ELSE
						thisform.ctn_vendedor.lbl_vend.Caption=""
						thisform.ctn_vendedor.lbl_comi.Caption=""
					ENDIF			
					SET DECIMALS TO 3
					frmconsfac= conectar_db(_screen.cn)
						SQLEXEC(frmconsfac,"call usp_facnum(?codifac);","cur_facart")
					desconectar_db(frmconsfac)
					SET DECIMALS TO
					GO TOP
					thisform.grd_articulos.RecordSource="cur_facart"
					thisform.grd_articulos.column5.ControlSource="(artfac_desc)"
					if .text19.value>0
						dfac=round((100-.text19.value)/100,3)
						.text8.value=round((cur_confac.fac_ng+cur_confac.neto_1+cur_confac.neto_2)/dfac,2)
						.text17.value=round((.text8.value*.text19.value)/100,2)
					else
						.text8.value=cur_confac.fac_ng+cur_confac.neto_1+cur_confac.neto_2
					endif
					.text18.value=cur_confac.fac_ng+cur_confac.neto_1+cur_confac.neto_2
					.text9.value=cur_confac.fac_ivari
					.text11.value=cur_confac.fac_ivarni
					.text10.value=.text18.value+.text9.value+.text11.value
					acu=0
					thisform.buscar_compasoc(codifac)
				ENDIF
			else
				messagebox("Factura no está en archivo",0+48,"Consulta de Facturas")
			endif
			if empty(cur_confac.fac_pie)
				.command1.enabled=.F.
			else
				.command1.enabled=.T.
			endif
			if empty(cur_confac.nc_texto)
				.command3.enabled=.F.
			else
				.command3.enabled=.T.
			ENDIF
			KEYBOARD '{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'
			
		endwith
		
	ENDPROC

	PROCEDURE Text4.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text5.Click
		this.setfocus
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="2" />

	*<PropValue>
		DataSource = .NULL.
		Height = 618
		Left = 1
		Name = "Dataenvironment"
		Top = 220
		Width = 1264
	*</PropValue>

ENDDEFINE

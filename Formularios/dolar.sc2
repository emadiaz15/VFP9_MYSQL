		this.text2.value=0.000
		
	ENDPROC

	PROCEDURE Command1.Click
		valor=thisform.text2.value
		update articulos set art_precio=art_precio/valor
		thisform.release
	ENDPROC

	PROCEDURE Command2.Click
		thisform.release
	ENDPROC


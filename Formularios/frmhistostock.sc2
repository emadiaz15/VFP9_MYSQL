	PROCEDURE GotFocus
		*!*	codigo = thisform.xcodigo
	ENDPROC

	PROCEDURE grid_dobleclick
		IF USED("cur_histost")
			DO case
				CASE cur_histost.aju_codi>0
					DO FORM consajuste WITH cur_histost.aju_codi
				CASE cur_histost.recep_codi>0
					LOCAL xcodiclirpo
					xcodiclirpo=cur_histost.codi_clipro
					frmhs= conectar_db(_screen.cn)
						SQLEXEC(frmhs,"call usp_buscarprov(?xcodiclirpo);","cur_prov")
					desconectar_db(frmhs)	
					codrec=cur_histost.recep_codi
					cond=cur_histost.cond_codi
					pasrecep=1
					do form consrecep with codrec,cond
				CASE cur_histost.fac_codi>0
					pasfac=1
					codifac=cur_histost.fac_codi
					cond=cur_histost.cond_codi
					DO FORM consfactura WITH codifac,cond
				CASE cur_histost.rem_codi>0
					cond=cur_histost.cond_codi
					DO FORM consremito WITH cur_histost.rem_codi,cond
				CASE cur_histost.fab_codi>0
					DO FORM frmconsing WITH cur_histost.fab_codi
			ENDCASE 
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tnCodigo
		
		*!*	PUBLIC codigo,nombre,codifac,pasfac,pasrecep,pasrem
		
		*-------------------------
		* Defaults / Propiedades
		*-------------------------
		IF PEMSTATUS(THISFORM, "lInvocado", 5) = .F.
			THISFORM.AddProperty("lInvocado", .F.)
		ENDIF
		IF PEMSTATUS(THISFORM, "nCodigoInicial", 5) = .F.
			THISFORM.AddProperty("nCodigoInicial", 0)
		ENDIF
		IF PEMSTATUS(THISFORM, "lAutoConsultar", 5) = .F.
			THISFORM.AddProperty("lAutoConsultar", .T.) && Ponerlo .F. si NO querés autoconfirmar consulta
		ENDIF
		IF PEMSTATUS(THISFORM, "xcodigo", 5) = .F.
			THISFORM.AddProperty("xcodigo", 0)
		ENDIF
		
		THISFORM.lInvocado     = (VARTYPE(tnCodigo) = "N" AND tnCodigo > 0)
		THISFORM.nCodigoInicial = IIF(THISFORM.lInvocado, tnCodigo, 0)
		
		STORE 1 TO pasfac,pasrecep,pasrem
		
		codigo = 0
		nombre = ""
		
		frmhs= conectar_db(_screen.cn)
			SQLEXEC(frmhs,"select param_desc nomemp from parametros where param_codi=13;","cur_empre")
		desconectar_db(frmhs)
		
		thisform.txt_codigo.Value=0
		thisform.txt_fecdes.Value=ctod("01/01/"+allt(str(year(date()))))
		thisform.txt_fechas.Value=DATE()
		
		FOR ncol=1 TO 8
			xsource="Thisform.grd_histo.column"+ALLTRIM(STR(ncol))+".text1"
			BINDEVENT(&xsource,"DblClick",Thisform,"Grid_DobleClick")
		NEXT ncol
		
		*-------------------------
		* INVOCADO: precarga
		*-------------------------
		IF THISFORM.lInvocado
		
			THISFORM.xcodigo = THISFORM.nCodigoInicial
			THISFORM.txt_codigo.Value = THISFORM.nCodigoInicial
		
			frmhs = conectar_db(_screen.cn)
				SQLEXEC(frmhs, "select art_codi, art_desc from articulos where art_codi=?THISFORM.nCodigoInicial;", "cur_arti")
			desconectar_db(frmhs)
		
			IF RECCOUNT("cur_arti") > 0
				THISFORM.txt_descri.Value = cur_arti.art_desc
			ENDIF
		
			IF USED("cur_arti")
				USE IN cur_arti
			ENDIF
		
			* UX: bloquear cambio de artículo si viene desde consart
			THISFORM.txt_codigo.Enabled = .F.
			THISFORM.cmd_artload.Enabled = .F.
		
			* Auto-consultar
			IF THISFORM.lAutoConsultar
				DOEVENTS
				THISFORM.cmd_ver.Click()
			ENDIF
		
			THISFORM.cmd_ver.SetFocus
		
		ELSE
			*-------------------------
			* Standalone: listo para buscar artículo
			*-------------------------
			THISFORM.txt_codigo.Enabled = .T.
			THISFORM.cmd_artload.Enabled = .T.
			THISFORM.txt_codigo.SetFocus
		ENDIF
		
		
	ENDPROC

	PROCEDURE LostFocus
		*!*	thisform.xcodigo=codigo
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnNregis
		
		LOCAL lnColor
		
			IF MOD(tnNregis,2) <> 0
				lnColor = RGB(230,230,230)
			ELSE
				lnColor = RGB(255,255,255)
			ENDIF
			
		return(lnColor)
	ENDPROC

	PROCEDURE Cmdcal1.MouseUp
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_ver.SetFocus
	ENDPROC

	PROCEDURE Cmdcal2.MouseUp
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_ver.SetFocus
	ENDPROC

	PROCEDURE cmd_artload.Click
		LOCAL xcc&&,xcodigo
		thisform.xcodigo=0
		thisform.txt_codigo.value=0
		do form artload with codigo
		if codigo>0
			frmhs= conectar_db(_screen.cn)
				SQLEXEC(frmhs,"select art_codi,art_desc from articulos where art_codi=?codigo;","cur_arti")
			desconectar_db(frmhs)
			thisform.txt_codigo.value=cur_arti.art_codi
			thisform.txt_descri.value=cur_arti.art_desc
			cerrar_cursor("cur_arti")
			thisform.txt_codigo.SetFocus
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE cmd_artload.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE cmd_artload.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE cmd_print.Click
		SELECT cur_histost
		LOCATE
		
		DO case
			CASE thisform.chk_pant.Value=0
				REPORT FORM histostock FOR cur_histost.art_codi = thisform.txt_codigo.value TO PRINTER PROMPT NOCONSOLE
			CASE thisform.chk_pant.Value=1
				REPORT FORM histostock FOR cur_histost.art_codi = thisform.txt_codigo.value PREVIEW NOCONSOLE
		ENDCASE
	ENDPROC

	PROCEDURE cmd_print.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE cmd_print.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE cmd_ver.Click
		LOCAL fecdes,fechas,xcodigo
		
		xcodigo=thisform.xcodigo
		fecdes= thisform.txt_fecdes.Value
		fechas= thisform.txt_fechas.Value
		thisform.grd_histo.RecordSource=''
		thisform.grd_histo.Refresh
		IF USED("cur_histost")
			USE IN cur_histost
		ENDIF
		
		SET DECIMALS TO 3
		frmhs= conectar_db(_screen.cn)
			SQLEXEC(frmhs,"select * from histostock where art_codi=?xcodigo and hs_fecha between ?fecdes and ?fechas order by hs_codi;","cur_staux")
		desconectar_db(frmhs)
		
		select hs_fecha,hs_hora,hs_tipmov,hs_anterior, ;
			   hs_cant,hs_saldo,hs_obser,hs_deta,aju_codi, ;
			   recep_codi,fac_codi,rem_codi,fab_codi, ;
			   cond_codi,codi_clipro,art_codi ;
			from cur_staux INTO CURSOR cur_histost
		
		cerrar_cursor("cur_staux")
		
		SET DECIMALS TO
		
		IF RECCOUNT("cur_histost")>0
			SELECT cur_histost
			LOCATE
			thisform.grd_histo.RecordSource="cur_histost"
			thisform.grd_histo.SetAll("DynamicBackColor","thisform.obtenercolor(RECNO())","Column")
			thisform.grd_histo.column2.ControlSource="(TTOC(hs_hora,2))"
			thisform.grd_histo.column7.ControlSource="(hs_obser)"
			thisform.grd_histo.column8.ControlSource="(hs_deta)"
			thisform.grd_histo.Refresh()
			thisform.lbl_cantreg.Caption="Cantidad de Movimientos encontrados "+ALLTRIM(STR(RECCOUNT("cur_histost")))
			thisform.cmd_print.Enabled= .T.
		ELSE
			thisform.lbl_cantreg.Caption="Cantidad de Movimientos encontrados 0"
			thisform.cmd_print.Enabled= .F.
		ENDIF
		thisform.txt_codigo.SetFocus
	ENDPROC

	PROCEDURE cmd_ver.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE cmd_ver.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE Command2.Click
		thisform.Release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.F.
		this.FontSize=9
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontBold=.T.
		this.FontSize=10
	ENDPROC

	PROCEDURE txt_codigo.Click
		this.setfocus
	ENDPROC

	PROCEDURE txt_codigo.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
	ENDPROC

	PROCEDURE txt_codigo.LostFocus
		IF LASTKEY()=13
			IF this.Value>0
				frmhs= conectar_db(_screen.cn)
					SQLEXEC(frmhs,"select art_codi,art_desc from articulos where art_codi=?this.value;","cur_arti")
				desconectar_db(frmhs)
				IF RECCOUNT("cur_arti")>0
					thisform.xcodigo=cur_arti.art_codi
					thisform.txt_descri.value=cur_arti.art_desc
				ELSE
					MESSAGEBOX("Artículo no encontrado",48,"Aviso del Sistema")
					thisform.txt_descri.Value=""
					NODEFAULT
					this.Click
				ENDIF
			ENDIF
		ELSE
			thisform.grd_histo.RecordSource=''
			thisform.grd_histo.Refresh()
			IF USED("cur_histost")
				USE IN cur_histost
			ENDIF
			thisform.lbl_cantreg.Caption=""
			thisform.txt_descri.Value=''
			thisform.xcodigo=0
		ENDIF
		
	ENDPROC

ENDDEFINE

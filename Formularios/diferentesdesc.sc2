	ADD OBJECT 'txt_dsis' AS textbox WITH ;
		BackColor = 40,44,52, ;
		FontBold = .T., ;
		ForeColor = 244,210,50, ;
		Height = 23, ;
		Left = 106, ;
		Name = "txt_dsis", ;
		Style = 1, ;
		Top = 15, ;
		Width = 344
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		parameter codicli,codiprov,descri,codigo
		public nombre
		nombre=""
		with thisform
		do case
			case codicli>0
				frmdifed= conectar_db(_screen.cn)
					SQLEXEC(frmdifed,"select cli_nomb from clientes where cli_codi=?codicli;","cur_nom")
				desconectar_db(frmdifed)
				nombre=cur_nom.cli_nomb
				cerrar_cursor("cur_nom")
				SELECT dac_desc,artcli_codi FROM cur_difdes INTO CURSOR difedes
				.list1.rowsource="difedes"
			case codiprov>0
				frmdifed= conectar_db(_screen.cn)
					SQLEXEC(frmdifed,"select prov_nomb from proveedores where prov_codi=?codiprov;","cur_nom")
				desconectar_db(frmdifed)
				nombre=cur_nom.prov_nomb
				cerrar_cursor("cur_nom")
				SELECT dap_desc,artpro_codi FROM cur_difdes INTO CURSOR difedes
				.list1.rowsource="difedes"
		endcase
		.caption="Descripciones utilizadas para "+allt(nombre)
		this.txt_dsis.Value=allt(cur_arti.art_desc)
		endwith
		
		
	ENDPROC

	PROCEDURE Unload
		return descri
	ENDPROC

	PROCEDURE cmd_masdes.Click
		descri = ALLTRIM(thisform.txt_dsis.Value)
		thisform.Release
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			do case
				case codicli>0
					descri=difedes.dac_desc
					cerrar_cursor("difedes")
				case codiprov>0
					descri=difedes.dap_desc
					cerrar_cursor("difedes")
			endcase
			.release
		endwith
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		*!*	descri=""
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE List1.Click
		for i=1 to this.listcount
			if this.selected(i)
				thisform.command1.enabled=.T.
			endif
		next
	ENDPROC

ENDDEFINE

		Width = 141
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txt_prem' AS textbox WITH ;
		Alignment = 2, ;
		FontBold = .T., ;
		FontSize = 17, ;
		Format = "LK", ;
		Height = 34, ;
		InputMask = "####", ;
		Left = 322, ;
		Name = "txt_prem", ;
		TabIndex = 2, ;
		Top = 21, ;
		Width = 74
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		SET NOTIFY off
		frmnrem= conectar_db(_screen.cn)
			SQLEXEC(frmnrem,"select rem_pto from remitos order by rem_codi desc limit 1;","cur_nrlo")
		desconectar_db(frmnrem)
		thisform.txt_prem.Value=cur_nrlo.rem_pto
		thisform.txt_nrem.Value=0
		thisform.txt_fecha.Value=''
		thisform.txt_cliente.Value=''
		cerrar_cursor("frmnrem")
	ENDPROC

	PROCEDURE btn_cancel.Click
		thisform.Release
		
	ENDPROC

	PROCEDURE btn_cancel.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE btn_cancel.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE btn_cont.Click
		&& aquí va tambien como local la variable codp cuando continúe con el otro desarrollo
		thisform.txt_nrem.SetFocus
		
		codp=0
		
		codre=thisform.codrem
		
		do form itemsfac with codp,codre,cond,codicli
		
		
		thisform.release
	ENDPROC

	PROCEDURE btn_cont.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE btn_cont.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE txt_nrem.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE txt_nrem.Valid
		IF this.Value>0
			LOCAL xcade,codrem
			xcade= ALLTRIM(STR(thisform.txt_prem.value))+ALLTRIM(STR(thisform.txt_nrem.value))
			frmnrem= conectar_db(_screen.cn)
				SQLEXEC(frmnrem,"select a.*,b.cli_nomb,b.cond_codi from remitos a inner join clientes b on a.cli_codi=b.cli_codi where concat(TRIM(CAST(rem_pto as char)),TRIM(CAST(rem_nro as char)))=?xcade;","cur_remn")
			desconectar_db(frmnrem)
			IF RECCOUNT("cur_remn")>0
				IF cur_remn.facturado=0
					thisform.txt_fecha.Value   =cur_remn.rem_fech
					thisform.txt_cliente.Value =cur_remn.cli_nomb
					codrem=cur_remn.rem_codi
					cond=cur_remn.cond_codi
					codicli=cur_remn.cli_codi
					thisform.btn_cont.Enabled= .T.
					KEYBOARD '{TAB}'
					thisform.codrem=codrem
				ELSE
		*!*				frmnrem= conectar_db(_screen.cn)
		*!*					SQLEXEC(frmnrem,"select a.fac_pto,a.fac_nro,TRIM(b.cli_nomb) cli_nomb from facturas a inner join clientes b on a.cli_codi=b.cli_codi where a.fac_codi=?cur_remn.fac_codi;","cur_hf")
		*!*				desconectar_db(frmnrem)
		*!*				xcade= REPLICATE("0",4-LEN(ALLTRIM(STR(cur_hf.fac_pto))))+ALLTRIM(STR(cur_hf.fac_pto))+" - "+ ;
		*!*					   REPLICATE("0",8-LEN(ALLTRIM(STR(cur_hf.fac_nro))))+ALLTRIM(STR(cur_hf.fac_nro))
		*!*				MESSAGEBOX("El Remito ingresado ya fue facturado con Factura Nº: "+xcade+" a nombre de "+cur_hf.cli_nomb+".",0+48,"Aviso del Sistema")
					MESSAGEBOX("El Remito ingresado ya fue facturado totalmente",0+48,"Aviso del Sistema")
					thisform.btn_cont.Enabled= .F.
					this.Value=0
					thisform.txt_fecha.Value=''
					thisform.txt_cliente.Value=''
					return .F.
				ENDIF
				cerrar_cursor("cur_remn")
		*!*			cerrar_cursor("cur_hf")
			ELSE
				MESSAGEBOX("Remito no se encuentra en archivo.",0+48,"Aviso del Sistema")
				thisform.btn_cont.Enabled= .F.
				this.Value=0
				thisform.txt_fecha.Value=''
				thisform.txt_cliente.Value=''
				return .F.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE txt_prem.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

ENDDEFINE

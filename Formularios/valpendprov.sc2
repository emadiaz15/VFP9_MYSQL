	PROCEDURE txt_codart.Click
		this.value=0
		this.setfocus
	ENDPROC

	PROCEDURE txt_codart.GotFocus
		set notify off
		thisform.cmb_art.rowsourcetype=3
	ENDPROC

	PROCEDURE txt_codart.LostFocus
		set notify on
	ENDPROC

	PROCEDURE txt_codart.Valid
		if this.value>0
			frmvalpend= conectar_db(_screen.cn)
				SQLEXEC(frmvalpend,"select * from articulos where art_codi=?this.value;","cur_art")
			desconectar_db(frmvalpend)
			if RECCOUNT("cur_art")>0
				thisform.ncodiart=cur_art.art_codi
				thisform.cmb_art.rowsource="SELECT art_desc FROM cur_art INTO CURSOR cmb_art"
				thisform.cmb_art.value=thisform.cmb_art.list(1)
				thisform.chk_art.Value=0
				thisform.cmd_actualizar.Click
				keyboard '{TAB}'+'{TAB}'+'{TAB}'
			else
				=messagebox("Artículo no está en archivo",0+48,"Advertencia")
				thisform.ncodiart=0
				this.value=0
				return .F.
			endif
		endif
	ENDPROC


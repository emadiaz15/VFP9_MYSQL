				thisform.ncodiprov=cur_pro.prov_codi
				thisform.cmb_prov.rowsource="SELECT prov_nomb FROM cur_pro INTO CURSOR cmb_prov"
				thisform.cmb_prov.value=thisform.cmb_prov.list(1)
				thisform.chk_prov.Value=0
				thisform.cmd_actualizar.Click
				keyboard '{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'
			else
				=messagebox("Proveedor no está en archivo",0+48,"Advertencia")
				thisform.ncodiprov=0
				this.value=0
				return .F.
			endif
		endif
	ENDPROC


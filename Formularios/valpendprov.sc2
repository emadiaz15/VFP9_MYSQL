	PROCEDURE cmd_actualizar.Click
		LOCAL xcodiprov,xcodigo,xdolar
		thisform.grd_detalle.RecordSource=''
		thisform.grd_detalle.Refresh
		xcodiprov= thisform.ncodiprov
		xcodigo  = thisform.ncodiart
		xdolar   = thisform.txt_cotiz.Value
		
		SET DECIMALS TO 3
		frmvalpend= conectar_db(_screen.cn)
			SQLEXEC(frmvalpend,"call usp_valpend(?xcodiprov,?xcodigo);","cur_valpen1")
		desconectar_db(frmvalpend)
		SET DECIMALS TO
		
		IF RECCOUNT("cur_valpen1")>0
			GO top
			SELECT prov_nomb, ;
				   orden_codi, ;
				   orden_fech, ;
				   art_codi, ;
				   cantidad, ;
				   padr(left(descripcion,len(descripcion)),254," "), ;
				   IIF(moneda="D",ROUND(neto*xdolar,3),neto) as neto, ;
				   IIF(moneda="D",ROUND(iva*xdolar,3),iva) as iva, ;
				   IIF(moneda="D",ROUND(total*xdolar,3),total) as total, ;
				   prov_codi, ;
				   cond_codi, ;
				   moneda FROM cur_valpen1 INTO CURSOR cur_valpen readwrite
			SELECT ROUND(SUM(neto),2) FROM cur_valpen  INTO ARRAY xneto
			SELECT ROUND(SUM(iva),2) FROM cur_valpen   INTO ARRAY xiva
			SELECT ROUND(SUM(total),2) FROM cur_valpen INTO ARRAY xtotal
			thisform.txt_totneto.Value= xneto[1,1]
			thisform.txt_totiva.Value = xiva[1,1]
			thisform.txt_tottot.Value = xtotal[1,1]
			thisform.grd_detalle.RecordSource="cur_valpen"
			ThisForm.grd_detalle.SetAll("DynamicBackColor","Thisform.ObtenerColor(cur_valpen.moneda)", "Column")
			thisform.cmd_exclu.Visible= .F.
		ELSE
			STORE 0 TO 	thisform.txt_totneto.value, ;
						thisform.txt_totiva.value, ;
						thisform.txt_tottot.value
		ENDIF
		
		Cerrar_Cursor("cur_valpen1")
		
	ENDPROC

	PROCEDURE cmd_actualizar.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE cmd_actualizar.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE cmd_exclu.Click
		thisform.grd_detalle.RecordSource=''
		thisform.grd_detalle.Refresh
		LOCAL xcprov
		xcprov = cur_valpen.prov_codi
		
		DELETE FROM cur_valpen WHERE cur_valpen.prov_codi = xcprov
		
		SELECT SUM(neto) FROM cur_valpen  INTO ARRAY xneto
		SELECT SUM(iva) FROM cur_valpen   INTO ARRAY xiva
		SELECT SUM(total) FROM cur_valpen INTO ARRAY xtotal
		thisform.txt_totneto.Value= xneto[1,1]
		thisform.txt_totiva.Value = xiva[1,1]
		thisform.txt_tottot.Value = xtotal[1,1]
		GO TOP IN cur_valpen
		thisform.grd_detalle.RecordSource="cur_valpen"
		
		this.Visible= .F.
		thisform.cmd_actualizar.SetFocus
		
	ENDPROC

	PROCEDURE cmd_exclu.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE cmd_exclu.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC


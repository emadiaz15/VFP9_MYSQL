	PROCEDURE Activate
		frmvalpend= conectar_db(_screen.cn)
			SQLEXEC(frmvalpend,"select param_impo from parametros where param_codi=14;","cur_cotiz")
		desconectar_db(frmvalpend)
		
		IF RECCOUNT("cur_cotiz")>0
			thisform.txt_cotiz.Value=cur_cotiz.param_impo
		ENDIF
		
		Cerrar_Cursor("cur_cotiz")
		
		
		
	ENDPROC

	PROCEDURE Init
		SET POINT TO ","
		SET SEPARATOR TO "."
		
		DIMENSION xneto[1,1]
		DIMENSION xiva[1,1]
		DIMENSION xtotal[1,1]
		
		thisform.txt_fecha.Value=DATE()
		thisform.txt_codart.Value=0
		thisform.txt_codiprov.Value=0
		
		
	ENDPROC

	PROCEDURE obtenercolor
		LParameters tnMoneda
		
		Local lnColor
		
			DO case
				CASE tnMoneda = "D"
					lnColor = RGB(128,255,128)
				CASE tnMoneda = "P"
					lnColor = RGB(255,255,160)
			ENDCASE
		Return(lnColor)
	ENDPROC

	PROCEDURE chk_art.Click
		IF this.Value=1
			thisform.ncodiart=0
			thisform.txt_codart.value=0
			thisform.cmb_art.value=''
			thisform.cmb_art.RowSource=''
			thisform.cmd_actualizar.click
			thisform.cmd_actualizar.setfocus
		ELSE
			thisform.ncodiart=0
			thisform.txt_codart.SetFocus
		endif
	ENDPROC

	PROCEDURE chk_prov.Click
		IF this.Value=1
			thisform.ncodiprov=0
			thisform.txt_codiprov.value=0
			thisform.cmb_prov.value=''
			thisform.cmb_prov.RowSource=''
			thisform.cmd_actualizar.click
			thisform.cmd_actualizar.setfocus
		ELSE
			thisform.ncodiprov=0
			thisform.txt_codiprov.SetFocus
		endif
	ENDPROC

	PROCEDURE cmb_art.Click
		this.setfocus
	ENDPROC

	PROCEDURE cmb_art.Destroy
		set notify on
	ENDPROC

	PROCEDURE cmb_art.GotFocus
		set notify off
		
		
	ENDPROC

	PROCEDURE cmb_art.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					frmvalpend= conectar_db(_screen.cn)
						xdesc=allt(this.list(i))
						SQLEXEC(frmvalpend,"select * from articulos where TRIM(art_desc)=?xdesc;","cur_art")
					desconectar_db(frmvalpend)
					thisform.txt_codart.value=cur_art.art_codi
					thisform.ncodiart=cur_art.art_codi
					thisform.chk_art.Value=0
					keyboard '{TAB}'+'{TAB}'+'{TAB}'+'{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE cmb_art.LostFocus
		IF thisform.ncodiart>0
			thisform.cmd_actualizar.Click
		endif
	ENDPROC

	PROCEDURE cmb_art.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade="%"+subst(allt(this.text),2,len(allt(this.text)))+"%"
				frmvalpend= conectar_db(_screen.cn)
					SQLEXEC(frmvalpend,"select * from articulos where art_desc like ?cade order by art_desc;","cur_art")
				desconectar_db(frmvalpend)
				IF RECCOUNT("cur_art")>0
					this.rowsource="select art_desc from cur_art INTO CURSOR cmb_art"
					this.value=this.list(1)
					keyboard "{F4}"
					return .F.
				endif
			else
				if len(allt(this.text))>0
					cade=ALLTRIM(this.text)+"%"
					frmvalpend= conectar_db(_screen.cn)
						SQLEXEC(frmvalpend,"select * from articulos where art_desc like ?cade;","cur_art")
					desconectar_db(frmvalpend)
					IF RECCOUNT("cur_art")>0
						this.rowsource="select art_desc from cur_art INTO CURSOR cmb_art"
						this.value=this.list(1)
						keyboard "{F4}"
						return .F.
					endif
				endif
			endif
		endif
	ENDPROC


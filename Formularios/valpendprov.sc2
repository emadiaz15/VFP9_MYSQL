					frmvalpend= conectar_db(_screen.cn)
						SQLEXEC(frmvalpend,"select * from proveedores where prov_nomb like ?cade;","cur_pro")
					desconectar_db(frmvalpend)
					IF RECCOUNT("cur_pro")>0
						this.rowsource="select prov_nomb from cur_pro INTO CURSOR cmb_prov"

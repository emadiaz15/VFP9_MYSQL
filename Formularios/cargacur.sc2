DEFINE CLASS cargacur AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grid1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command2" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BackColor = 216,216,216
		BorderStyle = 0
		Caption = "Llenado de Cursor"
		DataSession = 2
		DoCreate = .T.
		Height = 342
		Icon = imagen\litening.ico
		MaxButton = .F.
		Name = "cargacur"
		ShowWindow = 1
		Width = 752
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		Caption = "\<Terminar", ;
		Height = 25, ;
		Left = 271, ;
		Name = "Command1", ;
		TabIndex = 5, ;
		Top = 292, ;
		Width = 95
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command2' AS commandbutton WITH ;
		Cancel = .T., ;
		Caption = "\<Salir", ;
		Height = 25, ;
		Left = 415, ;
		Name = "Command2", ;
		TabIndex = 6, ;
		Top = 292, ;
		Width = 96
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grid1' AS olecontrol WITH ;
		Height = 244, ;
		Left = 82, ;
		Name = "grid1", ;
		TabIndex = 4, ;
		Top = 26, ;
		Width = 590
		*< END OBJECT: BaseClass="olecontrol" OLEObject="c:\windows\system32\msflxgrd.ocx" Value="" />
	
	PROCEDURE Activate
		set exact on
		if codigo=0
			muestro=0
		endif
		if muestro=1
			with thisform
				sele articulos
				set order to art_codi
				seek codigo
				set point to
				localiz=1
				if insertar=0
					nitem=nitem+1
					cadena=repl("0",8-len(allt(str(art_codi))))+allt(str(art_codi))
					.grid1.additem(alltrim(str(nitem))+chr(9)+trim(cant)+chr(9)+art_med+chr(9)+cadena+chr(9)+allt(descri))
					on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
				endif
			endwith
		endif
		store 0 to muestro
		
	ENDPROC

	PROCEDURE Init
		set dele on
		set date british
		set century on
		public elimi,descrip,muestro,opcion,nrofac,nrorem,codirem, ;
			   dato1,dato2,dato3,codigo,cant,descri,descrip,insertar, ;
			   borra,codiva,transporte,coditran,auxcond, ;
			   texto,rta,articulo,lugent,observ,comprobante,localiz,nitem, ;
			   buscar,paso
		paso=0	   
		codigo=0
		localiz=0
		opcion=0
		descri=""
		descrip=""
		insertar=0
		nitem=0
		elimi=0
		
		on key label INS do form cualartremi with opcion,dato1,dato2,dato3,codigo,cant,descri
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.Click
		if nitem=0
			messagebox("Aún no ha ingresado ningún Item al Remito. Imposible Terminar",0+48,"Advertencia")
		else	
			preg=messagebox("¿Confirma los datos del Remito?",4+32+256,"Alta de Remitos")
		endif
		if preg=6
			with thisform
				sele currem
				go top
				for fila=1 to .grid1.rows-1
					.grid1.row=fila
					appe blank
					.grid1.col=3
					repla art_codi with val(.grid1.text)
			 		.grid1.col=1
					repla art_cant with val(.grid1.text)
					.grid1.col=2
					repla art_med with allt(.grid1.text)
					.grid1.col=4
					repla art_desc with allt(.grid1.text)
				next fila
			endwith
			sele currem
			go top
			for n=1 to 3
				do case
					case n=1
						comprobante="ORIGINAL"
					case n=2
						comprobante="DUPLICADO"
					case n=3
						comprobante="TRIPLICADO"
				endcase
				set point to ","
				report form remitonn to printer noconsole
				set point to
			next n
			thisform.release
		endif
		
	ENDPROC

	PROCEDURE Command2.Click
		preg=messagebox("¿Seguro que desea salir?",4+32+256,"Verifique")
		if preg=6
			thisform.release
		endif
	ENDPROC

ENDDEFINE


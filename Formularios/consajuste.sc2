	ADD OBJECT 'txt_fecha' AS textbox WITH ;
		Alignment = 2, ;
		Height = 23, ;
		Left = 473, ;
		Name = "txt_fecha", ;
		Style = 1, ;
		Top = 4, ;
		Width = 87
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETERS xaju
		
		IF xaju>0
			LOCAL xcadetip
			frmconaj= conectar_db(_screen.cn)
				SQLEXEC(frmconaj,"select * from ajustes where aju_codi = ?xaju;","cur_aju")
				SQLEXEC(frmconaj,"select a.art_codi,b.art_desc,a.artaju_cant from ajustes_articulos a inner join articulos b on a.art_codi=b.art_codi where a.aju_codi = ?xaju;","cur_araju")
			desconectar_db(frmconaj)
			IF RECCOUNT("cur_aju")>0
				thisform.txt_fecha.Value=cur_aju.aju_fech
				xcadetip=ICASE(ALLTRIM(cur_aju.aju_conc)='E','ENTRADA DE STOCK',ALLTRIM(cur_aju.aju_conc)='S','SALIDA DE STOCK')
				thisform.lbl_tipo.Caption="Tipo de Ajuste: "+xcadetip
				thisform.edit1.Value=ALLTRIM(cur_aju.aju_observ)
				IF RECCOUNT("cur_araju")>0
					SELECT cur_araju
					LOCATE
					thisform.grd_deta.RecordSource="cur_araju"
					thisform.grd_deta.column3.ControlSource="(IIF(ALLTRIM(cur_aju.aju_conc)='E',artaju_cant,-artaju_cant))"
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Edit1.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

ENDDEFINE


	PROCEDURE Activate
		*!*	SELECT cur_itemsped
		*!*	LOCATE
		
		SELECT cur_itemscre
		LOCATE
		
		thisform.grd_itcred.RecordSource=''
		thisform.grd_itcred.Refresh
		thisform.grd_itcred.RecordSource="cur_itemscre"
		thisform.grd_itcred.SetAll("DynamicBackColor","Thisform.Colorfila(cur_itemscre.selart)","Column")
		thisform.grd_itcred.SetAll("DynamicForeColor","Thisform.Colorletra(cur_itemscre.selart)","Column")
		thisform.grd_itcred.COLUMN1.DynamicBackColor='RGB(144,238,144)'
		thisform.grd_itcred.column5.ControlSource="(art_desc)"
		
		
		*!*	do case
		*!*		case rta=1
		*!*			do form altafactura with codp,cond,codicli
		*!*		case rta=2
		*!*			thisform.release
		*!*	endcase
		*!*	if x>0 and x=con and y=0
		*!*		thisform.release
		*!*	endif
	ENDPROC

	PROCEDURE colorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = .T.
					lnColor = RGB(0,120,215)
				CASE tnsel = .F.
					lnColor = RGB(255,255,255)
			ENDCASE
		Return(lnColor)
		
		
	ENDPROC

	PROCEDURE colorletra
		LParameters tnsel
		
		Local ltColor
		
			DO case
				CASE tnsel = .T.
					ltColor = RGB(255,255,255)
				CASE tnsel = .F.
					ltColor = RGB(0,0,0)
			ENDCASE
		Return(ltColor)
	ENDPROC

	PROCEDURE Init
		parameter codf,cond,codicli
		
		*!*	public rta,x,con,y,localiz,elimi
		
		thisform.valorcadena= valorcadena
		CREATE CURSOR cur_itemscre(selart L,artfac_cant N(10,3),art_med C(3),art_codi N(8),art_desc M,artfac_impo N(15,3),dac_codi N(8),art_alicuota N(1),artped_codi N(8),artfac_sstock C(1))
		localiz=0
		elimi=0
		rta=0
		item=1
		
		SET DECIMALS TO 3
		frmitfac= conectar_db(_screen.cn)
			SQLEXEC(frmitfac,"select a.fac_pto,a.fac_nro,b.cli_nomb,a.ped_codi from facturas a inner join clientes b on a.cli_codi=b.cli_codi where a.fac_codi = ?codf;","cur_nf")
			SQLEXEC(frmitfac,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dac_desc,a.artped_codi from facturas_articulos a INNER JOIN articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.fac_codi=?codf;","cur_carfac")
		desconectar_db(frmitfac)
		SET DECIMALS TO
		codp=cur_nf.ped_codi
		xcaden=REPLICATE("0",4-LEN(ALLTRIM(STR(cur_nf.fac_pto))))+ALLTRIM(STR(cur_nf.fac_pto))+"-"+ ;
			   REPLICATE("0",8-LEN(ALLTRIM(STR(cur_nf.fac_nro))))+ALLTRIM(STR(cur_nf.fac_nro))
		this.caption="Nota de Crédito sobre Factura Nº "+allt(xcaden)+" de "+ALLTRIM(cur_nf.cli_nomb)
		cerrar_cursor("cur_nf")
		SELECT cur_carfac
		GO top
		
		SELECT .F. as selart,artfac_cant,art_med,art_codi, ;
			   IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artfac_dasc) as art_desc, ;
			   artfac_impo,dac_codi,art_alicuota,artped_codi,artfac_sstock FROM cur_carfac INTO CURSOR cur_itemscre readwrite
		
		cerrar_cursor("cur_carfac")
		
		SELECT cur_itemscre
		LOCATE
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL xcodsel
		
		SELECT cur_itemscre
		GO top
		
		estadoasoc=.T.
		
		thisform.release
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command1.OLEDrag
		LPARAMETERS lDetectDrag
		this.command1.enabled=.T.
	ENDPROC

	PROCEDURE Command2.Click
		DO case
			CASE thisform.estadosel=0
				UPDATE cur_itemscre SET selart=.T.
				this.Caption="\<Deseleccionar Todos"
				thisform.command1.enabled=.T.
				thisform.estadosel=1
			CASE thisform.estadosel=1
				UPDATE cur_itemscre SET selart=.F.
				this.Caption="\<Seleccionar Todos"
				thisform.command1.enabled=.F.
				thisform.estadosel=0
		ENDCASE
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		codp=0
		estadoasoc=.T.
		

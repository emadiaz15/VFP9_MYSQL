		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.OLEDrag
		LPARAMETERS lDetectDrag
		this.command1.enabled=.T.
	ENDPROC

	PROCEDURE grd_itcred.Column1.Check1.Click
		LOCAL cantsel,ubireg
		cantsel=0
		ubireg=0
		
		SELECT cur_itemscre
		ubireg=RECNO()
		LOCATE
		COUNT ALL FOR selart=.T. TO cantsel
		GO ubireg
		
		IF cantsel>0
			thisform.command2.Caption="\<Deseleccionar Todos"
			thisform.command1.enabled=.T.
			thisform.estadosel=1
		ELSE
			thisform.command2.Caption="\<Seleccionar Todos"
			thisform.command1.enabled=.F.
			thisform.estadosel=0
		ENDIF
	ENDPROC

ENDDEFINE

	PROCEDURE Init
		*!*	public i,zona
		*!*	*this.list2.rowsourcetype=3
		*!*	*this.list2.rowsource="SELECT cp_nro,loca_nomb FROM codipostales a,localidades b WHERE EXISTS (SELECT * FROM clientes c WHERE b.loca_codi = c.loca_codi) and b.cp_codi=a.cp_codi order by cp_nro INTO CURSOR list2"
		
		*!*	frmconfzon= conectar_db(_screen.cn)
		*!*		SQLEXEC(frmconfzon,"select zona_desc,zona_codi from zonas;","cur_zon")
		*!*		GO top
		*!*		thisform.list1.RowSource="cur_zon"
		*!*		SQLEXEC(frmconfzon,"select b.cp_nro,a.loca_nomb,a.loca_codi,a.zona_codi from localidades a inner join codipostales b on a.cp_codi=b.cp_codi where a.zona_codi=0 order by a.loca_nomb;","cur_disp")
		*!*	desconectar_db(frmconfzon)
		
		*!*	IF RECCOUNT("cur_disp")>0
		*!*		GO top
		*!*		thisform.list2.RowSource="cur_disp"
		*!*	*!*		i=1
		*!*	*!*		scan
		*!*	*!*			if clientes.loca_codi=loca_codi and zona_codi=0
		*!*	*!*				this.list2.addlistitem(allt(str(codipostales.cp_nro)),i,1)
		*!*	*!*				this.list2.addlistitem(loca_nomb,i,2)
		*!*	*!*				i=i+1
		*!*	*!*			endif
		*!*	*!*		ENDSCAN
		*!*	ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		MESSAGEBOX("ESTA RUTINA SE ENCUENTA MOMENTÁNEAMENTE EN PROCESO DE DISEÑO Y MANTENIMIENTO."+CHR(13)+CHR(13)+;
				   "ESTARÁ DISPONIBLE EN PRÓXIMAS ACTUALIZACIONES.",64,"Aviso del Sistema")
		RETURN TO master
		
		
		
	ENDPROC

	PROCEDURE Command1.Click
		for x=1 to thisform.list3.listcount
			if thisform.list3.selected(x)
				thisform.list3.selected(x)=.F.
			endif
		next x
		fila=thisform.list3.listcount+1
		for i=1 to thisform.list2.listcount
			if thisform.list2.selected(i)
				thisform.list2.boundcolumn=1
				thisform.list3.addlistitem(thisform.list2.value,fila,1)
				thisform.list2.boundcolumn=2
				sele codipostales
				set order to cp_nro
				seek val(thisform.list2.list(i,1))
				codigopostal=cp_codi
				sele localidades
				set order to locacp
				seek allt(thisform.list2.list(i,2))+str(codigopostal)
				if found()
					repla zona_codi with zona
				endif
				set order to
				thisform.list3.addlistitem(thisform.list2.value,fila,2)
				thisform.list2.removeitem(i)
			endif
		next i
	ENDPROC

	PROCEDURE Command2.Click
		for x=1 to thisform.list2.listcount
			if thisform.list2.selected(x)
				thisform.list2.selected(x)=.F.
			endif
		next x
		fila=thisform.list2.listcount+1
		for i=1 to thisform.list3.listcount
			if thisform.list3.selected(i)
				thisform.list3.boundcolumn=1
				thisform.list2.addlistitem(thisform.list3.value,fila,1)
				thisform.list3.boundcolumn=2
				sele codipostales
				set order to cp_nro
				seek val(thisform.list3.list(i,1))
				codigopostal=cp_codi
				sele localidades
				set order to locacp
				seek allt(thisform.list3.list(i,2))+str(codigopostal)
				if found()
					repla zona_codi with 0
				endif
				set order to
				thisform.list2.addlistitem(thisform.list3.value,fila,2)
				thisform.list3.removeitem(i)
			endif
		next i
		
	ENDPROC

	PROCEDURE Command3.Click
		LOCAL cadezon
		cadezon=0
		frmconfzon= conectar_db(_screen.cn)
			SQLEXEC(frmconfzon,"select CAST(MAX(zona_codi)+1 AS DECIMAL(8,0)) as zona_codi from zonas order by zona_codi;","cur_nz")
			zona=cur_nz.zona_codi
			cadezon="ZONA "+allt(str(zona))
			SQLEXEC(frmconfzon,"insert into zonas values(?zona,?cadezon,0);")
		
			with thisform
				SQLEXEC(frmconfzon,"select zona_desc,zona_codi from zonas;","cur_zon")
				GO top
				.list1.rowsource="cur_zon"
				.list1.requery
				.list1.refresh()
				.list1.selected(zona)=.T.
				.label2.visible=.T.
				.label2.caption=""
				.label2.caption="Localidades de la "+allt(.list1.value)
				.shape2.visible=.T.
				.list3.visible=.T.
				.list3.clear
				.list2.enabled=.T.
			ENDWITH
		desconectar_db(frmconfzon)
		
		
		
	ENDPROC

	PROCEDURE Command4.Click
		thisform.release
	ENDPROC

	PROCEDURE List1.Click
		with thisform
			.label2.visible=.T.
			.label2.caption="Localidades de la "+allt(this.value)
			.shape2.visible=.T.
			.list3.visible=.T.
			.list3.clear
			.list2.enabled=.T.
			.command1.enabled=.T.
			.command2.enabled=.T.
		*!*		for x=1 to thisform.list3.listcount
		*!*			if thisform.list3.selected(x)
		*!*				thisform.list3.selected(x)=.F.
		*!*			endif
		*!*		next x
		*!*		for x=1 to thisform.list2.listcount
		*!*			if thisform.list2.selected(x)
		*!*				thisform.list2.selected(x)=.F.
		*!*			endif
		*!*		next x
			frmconfzon= conectar_db(_screen.cn)
				SQLEXEC(frmconfzon,"select b.cp_nro,a.loca_nomb,a.loca_codi,a.zona_codi from localidades a inner join codipostales b on a.cp_codi=b.cp_codi where a.zona_codi=?cur_zon.zona_codi order by a.loca_nomb;","cur_loczon")
			desconectar_db(frmconfzon)
			if RECCOUNT("cur_loczon")>0
				GO top
				.list3.rowsource="cur_loczon"
			else
				zona=cur_zon.zona_codi
			endif
		endwith
		
	ENDPROC

	PROCEDURE List2.DblClick
		thisform.command1.click()
	ENDPROC

	PROCEDURE List3.DblClick
		thisform.command2.click()
	ENDPROC


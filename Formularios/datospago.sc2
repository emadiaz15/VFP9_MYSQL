	PROCEDURE Destroy
		if coditipag=2
			set currency to
		endif
	ENDPROC

	PROCEDURE Init
		parameter coditipag,numero,banco,plaza,fechavto,valor,totval,impotot,cuit
		public codiban,valorcheq,nitem
		nitem=0
		with thisform
			.text6.value=0
			if paso=1
				MESSAGEBOX("Entre por aca",64,"Aviso del Sistema")
				frmdatpag= conectar_db(_screen.cn)
					SQLEXEC(frmdatpag,"select * from tipospago where tippag_codi=?coditipag;","cur_tipp")
				desconectar_db(frmdatpag)
				.text1.value=cur_tipp.tippag_desc
				.text2.value=numero
				.text3.value=banco
				.text4.value=plaza
				.text5.value=fechavto
				.text7.value=cuit
				
		*!*		else
		*!*			coditipag=0
		*!*			.text5.value=ctod("  /  /    ")
		*!*			.text6.value=0
		*!*			do form tipagselec with coditipag
		*!*			if coditipag=0 and last()<>27
		*!*				thisform.command3.click()
		*!*			endif
			endif
			.text18.value=impotot
			.text19.value=totval
			.text20.value=.text18.value-.text19.value
			.text6.value=.text18.value-.text19.value
			IF .text20.value<=0
				.command4.enabled= .T.				
			ENDIF
		
			frmdatpag= conectar_db(_screen.cn)
				SQLEXEC(frmdatpag,"select ban_desc,ban_codi from bancos order by ban_desc;","cur_bce")
			desconectar_db(frmdatpag)
			IF RECCOUNT("cur_bce")>0
				LOCATE
				thisform.lstincremental1.pcursor="cur_bce"
				thisform.lstincremental1.pcampo="ban_desc"
				thisform.lstincremental1.pcampo2="ban_codi"
			ENDIF
		
		*!*		if coditipag=2
		*!*			set currency to "u$s"
		*!*		endif
		*!*		if coditipag>0
		*!*			sele tipospago
		*!*			set order to tippag_cod
		*!*			seek coditipag
		*!*			.text1.value=tippag_desc
		*!*			.text6.value=impotot-totval
		*!*			if coditipag<>3 and coditipag<>9 and coditipag<>11
		*!*				.text3.enabled=.F.
		*!*				.text4.enabled=.F.
		*!*				.text5.enabled=.F.
		*!*			endif
		*!*			if coditipag<>3
		*!*				.text7.enabled=.F.
		*!*				if prompt()="Pagos a Proveedores" and paso=0
		*!*					if coditipag=13 and matfac>0
		*!*						do form selecfac with matcli,impotot,totval,matcom
		*!*					endif
		*!*				endif
		*!*			else
		*!*				if prompt()="Pagos a Proveedores" or prompt()="Registro de Gastos" and paso=0
		*!*					p=messagebox("¿Abona con cheque de caja?",4+32+256,"Cheques")
		*!*					if p=6
		*!*						valorcheq=impotot-totval
		*!*						do form chequesdisp with numero,banco,plaza,fechavto,valor,cuit,valorcheq
		*!*						if len(allt(numero))>0
		*!*							.text2.value=numero
		*!*							.text3.value=banco
		*!*							.text4.value=plaza
		*!*							.text5.value=fechavto
		*!*							.text6.value=valor
		*!*							if totval+valor>impotot
		*!*								preg=messagebox("Excede el importe. ¿Le dió vuelto al Cliente?",4+48+256,"Advertencia")
		*!*								if preg=7
		*!*									valor=impotot-totval
		*!*									return 0	
		*!*								else
		*!*									impotot=impotot-valor
		*!*								endif
		*!*							endif
		*!*							.text7.value=cuit
		*!*							.command1.setfocus
		*!*						else
		*!*							.text7.value=cuit
		*!*						endif
		*!*					else
		*!*						sele parametros
		*!*						set order to param_desc
		*!*						seek "CUIT"
		*!*						cuit=param_impo
		*!*						.text7.value=cuit
		*!*					endif
		*!*				else
		*!*					.text7.value=cuit
		*!*				endif			
		*!*			endif
		*!*		else
		*!*			this.release
		*!*		endif
		endwith
	ENDPROC

	PROCEDURE limpiartextos
		
		thisform.text1.Value=''
		thisform.text2.Value=''
		thisform.text3.Value=''
		thisform.clstextinput1.txtInput.Value=''
		thisform.text4.Value=''
		thisform.text7.Value=''
		thisform.text5.Value=ctod("  /  /    ")
		thisform.check1.Value=0
		
		RETURN
		
	ENDPROC

	PROCEDURE Unload
		return coditipag
		return numero
		return banco
		return plaza
		return fechavto
		return valor
		return totval
		return cuit
	ENDPROC

	PROCEDURE Check1.Click
		thisform.command1.setfocus
	ENDPROC

	PROCEDURE Clstextinput1.txtInput.InteractiveChange
		n = LEN(ALLTRIM(this.Value))
		IF n >= this.Parent.penterchar
			thisform.lstincremental1.pinput = ALLTRIM(this.Value)
			thisform.lstincremental1.listcursor()
			thisform.lstincremental1.Visible= .T.
			IF USED("crlistincremental")
				IF RECCOUNT("crlistincremental")=0
					thisform.lstincremental1.Visible= .F.
				ENDIF
			ENDIF	
		ELSE
			thisform.lstincremental1.Visible   = .F.
			thisform.lstincremental1.RowSource = ""
			IF USED("crlistincremental")
				USE IN crlistincremental
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmd_newbank.Click
		IF thisform.codiban=0
			thisform.clstextinput1.txtInput.Value=''
			thisform.lstincremental1.RowSource=""
			thisform.lstincremental1.Visible= .F.
		ENDIF
		
		codiban=0
		codisuc=0
		do form altabanco with codiban,codisuc,2
		
		IF codiban > 0
			frmdatpag= conectar_db(_screen.cn)
				SQLEXEC(frmdatpag,"select * from bancos where ban_codi = ?codiban;","cur_nvoban")
			desconectar_db(frmdatpag)
			IF RECCOUNT("cur_nvoban")>0
				thisform.clstextinput1.txtInput.Value=cur_nvoban.ban_desc
				thisform.codiban=cur_nvoban.ban_codi
				thisform.text7.SetFocus
			ELSE
				thisform.clstextinput1.txtInput.Value=''
				thisform.clstextinput1.txtInput.SetFocus
			ENDIF
		ELSE
			thisform.clstextinput1.txtInput.Value=''
			thisform.clstextinput1.txtInput.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			if .text6.value>0
				numero=allt(.text2.value)
				banco=IIF(thisform.codiban>0,ALLTRIM(thisform.clstextinput1.txtInput.value),allt(.text3.value))
				plaza=.text4.value
				fechavto=.text5.value
				valor=.text6.value
				if coditipag=3 OR coditipag=20
					cuit=.text7.value
				else
					cuit=0
				endif
				totval=totval+valor
				nalo=iif(.check1.value=1,.T.,.F.)
				idcheq=IIF(coditipag=20,ALLTRIM(STR(thisform.codiban)),thisform.ncheqid)
				this.Enabled= .F.
				thisform.release
			endif
		endwith
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		coditipag=0
		do form tipagselec with coditipag
		if coditipag>0
			WITH thisform
		*!*			STORE 0  TO .text7.value,.text2.value
				STORE '' TO .text7.value,.text2.value,.text1.value,.text3.value,.text4.value,.text5.value 
				frmdatpag= conectar_db(_screen.cn)
					SQLEXEC(frmdatpag,"select * from tipospago where tippag_codi=?coditipag;","cur_tpp")
				desconectar_db(frmdatpag)
				if coditipag=1
					.text1.value=cur_tpp.tippag_desc
					thisform.text6.setfocus
				else
					thisform.text1.value=cur_tpp.tippag_desc
					if coditipag=2
						set currency to "u$s"
					else
						set currency to "$"
					ENDIF
					.text1.value=cur_tpp.tippag_desc
					if coditipag<>3 and coditipag<>9 and coditipag<>11
						with thisform
							.text3.enabled=.F.
							.text4.enabled=.F.
							.text5.enabled=.F.
						endwith
					else
						with thisform
							.text3.enabled=.T.
							.text4.enabled=.T.
							.text5.enabled=.T.
						endwith
					endif
					if coditipag=3
						thisform.check1.enabled=.T.
						thisform.text7.enabled=.T.
						thisform.text7.value=cuit
					ELSE
						thisform.check1.enabled=.F.
						thisform.text7.enabled=.F.
					endif
					thisform.text2.setfocus
				ENDIF
			ENDWITH
		else
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command3.Click
		do case
			case prompt()="Pagos de Clientes"
				with pagocliente
					do form itemmodifpag with nitem
					do while nitem>.olecontrol1.rows-1
						messagebox("El número de item ingresado no existe.",0+48,"Advertencia")
						do form itemmodifpag with nitem
					enddo
					.olecontrol1.row=nitem
					.olecontrol1.col=0
					thisform.text1.value=allt(.olecontrol1.text)
					.olecontrol1.col=1
					thisform.text2.value=allt(.olecontrol1.text)
					.olecontrol1.col=2
					thisform.text7.value=val(subst(allt(.olecontrol1.text),1,2)+subst(allt(.olecontrol1.text),4,8)+right(allt(.olecontrol1.text),1))
					.olecontrol1.col=3
					thisform.text3.value=allt(.olecontrol1.text)
					.olecontrol1.col=4
					thisform.text4.value=allt(.olecontrol1.text)
					.olecontrol1.col=5
					thisform.text5.value=ctod(.olecontrol1.text)
					.olecontrol1.col=6
					thisform.text6.value=ConverNro(.olecontrol1.text)
					totval=totval-thisform.text6.value
					thisform.text2.setfocus
					paso=1
				endwith			
			case prompt()="Pagos a Proveedores"
		endcase
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command4.Click
		preg=messagebox("¿Confirma los medios de pago ingresados?",4+48+256,"Pagos de Clientes")
		
		if preg=6
			confirma="S"
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command4.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command4.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command5.Click
		with thisform
			coditipag=0
			thisform.limpiartextos()
			thisform.codiban=0
			do form tipagselec with coditipag
			if coditipag>0
				thisform.command1.Enabled= .T.
				if coditipag=1
					thisform.ncheqid=''
					thisform.check1.enabled=.F.
					.text1.value=cur_tipp.tippag_desc
					.text6.setfocus
				else
					if coditipag=2
						set currency to "u$s"
					endif
					.text1.value=cur_tipp.tippag_desc
					.text6.value=impotot-totval
					if coditipag<>3 and coditipag<>9 and coditipag<>11
						IF coditipag = 20
							.text3.visible=.F.
							.text4.enabled=.F.
							thisform.clstextinput1.Visible= .T.
							thisform.cmd_newbank.Visible= .T.
							thisform.clstextinput1.ZOrder(0)
							thisform.lstincremental1.ZOrder(0)
							thisform.ncheqid=''
							thisform.text2.SetFocus
						ELSE
							thisform.clstextinput1.ZOrder(1)
							thisform.lstincremental1.ZOrder(1)
							thisform.clstextinput1.Visible= .F.
							thisform.cmd_newbank.Visible= .F.
							thisform.lstincremental1.Visible= .F.
							.text3.visible=.T.
							.text3.enabled=.F.
							.text4.enabled=.F.
							.text5.enabled=.F.
							thisform.text2.SetFocus
						ENDIF
					endif
					if coditipag<>3 AND coditipag<>20
						thisform.ncheqid=''
						.text7.enabled=.F.
						thisform.check1.enabled=.F.
					ELSE
						IF coditipag=20
							thisform.check1.visible=.F.
							.text2.Inputmask=""
							.text2.format=""
							.text7.value=cuit
						ENDIF
						IF coditipag=3
							thisform.check1.enabled=.T.
							.text2.Inputmask="999-999-99999999"
							.text2.format="R"
							.text7.value=cuit
							.text3.enabled=.T.
							.text4.enabled=.T.
							.text5.enabled=.T.
							.text7.enabled=.T.
							.text2.setfocus
						ENDIF
					endif
				endif
			else
				thisform.release
			endif
		endwith
	ENDPROC

	PROCEDURE Command6.Click
		confirma="S"
		cancelado="S"
		thisform.release
	ENDPROC

	PROCEDURE Command6.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC


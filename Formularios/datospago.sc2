		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Lstincremental1.Click
		IF this.ListCount>0
			IF USED("crlistincremental")
				SELECT crlistincremental
				thisform.clstextinput1.txtInput.Value=crlistincremental.ban_desc
				thisform.codiban = crlistincremental.ban_codi
				this.Visible = .F.
				thisform.text7.SetFocus
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.LostFocus
		LOCAL xcheque,xconf,registra
		STORE 'N' TO xconf,registra
		if last()<>13
		*!*		this.setfocus
			nodefault
		ELSE
			if coditipag=3
				local texban,texsuc
				if len(allt(this.value))>0
					if len(allt(this.value))<14
						messagebox("Número de cheque incorrecto. Verifique bien por favor.",0+48,"Advertencia")
						nodefault
						this.setfocus
					else
						frmdatpag= conectar_db(_screen.cn)
							SQLEXEC(frmdatpag,"select * from recibos_pagos where chequenro=?ALLTRIM(this.value);","cur_ch")
						desconectar_db(frmdatpag)
						if RECCOUNT("cur_ch")>0
							xcheque=ALLTRIM(this.value)
							DO FORM habiacheq WITH xcheque,xconf TO xvar1
							IF xvar1.prop2='S'
								thisform.ncheqid=RIGHT('0000'+ALLTRIM(STR((RECCOUNT("cur_ch"))+1)),4)
								registra='S'
							ELSE
								this.Value=''
								NODEFAULT
							ENDIF
						ELSE
							thisform.ncheqid='0001'
							registra='S'
						ENDIF
						
						IF registra='S'
							LOCAL cadesuc
							cadesuc=allt(subst(this.value,1,3))+allt(subst(this.value,4,3))
							frmdatpag= conectar_db(_screen.cn)
								SQLEXEC(frmdatpag,"select a.*,b.ban_desc from sucbancos a inner join bancos b on a.ban_codi=b.ban_codi where suc_bansuc=?cadesuc;","cur_suc")
							desconectar_db(frmdatpag)
							if RECCOUNT("cur_suc")>0
								thisform.text3.value=cur_suc.ban_desc
								thisform.text4.value=cur_suc.suc_nomb
							ELSE
								LOCAL codb
								codb=0
								codb=val(subst(allt(this.value),1,3))
								frmdatpag= conectar_db(_screen.cn)
									SQLEXEC(frmdatpag,"select * from bancos where ban_codi=?codb;","cur_ban")
								desconectar_db(frmdatpag)
								if RECCOUNT("cur_ban")>0
									pregunta=messagebox("Sucursal Nº: "+subst(allt(this.value),4,3)+" de "+allt(cur_ban.ban_desc)+" no está en archivo. ¿Ingresa nueva Sucursal?",4+32+256,"Cobranzas")
									if pregunta=6
										LOCAL cadbansuc
										codiban=cur_ban.ban_codi
										codisuc=0
										do form altasuc with codiban,codisuc
										thisform.text3.value=cur_ban.ban_desc
										cadbansuc=allt(str(codiban))+allt(str(codisuc))
										frmdatpag= conectar_db(_screen.cn)
											SQLEXEC(frmdatpag,"select * from sucbancos where CONCAT(TRIM(CAST(ban_codi as char)),TRIM(CAST(suc_codi as char)))=?cadbansuc;","cur_suc")
										desconectar_db(frmdatpag)
										thisform.text4.value=allt(cur_suc.suc_nomb)
									else
										this.value=""
										nodefault
										this.setfocus
									endif
								else
									pregunta=messagebox("Banco Nº: "+subst(allt(this.value),1,3)+" no está en archivo. ¿Ingresa nuevo Banco?",4+32+256,"Cobranzas")
									if pregunta=6
										codiban=0
										codisuc=0
										do form altabanco with codiban,codisuc,1
										if codiban>0
											frmdatpag= conectar_db(_screen.cn)
												SQLEXEC(frmdatpag,"select * from bancos where ban_codi=?codiban;","cur_ban")
											desconectar_db(frmdatpag)
											if RECCOUNT("cur_ban")>0
												LOCAL cadbansuc
												cadbansuc=allt(str(codiban))+allt(str(codisuc))
												frmdatpag= conectar_db(_screen.cn)
													SQLEXEC(frmdatpag,"select a.*,b.ban_desc from sucbancos a inner join bancos b on a.ban_codi=b.ban_codi where CONCAT(TRIM(CAST(a.ban_codi as char)),TRIM(CAST(a.suc_codi as char)))=?cadbansuc;","cur_suc")
												desconectar_db(frmdatpag)
												if RECCOUNT("cur_suc")>0
													thisform.text3.value=cur_suc.ban_desc
													thisform.text4.value=allt(cur_suc.suc_nomb)
												else
													pregunta=messagebox("Aún no ha ingresado ninguna sucursal para "+allt(cur_ban.ban_desc)+". ¿Ingresa nueva Sucursal?",4+32+256,"Cobranzas")
													if pregunta=6
														do form altasuc with codiban,codisuc
														thisform.text3.value=cur_ban.ban_desc
														cadbansuc=allt(str(codiban))+allt(str(codisuc))
														frmdatpag= conectar_db(_screen.cn)
															SQLEXEC(frmdatpag,"select a.*,b.ban_desc from sucbancos a inner join bancos b on a.ban_codi=b.ban_codi where CONCAT(TRIM(CAST(ban_codi as char)),TRIM(CAST(suc_codi as char)))=?cadbansuc;","cur_suc")
														desconectar_db(frmdatpag)														
														thisform.text4.value=allt(cur_suc.suc_nomb)
													else
														this.value=""
														nodefault
														this.setfocus
													endif
												endif
											endif
										else
											this.value=""
											nodefault
											this.setfocus
										endif
									else
										this.value=""
										nodefault
										this.setfocus
									endif				
								endif	
							endif
						endif
					endif
				ENDIF
			ELSE
				IF coditipag=20
					thisform.clstextinput1.txtInput.SetFocus
				ENDIF
			endif
		endif
	ENDPROC

	PROCEDURE Text3.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text3.GotFocus
		*!*	codiban=0
		*!*	do form bancoload with codiban
		*!*	if codiban>0
		*!*		sele bancos
		*!*		set order to ban_codi
		*!*		seek codiban
		*!*		this.value=ban_desc
		*!*		thisform.text4.setfocus
		*!*	endif
	ENDPROC


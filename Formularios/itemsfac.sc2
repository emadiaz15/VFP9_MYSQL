	PROCEDURE Activate
		*!*	SELECT cur_itemsped
		*!*	LOCATE
		
		SELECT cur_itemsped
		LOCATE
		
		thisform.grd_itpres.RecordSource=''
		thisform.grd_itpres.Refresh
		thisform.grd_itpres.RecordSource="cur_itemsped"
		thisform.grd_itpres.SetAll("DynamicBackColor","Thisform.Colorfila(cur_itemsped.selart)","Column")
		thisform.grd_itpres.SetAll("DynamicForeColor","Thisform.Colorletra(cur_itemsped.selart,cur_itemsped.art_med)","Column")
		thisform.grd_itpres.COLUMN7.DynamicBackColor='RGB(144,238,144)'
		
		
		*!*	do case
		*!*		case rta=1
		*!*			do form altafactura with codp,cond,codicli
		*!*		case rta=2
		*!*			thisform.release
		*!*	endcase
		*!*	if x>0 and x=con and y=0
		*!*		thisform.release
		*!*	endif
	ENDPROC

	PROCEDURE colorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = .T.
					lnColor = RGB(0,120,215)
				CASE tnsel = .F.
					lnColor = RGB(255,255,255)
			ENDCASE
		Return(lnColor)
		
		
	ENDPROC

	PROCEDURE colorletra
		LParameters tnsel,tnalt
		
		Local ltColor
		
			DO case
				CASE tnsel = .T. AND tnalt <> 'ALT'
					ltColor = RGB(255,255,255)
				CASE tnsel = .T. AND tnalt = 'ALT'
					ltColor = RGB(0,255,0)
				CASE tnsel = .F. AND tnalt <> 'ALT'
					ltColor = RGB(0,0,0)
				CASE tnsel = .F. AND tnalt = 'ALT'
					ltColor = RGB(255,0,0)
			ENDCASE
		Return(ltColor)
	ENDPROC

	PROCEDURE facped
		LPARAMETERS xcodp
		
		SET DECIMALS TO 3
		frmitfac= conectar_db(_screen.cn)
			SQLEXEC(frmitfac,"select a.*,b.art_desc,b.art_med,b.art_alicuota,c.dac_desc,a.artped_codi from pedidos_articulos a INNER JOIN articulos b on a.art_codi=b.art_codi LEFT JOIN desc_articulos_clientes c on c.dac_codi=a.dac_codi where a.ped_codi=?xcodp ORDER BY a.artped_it;","cur_carped")
		desconectar_db(frmitfac)
		SET DECIMALS TO
		this.caption="Facturación del pedido  Nº "+allt(STR(xcodp))+" de "+ALLTRIM(cur_clie.cli_nomb)
		GO top
		con=RECCOUNT("cur_carped")
		COUNT FOR cur_carped.artped_ent>0 TO x
		COUNT FOR cur_carped.artped_ent>0 AND cur_carped.artped_ent<cur_carped.artped_cant TO y
		
		do while ped_codi=xcodp and !eof()
			con=con+1
			if artped_ent>0
				x=x+1
				if artped_ent<artped_cant
					y=y+1
				endif
			endif
			skip
		enddo
		do case
			case x>0 and x=con and y>0
				messagebox("Este pedido ya fue facturado pero aún quedan items"+chr(13)+ ;
						   "con cantidades pendientes. Seleccione los items pendientes.",0+64,"Información importante")
			case x>0 and x=con and y=0
				messagebox("Este pedido ya fue facturado en su totalidad.",0+64,"Información importante")
				this.release
				do form pediload with codicli
			case x>0 and x<con
				messagebox("Este pedido ya fue facturado pero aún "+chr(13)+ ;
		                  "quedan items pendientes. Seleccione "+chr(13)+ ;
		                  "los items pendientes.",0+64,"Información importante")
		ENDCASE
		
		SELECT .F. as selart,00000 as nro_it,artped_cant-artped_ent as artped_cant,art_med,art_codi, ;
			   padr(left(IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artped_dasc),len(IIF(art_codi>5,iif(dac_codi>0,dac_desc,art_desc),artped_dasc))),254," ") as art_desc, ;
			   artped_precio,dac_codi,art_alicuota,artped_codi,'' as artrem_sstock FROM cur_carped WHERE artped_ent<artped_cant INTO CURSOR cur_itemsped readwrite
		
		SELECT cur_itemsped
		
		cerrar_cursor("cur_carped")
		
		RETURN
		
	ENDPROC

	PROCEDURE facrem
		LPARAMETERS xcodre
		
		cn= conectar_db(_screen.cn)
			SQLEXEC(cn,"select * from remitos where rem_codi=?xcodre;","cur_rc")
			SQLEXEC(cn,"call usp_buscarcli(?cur_rc.cli_codi);","cur_clie")
			xcade= REPLICATE("0",4-LEN(ALLTRIM(STR(cur_rc.rem_pto))))+ALLTRIM(STR(cur_rc.rem_pto))+"-"+;
				   REPLICATE("0",8-LEN(ALLTRIM(STR(cur_rc.rem_nro))))+ALLTRIM(STR(cur_rc.rem_nro))
			this.caption="Facturación del remito  Nº "+allt(xcade)+" de "+ALLTRIM(cur_clie.cli_nomb)
			cerrar_cursor("cur_rc")
			SQLEXEC(cn,"call usp_facremp(?xcodre);","cur_rem")
		desconectar_db(cn)
		
		IF RECCOUNT("cur_rem")>0
			LOCATE
			AFIELDS(aRemi, "cur_itemsped")
			CREATE CURSOR cur_auxr FROM ARRAY aRemi
			LOCAL agrega as Boolean
			LOCAL xrer,xcan,xcanf,cca
			STORE 0 TO xrer,xcan,xcanf
			SELECT cur_rem
			LOCATE
			codp=cur_rem.ped_codi
		
			SCAN
				agrega=.F.
				xcanf=0
				xrer=cur_rem.rer_codi
				xcan=cur_rem.artrem_cant
				cn= conectar_db(_screen.cn)
					SQLEXEC(cn,"select ROUND(SUM(farrer_cant),3) canre from facar_remar where rer_codi=?xrer;","cur_canre")
				desconectar_db(cn)
				IF cur_canre.canre>0
					cca=xcan-cur_canre.canre
		*!*				cn= conectar_db(_screen.cn)
		*!*					SQLEXEC(cn,"select far_codi,rer_codi,ROUND(?xcan-farrer_cant,3) canfa from facar_remar where rer_codi=?xrer and ROUND(?xcan-farrer_cant,3)>0;","cur_resul")
		*!*				desconectar_db(cn)
					&&IF cur_resul.canfa>0
					IF cca>0
						agrega=.T.
						xcanf=cca
					ELSE
						agrega=.F.
					ENDIF
				ELSE
					agrega=.T.
					xcanf=xcan
				ENDIF
				IF agrega=.T. then
					INSERT INTO cur_auxr values(.F.,0,xcanf,cur_rem.art_med,cur_rem.art_codi, ;
						   ALLTRIM(IIF(cur_rem.art_codi>5,iif(cur_rem.dac_codi>0,cur_rem.dac_desc,cur_rem.art_desc),cur_rem.artrem_dasc)), ;
			 	  		   cur_rem.artped_precio,cur_rem.dac_codi,cur_rem.art_alicuota,cur_rem.artped_codi,cur_rem.artrem_sstock)
				ENDIF
			ENDSCAN
		ENDIF
		
		SELECT cur_auxr
		LOCATE
		
		SELECT selart,nro_it,artped_cant,art_med,art_codi, ;
			   padr(left(art_desc,len(art_desc)),254," ") as art_desc, ;
			   artped_precio,dac_codi,art_alicuota,artped_codi,artrem_sstock FROM cur_auxr INTO CURSOR cur_itemsped readwrite
		
		cerrar_cursor("cur_rem")
		cerrar_cursor("cur_canre")
		cerrar_cursor("cur_resul")
		cerrar_cursor("cur_auxr")
		
		SELECT cur_itemsped
		LOCATE
		
		RETURN
	ENDPROC

	PROCEDURE Init
		parameter codp,codre,cond,codicli
		 
		public rta,x,con,y,localiz,elimi
		
		thisform.valorcadena= valorcadena
		CREATE CURSOR cur_itemsped(selart L,nro_it N(5),artped_cant N(10,3),art_med C(3),art_codi N(8),art_desc M,artped_precio N(15,4),dac_codi N(8),art_alicuota N(1),artped_codi N(8),artrem_sstock C(1))
		localiz=0
		elimi=0
		rta=0
		item=1
		x=0
		y=0
		con=0
		
		DO case
			CASE codp>0
				thisform.facped(codp)
			CASE codre>0
				thisform.xcodre=codre
				thisform.facrem(codre)
		ENDCASE
		
		SELECT cur_itemsped
		LOCATE
		
		LOCAL itp
		itp=1
		SCAN
			REPLACE nro_it WITH itp
			itp=itp+1
		ENDSCAN
		LOCATE
		
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE Command1.Click
		LOCAL xcodsel
		xcodsel=0
		SELECT cur_itemsped
		GO top
		rta=1
		SCAN FOR selart=.T.
			xcodsel=cur_itemsped.art_codi
			frmitfac= conectar_db(_screen.cn)
				SQLEXEC(frmitfac,"select * from articulos where art_codi=?xcodsel;","cur_arex")
			desconectar_db(frmitfac)
			IF thisform.valorcadena<>"Por Remito de Cliente"
				if cur_arex.art_stock-cur_itemsped.artped_cant<0 and cur_arex.art_codi>5
					do form excedestock with rta
					exit
				ENDIF
			ENDIF
			SELECT cur_itemsped
		ENDSCAN
		if rta=1
			do form altafactura with codp,cond,codicli
		endif
		thisform.hide
		
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command1.OLEDrag
		LPARAMETERS lDetectDrag
		this.command1.enabled=.T.
	ENDPROC

	PROCEDURE Command2.Click
		DO case
			CASE thisform.estadosel=0
				UPDATE cur_itemsped SET selart=.T.
				this.Caption="\<Deseleccionar Todos"
				thisform.command1.enabled=.T.
				thisform.estadosel=1
			CASE thisform.estadosel=1
				UPDATE cur_itemsped SET selart=.F.
				this.Caption="\<Seleccionar Todos"
				thisform.command1.enabled=.F.
				thisform.estadosel=0
		ENDCASE
		
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE grd_itpres.AfterRowColChange
		LPARAMETERS nColIndex
		
	ENDPROC

	PROCEDURE grd_itpres.Column5.Text1.Click
		IF cur_itemsped.art_codi<=5 OR cur_itemsped.dac_codi>0
			MESSAGEBOX(ALLTRIM(cur_itemsped.art_desc),64,"Descripciones adicionales")
		ENDIF
	ENDPROC

	PROCEDURE grd_itpres.Column7.Check1.Click
		LOCAL cantsel,ubireg
		cantsel=0
		ubireg=0
		
		SELECT cur_itemsped
		ubireg=RECNO()
		LOCATE
		COUNT ALL FOR selart=.T. TO cantsel
		GO ubireg
		
		IF cantsel>0
			thisform.command2.Caption="\<Deseleccionar Todos"
			thisform.command1.enabled=.T.
			thisform.estadosel=1
		ELSE
			thisform.command2.Caption="\<Seleccionar Todos"
			thisform.command1.enabled=.F.
			thisform.estadosel=0
		ENDIF
	ENDPROC

	PROCEDURE grd_itpres.Column7.Check1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		
	ENDPROC

	PROCEDURE grd_itpres.Column7.Check1.MouseUp
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
	ENDPROC


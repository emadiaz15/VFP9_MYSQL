	PROCEDURE Activate
		on key
		
		
	ENDPROC

	PROCEDURE Destroy
		on key label INS do form cualart with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		if last()=27 or codigo=0
			paso=0
			muestro=0
		endif
		if item=0
			localiz=0
		endif
	ENDPROC

	PROCEDURE Init
		parameter cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		public codiprov,cdd
		cdd=0
		SET EXACT ON
		set dele on
		codigo=0
		if opcion=2
			insertar=1
		endif
		if codigo=0
			this.text1.value=0
		endif
		thisform.text12.value=0
		*if prompt()="Presupuestos de Clientes" or prompt()="Presupuestos Clientes"
		*	this.command4.visible=.T.
		*endif   
		sele articulos
		set order to art_codi
		seek dato1
		if paso=1
			with this
				.text1.value=dato1
				.text2.value=dato2
				.text3.value=dato3
				.text4.value=dato4
				if dato1=4
					.edit1.value=dato3
				endif
				do case
					case art_alicuota=1
						thisform.text12.value=allt(str(impiva1,10,2))
					case art_alicuota=2
						thisform.text12.value=allt(str(impiva2,10,2))
				endcase
				.SetAll("Format", "K", "Textbox")
			endwith
		endif
		sele vendedores
		set order to ven_nomb
		seek UPPER(substr(sys(0),ATC("#",sys(0))+2))
		if found()
			with this
				.label19.visible=.F.
				.label16.visible=.F.
				.label13.visible=.F.
				.label20.visible=.F.
				.lstcosto.visible=.F.
				.text13.visible=.F.
				.command2.visible=.F.
				.shape2.width=422
				.autocenter=.T.
			endwith
		endif
		sele articulos
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			muestro=0
			localiz=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE Unload
		return cond
		return codigo
		return cant
		return descri
		return pruni
		return prtot
		return opcion
	ENDPROC

	PROCEDURE Command1.Click
		codigo=0
		do form artload with codigo
		if codigo>0
			thisform.text1.value=art_codi
			thisform.text6.value=art_stock
			dimension totped[1,1]
			totped[1,1]=0
			select sum(artped_cant-artped_ent) from pedidos_articulos where art_codi=thisform.text1.value and artped_ent<artped_cant into array totped
			thisform.text7.value=totped[1,1]
			dimension totcom[1,1]
			totcom[1,1]=0				
			select sum(b.artord_cant-b.artord_ent) from compras as a inner join compras_articulos as b ;
				on a.orden_codi=b.orden_codi where a.anulado<>"S" and art_codi=thisform.text1.value and artord_ent<artord_cant into array totcom
			thisform.text8.value=totcom[1,1]
			thisform.text9.value=art_stock+thisform.text8.value-thisform.text7.value
			thisform.text10.value=art_precio
			thisform.text13.value=costo_ultcpra
			thisform.text11.value=rubros.rub_desc
			do case
				case art_alicuota=1
					thisform.text12.value=allt(str(impiva1,10,2))
				case art_alicuota=2
					thisform.text12.value=allt(str(impiva2,10,2))
			endcase
			if cond=2
				thisform.text4.value=str(art_precio,10,3)
			else
				thisform.text4.value=str(art_precio*1.21,10,3)
			endif
			sele articulos_clientes
			set order to artcli
			seek str(codicli)+str(articulos.art_codi)	
			if found()
				sele desc_articulos_clientes
				count all for artcli_codi=articulos_clientes.artcli_codi to cdd
				if cdd>0
					codiprov=0
					descri=""
					do form diferentesdesc with codicli,codiprov,descri,thisform.text1.value
					if not isblank(descri)
						thisform.text3.value=allt(descri)
					else
						thisform.text3.value=articulos.art_desc
					endif
				else
					thisform.text3.value=articulos.art_desc
				endif
			else
				thisform.text3.value=articulos.art_desc
			endif
			sele articulos
			thisform.lstcosto.rowsource="select prov_nomb,artpro_costo,'     '+moneda from proveedores,articulos_proveedores where articulos_proveedores.art_codi=thisform.text1.value and proveedores.prov_codi=articulos_proveedores.prov_codi order by artpro_costo INTO CURSOR lstcosto"
			thisform.text2.setfocus
		else
			thisform.text1.setfocus
		endif
		thisform.SetAll("Format", "K", "Textbox")
		*thisform.setall("Enabled",.F.,"CommandButton")
	ENDPROC

	PROCEDURE Command2.Click
		thisform.setall("Enabled",.F.,"CommandButton")
		do form altasart
		
	ENDPROC

	PROCEDURE Command3.Click
		do case
			case thisform.height=162
				thisform.height=328
				this.caption="\<Ocultar Datos"
			case thisform.height=328
				thisform.height=162
				this.caption="\<Ver Datos"
		endcase	
	ENDPROC

	PROCEDURE Command4.Click
		thisform.text3.readonly=.F.
		thisform.text3.setfocus
	ENDPROC

	PROCEDURE Text1.Click
		this.refresh
		this.setfocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		*thisform.setall("Enabled",.T.,"CommandButton")
	ENDPROC

	PROCEDURE Text1.Valid
		if this.value<>0
			set order to art_codi
			seek this.value
			if found()
				if art_codi<>4 and art_codi<>5
					sele articulos_clientes
					set order to artcli
					seek str(codicli)+str(articulos.art_codi)
					if found()
						sele desc_articulos_clientes
						count all for artcli_codi=articulos_clientes.artcli_codi to cdd
						if cdd>0
							codiprov=0
							descri=""
							do form diferentesdesc with codicli,codiprov,descri,this.value
							if not isblank(descri)
								thisform.text3.value=allt(descri)
							else
								thisform.text3.value=articulos.art_desc
							endif
						endif
					else
						thisform.text3.value=articulos.art_desc
					endif
					sele articulos
					if paso<1
						if cond=2
							thisform.text4.value=str(art_precio,10,3)
						else
							thisform.text4.value=str(art_precio+art_precio*impiva1/100,10,3)
						endif
					endif
					thisform.text6.value=art_stock
					dimension totped[1,1]
					totped[1,1]=0
					select sum(artped_cant-artped_ent) from pedidos_articulos where art_codi=this.value and artped_ent<artped_cant into array totped
					thisform.text7.value=totped[1,1]
					dimension totcom[1,1]
					totcom[1,1]=0				
					select sum(b.artord_cant-b.artord_ent) from compras as a inner join compras_articulos as b ;
						on a.orden_codi=b.orden_codi where a.anulado<>"S" and art_codi=this.value and artord_ent<artord_cant into array totcom
					thisform.text8.value=totcom[1,1]
					thisform.text9.value=art_stock+thisform.text8.value-thisform.text7.value
					thisform.text10.value=art_precio
					thisform.text13.value=costo_ultcpra
					thisform.text11.value=rubros.rub_desc
					thisform.lstcosto.rowsource="select prov_nomb,artpro_costo,'     '+moneda from proveedores,articulos_proveedores where articulos_proveedores.art_codi=this.value and proveedores.prov_codi=articulos_proveedores.prov_codi order by artpro_costo INTO CURSOR lstcosto"
				endif
				do case
					case art_alicuota=1
						thisform.text12.value=allt(str(impiva1,10,2))
					case art_alicuota=2
						thisform.text12.value=allt(str(impiva2,10,2))
				endcase
				thisform.command4.enabled=.T.
		*		if paso<>1
		*			thisform.setall("Enabled",.F.,"CommandButton")
		*		endif
			else
				messagebox("Artículo no está en archivo",0+48,"Advertencia")
				this.value=0
				return 0
			endif
		endif
	ENDPROC

	PROCEDURE Text2.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text2.LostFocus
		if art_codi=4 or art_codi=5
			do form artsincodi with descrip
			thisform.text3.visible=.F.
			thisform.text3.value=descrip
			thisform.edit1.value=descrip
			thisform.edit1.visible=.T.
			codigo=1
		endif
		thisform.text4.setfocus
		
	ENDPROC

	PROCEDURE Text3.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Text3.LostFocus
		capslock(.F.)
		this.readonly=.T.
		thisform.text4.setfocus
	ENDPROC

	PROCEDURE Text4.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text4.LostFocus
		with thisform
			.label15.caption="Dto: "+allt(str(100-(val(this.value)*100/iif(cond=2,art_precio,art_precio+art_precio*val(.text12.value)/100)),10,2))+" %"
			.text5.value=str(val(.text2.value)*val(this.value),10,2)
		endwith
	ENDPROC

	PROCEDURE Text5.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			codigo=thisform.text1.value
			cant=thisform.text2.value
			descri=thisform.text3.value
			pruni=thisform.text4.value
			prtot=this.value
			sele articulos
			set order to art_codi
			seek codigo
			if allt(thisform.text3.value)<>allt(art_desc) and codigo<>4 and codigo<>5
				sele articulos_clientes
				set order to artcli
				seek str(codicli)+str(codigo)
				if found()
					if allt(thisform.text3.value)<>allt(artcli_desc)
						repla artcli_desc with allt(thisform.text3.value)
					endif
					sele desc_articulos_clientes
					set order to dacartcli
					seek str(articulos_clientes.artcli_codi)+allt(descri)
					if !found()
						set order to dac_codi
						go bott
						c=dac_codi+1
						appe blank
						repla dac_codi with c
						repla artcli_codi with articulos_clientes.artcli_codi
						repla dac_desc with allt(descri)
					endif
				else
					set order to artcli_cod
					go bott
					c=artcli_codi+1
					appe blank
					repla artcli_codi with c
					repla art_codi with codigo
					repla cli_codi with codicli
					
					repla artcli_desc with allt(descri)
					
					sele desc_articulos_clientes
					set order to dac_codi
					go bott
					c=dac_codi+1
					appe blank
					repla dac_codi with c
					repla artcli_codi with articulos_clientes.artcli_codi
					repla dac_desc with allt(descri)
				endif
			endif
			store 1 to localiz,muestro
			thisform.release
		endif
		
	ENDPROC

ENDDEFINE

DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="2" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Cursor1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Cursor2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Relation1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Cursor3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Cursor4" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Relation2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Cursor5" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Cursor6" UniqueID="" Timestamp="" />

	*<PropValue>
		Height = 415
		InitialSelectedAlias = "articulos"
		Left = 1
		Name = "Dataenvironment"
		Top = 220
		Width = 792
	*</PropValue>

	ADD OBJECT 'Cursor1' AS cursor WITH ;
		Alias = "articulos", ;
		CursorSource = "articulos", ;
		Database = base - hp.dbc, ;
		Height = 119, ;
		Left = 10, ;
		Name = "Cursor1", ;
		Order = "art_codi", ;
		Top = 21, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor2' AS cursor WITH ;
		Alias = "rubros", ;
		CursorSource = "rubros", ;
		Database = base - hp.dbc, ;
		Height = 90, ;
		Left = 150, ;
		Name = "Cursor2", ;
		Top = 20, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor3' AS cursor WITH ;
		Alias = "articulos_clientes", ;
		CursorSource = "articulos_clientes", ;
		Database = base - hp.dbc, ;
		Height = 142, ;
		Left = 290, ;
		Name = "Cursor3", ;
		Top = 20, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor4' AS cursor WITH ;
		Alias = "clientes", ;
		CursorSource = "clientes", ;
		Database = base - hp.dbc, ;
		Height = 263, ;
		Left = 456, ;
		Name = "Cursor4", ;
		Top = 11, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor5' AS cursor WITH ;
		Alias = "desc_articulos_clientes", ;
		CursorSource = "desc_articulos_clientes", ;
		Database = base - hp.dbc, ;
		Height = 114, ;
		Left = 617, ;
		Name = "Cursor5", ;
		Top = 16, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Cursor6' AS cursor WITH ;
		Alias = "vendedores", ;
		CursorSource = "vendedores", ;
		Database = base - hp.dbc, ;
		Height = 90, ;
		Left = 140, ;
		Name = "Cursor6", ;
		Top = 152, ;
		Width = 95
		*< END OBJECT: BaseClass="cursor" />

	ADD OBJECT 'Relation1' AS relation WITH ;
		ChildAlias = "rubros", ;
		ChildOrder = "rub_codi", ;
		Name = "Relation1", ;
		ParentAlias = "articulos", ;
		RelationalExpr = "rub_codi"
		*< END OBJECT: BaseClass="relation" />

	ADD OBJECT 'Relation2' AS relation WITH ;
		ChildAlias = "clientes", ;
		ChildOrder = "cli_codi", ;
		Name = "Relation2", ;
		ParentAlias = "articulos_clientes", ;
		RelationalExpr = "cli_codi"
		*< END OBJECT: BaseClass="relation" />

ENDDEFINE

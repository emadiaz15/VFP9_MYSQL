	ADD OBJECT 'Command1' AS commandbutton WITH ;
		Caption = "<<  \<Corregir pago anterior", ;
		Height = 25, ;
		Left = 39, ;
		Name = "Command1", ;
		Top = 181, ;
		Visible = .F., ;
		Width = 150
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'List1' AS listbox WITH ;
		FontBold = .T., ;
		Height = 152, ;
		Left = 33, ;
		Name = "List1", ;
		RowSource = "''", ;
		RowSourceType = 2, ;
		Top = 18, ;
		Width = 170
		*< END OBJECT: BaseClass="listbox" />
	
	PROCEDURE Activate
		*!*	if prompt()="Pagos de Clientes" or prompt()="Pagos a Proveedores"
		*!*		this.height=218
		*!*		this.command1.visible=.T.
		*!*	else
		*!*		this.height=180
		*!*		this.command1.visible=.F.
		*!*	endif		
	ENDPROC

	PROCEDURE Init
		parameter coditipag
		
		frmtippag= conectar_db(_screen.cn)
			SQLEXEC(frmtippag,"select tippag_desc,tippag_codi from tipospago order by tippag_desc;","cur_tipp")
		desconectar_db(frmtippag)
		
		IF RECCOUNT("cur_tipp")>0
			GO top
			thisform.list1.RowSource="cur_tipp"
		ENDIF
		
		*!*	if prompt()="Pagos de Clientes" or prompt()="Pagos a Proveedores"
		*!*		this.height=218
		*!*		this.command1.visible=.T.
		*!*	else
		*!*		this.height=180
		*!*		this.command1.visible=.F.
		*!*	endif
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		*!*	if nkeycode=27
		*!*		coditipag=0
		*!*		this.release
		*!*	endif
	ENDPROC

	PROCEDURE Unload
		return coditipag
	ENDPROC

	PROCEDURE Command1.Click
		do case
			case prompt()="Pagos de Clientes"
		*		with pagocliente
		*			do form itemmodifpag with item
		*			do while item>.olecontrol1.rows-1

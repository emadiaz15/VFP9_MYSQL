		*			sele tipospago
		*			seek allt(.olecontrol1.text)
		*			coditipag=tippag_codi
		*			.olecontrol1.row=item
		*			.olecontrol1.col=1
		*			numero=allt(.olecontrol1.text)
		*			.olecontrol1.col=2
		*			cuit=val(subst(allt(.olecontrol1.text),1,2)+subst(allt(.olecontrol1.text),4,8)+right(allt(.olecontrol1.text),1))
		*			.olecontrol1.col=3
		*			banco=allt(.olecontrol1.text)
		*			.olecontrol1.col=4
		*			plaza=allt(.olecontrol1.text)
		*			.olecontrol1.col=5
		*			fechavto=ctod(.olecontrol1.text)
		*			.olecontrol1.col=6
		*			valor=val(.olecontrol1.text)
		*			totval=totval-valor
					coditipag=0
					thisform.release
		*		endwith			
			case prompt()="Pagos a Proveedores"
		endcase
	ENDPROC

	PROCEDURE List1.Click
		if this.selected(this.listindex)
			coditipag=cur_tipp.tippag_codi
			thisform.release
		endif
		
	ENDPROC

	PROCEDURE List1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			if this.selected(this.listindex)
				coditipag=cur_tipp.tippag_codi
				thisform.release
			endif
		endif
	ENDPROC

ENDDEFINE

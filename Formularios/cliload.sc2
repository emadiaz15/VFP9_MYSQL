	ADD OBJECT 'txtcliload' AS textbox WITH ;
		BackColor = 230,230,230, ;
		FontBold = .T., ;
		Format = "!", ;
		Height = 23, ;
		Left = 31, ;
		Name = "txtcliload", ;
		SelectOnEntry = .T., ;
		TabIndex = 2, ;
		Top = 42, ;
		Width = 701
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		public d
		d=1
	ENDPROC

	PROCEDURE Init
		parameter codicli,postal,provi,locali
		
		public cade
		cade=""
		paso=0
		codicli=0
		
		LOCAL vendn
		vendn=UPPER(substr(sys(0),ATC("#",sys(0))+2))
		frmclilo= conectar_db(_screen.cn)
			SQLEXEC(frmclilo,"select * from vendedores where ven_nomb=?vendn;","cur_ven")
			if reccount("cur_ven")>0
				ven=ven_codi
			ELSE
				ven=0
			ENDIF
			do case
				case ven>0
					SQLEXEC(frmclilo,"select zona_codi,ven_codi from zonas where ven_codi=?ven;","cur_zon")
					SQLEXEC(frmclilo,"call usp_buscarcli(?codicli);","cur_aux")
					SELECT * FROM cur_aux WHERE zona_codi = any(select zona_codi FROM cur_zon) INTO CURSOR cur_clie
				other case
					SQLEXEC(frmclilo,"call usp_buscarcli(?codicli);","cur_clie")
			endcase
		desconectar_db(frmclilo)
		
		thisform.lstcli.RowSource="cur_clie"
	ENDPROC

	PROCEDURE Load
		
		
	ENDPROC

	PROCEDURE Unload
		return codicli
		return postal
		return provi
		return locali
	ENDPROC

	PROCEDURE lstcli.Click
		SELECT cur_clie
		codicli=cli_codi
		cond=cond_codi
		locali=cur_clie.loca_nomb
		provi=cur_clie.provi_nomb
		postal=cur_clie.cp_nro
		if last()!=24 AND last()!=5
			thisform.release
		ENDIF
	ENDPROC

	PROCEDURE lstcli.GotFocus
		if last()=24 or last()=5
			thisform.txtcliload.setfocus
		endif
	ENDPROC

	PROCEDURE lstcli.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nkeycode=13
			SELECT cur_clie
			codicli=cli_codi
			cond=cond_codi
			locali=cur_clie.loca_nomb
			provi=cur_clie.provi_nomb
			postal=cur_clie.cp_nro
			thisform.release
		endif
	ENDPROC

	PROCEDURE txtcliload.InteractiveChange
		if subst(allt(this.value),1,1)="?"
			SELECT cur_clie
			SET FILTER TO
		endif
		if subst(allt(this.value),1,1)!="?"
				sele cur_clie
				local lc
				lc = allt(This.Value)
				if last()<>127 and last()<>7
					do while !eof()
						if lc=subst(cli_nomb,1,len(lc))
							exit
						else
							skip
							d=d+1
							if eof()
								go top
								d=1
								exit
							endif
						endif
					enddo
				else
					do while lc=subst(cli_nomb,1,len(lc)) and d>1
						if bof()
							exit
						endif
						skip-1
						if d>1
							d=d-1
						endif
						if lc<>subst(cli_nomb,1,len(lc))
							skip
							d=d+1
							exit
						endif
					enddo
				endif
			thisform.lstcli.selected(d)=.T.
			return
		endif
		
	ENDPROC

	PROCEDURE txtcliload.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		do case
			case last()=13
				if subst(allt(this.value),1,1)="?"
					cade=subst(allt(this.value),2,len(allt(this.value)))
					sele cur_clie
					set filter to atcline(cade,cli_nomb)!=0
				else
					sele cur_clie
					locali=loca_nomb
					provi=provi_nomb
					postal=cp_nro
					codicli=cli_codi
					thisform.release
				endif
			case last()=5
				if d>1
					d=d-1
					skip-1
				endif
				thisform.lstcli.selected(d)=d
				this.value=thisform.lstcli.value
			case last()=24
				if d<thisform.lstcli.listcount
					d=d+1
					skip
				endif
				thisform.lstcli.selected(d)=d
				this.value=thisform.lstcli.value
			case last()=27
				thisform.release
		endcase
	ENDPROC

ENDDEFINE


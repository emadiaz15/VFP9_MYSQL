	PROCEDURE Init
		
		CREATE CURSOR fac_mante(fc_fec D,fc_tipo C(3),fc_pto N(4),fc_ncom N(8), fc_cliente C(45),fc_cuit N(11),fc_impo N(15,2),fc_fcodi N(8),fc_conc C(1))
		
		frmmancom = conectar_db(_screen.cn)
			SQLEXEC(frmmancom,"call usp_nrocom();","cur_facturas")
		desconectar_db(frmmancom)
		
		IF RECCOUNT("cur_facturas")>0
			LOCATE
		
			SELECT fac_fec fc_fec,tipo fc_tipo,fac_pto fc_pto,fac_nro fc_ncom,cli_nomb fc_cliente,cli_cuit fc_cuit,importe fc_impo,fac_codi fc_fcodi,fac_conc fc_conc ;
				FROM cur_facturas INTO CURSOR fac_mante readwrite
		
		
			thisformset.frm_principal.grd_cbtes.RecordSource="fac_mante"
			thisformset.frm_principal.grd_cbtes.column5.DynamicInputMask = [('9999')]
			thisformset.frm_principal.grd_cbtes.column6.DynamicInputMask = [('99999999')]
			Thisformset.frm_principal.grd_cbtes.column7.DynamicInputMask = [('$ 999,999,999.99')]
			thisformset.frm_principal.grd_cbtes.Refresh()
		ELSE
			MESSAGEBOX("NO EXISTEN COMPROBANTES DE VENTA MARCADOS PARA NO SOLICITAR CAE.",0+64,"Mantenimiento de Comprobantes")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE frm_datos.cmd_aceptar.Click
		xpr = MESSAGEBOX("¿Confirma los datos ingresados?",4+32+256,"Comprobantes")
		
		IF xpr = 6
			LOCAL xpto,xnro
			xfc  = fac_mante.fc_fcodi
			xpto = thisform.txt_punto.Value
			xnro = thisform.txt_numero.value
		*!*		thisformset.frm_principal.grd_cbtes.RecordSource=''
		*!*		frmmancom = conectar_db(_screen.cn)
		*!*			SQLEXEC(frmmancom,"UPDATE facturas SET fac_pto = ?xpto, fac_nro = ?xnro where fac_codi = ?xfc;")
		*!*			SQLEXEC(frmmancom,"call usp_nrocom();","cur_facturas")
		*!*		desconectar_db(frmmancom)
		*!*		LOCATE
		*!*		SELECT fac_fec fc_fec,tipo fc_tipo,fac_pto fc_pto,fac_nro fc_ncom,cli_nomb fc_cliente,cli_cuit fc_cuit,importe fc_impo,fac_codi fc_fcodi ;
		*!*			FROM cur_facturas INTO CURSOR fac_mante readwrite
			UPDATE fac_mante SET fc_pto = xpto, fc_ncom = xnro WHERE fc_fcodi = xfc
			thisformset.frm_principal.grd_cbtes.RecordSource="fac_mante"
			GO TOP IN fac_mante
			thisformset.frm_principal.grd_cbtes.Refresh()
			thisformset.frm_datos.AlwaysOnTop= .F.
			thisformset.frm_datos.Visible= .F.
			thisformset.frm_principal.AlwaysOnTop= .T.
			thisformset.frm_principal.Enabled= .T.
		ELSE
			thisformset.frm_datos.txt_punto.SetFocus
			this.Enabled= .F.
		ENDIF
	ENDPROC

	PROCEDURE frm_datos.cmd_aceptar.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE frm_datos.cmd_aceptar.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE frm_datos.cmd_cancel.Click
		thisformset.frm_datos.AlwaysOnTop= .F.
		thisformset.frm_datos.Visible= .F.
		thisformset.frm_principal.AlwaysOnTop= .T.
		thisformset.frm_principal.Enabled= .T.
		
	ENDPROC

	PROCEDURE frm_datos.cmd_cancel.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE frm_datos.cmd_cancel.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE frm_datos.txt_numero.Click
		this.SetFocus
	ENDPROC

	PROCEDURE frm_datos.txt_numero.LostFocus
		IF thisformset.frm_datos.txt_punto.Value > 0 AND this.Value > 0
			thisformset.frm_datos.cmd_aceptar.Enabled= .T.
			thisformset.frm_datos.cmd_aceptar.SetFocus
		ELSE
			thisformset.frm_datos.cmd_cancel.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE frm_datos.txt_punto.Click
		this.SetFocus
	ENDPROC

	PROCEDURE frm_principal.btn_salir.Click
		IF USED("cur_facturas")
			USE IN cur_facturas
		ENDIF
		IF USED("fac_mante")
			USE IN fac_mante
		ENDIF
		thisformset.release
	ENDPROC

	PROCEDURE frm_principal.btn_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE frm_principal.btn_salir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE frm_principal.Command1.Click
		IF RECCOUNT("fac_mante")>0
			SELECT COUNT(*) FROM fac_mante WHERE fc_pto > 0 INTO ARRAY cantp
		
			IF TYPE("cantp") = "N"
				IF cantp[1] > 0
					xdat = MESSAGEBOX("¿Confirma los datos ingresados?",4+32+256,"Comprobantes")
		
					IF xdat = 6
						LOCAL xpto, xnro, xcadecom,xnomcli
						xnomcli=fac_mante.fc_cliente
						SELECT fac_mante
						LOCATE
						SCAN FOR fc_pto > 0
							xpto     =REPLICATE("0",4-LEN(ALLTRIM(STR(fac_mante.fc_pto))))+ALLTRIM(STR(fac_mante.fc_pto))
							xnro     =REPLICATE("0",8-LEN(ALLTRIM(STR(fac_mante.fc_ncom))))+ALLTRIM(STR(fac_mante.fc_ncom))
							xcadecom =ALLTRIM(fac_mante.fc_tipo)+"_"+ALLTRIM(xpto)+"-"+ALLTRIM(xnro)+" -- "+ALLTRIM(xnomcli)
							xfc = fc_fcodi
							frmmancom = conectar_db(_screen.cn)
								SQLEXEC(frmmancom,"update facturas set fac_pto = ?fac_mante.fc_pto,fac_nro = ?fac_mante.fc_ncom,fac_pcae = 0 where fac_codi = ?xfc;")
								SQLEXEC(frmmancom,"update histostock set hs_obser = ?xcadecom where fac_codi = ?xfc;")
							desconectar_db(frmmancom)
						ENDSCAN
						thisform.grd_cbtes.RecordSource=''
						IF USED("cur_facturas")
							USE IN cur_facturas
						ENDIF
						IF USED("fac_mante")
							USE IN fac_mante
						ENDIF
						frmmancom = conectar_db(_screen.cn)
							SQLEXEC(frmmancom,"call usp_nrocom();","cur_facturas")
						desconectar_db(frmmancom)
		
						LOCATE
		
						SELECT fac_fec fc_fec,tipo fc_tipo,fac_pto fc_pto,fac_nro fc_ncom,cli_nomb fc_cliente,cli_cuit fc_cuit,importe fc_impo,fac_codi fc_fcodi,fac_conc fc_conc ;
							FROM cur_facturas INTO CURSOR fac_mante readwrite
						
						IF RECCOUNT("fac_mante") > 0
							thisform.grd_cbtes.RecordSource = "fac_mante"
						ELSE
							thisformset.Release
						ENDIF
					ENDIF
				ELSE
					MESSAGEBOX("No se ha efectuado ninguna modificación, no existen cambios por guardar",0+48,"Comprobantes")
				ENDIF
			ELSE
				MESSAGEBOX("No se ha efectuado ninguna modificación, no existen cambios por guardar",0+48,"Comprobantes")
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frm_principal.Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE frm_principal.Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE frm_principal.grd_cbtes.Column8.Command1.Click
		LOCAL xcadetip
		
		thisformset.frm_datos.txt_cliente.Value= fac_mante.fc_cliente
		xcadetip = ICASE(fac_mante.fc_tipo='FCA','(FCA) - FACTURA "A"', ;
						 fac_mante.fc_tipo='FCB','(FCB) - FACTURA "B"', ;
						 fac_mante.fc_tipo='NCA','(NCA) - NOTA DE CRÉDITO "A"', ;
						 fac_mante.fc_tipo='NCB','(NCB) - NOTA DE CRÉDITO "B"', ;
						 fac_mante.fc_tipo='NDA','(NDA) - NOTA DE DÉBITO "A"', ;
						 fac_mante.fc_tipo='NDB','(NDB) - NOTA DE DÉBITO "B"')
		thisformset.frm_datos.txt_tipo.Value   = xcadetip
		thisformset.frm_datos.txt_impo.Value   = fac_mante.fc_impo
		thisformset.frm_datos.txt_punto.Value  = fac_mante.fc_pto
		thisformset.frm_datos.txt_numero.Value = fac_mante.fc_ncom
		
		thisformset.frm_datos.AlwaysOnTop= .T.
		thisformset.frm_principal.AlwaysOnTop= .F.
		thisformset.frm_datos.Visible= .T.
		thisformset.frm_principal.Enabled= .F.
		thisformset.frm_datos.txt_punto.SetFocus
	ENDPROC

ENDDEFINE

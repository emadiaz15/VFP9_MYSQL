DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Spinner1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: xcant
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		BorderStyle = 0
		Caption = "Pendientes"
		DoCreate = .T.
		Height = 105
		Icon = ..\imagen\litening.ico
		MaxButton = .F.
		Name = "Form1"
		Width = 324
		WindowType = 1
		xcant = 0
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		BackColor = 33,146,214, ;
		Caption = "\<Aceptar", ;
		DisabledBackColor = 33,146,214, ;
		ForeColor = 255,255,255, ;
		Height = 25, ;
		Left = 119, ;
		Name = "Command1", ;
		Themes = .F., ;
		Top = 69, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackStyle = 0, ;
		Caption = "Cantidad de Pendientes a anular: ", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 17, ;
		Name = "Label1", ;
		TabIndex = 2, ;
		Top = 34, ;
		Width = 191
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Spinner1' AS spinner WITH ;
		Format = "K", ;
		Height = 22, ;
		Left = 221, ;
		Name = "Spinner1", ;
		TabIndex = 1, ;
		Top = 31, ;
		Value = 1, ;
		Width = 79
		*< END OBJECT: BaseClass="spinner" />
	
	PROCEDURE Init
		parameter can
		
		THISFORM.AddProperty("oRet")
		THISFORM.oRet = CREATEOBJECT("Empty")
		
		thisform.xcant= can
		
		this.spinner1.value=thisform.xcant
	ENDPROC

	PROCEDURE Unload
		RETURN ThisForm.oRet
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			ADDPROPERTY(THISFORM.oRet, "xcant", thisform.spinner1.Value)
			.release
		endwith
	ENDPROC

	PROCEDURE Spinner1.InteractiveChange
		if this.value>thisform.xcant
			this.value=thisform.xcant
		endif
		if this.value<1
			this.value=1
		endif
	ENDPROC

	PROCEDURE Spinner1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			thisform.command1.click()
		endif
	ENDPROC

ENDDEFINE

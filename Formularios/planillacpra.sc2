		XLSheet.Range(XLSheet.Cells(13,2),XLSheet.Cells(13,8)).Borders.LineStyle=1
		XLSheet.Range(XLSheet.Cells(13,2),XLSheet.Cells(13,8)).Borders.Weight=2
		XLSheet.Range(XLSheet.Cells(13,2),XLSheet.Cells(13,8)).Interior.Color= RGB(192,192,192)
		IF thisform.chk_xls.Value = 0
			XLSheet.Range(XLSheet.Cells(13,2),XLSheet.Cells(13,8)).AutoFilter
		ENDIF
		
		return
	ENDPROC

	PROCEDURE excelfooter
		LPARAMETERS xInifil
		
		LOCAL fotfil
		
		fotfil = xInifil
		
		XLSheet.Rows(fotfil).RowHeight = 10
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,7)='MONTO TOTAL'
		Xlsheet.cells(fotfil,8)='MONTO PEND'
		WITH Xlsheet.range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8))
			.font.bold=.T.
			.HorizontalAlignment=-4108
		ENDWITH
		
		thisform.excelcuadrofooter(fotfil)
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,6)='Sin Empezar ('+ALLTRIM(thisform.pgf_resum.page1.etq_cantse.Caption)+' ordenes de compra)'
		Xlsheet.cells(fotfil,6).HorizontalAlignment=-4152
		thisform.excelcuadrofooter(fotfil)
		XLSheet.Cells(fotfil,7).NUMBERFORMAT="_-[$USD] * #,##0.00"
		XLSheet.Cells(fotfil,8).NUMBERFORMAT="_-[$USD] * #,##0.00"
		XLSheet.Cells(fotfil,7)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_tdse.caption))
		XLSheet.Cells(fotfil,8)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_pdse.caption))
		fotfil = fotfil + 1
		XLSheet.Rows(fotfil).RowHeight = 10
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,6)='En Proceso ('+ALLTRIM(thisform.pgf_resum.page1.etq_cantep.Caption)+' ordenes de compra)'
		Xlsheet.cells(fotfil,6).HorizontalAlignment=-4152
		thisform.excelcuadrofooter(fotfil)
		XLSheet.Cells(fotfil,7).NUMBERFORMAT="_-[$USD] * #,##0.00"
		XLSheet.Cells(fotfil,8).NUMBERFORMAT="_-[$USD] * #,##0.00"
		XLSheet.Cells(fotfil,7)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_tdep.caption))
		XLSheet.Cells(fotfil,8)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_pdep.caption))
		fotfil = fotfil + 1
		XLSheet.Rows(fotfil).RowHeight = 10
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,6)='Finalizados Totalmente ('+ALLTRIM(thisform.pgf_resum.page1.etq_cantfin.Caption)+' ordenes de compra)'
		Xlsheet.cells(fotfil,6).HorizontalAlignment=-4152
		thisform.excelcuadrofooter(fotfil)
		XLSheet.Cells(fotfil,7).NUMBERFORMAT="_-[$USD] * #,##0.00"
		XLSheet.Cells(fotfil,8).NUMBERFORMAT="_-[$USD] * #,##0.00"
		XLSheet.Cells(fotfil,7)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_tdfin.caption))
		XLSheet.Cells(fotfil,8)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_pdfin.caption))
		fotfil = fotfil + 1
		XLSheet.Rows(fotfil).RowHeight = 10
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,6)='Totales Generales ('+ALLTRIM(thisform.pgf_resum.page1.etq_totcan.Caption)+' ordenes de compra)'
		Xlsheet.cells(fotfil,6).HorizontalAlignment=-4152
		thisform.excelcuadrofooter(fotfil)
		XLSheet.Cells(fotfil,7).NUMBERFORMAT="_-[$USD] * #,##0.00"
		XLSheet.Cells(fotfil,8).NUMBERFORMAT="_-[$USD] * #,##0.00"
		XLSheet.Cells(fotfil,7)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_totd.caption))
		XLSheet.Cells(fotfil,8)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_totdp.caption))
		
		fotfil = fotfil - 1
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil+1,8)).font.bold= .T.
		fotfil = xInifil + 1
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil+11,6)).font.bold= .T.
		
		RETURN
		
		
		
		
		
		
	ENDPROC

	PROCEDURE grd_click
		thisform.grd_ped.SelectedItemBackColor=thisform.obtenercolor(cur_planc.estado)
		thisform.grd_ped.SelectedItemForeColor=thisform.obtenercolortex(cur_planc.estado)
	ENDPROC

	PROCEDURE grid_rightclick
		IF USED("cur_planc")
			LOCAL lcShortcut, loRef
			m.loRef = this
			m.lcShortcut = SYS(2015)
		
			DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
			DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Anular Cantidades Pendientes] PICTURE "C:\VFP9_MYSQL\imagen\iconos\thumbsdown_2.ico"
			DEFINE BAR 2 OF (m.lcShortcut) PROMPT [Marcar como Finalizado] PICTURE "C:\VFP9_MYSQL\imagen\iconos\confirm_01.ico"
			DEFINE BAR 3 OF (m.lcShortcut) PROMPT [Consultar Orden de Compra] PICTURE "C:\VFP9_MYSQL\imagen\iconos\ver.bmp"
			DEFINE BAR 4 OF (m.lcShortcut) PROMPT [Modificar Orden de Compra] PICTURE "C:\VFP9_MYSQL\imagen\misc_1_911.ico"
		*!*		DEFINE BAR 5 OF (m.lcShortcut) PROMPT [Modificar Orden de Compra] PICTURE "C:\VFP9_MYSQL\imagen\misc_1_911.ico"
			
			ON SELECTION BAR 1 OF (m.lcShortcut) do form anulapendcpra with cur_planc.orcodi
			ON SELECTION BAR 2 OF (m.lcShortcut) m.loRef.Marca_Final(cur_planc.orcodi)
			ON SELECTION BAR 3 OF (m.lcShortcut) DO FORM consocpra WITH cur_planc.orcodi,cur_planc.cond_codi
			ON SELECTION BAR 4 OF (m.lcShortcut) m.loRef.modificacom()
		*!*		ON SELECTION BAR 5 OF (m.lcShortcut) m.loRef.modificaped()
				
			IF cur_planc.estado = 3 OR cur_planc.estado = 2
				SET SKIP OF BAR 2 OF (m.lcShortcut) .T.
			ENDIF
			IF cur_planc.cumplido = 'S'
				SET SKIP OF BAR 1 OF (m.lcShortcut) .T.
			ENDIF
		*!*		IF _screen.modcpraplan=.T.
		*!*			thisform.btn_actualizar.btn.Click()
		*!*			_screen.modcpraplan=.F.
		*!*		ENDIF
		
			ACTIVATE POPUP (m.lcShortcut)
			RELEASE POPUP (m.lcShortcut)
		ENDIF
	ENDPROC

	PROCEDURE Init
		*!*	PUBLIC valorcadena, codigo, nombre
		SET POINT TO ","
		SET SEPARATOR TO "."
		*!*	SET DATE BRITISH
		*!*	SET CENTURY ON
		
		PUBLIC valorcadena,pascpra
		valorcadena='Compras'
		pascpra=0
		
		IF USED("cur_planc")
			cerrar_cursor("cur_planc")
		ENDIF
		IF USED("cur_detalle")
			cerrar_cursor("cur_detalle")
		ENDIF
		
		
		frmplanc = conectar_db(_screen.cn)
			SQLEXEC(frmplanc,"select min(orden_fech) primefec, max(orden_fech) ultifech from compras where cumplido<>'S' and anulado<>'S' order by orden_fech;","cur_fechas")
		desconectar_db(frmplanc)
		
		IF RECCOUNT("cur_fechas") > 0
			thisform.xprimefec = IIF(ISNULL(cur_fechas.primefec),DATE(),cur_fechas.primefec)
			this.txt_fecdes.Value= IIF(ISNULL(cur_fechas.primefec),DATE(),cur_fechas.primefec)
			this.txt_fechas.Value= IIF(ISNULL(cur_fechas.ultifech),DATE(),cur_fechas.ultifech)
			this.chk_fechas.Value=1
			cerrar_cursor("cur_fechas")
		ENDIF
		
		frmplanc= conectar_db(_screen.cn)
			SQLEXEC(frmplanc,"select param_desc from parametros where param_codi = 13;","cur_emp")
		desconectar_db(frmplanc)
		
		IF RECCOUNT("cur_emp") > 0
			thisform.empresa=ALLTRIM(cur_emp.param_desc)
			cerrar_cursor("cur_emp")
		ENDIF
		
		FOR ncol=1 TO 7
			xsource="Thisform.grd_ped.column"+ALLTRIM(STR(ncol))+".text1"
			BINDEVENT(&xsource,"RightClick",Thisform,"Grid_RightClick")
		NEXT ncol
		
		this.btn_actualizar.SetFocus
	ENDPROC

	PROCEDURE limpiartotales
		LPARAMETERS xopcion
		
		IF xopcion = .T.
			thisform.pgf_resum.page1.etq_cantep.Caption  = ''
			thisform.pgf_resum.page1.etq_cantfin.Caption = ''
			thisform.pgf_resum.page1.etq_cantse.Caption  = ''
		*!*		thisform.pgf_resum.page1.etq_tpep.Caption    = ''
		*!*		thisform.pgf_resum.page1.etq_tpfin.Caption   = ''
		*!*		thisform.pgf_resum.page1.etq_tpse.Caption    = ''
			thisform.pgf_resum.page1.etq_tdep.Caption    = ''
			thisform.pgf_resum.page1.etq_tdfin.Caption   = ''
			thisform.pgf_resum.page1.etq_tdse.Caption    = ''
		*!*		thisform.pgf_resum.page1.etq_ppep.Caption    = ''
		*!*		thisform.pgf_resum.page1.etq_ppfin.Caption   = ''
		*!*		thisform.pgf_resum.page1.etq_ppse.Caption    = ''
			thisform.pgf_resum.page1.etq_pdep.Caption    = ''
			thisform.pgf_resum.page1.etq_pdfin.Caption   = ''
			thisform.pgf_resum.page1.etq_pdse.Caption    = ''
			thisform.pgf_resum.page1.etq_totcan.Caption  = ''
		*!*		thisform.pgf_resum.page1.etq_totp.Caption    = ''
			thisform.pgf_resum.page1.etq_totd.Caption    = ''
		*!*		thisform.pgf_resum.page1.etq_totpp.Caption   = ''
			thisform.pgf_resum.page1.etq_totdp.Caption   = ''
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE marca_final
		LPARAMETERS nCodi
		
		prfin= MESSAGEBOX("¿Confirma marcar la orden de compra como Finalizada?",36,"Aviso del Sistema")
		
		IF prfin = 6
			IF cur_planc.cumplido<>"S"
				frmplanc= conectar_db(_screen.cn)
					SQLEXEC(frmplanc,"select * from compras_articulos where orden_codi = ?nCodi and artord_ent<artord_cant;","cur_pendi")
				desconectar_db(frmplanc)
				IF RECCOUNT("cur_pendi")>0
					LOCAL xapc,xpend,xart
					STORE 0 TO xapc,xpend,xart
					SELECT cur_pendi
					LOCATE
					SCAN
						xart  =cur_pendi.art_codi
						xapc  =cur_pendi.artord_codi
						xpendi=cur_pendi.artord_cant-cur_pendi.artord_ent
						frmplanc= conectar_db(_screen.cn)
		*!*						SQLEXEC(frmplanc,"update articulos set pedidos = pedidos - ?xpendi where art_codi = ?xart;")
							SQLEXEC(frmplanc,"update compras_articulos set artord_ent = artord_cant where artord_codi = ?xapc;")
						desconectar_db(frmplanc)
						IF xart > 5
							Campo_ppr(xart)
						ENDIF
					ENDSCAN
					frmplanc= conectar_db(_screen.cn)
						SQLEXEC(frmplanc,"update compras set cumplido = 'S' where orden_codi = ?nCodi;")
					desconectar_db(frmplanc)
					cerrar_cursor("cur_pendi")
				ENDIF
			ENDIF
		
		*!*		frmplanc= conectar_db(_screen.cn)
		*!*			SQLEXEC(frmplanc,"update pedidos set finalizado = 1 where ped_codi = ?nCodi;")
		*!*		desconectar_db(frmplanc)
		
			SELECT cur_planc
			nregis= RECNO()
			thisform.btn_actualizar.btn.Click
			GO nregis
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE modificacom
		LOCAL xcomcod
		
		xcomcod = cur_planc.orcodi
		
		DO FORM modiocpra WITH cur_planc.orcodi,cur_planc.cond_codi
		
		*!*	LOCATE FOR cur_planc.orcodi = xcomcod
		
		_screen.modcpraplan=.T.
		
		RETURN
		
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS nEstado
		
		LOCAL lnColor
		
		DO case
			CASE nEstado = 1
				lnColor = RGB(227,68,34)
			CASE nEstado = 2
				lnColor = RGB(52,105,105)
		    CASE nEstado = 3 OR nEstado = 5
		    	lnColor = RGB(66,69,84)
			CASE nEstado = 4
				lnColor = RGB(0,255,255)
		ENDCASE
		
		return(lnColor)
		
	ENDPROC

	PROCEDURE obtenercolortex
		LPARAMETERS nEstado
		
		LOCAL txColor
		
		DO case
			CASE nEstado = 1
				txColor = RGB(255,255,255)
			CASE nEstado = 2
				txColor = RGB(255,255,255)
			CASE nEstado = 3 OR nEstado = 5
				txColor = RGB(230,232,242)
			CASE nEstado = 4
				txColor = RGB(0,0,0)
		ENDCASE
		
		return(txColor)
		
	ENDPROC

	PROCEDURE recorrer
		LPARAMETERS xkeycode
		
		IF xkeycode = 5 OR xkeycode = 24
			frmplanc= conectar_db(_screen.cn)
				SQLEXEC(frmplanc,"select orden_obser from compras where orden_codi = ?cur_planc.orcodi","cur_obser")
			desconectar_db(frmplanc)
			
			IF RECCOUNT("cur_obser") > 0
				IF LEN(ALLTRIM(cur_obser.orden_obser)) > 0
					thisform.pgf_resum.page2.edt_obser.Value = ALLTRIM(cur_obser.orden_obser)
				ELSE
					thisform.pgf_resum.page2.edt_obser.Value = ''
				ENDIF
				cerrar_cursor("cur_obser")
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE bnt_impirmir.Click
		IF USED("cur_planc")
			IF RECCOUNT("cur_planc") > 0
				IF thisform.chk_deta.Value=1 then
					SELECT cur_detalle
					LOCATE
					INDEX on orcodi TO SYS(2015)
					SELECT cur_planc
					LOCATE
					INDEX on orcodi TO SYS(2015)
					SET RELATION TO
					SET RELATION TO orcodi INTO cur_detalle addi
					IF thisform.chk_pant.Value=1
						REPORT FORM planicpra_2 PREVIEW NOCONSOLE	
					ELSE
						REPORT FORM planicpra_2 TO PRINTER PROMPT NOCONSOLE
					ENDIF
				ELSE
					SELECT cur_planc
					LOCATE		
					IF thisform.chk_pant.Value=1
						REPORT FORM planicpra_1 PREVIEW NOCONSOLE
					ELSE
						REPORT FORM planicpra_1 TO PRINTER PROMPT NOCONSOLE
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE bnt_impirmir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE bnt_impirmir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Btn_actualizar.btn.Click
		LOCAL fecdes,fechas,ordes,orhas,ardes,arhas
		imposf = 0
		DIMENSION cantsf[1,1]
		cantsf[1,1] = 0
		
		thisform.grd_ped.RecordSource = ''
		thisform.grd_ped.Refresh
		
		fecdes = thisform.txt_fecdes.Value
		fechas = thisform.txt_fechas.Value
		ordes = thisform.txt_ordes.Value
		orhas = thisform.txt_orhas.Value
		ardes  = thisform.txt_artdes.Value
		arhas  = thisform.txt_arthas.Value
		
		SET DECIMALS TO 3
		frmplanc = conectar_db(_screen.cn)
			SQLEXEC(frmplanc, "call usp_planicpra(?fecdes, ?fechas, ?ordes, ?orhas, ?ardes, ?arhas);","cur_detalle")
		desconectar_db(frmplanc)
		SET DECIMALS TO
		
		IF RECCOUNT("cur_detalle") > 0
			SELECT distinct fecha,orcodi,proveedor,canitems,cancump,impotot, ;
							impopen,moneda,cumplido, ;
							prov_codi,cond_codi,estado ;
							FROM cur_detalle INTO CURSOR cur_planc
		
			IF thisform.xcodiprov <> 99999999
				SELECT * FROM cur_planc WHERE prov_codi = thisform.xcodiprov INTO CURSOR cur_planc
			ENDIF
			IF !(thisform.chk_sinem.Value = 1 AND thisform.chk_enpro.Value = 1 AND thisform.chk_fin.Value = 1)
				DO case
					CASE thisform.chk_sinem.Value = 1 AND thisform.chk_enpro.Value = 0 AND thisform.chk_fin.Value = 0 &&(Sin Empezar)
						SELECT * FROM cur_planc WHERE estado = 1 INTO CURSOR cur_planc 
					CASE thisform.chk_sinem.Value = 1 AND thisform.chk_enpro.Value = 1 AND thisform.chk_fin.Value = 0 &&(Sin Empezar / En Proceso)
						SELECT * FROM cur_planc WHERE estado in (1, 2) INTO CURSOR cur_planc 
					CASE thisform.chk_sinem.Value = 0 AND thisform.chk_enpro.Value = 1 AND thisform.chk_fin.Value = 1 &&(En Proceso / Finalizados)
						SELECT * FROM cur_planc WHERE estado in (2, 3) INTO CURSOR cur_planc 
					CASE thisform.chk_sinem.Value = 1 AND thisform.chk_enpro.Value = 0 AND thisform.chk_fin.Value = 1 &&(Sin Empezar / Finalizados)
						SELECT * FROM cur_planc WHERE estado in (1, 3) INTO CURSOR cur_planc 				
					CASE thisform.chk_sinem.Value = 0 AND thisform.chk_enpro.Value = 1 AND thisform.chk_fin.Value = 0 &&(En Proceso)
						SELECT * FROM cur_planc WHERE estado in (2) INTO CURSOR cur_planc 
					CASE thisform.chk_sinem.Value = 0 AND thisform.chk_enpro.Value = 0 AND thisform.chk_fin.Value = 1 &&(Finalizados)
						SELECT * FROM cur_planc WHERE estado in (3) INTO CURSOR cur_planc 			
				ENDCASE
			ENDIF
			LOCATE
				
			IF thisform.chk_sinem.Value = 0 AND thisform.chk_enpro.Value = 0 AND thisform.chk_fin.Value = 0
				IF USED("cur_planc")
					SELECT cur_planc
					USE
				ENDIF
				IF USED("cur_detalle")
					SELECT cur_detalle
					USE
				ENDIF
				thisform.grd_ped.RecordSource = ''
				thisform.grd_ped.Refresh
				thisform.limpiartotales(.T.)
			ELSE
				thisform.limpiartotales(.T.)
				thisform.grd_ped.RecordSource = "cur_planc"
			
				Thisform.grd_ped.column6.DynamicInputMask = [('USD999,999,999.99')]
				&& [IIF(cur_planc.moneda = 'D',('USD999,999,999.99'),('$999,999,999.99'))]
				Thisform.grd_ped.column7.DynamicInputMask = [('USD999,999,999.99')]
				&& [IIF(cur_planc.moneda = 'D',('USD999,999,999.99'),('$999,999,999.99'))]
				thisform.grd_ped.SetAll("DynamicBackcolor","thisform.obtenercolor(cur_planc.estado)","Column")
				thisform.grd_ped.SetAll("DynamicForecolor","thisform.obtenercolortex(cur_planc.estado)","Column")
		*!*			thisform.grd_ped.SetAll("DynamicFontbold","iif(cur_planc.estado=4,.T.,.F.)","Column")
				thisform.contarpedidos()
				thisform.calculartotales()
				frmplanc= conectar_db(_screen.cn)
					SQLEXEC(frmplanc,"select TRIM(orden_obser) orden_obser from compras where orden_codi = ?cur_planc.orcodi;","cur_obser")
				desconectar_db(frmplanc)
				IF RECCOUNT("cur_obser") > 0
					IF LEN(ALLTRIM(cur_obser.orden_obser)) > 0
						thisform.pgf_resum.page2.edt_obser.Value = ALLTRIM(cur_obser.orden_obser)
					ELSE
						thisform.pgf_resum.page2.edt_obser.Value = ""
					ENDIF
					cerrar_cursor("cur_obser")
				ENDIF
				thisform.grd_ped.SetFocus
			ENDIF
		ELSE
			thisform.limpiartotales(.T.)
		ENDIF
	ENDPROC


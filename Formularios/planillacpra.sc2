		XLSheet.Cells(13,6)="CUMPL."
		XLSheet.Cells(13,6).font.bold=.T.
		XLSheet.Cells(13,6).font.size="11"
		XLSheet.Cells(13,6).font.name="Courier New"
		XLSheet.range("F13:F13").HorizontalAlignment=-4108

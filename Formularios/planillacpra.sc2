	PROCEDURE txt_artdes.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_artdes.LostFocus
		IF this.Value > 0
			thisform.chk_articulo.Value = 0
			thisform.txt_arthas.Value= this.Value
		ENDIF
		
	ENDPROC

	PROCEDURE txt_arthas.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_arthas.LostFocus
		IF this.Value < 99999999
			thisform.chk_articulo.Value = 0
		ENDIF
		
	ENDPROC

	PROCEDURE txt_fecdes.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_fecdes.GotFocus
		IF this.Value > thisform.xprimefec AND thisform.chk_fechas.Value = 1
			thisform.chk_fechas.Value = 0
		ENDIF
		
	ENDPROC

	PROCEDURE txt_fecdes.LostFocus
		IF this.Value > thisform.xprimefec AND thisform.chk_fechas.Value = 1
			thisform.chk_fechas.Value = 0
		ENDIF
		
	ENDPROC

	PROCEDURE txt_fechas.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_fechas.GotFocus
		IF this.Value < DATE() AND thisform.chk_fechas.Value = 1
			thisform.chk_fechas.Value = 0
		ENDIF
		
	ENDPROC

	PROCEDURE txt_fechas.LostFocus
		IF this.Value < DATE() AND thisform.chk_fechas.Value = 1
			thisform.chk_fechas.Value = 0
		ENDIF
	ENDPROC

	PROCEDURE txt_ordes.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_ordes.LostFocus
		IF this.Value > 0
			thisform.chk_pedcod.Value = 0
		ENDIF
		
	ENDPROC

	PROCEDURE txt_orhas.Click
		this.SetFocus
	ENDPROC

	PROCEDURE txt_orhas.LostFocus
		IF this.Value < 99999999
			thisform.chk_pedcod.Value = 0
		ENDIF
		
	ENDPROC

ENDDEFINE

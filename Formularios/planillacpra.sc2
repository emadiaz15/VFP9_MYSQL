	PROCEDURE Activate
		IF _screen.modcpraplan=.T.
			LOCAL xcomcod
			xcomcod = cur_planc.orcodi
			thisform.btn_actualizar.btn.Click()
			LOCATE FOR cur_planc.orcodi = xcomcod
			_screen.modcpraplan=.F.
		ENDIF
		
	ENDPROC

	PROCEDURE agregapendientes
		LPARAMETERS xorden, xfila
		
		if cur_planc.estado <> 3
			SELECT art_codi,art_desc,artord_cant-artord_ent pend FROM cur_detalle ;
				WHERE orcodi = xorden AND artord_ent < artord_cant INTO CURSOR cur_pendientes
		ELSE
			SELECT art_codi,art_desc,artord_cant-artord_ent pend FROM cur_detalle ;
				WHERE orcodi = xorden INTO CURSOR cur_pendientes
		ENDIF
		
		XLSheet.Cells(xfila,3)="CÓDIGO"
		XLSheet.Range(XLSheet.Cells(xfila,4),XLSheet.Cells(xfila,5)).Merge
		XLSheet.Cells(xfila,4)="DESCRIPCIÓN"
		XLSheet.Cells(xfila,6)="PENDIENTES"
		XLSheet.Range(XLSheet.Cells(xfila,3),XLSheet.Cells(xfila,6)).Interior.Color= RGB(192,192,192)
		XLSheet.Range(XLSheet.Cells(xfila,3),XLSheet.Cells(xfila,6)).Font.Bold= .T.
		XLSheet.Range(XLSheet.Cells(xfila,3),XLSheet.Cells(xfila,6)).HorizontalAlignment = -4108
		
		xfila = xfila + 1
		
		SELECT cur_pendientes
		GO TOP
		SCAN
			XLSheet.Cells(xfila,3)=cur_pendientes.art_codi
			XLSheet.Cells(xfila,3).HorizontalAlignment = -4108
			XLSheet.Range(XLSheet.Cells(xfila,4),XLSheet.Cells(xfila,5)).Merge
			XLSheet.Cells(xfila,4)=cur_pendientes.art_desc
			XLSheet.Cells(xfila,6)=cur_pendientes.pend
			XLSheet.Cells(xfila,6).HorizontalAlignment = -4108
			XLSheet.Cells(xfila,6).NUMBERFORMAT="#,###0.000"
			xfila = xfila + 1
		ENDSCAN
		
		thisform.auxfila = xfila
		
		SELECT cur_planc
		
		RETURN
	ENDPROC

	PROCEDURE calculartotales
		IF USED("cur_planc")
			LOCATE
		*!*		SELECT SUM(impotot) FROM cur_planc WHERE estado = 1 AND moneda = 'P' INTO ARRAY ar_tpse
		*!*		SELECT SUM(impotot) FROM cur_planc WHERE estado = 2 AND moneda = 'P' INTO ARRAY ar_tpep
		*!*		SELECT SUM(impotot) FROM cur_planc WHERE estado = 3 AND moneda = 'P' INTO ARRAY ar_tpft
		&& AND moneda = 'D'
			SELECT SUM(impotot) FROM cur_planc WHERE estado = 1 INTO ARRAY ar_tdse
			SELECT SUM(impotot) FROM cur_planc WHERE estado = 2 INTO ARRAY ar_tdep
			SELECT SUM(impotot) FROM cur_planc WHERE estado = 3 OR estado = 5 INTO ARRAY ar_tdft
			
		*!*		SELECT SUM(impopen) FROM cur_planc WHERE estado = 1 AND moneda = 'P' INTO ARRAY ar_ppse
		*!*		SELECT SUM(impopen) FROM cur_planc WHERE estado = 2 AND moneda = 'P' INTO ARRAY ar_ppep
		*!*		SELECT SUM(impopen) FROM cur_planc WHERE estado = 3 AND moneda = 'P' INTO ARRAY ar_ppft
		
			SELECT SUM(impopen) FROM cur_planc WHERE estado = 1 INTO ARRAY ar_pdse
			SELECT SUM(impopen) FROM cur_planc WHERE estado = 2 INTO ARRAY ar_pdep
			SELECT SUM(impopen) FROM cur_planc WHERE estado = 3 OR estado = 5 INTO ARRAY ar_pdft
		*!*		SELECT SUM(remsfac) FROM cur_planc WHERE estado = 4 INTO ARRAY ar_rsf
		*!*		IF ar_rsf[1,1] > 0
		*!*			thisform.remsf = ar_rsf[1,1]
		*!*		ELSE
		*!*			thisform.remsf = 0
		*!*		ENDIF
		*!*		thisform.pgf_resum.page1.etq_tpse.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_tpse),0,ar_tpse),15,2))
		*!*		thisform.pgf_resum.page1.etq_tpep.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_tpep),0,ar_tpep),15,2))
		*!*		thisform.pgf_resum.page1.etq_tpfin.Caption = ALLTRIM(STR(IIF(ISNULL(ar_tpft),0,ar_tpft),15,2))
		*!*		thisform.pgf_resum.page1.etq_totp.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_tpse),0,ar_tpse) + ;
		*!*		                                                         IIF(ISNULL(ar_tpep),0,ar_tpep) + ;
		*!*		                                                         IIF(ISNULL(ar_tpft),0,ar_tpft),15,2))
			                                                         
			thisform.pgf_resum.page1.etq_tdse.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_tdse),0,ar_tdse),15,2))
			thisform.pgf_resum.page1.etq_tdep.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_tdep),0,ar_tdep),15,2))
			thisform.pgf_resum.page1.etq_tdfin.Caption = ALLTRIM(STR(IIF(ISNULL(ar_tdft),0,ar_tdft),15,2))
			thisform.pgf_resum.page1.etq_totd.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_tdse),0,ar_tdse) + ;
			                                                         IIF(ISNULL(ar_tdep),0,ar_tdep) + ;
			                                                         IIF(ISNULL(ar_tdft),0,ar_tdft),15,2))
		
		*!*		thisform.pgf_resum.page1.etq_ppse.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_ppse),0,ar_ppse),15,2))
		*!*		thisform.pgf_resum.page1.etq_ppep.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_ppep),0,ar_ppep),15,2))
		*!*		thisform.pgf_resum.page1.etq_ppfin.Caption = ALLTRIM(STR(IIF(ISNULL(ar_ppft),0,ar_ppft),15,2))
		*!*		thisform.pgf_resum.page1.etq_totpp.Caption = ALLTRIM(STR(IIF(ISNULL(ar_ppse),0,ar_ppse) + ;
		*!*		                                                         IIF(ISNULL(ar_ppep),0,ar_ppep) + ;
		*!*		                                                         IIF(ISNULL(ar_ppft),0,ar_ppft),15,2))
			                                                         
			thisform.pgf_resum.page1.etq_pdse.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_pdse),0,ar_pdse),15,2))
			thisform.pgf_resum.page1.etq_pdep.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_pdep),0,ar_pdep),15,2))
			thisform.pgf_resum.page1.etq_pdfin.Caption = ALLTRIM(STR(IIF(ISNULL(ar_pdft),0,ar_pdft),15,2))
			thisform.pgf_resum.page1.etq_totdp.Caption = ALLTRIM(STR(IIF(ISNULL(ar_pdse),0,ar_pdse) + ;
			                                                         IIF(ISNULL(ar_pdep),0,ar_pdep) + ;
			                                                         IIF(ISNULL(ar_pdft),0,ar_pdft),15,2))
		ENDIF
		*!*	DO case
		*!*		CASE nEstado = 1
		*!*			lnColor = RGB(230,0,0)
		*!*		CASE nEstado = 2
		*!*			lnColor = RGB(52,105,105)
		*!*	    CASE nEstado = 3
		*!*	    	lnColor = RGB(131,208,142)
		*!*	ENDCASE
		
		
	ENDPROC

	PROCEDURE colorear_asterisco
		LPARAMETERS xfila
		
		xrango = ALLTRIM('"F'+ALLTRIM(STR(xfila))+'"')
		
		With XLSheet.Range(&xrango).Characters(1,3).Font
		    .Name = "Calibri"
		    .FontStyle = "Negrita"
		    .Size = 11
		    .Strikethrough = .F.
		    .Superscript = .F.
		    .Subscript = .F.
		    .OutlineFont = .F.
		    .Shadow = .F.
		    .Color = -16776961
		EndWith
		    
		RETURN
		
	ENDPROC

	PROCEDURE contarpedidos
		IF USED("cur_planc")
			LOCATE
			SELECT COUNT(*) FROM cur_planc WHERE estado = 1 INTO ARRAY ar_cantse
			SELECT COUNT(*) FROM cur_planc WHERE estado = 2 INTO ARRAY ar_cantep
			SELECT COUNT(*) FROM cur_planc WHERE estado = 3 OR estado = 5 INTO ARRAY ar_cantft
			SELECT COUNT(*) FROM cur_planc WHERE estado = 4 INTO ARRAY ar_cantsf
			
			thisform.pgf_resum.page1.etq_cantse.Caption  = ALLTRIM(STR(ar_cantse))
			thisform.pgf_resum.page1.etq_cantep.Caption  = ALLTRIM(STR(ar_cantep))
			thisform.pgf_resum.page1.etq_cantfin.Caption = ALLTRIM(STR(ar_cantft))
			thisform.pgf_resum.page1.etq_totcan.Caption  = ALLTRIM(STR(ar_cantse + ar_cantep + ar_cantsf + ar_cantft))
		ENDIF
	ENDPROC

	PROCEDURE copiapedido
		LPARAMETERS ncodp
		
		LOCAL xcodp,xcond
		
		xcodp    = ncodp
		xcond    = cur_planc.cond_codi
		
		DO FORM pedxped WITH xcodp,xcond
		
		thisform.btn_actualizar.btn.Click()
		
		RETURN
	ENDPROC

	PROCEDURE datos_click
		
		thisform.RemoveObject("shp_datos")
		thisform.RemoveObject("edt_datos")
		thisform.RemoveObject("cmd_datos")
	ENDPROC

	PROCEDURE datos_mleave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.F.
		thisform.cmd_datos.FontSize=9
	ENDPROC

	PROCEDURE datos_mmove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.T.
		thisform.cmd_datos.FontSize=10
	ENDPROC

	PROCEDURE Destroy
		SET POINT TO
		SET SEPARATOR TO
	ENDPROC

	PROCEDURE excelcuadrofooter
		LPARAMETERS nFila
		
		fotfil = nFila
		
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(1).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(1).Weight=3
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(2).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(2).Weight=3
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(3).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(3).Weight=3
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(4).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(4).Weight=3
		
		RETURN
		
		
	ENDPROC


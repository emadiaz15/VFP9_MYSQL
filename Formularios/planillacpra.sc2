			thisform.txt_artdes.Value = 0
			thisform.txt_arthas.Value = 99999999
		ELSE
			thisform.txt_artdes.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE chk_fechas.Click
		IF this.Value=1
			thisform.txt_fecdes.value=thisform.xprimefec
			thisform.txt_fechas.value=DATE()
			thisform.btn_actualizar.setfocus
		ELSE
			thisform.txt_fecdes.value=DATE()
			thisform.txt_fechas.value=DATE()
			thisform.btn_actualizar.SetFocus
		endif
	ENDPROC

	PROCEDURE chk_pedcod.Click
		IF this.Value = 1
			thisform.txt_ordes.Value = 0
			thisform.txt_orhas.Value = 99999999
		ELSE
			thisform.txt_ordes.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE chk_prov.Click
		IF this.Value=1
			thisform.xcodiprov = 99999999
			thisform.cmb_proveedor.value=''
			thisform.cmb_proveedor.RowSource=''
			thisform.btn_actualizar.SetFocus
		ELSE
			thisform.xcodiprov = 99999999
			thisform.cmb_proveedor.SetFocus

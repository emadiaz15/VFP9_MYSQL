	PROCEDURE cmb_proveedor.Click
		this.setfocus
	ENDPROC

	PROCEDURE cmb_proveedor.Destroy
		set notify on
	ENDPROC

	PROCEDURE cmb_proveedor.GotFocus
		set notify off
		
		
	ENDPROC

	PROCEDURE cmb_proveedor.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode=13
			for i=1 to this.listcount
				if this.selected(i)
					frmplanc= conectar_db(_screen.cn)
						xdesc=allt(this.list(i))
						SQLEXEC(frmplanc,"select * from proveedores where TRIM(prov_nomb)=?xdesc;","cur_pro")
					desconectar_db(frmplanc)
					thisform.xcodiprov=cur_pro.prov_codi
					thisform.chk_prov.Value=0
					keyboard '{TAB}'
				endif
			next i
		endif
	ENDPROC

	PROCEDURE cmb_proveedor.LostFocus
		IF LEN(ALLTRIM(this.Value)) = 0
			thisform.chk_prov.Value = 1
			thisform.xcodiprov = 99999999
		ENDIF
		
	ENDPROC

	PROCEDURE cmb_proveedor.Valid
		if lastkey()=13
			if subst(allt(this.text),1,1)="?"
				cade="%"+subst(allt(this.text),2,len(allt(this.text)))+"%"
				frmplanc= conectar_db(_screen.cn)
					SQLEXEC(frmplanc,"select * from proveedores where prov_nomb like ?cade order by prov_nomb;","cur_pro")
				desconectar_db(frmplanc)
				IF RECCOUNT("cur_pro")>0
					this.rowsource="select prov_nomb from cur_pro INTO CURSOR cmb_proveedor"
					this.value=this.list(1)
					keyboard "{F4}"
				ELSE
					MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
					this.Value=""			
				ENDIF
				RETURN .F.
			else
				if len(allt(this.text))>0
					cade=ALLTRIM(this.text)+"%"
					frmplanc= conectar_db(_screen.cn)
						SQLEXEC(frmplanc,"select * from proveedores where prov_nomb like ?cade;","cur_pro")
					desconectar_db(frmplanc)
					IF RECCOUNT("cur_pro")>0
						this.rowsource="select prov_nomb from cur_pro INTO CURSOR cmb_proveedor"
						this.value=this.list(1)
						keyboard "{F4}"
					ELSE
						MESSAGEBOX("No se encontraron coincidencias con el texto ingresado",0+64,"Aviso del Sistema")
						this.Value=""				
					ENDIF
					RETURN .F.
				ENDIF
			endif
		endif
	ENDPROC

	PROCEDURE Command2.Click
		codigo=0
		nombre=''
		
		DO FORM artload WITH codigo, nombre
		
		IF codigo > 0
			thisform.txt_artdes.Value= codigo
			thisform.txt_arthas.Value= codigo
			thisform.chk_articulo.Value = 0
		ENDIF
	ENDPROC

	PROCEDURE Command3.Click
		codigo=0
		nombre=''
		
		DO FORM artload WITH codigo, nombre
		
		IF codigo > 0
			IF thisform.txt_artdes.Value > codigo
				thisform.txt_artdes.Value = codigo
			ENDIF
			thisform.txt_arthas.Value= codigo
			thisform.chk_articulo.Value = 0
		ENDIF
	ENDPROC

	PROCEDURE Command4.Click
		IF USED("cur_planc")
			IF RECCOUNT("cur_planc") > 0
				SELECT cur_planc
				LOCATE
				local Fila,fpag,pagina,empresa,lnCantidadDatos,lnI,lnPorcentaje
		
				wait'Espere Un Momento Exportando Datos' window nowait
				_screen.mousepointer=11
				TmpSheet=GetObject('','Excel.Sheet')
				XLApp=TmpSheet.Application
				XLApp.workbooks.add()
				XLSheet=XLApp.ActiveSheet
				with XLSheet.PageSetup
					.Orientation = 1
					.LeftMargin = XLApp.InchesToPoints(0)
					.RightMargin = XLApp.InchesToPoints(0)
				    .TopMargin = XLApp.InchesToPoints(0)
				    .BottomMargin = XLApp.InchesToPoints(0)
				    .HeaderMargin = XLApp.InchesToPoints(0)
				    .FooterMargin = XLApp.InchesToPoints(0)
				    .Zoom=85
				ENDWITH
				XLSheet.Columns("A:A").ColumnWidth = 3.71
				XLSheet.Columns("B:B").ColumnWidth = 10.71
				XLSheet.Columns("C:C").ColumnWidth = 10.71
				XLSheet.Columns("D:D").ColumnWidth = 31.57
				XLSheet.Columns("E:E").ColumnWidth = 10.71
				XLSheet.Columns("F:F").ColumnWidth = 10.71
				XLSheet.Columns("G:G").ColumnWidth = 16.43
				XLSheet.Columns("H:H").ColumnWidth = 16.43
		
				thisform.excelencabezado()
		
				sele cur_planc
				go top
				lnCantidadDatos=RECCOUNT("cur_planc")
				Fila=14
				thisform.progreso.Visible= .T.
				FOR lnI = 1 TO lnCantidadDatos
				   	xini = "B"+ALLTRIM(STR(Fila))
				   	xfin = "H"+ALLTRIM(STR(Fila))
				   	rango= '"'+xini+':'+xfin+'"'
				   	XLSheet.range(&rango).Font.Size = "10"
				   	DO case
				   		CASE cur_planc.estado = 1
				   			XLSheet.range(&rango).Interior.Color= thisform.obtenercolor(cur_planc.estado)
				   			XLSheet.range(&rango).Font.Color    = thisform.obtenercolortex(cur_planc.estado)
				   		CASE cur_planc.estado = 2
				   			XLSheet.range(&rango).Interior.Color= thisform.obtenercolor(cur_planc.estado)
				   			XLSheet.range(&rango).Font.Color    = thisform.obtenercolortex(cur_planc.estado)
				   		CASE cur_planc.estado = 3
				   			XLSheet.range(&rango).Interior.Color= thisform.obtenercolor(cur_planc.estado)
				   			XLSheet.range(&rango).Font.Color    = thisform.obtenercolortex(cur_planc.estado)
				   	ENDCASE 
				   	WITH XLSheet.RANGE(&rango)
					    .Borders(1).LineStyle = 1
					    .Borders(1).Weight = 1
					    .Borders(1).Color = RGB(185,185,185)
					    .Borders(2).LineStyle = 1
					    .Borders(2).Weight = 1
					    .Borders(2).Color = RGB(185,185,185)
					    .Borders(3).LineStyle = 1
					    .Borders(3).Weight = 1
					    .Borders(3).Color = RGB(185,185,185)
					    .Borders(4).LineStyle = 1
					    .Borders(4).Weight = 1
					    .Borders(4).Color = RGB(185,185,185)
					ENDWITH
					XLSheet.Cells(Fila,2)=cur_planc.fecha
				   	XLSheet.Cells(Fila,2).HorizontalAlignment=-4108
				   	XLSheet.Cells(Fila,3)=cur_planc.orcodi
				   	XLSheet.Cells(Fila,4)=cur_planc.proveedor
				   	XLSheet.Cells(Fila,5)=cur_planc.canitems
				   	XLSheet.Cells(Fila,5).HorizontalAlignment=-4108
				   	XLSheet.Cells(Fila,6)=cur_planc.cancump
				   	XLSheet.Cells(Fila,6).HorizontalAlignment=-4108
				   	XLSheet.Cells(Fila,7)=cur_planc.impotot
				   	XLSheet.Cells(Fila,8)=cur_planc.impopen
		*!*			  	DO case
		*!*			  		CASE cur_planc.moneda='P'
		*!*			  			XLSheet.Cells(Fila,7).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		*!*			  			XLSheet.Cells(Fila,8).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		*!*			  		CASE cur_planc.moneda='D'
				  			XLSheet.Cells(Fila,7).NUMBERFORMAT="_-[$USD] * #,##0.00"
				  			XLSheet.Cells(Fila,8).NUMBERFORMAT="_-[$USD] * #,##0.00"
		*!*			  	ENDCASE
				   	Fila=Fila+1
				   	IF thisform.chk_xls.Value=1
						thisform.agregapendientes(cur_planc.orcodi,Fila)
						Fila = thisform.auxfila
				   	ENDIF
					lnPorcentaje            = lnI * 100 / lnCantidadDatos
				    ThisForm.Progreso.Value = lnPorcentaje
				    skip		   	
				ENDFOR
		
				thisform.excelfooter(Fila)
				thisform.progreso.Visible= .F.
				XLApp.visible=.T.
				XLApp.WindowState = -4137
				DECLARE LONG BringWindowToTop IN "user32" LONG HWND
				BringWindowToTop(XLApp.HWND)
				_screen.mousepointer=0
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Ctn_banner1.Init
		this.Height=133
		this.left=0
		this.Width=this.Parent.Width
		
	ENDPROC

	PROCEDURE grd_ped.Column1.Header1.Click
		IF USED("cur_planc")
			thisform.grd_ped.RecordSource=''
			IF thisform.hdfecha_estado = 0
				SELECT * FROM cur_detalle ORDER BY fecha INTO CURSOR cur_detalle
				SELECT * FROM cur_planc ORDER BY fecha INTO CURSOR cur_planc
				thisform.hdfecha_estado = 1
			ELSE
				DO case
					CASE thisform.hdfecha_estado = 1
						SELECT * FROM cur_detalle ORDER BY fecha DESC INTO CURSOR cur_detalle
						SELECT * FROM cur_planc ORDER BY fecha DESC INTO CURSOR cur_planc
						thisform.hdfecha_estado = 2
					CASE thisform.hdfecha_estado = 2
						SELECT * FROM cur_detalle ORDER BY fecha INTO CURSOR cur_detalle
						SELECT * FROM cur_planc ORDER BY fecha INTO CURSOR cur_planc
						thisform.hdfecha_estado = 1
				ENDCASE
			ENDIF
			thisform.grd_ped.RecordSource="cur_planc"
			thisform.grd_ped.Refresh()
		ENDIF
		
	ENDPROC

	PROCEDURE grd_ped.Column1.Text1.Click
		frmplanc= conectar_db(_screen.cn)
			SQLEXEC(frmplanc,"select TRIM(orden_obser) orden_obser from compras where orden_codi = ?cur_planc.orcodi;","cur_obser")
		desconectar_db(frmplanc)
		
		IF RECCOUNT("cur_obser") > 0
			IF LEN(ALLTRIM(cur_obser.orden_obser)) > 0
				thisform.pgf_resum.page2.edt_obser.Value = ALLTRIM(cur_obser.orden_obser)
			ELSE
				thisform.pgf_resum.page2.edt_obser.Value = ""

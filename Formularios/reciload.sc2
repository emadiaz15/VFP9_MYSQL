	PROCEDURE Activate
		if codicli=0
			thisform.release
		endif
	ENDPROC

	PROCEDURE Init
		parameter codicli
		public cond,i,codirec,postal,provi,locali
		
		LOCAL xtcomp,xncomp
		STORE '' TO xtcomp,xncomp
		
		*!*	create cursor recfac(fecha D,fac_codi N(8),impag N(10,2),parcial L)
		*!*	create cursor recsini(fecha D,sini_cod N(8),impag N(10,2),parcial L)
		*!*	create cursor recfacsini(fecha D,fac_codi N(8),sini_cod N(8),impag N(10,2),parcial L)
		
		create cursor fac(fac_conc C(1),fac_tipo C(1),fac_pto N(4),fac_nro N(8),fac_fec D,imp_pag N(10,2))
		create cursor siv(sini_cod N(8),sini_fech D,recsini_imp N(15,2))
		create cursor div(debv_codi N(8),debv_fech D,debv_impag N(15,2))
		create cursor civ(debc_codi N(8),debc_fech D,debc_impag N(15,2))
		create cursor facsiv(tcomp C(3),ncomp C(13),facsiv_fec D,facsiv_imp N(15,2))
		
		postal=0
		provi=""
		locali=""
		set date british
		set cent on
		set dele on
		if codicli=0
			do form cliload with codicli,postal,provi,locali
			cond=cond_codi
			WITH thisform
				.text1.value=cur_clie.cli_nomb
				.text2.value=cur_clie.cli_domi
				.text6.value=cur_clie.cond_desc
				.text12.value=cur_clie.cli_cuit
				.text3.value=cur_clie.cp_nro
				.text4.value=cur_clie.loca_nomb
				.text5.value=cur_clie.provi_nomb
			ENDWITH
		else
			frmremlo= conectar_db(_screen.cn)
				SQLEXEC(frmremlo,"call usp_buscarcli(?codicli);","cur_clie")
			desconectar_db(frmremlo)
			WITH thisform
				.text1.value=cur_clie.cli_nomb
				.text2.value=cur_clie.cli_domi
				.text6.value=cur_clie.cond_desc
				.text12.value=cur_clie.cli_cuit
				.text3.value=cur_clie.cp_nro
				.text4.value=cur_clie.loca_nomb
				.text5.value=cur_clie.provi_nomb
			ENDWITH
		ENDIF
		frmreclo= conectar_db(_screen.cn)
			SQLEXEC(frmreclo,"select CONCAT('  ',CAST(rec_tipo AS CHAR)),CONCAT('  ',CAST(rec_nro AS CHAR)),rec_fec,rec_codi,cli_codi from recibos where cli_codi=?codicli order by rec_fec desc;","cur_rl") 
		desconectar_db(frmreclo)
		WITH thisform
			IF RECCOUNT("cur_rl")>0
				thisform.lst_recilo.RowSource="cur_rl"
				codirec=cur_rl.rec_codi
				local paso
				paso=0
				.grid1.rows=1
				frmreclo= conectar_db(_screen.cn)
					SQLEXEC(frmreclo,"select b.fac_conc,b.fac_tipo,b.fac_pto,b.fac_nro,b.fac_fec,a.recfac_impo from recibos_facturas a inner join facturas b on a.fac_codi=b.fac_codi where a.rec_codi=?codirec;","fac")
					SQLEXEC(frmreclo,"select b.sini_cod,b.sini_fech,a.recsini_imp from recibos_saldosiniciales a inner join saldosiniciales b on a.sini_cod=b.sini_cod where a.rec_codi=?codirec;","siv")
					SQLEXEC(frmreclo,"select b.debv_codi,b.debv_fech,a.recdebi_imp from recibos_debintv a inner join debintv b on a.debv_codi=b.debv_codi where a.rec_codi=?codirec;","div")
					SQLEXEC(frmreclo,"select b.crev_codi,b.crev_fech,a.reccrei_imp from recibos_creintv a inner join creintv b on a.crev_codi=b.crev_codi where a.rec_codi=?codirec;","civ")
				desconectar_db(frmreclo)
				if RECCOUNT("fac")+RECCOUNT("siv")+RECCOUNT("div")>0++RECCOUNT("civ")>0
					sele fac
					go top
					SCAN
						xtcomp= ICASE(fac.fac_conc="N","NC"+ALLTRIM(fac.fac_tipo), ;
									  fac.fac_conc="D","ND"+ALLTRIM(fac.fac_tipo), ;
									  "F"+ALLTRIM(fac.fac_tipo))
						xncomp= ALLTRIM(REPLICATE("0",4-LEN(ALLTRIM(STR(fac.fac_pto))))+ALLTRIM(STR(fac.fac_pto))+"-"+;
										REPLICATE("0",8-LEN(ALLTRIM(STR(fac.fac_nro))))+ALLTRIM(STR(fac.fac_nro)))
						insert into facsiv(tcomp,ncomp,facsiv_fec,facsiv_imp) ;
									values(xtcomp,xncomp,fac.fac_fec,fac.recfac_impo)
					endscan
					sele siv
					go top
					SCAN
						xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(siv.sini_cod))))+ALLTRIM(STR(siv.sini_cod)))
						insert into facsiv(tcomp,ncomp,facsiv_fec,facsiv_imp) ;
									values("SIV",xncomp,siv.sini_fech,siv.recsini_imp)
					ENDSCAN
					sele div
					go top
					SCAN
						xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(div.debv_codi))))+ALLTRIM(STR(div.debv_codi)))
						insert into facsiv(tcomp,ncomp,facsiv_fec,facsiv_imp) ;
									values("DIV",xncomp,div.debv_fech,div.recdebi_imp)
					ENDSCAN
					sele civ
					go top
					SCAN
						xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(civ.crev_codi))))+ALLTRIM(STR(civ.crev_codi)))
						insert into facsiv(tcomp,ncomp,facsiv_fec,facsiv_imp) ;
									values("CIV",xncomp,civ.crev_fech,civ.reccrei_imp)
					endscan
					
					sele facsiv
					index on facsiv_fec to SYS(2015)
					LOCATE
					
					SCAN
						.grid1.additem(tcomp+chr(9)+ncomp+chr(9)+dtoc(facsiv_fec)+CHR(9)+TRANSFORM(facsiv_imp, "$ 999,999,999.99"))
					ENDSCAN
				endif
				thisform.lst_recilo.Selected(1)=.T.
				thisform.command2.enabled=.T.			
			ENDIF
		endwith
		
	ENDPROC

	PROCEDURE Command1.Click
		local paso
		paso=0
		thisform.grid1.rows=1
		SET SAFETY off
		SELECT fac
		ZAP
		SELECT siv
		ZAP
		SELECT div
		ZAP
		SELECT facsiv
		ZAP
		SET SAFETY on
		do form cliload with codicli
		WITH thisform
			.text1.value=cur_clie.cli_nomb
			.text2.value=cur_clie.cli_domi
			.text6.value=cur_clie.cond_desc
			.text12.value=cur_clie.cli_cuit
			.text3.value=cur_clie.cp_nro
			.text4.value=cur_clie.loca_nomb
			.text5.value=cur_clie.provi_nomb
		ENDWITH
		cond=cur_clie.cond_codi
		frmreclo= conectar_db(_screen.cn)
			SQLEXEC(frmreclo,"select CONCAT('  ',CAST(rec_tipo AS CHAR)),CONCAT('  ',CAST(rec_nro AS CHAR)),rec_fec,rec_codi,cli_codi from recibos where cli_codi=?codicli order by rec_fec desc;","cur_rl")
		desconectar_db(frmreclo)
		WITH thisform
			IF RECCOUNT()>0
				thisform.lst_recilo.RowSource="cur_rl"
				codirec=cur_rl.rec_codi
				frmreclo= conectar_db(_screen.cn)
					SQLEXEC(frmreclo,"select b.fac_conc,b.fac_tipo,b.fac_pto,b.fac_nro,b.fac_fec,a.recfac_impo from recibos_facturas a inner join facturas b on a.fac_codi=b.fac_codi where a.rec_codi=?codirec;","fac")
					SQLEXEC(frmreclo,"select b.sini_cod,b.sini_fech,a.recsini_imp from recibos_saldosiniciales a inner join saldosiniciales b on a.sini_cod=b.sini_cod where a.rec_codi=?codirec;","siv")
					SQLEXEC(frmreclo,"select b.debv_codi,b.debv_fech,a.recdebi_imp from recibos_debintv a inner join debintv b on a.debv_codi=b.debv_codi where a.rec_codi=?codirec;","div")
				desconectar_db(frmreclo)
				if RECCOUNT("fac")+RECCOUNT("siv")+RECCOUNT("div")>0
		
					sele fac
					go top
					SCAN
						xtcomp= ICASE(fac.fac_conc="N","NC"+ALLTRIM(fac.fac_tipo), ;
									  fac.fac_conc="D","ND"+ALLTRIM(fac.fac_tipo), ;
									  "F"+ALLTRIM(fac.fac_tipo))
						xncomp= ALLTRIM(REPLICATE("0",4-LEN(ALLTRIM(STR(fac.fac_pto))))+ALLTRIM(STR(fac.fac_pto))+"-"+;
										REPLICATE("0",8-LEN(ALLTRIM(STR(fac.fac_nro))))+ALLTRIM(STR(fac.fac_nro)))
						insert into facsiv(tcomp,ncomp,facsiv_fec,facsiv_imp) ;
									values(xtcomp,xncomp,fac.fac_fec,fac.recfac_impo)
					endscan
					sele siv
					go top
					SCAN
						xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(siv.sini_cod))))+ALLTRIM(STR(siv.sini_cod)))
						insert into facsiv(tcomp,ncomp,facsiv_fec,facsiv_imp) ;
									values("SIV",xncomp,siv.sini_fech,siv.recsini_imp)
					ENDSCAN
					sele div
					go top
					SCAN
						xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(div.debv_codi))))+ALLTRIM(STR(div.debv_codi)))
						insert into facsiv(tcomp,ncomp,facsiv_fec,facsiv_imp) ;
									values("DIV",xncomp,div.debv_fech,div.recdebi_imp)
					endscan
					sele facsiv
					index on facsiv_fec to SYS(2015)
					LOCATE
					
					SCAN
						.grid1.additem(tcomp+chr(9)+ncomp+chr(9)+dtoc(facsiv_fec)+CHR(9)+TRANSFORM(facsiv_imp, "$ 999,999,999.99"))
					ENDSCAN
				endif
				thisform.lst_recilo.Selected(1)=.T.
				thisform.command2.enabled=.T.		
				thisform.lst_recilo.SetFocus	
			ENDIF
		endwith
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command2.Click
		codirec=cur_rl.rec_codi
		cond=cur_clie.cond_codi
		do form consrecibo with codirec,cond
		thisform.release
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE lst_recilo.Click
		local paso
		paso=0
		WITH thisform
			.grid1.rows=1
			SET SAFETY off
			SELECT fac
			ZAP
			SELECT siv
			ZAP
			SELECT div
			ZAP
			SELECT facsiv
			ZAP
			SET SAFETY on
			codirec=cur_rl.rec_codi
			frmreclo= conectar_db(_screen.cn)
				SQLEXEC(frmreclo,"select b.fac_conc,b.fac_tipo,b.fac_pto,b.fac_nro,b.fac_fec,a.recfac_impo from recibos_facturas a inner join facturas b on a.fac_codi=b.fac_codi where a.rec_codi=?codirec;","fac")
				SQLEXEC(frmreclo,"select b.sini_cod,b.sini_fech,a.recsini_imp from recibos_saldosiniciales a inner join saldosiniciales b on a.sini_cod=b.sini_cod where a.rec_codi=?codirec;","siv")
				SQLEXEC(frmreclo,"select b.debv_codi,b.debv_fech,a.recdebi_imp from recibos_debintv a inner join debintv b on a.debv_codi=b.debv_codi where a.rec_codi=?codirec;","div")
				SQLEXEC(frmreclo,"select b.crev_codi,b.crev_fech,a.reccrei_imp from recibos_creintv a inner join creintv b on a.crev_codi=b.crev_codi where a.rec_codi=?codirec;","civ")
			desconectar_db(frmreclo)
			if RECCOUNT("fac")+RECCOUNT("siv")+RECCOUNT("div")>0+RECCOUNT("civ")>0
		
				sele fac
				go top
				SCAN
					xtcomp= ICASE(fac.fac_conc="N","NC"+ALLTRIM(fac.fac_tipo), ;
								  fac.fac_conc="D","ND"+ALLTRIM(fac.fac_tipo), ;
								  "F"+ALLTRIM(fac.fac_tipo))
					xncomp= ALLTRIM(REPLICATE("0",4-LEN(ALLTRIM(STR(fac.fac_pto))))+ALLTRIM(STR(fac.fac_pto))+"-"+;
									REPLICATE("0",8-LEN(ALLTRIM(STR(fac.fac_nro))))+ALLTRIM(STR(fac.fac_nro)))
					insert into facsiv(tcomp,ncomp,facsiv_fec,facsiv_imp) ;
								values(xtcomp,xncomp,fac.fac_fec,fac.recfac_impo)
				endscan
				sele siv
				go top
				SCAN
					xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(siv.sini_cod))))+ALLTRIM(STR(siv.sini_cod)))
					insert into facsiv(tcomp,ncomp,facsiv_fec,facsiv_imp) ;
								values("SIV",xncomp,siv.sini_fech,siv.recsini_imp)
				ENDSCAN
				sele div
				go top
				SCAN
					xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(div.debv_codi))))+ALLTRIM(STR(div.debv_codi)))
					insert into facsiv(tcomp,ncomp,facsiv_fec,facsiv_imp) ;
								values("DIV",xncomp,div.debv_fech,div.recdebi_imp)
				ENDSCAN
				sele civ
				go top
				SCAN
					xncomp= ALLTRIM("0000-"+REPLICATE("0",8-LEN(ALLTRIM(STR(civ.crev_codi))))+ALLTRIM(STR(civ.crev_codi)))
					insert into facsiv(tcomp,ncomp,facsiv_fec,facsiv_imp) ;
								values("CIV",xncomp,civ.crev_fech,civ.reccrei_imp)
				ENDSCAN
						
				sele facsiv
				index on facsiv_fec to SYS(2015)
				LOCATE
				
				SCAN
					.grid1.additem(tcomp+chr(9)+ncomp+chr(9)+dtoc(facsiv_fec)+CHR(9)+TRANSFORM(facsiv_imp, "$ 999,999,999.99"))
				ENDSCAN
			endif
			.command2.enabled=.T.
		ENDWITH
		
	ENDPROC

	PROCEDURE lst_recilo.KeyPress
		&& reciload.lst_recibo.keypress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = 13
			THIS.Click()
		
			IF THISFORM.Command2.Enabled
				THISFORM.Command2.Click()
			ENDIF
		
			NODEFAULT
		ENDIF
	ENDPROC

	PROCEDURE Text1.GotFocus
		*!*	if codicli<>0
		*!*		with thisform
		*!*			.text1.value=cli_nomb
		*!*			.text2.value=cli_domi
		*!*			.text6.value=condiva.cond_desc
		*!*			.text12.value=cli_cuit
		*!*			.text3.value=codipostales.cp_nro
		*!*			.text4.value=localidades.loca_nomb
		*!*			.text5.value=provincias.provi_nomb
		*!*			.list1.rowsourcetype=3
		*!*			.list1.rowsource="select '  '+allt(str(rec_tipo)),rec_nro,rec_fec,rec_codi from recibos where cli_codi=codicli order by rec_fec desc INTO CURSOR list1"
		*!*		endwith
		*!*	endif
		
	ENDPROC

ENDDEFINE

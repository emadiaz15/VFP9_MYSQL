	PROCEDURE Destroy
		set skip of bar 5 of Modificaci .F.
		
	ENDPROC

	PROCEDURE Init
		public codigo,nombre
		codigo=0
		
		frmmodart= conectar_db(_screen.cn)
			SQLEXEC(frmmodart,"select * from iva order by iva_codi desc limit 1;","cur_ivact")
		desconectar_db(frmmodart)
		this.combo1.additem(allt(str(cur_ivact.iva_1,10,2))+"%",1)
		this.combo1.additem(allt(str(cur_ivact.iva_2,10,2))+"%",2)
	ENDPROC

	PROCEDURE Load
		set skip of bar 5 of Modificaci .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if prompt()<>"Datos Artículos"
		*!*		set skip of bar 5 of Modificaci .F.
		*!*		thisform.hide
		*!*	endif
	ENDPROC

	PROCEDURE Combo1.Click
		KEYBOARD '{TAB}'
	ENDPROC

	PROCEDURE Commandgroup1.Command1.Click
		thisform.commandgroup1.command2.enabled=.F.
		do form artload with codigo,nombre
		if codigo>0
			with thisform
				if art_codi>5
					.text1.value=cur_art.art_codi
					.text2.readonly=.F.
					.text2.value=cur_art.art_desc
					.text3.value=cur_art.art_precio
					do case
						case cur_art.art_med="UN"
							.optiongroup1.value=1
						case cur_art.art_med="MT"
							.optiongroup1.value=2
						case cur_art.art_med="KG"
							.optiongroup1.value=3
					ENDCASE
					do case
						case cur_art.art_alicuota=1
							.combo1.value=allt(str(cur_ivact.iva_1,10,2))+"%"
						case cur_art.art_alicuota=2
							.combo1.value=allt(str(cur_ivact.iva_2,10,2))+"%"
					endcase
					.commandgroup1.command2.enabled=.T.
					.text2.setfocus
				else
					messagebox("Este código se utiliza para artículos sin código."+chr(13)+ ;
				               "No hay datos para modificar.",0+64,"Información")
				    .text1.value=0
					.text1.setfocus
				endif
			endwith
		endif
	ENDPROC

	PROCEDURE Commandgroup1.Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Commandgroup1.Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Commandgroup1.Command2.Click
		LOCAL xdesc,xprec,xmed,xali,conexterna
		with thisform
			xdesc=ALLTRIM(.text2.value)
			xprec=.text3.value
			do case
				case .optiongroup1.value=1
					xmed="UN"
				case .optiongroup1.value=2
					xmed="MT"
				case .optiongroup1.value=3
					xmed="KG"
			ENDCASE
			do case
				case ConverNro(.combo1.value)=cur_ivact.iva_1
					xali=1
				case ConverNro(.combo1.value)=cur_ivact.iva_2
					xali=2
			endcase
			frmmodart= conectar_db(_screen.cn)
				SQLEXEC(frmmodart,"update articulos set art_desc=?xdesc,art_precio=?xprec,art_med=?xmed,art_alicuota=?xali where art_codi=?codigo;")
			desconectar_db(frmmodart)
			********************* SE CONECTA AL SERVIDOR ILUMET Y ACTUALIZA LOS DATOS DEL ARTÍCULO *************************
			conexterna = conectar_db(_screen.xconext)
			IF VARTYPE(conexterna)="N" AND conexterna>0
				SQLEXEC(conexterna,"update articulos set art_desc=?xdesc,art_precio=?xprec,art_med=?xmed,art_alicuota=?xali where art_codi=?codigo;")
				desconectar_db(conexterna)
			ENDIF
			********************** FIN PROCESO SERVIDOR ILUMET **************************************	
			.text1.value=0
			.text2.readonly=.T.
			.text2.value=""
			.text3.value=0
			this.enabled=.F.
			.optiongroup1.value=1
			.text1.setfocus
		endwith
		
	ENDPROC

	PROCEDURE Commandgroup1.Command2.GotFocus
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Commandgroup1.Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Commandgroup1.Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Commandgroup1.Command3.Click
		thisform.release
	ENDPROC

	PROCEDURE Commandgroup1.Command3.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Commandgroup1.Command3.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE Optiongroup1.Option1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Optiongroup1.Option2.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Optiongroup1.Option3.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.Valid
		if this.value<>0
			frmmodart= conectar_db(_screen.cn)
				SQLEXEC(frmmodart,"select * from articulos where art_codi=?this.value;","cur_art")
			desconectar_db(frmmodart)
			if RECCOUNT("cur_art")>0
				if art_codi>5
					thisform.text2.value=cur_art.art_desc
					thisform.text3.value=cur_art.art_precio
					do case
						case cur_art.art_med="UN"
							thisform.optiongroup1.value=1
						case cur_art.art_med="MT"
							thisform.optiongroup1.value=2
						case cur_art.art_med="KG"
							thisform.optiongroup1.value=3
					endcase
					do case
						case cur_art.art_alicuota=1
							thisform.combo1.value=allt(str(cur_ivact.iva_1,10,2))+"%"
						case cur_art.art_alicuota=2
							thisform.combo1.value=allt(str(cur_ivact.iva_2,10,2))+"%"
					endcase
					thisform.commandgroup1.command2.enabled=.T.
					thisform.text2.readonly=.F.
				else
					messagebox("Este código se utiliza para artículos sin código."+chr(13)+ ;
					           "No hay datos para modificar.",0+64,"Información")
					this.value=0
					return 0
				endif
			else
				messagebox("Artículo no está en archivo",0+48,"Advertencia")
				this.value=0
				return 0
			endif
		endif
	ENDPROC

	PROCEDURE Text2.GotFocus
		capslock(.T.)
		if !this.click()
			thisform.text1.setfocus
		endif
	ENDPROC

	PROCEDURE Text2.LostFocus
		capslock(.F.)
	ENDPROC

ENDDEFINE

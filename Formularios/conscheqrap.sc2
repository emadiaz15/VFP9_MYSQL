	PROCEDURE Destroy
		set point to
		set separator to
	ENDPROC

	PROCEDURE Init
		Parameter xcodpag, xtipo
		public rpgc,sucbcc
		LOCAL xcadecheq, xtiprov
		rpgc=0
		set point to ","
		set separator to "."
		set date british
		set cent on
		if xcodpag>0
		*!*		IF USED("cur_deposito")
		*!*			USE IN cur_deposito
		*!*		ENDIF
		*!*		xcadecheq=allt(subst(chnro,1,3))+allt(subst(chnro,4,3))
			frmconch= conectar_db(_screen.cn)
		*!*			xcadechlo=ALLTRIM(chnro)+ALLTRIM(chid)
				SQLEXEC(frmconch,"select a.*,b.ban_desc,b.ban_cuit from recibos_pagos a inner join bancos b on a.ban_codi=b.ban_codi where a.recpag_codi=?xcodpag;","cur_cheq")
				xtiprov = ICASE(cur_cheq.pag_codi>0,1,cur_cheq.pagg_codi>0,2,cur_cheq.pag_codi=0 and cur_cheq.pagg_codi=0,0)
				xcadecheq=allt(subst(cur_cheq.chequenro,1,3))+allt(subst(cur_cheq.chequenro,4,3))
				SQLEXEC(frmconch,"select a.rec_tipo,a.rec_nro,a.rec_fec,b.cli_nomb from recibos a inner join clientes b on a.cli_codi=b.cli_codi where rec_codi=?cur_cheq.rec_codi;","recicli")
				DO case
					CASE xtiprov = 1
						SQLEXEC(frmconch,"select a.pag_fech,b.prov_nomb from pagosprov a inner join proveedores b on a.prov_codi=b.prov_codi where pag_codi=?cur_cheq.pag_codi;","cur_pagocheq")
					CASE xtiprov = 2
						SQLEXEC(frmconch,"select a.pagg_fech,b.per_desc from pagosgas a inner join personas b on a.per_codi=b.per_codi where pagg_codi=?cur_cheq.pagg_codi;","cur_pagocheq")
				ENDCASE
				SQLEXEC(frmconch,"select suc_nomb from sucbancos where TRIM(suc_bansuc)=?xcadecheq;","sucu")
			desconectar_db(frmconch)
			with thisform
				rpgc=xcodpag
				this.Caption=ICASE(xtipo=1,"Consulta Rápida de Cheques",xtipo=2,"Consulta Rápida de Echeqs")
				thisform.label11.Caption=ICASE(xtipo=1,"Datos del Cheque",xtipo=2,"Datos del Echeq")
				thisform.label1.Caption=ICASE(xtipo=1,"Cheque Número:",xtipo=2,"Echeq Número:")
				thisform.text1.Format=ICASE(xtipo=1,"R",xtipo=2,"")
				thisform.text1.InputMask=ICASE(xtipo=1,"999-999-99999999",xtipo=2,"")
				.text1.value=cur_cheq.chequenro
				.text2.value=allt(cur_cheq.ban_desc)
				.text3.value=cur_cheq.movtippag_imp
				.text4.value=cur_cheq.movtippag_fvto
				.text5.value=recicli.cli_nomb
				.text6.value=allt(str(recicli.rec_tipo)+"-"+allt(str(recicli.rec_nro)))
				.text7.value=recicli.rec_fec
				DO CASE
					CASE xtiprov = 1
						.text8.value=cur_pagocheq.prov_nomb
						.text10.value=cur_pagocheq.pag_fech
						.text9.value=cur_cheq.pag_codi
						thisform.xbanco  = ''
						thisform.xboleta = ''
						thisform.xfecdep = CTOD("  /  /    ")				
					CASE xtiprov = 2
						.text8.value=cur_pagocheq.per_desc
						.text10.value=cur_pagocheq.pagg_fech
						.text9.value=cur_cheq.pagg_codi
						thisform.label9.Caption="Orden de Pago Nº: GS"
						thisform.xbanco  = ''
						thisform.xboleta = ''
						thisform.xfecdep = CTOD("  /  /    ")				
					CASE cur_cheq.dep_codi>0
						frmconch= conectar_db(_screen.cn)
							SQLEXEC(frmconch,"select b.banc_desc,a.dep_bolnro,a.dep_fech from depositos a inner join bancos_caja b on a.banc_codi = b.banc_codi;","cur_deporap")
						desconectar_db(frmconch)
						.text8.value=cur_deporap.banc_desc
						.text10.value=cur_deporap.dep_fech 
						.text9.value=cur_deporap.dep_bolnro		
						.label7.Caption="Depositado en Banco:"
						.label9.Caption="Boleta Nº:"
						.label10.Caption="Fecha Depósito:"
						STORE RGB(255,0,0) TO .label7.ForeColor,.label9.ForeColor,.label10.ForeColor
						thisform.xbanco  = cur_deporap.banc_desc
						thisform.xboleta = cur_deporap.dep_bolnro
						thisform.xfecdep = cur_deporap.dep_fech
				OTHERWISE
					thisform.xbanco  = ''
					thisform.xboleta = ''
					thisform.xfecdep = CTOD("  /  /    ")					
				ENDCASE			
				.text12.value=VAL(cur_cheq.cuit_lib)
				.text11.value=sucu.suc_nomb
				sucbcc=sucu.suc_nomb
				.command2.enabled=.T.
			endwith
		endif
	ENDPROC

	PROCEDURE Command1.Click
		*!*	IF USED("cur_pagocheq")
		*!*		USE IN cur_pagocheq
		*!*	ENDIF
		
		thisform.release
	ENDPROC

	PROCEDURE Command1.GotFocus
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Command2.Click
		SELECT cur_cheq
		LOCATE
		
		report form chequerap for cur_cheq.recpag_codi=rpgc TO PRINTER PROMPT noconsole
	ENDPROC

	PROCEDURE Command2.GotFocus
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Command2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE Command2.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

ENDDEFINE

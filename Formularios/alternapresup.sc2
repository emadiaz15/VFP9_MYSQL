	PROCEDURE Activate
		on key
		store 1 to localiz,muestro
		if paso=1
			with this
				if modiarc=0
					.text1.value=dato1
					IF dato1>5
						.text3.value=dato3
						.text3.Visible= .T.
						.edit1.Visible= .F.
					ELSE
						.edit1.Value=dato3
						.edit1.Visible= .T.
						.text3.Visible= .F.
					ENDIF
					.text4.value=ConverNro(dato4)
					.SetAll("Format", "K", "Textbox")
				endif
			endwith
		endif
	ENDPROC

	PROCEDURE calc_meses
		LPARAMETERS ndias
		
		LOCAL nmeses
		
		nmeses = ndias / 30
		
		thisform.lbl_diascosto.ToolTipText='Cantidad de días equivale a '+ALLTRIM(STR(nmeses,6,1))+' meses'
		
		RETURN
	ENDPROC

	PROCEDURE Destroy
		&&Cerrar_cursores()
	ENDPROC

	PROCEDURE dias_actcosto
		LPARAMETERS tnArtCodi
		
		LOCAL lnConn
		
		thisform.lbl_diascosto.Caption = ""
		
		IF VARTYPE(tnArtCodi) <> "N" OR tnArtCodi <= 0
			RETURN
		ENDIF
		
		lnConn = conectar_db(_screen.cn)
		
		SQLEXEC(lnConn, ;
		"SELECT " + ;
		"  DATEDIFF(CURDATE(), DATE(hc.histo_fech)) AS dias, " + ;
		"  p.prov_nomb " + ;
		"FROM histocosto hc " + ;
		"INNER JOIN articulos_proveedores ap ON ap.artpro_codi = hc.artpro_codi " + ;
		"INNER JOIN proveedores p ON p.prov_codi = ap.prov_codi " + ;
		"WHERE ap.art_codi = ?tnArtCodi " + ;
		"ORDER BY hc.histo_fech DESC, hc.histo_codi DESC " + ;
		"LIMIT 1;", ;
		"cur_ultcosto")
		
		desconectar_db(lnConn)
		
		IF RECCOUNT("cur_ultcosto") > 0
			thisform.lbl_diascosto.Caption = ;
				ALLTRIM(ALLTRIM(STR(cur_ultcosto.dias)) + " días - Últ. actualización de costo" + CHR(13) + ;
				ALLTRIM(cur_ultcosto.prov_nomb))
			thisform.ndiascosto=cur_ultcosto.dias
		ELSE
			thisform.lbl_diascosto.Caption = "Sin historial de costos"
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE Init
		parameter cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		public modiarc,codiprov,cdd
		cdd=0
		alternati="S"
		modiarc=0
		this.text4.Value=0
		if paso<>1
			this.text1.value=0
		ENDIF
		LOCAL xvend
		xvend=UPPER(substr(sys(0),ATC("#",sys(0))+2))
		frmalter= conectar_db(_screen.cn)
			SQLEXEC(frmalter,"select * from vendedores where TRIM(ven_nomb)=?xvend;","cur_vende")
		desconectar_db(frmalter)
		IF RECCOUNT("cur_vende")>0
			with this
				.command2.visible=.F.
				.command4.visible=.F.
				.label14.visible=.F.
				.label12.visible=.F.
				.label7.visible=.F.
				.label8.visible=.F.
				.label9.visible=.F.
				.label10.visible=.F.
				.label19.visible=.F.
				.label11.visible=.F.
				.label16.visible=.F.
				.label13.visible=.F.
				.label20.visible=.F.
				.shape2.visible=.F.
				.text11.visible=.F.
				.text6.visible=.F.
				.text7.visible=.F.
				.text8.visible=.F.
				.text9.visible=.F.
				.text10.visible=.F.
				.text13.visible=.F.
				.lstcosto.visible=.F.
				.height=155
				.autocenter=.T.
			endwith
		ENDIF
		
		IF WEXIST("modipresup") OR WEXIST("altapresup")
			thisform.btn_cotiz.Visible= .T.
		ENDIF
		
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=27
			thisform.release
		endif
	ENDPROC

	PROCEDURE nboldfila
		LParameters tnsel
		
		Local lnBold
		
			DO case
				CASE tnsel = 1
					lnBold = .T.
				CASE tnsel = 0
					lnBold = .F.
			ENDCASE
		Return(lnBold)
	ENDPROC

	PROCEDURE ncolorfila
		LParameters tnsel
		
		Local lnColor
		
			DO case
				CASE tnsel = 1
					lnColor = RGB(255,0,0)
				CASE tnsel = 0
					lnColor = RGB(0,0,0)
			ENDCASE
		Return(lnColor)
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS tnlp,tncz
		
		LOCAL lnColor
		
		DO CASE 
			CASE tnlp=1 AND tncz=0
				lnColor = RGB(144,238,144)
			CASE tnlp=0 AND tncz=1
				lnColor = RGB(230,240,20)
			CASE tnlp=1 AND tncz=1
				lnColor = RGB(255,211,168)
		OTHERWISE
			lnColor = RGB(255,255,255)
		ENDCASE
		
		return(lnColor)
	ENDPROC

	PROCEDURE Unload
		return codigo
		return descri
		return descrip
		return pruni
	ENDPROC

	PROCEDURE Btn_cotiz.Image1.Click
		THISFORM.AddProperty("oWait")
		
		IF TYPE("THISFORM.oWait") <> "O" OR ISNULL(THISFORM.oWait)   
			THISFORM.oWait = CREATEOBJECT("frmWait", "Procesando información...Espere...")
			THISFORM.oWait.Show()
			DOEVENTS
			INKEY(0.15) && 150 milisegundos para que pinte el label antes de ejecutar la query
			DOEVENTS
		ELSE
			THISFORM.oWait.SetMessage("Procesando información...Espere...")
		ENDIF
		
		LOCAL xarticulo, xcliente, xdescart
		LOCAL xresult, xcQuery
		LOCAL lcTmp, lcDbf
		LOCAL frmaltapr, xreaj, xdolar
		
		SET DATE BRITISH
		SET CENTURY ON
		
		*!*	IF !USED(THISFORM.xcurarpres) OR RECCOUNT(THISFORM.xcurarpres) = 0
		*!*	    RETURN
		*!*	ENDIF
		
		*!*	SELECT (THISFORM.xcurarpres)
		xarticulo = thisform.text1.Value
		xdescart  = LEFT(ALLTRIM(thisform.text3.Value), 60)
		
		IF xarticulo <= 5&& OR ALLTRIM(art_med) = "ALT"
		    MESSAGEBOX("Este ítem no tiene historial de cotización." + CHR(13) + ;
		               "No es un artículo codificado.", 48, "Aviso del Sistema")
		    RETURN
		ENDIF
		
		xcliente = _screen.clientepres
		IF xcliente = 0
		    MESSAGEBOX("No hay cliente seleccionado para el presupuesto.", 48, "Aviso del Sistema")
		    RETURN
		ENDIF
		
		** Limpiar cursores anteriores
		IF USED("cur_ultcotiz")
		    USE IN cur_ultcotiz
		ENDIF
		
		** Obtener parámetro de reajuste
		frmaltapr = conectar_db(_screen.cn)
		SQLEXEC(frmaltapr, "SELECT param_impo FROM parametros WHERE param_codi = 11;", "cur_rjdolar")
		desconectar_db(frmaltapr)
		
		xreaj = (100 - cur_rjdolar.param_impo) / 100
		
		** Query con cálculo de utilidad igual que usp_conspres, Ver si se puede reutilizar!
		TEXT TO xcQuery NOSHOW TEXTMERGE
		SELECT 
		    d.presup_fech, 
		    d.presup_codi, 
		    a.artpres_cant, 
		    ROUND(a.artpres_precio, 3) AS artpres_precio,
		    ROUND(a.artpres_cant * a.artpres_precio, 2) AS total, 
		    d.moneda, 
		    d.cotiz_dolar,
		    IFNULL(ROUND(
		        CASE
		            WHEN (d.moneda = 'D' AND a.artpres_precio > 0) THEN
		                (SELECT ((((IF(f.cond_codi<>2, IF(b.art_alicuota=1, a.artpres_precio/((e.iva_1/100)+1), a.artpres_precio/((e.iva_2/100)+1)), a.artpres_precio) * 
		                    (d.cotiz_dolar * <<xreaj>>) / IF(his.moneda='P', his.histo_costo/d.cotiz_dolar, his.histo_costo)) / d.cotiz_dolar)-1)*100)
		                FROM histocosto his
		                INNER JOIN articulos_proveedores ap ON ap.artpro_codi = his.artpro_codi
		                WHERE ap.art_codi = a.art_codi AND ap.cotiz = 1
		                AND his.histo_costo > 0 
		                AND DATE(his.histo_fech) <= COALESCE(
		                    (SELECT MAX(DATE(h2.histo_fech)) 
		                     FROM histocosto h2 
		                     INNER JOIN articulos_proveedores ap2 ON ap2.artpro_codi = h2.artpro_codi
		                     WHERE ap2.art_codi = a.art_codi AND ap2.cotiz = 1 
		                     AND DATE(h2.histo_fech) <= IFNULL(d.presup_ultact, d.presup_fech)
		                     AND h2.histo_costo > 0),
		                    (SELECT MAX(DATE(h3.histo_fech)) 
		                     FROM histocosto h3 
		                     INNER JOIN articulos_proveedores ap3 ON ap3.artpro_codi = h3.artpro_codi
		                     WHERE ap3.art_codi = a.art_codi AND ap3.cotiz = 1
		                     AND h3.histo_costo > 0)
		                )
		                ORDER BY his.histo_fech DESC LIMIT 1)
		            WHEN (d.moneda = 'P' AND a.artpres_precio > 0) THEN
		                (SELECT ((((IF(his.moneda='D', IF(f.cond_codi<>2, IF(b.art_alicuota=1, a.artpres_precio/((e.iva_1/100)+1), a.artpres_precio/((e.iva_2/100)+1)), a.artpres_precio)
		                    / d.cotiz_dolar, IF(f.cond_codi<>2, IF(b.art_alicuota=1, a.artpres_precio/((e.iva_1/100)+1), a.artpres_precio/((e.iva_2/100)+1)), a.artpres_precio)) * <<xreaj>>) / his.histo_costo)-1)*100)
		                FROM histocosto his
		                INNER JOIN articulos_proveedores ap ON ap.artpro_codi = his.artpro_codi
		                WHERE ap.art_codi = a.art_codi AND ap.cotiz = 1
		                AND his.histo_costo > 0 
		                AND DATE(his.histo_fech) <= COALESCE(
		                    (SELECT MAX(DATE(h2.histo_fech)) 
		                     FROM histocosto h2 
		                     INNER JOIN articulos_proveedores ap2 ON ap2.artpro_codi = h2.artpro_codi
		                     WHERE ap2.art_codi = a.art_codi AND ap2.cotiz = 1 
		                     AND DATE(h2.histo_fech) <= IFNULL(d.presup_ultact, d.presup_fech)
		                     AND h2.histo_costo > 0),
		                    (SELECT MAX(DATE(h3.histo_fech)) 
		                     FROM histocosto h3 
		                     INNER JOIN articulos_proveedores ap3 ON ap3.artpro_codi = h3.artpro_codi
		                     WHERE ap3.art_codi = a.art_codi AND ap3.cotiz = 1
		                     AND h3.histo_costo > 0)
		                )
		                ORDER BY his.histo_fech DESC LIMIT 1)
		            ELSE 0
		        END, 3), 0) AS utilidad,
		        f.cond_codi
		FROM presupuestos_articulos a 
		INNER JOIN articulos b ON a.art_codi = b.art_codi 
		INNER JOIN presupuestos d ON a.presup_codi = d.presup_codi
		INNER JOIN iva e ON d.iva_codi = e.iva_codi
		INNER JOIN clientes f ON d.cli_codi = f.cli_codi
		WHERE d.cli_codi = <<xcliente>> 
		  AND a.art_codi = <<xarticulo>>
		  AND a.alternativa <> 'S'
		ORDER BY d.presup_fech DESC, d.presup_codi DESC;
		ENDTEXT
		
		SET DECIMALS TO 3
		frmaltapr = conectar_db(_screen.cn)
			xresult = SQLEXEC(frmaltapr, xcQuery, "cur_ultcotiz")
		desconectar_db(frmaltapr)
		SET DECIMALS TO
		
		IF xresult < 0 OR !USED("cur_ultcotiz") OR RECCOUNT("cur_ultcotiz") = 0
		    MESSAGEBOX("No hay cotizaciones anteriores para este cliente" + CHR(13) + ;
		               "y este artículo (Cód: " + ALLTRIM(STR(xarticulo)) + ").", 64, "Historial de Cotizaciones")
		    IF USED("cur_ultcotiz")
		        USE IN cur_ultcotiz
		    ENDIF
			IF TYPE("THISFORM.oWait") = "O"
				thisform.oWait.Release
			ENDIF    
		    RETURN
		ENDIF
		
		** Guardar en DBF temporal
		lcTmp = SYS(2023)
		lcDbf = FORCEEXT(ADDBS(lcTmp) + "histo_" + SYS(2015), "dbf")
		
		*!*	IF !PEMSTATUS(THISFORM, "xHistoCotizDbf", 5)
		*!*	    THISFORM.AddProperty("xHistoCotizDbf", "")
		*!*	ENDIF
		*!*	THISFORM.xHistoCotizDbf = lcDbf
		
		SELECT cur_ultcotiz
		COPY TO (lcDbf)
		
		** Abrir formulario
		PUBLIC goHistoCotiz
		
		IF TYPE("goHistoCotiz") = "O" AND !ISNULL(goHistoCotiz)
		    goHistoCotiz.Release()
		ENDIF
		goHistoCotiz = .NULL.
		
		DO FORM frm_histocotiz NAME goHistoCotiz WITH cond LINKED
		
		IF TYPE("goHistoCotiz") <> "O" OR ISNULL(goHistoCotiz)
		    MESSAGEBOX("No se pudo abrir el formulario de historial.", 16, "Error")
		    RETURN
		ENDIF
		
		=goHistoCotiz.ShowWithCursor(lcDbf, xarticulo, xdescart)
		
		IF TYPE("THISFORM.oWait") = "O"
			thisform.oWait.Release
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE chk_todos.Click
		thisform.grd_costos.RecordSource=''
		thisform.grd_costos.Refresh()
		
		SET DECIMALS TO 3
		IF this.Value=1
			frmcualart= conectar_db(_screen.cn)
				SQLEXEC(frmcualart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value order by a.artpro_costo;","cur_costos")
			desconectar_db(frmcualart)
			GO top
			thisform.grd_costos.recordsource="cur_costos"
		ELSE
			frmcualart= conectar_db(_screen.cn)
				SQLEXEC(frmcualart,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.artpro_codi,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?thisform.text1.value and a.otro=0 order by a.artpro_costo;","cur_costos")
			desconectar_db(frmcualart)
			GO top
			thisform.grd_costos.recordsource="cur_costos"
		ENDIF
		SET DECIMALS TO
		
		
	ENDPROC

	PROCEDURE cmd_masdes.img_add.Click
		codiprov=0
		descri=""
		do form diferentesdesc with codicli,codiprov,descri,thisform.text1.value
		if not isblank(descri)
			thisform.text3.value=allt(descri)
		ENDIF
		thisform.text2.SetFocus
		
	ENDPROC

	PROCEDURE Command1.Click
		*thisform.setall("Enabled",.F.,"CommandButton")
		codigo=0
		do form artload with codigo
		if codigo>0
			frmalter= conectar_db(_screen.cn)
				SQLEXEC(frmalter, "select a.*,b.* from articulos a inner join rubros b on a.rub_codi=b.rub_codi where a.art_codi=?codigo;","cur_arti")
			desconectar_db(frmalter)
			thisform.chk_todos.Enabled= .F.
			thisform.chk_todos.Value=0	
			thisform.text7.Style= 0
			thisform.text8.Style= 0
			thisform.text1.value=cur_arti.art_codi
			thisform.text6.value=cur_arti.art_stock
			thisform.text7.value=cur_arti.pedidos
			thisform.text8.value=cur_arti.pedprov
			thisform.text9.value=cur_arti.art_stock+thisform.text8.value-thisform.text7.value
			thisform.text10.value=cur_arti.art_precio
			thisform.text13.value=cur_arti.costo_ultcpra
			thisform.text11.value=cur_arti.rub_desc
			thisform.dias_actcosto(codigo)
			frmalter= conectar_db(_screen.cn)
				SQLEXEC(frmalter,"select param_impo from parametros where param_codi=9;","cur_dolar")
				SQLEXEC(frmalter,"select param_impo from parametros where param_codi=14;","cur_dolarofi")
				SQLEXEC(frmalter,"select param_impo from parametros where param_codi=11;","cur_rjdolar")	
				SQLEXEC(frmalter,"select * from desc_articulos_clientes where artcli_codi = any (select artcli_codi from articulos_clientes where art_codi=?codigo and cli_codi=?codicli);","cur_difdes")
			desconectar_db(frmalter)
			IF RECCOUNT("cur_difdes")>0
				IF _screen.xopvta<>"FA"
					frmcualart= conectar_db(_screen.cn)
						SQLEXEC(frmcualart,"call usp_ultdesvta(?cur_arti.art_codi,?codicli,0,?_screen.xopvta);","cur_udd")
					desconectar_db(frmcualart)
					IF RECCOUNT("cur_udd") > 0
						thisform.text3.value=cur_udd.dac_desc
						cerrar_cursor("cur_udd")
					ENDIF
				ELSE
					thisform.text3.value=cur_arti.art_desc
				ENDIF
				thisform.cmd_masdes.Visible= .T.		
		*!*			codiprov=0
		*!*			descri=""
		*!*			do form diferentesdesc with codicli,codiprov,descri,codigo
		*!*			if not isblank(descri)
		*!*				thisform.text3.value=allt(descri)
		*!*			else
		*!*				thisform.text3.value=cur_arti.art_desc
		*!*			endif
			else
				thisform.text3.value=cur_arti.art_desc
			ENDIF
			frmalter= conectar_db(_screen.cn)
				SQLEXEC(frmalter,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?codigo and a.otro=0 order by a.artpro_costo;","cur_costosalt")
			desconectar_db(frmalter)
			thisform.chk_todos.Enabled= .T.
			GO top	
			thisform.grd_costos.RecordSource="cur_costosalt"
			thisform.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(cur_costosalt.lista,cur_costosalt.cotiz)","Column")
			thisform.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(cur_costosalt.otro)","Column")
			thisform.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(cur_costosalt.otro)","Column")
			LOCAL xdolar,xdolarofi,xreaj,xutil,costmin
		
			xdolar=cur_dolar.param_impo
		*!*		xdolarofi=cur_dolarofi.param_impo
			xdolarofi= IIF(WEXIST("modipresup") OR WEXIST("altapresup"),_screen.dolarpres,cur_dolarofi.param_impo)
			xreaj =ROUND(xdolar*((100-cur_rjdolar.param_impo)/100),3)
			xutil =1+(_screen.utilidad/100)
			
			IF WEXIST("modipresup") OR WEXIST("altapresup")
				IF _screen.monepres='D'
					SELECT IIF(ALLTRIM(moneda)="D",artpro_costo,ROUND(artpro_costo/xdolarofi,3)) as costo ;
							FROM cur_costosalt WHERE cotiz=1 INTO CURSOR calc_costosalt
				ELSE
					SELECT IIF(ALLTRIM(moneda)="P",artpro_costo,ROUND(artpro_costo*xdolarofi,3)) as costo ;
							FROM cur_costosalt WHERE cotiz=1 INTO CURSOR calc_costosalt
				ENDIF
				cerrar_cursor("cur_dolarofi")
			ENDIF
		
			costmin= IIF(RECCOUNT("calc_costosalt")>0,calc_costosalt.costo,0)		
			if paso=0
				if cond=2
					thisform.text4.value=ROUND(costmin*xutil,3)
				ELSE
					thisform.text4.value=ROUND((costmin+costmin*iif(cur_arti.art_alicuota=1,impiva1,impiva2)/100)*xutil,3)
				ENDIF
			ELSE
				modiarc=1
				IF codigo <> dato1
					if cond=2
						thisform.text4.value=ROUND(costmin*xutil,3)
					ELSE
						thisform.text4.value=ROUND((costmin+costmin*iif(cur_arti.art_alicuota=1,impiva1,impiva2)/100)*xutil,3)
					ENDIF
				ENDIF
			ENDIF
			thisform.text4.setfocus
		ELSE
			thisform.text7.Style= 1
			thisform.text8.Style= 1
			thisform.cmd_masdes.Visible= .F.
			thisform.text1.setfocus
		endif
		
		
	ENDPROC


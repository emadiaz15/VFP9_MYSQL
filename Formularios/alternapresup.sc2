	PROCEDURE Command5.Click
		SET POINT TO ","
		codigo=thisform.text1.value
		descri=IIF(codigo>5,ALLTRIM(thisform.text3.value),ALLTRIM(thisform.edit1.Value))
		pruni=allt(STR(thisform.text4.value,10,3))
		SET POINT TO
		if allt(thisform.text3.value)<>allt(cur_arti.art_desc) and codigo<>4 and codigo<>5
			LOCAL lnLock
			lnLock = 0
			frmcualart= conectar_db(_screen.cn)
				SQLEXEC(frmcualart,"select * from articulos_clientes where cli_codi=?codicli and art_codi=?codigo;","cur_arcli")
			desconectar_db(frmcualart)
			IF RECCOUNT("cur_arcli")>0
				if allt(thisform.text3.value)<>allt(cur_arcli.artcli_desc)
					frmcualart= conectar_db(_screen.cn)
						LOCAL xdes
						xdes=allt(thisform.text3.value)
						SQLEXEC(frmcualart,"update articulos_clientes set artcli_desc=?xdes where artcli_codi=?cur_arcli.artcli_codi;")
					desconectar_db(frmcualart)
				endif
				LOCAL xcadena
				xcadena=ALLTRIM(STR(cur_arcli.artcli_codi))+ALLTRIM(descri)
				frmcualart= conectar_db(_screen.cn)
					SQLEXEC(frmcualart,"select * from desc_articulos_clientes where concat(cast(artcli_codi as char),TRIM(dac_desc))=?xcadena;","cur_ddes")
				desconectar_db(frmcualart)
				IF RECCOUNT("cur_ddes")=0
					frmcualart= conectar_db(_screen.cn)
						lnLock = MySQL_LockTables("LOCK", "desc_articulos_clientes WRITE", frmcualart)
						SQLEXEC(frmcualart,"select dac_codi+1 as dac_codi from desc_articulos_clientes order by dac_codi desc limit 1;","cur_nvo")
						SQLEXEC(frmcualart,"insert into desc_articulos_clientes values(?cur_nvo.dac_codi,?cur_arcli.artcli_codi,?descri);")
						lnLock = MySQL_LockTables("UNLOCK", "", frmcualart)
					desconectar_db(frmcualart)
				endif
			ELSE
				frmcualart= conectar_db(_screen.cn)
					lnLock = MySQL_LockTables("LOCK", "articulos_clientes WRITE, desc_articulos_clientes WRITE", frmcualart)
					SQLEXEC(frmcualart,"select artcli_codi+1 as artcli_codi from articulos_clientes order by artcli_codi desc limit 1;","cur_nvo1")
					SQLEXEC(frmcualart,"insert into articulos_clientes values(?cur_nvo1.artcli_codi,?codigo,?codicli,?descri);" )
		
					SQLEXEC(frmcualart,"select dac_codi+1 as dac_codi from desc_articulos_clientes order by dac_codi desc limit 1;","cur_nvo2")
					SQLEXEC(frmcualart,"insert into desc_articulos_clientes values(?cur_nvo2.dac_codi,?cur_nvo1.artcli_codi,?descri);")
					lnLock = MySQL_LockTables("UNLOCK", "", frmcualart)
				desconectar_db(frmcualart)
			endif
		endif
		cerrar_cursor("cur_nvo")
		cerrar_cursor("cur_arcli")
		cerrar_cursor("cur_nvo1")
		cerrar_cursor("cur_nvo2")
		
		thisform.release
	ENDPROC

	PROCEDURE Command5.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
		
	ENDPROC

	PROCEDURE Command5.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
		
	ENDPROC

	PROCEDURE lbl_diascosto.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
		thisform.calc_meses(thisform.ndiascosto)
	ENDPROC

	PROCEDURE Text1.Click
		this.SetFocus
	ENDPROC

	PROCEDURE Text1.GotFocus
		thisform.setall("Enabled",.T.,"CommandButton")
	ENDPROC

	PROCEDURE Text1.Valid
		if this.value<>0
			thisform.chk_todos.Enabled= .F.
			thisform.chk_todos.Value=0
			frmalter= conectar_db(_screen.cn)
				if this.Value<=5
					SQLEXEC(frmalter, "select * from articulos where art_codi=?this.value;","cur_arti")
				else
					SQLEXEC(frmalter, "select a.*,b.* from articulos a inner join rubros b on a.rub_codi=b.rub_codi where a.art_codi=?this.value;","cur_arti")
				endif
			desconectar_db(frmalter)
			IF RECCOUNT("cur_arti")>0
				if cur_arti.art_codi>5
					frmalter= conectar_db(_screen.cn)
						SQLEXEC(frmalter,"select param_impo from parametros where param_codi=9;","cur_dolar")
						SQLEXEC(frmalter,"select param_impo from parametros where param_codi=14;","cur_dolarofi")
						SQLEXEC(frmalter,"select param_impo from parametros where param_codi=11;","cur_rjdolar")
						SQLEXEC(frmalter,"select * from desc_articulos_clientes where artcli_codi = any (select artcli_codi from articulos_clientes where art_codi=?this.value and cli_codi=?codicli);","cur_difdes")
					desconectar_db(frmalter)
					IF RECCOUNT("cur_difdes")>0
						IF _screen.xopvta<>"FA"
							frmcualart= conectar_db(_screen.cn)
								SQLEXEC(frmcualart,"call usp_ultdesvta(?cur_arti.art_codi,?codicli,0,?_screen.xopvta);","cur_udd")
							desconectar_db(frmcualart)
							IF RECCOUNT("cur_udd") > 0
								thisform.text3.value=cur_udd.dac_desc
								cerrar_cursor("cur_udd")
							ENDIF
						ELSE
							thisform.text3.value=cur_arti.art_desc
						ENDIF
						thisform.cmd_masdes.Visible= .T.			
		*!*					codiprov=0
		*!*					descri=""
		*!*					do form diferentesdesc with codicli,codiprov,descri,this.value
		*!*					if not isblank(descri)
		*!*						thisform.text3.value=allt(descri)
		*!*					else
		*!*						thisform.text3.value=cur_arti.art_desc
		*!*					endif
					else
						thisform.text3.value=cur_arti.art_desc
					ENDIF
					frmalter= conectar_db(_screen.cn)
						SQLEXEC(frmalter,"select b.prov_nomb,a.artpro_costo,a.artpro_ctovta,a.moneda,a.lista,a.cotiz,a.otro from articulos_proveedores a inner join proveedores b on a.prov_codi=b.prov_codi where a.art_codi=?this.value  and a.otro=0 order by a.artpro_costo;","cur_costosalt")
					desconectar_db(frmalter)
					thisform.chk_todos.Enabled= .T.
					GO top	
					thisform.grd_costos.RecordSource="cur_costosalt"
					thisform.grd_costos.SetAll("DynamicBackColor","thisform.obtenercolor(cur_costosalt.lista,cur_costosalt.cotiz)","Column")
					thisform.grd_costos.SetAll("DynamicForeColor","Thisform.ncolorfila(cur_costosalt.otro)","Column")
					thisform.grd_costos.SetAll("DynamicFontBold","Thisform.nboldfila(cur_costosalt.otro)","Column")
					
					LOCAL xdolar,xdolarofi,xreaj,xutil,costmin
		
					xdolar=cur_dolar.param_impo
		*!*				xdolarofi=cur_dolarofi.param_impo
					xdolarofi= IIF(WEXIST("modipresup") OR WEXIST("altapresup"),_screen.dolarpres,cur_dolarofi.param_impo)
					xreaj =ROUND(xdolar*((100-cur_rjdolar.param_impo)/100),3)
					xutil =1+(_screen.utilidad/100)
					IF WEXIST("modipresup") OR WEXIST("altapresup")
						IF _screen.monepres='D'
							SELECT IIF(ALLTRIM(moneda)="D",artpro_costo,ROUND(artpro_costo/xdolarofi,3)) as costo ;
									FROM cur_costosalt WHERE cotiz=1 INTO CURSOR calc_costosalt
						ELSE
							SELECT IIF(ALLTRIM(moneda)="P",artpro_costo,ROUND(artpro_costo*xdolarofi,3)) as costo ;
									FROM cur_costosalt WHERE cotiz=1 INTO CURSOR calc_costosalt
						ENDIF
						cerrar_cursor("cur_dolarofi")
					ENDIF
		
					costmin= IIF(RECCOUNT("calc_costosalt")>0,calc_costosalt.costo,0)	
					if paso=0
						if cond=2
							thisform.text4.value=ROUND(costmin*xutil,3)
						ELSE
							thisform.text4.value=ROUND((costmin+costmin*iif(cur_arti.art_alicuota=1,impiva1,impiva2)/100)*xutil,3)
						ENDIF
					ELSE
						IF this.Value <> dato1
							if cond=2
								thisform.text4.value=ROUND(costmin*xutil,3)
							ELSE
								thisform.text4.value=ROUND((costmin+costmin*iif(cur_arti.art_alicuota=1,impiva1,impiva2)/100)*xutil,3)
							ENDIF
						ENDIF
					ENDIF
					thisform.text7.Style= 0
					thisform.text8.Style= 0
					thisform.text6.value=cur_arti.art_stock
					thisform.text7.value=cur_arti.pedidos
					thisform.text8.value=cur_arti.pedprov
					cerrar_cursor("cur_tped")
					cerrar_cursor("cur_tcom")
					thisform.text9.value=cur_arti.art_stock+thisform.text8.value-thisform.text7.value
					thisform.text10.value=cur_arti.art_precio
					thisform.text13.value=cur_arti.costo_ultcpra
					thisform.text11.value=cur_arti.rub_desc
					thisform.dias_actcosto(this.value)
		*!*				frmalter= conectar_db(_screen.cn)
		*!*					SQLEXEC(frmalter,"select a.prov_nomb,CAST(b.artpro_costo AS CHAR),concat('     ',b.moneda) from proveedores a inner join articulos_proveedores b on a.prov_codi=b.prov_codi where b.art_codi=?this.value order by b.artpro_costo;","cur_costos")
		*!*				desconectar_db(frmalter)
		*!*				thisform.lstcosto.rowsource="cur_costos"
					KEYBOARD '{TAB}'+'{TAB}'
				ELSE
					thisform.text3.visible=.F.
					thisform.edit1.visible=.T.
					do form artsincodi with descrip
					thisform.text3.value=descrip
					thisform.edit1.value=descrip
					codigo=1
					thisform.cmd_masdes.Visible= .F.
		*!*				thisform.text4.value=0
				ENDIF
				thisform.command4.enabled=.T.
		*		if paso<>1
		*			thisform.setall("Enabled",.F.,"CommandButton")
		*		endif
			ELSE
				thisform.text7.Style= 1
				thisform.text8.Style= 1
				messagebox("Artículo no está en archivo",0+48,"Advertencia")
				this.value=0
				return 0
			endif
		endif
		
	ENDPROC

	PROCEDURE Text3.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE Text3.LostFocus
		capslock(.F.)
		this.readonly=.T.
		thisform.text4.setfocus
	ENDPROC

	PROCEDURE Text4.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE Text4.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

	PROCEDURE Text7.Click
		codigo=thisform.text1.value
		descri=allt(thisform.text2.value)
		do form pendclirapi with codigo,descri
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text8.Click
		codigo=thisform.text1.value
		descri=allt(thisform.text2.value)
		do form pendprovrapi with codigo,descri
		thisform.text1.setfocus
	ENDPROC

ENDDEFINE


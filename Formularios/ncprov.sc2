	PROCEDURE Text13.Valid
		frmncprov= conectar_db(_screen.cn)
			SQLEXEC(frmncprov,"select * from parametros where TRIM(param_desc)='ULTCIERCOM';","cur_cier")
		desconectar_db(frmncprov)
		if RECCOUNT("cur_cier")>0
			if this.value<=cur_cier.param_fec and this.value<>ctod("  /  /    ")
				=messagebox("Ultima fecha de cierre de Iva Compras "+dtoc(cur_cier.param_fec)+chr(13)+;
							"Imposible ingresar la Nota de "+iif(thisform.optiongroup1.value=1,"Crédito","Débito")+" con esta fecha",0+48,"Advertencia!")
				this.value=ctod("  /  /    ")
				return 0
			endif
		endif
	ENDPROC

	PROCEDURE Text15.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE Text15.LostFocus
		IF LASTKEY()=13 THEN
			with thisform
				.text16.value=IIF(.text18.value>0,(this.value/.text18.value)*100,0)
				.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
			ENDWITH
			thisform.grid1.SetFocus
		ELSE
			NODEFAULT
			this.SetFocus
		ENDIF
	ENDPROC

	PROCEDURE Text16.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text16.LostFocus
		with thisform
			if this.value>0
				.text15.value=(.text18.value*.text16.value)/100
			else
				.text15.value=0
			ENDIF
			.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value		
		endwith	
	ENDPROC

	PROCEDURE Text19.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text19.GotFocus
		public valdto
		valdto=this.value
	ENDPROC

	PROCEDURE Text19.LostFocus
		with thisform
			if this.value<>valdto
				do case
					case this.value=0
						.text17.value=0
						.text18.value=.text8.value
						thisform.impo1=thisform.impo1/((100-valdto)/100)
						thisform.impo2=thisform.impo2/((100-valdto)/100)
						thisform.acun1=thisform.acun1/((100-valdto)/100)
						thisform.acun2=thisform.acun2/((100-valdto)/100)
						thisform.acu1=thisform.acu1/((100-valdto)/100)
						thisform.acu2=thisform.acu2/((100-valdto)/100)
						if cond=2
							.text9.value=.text9.value/((100-valdto)/100)
							.text11.value=.text11.value/((100-valdto)/100)
						ENDIF
						if .text15.value>0
							.text15.value=.text15.value/((100-valdto)/100)
						endif
						if .text20.value>0
							.text20.value=.text20.value/((100-valdto)/100)
						endif				
					otherwise
						.text17.value=(.text8.value*this.value)/100
						.text18.value=.text8.value-.text17.value
						.text24.value=.text24.value+((.text18.value*.text25.value)/100)
						if cond=2
							if valdto>0
								.text9.value=.text9.value/((100-valdto)/100)
								.text11.value=.text11.value/((100-valdto)/100)
							endif
							.text9.value=.text9.value*((100-this.value)/100)
							.text11.value=.text11.value*((100-this.value)/100)
						endif
						if valdto>0
							thisform.impo1=thisform.impo1/((100-valdto)/100)
							thisform.impo2=thisform.impo2/((100-valdto)/100)
							thisform.acun1=thisform.acun1/((100-valdto)/100)
							thisform.acun2=thisform.acun2/((100-valdto)/100)
							thisform.acu1=thisform.acu1/((100-valdto)/100)
							thisform.acu2=thisform.acu2/((100-valdto)/100)
						endif
						thisform.impo1=thisform.impo1*((100-this.value)/100)
						thisform.impo2=thisform.impo2*((100-this.value)/100)
						thisform.acun1=thisform.acun1*((100-this.value)/100)
						thisform.acun2=thisform.acun2*((100-this.value)/100)
						thisform.acu1=thisform.acu1*((100-this.value)/100)
						thisform.acu2=thisform.acu2*((100-this.value)/100)
						if .text15.value>0
							.text15.value=.text15.value*((100-this.value)/100)
						endif
						if .text20.value>0
							.text20.value=.text20.value*((100-this.value)/100)
						endif				
				endcase 
				.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
			endif
		endwith
		*!*	local acuivait
		*!*	acuivait=0
		*!*	with thisform
		*!*		if .optiongroup1.value=2
		*!*			acu=0
		*!*			for i=1 to .grid1.rows-1
		*!*				.grid1.row=i
		*!*				.grid1.col=8
		*!*				if allt(.grid1.text)="X"
		*!*					.grid1.col=6
		*!*					acuivait=acuivait+val(.grid1.text)
		*!*				else
		*!*					.grid1.col=6
		*!*					acu=acu+val(.grid1.text)
		*!*				endif
		*!*			next
		*!*			dtotot=((acu+acuivait)*this.value)/100
		*!*			.text17.value=str(dtotot,10,2)
		*!*			.text18.value=str((acu+acuivait)-dtotot,10,2)
		*!*			.text24.value=str(val(.text18.value)*.text25.value/100,10,2)
		*!*			if cond=2
		*!*				.text9.value=str((acuivait*round((100-this.value)/100,2))*impiva1/100,10,2)
		*!*			endif
		*!*			if .text16.value>0
		*!*				.text15.value=val(str((val(.text18.value)*.text16.value)/100,10,2))
		*!*			endif
		*!*			if .text21.value>0
		*!*				.text20.value=val(str((val(.text18.value)*.text21.value)/100,10,2))
		*!*			endif
		*!*			.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+.text20.value+val(.text11.value),10,2)
		*!*			acu=acu+acuivait
		*!*		else
		*!*			dtotot=acu*this.value/100
		*!*			.text17.value=str(dtotot,10,2)
		*!*			.text18.value=str(acu-dtotot,10,2)
		*!*			.text24.value=str(val(.text18.value)*.text25.value/100,10,2)
		*!*			if cond=2
		*!*				.text9.value=str(val(.text18.value)*impiva1/100,10,2)
		*!*			endif
		*!*			if .text16.value>0
		*!*				.text15.value=val(str((val(.text18.value)*.text16.value)/100,10,2))
		*!*			endif
		*!*			if .text21.value>0
		*!*				.text20.value=val(str((val(.text18.value)*.text21.value)/100,10,2))
		*!*			endif
		*!*			.text10.value=str(val(.text18.value)+val(.text24.value)+val(.text9.value)+.text15.value+.text20.value+val(.text11.value),10,2)
		*!*		endif
		*!*	endwith
	ENDPROC

	PROCEDURE Text20.Click
		this.SetFocus
		
	ENDPROC

	PROCEDURE Text20.LostFocus
		IF LASTKEY()=13 THEN
			with thisform
				.text21.value=IIF(.text18.value>0,(this.value/.text18.value)*100,0)
				.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
			ENDWITH
			thisform.grid1.SetFocus
		ELSE
			NODEFAULT
			this.SetFocus
		ENDIF
	ENDPROC

	PROCEDURE Text21.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text21.LostFocus
		with thisform
			if this.value>0
				.text20.value=(.text18.value*.text21.value)/100
			else
				.text20.value=0
			endif			
			.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
		endwith	
	ENDPROC

	PROCEDURE Text23.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text25.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text25.GotFocus
		PUBLIC valng
		valng=this.value
	ENDPROC

	PROCEDURE Text25.LostFocus
		with thisform
			IF this.Value>0
				IF .text24.value-((.text18.value*valng)/100)>0
					.text24.value=.text24.value-((.text18.value*valng)/100)
				ENDIF
				.text24.value=.text24.value+((.text18.value*this.value)/100)
			ELSE
				IF .text24.value-((.text18.value*valng)/100)>0
					.text24.value=.text24.value-((.text18.value*valng)/100)
				ELSE
					.text24.value=0
				ENDIF
			ENDIF
			.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
		endwith
	ENDPROC

	PROCEDURE Text26.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text7.Valid
		local cadepto,cadenro,xtip,xpto,xfac,xcadebus
		cadepto=""
		cadenro=""
		xtip=allt(thisform.text14.value)
		xpto=allt(str(thisform.text22.value))
		xfac=allt(str(this.value))
		xcadebus=ALLTRIM(STR(codiprov))+xtip+'PTO'+xpto+'NRO'+xfac+iif(thisform.optiongroup1.value=1,'N','D')
		frmncprov= conectar_db(_screen.cn)
			SQLEXEC(frmncprov,"select * from recepciones where concat(CAST(prov_codi as char),TRIM(prov_tipfac),'PTO',TRIM(CAST(prov_pto as char)),'NRO',TRIM(CAST(prov_fac as char)),TRIM(recep_conc))=?xcadebus;","cur_recexis")
		desconectar_db(frmncprov)
		if RECCOUNT("cur_recexis")>0
			cadepto=repl("0",4-len(allt(str(thisform.text22.value))))+allt(str(thisform.text22.value))
			cadenro=repl("0",8-len(allt(str(this.value))))+allt(str(this.value))
			messagebox("La Nota de "+iif(thisform.optiongroup1.value=1,"Crédito","Débito")+" Nº: "+allt(thisform.text14.value)+" "+cadepto+" - "+cadenro+" de "+allt(cur_prov.prov_nomb)+" ya esta en archivo. Imposible ingresarla nuevamente",0+48,"Advertencia")
		*	this.value=0
			return 0
		endif
	ENDPROC

ENDDEFINE

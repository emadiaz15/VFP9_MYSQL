		           "acu1: "+ALLTRIM(STR(thisform.acu1,15,2))+CHR(13)+ ;
		           "acu2: "+ALLTRIM(STR(thisform.acu2,15,2))+CHR(13)+ ;
		           "acun1: "+ALLTRIM(STR(thisform.acun1,15,2))+CHR(13)+ ;
		           "acun2: "+ALLTRIM(STR(thisform.acun2,15,2))+CHR(13)+ ;
		           "impo1: "+ALLTRIM(STR(thisform.impo1,15,2))+CHR(13)+ ;
		           "impo2: "+ALLTRIM(STR(thisform.impo2,15,2)),16,"Acumuladores")
	ENDPROC


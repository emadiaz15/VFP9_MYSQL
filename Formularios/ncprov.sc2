		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Activate
		opcion=0
		valorcadena=thisform.valorcadena
		on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		set exact on
		if codigo=0
			muestro=0
		ENDIF
		
		if muestro=1
			with thisform
				frmncprov= conectar_db(_screen.cn)
					SQLEXEC(frmncprov,"select * from articulos where art_codi=?codigo;","cur_arti")
				desconectar_db(frmncprov)
				localiz=1
				if paso=1
					.grid1.col=0
					.grid1.text=allt(str(aux))
					.grid1.col=1
					.grid1.text=allt(cant)
					.grid1.col=2
					.grid1.text=cur_arti.art_med
					.grid1.col=3
					cadena=repl("0",8-len(allt(str(codigo))))+allt(str(codigo))
					.grid1.text=cadena
					.grid1.col=4
					if codigo=4 OR codigo=5
						.grid1.text=allt(descrip)
					else
						.grid1.text=allt(descri)
					endif
					.grid1.col=5
					.grid1.text=allt(pruni)
					if .check1.value=1
						.grid1.col=7
						.grid1.text="SS"
					endif
					.grid1.col=6
					if auximpo<>ConverNro(prtot)
						pregciva=messagebox("¿Calcula Iva para este Item?",4+48+0,"Advertencia")
						IF pregciva=6
							.grid1.col=9
							DO case
								CASE ALLTRIM(.grid1.text)='X'
									.grid1.col=6
		*!*								thisform.acu=thisform.acu-ConverNro(.grid1.text)
									thisform.acu=thisform.acu-auximpo
									.grid1.text=prtot
									if .text19.value>0
										auxiva=auxiva*((100-.text19.value)/100)
										auximpo=auximpo*((100-.text19.value)/100)
									ENDIF
									do case
										case cur_arti.art_alicuota=1 AND auxalic=impiva1
											thisform.impo1=thisform.impo1-auximpo
											if cond=2
												.text9.value=.text9.value-auxiva
											endif
										case cur_arti.art_alicuota=1 AND auxalic=impiva2
											thisform.impo2=thisform.impo2-auximpo
											if cond=2
												.text11.value=.text11.value-auxiva
											endif
										case cur_arti.art_alicuota=2 AND auxalic=impiva2
											thisform.impo2=thisform.impo2-auximpo
											if cond=2
												.text11.value=.text11.value-auxiva
											ENDIF
										case cur_arti.art_alicuota=2 AND auxalic=impiva1
											thisform.impo1=thisform.impo1-auximpo
											if cond=2
												.text9.value=.text9.value-auxiva
											endif
									ENDCASE
									thisform.acu=thisform.acu+ConverNro(prtot)
								CASE ALLTRIM(.grid1.text)=''
									.grid1.text=prtot
									.grid1.col=6
									.text24.value=.text24.value-IIF(.text19.value>0,ConverNro(.grid1.text)*((100-.text19.value)/100),ConverNro(.grid1.text))
									thisform.acu=thisform.acu+ConverNro(prtot)
							ENDCASE
						ELSE
							.grid1.col=9
							DO case
								CASE ALLTRIM(.grid1.text)='X'
									.grid1.text=''
									.grid1.col=6
									thisform.acu=thisform.acu-ConverNro(.grid1.text)
									.grid1.text=prtot
									if .text19.value>0
										auxiva=auxiva*((100-.text19.value)/100)
										auximpo=auximpo*((100-.text19.value)/100)
									ENDIF
									do case
										case cur_arti.art_alicuota=1	
											thisform.impo1=thisform.impo1-auximpo
											if cond=2
												.text9.value=.text9.value-auxiva
											endif
										case cur_arti.art_alicuota=2
											thisform.impo2=thisform.impo2-auximpo
											if cond=2
												.text11.value=.text11.value-auxiva
											endif
									ENDCASE
									.text24.value=.text24.value+IIF(.text19.value>0,ConverNro(prtot)*((100-.text19.value)/100),ConverNro(prtot))
								CASE ALLTRIM(.grid1.text)=''
									.grid1.text=prtot
							ENDCASE
						ENDIF
					ELSE
						pregciva=messagebox("¿Calcula Iva para este Item?",4+48+0,"Advertencia")
						IF pregciva=6
							.grid1.col=9
							DO CASE
								CASE ALLTRIM(.grid1.text)='X'
									if auxalic<>IIF(cur_arti.art_alicuota=1,impiva1,impiva2)
										do case
											case auxalic=impiva1
												thisform.impo1=thisform.impo1-ConverNro(prtot)
												if cond=2
													.text9.value=.text9.value-(ConverNro(prtot)*auxalic/100)
												endif
											case auxalic=impiva2
												thisform.impo2=thisform.impo2-ConverNro(prtot)
												if cond=2
													.text11.value=.text11.value-(ConverNro(prtot)*auxalic/100)
												endif
										ENDCASE
									endif
								CASE ALLTRIM(.grid1.text)=''
									thisform.acu=thisform.acu+ConverNro(prtot)
							ENDCASE
						ELSE
							.grid1.col=9
							IF ALLTRIM(.grid1.text)='X'
								.grid1.text=''
								thisform.acu=thisform.acu-ConverNro(prtot)
								if .text19.value>0
									auxiva=auxiva*((100-.text19.value)/100)
									auximpo=auximpo*((100-.text19.value)/100)
								ENDIF
								do case
									case cur_arti.art_alicuota=1	
										thisform.impo1=thisform.impo1-auximpo
										if cond=2
											.text9.value=.text9.value-auxiva
										endif
									case cur_arti.art_alicuota=2
										thisform.impo2=thisform.impo2-auximpo
										if cond=2
											.text11.value=.text11.value-auxiva
										endif
								ENDCASE
								.text24.value=.text24.value+IIF(.text19.value>0,ConverNro(prtot)*((100-.text19.value)/100),ConverNro(prtot))
							ENDIF 
						ENDIF
					ENDIF
					paso=0
				else
					if insertar=0
						nitem=nitem+1
						cadena=repl("0",8-len(allt(str(cur_arti.art_codi))))+allt(str(cur_arti.art_codi))
						.grid1.additem(alltrim(str(nitem))+chr(9)+trim(cant)+chr(9)+cur_arti.art_med+chr(9)+cadena+chr(9)+allt(descri)+chr(9)+allt(pruni)+chr(9)+allt(prtot)+chr(9)+""+chr(9)+iif(cur_arti.art_alicuota=1,allt(str(impiva1,10,2)),allt(str(impiva2,10,2))))
						.grid1.row=.grid1.rows-1
						if .check1.value=1
							.grid1.col=7
							.grid1.text="SS"
						endif
					ENDIF
					pregciva=messagebox("¿Calcula Iva para este Item?",4+48+0,"Advertencia")
					IF pregciva=6
						thisform.acu=thisform.acu+ConverNro(prtot)
						.grid1.col=9
						.grid1.text='X'
					ELSE
						.text24.value=.text24.value+IIF(.text19.value>0,ConverNro(prtot)*((100-.text19.value)/100),ConverNro(prtot))
					endif
				endif
			endwith
			if localiz=1 and nitem>0
				thisform.grid1.col=6
				thisform.totales(ConverNro(thisform.grid1.text))
			endif
			codigo=0
			this.grid1.row=this.grid1.rows-1
			this.grid1.col=0
			this.grid1.cellfontname="Courier New"
			this.grid1.cellfontsize=8
			this.grid1.cellalignment=3
			this.grid1.col=1
			this.grid1.cellfontname="Courier New"
			this.grid1.cellfontsize=8
			this.grid1.cellalignment=6
			this.grid1.col=2
			this.grid1.cellfontname="Courier New"
			this.grid1.cellfontsize=8
			this.grid1.cellalignment=3
			this.grid1.col=3
			this.grid1.cellfontname="Courier New"
			this.grid1.cellfontsize=8
			this.grid1.cellalignment=3
			this.grid1.col=4
			this.grid1.cellfontname="Courier New"
			this.grid1.cellfontsize=8
			this.grid1.cellalignment=0
			this.grid1.col=5
			this.grid1.cellfontname="Courier New"
			this.grid1.cellfontsize=8
			this.grid1.cellalignment=8
			this.grid1.col=6
			this.grid1.cellfontname="Courier New"
			this.grid1.cellfontsize=8
			this.grid1.cellalignment=8
			this.grid1.col=7
			this.grid1.cellfontname="Courier New"
			this.grid1.cellfontsize=8
			this.grid1.cellalignment=8
			this.grid1.col=8
			this.grid1.cellfontname="Courier New"
			this.grid1.cellfontsize=8
			this.grid1.cellalignment=8 
		ENDIF
		
		store 0 to localiz,muestro
	ENDPROC

	PROCEDURE Destroy
		localiz=0
		nitem=0
		on key label INS
	ENDPROC

	PROCEDURE Init
		public cond,elimi,aux,descrip,muestro,insertar,observ,cantreg,postal,locali,provi, ;
		       impiva1,impiva2,codiva,opcion,dato1,dato2,dato3,dato4,cant,descri, ;
			   pruni,prtot,opcion,borra,alternati,localiz,ivaant,ivaact,iva,codiprov,codr,dato1, ;
			   proveedor,paso,pregciva,nitem,auxalic
		PUBLIC auxiacneto,auximpo,auxacuneto,auxiva
		
		_screen.xopcpra="RE"
		
		store 0 to auxiacneto,auxacuneto,auxiva,nitem,auxalic
		observ=""
		paso=0
		thisform.acu=0
		elimi=0
		aux=0
		descrip=""
		insertar=0
		cantreg=0
		borra=0
		prtot=""
		pruni=""
		codigo=0
		codiprov=0
		codr=0
		pregciva=0
		thisform.valorcadena=valorcadena
		this.text13.value=date()
		STORE 0 TO this.text7.value, ;
		           this.text19.value, ;
				   this.text23.value, ;
				   this.text22.value, ;
				   this.text25.value, ;
				   this.text26.value, ;
				   this.text8.Value, ;
				   this.text17.Value, ;
				   this.text18.Value, ;
				   this.text24.Value, ;
				   this.text9.Value, ;
				   this.text11.Value, ;
				   this.text15.Value, ;
				   this.text20.Value, ;
				   this.text10.Value
		frmncprov= conectar_db(_screen.cn)
			SQLEXEC(frmncprov,"select * from iva order by iva_codi desc limit 1;","cur_iva")
		desconectar_db(frmncprov)
		codiva=cur_iva.iva_codi
		impiva1=cur_iva.iva_1
		impiva2=cur_iva.iva_2
		ivaant=impiva1
		thisform.label12.caption=allt(str(impiva1,10,2))+"%"
		thisform.label13.caption=allt(str(impiva2,10,2))+"%"
		proveedor=" "
		do form provload with proveedor,codiprov
		IF codiprov=0
			thisform.Release
		endif
		localiz=0
		muestro=0
		cond=cur_prov.cond_codi
		with thisform
			.text1.value=cur_prov.prov_nomb
			.text2.value=cur_prov.prov_domi
			.text3.value=postal
			.text4.value=locali
			.text5.value=provi
			.text6.value=cur_prov.cond_desc
			.text12.value=VAL(cur_prov.prov_cuit)
			.text14.value=allt(cur_prov.prov_ultiletra)
			.text22.value=cur_prov.prov_ultipto
			if cur_prov.percepcion="S"
				.label18.enabled=.T.
				.label19.enabled=.T.
				.text15.enabled=.T.
				.text20.enabled=.T.
				.text16.value=0
				.text21.value=0
			else
				.label18.enabled=.F.
				.label19.enabled=.F.
				.text15.enabled=.F.
				.text20.enabled=.F.
				.text16.value=0
				.text21.value=0
			endif
			.text15.value=0
			.text20.value=0
		endwith
	ENDPROC

	PROCEDURE Load
		set skip of bar 9 of Altas .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if prompt()<>"Notas de Crédito/Notas de Débito"
		*!*	*set skip of bar 9 of Altas .F.
		*!*		thisform.hide
		*!*		localiz=0
		*!*		nitem=0
		*!*	endif
	ENDPROC

	PROCEDURE totales
		LPARAMETERS ximpor
		
		with thisform
			if .optiongroup1.value=2
				if INLIST(cond,4,5)
					.text24.value=thisform.acu
					.text10.value=.text24.value
				else
					.text8.value=thisform.acu
					.text17.value=(thisform.acu*.text19.value)/100
					.text18.value=thisform.acu-.text17.value
					IF .text25.value>0
						.text24.value=.text24.value+((.text18.value*.text25.value)/100)
					ENDIF
		*!*				.grid1.row=nitem
					IF pregciva=6
						if .text19.value>0
							do case
								case cur_arti.art_alicuota=1
									thisform.impo1=thisform.impo1+(ximpor*((100-.text19.value)/100))
									if cond=2
										.text9.value=.text9.value+((ConverNro(prtot)*((100-.text19.value)/100))*impiva1/100)
									else
										auxiacneto=thisform.acun1
										thisform.acun1=thisform.acun1+((ConverNro(prtot)*((100-.text19.value)/100))/(1+(impiva1/100)))
										thisform.acu1=thisform.acu1+(thisform.acun1-auxiacneto)*impiva1/100
									endif
								case cur_arti.art_alicuota=2
									thisform.impo2=thisform.impo2+(ximpor*((100-.text19.value)/100))
									if cond=2
										.text11.value=.text11.value+((ConverNro(prtot)-(ConverNro(prtot)*.text19.value/100))*impiva2/100)
									else
										auxiacneto=thisform.acun2
										thisform.acun2=thisform.acun2+((ConverNro(prtot)*((100-.text19.value)/100))/(1+(impiva2/100)))
										thisform.acu2=thisform.acu2+(thisform.acun2-auxiacneto)*impiva2/100
									endif
							endcase
						else
							do case
								case cur_arti.art_alicuota=1
									.grid1.col=6
									thisform.impo1=thisform.impo1+ConverNro(.grid1.text)
									if cond=2
										.text9.value=.text9.value+((ConverNro(prtot))*impiva1/100)
									else
										auxiacneto=thisform.acun1
										thisform.acun1=thisform.acun1+(ConverNro(prtot)/(1+(impiva1/100)))
										thisform.acu1=thisform.acu1+(thisform.acun1-auxiacneto)*impiva1/100
									endif
								case cur_arti.art_alicuota=2
									.grid1.col=6
									thisform.impo2=thisform.impo2+ConverNro(.grid1.text)
									if cond=2
										.text11.value=.text11.value+((ConverNro(prtot))*impiva2/100)
									else
										auxiacneto=thisform.acun2
										thisform.acun2=thisform.acun2+(ConverNro(prtot)/(1+(impiva2/100)))
										thisform.acu2=thisform.acu2+(thisform.acun2-auxiacneto)*impiva2/100
									endif
							endcase
						ENDIF
					endif
				endif		
				.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
			ELSE
				if INLIST(cond,4,5)
					.text24.value=thisform.acu
					.text10.value=.text24.value
				ELSE
					.text8.value=thisform.acu
					.text17.value=(thisform.acu*.text19.value)/100
					.text18.value=thisform.acu-.text17.value
					IF .text25.value>0
						.text24.value=.text24.value+((.text18.value*.text25.value)/100)
					ENDIF
					IF pregciva=6
						if .text19.value>0
							do case
								case cur_arti.art_alicuota=1
									thisform.impo1=thisform.impo1+(ximpor*((100-.text19.value)/100))
									if cond=2
										.text9.value=.text9.value+(ConverNro(prtot)*((100-.text19.value)/100)*impiva1/100)
									else
										auxiacneto=thisform.acun1
										thisform.acun1=thisform.acun1+((ConverNro(prtot)*((100-.text19.value)/100))/(1+(impiva1/100)))
										thisform.acu1=thisform.acu1+(thisform.acun1-auxiacneto)*impiva1/100
									endif
								case cur_arti.art_alicuota=2
									thisform.impo2=thisform.impo2+(ximpor*((100-.text19.value)/100))
									if cond=2
										.text11.value=.text11.value+((ConverNro(prtot)-(ConverNro(prtot)*.text19.value/100))*impiva2/100)
									else
										auxiacneto=thisform.acun2
										thisform.acun2=thisform.acun2+((ConverNro(prtot)*((100-.text19.value)/100))/(1+(impiva2/100)))
										thisform.acu2=thisform.acu2+(thisform.acun2-auxiacneto)*impiva2/100
									endif
							endcase
						ELSE
							do case
								case cur_arti.art_alicuota=1
									thisform.impo1=thisform.impo1+ximpor
									if cond=2
										.text9.value=.text9.value+((ConverNro(prtot))*impiva1/100)
									else
										auxiacneto=thisform.acun1
										thisform.acun1=thisform.acun1+(ConverNro(prtot)/(1+(impiva1/100)))
										thisform.acu1=thisform.acu1+(thisform.acun1-auxiacneto)*impiva1/100
									endif
								case cur_arti.art_alicuota=2
									thisform.impo2=thisform.impo2+ximpor
									if cond=2
										.text11.value=.text11.value+((ConverNro(prtot))*impiva2/100)
									else
										auxiacneto=thisform.acun2
										thisform.acun2=thisform.acun2+(ConverNro(prtot)/(1+(impiva2/100)))
										thisform.acu2=thisform.acu2+(thisform.acun2-auxiacneto)*impiva2/100
									endif
							endcase
						ENDIF
					ENDIF
				ENDIF
				.text10.value=.text18.value+.text24.value+.text9.value+.text15.value+.text20.value+.text11.value
			ENDIF
		ENDWITH
		
		RETURN
		
	ENDPROC

	PROCEDURE btn_deta.Click
		IF LEN(ALLTRIM(cur_prov.prov_deta)) > 0
			MESSAGEBOX(ALLTRIM(cur_prov.prov_deta),64,"Detalles Adicionales del Proveedor")
		ELSE
			MESSAGEBOX("No hay detalles ingresados para este proveedor",48,"Detalles Adicionales del Proveedor")
		ENDIF
		
	ENDPROC

	PROCEDURE Check1.Click
		do case
			case this.value=1
				preg=messagebox("¿Sin mover Stock?",4+48+256,"Advertencia")
				if preg=6
					if thisform.grid1.rows>1
						thisform.grid1.col=7
						for i=1 to thisform.grid1.rows-1
							thisform.grid1.row=i
							thisform.grid1.text="SS"
						next i
						thisform.grid1.row=1
					endif
				else
					this.value=0
				endif
			case this.value=0
				preg=messagebox("¿Mueve Stock?",4+48+256,"Advertencia")
				if preg=6
					if thisform.grid1.rows>1
						thisform.grid1.col=7
						for i=1 to thisform.grid1.rows-1
							thisform.grid1.row=i
							thisform.grid1.text=""
						next i
						thisform.grid1.row=1
					endif
				else
					this.value=1
				endif
		endcase
	ENDPROC

	PROCEDURE Check2.Click
		if this.value=1
			pag=messagebox("¿Confirma imputar este Comprobante como Descontado?",4+48+256,"Recepciones")
			if pag=6
				this.value=1
			else
				this.value=0
			endif
		else
			if this.value=0
				pag=messagebox("¿Confirma imputar este Comprobante como NO Descontado?",4+48+256,"Recepciones")
				if pag=6
					this.value=0
				else
					this.value=1
				endif
			endif
		endif
		
	ENDPROC

	PROCEDURE Check3.Click
		if this.value=1
			pag=messagebox("¿Confirma Asentar este Comprobante en la Cuenta Corriente?",4+48+256,"Recepciones")
			if pag=6
				this.value=1
			else
				this.value=0
			endif
		else
			if this.value=0
				pag=messagebox("¿Confirma NO Asentar este Comprobante en la Cuenta Corriente?",4+48+256,"Recepciones")
				if pag=6
					this.value=0
				else
					this.value=1
				endif
			endif
		endif
	ENDPROC

	PROCEDURE Command1.Click
		salir=messagebox("¿Seguro que desea Salir?",4+32+256,"Verifique!!!")
		if salir=6
			thisform.release
		endif
		

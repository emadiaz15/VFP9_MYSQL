		this.FontBold= .T.
	ENDPROC

	PROCEDURE Command2.Click
		if thisform.text7.value=0
			messagebox("Debe ingresar obligatoriamente el número de factura del Proveedor",0+48,"Adevertencia")
			thisform.text7.setfocus
		else
		if nitem=0
			do case
				case thisform.optiongroup1.value=1
					messagebox("Aún no ha ingresado ningún artículo a la Nota de Crédito, imposible terminar",48,"Advertencia")
				case thisform.optiongroup1.value=2
					messagebox("Aún no ha ingresado ningún Dédito, imposible terminar",48,"Advertencia")
			endcase
		else
			do case
				case thisform.optiongroup1.value=1
					preg=messagebox("¿Confirma los datos de la Nota de Crédito?",4+32+256,"Recepciones")
				case thisform.optiongroup1.value=2
					preg=messagebox("¿Confirma los datos de la Nota de Débito?",4+32+256,"Recepciones")
			endcase
			if preg=6
				with thisform
					LOCAL xcodr,xfec,xdto,xpiva,xpbto,xfac,xtipf,xpto,xcta,xcoti,xtot,ximpag,xpag,xng,xne1,xne2,xivri,xivrni,xconc, ;
						  xarti,xdasc,xcant,xcstock,xsst,xprec,xciva
					STORE 0 TO xpiva,xpbto,xivnc,xivnd,xng
					STORE '' TO xpag,xsst,xdasc
					frmncprov= conectar_db(_screen.cn)
						SQLEXEC(frmncprov,"select CAST(recep_codi+1 as DECIMAL(8,0)) as recep_codi from recepciones order by recep_codi desc limit 1;","cur_nvor")
						IF ISNULL(cur_nvor.recep_codi)
							xcodr=1
						ELSE
							xcodr=cur_nvor.recep_codi					
						ENDIF
					desconectar_db(frmncprov)
					xfec=.text13.value
					xdto=.text19.value
					xpiva=.text15.value
					xpbto=.text20.value
					xfac=.text7.value
					xtipf=allt(.text14.value)
					xpto=.text22.value
					if .check3.value=1
						xcta=1
					else
						xcta=0
					endif
					if .text23.value>0
						xcoti=.text23.value
						xtot=.text18.value*.text23.value
						if .check2.value=1
							ximpag=xtot
							xpag='S'
						endif
					else
						xtot=.text18.value
						if .check2.value=1
							ximpag=xtot
							xpag='S'
						endif
					endif
					if cond=4 or cond=5
						xng=.text24.value
					endif
					if .text24.value>0
						xng=.text24.value
					endif
					if cond=2
						xivri=.text9.value
						xivrni=.text11.value
					else
						xivri=thisform.acu1
						xivrni=thisform.acu2
					endif
					xne1=iif(cond=2,thisform.impo1,thisform.acun1)
					xne2=iif(cond=2,thisform.impo2,thisform.acun2)
					frmncprov= conectar_db(_screen.cn)
						do case
							case .optiongroup1.value=1
								xconc='N'
								if .check2.value=0
									SQLEXEC(frmncprov,"update proveedores set prov_saldo=prov_saldo-?.text10.value where prov_codi=?codiprov;")
								endif
							case .optiongroup1.value=2
								xconc='D'
								if .check2.value=0
									SQLEXEC(frmncprov,"update proveedores set prov_saldo=prov_saldo+?.text10.value where prov_codi=?codiprov;")
								endif
						ENDCASE
						SQLEXEC(frmncprov,"insert into recepciones values(?xcodr,?xfec,?codiprov,?observ,?xdto,?xtipf,?xpto,?xfac,0,?codiva,?xpiva,?xpbto,?ximpag,?xpag,?xconc,?xcoti,?xng,?xivri,?xivrni,?xne1,?xne2,?xtot,0,?xcta,'');")
					desconectar_db(frmncprov)
								
					for fila=1 to .grid1.rows
						if fila<.grid1.rows
							.grid1.row=fila
							.grid1.col=3
							xarti=val(.grid1.text)
							if xarti=4 OR xarti=5
								.grid1.col=4
								xdasc=allt(.grid1.text)
							endif
							.grid1.col=1
							SET DECIMALS TO 3
							xcant=ConverNro(.grid1.text)
							.grid1.col=7
							if xarti>5
								if allt(.grid1.text)<>"SS"
									LOCAL stact,saldst,xcadecom,npto,nnro,xnompro,xtipmov
									xnompro  =ALLTRIM(thisform.text1.Value)
									npto     =REPLICATE("0",4-LEN(ALLTRIM(STR(xpto))))+ALLTRIM(STR(xpto))
									nnro     =REPLICATE("0",8-LEN(ALLTRIM(STR(xfac))))+ALLTRIM(STR(xfac))
									xcadecom =IIF(.optiongroup1.value=1,"NCP","NDP")+ALLTRIM(xtipf)+"_"+ALLTRIM(npto)+"-"+ALLTRIM(nnro)+" -- "+xnompro						
									xcstock=IIF(.optiongroup1.value=1,-xcant,xcant)
									xtipmov=IIF(.optiongroup1.value=1,'S','E')
									.grid1.col=1
									frmncprov= conectar_db(_screen.cn)
										SET DECIMALS TO 3
										SQLEXEC(frmncprov,"select art_stock from articulos where art_codi=?xarti;","cur_stac")
										stact=cur_stac.art_stock
										saldst=stact+xcstock
										SQLEXEC(frmncprov,"update articulos set art_stock=art_stock+?xcstock where art_codi=?xarti;")
										SQLEXEC(frmncprov,"insert into histostock values(null,?xarti,current_date(),current_time(),?xtipmov,?stact,?xcstock,?saldst,?xcadecom,?observ,0,?xcodr,0,0,0,?cond,?codiprov);")
										SET DECIMALS TO
										cerrar_cursor("cur_stac")
									desconectar_db(frmncprov)
									**************************** SE CONECTA AL SERVIDOR ILUMET Y SI EXISTE EL ARTICULO MODIFICA STOCK E HISTORICO **********************************
									conexterna= conectar_db(_screen.xconext)
									IF VARTYPE(conexterna) = "N" AND conexterna> 0
										SQLEXEC(conexterna,"select * from articulos where art_codi = ?xarti;","cur_artext")
										IF USED("cur_artext")
											IF RECCOUNT("cur_artext") > 0
												SQLEXEC(conexterna,"select art_stock from articulos where art_codi=?xarti;","cur_stac")
												stact=cur_stac.art_stock
												saldst=stact+xcant
												xcadecom =IIF(.optiongroup1.value=1,"NCP","NDP")+ALLTRIM(xtipf)+"(HP)_"+ALLTRIM(npto)+"-"+ALLTRIM(nnro)+" -- "+xnompro
												SQLEXEC(conexterna,"update articulos set art_stock=art_stock+?xcstock where art_codi=?xarti;")
												SQLEXEC(conexterna,"insert into histostock values(null,?xarti,current_date(),current_time(),?xtipmov,?stact,?xcstock,?saldst,?xcadecom,?observ,0,?xcodr,0,0,0,?cond,?codiprov);")
											ENDIF
											cerrar_cursor("cur_artext")
										ENDIF
										desconectar_db(conexterna)
									ENDIF
									*************************** FIN PROCESO SERVIDOR ILUMET *****************************************							
								else
									xsst='S'
								ENDIF
							endif
							.grid1.col=5
							SET DECIMALS TO 4
							xprec=ConverNro(.grid1.text)
							SET DECIMALS TO
							.grid1.col=9
							if allt(.grid1.text)="X"
								xciva=1
							ELSE
								xciva=0
							endif
							frmncprov= conectar_db(_screen.cn)
								SQLEXEC(frmncprov,"insert into recepciones_articulos values(?xcodr,?xarti,?xcant,?xprec,?xdasc,'',?xsst,0,?xciva,0);")
							desconectar_db(frmncprov)
						endif
					next fila
				endwith
				thisform.release
			endif
		endif
		endif
	ENDPROC


		capslock(.T.)
	ENDPROC

	PROCEDURE Edit1.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
		
	ENDPROC

	PROCEDURE grid1.DblClick
		*** ActiveX Control Event ***
		local x,y
		if nitem>0
			this.col=0
			aux=val(this.text)
			this.col=3
			dato1=val(this.text)
			this.col=1
			dato2=this.text
			this.col=4
			dato3=this.text
			this.col=5
			dato4=this.text
			this.col=6
			prtot=this.text
			this.col=2
			dato5=this.text
			this.col=7
			IF ALLTRIM(this.text)='SS'
				opcion=3
			ENDIF
			this.col=8
			auxalic=ConverNro(ALLTRIM(this.text))
			do form modippreg with cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot
		endif
		if borra=6
			frmncprov= conectar_db(_screen.cn)
				SQLEXEC(frmncprov,"select * from articulos where art_codi=?dato1;","cur_arti")
			desconectar_db(frmncprov)
			with thisform
				this.col=6
				thisform.acu=thisform.acu-ConverNro(this.text)
				if this.rows=2
					nitem=nitem-1
					this.rows=1
					thisform.acu=0
					.text8.value=""
					.text9.value=""
					.text10.value=""
					.text11.value=""
					.text17.value=""
					.text18.value=""
					.text19.value=0
				else
					nitem=nitem-1
					this.removeitem(this.row)
					filaux=this.row
					x=1
					do while x<=this.rows-1
						this.row=x
						this.col=0
						this.text=allt(str(x))
						x=x+1
					enddo
					this.row=filaux
				endif
			endwith
			borra=0
			insertar=0
		ENDIF
		DO case
			case opcion=3
				this.col=7
				this.text='SS'
				opcion=0
			CASE opcion=4
				this.col=7
				this.text=''
				opcion=0
		ENDCASE
		
	ENDPROC


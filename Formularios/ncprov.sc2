	PROCEDURE Text13.GotFocus
		codigo=0
		opcion=0
		valorcadena=thisform.valorcadena
		on key label INS do form cualartprov with codiprov,cond,opcion,dato1,dato2,dato3,dato4,codigo,cant,descri,pruni,prtot

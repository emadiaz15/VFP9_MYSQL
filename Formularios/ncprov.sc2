	ADD OBJECT 'Text9' AS textbox WITH ;
		Alignment = 1, ;
		DisabledBackColor = 255,255,255, ;
		Height = 23, ;
		InputMask = "999,999,999.99", ;
		Left = 657, ;
		Name = "Text9", ;

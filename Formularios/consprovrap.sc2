	PROCEDURE Destroy
		*!*	set skip of bar 10 of Consultas .F.
	ENDPROC

	PROCEDURE Init
		parameter codiprov
		
		public salrap
		
		frmconsprap= conectar_db(_screen.cn)
			SQLEXEC(frmconsprap,"call usp_buscarprov(?codiprov);","cur_prorap")
		desconectar_db(frmconsprap)
		
		salrap=cur_prorap.prov_saldo-cur_prorap.prov_afvor
		
		this.check1.value=iif(cur_prorap.percepcion="S",1,0)
		
		this.text11.inputmask=repl("9",1+len(allt(cur_prorap.prov_cartel)))
		
		IF LEN(ALLTRIM(cur_prov.prov_deta))>0
			this.Height=584
			thisform.command1.Top = 538
			this.label16.Visible= .T.
			this.shape2.Visible= .T.
			this.edt_deta.Visible= .T.
			this.command1.SetFocus
		ELSE
			this.Height=456
			thisform.command1.Top = 408
			this.label16.Visible= .F.
			this.shape2.Visible= .F.
			this.edt_deta.Visible= .F.
		ENDIF
		thisform.AutoCenter= .T.
			
	ENDPROC

	PROCEDURE Load
		set skip of bar 10 of Consultas .T.
	ENDPROC

	PROCEDURE LostFocus
		*!*	if prompt()<>"Datos Proveedores"
		*!*		set skip of bar 10 of Consultas .F.
		*!*		thisform.hide
		*!*	endif
		
	ENDPROC

	PROCEDURE Command1.Click
		thisform.release
	ENDPROC

	PROCEDURE Command1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold= .F.
	ENDPROC

	PROCEDURE Command1.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold= .T.
	ENDPROC

	PROCEDURE edt_deta.GotFocus
		capslock(.T.)
	ENDPROC

	PROCEDURE edt_deta.LostFocus
		capslock(.F.)
	ENDPROC

	PROCEDURE Text4.LostFocus
		if this.value<>" "
			sele provincias
			set order to provi_nomb
			seek allt(this.value)
			if !found()
				set order to provi_codi
				go bott
				pro=provi_codi+1
				appe blank
				repla provi_codi with pro
				repla provi_nomb with allt(this.value)
				sele localidades
				repla provi_codi with pro
			else
				sele localidades
				repla provi_codi with provincias.provi_codi
				sele provincias
				set order to provi_codi
			endif
		endif
	ENDPROC

	PROCEDURE Text4.Valid
		if this.value=" " and last()<>-4
			messagebox("Debe ingresar la Provincia",0+48,"Advertencia!!!")
			return 0
		endif
	ENDPROC

ENDDEFINE


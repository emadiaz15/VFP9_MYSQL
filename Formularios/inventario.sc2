	PROCEDURE Init
		*!*	public inv,paso,borra,fila,articulo
		*!*	inv=0
		*!*	paso=0
		*!*	borra=0
		*!*	fila=0
		*!*	articulo=0
		*!*	with this
		*!*		.text1.value=0
		*!*		.text4.value=0
		*!*	endwith
	ENDPROC

	PROCEDURE Load
		MESSAGEBOX("ESTA RUTINA SE ENCUENTA MOMENTÁNEAMENTE EN PROCESO DE DISEÑO Y MANTENIMIENTO."+CHR(13)+CHR(13)+;
				   "ESTARÁ DISPONIBLE EN PRÓXIMAS ACTUALIZACIONES.",64,"Aviso del Sistema")
		RETURN TO master
	ENDPROC

	PROCEDURE Command1.Click
		with thisform
			if .grid1.rows=1
				=messagebox("Debe ingresar algun item para poder efectuar el proceso de ajuste de Inventario",0+48,"Advertencia")
			else
				preg=messagebox("¿Confirma los ajustes por Inventario?",4+48+256,"Advertencia")
				if preg=6
					set reprocess to automatic
					if flock()
						sele inventarios
						set order to inve_fech
						seek date()
						if found()
							inv=inve_codi
							set order to inve_codi
						else
							set order to inve_codi
							go bott
							inv=inve_codi+1
							appe blank
							repla inve_codi with inv
							repla inve_fech with date()
						endif
						sele inventarios_articulos
						set order to inve_codi
						seek inv
						if !found()
							for i=1 to .grid1.rows-1
								.grid1.row=i
								.grid1.col=0
								appe blank
								repla inve_codi with inv
								repla art_codi with val(.grid1.text)
								.grid1.col=2
								repla artinve_stock with val(.grid1.text)
								.grid1.col=3
								repla artinve_ctrl with val(.grid1.text)
								repla articulos.art_stock with val(.grid1.text)
							next
						else
							for i=1 to .grid1.rows-1
								.grid1.row=i
								.grid1.col=0
								set order to artinve
								articulo=val(.grid1.text)
								seek str(inv)+str(articulo)
								if found()
									preg=messagebox("El siguiente artículo ya ha sido ajustado"+chr(13)+ ;
													"al Inventario del día de hoy: "+chr(13)+chr(13)+ ;
													"Código: "+allt(.grid1.text)+chr(13)+ ;
													"Descripción: "+allt(articulos.art_desc)+chr(13)+ ;
													"Stock Anterior: "+allt(str(artinve_stock,10,3))+chr(13)+ ;
													"Control de Inventario: "+allt(str(artinve_ctrl,10,3))+chr(13)+chr(13)+ ;
													"¿Desea ajustar nuevamente este Artículo?",4+48+256,"Advertencia")
									if preg=6
										.grid1.col=3
										repla artinve_ctrl with val(.grid1.text)
									endif
								else
									appe blank
									repla inve_codi with inv
									repla art_codi with val(.grid1.text)
									.grid1.col=2
									repla artinve_stock with val(.grid1.text)
									.grid1.col=3
									repla artinve_ctrl with val(.grid1.text)
									repla articulos.art_stock with val(.grid1.text)
								endif
							next
						endif
					endif
					thisform.release
				else
					thisform.text1.setfocus
				endif
			endif
		endwith
	ENDPROC

	PROCEDURE Command2.Click
		preg=messagebox("¿Seguro que desea salir sin procesar el Inventario?",4+48+256,"Advertencia")
		if preg=6
			thisform.release
		else
			thisform.text1.setfocus
		endif
	ENDPROC

	PROCEDURE grid1.Click
		*** ActiveX Control Event ***
		
	ENDPROC

	PROCEDURE grid1.DblClick
		*** ActiveX Control Event ***
		*!*	fila=this.row
		*!*	paso=0
		*!*	borra=0
		*!*	do form modipinve with paso,borra
		*!*	with thisform
		*!*		do case
		*!*			case paso=1
		*!*				this.col=0
		*!*				.text1.value=val(this.text)
		*!*				this.col=1
		*!*				.text2.value=allt(this.text)
		*!*				this.col=2
		*!*				.text3.value=val(this.text)
		*!*				this.col=3
		*!*				.text4.value=val(this.text)
		*!*				.text4.setfocus
		*!*			case borra=6
		*!*				this.removeitem(fila)
		*!*		endcase
		*!*	endwith
	ENDPROC

	PROCEDURE grid1.GotFocus
		thisform.text1.setfocus
	ENDPROC

	PROCEDURE Text1.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			frminve= conectar_db(_screen.cn)
				SQLEXEC(frminve,"select * from articulos where art_codi=?this.value;","cur_arti")
			desconectar_db(frminve)
			if RECCOUNT("cur_arti")>0
				with thisform
					.text2.value=cur_arti.art_desc
					.text3.value=cur_arti.art_stock
					.text4.value=cur_arti.art_stock
				endwith
			else
				=messagebox("Artículo no está en archivo",0+48,"Advertencia")
			endif
		endif
	ENDPROC

	PROCEDURE Text1.Valid
		*!*	if !found() and this.value>0
		*!*		this.value=0
		*!*		return 0
		*!*	endif
	ENDPROC

	PROCEDURE Text4.Click
		this.setfocus
	ENDPROC

	PROCEDURE Text4.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode=13
			with thisform
				if paso=1
					.grid1.col=3
					.grid1.row=fila
					.grid1.text=str(this.value,10,3)
					.text1.value=0
					.text2.value=""
					.text3.value=0
					.text4.value=0
					paso=0
				else
					cadena=repl("0",8-len(allt(str(.text1.value))))+allt(str(.text1.value))
					.grid1.additem(cadena+chr(9)+allt(.text2.value)+chr(9)+str(.text3.value,10,3)+chr(9)+str(.text4.value,10,3))
					.text1.value=0
					.text2.value=""
					.text3.value=0
					.text4.value=0
		*			.grid1.toprow=.grid1.rows-1
				endif
			endwith
		endif
	ENDPROC

ENDDEFINE

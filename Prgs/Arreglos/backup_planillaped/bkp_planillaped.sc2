		XLSheet.Cells(fotfil,7).NUMBERFORMAT="_-[$USD] * #,##0.00"
		XLSheet.Cells(fotfil,8).NUMBERFORMAT="_-[$USD] * #,##0.00"
		XLSheet.Cells(fotfil,7)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_totd.caption))
		XLSheet.Cells(fotfil,8)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_totdp.caption))
		fotfil = fotfil - 1
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil+1,8)).font.bold= .T.
		fotfil = xInifil + 1
		XLSheet.Range(XLSheet.Cells(fotfil,6),XLSheet.Cells(fotfil+11,6)).font.bold= .T.
		
		RETURN
		
		
		
		
		
	ENDPROC

	PROCEDURE grd_click
		thisform.grd_ped.SelectedItemBackColor=thisform.obtenercolor(cur_planp.estado)
		thisform.grd_ped.SelectedItemForeColor=thisform.obtenercolortex(cur_planp.estado)
	ENDPROC

	PROCEDURE grid_rightclick
		IF USED("cur_planp")
			IF cur_planp.estado = 4
		*!*			thisform.grd_ped.SelectedItembackcolor=thisform.obtenercolor(cur_planp.estado)
		*!*			thisform.grd_ped.SelectedItemForecolor=thisform.obtenercolortex(cur_planp.estado)
				LOCAL lcShortcut, loRef
				m.loRef = this
				m.lcShortcut = SYS(2015)
		
				DEFINE POPUP (m.lcShortcut) SHORTCUT RELATIVE FROM MROW(), MCOL()
				DEFINE BAR 1 OF (m.lcShortcut) PROMPT [Ver Detalle Monto Pendiente]
		
				ON SELECTION BAR 1 OF (m.lcShortcut) m.loRef.Grid_ShowDesc()
		*!*			SET MARK OF BAR 1 OF (m.lcShortcut) TO m.loRef.lExpanded
		
		
				ACTIVATE POPUP (m.lcShortcut)
				RELEASE POPUP (m.lcShortcut)
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE grid_showdesc
		
		IF USED("cur_planp")
			thisform.AddObject("shp_datos","shape")
			WITH thisform.shp_datos
				.left    = 105
				.top     = 275
				.width   = 574
				.height  = 173
				.backcolor = RGB(140, 165, 176)
				.SpecialEffect = 0
				.Visible = .T.
			ENDWITH
				
			THISFORM. ADDOBJECT("edt_datos","EDITBOX")
			WITH THISform.edt_datos
				.left    = 117
				.top     = 288
				.width   = 550
				.height  = 125
				.disabledbackcolor = RGB(40,44,52)
				.forecolor = RGB(244,210,50)
				.fontsize  = 10
				.fontbold  = .T.
				.readonly  = .T.
				.value     = "Detalle del Monto Pendiente: "+CHR(13)+CHR(13)+ ;
				             "Pendiente sin Entregar: USD "+ ;
				             	ALLTRIM(STR(cur_planp.impopen-cur_planp.remsfac,15,2))+CHR(13)+ ;
				             "Pendiente Entregado sin Facturar: USD "+ ;
				             	ALLTRIM(STR(cur_planp.remsfac,15,2))+CHR(13)+CHR(13)+ ;
				             "TOTAL IMPORTE PENDIENTE: USD "+ ;
				             	ALLTRIM(STR(cur_planp.impopen,15,2))
				.themes    = .F.
				.Visible   = .T.
			ENDWITH
			
			thisform.AddObject("cmd_datos","Commandbutton")
			WITH thisform.cmd_datos
				.left      = 333
				.top       = 416
				.width     = 108
				.height    = 27
				.themes    = .F.
				.forecolor = RGB(255,255,255)
				.backcolor = RGB(227,68,34)
				.alignment = 2
				.caption   = "\<Cerrar Ventana"
				.Visible   = .T.
				=BINDEVENT(ThisForm.cmd_datos, "Click", ThisForm, "datos_click")
				=BINDEVENT(ThisForm.cmd_datos, "MouseMove", ThisForm, "datos_mmove")
				=BINDEVENT(ThisForm.cmd_datos, "MouseLeave", ThisForm, "datos_mleave")
			ENDWITH
		ENDIF
	ENDPROC

	PROCEDURE Init
		*!*	PUBLIC valorcadena, codigo, nombre
		SET POINT TO ","
		SET SEPARATOR TO "."
		*!*	SET DATE BRITISH
		*!*	SET CENTURY ON
		
		IF USED("cur_planp")
			cerrar_cursor("cur_planp")
		ENDIF
		IF USED("cur_detalle")
			cerrar_cursor("cur_detalle")
		ENDIF
		
		this.txt_fecdes.Value= DATE()
		this.txt_fechas.Value= DATE()
		frmplanp = conectar_db(_screen.cn)
			SQLEXEC(frmplanp,"select param_fec from parametros where param_codi = 4;","cur_primfec")
		desconectar_db(frmplanp)
		
		IF RECCOUNT("cur_primfec") > 0
			thisform.xprimefec = cur_primfec.param_fec
			cerrar_cursor("cur_primfec")
		ENDIF
		
		frmplanp = conectar_db(_screen.cn)
			SQLEXEC(frmplanp,"select * from vendedores order by ven_nomb;","cur_venp")
		desconectar_db(frmplanp)
		
		IF RECCOUNT("cur_venp") > 0
			LOCAL convp
			convp = 1
			LOCATE
			SCAN FOR convp <= RECCOUNT("cur_venp")
				thisform.cmb_vendedor.AddItem(ALLTRIM(cur_venp.ven_nomb), convp)
				convp = convp + 1
			ENDSCAN
			thisform.cmb_vendedor.AddItem("VENTAS SIN VENDEDOR", RECCOUNT("cur_venp") + 1)
			cerrar_cursor("cur_venp")
		ENDIF
		
		frmplanp= conectar_db(_screen.cn)
			SQLEXEC(frmplanp,"select param_desc from parametros where param_codi = 13;","cur_emp")
		desconectar_db(frmplanp)
		
		IF RECCOUNT("cur_emp") > 0
			thisform.empresa=ALLTRIM(cur_emp.param_desc)
			cerrar_cursor("cur_emp")
		ENDIF
		
		BINDEVENT(ThisForm.grd_ped.column1.text1, "RightClick", ThisForm, "Grid_RightClick")
		BINDEVENT(ThisForm.grd_ped.column2.text1, "RightClick", ThisForm, "Grid_RightClick")
		BINDEVENT(ThisForm.grd_ped.column3.text1, "RightClick", ThisForm, "Grid_RightClick")
		BINDEVENT(ThisForm.grd_ped.column4.text1, "RightClick", ThisForm, "Grid_RightClick")
		BINDEVENT(ThisForm.grd_ped.column5.text1, "RightClick", ThisForm, "Grid_RightClick")
		BINDEVENT(ThisForm.grd_ped.column6.text1, "RightClick", ThisForm, "Grid_RightClick")
		BINDEVENT(ThisForm.grd_ped.column7.text1, "RightClick", ThisForm, "Grid_RightClick")
		
		this.btn_actualizar.SetFocus
	ENDPROC

	PROCEDURE limpiartotales
		LPARAMETERS xopcion
		
		IF xopcion = .T.
			thisform.pgf_resum.page1.etq_cantep.Caption  = ''
			thisform.pgf_resum.page1.etq_cantfin.Caption = ''
			thisform.pgf_resum.page1.etq_cantse.Caption  = ''
		*!*		thisform.pgf_resum.page1.etq_tpep.Caption    = ''
		*!*		thisform.pgf_resum.page1.etq_tpfin.Caption   = ''
		*!*		thisform.pgf_resum.page1.etq_tpse.Caption    = ''
			thisform.pgf_resum.page1.etq_tdep.Caption    = ''
			thisform.pgf_resum.page1.etq_tdfin.Caption   = ''
			thisform.pgf_resum.page1.etq_tdse.Caption    = ''
		*!*		thisform.pgf_resum.page1.etq_ppep.Caption    = ''
		*!*		thisform.pgf_resum.page1.etq_ppfin.Caption   = ''
		*!*		thisform.pgf_resum.page1.etq_ppse.Caption    = ''
			thisform.pgf_resum.page1.etq_pdep.Caption    = ''
			thisform.pgf_resum.page1.etq_pdfin.Caption   = ''
			thisform.pgf_resum.page1.etq_pdse.Caption    = ''
			thisform.pgf_resum.page1.etq_totcan.Caption  = ''
		*!*		thisform.pgf_resum.page1.etq_totp.Caption    = ''
			thisform.pgf_resum.page1.etq_totd.Caption    = ''
		*!*		thisform.pgf_resum.page1.etq_totpp.Caption   = ''
			thisform.pgf_resum.page1.etq_totdp.Caption   = ''
		ENDIF
		
		RETURN
		
	ENDPROC

	PROCEDURE obtenercolor
		LPARAMETERS nEstado
		
		LOCAL lnColor
		
		DO case
			CASE nEstado = 1
				lnColor = RGB(227,68,34)
			CASE nEstado = 2
				lnColor = RGB(52,105,105)
		    CASE nEstado = 3
		    	lnColor = RGB(66,69,84)
			CASE nEstado = 4
				lnColor = RGB(0,255,255)
		ENDCASE
		
		return(lnColor)
		
	ENDPROC

	PROCEDURE obtenercolortex
		LPARAMETERS nEstado
		
		LOCAL txColor
		
		DO case
			CASE nEstado = 1
				txColor = RGB(255,255,255)
			CASE nEstado = 2
				txColor = RGB(255,255,255)
			CASE nEstado = 3
				txColor = RGB(230,232,242)
			CASE nEstado = 4
				txColor = RGB(0,0,0)
		ENDCASE
		
		return(txColor)
		
	ENDPROC

	PROCEDURE recorrer
		LPARAMETERS xkeycode
		
		IF xkeycode = 5 OR xkeycode = 24
			frmplanp= conectar_db(_screen.cn)
				SQLEXEC(frmplanp,"select ped_obser from pedidos where ped_codi = ?cur_planp.pedcodi","cur_obser")
			desconectar_db(frmplanp)
			
			IF RECCOUNT("cur_obser") > 0
				IF LEN(ALLTRIM(cur_obser.ped_obser)) > 0
					thisform.pgf_resum.page2.edt_obser.Value = ALLTRIM(cur_obser.ped_obser)
				ELSE
					thisform.pgf_resum.page2.edt_obser.Value = ''
				ENDIF
				cerrar_cursor("cur_obser")
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE bnt_impirmir.Click
		IF USED("cur_planp")
			IF RECCOUNT("cur_planp") > 0
				IF thisform.chk_deta.Value=1 then
					SELECT cur_detalle
					LOCATE
					INDEX on pedcodi TO SYS(2015)
					SELECT cur_planp
					LOCATE
					INDEX on pedcodi TO SYS(2015)
					SET RELATION TO
					SET RELATION TO pedcodi INTO cur_detalle addi
					IF thisform.chk_pant.Value=1
						REPORT FORM planiped_2 PREVIEW NOCONSOLE
					ELSE
						REPORT FORM planiped_2 TO PRINTER PROMPT NOCONSOLE
					ENDIF
				ELSE
					SELECT cur_planp
					LOCATE		
					IF thisform.chk_pant.Value=1
						REPORT FORM planiped_1 PREVIEW NOCONSOLE
					ELSE
						REPORT FORM planiped_1 TO PRINTER PROMPT NOCONSOLE
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE bnt_impirmir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC

	PROCEDURE bnt_impirmir.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=10
		this.FontBold=.T.
	ENDPROC

	PROCEDURE Btn_actualizar.btn.Click
		LOCAL fecdes,fechas,peddes,pedhas,npdes,nphas,ardes,arhas
		imposf = 0
		DIMENSION cantsf[1,1]
		cantsf[1,1] = 0
		
		thisform.grd_ped.RecordSource = ''
		thisform.grd_ped.Refresh
		
		fecdes = thisform.txt_fecdes.Value
		fechas = thisform.txt_fechas.Value
		peddes = thisform.txt_peddes.Value
		pedhas = thisform.txt_pedhas.Value
		npdes  = thisform.txt_npdes.Value
		nphas  = thisform.txt_nphas.Value
		ardes  = thisform.txt_artdes.Value
		arhas  = thisform.txt_arthas.Value
		
		SET DECIMALS TO 3
		frmplanp = conectar_db(_screen.cn)
			SQLEXEC(frmplanp, "call usp_planiped(?fecdes, ?fechas, ?peddes, ?pedhas, ?npdes, ?nphas, ?ardes, ?arhas);","cur_detalle")
		desconectar_db(frmplanp)
		SET DECIMALS TO
		
		IF RECCOUNT("cur_detalle") > 0	
			SELECT distinct fecha,pedcodi,notaped,cliente,vendedor,impotot, ;
							impopen,moneda,cumplido,canitems,cancump, ;
							ven_codi,cli_codi,cond_codi,estado,remsfac ;
							FROM cur_detalle INTO CURSOR cur_planp
			
			IF thisform.xcodicli <> 99999999 OR thisform.xcodiven <> 99999999
				DO case
					CASE thisform.xcodicli <> 99999999 AND thisform.xcodiven <> 99999999
						SELECT * FROM cur_planp WHERE cli_codi = thisform.xcodicli AND ven_codi = thisform.xcodiven INTO CURSOR cur_planp 
					CASE thisform.xcodicli <> 99999999 AND thisform.xcodiven = 99999999
						SELECT * FROM cur_planp WHERE cli_codi = thisform.xcodicli INTO CURSOR cur_planp 
					CASE thisform.xcodicli = 99999999 AND thisform.xcodiven <> 99999999
						SELECT * FROM cur_planp WHERE ven_codi = thisform.xcodiven INTO CURSOR cur_planp 
					CASE thisform.xcodicli = 99999999 AND thisform.xcodiven = 0
						SELECT * FROM cur_planp WHERE ven_codi = 0 INTO CURSOR cur_planp 
					CASE thisform.xcodicli <> 99999999 AND thisform.xcodiven = 0
						SELECT * FROM cur_planp WHERE cli_codi = thisform.xcodicli AND ven_codi = 0 INTO CURSOR cur_planp 
				ENDCASE
			ENDIF
			IF !(thisform.chk_sinem.Value = 1 AND thisform.chk_enpro.Value = 1 AND thisform.chk_fin.Value = 1)
				DO case
					CASE thisform.chk_sinem.Value = 1 AND thisform.chk_enpro.Value = 0 AND thisform.chk_fin.Value = 0 &&(Sin Empezar)
						SELECT * FROM cur_planp WHERE estado = 1 INTO CURSOR cur_planp 
					CASE thisform.chk_sinem.Value = 1 AND thisform.chk_enpro.Value = 1 AND thisform.chk_fin.Value = 0 &&(Sin Empezar / En Proceso)
						SELECT * FROM cur_planp WHERE estado in (1, 2, 4) INTO CURSOR cur_planp 
					CASE thisform.chk_sinem.Value = 0 AND thisform.chk_enpro.Value = 1 AND thisform.chk_fin.Value = 1 &&(En Proceso / Finalizados)
						SELECT * FROM cur_planp WHERE estado in (2, 3, 4) INTO CURSOR cur_planp 
					CASE thisform.chk_sinem.Value = 1 AND thisform.chk_enpro.Value = 0 AND thisform.chk_fin.Value = 1 &&(Sin Empezar / Finalizados)
						SELECT * FROM cur_planp WHERE estado in (1, 3) INTO CURSOR cur_planp 				
					CASE thisform.chk_sinem.Value = 0 AND thisform.chk_enpro.Value = 1 AND thisform.chk_fin.Value = 0 &&(En Proceso)
						SELECT * FROM cur_planp WHERE estado in (2, 4) INTO CURSOR cur_planp 
					CASE thisform.chk_sinem.Value = 0 AND thisform.chk_enpro.Value = 0 AND thisform.chk_fin.Value = 1 &&(Finalizados)
						SELECT * FROM cur_planp WHERE estado = 3 INTO CURSOR cur_planp 			
				ENDCASE
			ENDIF
			LOCATE
				
			IF thisform.chk_sinem.Value = 0 AND thisform.chk_enpro.Value = 0 AND thisform.chk_fin.Value = 0
				IF USED("cur_planp")
					SELECT cur_planp
					USE
				ENDIF
				IF USED("cur_detalle")
					SELECT cur_detalle
					USE
				ENDIF
				thisform.grd_ped.RecordSource = ''
				thisform.grd_ped.Refresh
				thisform.limpiartotales(.T.)
			ELSE
				thisform.limpiartotales(.T.)
				thisform.grd_ped.RecordSource = "cur_planp"
			
				Thisform.grd_ped.column6.DynamicInputMask = [('USD999,999,999.99')]
				&& [IIF(cur_planp.moneda = 'D',('USD999,999,999.99'),('$999,999,999.99'))]
				Thisform.grd_ped.column7.DynamicInputMask = [('USD999,999,999.99')]
				&& [IIF(cur_planp.moneda = 'D',('USD999,999,999.99'),('$999,999,999.99'))]
				thisform.grd_ped.SetAll("DynamicBackcolor","thisform.obtenercolor(cur_planp.estado)","Column")
				thisform.grd_ped.SetAll("DynamicForecolor","thisform.obtenercolortex(cur_planp.estado)","Column")
				thisform.grd_ped.SetAll("DynamicFontbold","iif(cur_planp.estado=4,.T.,.F.)","Column")
				thisform.contarpedidos()
				thisform.calculartotales()
				frmplanp= conectar_db(_screen.cn)
					SQLEXEC(frmplanp,"select TRIM(ped_obser) ped_obser from pedidos where ped_codi = ?cur_planp.pedcodi;","cur_obser")
				desconectar_db(frmplanp)
				IF RECCOUNT("cur_obser") > 0
					IF LEN(ALLTRIM(cur_obser.ped_obser)) > 0
						thisform.pgf_resum.page2.edt_obser.Value = ALLTRIM(cur_obser.ped_obser)
					ELSE
						thisform.pgf_resum.page2.edt_obser.Value = ""
					ENDIF
					cerrar_cursor("cur_obser")
				ENDIF
				thisform.grd_ped.SetFocus
			ENDIF
		ELSE
			thisform.limpiartotales(.T.)
		ENDIF
	ENDPROC

	PROCEDURE btn_salir.Click
		thisform.release
	ENDPROC

	PROCEDURE btn_salir.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		this.FontSize=9
		this.FontBold=.F.
	ENDPROC


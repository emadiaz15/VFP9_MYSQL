		desconectar_db(frmplanp)
		
		IF RECCOUNT("cur_obser") > 0
			IF LEN(ALLTRIM(cur_obser.ped_obser)) > 0
				thisform.pgf_resum.page2.edt_obser.Value = ALLTRIM(cur_obser.ped_obser)

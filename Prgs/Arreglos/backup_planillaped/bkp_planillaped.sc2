	PROCEDURE calculartotales
		IF USED("cur_planp")
			LOCATE
		*!*		SELECT SUM(impotot) FROM cur_planp WHERE estado = 1 AND moneda = 'P' INTO ARRAY ar_tpse
		*!*		SELECT SUM(impotot) FROM cur_planp WHERE estado = 2 AND moneda = 'P' INTO ARRAY ar_tpep
		*!*		SELECT SUM(impotot) FROM cur_planp WHERE estado = 3 AND moneda = 'P' INTO ARRAY ar_tpft
		&& AND moneda = 'D'
			SELECT SUM(impotot) FROM cur_planp WHERE estado = 1 INTO ARRAY ar_tdse
			SELECT SUM(impotot) FROM cur_planp WHERE estado = 2 INTO ARRAY ar_tdep
			SELECT SUM(impotot) FROM cur_planp WHERE estado = 3 INTO ARRAY ar_tdft
			SELECT SUM(impotot) FROM cur_planp WHERE estado = 4 INTO ARRAY ar_tsf
			
		*!*		SELECT SUM(impopen) FROM cur_planp WHERE estado = 1 AND moneda = 'P' INTO ARRAY ar_ppse
		*!*		SELECT SUM(impopen) FROM cur_planp WHERE estado = 2 AND moneda = 'P' INTO ARRAY ar_ppep
		*!*		SELECT SUM(impopen) FROM cur_planp WHERE estado = 3 AND moneda = 'P' INTO ARRAY ar_ppft
		
			SELECT SUM(impopen) FROM cur_planp WHERE estado = 1 INTO ARRAY ar_pdse
			SELECT SUM(impopen) FROM cur_planp WHERE estado = 2 INTO ARRAY ar_pdep
			SELECT SUM(impopen) FROM cur_planp WHERE estado = 3 INTO ARRAY ar_pdft
			SELECT SUM(impopen) FROM cur_planp WHERE estado = 4 INTO ARRAY ar_psf
			SELECT SUM(remsfac) FROM cur_planp WHERE estado = 4 INTO ARRAY ar_rsf
		
		*!*		thisform.pgf_resum.page1.etq_tpse.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_tpse),0,ar_tpse),15,2))
		*!*		thisform.pgf_resum.page1.etq_tpep.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_tpep),0,ar_tpep),15,2))
		*!*		thisform.pgf_resum.page1.etq_tpfin.Caption = ALLTRIM(STR(IIF(ISNULL(ar_tpft),0,ar_tpft),15,2))
		*!*		thisform.pgf_resum.page1.etq_totp.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_tpse),0,ar_tpse) + ;
		*!*		                                                         IIF(ISNULL(ar_tpep),0,ar_tpep) + ;
		*!*		                                                         IIF(ISNULL(ar_tpft),0,ar_tpft),15,2))
			                                                         
			thisform.pgf_resum.page1.etq_tdse.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_tdse),0,ar_tdse),15,2))
			thisform.pgf_resum.page1.etq_tdep.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_tdep),0,ar_tdep),15,2))
			thisform.pgf_resum.page1.etq_tsf.Caption   = ALLTRIM(STR(IIF(ISNULL(ar_tsf),0,ar_tsf),15,2))
			thisform.pgf_resum.page1.etq_tdfin.Caption = ALLTRIM(STR(IIF(ISNULL(ar_tdft),0,ar_tdft),15,2))
			thisform.pgf_resum.page1.etq_totd.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_tdse),0,ar_tdse) + ;
			                                                         IIF(ISNULL(ar_tdep),0,ar_tdep) + ;
			                                                         IIF(ISNULL(ar_tsf),0,ar_tsf) + ;
			                                                         IIF(ISNULL(ar_tdft),0,ar_tdft),15,2))
		
		*!*		thisform.pgf_resum.page1.etq_ppse.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_ppse),0,ar_ppse),15,2))
		*!*		thisform.pgf_resum.page1.etq_ppep.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_ppep),0,ar_ppep),15,2))
		*!*		thisform.pgf_resum.page1.etq_ppfin.Caption = ALLTRIM(STR(IIF(ISNULL(ar_ppft),0,ar_ppft),15,2))
		*!*		thisform.pgf_resum.page1.etq_totpp.Caption = ALLTRIM(STR(IIF(ISNULL(ar_ppse),0,ar_ppse) + ;
		*!*		                                                         IIF(ISNULL(ar_ppep),0,ar_ppep) + ;
		*!*		                                                         IIF(ISNULL(ar_ppft),0,ar_ppft),15,2))
			                                                         
			thisform.pgf_resum.page1.etq_pdse.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_pdse),0,ar_pdse),15,2))
			thisform.pgf_resum.page1.etq_pdep.Caption  = ALLTRIM(STR(IIF(ISNULL(ar_pdep),0,ar_pdep),15,2))
			thisform.pgf_resum.page1.etq_psf.Caption   = ALLTRIM(STR(IIF(ISNULL(ar_psf),0,ar_psf),15,2))
			thisform.pgf_resum.page1.etq_pdfin.Caption = ALLTRIM(STR(IIF(ISNULL(ar_pdft),0,ar_pdft),15,2))
			thisform.pgf_resum.page1.etq_totdp.Caption = ALLTRIM(STR(IIF(ISNULL(ar_pdse),0,ar_pdse) + ;
			                                                         IIF(ISNULL(ar_pdep),0,ar_pdep) + ;
			                                                         IIF(ISNULL(ar_psf),0,ar_psf) + ;
			                                                         IIF(ISNULL(ar_pdft),0,ar_pdft),15,2))
		ENDIF
		*!*	DO case
		*!*		CASE nEstado = 1
		*!*			lnColor = RGB(230,0,0)
		*!*		CASE nEstado = 2
		*!*			lnColor = RGB(52,105,105)
		*!*	    CASE nEstado = 3
		*!*	    	lnColor = RGB(131,208,142)
		*!*	ENDCASE
		
		
	ENDPROC

	PROCEDURE contarpedidos
		IF USED("cur_planp")
			LOCATE
			SELECT COUNT(*) FROM cur_planp WHERE estado = 1 INTO ARRAY ar_cantse
			SELECT COUNT(*) FROM cur_planp WHERE estado = 2 INTO ARRAY ar_cantep
			SELECT COUNT(*) FROM cur_planp WHERE estado = 3 INTO ARRAY ar_cantft
			SELECT COUNT(*) FROM cur_planp WHERE estado = 4 INTO ARRAY ar_cantsf
			
			thisform.pgf_resum.page1.etq_cantse.Caption  = ALLTRIM(STR(ar_cantse))
			thisform.pgf_resum.page1.etq_cantep.Caption  = ALLTRIM(STR(ar_cantep))
			thisform.pgf_resum.page1.etq_cantsf.Caption  = ALLTRIM(STR(ar_cantsf))
			thisform.pgf_resum.page1.etq_cantfin.Caption = ALLTRIM(STR(ar_cantft))
			thisform.pgf_resum.page1.etq_totcan.Caption  = ALLTRIM(STR(ar_cantse + ar_cantep + ar_cantsf + ar_cantft))
		ENDIF
	ENDPROC

	PROCEDURE datos_click
		
		thisform.RemoveObject("shp_datos")
		thisform.RemoveObject("edt_datos")
		thisform.RemoveObject("cmd_datos")
	ENDPROC

	PROCEDURE datos_mleave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.F.
		thisform.cmd_datos.FontSize=9
	ENDPROC

	PROCEDURE datos_mmove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		thisform.cmd_datos.FontBold=.T.
		thisform.cmd_datos.FontSize=10
	ENDPROC

	PROCEDURE Destroy
		SET POINT TO
		SET SEPARATOR TO
	ENDPROC

	PROCEDURE excelcuadrofooter
		LPARAMETERS nFila
		
		fotfil = nFila
		
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(1).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(1).Weight=3
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(2).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(2).Weight=3
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(3).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(3).Weight=3
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(4).LineStyle=1
		XLSheet.Range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8)).Borders(4).Weight=3
		
		RETURN
		
		
	ENDPROC

	PROCEDURE excelencabezado
		Xlsheet.cells(1,8)=ALLTRIM(thisform.empresa)
		XLSheet.Cells(1,8).font.bold=.T.
		XLSheet.Cells(1,8).font.size="12"
		XLSheet.Cells(1,8).font.name="Courier New"
		XLSheet.Cells(1,8).HorizontalAlignment=-4152
		
		Xlsheet.cells(3,8)='Fecha Actual: '+ALLTRIM(DTOC(DATE()))
		XLSheet.Cells(3,8).font.bold=.T.
		XLSheet.Cells(3,8).font.size="11"
		XLSheet.Cells(3,8).font.name="Courier New"
		XLSheet.Cells(3,8).HorizontalAlignment=-4152
		
		Xlsheet.range("E4:F4").merge
		Xlsheet.cells(4,5)="PLANILLA DE PEDIDOS"
		XLSheet.Cells(4,5).font.bold=.T.
		XLSheet.Cells(4,5).font.underline=.T.
		XLSheet.Cells(4,5).font.size="13"
		XLSheet.Cells(4,5).font.name="Cooper Black"
		XLSheet.range("E4:F4").HorizontalAlignment=7
		
		XLSheet.range("B8:C8").merge
		XLSheet.range("B9:C9").merge
		XLSheet.range("B10:C10").merge
		XLSheet.range("B11:C11").merge
		XLSheet.range("B12:C12").merge
		XLSheet.range("B8:C12").HorizontalAlignment=7
		XLSheet.range("B8:C12").Borders.LineStyle=1
		XLSheet.range("B8:C12").Borders.Weight=3
		XLSheet.Cells(8,2)="Referencias:"
		XLSheet.Cells(8,2).font.bold=.T.
		XLSheet.Cells(9,2)="Sin Empezar"
		XLSheet.Cells(9,2).interior.color=thisform.obtenercolor(1)
		XLSheet.Cells(9,2).font.color=thisform.obtenercolortex(1)
		XLSheet.Cells(10,2)="En Proceso"
		XLSheet.Cells(10,2).interior.color=thisform.obtenercolor(2)
		XLSheet.Cells(10,2).font.color=thisform.obtenercolortex(2)
		XLSheet.Cells(11,2)="En Proc.C/Cant.S/Fac"
		XLSheet.Cells(11,2).interior.color=thisform.obtenercolor(4)
		XLSheet.Cells(11,2).font.color=thisform.obtenercolortex(4)
		XLSheet.Cells(11,2).font.bold=.T.
		XLSheet.Cells(12,2)="Finalizados"
		XLSheet.Cells(12,2).interior.color=thisform.obtenercolor(3)
		XLSheet.Cells(12,2).font.color=thisform.obtenercolortex(3)
		
		XLSheet.Cells(6,5)="Fecha desde:"
		XLSheet.Cells(6,5).font.bold=.T.
		XLSheet.Cells(6,5).font.size="11"
		XLSheet.Cells(6,5).font.name="Courier New"
		XLSheet.Cells(6,5).HorizontalAlignment=-4152
		XLSheet.Cells(6,7)="hasta"
		XLSheet.Cells(6,7).font.bold=.T.
		XLSheet.Cells(6,7).font.size="11"
		XLSheet.Cells(6,7).font.name="Courier New"
		XLSheet.Cells(6,7).HorizontalAlignment=-4108
		XLSheet.Cells(7,5)="Pedido desde:"
		XLSheet.Cells(7,5).font.bold=.T.
		XLSheet.Cells(7,5).font.size="11"
		XLSheet.Cells(7,5).font.name="Courier New"
		XLSheet.Cells(7,5).HorizontalAlignment=-4152
		XLSheet.Cells(7,7)="hasta"
		XLSheet.Cells(7,7).font.bold=.T.
		XLSheet.Cells(7,7).font.size="11"
		XLSheet.Cells(7,7).font.name="Courier New"
		XLSheet.Cells(7,7).HorizontalAlignment=-4108
		XLSheet.Cells(8,5)="N.Ped desde:"
		XLSheet.Cells(8,5).font.bold=.T.
		XLSheet.Cells(8,5).font.size="11"
		XLSheet.Cells(8,5).font.name="Courier New"
		XLSheet.Cells(8,5).HorizontalAlignment=-4152
		XLSheet.Cells(8,7)="hasta"
		XLSheet.Cells(8,7).font.bold=.T.
		XLSheet.Cells(8,7).font.size="11"
		XLSheet.Cells(8,7).font.name="Courier New"
		XLSheet.Cells(8,7).HorizontalAlignment=-4108
		XLSheet.Cells(9,5)="Artículo desde:"
		XLSheet.Cells(9,5).font.bold=.T.
		XLSheet.Cells(9,5).font.size="11"
		XLSheet.Cells(9,5).font.name="Courier New"
		XLSheet.Cells(9,5).HorizontalAlignment=-4152
		XLSheet.Cells(9,7)="hasta"
		XLSheet.Cells(9,7).font.bold=.T.
		XLSheet.Cells(9,7).font.size="11"
		XLSheet.Cells(9,7).font.name="Courier New"
		XLSheet.Cells(9,7).HorizontalAlignment=-4108
		XLSheet.Cells(10,5)="Cliente:"
		XLSheet.Cells(10,5).font.bold=.T.
		XLSheet.Cells(10,5).font.size="11"
		XLSheet.Cells(10,5).font.name="Courier New"
		XLSheet.Cells(10,5).HorizontalAlignment=-4152
		XLSheet.Cells(11,5)="Vendedor:"
		XLSheet.Cells(11,5).font.bold=.T.
		XLSheet.Cells(11,5).font.size="11"
		XLSheet.Cells(11,5).font.name="Courier New"
		XLSheet.Cells(11,5).HorizontalAlignment=-4152
		XLSheet.Cells(12,5)="Estado:"
		XLSheet.Cells(12,5).font.bold=.T.
		XLSheet.Cells(12,5).font.size="11"
		XLSheet.Cells(12,5).font.name="Courier New"
		XLSheet.Cells(12,5).HorizontalAlignment=-4152
		
		XLSheet.Cells(6,6)=thisform.txt_fecdes.Value
		XLSheet.Cells(6,6).HorizontalAlignment=-4152
		XLSheet.Cells(6,8)=thisform.txt_fechas.Value
		XLSheet.Cells(6,8).HorizontalAlignment=2
		XLSheet.Cells(7,6)=thisform.txt_peddes.Value
		XLSheet.Cells(7,6).HorizontalAlignment=-4152
		XLSheet.Cells(7,8)=thisform.txt_pedhas.Value
		XLSheet.Cells(7,8).HorizontalAlignment=2
		XLSheet.Cells(8,6)=thisform.txt_npdes.Value
		XLSheet.Cells(8,6).HorizontalAlignment=-4152
		XLSheet.Cells(8,8)=thisform.txt_nphas.Value
		XLSheet.Cells(8,8).HorizontalAlignment=2
		XLSheet.Cells(9,6)=thisform.txt_artdes.Value
		XLSheet.Cells(9,6).HorizontalAlignment=-4152
		XLSheet.Cells(9,8)=thisform.txt_arthas.Value
		XLSheet.Cells(9,8).HorizontalAlignment=2
		XLSheet.Cells(10,6)=IIF(thisform.chk_cliente.Value=1,"TODOS",ALLTRIM(thisform.cmb_cliente.Value))
		XLSheet.Cells(10,6).HorizontalAlignment=2
		XLSheet.Cells(11,6)=IIF(thisform.chk_vend.Value=1,"TODOS",ALLTRIM(thisform.cmb_vendedor.Value))
		XLSheet.Cells(11,6).HorizontalAlignment=2
		LOCAL xEst
		xEst = ''
		IF thisform.chk_sinem.Value=1
			xEst = xEst + "SIN EMPEZAR"
		ENDIF
		IF thisform.chk_enpro.Value=1
			xEst = xEst + " / EN PROCESO"
		ENDIF
		IF thisform.chk_fin.Value=1
			xEst = xEst + " / FINALIZADO"
		ENDIF
		XLSheet.Cells(12,6)=ALLTRIM(xEst)
		XLSheet.Cells(12,6).HorizontalAlignment=2
		
		XLSheet.Cells(14,2)="FECHA"
		XLSheet.Cells(14,2).font.bold=.T.
		XLSheet.Cells(14,2).font.size="11"
		XLSheet.Cells(14,2).font.name="Courier New"
		XLSheet.range("B14:B14").HorizontalAlignment=-4108
		XLSheet.Cells(14,3)="PED.CODI"
		XLSheet.Cells(14,3).font.bold=.T.
		XLSheet.Cells(14,3).font.size="11"
		XLSheet.Cells(14,3).font.name="Courier New"
		XLSheet.range("C14:C14").HorizontalAlignment=-4108
		XLSheet.Cells(14,4)="NP.NRO"
		XLSheet.Cells(14,4).font.bold=.T.
		XLSheet.Cells(14,4).font.size="11"
		XLSheet.Cells(14,4).font.name="Courier New"
		XLSheet.range("D14:D14").HorizontalAlignment=-4108
		XLSheet.Cells(14,5)="CLIENTE / RAZÓN SOCIAL"
		XLSheet.Cells(14,5).font.bold=.T.
		XLSheet.Cells(14,5).font.size="11"
		XLSheet.Cells(14,5).font.name="Courier New"
		XLSheet.range("E14:E14").HorizontalAlignment=-4108
		XLSheet.Cells(14,6)="VENDEDOR"
		XLSheet.Cells(14,6).font.bold=.T.
		XLSheet.Cells(14,6).font.size="11"
		XLSheet.Cells(14,6).font.name="Courier New"
		XLSheet.range("F14:F14").HorizontalAlignment=-4108
		XLSheet.Cells(14,7)="MONTO TOTAL"
		XLSheet.Cells(14,7).font.bold=.T.
		XLSheet.Cells(14,7).font.size="11"
		XLSheet.Cells(14,7).font.name="Courier New"
		XLSheet.range("G14:G14").HorizontalAlignment=-4108
		XLSheet.Cells(14,8)="MONTO PEND"
		XLSheet.Cells(14,8).font.bold=.T.
		XLSheet.Cells(14,8).font.size="11"
		XLSheet.Cells(14,8).font.name="Courier New"
		XLSheet.range("H14:H14").HorizontalAlignment=-4108
		XLSheet.Range(XLSheet.Cells(14,2),XLSheet.Cells(14,8)).Borders.LineStyle=1
		XLSheet.Range(XLSheet.Cells(14,2),XLSheet.Cells(14,8)).Borders.Weight=2
		XLSheet.Range(XLSheet.Cells(14,2),XLSheet.Cells(14,8)).Interior.Color= RGB(192,192,192)
		
		return
	ENDPROC

	PROCEDURE excelfooter
		LPARAMETERS xInifil
		
		LOCAL fotfil
		
		fotfil = xInifil
		
		XLSheet.Rows(fotfil).RowHeight = 10
		fotfil = fotfil + 1
		Xlsheet.cells(fotfil,7)='MONTO TOTAL'
		Xlsheet.cells(fotfil,8)='MONTO PEND'
		WITH Xlsheet.range(XLSheet.Cells(fotfil,7),XLSheet.Cells(fotfil,8))
			.font.bold=.T.
			.HorizontalAlignment=-4108
		ENDWITH
		
		thisform.excelcuadrofooter(fotfil)
		fotfil = fotfil + 1
		*!*	thisform.excelcuadrofooter(fotfil)
		Xlsheet.cells(fotfil,6)='Sin Empezar ('+ALLTRIM(thisform.pgf_resum.page1.etq_cantse.Caption)+' pedidos)'
		Xlsheet.cells(fotfil,6).HorizontalAlignment=-4152
		*!*	XLSheet.Cells(fotfil,7).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		*!*	XLSheet.Cells(fotfil,8).NUMBERFORMAT="_-[$$-es-AR] * #,##0.00"
		*!*	XLSheet.Cells(fotfil,7)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_tpse.caption))
		*!*	XLSheet.Cells(fotfil,8)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_ppse.caption))
		*!*	fotfil = fotfil + 1
		thisform.excelcuadrofooter(fotfil)
		XLSheet.Cells(fotfil,7).NUMBERFORMAT="_-[$USD] * #,##0.00"
		XLSheet.Cells(fotfil,8).NUMBERFORMAT="_-[$USD] * #,##0.00"
		XLSheet.Cells(fotfil,7)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_tdse.caption))
		XLSheet.Cells(fotfil,8)=ConverNro(ALLTRIM(thisform.pgf_resum.page1.etq_pdse.caption))
		fotfil = fotfil + 1
		XLSheet.Rows(fotfil).RowHeight = 10
		fotfil = fotfil + 1
		*!*	thisform.excelcuadrofooter(fotfil)
